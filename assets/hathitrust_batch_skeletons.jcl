//HTEXPORT JOB (ACCNT),'HATHITRUST BATCH',CLASS=A,MSGCLASS=X
//*
//* SKELETON JCL FOR HATHITRUST BATCH EXPORT ROUTINE
//*
//STEP1    EXEC PGM=HTQTEXP
//SYSIN    DD DSN=HT.RAW.TSV,DISP=SHR
//SYSOUT   DD DSN=HT.PRIMARY.DAT.BIN,DISP=(NEW,CATLG,DELETE)
//SYSISBN  DD DSN=HT.ISBN.AIX.DAT.BIN,DISP=(NEW,CATLG,DELETE)
//SYSOCLC  DD DSN=HT.OCLC.AIX.DAT.BIN,DISP=(NEW,CATLG,DELETE)
//SYSINTR  DD DSN=HT.AUDIT.LOG.DAT.BIN,DISP=SHR
//*
//* STEP 2: CONVERT HATHITRUST RAW DATA TO CONFIGURED SEPARATOR FORMAT
//STEP2    EXEC PGM=TSVCONV
//SYSIN    DD DSN=HT.RAW.TSV,DISP=SHR
//SYSOUT   DD DSN=HT.CONV.TSV,DISP=(NEW,CATLG,DELETE)
//*
//* STEP 3: EXECUTE HATHITRUST REFERENCE PRESERVATION QUERY
//STEP3    EXEC PGM=HTPRESQ
//SYSDB    DD DSN=HT.PRIMARY.DAT.BIN,DISP=SHR
//SYSREF   DD DSN=HT.REFERENCES.TXT,DISP=(MOD,KEEP)
//SYSQRY   DD *
9780123456789
