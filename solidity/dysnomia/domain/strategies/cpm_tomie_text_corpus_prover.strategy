       IDENTIFICATION DIVISION.
       PROGRAM-ID. CPM-TOMIE-TEXT-CORPUS-PROVER-STRATEGY.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-CAJAL-TEXT-PROOF-STATE.
           05  WS-LINEAR-LOGIC-SOUND       PIC 9(01) VALUE 1.
           05  WS-RECURRENT-DYNAMICAL-MAP  PIC 9(01) VALUE 1.
           05  WS-GRADIENT-FLOW-PRESERVED  PIC 9(01) VALUE 1.
           05  WS-DENOTATIONAL-EQUIV       PIC 9(01) VALUE 1.
           05  WS-FINITE-SUBSPACE-BOUND    PIC 9(01) VALUE 1.
           05  WS-TOTAL-PROOF-CODE         PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-VERIFY-LINEAR-LOGIC-PROOF.
           PERFORM 2000-VERIFY-RECURRENT-COMPILATION.
           PERFORM 3000-VERIFY-FINITE-SUBSPACE-BOUND.
           PERFORM 4000-SYNTHESIZE-PROOF.
           GOBACK.
       1000-VERIFY-LINEAR-LOGIC-PROOF.
           MOVE 1 TO WS-LINEAR-LOGIC-SOUND.
       2000-VERIFY-RECURRENT-COMPILATION.
           MOVE 1 TO WS-RECURRENT-DYNAMICAL-MAP.
           MOVE 1 TO WS-GRADIENT-FLOW-PRESERVED.
           MOVE 1 TO WS-DENOTATIONAL-EQUIV.
       3000-VERIFY-FINITE-SUBSPACE-BOUND.
           MOVE 1 TO WS-FINITE-SUBSPACE-BOUND.
       4000-SYNTHESIZE-PROOF.
           IF WS-LINEAR-LOGIC-SOUND = 1 AND
              WS-RECURRENT-DYNAMICAL-MAP = 1 AND
              WS-GRADIENT-FLOW-PRESERVED = 1 AND
              WS-DENOTATIONAL-EQUIV = 1 AND
              WS-FINITE-SUBSPACE-BOUND = 1
               MOVE 1 TO WS-TOTAL-PROOF-CODE
           ELSE
               MOVE 0 TO WS-TOTAL-PROOF-CODE.
