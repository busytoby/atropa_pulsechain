       IDENTIFICATION DIVISION.
       PROGRAM-ID. LYAPUNOV-TOTIENT-EMPATHY.
       AUTHOR. AUNCIENT DYSNOMIA VM / TOTIENT EMPATHY.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-TOT-EMP-PARAMS.
          05 WS-INIT-TOT-CHARGE-A0     PIC 9(05) VALUE 12000.
          05 WS-SWARM-FLUX-RATE        PIC 9(04) VALUE 0400.
          05 WS-PHI-FACTOR             PIC 9(04) VALUE 0500.
          05 WS-ACCUM-STEPS-N          PIC 9(02) VALUE 16.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-CURRENT-TOT-CHARGE     PIC 9(09) VALUE 0.
          05 WS-STEP-IDX               PIC 9(02) VALUE 0.
          05 WS-THEORY-CAPACITY-MAX    PIC 9(09) VALUE 0.
          05 WS-SHADOW-TOT-BASE        PIC 9(12) VALUE 0.
          05 WS-CYC-MOD                PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-INITIAL-CHARGE      VALUE 2.
             88 INVALID-FLUX-RATE           VALUE 3.
             88 INVALID-TOTIENT-PHI         VALUE 4.
             88 INVALID-ACCUM-STEPS         VALUE 5.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 6.
             88 TOTIENT-CAPACITY-OVERFLOW   VALUE 7.
             88 GATING-CLAMP-OVERFLOW       VALUE 8.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 9.
             88 CASCADE-ROLLBACK-FAIL       VALUE 10.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-TOTIENT-INTEGRATION
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-INIT-TOT-CHARGE-A0 > 50000
               SET INVALID-INITIAL-CHARGE TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SWARM-FLUX-RATE < 1 OR WS-SWARM-FLUX-RATE > 5000
               SET INVALID-FLUX-RATE TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-PHI-FACTOR < 1 OR WS-PHI-FACTOR > 1000
               SET INVALID-TOTIENT-PHI TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-ACCUM-STEPS-N < 1 OR WS-ACCUM-STEPS-N > 64
               SET INVALID-ACCUM-STEPS TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-TOTIENT-INTEGRATION.
           MOVE WS-INIT-TOT-CHARGE-A0 TO WS-CURRENT-TOT-CHARGE.

           PERFORM VARYING WS-STEP-IDX FROM 1 BY 1 UNTIL WS-STEP-IDX > WS-ACCUM-STEPS-N
               COMPUTE WS-CURRENT-TOT-CHARGE = ((WS-CURRENT-TOT-CHARGE * 875) / 1000) + WS-SWARM-FLUX-RATE
           END-PERFORM.

           COMPUTE WS-THEORY-CAPACITY-MAX = WS-INIT-TOT-CHARGE-A0 + (8 * WS-SWARM-FLUX-RATE).

           IF WS-CURRENT-TOT-CHARGE > WS-THEORY-CAPACITY-MAX
               SET TOTIENT-CAPACITY-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-SHADOW-TOT-BASE = (WS-CICS-WRITER-ID * 1000000) + 
               (WS-ACCUM-STEPS-N * 10000) + (WS-PHI-FACTOR * 10) + (WS-CURRENT-TOT-CHARGE / 16).

           COMPUTE WS-CYC-MOD = FUNCTION MOD(WS-ACCUM-STEPS-N, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-CYC-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-TOT-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-TOT-BASE + ((WS-CURRENT-TOT-CHARGE * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-TOT-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-ACCUM-STEPS-N * 10000) + (WS-PHI-FACTOR * 10) + (WS-CURRENT-TOT-CHARGE / 16))
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-TOT-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
