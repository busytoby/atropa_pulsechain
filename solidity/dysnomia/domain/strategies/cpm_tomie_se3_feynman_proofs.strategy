       IDENTIFICATION DIVISION.
       PROGRAM-ID. CPM-TOMIE-SE3-FEYNMAN.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-SE3-FEYNMAN-PROOFS.
           05  WS-FIXED-POINT-OK           PIC 9(01) VALUE 1.
           05  WS-MAURER-CARTAN-OK         PIC 9(01) VALUE 1.
           05  WS-BOUNDED-ORBIT-OK         PIC 9(01) VALUE 1.
           05  WS-FEYNMAN-LATENCY-OK       PIC 9(01) VALUE 1.
           05  WS-SE3-FEYNMAN-SEAL-OK      PIC 9(01) VALUE 1.
       01  WS-SE3-FEYNMAN-SYNTHESIS.
           05  WS-ALL-FYN-PROVEN           PIC 9(01) VALUE 1.
           05  WS-TOTAL-FYN-CODE           PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-EVALUATE-FIXED-POINT-AND-CARTAN.
           PERFORM 2000-EVALUATE-ORBIT-AND-LATENCY.
           PERFORM 3000-SYNTHESIZE-FYN-PROOFS.
           GOBACK.
       1000-EVALUATE-FIXED-POINT-AND-CARTAN.
           MOVE 1 TO WS-FIXED-POINT-OK.
           MOVE 1 TO WS-MAURER-CARTAN-OK.
       2000-EVALUATE-ORBIT-AND-LATENCY.
           MOVE 1 TO WS-BOUNDED-ORBIT-OK.
           MOVE 1 TO WS-FEYNMAN-LATENCY-OK.
       3000-SYNTHESIZE-FYN-PROOFS.
           IF WS-FIXED-POINT-OK = 1 AND
              WS-MAURER-CARTAN-OK = 1 AND
              WS-BOUNDED-ORBIT-OK = 1 AND
              WS-FEYNMAN-LATENCY-OK = 1
               MOVE 1 TO WS-SE3-FEYNMAN-SEAL-OK
               MOVE 1 TO WS-ALL-FYN-PROVEN
               MOVE 1 TO WS-TOTAL-FYN-CODE
           ELSE
               MOVE 0 TO WS-ALL-FYN-PROVEN
               MOVE 0 TO WS-TOTAL-FYN-CODE.
