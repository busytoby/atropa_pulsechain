        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-IDENTITY-CONSENSUS.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-ID-CONSENSUS-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1436-CONSENSUS-OK      PIC 9(01) VALUE 1.
            05  WS-TH1437-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1438-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1439-1440M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1440-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-ID-CONSENSUS-WIT         PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-ID-CONSENSUS.
            GOBACK.
        1000-EVALUATE-ID-CONSENSUS.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1436-CONSENSUS-OK = 1 AND
               WS-TH1437-DATBIN-STRAT-OK = 1 AND
               WS-TH1438-SUBMICRO-LAT-OK = 1 AND
               WS-TH1439-1440M-SAAT-OK = 1 AND
               WS-TH1440-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-ID-CONSENSUS-WIT
            ELSE
                MOVE 0 TO WS-ID-CONSENSUS-WIT.
