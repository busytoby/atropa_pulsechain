       IDENTIFICATION DIVISION.
       PROGRAM-ID. CPM-TOMIE-CASE-INFLECTION.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-CASE-INFLECTION-PROOFS.
           05  WS-OVERT-CASE-MARKING-SOUND PIC 9(01) VALUE 1.
           05  WS-PREPOSITIONAL-CASE-MAP   PIC 9(01) VALUE 1.
           05  WS-TOPICALIZATION-PROJECTION PIC 9(01) VALUE 1.
           05  WS-FOCUS-STRESS-ALIGNMENT   PIC 9(01) VALUE 1.
           05  WS-SURFACE-INFLECTION-SEAL  PIC 9(01) VALUE 1.
       01  WS-INFLECTION-SYNTHESIS.
           05  WS-ALL-INFLECTION-PROVEN    PIC 9(01) VALUE 1.
           05  WS-TOTAL-INFLECTION-CODE    PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-EVALUATE-MARKING-AND-PREPOSITIONS.
           PERFORM 2000-EVALUATE-TOPIC-AND-FOCUS.
           PERFORM 3000-SYNTHESIZE-INFLECTION-PROOFS.
           GOBACK.
       1000-EVALUATE-MARKING-AND-PREPOSITIONS.
           MOVE 1 TO WS-OVERT-CASE-MARKING-SOUND.
           MOVE 1 TO WS-PREPOSITIONAL-CASE-MAP.
       2000-EVALUATE-TOPIC-AND-FOCUS.
           MOVE 1 TO WS-TOPICALIZATION-PROJECTION.
           MOVE 1 TO WS-FOCUS-STRESS-ALIGNMENT.
       3000-SYNTHESIZE-INFLECTION-PROOFS.
           IF WS-OVERT-CASE-MARKING-SOUND = 1 AND
              WS-PREPOSITIONAL-CASE-MAP = 1 AND
              WS-TOPICALIZATION-PROJECTION = 1 AND
              WS-FOCUS-STRESS-ALIGNMENT = 1
               MOVE 1 TO WS-SURFACE-INFLECTION-SEAL
               MOVE 1 TO WS-ALL-INFLECTION-PROVEN
               MOVE 1 TO WS-TOTAL-INFLECTION-CODE
           ELSE
               MOVE 0 TO WS-ALL-INFLECTION-PROVEN
               MOVE 0 TO WS-TOTAL-INFLECTION-CODE.
