IDENTIFICATION DIVISION.
PROGRAM-ID. PROG-VULKAN-VISION-CAMERA.

DATA DIVISION.
01 D0-SUBSTRATE-TRUNK.
   05 D0-MOTZKIN-PRIME     PIC 9(9) USAGE R0.
   05 D0-K-EXPONENT        PIC 9(9) USAGE R1.
   05 D0-MAX-DEPTH-Z       PIC 9(9) USAGE R2.
01 D1-CAMERA-VULKAN.
   05 D1-FOV-DEG           PIC 9(9) USAGE R3.
   05 D1-MESH-DEPTH-Z      PIC 9(9) USAGE R4.
   05 D1-SET-INDEX         PIC 9(9) USAGE R5.
01 D2-FRUSTUM-PROJECT.
   05 D2-FOCAL-LENGTH-Q16  PIC 9(9) USAGE R6.
   05 D2-PROJECTED-Z-Q16   PIC 9(9) USAGE R7.
   05 D2-G-SWIGLU-GATE     PIC 9(9) USAGE R8.
   05 D2-SHADOW-FOV        PIC 9(9) USAGE R9.
   05 D2-COMMITTED-STATE   PIC 9(9) USAGE R10.
   05 D2-ALIGNMENT-BYTES   PIC 9(9) USAGE R11.
01 D3-LEAF-EVAL.
   05 D3-PROOF-RULING      PIC 9(9) USAGE R12.
   05 D3-DISP-WRAP-MOD     PIC 9(9) USAGE R13.

PROCEDURE DIVISION.
    MOVE 953467954 TO D0-MOTZKIN-PRIME.
    MOVE 3 TO D0-K-EXPONENT.
    MOVE 1048576 TO D0-MAX-DEPTH-Z.
    MOVE 60 TO D1-FOV-DEG.
    MOVE 800 TO D1-MESH-DEPTH-Z.
    MOVE 0 TO D1-SET-INDEX.

    PERFORM STAGE-CAMERA-FRUSTUM.
    PERFORM STAGE-VULKAN-DESCRIPTORS.
    PERFORM EVALUATE-COMMIT.
    PERFORM SYNC-DISPLACEMENT.

    IF D2-SHADOW-FOV == D1-FOV-DEG AND D2-PROJECTED-Z-Q16 <= D0-MAX-DEPTH-Z
        MOVE 0 TO D3-PROOF-RULING
        SET depth 4
    ELSE
        MOVE 5 TO D3-PROOF-RULING
        SET depth 1
    END-IF.

    EVAL.
    GO TO END-STRATEGY.

STAGE-CAMERA-FRUSTUM.
    MOVE D1-FOV-DEG TO D2-SHADOW-FOV.
    COMPUTE D2-FOCAL-LENGTH-Q16 = 6553600 / D1-FOV-DEG.
    COMPUTE D2-PROJECTED-Z-Q16 = (D1-MESH-DEPTH-Z * D2-FOCAL-LENGTH-Q16) / 65536.
    EXIT.

STAGE-VULKAN-DESCRIPTORS.
    COMPUTE D2-G-SWIGLU-GATE = 875 + ((125 * (D1-SET-INDEX + 1)) / 3).
    COMPUTE D2-ALIGNMENT-BYTES = 256.
    EXIT.

EVALUATE-COMMIT.
    COMPUTE D2-COMMITTED-STATE = (((D2-FOCAL-LENGTH-Q16 + D2-PROJECTED-Z-Q16 + 43605) * D2-G-SWIGLU-GATE) / 1000).
    EXIT.

SYNC-DISPLACEMENT.
    COMPUTE D3-DISP-WRAP-MOD = D2-COMMITTED-STATE - ((D2-COMMITTED-STATE / 256) * 256).
    EXIT.

END-STRATEGY.
