        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-AUX-CORES.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-AUX-CORES-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1036-AUX-CORES-OK      PIC 9(01) VALUE 1.
            05  WS-TH1037-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1038-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1039-1040M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1040-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-AUX-CORES-WIT            PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-AUX-CORES.
            GOBACK.
        1000-EVALUATE-AUX-CORES.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1036-AUX-CORES-OK = 1 AND
               WS-TH1037-DATBIN-STRAT-OK = 1 AND
               WS-TH1038-SUBMICRO-LAT-OK = 1 AND
               WS-TH1039-1040M-SAAT-OK = 1 AND
               WS-TH1040-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-AUX-CORES-WIT
            ELSE
                MOVE 0 TO WS-AUX-CORES-WIT.
