       IDENTIFICATION DIVISION.
       PROGRAM-ID. HARVARD-TRANSFER-BUS-STRATEGY.
       AUTHOR. AUNCIENT DYSNOMIA VM / HARVARD TRANSFER BUS INTERPOLATOR.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-TRANSFER-PARAMETERS.
          05 WS-SOURCE-WHEEL-VAL       PIC 9(12) VALUE 0001000000.
          05 WS-TRANSFER-DELTA-VAL     PIC 9(09) VALUE 000050000.
          05 WS-INTERP-STEP-S-Q16      PIC 9(06) VALUE 032768.
          05 WS-STRATEGY-COUNT         PIC 9(02) VALUE 04.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-ROOT-SHADOW-WHEEL      PIC 9(12) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-DELTA-Y0               PIC 9(05) VALUE 01000.
          05 WS-DELTA2-Y0              PIC 9(05) VALUE 01000.
          05 WS-CONTINUOUS-CHARGE      PIC 9(09) VALUE 0.
          05 WS-TRANSFERRED-TOTAL      PIC 9(12) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-SOURCE-WHEEL        VALUE 2.
             88 INVALID-TRANSFER-DELTA      VALUE 3.
             88 INVALID-STRATEGY-COUNT      VALUE 4.
             88 INTERPOLATOR-BOUND-FAIL     VALUE 5.
             88 GATING-CLAMP-OVERFLOW       VALUE 6.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 7.
             88 CASCADE-ROLLBACK-FAIL       VALUE 8.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-TRANSFER-BUS
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SOURCE-WHEEL-VAL EQUAL ZERO
               SET INVALID-SOURCE-WHEEL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-TRANSFER-DELTA-VAL EQUAL ZERO
               SET INVALID-TRANSFER-DELTA TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-STRATEGY-COUNT < 1 OR WS-STRATEGY-COUNT > 8
               SET INVALID-STRATEGY-COUNT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-INTERP-STEP-S-Q16 > 65536
               SET INTERPOLATOR-BOUND-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-TRANSFER-BUS.
           MOVE WS-SOURCE-WHEEL-VAL TO WS-ROOT-SHADOW-WHEEL.

           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-STRATEGY-COUNT) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-CONTINUOUS-CHARGE = WS-TRANSFER-DELTA-VAL + 
               ((WS-INTERP-STEP-S-Q16 * WS-DELTA-Y0) / 65536) +
               (((WS-INTERP-STEP-S-Q16 * (WS-INTERP-STEP-S-Q16 - 65536) / 65536) * WS-DELTA2-Y0) / 131072).

           COMPUTE WS-TRANSFERRED-TOTAL = WS-SOURCE-WHEEL-VAL + (((WS-CONTINUOUS-CHARGE * WS-G-GATE-FACTOR) / 1000)).

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-ROOT-SHADOW-WHEEL TO WS-COMMITTED-OUTPUT
           ELSE
               MOVE WS-TRANSFERRED-TOTAL TO WS-COMMITTED-OUTPUT
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-ROOT-SHADOW-WHEEL NOT EQUAL WS-SOURCE-WHEEL-VAL
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-ROOT-SHADOW-WHEEL
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
