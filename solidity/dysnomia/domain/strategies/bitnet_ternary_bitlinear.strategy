        IDENTIFICATION DIVISION.
        PROGRAM-ID. BITNET-TERNARY-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / BITNET QAT AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-BIT-PARAMS.
           05 WS-HIDDEN-DIM             PIC 9(05) VALUE 04096.
           05 WS-FFN-DIM                PIC 9(05) VALUE 14336.
           05 WS-TERNARY-COUNT          PIC 9(02) VALUE 03.
           05 WS-QAT-FLAG               PIC 9(01) VALUE 1.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-BIT-VITALITY           PIC 9(09) VALUE 0.
           05 WS-BIT-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-BIT-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-BIT-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 INVALID-HIDDEN-DIM          VALUE 2.
              88 INVALID-FFN-DIM             VALUE 3.
              88 INVALID-TERNARY-STATES      VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 BITLINEAR-QAT-FAIL          VALUE 6.
              88 TERNARY-DIVERG-FAIL         VALUE 7.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 8.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-BITNET
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-HIDDEN-DIM < 512 OR WS-HIDDEN-DIM > 8192
                SET INVALID-HIDDEN-DIM TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-FFN-DIM < 1024 OR WS-FFN-DIM > 32768
                SET INVALID-FFN-DIM TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-TERNARY-COUNT NOT EQUAL 3
                SET INVALID-TERNARY-STATES TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-QAT-FLAG NOT EQUAL 1
                SET BITLINEAR-QAT-FAIL TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-BITNET.
            COMPUTE WS-BIT-VITALITY = (WS-HIDDEN-DIM / 8) +
                                      (WS-FFN-DIM / 32) +
                                      (WS-TERNARY-COUNT * 128) +
                                      (WS-QAT-FLAG * 256) + 1.

            IF WS-BIT-VITALITY EQUAL ZERO
                SET TERNARY-DIVERG-FAIL TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-BIT-COHERENCE = (WS-TERNARY-COUNT * 64) +
                                       (WS-HIDDEN-DIM / 32) +
                                       (WS-FFN-DIM / 128).

            COMPUTE WS-BIT-REBAR-LATCH = 1470169088 + (WS-HIDDEN-DIM / 4) +
                                         (WS-FFN-DIM / 16) +
                                         (WS-TERNARY-COUNT * 32).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-BIT-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-BIT-VITALITY * 10) +
                                         (WS-BIT-COHERENCE * 10) +
                                         (WS-TERNARY-COUNT * 1000) +
                                         (WS-BIT-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-BIT-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-BIT-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
