        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FULL-STACK.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FULL-STACK-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1596-STACK-OK          PIC 9(01) VALUE 1.
            05  WS-TH1597-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1598-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1599-1600M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1600-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-FULL-STACK-WIT           PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-FULL-STACK.
            GOBACK.
        1000-EVALUATE-FULL-STACK.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1596-STACK-OK = 1 AND
               WS-TH1597-DATBIN-STRAT-OK = 1 AND
               WS-TH1598-SUBMICRO-LAT-OK = 1 AND
               WS-TH1599-1600M-SAAT-OK = 1 AND
               WS-TH1600-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-FULL-STACK-WIT
            ELSE
                MOVE 0 TO WS-FULL-STACK-WIT.
