       IDENTIFICATION DIVISION.
       PROGRAM-ID. WMQ-PBX-MIND-RESOLVER-STRATEGY.
       AUTHOR. AUNCIENT DYSNOMIA VM / WMQ / MIND PBX AUDIT.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-WMQ-PARAMETERS.
          05 WS-DIGIT-1                PIC 9(01) VALUE 5.
          05 WS-DIGIT-2                PIC 9(01) VALUE 5.
          05 WS-DIGIT-3                PIC 9(01) VALUE 7.
          05 WS-DIGIT-4                PIC 9(01) VALUE 0.
          05 WS-TRUNK-LINE-ID          PIC 9(02) VALUE 12.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-PLL-PHASE-ERR          PIC S9(05) VALUE +00064.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-MIND-SECTOR-OFFSET     PIC 9(05) VALUE 0.
          05 WS-SHADOW-SCSI-BASELINE   PIC 9(12) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.
          05 WS-ABS-PHASE-ERR          PIC 9(05) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-DIAL-DIGIT          VALUE 2.
             88 INVALID-TRUNK-LINE          VALUE 3.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 4.
             88 PLL-PHASE-LOCK-FAIL         VALUE 5.
             88 GATING-CLAMP-OVERFLOW       VALUE 6.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 7.
             88 CASCADE-ROLLBACK-FAIL       VALUE 8.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-WMQ-RESOLUTION
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-DIGIT-1 > 9 OR WS-DIGIT-2 > 9 OR
              WS-DIGIT-3 > 9 OR WS-DIGIT-4 > 9
               SET INVALID-DIAL-DIGIT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-TRUNK-LINE-ID < 1 OR WS-TRUNK-LINE-ID > 24
               SET INVALID-TRUNK-LINE TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-PLL-PHASE-ERR < -512 OR WS-PLL-PHASE-ERR > +512
               SET PLL-PHASE-LOCK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-WMQ-RESOLUTION.
           COMPUTE WS-MIND-SECTOR-OFFSET = (WS-DIGIT-1 * 1000) + (WS-DIGIT-2 * 100) + (WS-DIGIT-3 * 10) + WS-DIGIT-4.
           COMPUTE WS-SHADOW-SCSI-BASELINE = (WS-TRUNK-LINE-ID * 100000) + (WS-CICS-WRITER-ID * 1000) + WS-MIND-SECTOR-OFFSET.

           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-TRUNK-LINE-ID) / 24).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-PLL-PHASE-ERR < 0
               COMPUTE WS-ABS-PHASE-ERR = - WS-PLL-PHASE-ERR
           ELSE
               MOVE WS-PLL-PHASE-ERR TO WS-ABS-PHASE-ERR
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-SCSI-BASELINE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = (((WS-SHADOW-SCSI-BASELINE + ((512 - WS-ABS-PHASE-ERR) * 32)) * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-SCSI-BASELINE NOT EQUAL ((WS-TRUNK-LINE-ID * 100000) + (WS-CICS-WRITER-ID * 1000) + WS-MIND-SECTOR-OFFSET)
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-SCSI-BASELINE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
