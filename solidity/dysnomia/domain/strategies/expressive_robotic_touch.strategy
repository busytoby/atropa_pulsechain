        IDENTIFICATION DIVISION.
        PROGRAM-ID. ERT-ROB-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / EXPRESSIVE ROBOTIC TOUCH AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-ERT-PARAMS.
           05 WS-ACTUATION-LAT-MS       PIC 9(02) VALUE 12.
           05 WS-OTHERNESS-FID-M        PIC 9(04) VALUE 0960.
           05 WS-DISP-RESIDUAL-UM       PIC 9(02) VALUE 01.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-ERT-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-ERT-VITALITY           PIC 9(09) VALUE 0.
           05 WS-ERT-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-ERT-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-ERT-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 ACTU-LAT-OUT-OF-BOUNDS      VALUE 2.
              88 OTHERNESS-FIDELITY-LOW      VALUE 3.
              88 RESIDUAL-EXCEEDED           VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 ROBOTIC-COLLAPSE            VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-ROBOTIC-TOUCH
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3 AND WS-K-EXPONENT NOT EQUAL 4
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-ACTUATION-LAT-MS < 5 OR WS-ACTUATION-LAT-MS > 25
                SET ACTU-LAT-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-OTHERNESS-FID-M < 850 OR WS-OTHERNESS-FID-M > 1000
                SET OTHERNESS-FIDELITY-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-DISP-RESIDUAL-UM < 0 OR WS-DISP-RESIDUAL-UM > 5
                SET RESIDUAL-EXCEEDED TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-ROBOTIC-TOUCH.
            COMPUTE WS-ERT-COMPOSITE = ((30 - WS-ACTUATION-LAT-MS) * 20) +
                                       (WS-OTHERNESS-FID-M / 2) +
                                       ((10 - WS-DISP-RESIDUAL-UM) * 40).

            COMPUTE WS-ERT-VITALITY = (WS-ERT-COMPOSITE / 4) +
                                      (WS-OTHERNESS-FID-M / 4) +
                                      ((30 - WS-ACTUATION-LAT-MS) * 4) + 1.

            IF WS-ERT-VITALITY EQUAL ZERO
                SET ROBOTIC-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-ERT-COHERENCE = (WS-ERT-COMPOSITE / 16) +
                                       (WS-OTHERNESS-FID-M / 16) +
                                       ((30 - WS-ACTUATION-LAT-MS) * 2).

            COMPUTE WS-ERT-REBAR-LATCH = 1470169088 +
                                         (WS-ERT-COMPOSITE / 2) +
                                         ((30 - WS-ACTUATION-LAT-MS) * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-ERT-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-ERT-VITALITY * 10) +
                                         (WS-ERT-COHERENCE * 10) +
                                         (WS-ERT-COMPOSITE * 10) +
                                         (WS-ERT-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-ERT-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-ERT-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
