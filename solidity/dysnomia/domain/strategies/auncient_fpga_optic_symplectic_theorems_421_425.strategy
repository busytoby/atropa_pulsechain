        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-OPTIC-SYMPLECTIC.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-OPTIC-SYMP-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH421-PHASE-SPACE-OK     PIC 9(01) VALUE 1.
            05  WS-TH422-COHERENCE-OK       PIC 9(01) VALUE 1.
            05  WS-TH423-FET-GAMMA-OK       PIC 9(01) VALUE 1.
            05  WS-TH424-SYMP-SAAT-OK       PIC 9(01) VALUE 1.
            05  WS-TH425-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-OPTIC-SYMP-WIT      PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-OPTIC-SYMP.
            GOBACK.
        1000-EVALUATE-OPTIC-SYMP.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH421-PHASE-SPACE-OK = 1 AND
               WS-TH422-COHERENCE-OK = 1 AND
               WS-TH423-FET-GAMMA-OK = 1 AND
               WS-TH424-SYMP-SAAT-OK = 1 AND
               WS-TH425-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-OPTIC-SYMP-WIT
            ELSE
                MOVE 0 TO WS-FPGA-OPTIC-SYMP-WIT.
