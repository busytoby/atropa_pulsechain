        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-BEYOND-780.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-BEYOND-780-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH781-NCL-DUAL-RAIL-OK   PIC 9(01) VALUE 1.
            05  WS-TH782-NULL-CYCLE-OK      PIC 9(01) VALUE 1.
            05  WS-TH783-CLOCKLESS-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH784-785M-SAAT-OK       PIC 9(01) VALUE 1.
            05  WS-TH785-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-BEYOND-780-WIT      PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-BEYOND-780.
            GOBACK.
        1000-EVALUATE-BEYOND-780.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH781-NCL-DUAL-RAIL-OK = 1 AND
               WS-TH782-NULL-CYCLE-OK = 1 AND
               WS-TH783-CLOCKLESS-LAT-OK = 1 AND
               WS-TH784-785M-SAAT-OK = 1 AND
               WS-TH785-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-BEYOND-780-WIT
            ELSE
                MOVE 0 TO WS-FPGA-BEYOND-780-WIT.
