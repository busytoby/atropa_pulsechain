        IDENTIFICATION DIVISION.
        PROGRAM-ID. PTS-VIS-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / PROTEUS VISUALIZATION ADAPTATION AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-PTS-PARAMS.
           05 WS-ADAPTATION-LAT-MS      PIC 9(02) VALUE 12.
           05 WS-SEMANTIC-FID-M         PIC 9(04) VALUE 0960.
           05 WS-REFLOW-JITTER-UM       PIC 9(02) VALUE 01.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-PTS-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-PTS-VITALITY           PIC 9(09) VALUE 0.
           05 WS-PTS-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-PTS-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-PTS-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 ADAPT-LAT-OUT-OF-BOUNDS     VALUE 2.
              88 SEMANTIC-FIDELITY-LOW       VALUE 3.
              88 JITTER-EXCEEDED             VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 PROTEUS-COLLAPSE            VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-PROTEUS-ADAPT
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3 AND WS-K-EXPONENT NOT EQUAL 4
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-ADAPTATION-LAT-MS < 5 OR WS-ADAPTATION-LAT-MS > 25
                SET ADAPT-LAT-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-SEMANTIC-FID-M < 850 OR WS-SEMANTIC-FID-M > 1000
                SET SEMANTIC-FIDELITY-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-REFLOW-JITTER-UM < 0 OR WS-REFLOW-JITTER-UM > 5
                SET JITTER-EXCEEDED TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-PROTEUS-ADAPT.
            COMPUTE WS-PTS-COMPOSITE = ((30 - WS-ADAPTATION-LAT-MS) * 20) +
                                       (WS-SEMANTIC-FID-M / 2) +
                                       ((10 - WS-REFLOW-JITTER-UM) * 40).

            COMPUTE WS-PTS-VITALITY = (WS-PTS-COMPOSITE / 4) +
                                      (WS-SEMANTIC-FID-M / 4) +
                                      ((30 - WS-ADAPTATION-LAT-MS) * 4) + 1.

            IF WS-PTS-VITALITY EQUAL ZERO
                SET PROTEUS-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-PTS-COHERENCE = (WS-PTS-COMPOSITE / 16) +
                                       (WS-SEMANTIC-FID-M / 16) +
                                       ((30 - WS-ADAPTATION-LAT-MS) * 2).

            COMPUTE WS-PTS-REBAR-LATCH = 1470169088 +
                                         (WS-PTS-COMPOSITE / 2) +
                                         ((30 - WS-ADAPTATION-LAT-MS) * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-PTS-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-PTS-VITALITY * 10) +
                                         (WS-PTS-COHERENCE * 10) +
                                         (WS-PTS-COMPOSITE * 10) +
                                         (WS-PTS-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-PTS-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-PTS-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
