IDENTIFICATION DIVISION.
PROGRAM-ID. PROG-HARVARD-1946-INTERPOLATOR.

DATA DIVISION.
01 D0-SUBSTRATE-TRUNK.
   05 D0-MOTZKIN-PRIME     PIC 9(9) USAGE R0.
   05 D0-K-EXPONENT        PIC 9(9) USAGE R1.
   05 D0-TAPE-SKEW-FLAG    PIC 9(9) USAGE R2.
01 D1-TAPE-TABLE-SHADOW.
   05 D1-BASE-Y0           PIC 9(9) USAGE R3.
   05 D1-SUB-INTERVAL-DX   PIC 9(9) USAGE R4.
   05 D1-SHADOW-Y0-SNAP    PIC 9(9) USAGE R5.
01 D2-DIFFERENCE-STAGE.
   05 D2-DELTA1            PIC 9(9) USAGE R6.
   05 D2-INTERPOLATED-VAL  PIC 9(9) USAGE R7.
   05 D2-COMMITTED-STATE   PIC 9(9) USAGE R8.
01 D3-LEAF-EVAL.
   05 D3-PROOF-RULING      PIC 9(9) USAGE R9.
   05 D3-DISP-WRAP-MOD     PIC 9(9) USAGE R10.

PROCEDURE DIVISION.
    MOVE 953467954 TO D0-MOTZKIN-PRIME.
    MOVE 3 TO D0-K-EXPONENT.
    MOVE 0 TO D0-TAPE-SKEW-FLAG.
    MOVE 65536 TO D1-BASE-Y0.
    MOVE 32768 TO D1-SUB-INTERVAL-DX.

    PERFORM STAGE-TABLE-INTERPOLATION.
    PERFORM APPLY-TAPE-COMMIT-ROLLBACK.
    PERFORM SYNC-DISPLACEMENT.

    IF D1-SHADOW-Y0-SNAP == D1-BASE-Y0
        MOVE 0 TO D3-PROOF-RULING
        SET depth 4
    ELSE
        MOVE 4 TO D3-PROOF-RULING
        SET depth 1
    END-IF.

    EVAL.
    GO TO END-STRATEGY.

STAGE-TABLE-INTERPOLATION.
    comment Snapshot baseline table point;
    MOVE D1-BASE-Y0 TO D1-SHADOW-Y0-SNAP.
    comment Delta1 = y1 - y0 = 64512 - 65536 = -1024;
    MOVE 1024 TO D2-DELTA1.
    comment Linear interpolation step y0 - (dx * delta1) / 65536;
    COMPUTE D2-INTERPOLATED-VAL = D1-BASE-Y0 - ((D1-SUB-INTERVAL-DX * D2-DELTA1) / 65536).
    EXIT.

APPLY-TAPE-COMMIT-ROLLBACK.
    IF D0-TAPE-SKEW-FLAG == 1
        MOVE D1-SHADOW-Y0-SNAP TO D2-COMMITTED-STATE
    ELSE
        MOVE D2-INTERPOLATED-VAL TO D2-COMMITTED-STATE
    END-IF.
    EXIT.

SYNC-DISPLACEMENT.
    COMPUTE D3-DISP-WRAP-MOD = D2-COMMITTED-STATE - ((D2-COMMITTED-STATE / 256) * 256).
    EXIT.

END-STRATEGY.
