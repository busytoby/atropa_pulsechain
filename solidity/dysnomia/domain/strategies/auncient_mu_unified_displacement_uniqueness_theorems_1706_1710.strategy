        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-DISP-UNIQ.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-DISP-UNIQ-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1706-DISP-UNIQ-OK      PIC 9(01) VALUE 1.
            05  WS-TH1707-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1708-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1709-1710M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1710-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-DISP-UNIQ-WIT            PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-DISP-UNIQ.
            GOBACK.
        1000-EVALUATE-DISP-UNIQ.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1706-DISP-UNIQ-OK = 1 AND
               WS-TH1707-DATBIN-STRAT-OK = 1 AND
               WS-TH1708-SUBMICRO-LAT-OK = 1 AND
               WS-TH1709-1710M-SAAT-OK = 1 AND
               WS-TH1710-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-DISP-UNIQ-WIT
            ELSE
                MOVE 0 TO WS-DISP-UNIQ-WIT.
