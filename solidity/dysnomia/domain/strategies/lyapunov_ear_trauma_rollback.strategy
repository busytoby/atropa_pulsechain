       IDENTIFICATION DIVISION.
       PROGRAM-ID. LYAPUNOV-TRAUMA-STRATEGY.
       AUTHOR. AUNCIENT DYSNOMIA VM / TRAUMA ROLLBACK.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-TRAUMA-PARAMS.
          05 WS-IMPULSE-SPL-DB         PIC 9(05) VALUE 35000.
          05 WS-ATTENUATION-CYCLES-N   PIC 9(02) VALUE 16.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-BURST         PIC X(01) VALUE 'Y'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-CURRENT-SPL-LEVEL      PIC 9(05) VALUE 0.
          05 WS-STEP-IDX               PIC 9(02) VALUE 0.
          05 WS-IMPULSE-MOD            PIC 9(03) VALUE 0.
          05 WS-SHADOW-TRAUMA-BASE     PIC 9(12) VALUE 0.
          05 WS-CYC-MOD                PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-IMPULSE-LEVEL       VALUE 2.
             88 INVALID-ATTEN-CYCLES        VALUE 3.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 4.
             88 TRAUMA-DISSIPATION-FAIL     VALUE 5.
             88 GATING-CLAMP-OVERFLOW       VALUE 6.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 7.
             88 CASCADE-ROLLBACK-FAIL       VALUE 8.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-TRAUMA-INTERCEPTION
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-IMPULSE-SPL-DB > 50000
               SET INVALID-IMPULSE-LEVEL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-ATTENUATION-CYCLES-N < 1 OR WS-ATTENUATION-CYCLES-N > 64
               SET INVALID-ATTEN-CYCLES TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-TRAUMA-INTERCEPTION.
           MOVE WS-IMPULSE-SPL-DB TO WS-CURRENT-SPL-LEVEL.

           PERFORM VARYING WS-STEP-IDX FROM 1 BY 1 UNTIL WS-STEP-IDX > WS-ATTENUATION-CYCLES-N
               COMPUTE WS-CURRENT-SPL-LEVEL = (WS-CURRENT-SPL-LEVEL * 875) / 1000
           END-PERFORM.

           IF WS-CURRENT-SPL-LEVEL > WS-IMPULSE-SPL-DB
               SET TRAUMA-DISSIPATION-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-IMPULSE-MOD = FUNCTION MOD(WS-IMPULSE-SPL-DB, 1000).

           COMPUTE WS-SHADOW-TRAUMA-BASE = (WS-CICS-WRITER-ID * 1000000) + 
               (WS-ATTENUATION-CYCLES-N * 10000) + (WS-IMPULSE-MOD * 10) + (WS-CURRENT-SPL-LEVEL / 16).

           COMPUTE WS-CYC-MOD = FUNCTION MOD(WS-ATTENUATION-CYCLES-N, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-CYC-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-BURST EQUAL 'Y' OR WS-IMPULSE-SPL-DB > 20000
               MOVE WS-SHADOW-TRAUMA-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-TRAUMA-BASE + ((WS-CURRENT-SPL-LEVEL * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-TRAUMA-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-ATTENUATION-CYCLES-N * 10000) + (WS-IMPULSE-MOD * 10) + (WS-CURRENT-SPL-LEVEL / 16))
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF (WS-SIMULATE-BURST EQUAL 'Y' OR WS-IMPULSE-SPL-DB > 20000) AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-TRAUMA-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
