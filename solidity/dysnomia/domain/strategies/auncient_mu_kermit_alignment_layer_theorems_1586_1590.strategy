        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-KERMIT-ALIGN.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-KERMIT-ALIGN-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1586-ALIGN-OK          PIC 9(01) VALUE 1.
            05  WS-TH1587-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1588-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1589-1590M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1590-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-KERMIT-ALIGN-WIT         PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-KERMIT-ALIGN.
            GOBACK.
        1000-EVALUATE-KERMIT-ALIGN.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1586-ALIGN-OK = 1 AND
               WS-TH1587-DATBIN-STRAT-OK = 1 AND
               WS-TH1588-SUBMICRO-LAT-OK = 1 AND
               WS-TH1589-1590M-SAAT-OK = 1 AND
               WS-TH1590-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-KERMIT-ALIGN-WIT
            ELSE
                MOVE 0 TO WS-KERMIT-ALIGN-WIT.
