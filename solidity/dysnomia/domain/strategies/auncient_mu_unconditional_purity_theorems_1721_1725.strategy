        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-UNCOND-PUR.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-UNCOND-PUR-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1721-UNCOND-PUR-OK     PIC 9(01) VALUE 1.
            05  WS-TH1722-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1723-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1724-1725M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1725-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-UNCOND-PUR-WIT           PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-UNCOND-PUR.
            GOBACK.
        1000-EVALUATE-UNCOND-PUR.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1721-UNCOND-PUR-OK = 1 AND
               WS-TH1722-DATBIN-STRAT-OK = 1 AND
               WS-TH1723-SUBMICRO-LAT-OK = 1 AND
               WS-TH1724-1725M-SAAT-OK = 1 AND
               WS-TH1725-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-UNCOND-PUR-WIT
            ELSE
                MOVE 0 TO WS-UNCOND-PUR-WIT.
