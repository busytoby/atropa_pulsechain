        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-KERN-INTRCPT.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-KERN-INTRCPT-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1666-KERN-INTRCPT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1667-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1668-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1669-1670M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1670-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-KERN-INTRCPT-WIT         PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-KERN-INTRCPT.
            GOBACK.
        1000-EVALUATE-KERN-INTRCPT.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1666-KERN-INTRCPT-OK = 1 AND
               WS-TH1667-DATBIN-STRAT-OK = 1 AND
               WS-TH1668-SUBMICRO-LAT-OK = 1 AND
               WS-TH1669-1670M-SAAT-OK = 1 AND
               WS-TH1670-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-KERN-INTRCPT-WIT
            ELSE
                MOVE 0 TO WS-KERN-INTRCPT-WIT.
