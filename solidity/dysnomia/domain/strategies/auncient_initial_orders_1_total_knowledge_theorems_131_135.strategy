        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-INIT-ORDERS-1-TK-131-135.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-INIT-ORDERS-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH131-TK-PRECOND-OK      PIC 9(01) VALUE 1.
            05  WS-TH132-31WORD-LIMIT-OK    PIC 9(01) VALUE 1.
            05  WS-TH133-RELOC-ARITH-OK     PIC 9(01) VALUE 1.
            05  WS-TH134-PREFETCH-AUDIT-OK  PIC 9(01) VALUE 1.
            05  WS-TH135-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-INIT-ORDERS-WITNESS      PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-INIT-ORDERS.
            GOBACK.
        1000-EVALUATE-INIT-ORDERS.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH131-TK-PRECOND-OK = 1 AND
               WS-TH132-31WORD-LIMIT-OK = 1 AND
               WS-TH133-RELOC-ARITH-OK = 1 AND
               WS-TH134-PREFETCH-AUDIT-OK = 1 AND
               WS-TH135-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-INIT-ORDERS-WITNESS
            ELSE
                MOVE 0 TO WS-INIT-ORDERS-WITNESS.
