        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-OPTIC-VERLET.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-OPTIC-VERLET-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH416-WDM-ROUTING-OK     PIC 9(01) VALUE 1.
            05  WS-TH417-SUPER8-FPS-OK      PIC 9(01) VALUE 1.
            05  WS-TH418-VERLET-RULE10-OK   PIC 9(01) VALUE 1.
            05  WS-TH419-VERLET-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH420-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-OPTIC-VERLET-WIT    PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-OPTIC-VERLET.
            GOBACK.
        1000-EVALUATE-OPTIC-VERLET.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH416-WDM-ROUTING-OK = 1 AND
               WS-TH417-SUPER8-FPS-OK = 1 AND
               WS-TH418-VERLET-RULE10-OK = 1 AND
               WS-TH419-VERLET-SAAT-OK = 1 AND
               WS-TH420-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-OPTIC-VERLET-WIT
            ELSE
                MOVE 0 TO WS-FPGA-OPTIC-VERLET-WIT.
