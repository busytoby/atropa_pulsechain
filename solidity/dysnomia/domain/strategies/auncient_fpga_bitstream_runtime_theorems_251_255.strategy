        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-RUNTIME.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-RUNTIME-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH251-PR-INTEGRITY-OK    PIC 9(01) VALUE 1.
            05  WS-TH252-DMA-THROUGHPUT-OK  PIC 9(01) VALUE 1.
            05  WS-TH253-CDC-METASTABLE-OK  PIC 9(01) VALUE 1.
            05  WS-TH254-HOT-SWAP-OK        PIC 9(01) VALUE 1.
            05  WS-TH255-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-RUNTIME-WITNESS     PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-FPGA-RUNTIME.
            GOBACK.
        1000-EVALUATE-FPGA-RUNTIME.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH251-PR-INTEGRITY-OK = 1 AND
               WS-TH252-DMA-THROUGHPUT-OK = 1 AND
               WS-TH253-CDC-METASTABLE-OK = 1 AND
               WS-TH254-HOT-SWAP-OK = 1 AND
               WS-TH255-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-RUNTIME-WITNESS
            ELSE
                MOVE 0 TO WS-FPGA-RUNTIME-WITNESS.
