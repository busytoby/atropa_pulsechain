        IDENTIFICATION DIVISION.
        PROGRAM-ID. NUBIA-SIM-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / NUBIA SEMANTIC AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-NUBIA-PARAMS.
           05 WS-SENT-SIM               PIC 9(04) VALUE 0400.
           05 WS-ENTAIL-PROB            PIC 9(04) VALUE 0420.
           05 WS-COHERENCE              PIC 9(04) VALUE 0450.
           05 WS-VALID-FLAG             PIC 9(01) VALUE 1.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-COMPOSITE-NUBIA        PIC 9(04) VALUE 0.
           05 WS-NUBIA-VITALITY         PIC 9(09) VALUE 0.
           05 WS-NUBIA-COHERENCE        PIC 9(09) VALUE 0.
           05 WS-NUBIA-REBAR-LATCH      PIC 9(12) VALUE 0.
           05 WS-SHADOW-NUBIA-BASE      PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 INVALID-SENT-SIM            VALUE 2.
              88 INVALID-ENTAIL-PROB         VALUE 3.
              88 INVALID-COHERENCE           VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 NUBIA-VALIDITY-FAIL         VALUE 6.
              88 NUBIA-DIVERG-FAIL           VALUE 7.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 8.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-NUBIA-SIMILARITY
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-SENT-SIM < 100 OR WS-SENT-SIM > 1000
                SET INVALID-SENT-SIM TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-ENTAIL-PROB < 100 OR WS-ENTAIL-PROB > 1000
                SET INVALID-ENTAIL-PROB TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-COHERENCE < 100 OR WS-COHERENCE > 1000
                SET INVALID-COHERENCE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-VALID-FLAG NOT EQUAL 1
                SET NUBIA-VALIDITY-FAIL TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-NUBIA-SIMILARITY.
            COMPUTE WS-COMPOSITE-NUBIA = ((WS-SENT-SIM * 4) / 10) +
                                         ((WS-ENTAIL-PROB * 4) / 10) +
                                         ((WS-COHERENCE * 2) / 10).

            COMPUTE WS-NUBIA-VITALITY = (WS-COMPOSITE-NUBIA / 2) +
                                        (WS-SENT-SIM / 4) +
                                        (WS-ENTAIL-PROB / 4) +
                                        (WS-VALID-FLAG * 256) + 1.

            IF WS-NUBIA-VITALITY EQUAL ZERO
                SET NUBIA-DIVERG-FAIL TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-NUBIA-COHERENCE = (WS-COMPOSITE-NUBIA / 4) +
                                         (WS-COHERENCE / 8) +
                                         (WS-ENTAIL-PROB / 8).

            COMPUTE WS-NUBIA-REBAR-LATCH = 1470169088 + (WS-COMPOSITE-NUBIA / 2) +
                                           (WS-SENT-SIM / 4) +
                                           (WS-COHERENCE / 8).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-NUBIA-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                           (WS-NUBIA-VITALITY * 10) +
                                           (WS-NUBIA-COHERENCE * 10) +
                                           (WS-COMPOSITE-NUBIA * 100) +
                                           (WS-NUBIA-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-NUBIA-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-NUBIA-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
