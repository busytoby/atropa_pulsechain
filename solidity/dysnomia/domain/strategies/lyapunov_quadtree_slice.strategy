       IDENTIFICATION DIVISION.
       PROGRAM-ID. LYAPUNOV-QUADTREE-STRATEGY.
       AUTHOR. AUNCIENT DYSNOMIA VM / QUADTREE SLICE.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-QUADTREE-PARAMS.
          05 WS-MEDIA-EXT-CODE         PIC 9(01) VALUE 1.
          05 WS-SLICE-DEPTH-D          PIC 9(02) VALUE 16.
          05 WS-INIT-SUBDIV-ENERGY     PIC 9(05) VALUE 20000.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-CURRENT-SUBDIV-E       PIC 9(05) VALUE 0.
          05 WS-STEP-IDX               PIC 9(02) VALUE 0.
          05 WS-SHADOW-QUAD-BASE       PIC 9(12) VALUE 0.
          05 WS-CYC-MOD                PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-MEDIA-EXTENSION     VALUE 2.
             88 INVALID-SLICE-DEPTH         VALUE 3.
             88 INVALID-SUBDIV-ENERGY       VALUE 4.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
             88 SLICING-DIVERGENCE-FAIL     VALUE 6.
             88 GATING-CLAMP-OVERFLOW       VALUE 7.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 8.
             88 CASCADE-ROLLBACK-FAIL       VALUE 9.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-SUBDIVISION-LOOP
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-MEDIA-EXT-CODE NOT EQUAL 1
               SET INVALID-MEDIA-EXTENSION TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SLICE-DEPTH-D < 1 OR WS-SLICE-DEPTH-D > 16
               SET INVALID-SLICE-DEPTH TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-INIT-SUBDIV-ENERGY > 50000
               SET INVALID-SUBDIV-ENERGY TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-SUBDIVISION-LOOP.
           MOVE WS-INIT-SUBDIV-ENERGY TO WS-CURRENT-SUBDIV-E.

           PERFORM VARYING WS-STEP-IDX FROM 1 BY 1 UNTIL WS-STEP-IDX > WS-SLICE-DEPTH-D
               COMPUTE WS-CURRENT-SUBDIV-E = (WS-CURRENT-SUBDIV-E * 875) / 1000
           END-PERFORM.

           IF WS-CURRENT-SUBDIV-E > WS-INIT-SUBDIV-ENERGY
               SET SLICING-DIVERGENCE-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-SHADOW-QUAD-BASE = (WS-CICS-WRITER-ID * 1000000) + 
               (WS-SLICE-DEPTH-D * 10000) + (WS-MEDIA-EXT-CODE * 100) + (WS-CURRENT-SUBDIV-E / 16).

           COMPUTE WS-CYC-MOD = FUNCTION MOD(WS-SLICE-DEPTH-D, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-CYC-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-QUAD-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-QUAD-BASE + ((WS-CURRENT-SUBDIV-E * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-QUAD-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-SLICE-DEPTH-D * 10000) + (WS-MEDIA-EXT-CODE * 100) + (WS-CURRENT-SUBDIV-E / 16))
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-QUAD-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
