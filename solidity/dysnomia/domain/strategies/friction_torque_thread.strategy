        IDENTIFICATION DIVISION.
        PROGRAM-ID. FTT-THR-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / FRICTION TORQUE THREAD AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-FTT-PARAMS.
           05 WS-PITCH-LAT-MS           PIC 9(02) VALUE 12.
           05 WS-TORQUE-FIDELITY-M      PIC 9(04) VALUE 0960.
           05 WS-LEAD-DISP-UM           PIC 9(02) VALUE 01.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-FTT-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-FTT-VITALITY           PIC 9(09) VALUE 0.
           05 WS-FTT-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-FTT-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-FTT-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 PITCH-LAT-OUT-OF-BOUNDS     VALUE 2.
              88 FRICTION-TORQUE-LOW         VALUE 3.
              88 LEAD-DISP-EXCEEDED          VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 THREAD-COLLAPSE             VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-THREAD-TORQUE
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-PITCH-LAT-MS < 5 OR WS-PITCH-LAT-MS > 25
                SET PITCH-LAT-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-TORQUE-FIDELITY-M < 850 OR WS-TORQUE-FIDELITY-M > 1000
                SET FRICTION-TORQUE-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-LEAD-DISP-UM < 0 OR WS-LEAD-DISP-UM > 5
                SET LEAD-DISP-EXCEEDED TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-THREAD-TORQUE.
            COMPUTE WS-FTT-COMPOSITE = ((30 - WS-PITCH-LAT-MS) * 20) +
                                       (WS-TORQUE-FIDELITY-M / 2) +
                                       ((10 - WS-LEAD-DISP-UM) * 40).

            COMPUTE WS-FTT-VITALITY = (WS-FTT-COMPOSITE / 4) +
                                      (WS-TORQUE-FIDELITY-M / 4) +
                                      ((30 - WS-PITCH-LAT-MS) * 4) + 1.

            IF WS-FTT-VITALITY EQUAL ZERO
                SET THREAD-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-FTT-COHERENCE = (WS-FTT-COMPOSITE / 16) +
                                       (WS-TORQUE-FIDELITY-M / 16) +
                                       ((30 - WS-PITCH-LAT-MS) * 2).

            COMPUTE WS-FTT-REBAR-LATCH = 1470169088 +
                                         (WS-FTT-COMPOSITE / 2) +
                                         ((30 - WS-PITCH-LAT-MS) * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-FTT-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-FTT-VITALITY * 10) +
                                         (WS-FTT-COHERENCE * 10) +
                                         (WS-FTT-COMPOSITE * 10) +
                                         (WS-FTT-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-FTT-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-FTT-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
