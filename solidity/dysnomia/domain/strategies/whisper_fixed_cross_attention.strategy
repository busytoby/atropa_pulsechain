        IDENTIFICATION DIVISION.
        PROGRAM-ID. WHISPER-CROSSATTN-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / WHISPER CROSS-ATTENTION AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-CROSS-PARAMS.
           05 WS-TIME-STEPS             PIC 9(04) VALUE 1500.
           05 WS-MODEL-DIM              PIC 9(04) VALUE 0512.
           05 WS-HEAD-COUNT             PIC 9(02) VALUE 08.
           05 WS-FIXED-CACHE-FLAG       PIC 9(01) VALUE 1.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-CROSS-VITALITY         PIC 9(09) VALUE 0.
           05 WS-CROSS-COHERENCE        PIC 9(09) VALUE 0.
           05 WS-CROSS-REBAR-LATCH      PIC 9(12) VALUE 0.
           05 WS-SHADOW-CROSS-BASE      PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 INVALID-TIME-STEPS          VALUE 2.
              88 INVALID-MODEL-DIM           VALUE 3.
              88 INVALID-HEAD-COUNT          VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 FIXED-CACHE-FLAG-FAIL       VALUE 6.
              88 CROSS-ATTN-DIVERG-FAIL      VALUE 7.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 8.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-CROSS-ATTENTION
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-TIME-STEPS < 16 OR WS-TIME-STEPS > 3000
                SET INVALID-TIME-STEPS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-MODEL-DIM < 256 OR WS-MODEL-DIM > 2048
                SET INVALID-MODEL-DIM TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-HEAD-COUNT < 1 OR WS-HEAD-COUNT > 32
                SET INVALID-HEAD-COUNT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-FIXED-CACHE-FLAG NOT EQUAL 1
                SET FIXED-CACHE-FLAG-FAIL TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-CROSS-ATTENTION.
            COMPUTE WS-CROSS-VITALITY = (WS-HEAD-COUNT * 512) +
                                        (WS-MODEL-DIM / 4) +
                                        (WS-TIME-STEPS / 8) +
                                        (WS-FIXED-CACHE-FLAG * 256) + 1.

            IF WS-CROSS-VITALITY EQUAL ZERO
                SET CROSS-ATTN-DIVERG-FAIL TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-CROSS-COHERENCE = (WS-HEAD-COUNT * 64) +
                                         (WS-MODEL-DIM / 16) +
                                         (WS-TIME-STEPS / 32).

            COMPUTE WS-CROSS-REBAR-LATCH = 1470169088 + (WS-HEAD-COUNT * 256) +
                                           (WS-MODEL-DIM / 8) +
                                           (WS-TIME-STEPS / 16).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-CROSS-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                           (WS-CROSS-VITALITY * 10) +
                                           (WS-CROSS-COHERENCE * 10) +
                                           (WS-HEAD-COUNT * 1000) +
                                           (WS-CROSS-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-CROSS-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-CROSS-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
