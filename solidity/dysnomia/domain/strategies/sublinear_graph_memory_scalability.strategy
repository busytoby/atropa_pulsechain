        IDENTIFICATION DIVISION.
        PROGRAM-ID. SCA-MEM-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / SUBLINEAR GRAPH MEMORY SCALABILITY AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-SCA-PARAMS.
           05 WS-MEM-REDUCTION-T-PCT    PIC 9(03) VALUE 300.
           05 WS-THROUGHPUT-SPD-T-X     PIC 9(02) VALUE 20.
           05 WS-BATCH-SIZE-NODES       PIC 9(04) VALUE 1024.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-SCA-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-SCA-VITALITY           PIC 9(09) VALUE 0.
           05 WS-SCA-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-SCA-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-SCA-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 MEMORY-REDUCTION-LOW        VALUE 2.
              88 THROUGHPUT-SPEEDUP-LOW      VALUE 3.
              88 BATCH-SIZE-OUT-OF-BOUNDS    VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 SCALABILITY-COLLAPSE        VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-GRAPH-SCALABILITY
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-MEM-REDUCTION-T-PCT < 250 OR WS-MEM-REDUCTION-T-PCT > 400
                SET MEMORY-REDUCTION-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-THROUGHPUT-SPD-T-X < 17 OR WS-THROUGHPUT-SPD-T-X > 24
                SET THROUGHPUT-SPEEDUP-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-BATCH-SIZE-NODES < 256 OR WS-BATCH-SIZE-NODES > 8192
                SET BATCH-SIZE-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-GRAPH-SCALABILITY.
            COMPUTE WS-SCA-COMPOSITE = (WS-MEM-REDUCTION-T-PCT * 2) +
                                       (WS-THROUGHPUT-SPD-T-X * 20) +
                                       (WS-BATCH-SIZE-NODES / 32).

            COMPUTE WS-SCA-VITALITY = (WS-SCA-COMPOSITE / 4) +
                                      (WS-MEM-REDUCTION-T-PCT / 4) +
                                      (WS-THROUGHPUT-SPD-T-X * 2) + 1.

            IF WS-SCA-VITALITY EQUAL ZERO
                SET SCALABILITY-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-SCA-COHERENCE = (WS-SCA-COMPOSITE / 16) +
                                       (WS-MEM-REDUCTION-T-PCT / 16) +
                                       (WS-THROUGHPUT-SPD-T-X / 2).

            COMPUTE WS-SCA-REBAR-LATCH = 1470169088 +
                                         (WS-SCA-COMPOSITE / 2) +
                                         (WS-THROUGHPUT-SPD-T-X * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-SCA-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-SCA-VITALITY * 10) +
                                         (WS-SCA-COHERENCE * 10) +
                                         (WS-SCA-COMPOSITE * 10) +
                                         (WS-SCA-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-SCA-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-SCA-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
