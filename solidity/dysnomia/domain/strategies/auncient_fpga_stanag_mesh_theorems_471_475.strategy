        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-STANAG-MESH.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-STANAG-MESH-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH471-DT-MESH-OK         PIC 9(01) VALUE 1.
            05  WS-TH472-IONO-COHERENCE-OK  PIC 9(01) VALUE 1.
            05  WS-TH473-SCSI-GATING-OK     PIC 9(01) VALUE 1.
            05  WS-TH474-STANAG-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH475-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-STANAG-MESH-WIT     PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-STANAG-MESH.
            GOBACK.
        1000-EVALUATE-STANAG-MESH.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH471-DT-MESH-OK = 1 AND
               WS-TH472-IONO-COHERENCE-OK = 1 AND
               WS-TH473-SCSI-GATING-OK = 1 AND
               WS-TH474-STANAG-SAAT-OK = 1 AND
               WS-TH475-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-STANAG-MESH-WIT
            ELSE
                MOVE 0 TO WS-FPGA-STANAG-MESH-WIT.
