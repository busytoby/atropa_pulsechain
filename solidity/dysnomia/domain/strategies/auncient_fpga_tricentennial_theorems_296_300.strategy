        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-TRICENTENNIAL.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-TRICENTENNIAL-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH296-MASTER-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-TH297-ZERO-JAM-OK        PIC 9(01) VALUE 1.
            05  WS-TH298-GLASSBOX-TK-OK     PIC 9(01) VALUE 1.
            05  WS-TH299-HOGAN-SOLVENCY-OK  PIC 9(01) VALUE 1.
            05  WS-TH300-TRICENTENNIAL-OK   PIC 9(01) VALUE 1.
            05  WS-FPGA-TRICENTENNIAL-WIT   PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-TRICENTENNIAL.
            GOBACK.
        1000-EVALUATE-TRICENTENNIAL.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH296-MASTER-CLOSURE-OK = 1 AND
               WS-TH297-ZERO-JAM-OK = 1 AND
               WS-TH298-GLASSBOX-TK-OK = 1 AND
               WS-TH299-HOGAN-SOLVENCY-OK = 1 AND
               WS-TH300-TRICENTENNIAL-OK = 1
                MOVE 1 TO WS-FPGA-TRICENTENNIAL-WIT
            ELSE
                MOVE 0 TO WS-FPGA-TRICENTENNIAL-WIT.
