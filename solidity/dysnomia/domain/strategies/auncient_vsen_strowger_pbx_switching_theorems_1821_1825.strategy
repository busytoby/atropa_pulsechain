        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-VSEN-STROWGER.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-VSEN-STROWGER-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1821-WIPER-STEP-OK     PIC 9(01) VALUE 1.
            05  WS-TH1822-PLL-JITTER-OK     PIC 9(01) VALUE 1.
            05  WS-TH1823-FAULT-ISOLATE-OK  PIC 9(01) VALUE 1.
            05  WS-TH1824-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1825-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-VSEN-STROWGER-WIT        PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-VSEN-STROWGER.
            GOBACK.
        1000-EVALUATE-VSEN-STROWGER.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1821-WIPER-STEP-OK = 1 AND
               WS-TH1822-PLL-JITTER-OK = 1 AND
               WS-TH1823-FAULT-ISOLATE-OK = 1 AND
               WS-TH1824-SUBMICRO-LAT-OK = 1 AND
               WS-TH1825-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-VSEN-STROWGER-WIT
            ELSE
                MOVE 0 TO WS-VSEN-STROWGER-WIT.
