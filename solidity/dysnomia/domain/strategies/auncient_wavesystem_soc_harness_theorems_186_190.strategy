        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-HARNESS-SOC-186-190.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-HARNESS-SOC-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH186-ALIGNMENT-OK       PIC 9(01) VALUE 1.
            05  WS-TH187-HELMHOLTZ-OK       PIC 9(01) VALUE 1.
            05  WS-TH188-SIGNALFD-OK        PIC 9(01) VALUE 1.
            05  WS-TH189-PROVENANCE-OK      PIC 9(01) VALUE 1.
            05  WS-TH190-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-HARNESS-SOC-WITNESS      PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-HARNESS-SOC.
            GOBACK.
        1000-EVALUATE-HARNESS-SOC.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH186-ALIGNMENT-OK = 1 AND
               WS-TH187-HELMHOLTZ-OK = 1 AND
               WS-TH188-SIGNALFD-OK = 1 AND
               WS-TH189-PROVENANCE-OK = 1 AND
               WS-TH190-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-HARNESS-SOC-WITNESS
            ELSE
                MOVE 0 TO WS-HARNESS-SOC-WITNESS.
