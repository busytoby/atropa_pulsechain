       IDENTIFICATION DIVISION.
       PROGRAM-ID. LYAPUNOV-BARK-BAND-STRATEGY.
       AUTHOR. AUNCIENT DYSNOMIA VM / BARK AUDITORY STABILITY.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-BARK-PARAMETERS.
          05 WS-BARK-BAND-INDEX-B      PIC 9(02) VALUE 05.
          05 WS-INIT-DISSONANCE        PIC 9(05) VALUE 10000.
          05 WS-FILTERING-CYCLES-N     PIC 9(02) VALUE 16.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-NOMINAL-CENTER-FREQ    PIC 9(06) VALUE 0.
          05 WS-CURRENT-DISSONANCE     PIC 9(05) VALUE 0.
          05 WS-STEP-IDX               PIC 9(02) VALUE 0.
          05 WS-SHADOW-BARK-BASE       PIC 9(12) VALUE 0.
          05 WS-CYC-MOD                PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-BARK-BAND           VALUE 2.
             88 INVALID-DISSONANCE          VALUE 3.
             88 INVALID-FILTER-CYCLES       VALUE 4.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
             88 DISSONANCE-DIVERGENCE       VALUE 6.
             88 GATING-CLAMP-OVERFLOW       VALUE 7.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 8.
             88 CASCADE-ROLLBACK-FAIL       VALUE 9.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-BARK-FILTERING
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-BARK-BAND-INDEX-B < 1 OR WS-BARK-BAND-INDEX-B > 24
               SET INVALID-BARK-BAND TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-INIT-DISSONANCE > 50000
               SET INVALID-DISSONANCE TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-FILTERING-CYCLES-N < 1 OR WS-FILTERING-CYCLES-N > 64
               SET INVALID-FILTER-CYCLES TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-BARK-FILTERING.
           IF WS-BARK-BAND-INDEX-B <= 5
               COMPUTE WS-NOMINAL-CENTER-FREQ = 100 * WS-BARK-BAND-INDEX-B
           ELSE
               COMPUTE WS-NOMINAL-CENTER-FREQ = 500 + ((WS-BARK-BAND-INDEX-B - 5) * 600)
           END-IF.

           MOVE WS-INIT-DISSONANCE TO WS-CURRENT-DISSONANCE.

           PERFORM VARYING WS-STEP-IDX FROM 1 BY 1 UNTIL WS-STEP-IDX > WS-FILTERING-CYCLES-N
               COMPUTE WS-CURRENT-DISSONANCE = (WS-CURRENT-DISSONANCE * 875) / 1000
           END-PERFORM.

           IF WS-CURRENT-DISSONANCE > WS-INIT-DISSONANCE
               SET DISSONANCE-DIVERGENCE TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-SHADOW-BARK-BASE = (WS-CICS-WRITER-ID * 1000000) + 
               (WS-BARK-BAND-INDEX-B * 10000) + (WS-NOMINAL-CENTER-FREQ / 4) + WS-CURRENT-DISSONANCE.

           COMPUTE WS-CYC-MOD = FUNCTION MOD(WS-BARK-BAND-INDEX-B, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-CYC-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-BARK-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-BARK-BASE + ((WS-NOMINAL-CENTER-FREQ * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-BARK-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-BARK-BAND-INDEX-B * 10000) + (WS-NOMINAL-CENTER-FREQ / 4) + WS-CURRENT-DISSONANCE)
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-BARK-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
