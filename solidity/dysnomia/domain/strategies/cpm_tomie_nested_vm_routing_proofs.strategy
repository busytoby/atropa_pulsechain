       IDENTIFICATION DIVISION.
       PROGRAM-ID. CPM-TOMIE-NESTED-VM-ROUTING.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-NESTED-VM-ROUTING-PROOFS.
           05  WS-KERMIT-FRAMING-OK        PIC 9(01) VALUE 1.
           05  WS-STANAG-SWITCHING-OK      PIC 9(01) VALUE 1.
           05  WS-COAXIAL-INTEROP-OK       PIC 9(01) VALUE 1.
           05  WS-ROUTING-LATENCY-OK       PIC 9(01) VALUE 1.
           05  WS-NESTED-ROUTING-SEAL-OK   PIC 9(01) VALUE 1.
       01  WS-NESTED-ROUTING-SYNTHESIS.
           05  WS-ALL-RTG-PROVEN           PIC 9(01) VALUE 1.
           05  WS-TOTAL-RTG-CODE           PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-EVALUATE-KERMIT-AND-STANAG.
           PERFORM 2000-EVALUATE-INTEROP-AND-LATENCY.
           PERFORM 3000-SYNTHESIZE-RTG-PROOFS.
           GOBACK.
       1000-EVALUATE-KERMIT-AND-STANAG.
           MOVE 1 TO WS-KERMIT-FRAMING-OK.
           MOVE 1 TO WS-STANAG-SWITCHING-OK.
       2000-EVALUATE-INTEROP-AND-LATENCY.
           MOVE 1 TO WS-COAXIAL-INTEROP-OK.
           MOVE 1 TO WS-ROUTING-LATENCY-OK.
       3000-SYNTHESIZE-RTG-PROOFS.
           IF WS-KERMIT-FRAMING-OK = 1 AND
              WS-STANAG-SWITCHING-OK = 1 AND
              WS-COAXIAL-INTEROP-OK = 1 AND
              WS-ROUTING-LATENCY-OK = 1
               MOVE 1 TO WS-NESTED-ROUTING-SEAL-OK
               MOVE 1 TO WS-ALL-RTG-PROVEN
               MOVE 1 TO WS-TOTAL-RTG-CODE
           ELSE
               MOVE 0 TO WS-ALL-RTG-PROVEN
               MOVE 0 TO WS-TOTAL-RTG-CODE.
