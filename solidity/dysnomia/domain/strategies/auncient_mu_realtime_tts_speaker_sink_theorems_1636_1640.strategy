        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-SPEAKER-SINK.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-SPEAKER-SINK-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1636-SINK-OK           PIC 9(01) VALUE 1.
            05  WS-TH1637-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1638-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1639-1640M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1640-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-SPEAKER-SINK-WIT         PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-SPEAKER-SINK.
            GOBACK.
        1000-EVALUATE-SPEAKER-SINK.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1636-SINK-OK = 1 AND
               WS-TH1637-DATBIN-STRAT-OK = 1 AND
               WS-TH1638-SUBMICRO-LAT-OK = 1 AND
               WS-TH1639-1640M-SAAT-OK = 1 AND
               WS-TH1640-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-SPEAKER-SINK-WIT
            ELSE
                MOVE 0 TO WS-SPEAKER-SINK-WIT.
