       IDENTIFICATION DIVISION.
       PROGRAM-ID. ANKH-GRID-QBAL.
       AUTHOR. AUNCIENT DYSNOMIA VM / GRID QUORUM POWER BALANCER.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-BAL-PARAMS.
          05 WS-INIT-IMBAL-MVA         PIC 9(05) VALUE 15500.
          05 WS-SUBSTATION-COUNT-S     PIC 9(02) VALUE 08.
          05 WS-BALANCING-CYCLES-N     PIC 9(02) VALUE 16.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-CURRENT-IMBAL          PIC 9(05) VALUE 0.
          05 WS-STEP-IDX               PIC 9(02) VALUE 0.
          05 WS-SHADOW-BAL-BASE        PIC 9(12) VALUE 0.
          05 WS-CYC-MOD                PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-IMBAL-MVA           VALUE 2.
             88 INVALID-SUBSTATION-COUNT-S  VALUE 3.
             88 INVALID-BALANCING-CYCLES    VALUE 4.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
             88 POWER-FLOW-DIVERG-FAIL      VALUE 6.
             88 GATING-CLAMP-OVERFLOW       VALUE 7.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 8.
             88 CASCADE-ROLLBACK-FAIL       VALUE 9.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-POWER-BALANCING
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-INIT-IMBAL-MVA > 50000
               SET INVALID-IMBAL-MVA TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SUBSTATION-COUNT-S < 1 OR WS-SUBSTATION-COUNT-S > 16
               SET INVALID-SUBSTATION-COUNT-S TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-BALANCING-CYCLES-N < 1 OR WS-BALANCING-CYCLES-N > 64
               SET INVALID-BALANCING-CYCLES TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-POWER-BALANCING.
           MOVE WS-INIT-IMBAL-MVA TO WS-CURRENT-IMBAL.

           PERFORM VARYING WS-STEP-IDX FROM 1 BY 1 UNTIL WS-STEP-IDX > WS-BALANCING-CYCLES-N
               COMPUTE WS-CURRENT-IMBAL = (WS-CURRENT-IMBAL * 875) / 1000
           END-PERFORM.

           IF WS-CURRENT-IMBAL > WS-INIT-IMBAL-MVA
               SET POWER-FLOW-DIVERG-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-SHADOW-BAL-BASE = (WS-CICS-WRITER-ID * 1000000) + 
               (WS-BALANCING-CYCLES-N * 10000) + (WS-SUBSTATION-COUNT-S * 100) + (WS-CURRENT-IMBAL / 16).

           COMPUTE WS-CYC-MOD = FUNCTION MOD(WS-SUBSTATION-COUNT-S, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-CYC-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-BAL-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-BAL-BASE + ((WS-CURRENT-IMBAL * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-BAL-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-BALANCING-CYCLES-N * 10000) + (WS-SUBSTATION-COUNT-S * 100) + (WS-CURRENT-IMBAL / 16))
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-BAL-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
