        IDENTIFICATION DIVISION.
        PROGRAM-ID. MSR-REP-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / MICRO-ADAPTIVE SEQUENCE REPLANNING AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-MSR-PARAMS.
           05 WS-REPLAN-LAT-MS          PIC 9(02) VALUE 12.
           05 WS-RECOVERY-FID-M         PIC 9(04) VALUE 0960.
           05 WS-SUBSET-PARTS-COUNT     PIC 9(02) VALUE 08.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-MSR-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-MSR-VITALITY           PIC 9(09) VALUE 0.
           05 WS-MSR-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-MSR-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-MSR-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 REPLAN-LAT-OUT-OF-BOUNDS    VALUE 2.
              88 RECOVERY-FID-LOW            VALUE 3.
              88 SUBSET-COUNT-OUT-OF-BOUNDS  VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 REPLANNING-COLLAPSE         VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-SEQUENCE-REPLAN
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-REPLAN-LAT-MS < 5 OR WS-REPLAN-LAT-MS > 25
                SET REPLAN-LAT-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-RECOVERY-FID-M < 850 OR WS-RECOVERY-FID-M > 1000
                SET RECOVERY-FID-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-SUBSET-PARTS-COUNT < 1 OR WS-SUBSET-PARTS-COUNT > 32
                SET SUBSET-COUNT-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-SEQUENCE-REPLAN.
            COMPUTE WS-MSR-COMPOSITE = ((30 - WS-REPLAN-LAT-MS) * 20) +
                                       (WS-RECOVERY-FID-M / 2) +
                                       (WS-SUBSET-PARTS-COUNT * 15).

            COMPUTE WS-MSR-VITALITY = (WS-MSR-COMPOSITE / 4) +
                                      (WS-RECOVERY-FID-M / 4) +
                                      ((30 - WS-REPLAN-LAT-MS) * 4) + 1.

            IF WS-MSR-VITALITY EQUAL ZERO
                SET REPLANNING-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-MSR-COHERENCE = (WS-MSR-COMPOSITE / 16) +
                                       (WS-RECOVERY-FID-M / 16) +
                                       ((30 - WS-REPLAN-LAT-MS) * 2).

            COMPUTE WS-MSR-REBAR-LATCH = 1470169088 +
                                         (WS-MSR-COMPOSITE / 2) +
                                         ((30 - WS-REPLAN-LAT-MS) * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-MSR-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-MSR-VITALITY * 10) +
                                         (WS-MSR-COHERENCE * 10) +
                                         (WS-MSR-COMPOSITE * 10) +
                                         (WS-MSR-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-MSR-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-MSR-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
