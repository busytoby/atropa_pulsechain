        IDENTIFICATION DIVISION.
        PROGRAM-ID. SHC-MOD-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / SUBASSEMBLY HIERARCHY CHUNKING AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-SHC-PARAMS.
           05 WS-CHUNKING-LAT-MS        PIC 9(02) VALUE 20.
           05 WS-MODULARITY-FID-M       PIC 9(04) VALUE 0960.
           05 WS-SEPARATION-DRIFT-MM    PIC 9(02) VALUE 01.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-SHC-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-SHC-VITALITY           PIC 9(09) VALUE 0.
           05 WS-SHC-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-SHC-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-SHC-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 CHUNKING-LAT-OUT-OF-BOUNDS  VALUE 2.
              88 MODULARITY-FIDELITY-LOW     VALUE 3.
              88 SEPARATION-DRIFT-EXCEEDED   VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 CHUNKING-COLLAPSE           VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-HIERARCHY-CHUNKING
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3 AND WS-K-EXPONENT NOT EQUAL 4
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CHUNKING-LAT-MS < 10 OR WS-CHUNKING-LAT-MS > 50
                SET CHUNKING-LAT-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-MODULARITY-FID-M < 850 OR WS-MODULARITY-FID-M > 1000
                SET MODULARITY-FIDELITY-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-SEPARATION-DRIFT-MM < 0 OR WS-SEPARATION-DRIFT-MM > 5
                SET SEPARATION-DRIFT-EXCEEDED TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-HIERARCHY-CHUNKING.
            COMPUTE WS-SHC-COMPOSITE = ((60 - WS-CHUNKING-LAT-MS) * 10) +
                                       (WS-MODULARITY-FID-M / 2) +
                                       ((10 - WS-SEPARATION-DRIFT-MM) * 40).

            COMPUTE WS-SHC-VITALITY = (WS-SHC-COMPOSITE / 4) +
                                      (WS-MODULARITY-FID-M / 4) +
                                      ((60 - WS-CHUNKING-LAT-MS) * 4) + 1.

            IF WS-SHC-VITALITY EQUAL ZERO
                SET CHUNKING-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-SHC-COHERENCE = (WS-SHC-COMPOSITE / 16) +
                                       (WS-MODULARITY-FID-M / 16) +
                                       ((60 - WS-CHUNKING-LAT-MS) * 2).

            COMPUTE WS-SHC-REBAR-LATCH = 1470169088 +
                                         (WS-SHC-COMPOSITE / 2) +
                                         ((60 - WS-CHUNKING-LAT-MS) * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-SHC-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-SHC-VITALITY * 10) +
                                         (WS-SHC-COHERENCE * 10) +
                                         (WS-SHC-COMPOSITE * 10) +
                                         (WS-SHC-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-SHC-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-SHC-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
