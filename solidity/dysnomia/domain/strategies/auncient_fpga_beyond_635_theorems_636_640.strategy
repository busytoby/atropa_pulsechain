        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-BEYOND-635.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-BEYOND-635-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH636-COOP-ICAP-OK       PIC 9(01) VALUE 1.
            05  WS-TH637-RECONFIG-INT-OK    PIC 9(01) VALUE 1.
            05  WS-TH638-ICAP-LAT-OK        PIC 9(01) VALUE 1.
            05  WS-TH639-640M-SAAT-OK       PIC 9(01) VALUE 1.
            05  WS-TH640-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-BEYOND-635-WIT      PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-BEYOND-635.
            GOBACK.
        1000-EVALUATE-BEYOND-635.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH636-COOP-ICAP-OK = 1 AND
               WS-TH637-RECONFIG-INT-OK = 1 AND
               WS-TH638-ICAP-LAT-OK = 1 AND
               WS-TH639-640M-SAAT-OK = 1 AND
               WS-TH640-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-BEYOND-635-WIT
            ELSE
                MOVE 0 TO WS-FPGA-BEYOND-635-WIT.
