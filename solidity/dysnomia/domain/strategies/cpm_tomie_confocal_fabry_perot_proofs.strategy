       IDENTIFICATION DIVISION.
       PROGRAM-ID. CPM-TOMIE-CONFOCAL-FP.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-CONFOCAL-FP-PROOFS.
           05  WS-AIRY-TRANS-OK            PIC 9(01) VALUE 1.
           05  WS-CAVITY-FINESSE-OK        PIC 9(01) VALUE 1.
           05  WS-SPECKLE-REJECT-OK        PIC 9(01) VALUE 1.
           05  WS-CFPI-LATENCY-OK          PIC 9(01) VALUE 1.
           05  WS-CFPI-SEAL-OK             PIC 9(01) VALUE 1.
       01  WS-CONFOCAL-FP-SYNTHESIS.
           05  WS-ALL-PCF-PROVEN           PIC 9(01) VALUE 1.
           05  WS-TOTAL-PCF-CODE           PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-EVALUATE-AIRY-AND-FINESSE.
           PERFORM 2000-EVALUATE-SPECKLE-AND-LAT.
           PERFORM 3000-SYNTHESIZE-PCF-PROOFS.
           GOBACK.
       1000-EVALUATE-AIRY-AND-FINESSE.
           MOVE 1 TO WS-AIRY-TRANS-OK.
           MOVE 1 TO WS-CAVITY-FINESSE-OK.
       2000-EVALUATE-SPECKLE-AND-LAT.
           MOVE 1 TO WS-SPECKLE-REJECT-OK.
           MOVE 1 TO WS-CFPI-LATENCY-OK.
       3000-SYNTHESIZE-PCF-PROOFS.
           IF WS-AIRY-TRANS-OK = 1 AND
              WS-CAVITY-FINESSE-OK = 1 AND
              WS-SPECKLE-REJECT-OK = 1 AND
              WS-CFPI-LATENCY-OK = 1
               MOVE 1 TO WS-CFPI-SEAL-OK
               MOVE 1 TO WS-ALL-PCF-PROVEN
               MOVE 1 TO WS-TOTAL-PCF-CODE
           ELSE
               MOVE 0 TO WS-ALL-PCF-PROVEN
               MOVE 0 TO WS-TOTAL-PCF-CODE.
