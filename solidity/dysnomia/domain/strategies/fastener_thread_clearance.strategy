        IDENTIFICATION DIVISION.
        PROGRAM-ID. FTC-THR-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / FASTENER THREAD CLEARANCE AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-FTC-PARAMS.
           05 WS-THREAD-LAT-MS          PIC 9(02) VALUE 12.
           05 WS-SEATING-FID-M          PIC 9(04) VALUE 0960.
           05 WS-LEAD-RESIDUAL-UM       PIC 9(02) VALUE 01.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-FTC-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-FTC-VITALITY           PIC 9(09) VALUE 0.
           05 WS-FTC-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-FTC-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-FTC-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 THREAD-LAT-OUT-OF-BOUNDS    VALUE 2.
              88 SEATING-FIDELITY-LOW        VALUE 3.
              88 RESIDUAL-EXCEEDED           VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 THREAD-COLLAPSE             VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-THREAD-CLEARANCE
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3 AND WS-K-EXPONENT NOT EQUAL 4
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-THREAD-LAT-MS < 5 OR WS-THREAD-LAT-MS > 25
                SET THREAD-LAT-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-SEATING-FID-M < 850 OR WS-SEATING-FID-M > 1000
                SET SEATING-FIDELITY-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-LEAD-RESIDUAL-UM < 0 OR WS-LEAD-RESIDUAL-UM > 5
                SET RESIDUAL-EXCEEDED TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-THREAD-CLEARANCE.
            COMPUTE WS-FTC-COMPOSITE = ((30 - WS-THREAD-LAT-MS) * 20) +
                                       (WS-SEATING-FID-M / 2) +
                                       ((10 - WS-LEAD-RESIDUAL-UM) * 40).

            COMPUTE WS-FTC-VITALITY = (WS-FTC-COMPOSITE / 4) +
                                      (WS-SEATING-FID-M / 4) +
                                      ((30 - WS-THREAD-LAT-MS) * 4) + 1.

            IF WS-FTC-VITALITY EQUAL ZERO
                SET THREAD-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-FTC-COHERENCE = (WS-FTC-COMPOSITE / 16) +
                                       (WS-SEATING-FID-M / 16) +
                                       ((30 - WS-THREAD-LAT-MS) * 2).

            COMPUTE WS-FTC-REBAR-LATCH = 1470169088 +
                                         (WS-FTC-COMPOSITE / 2) +
                                         ((30 - WS-THREAD-LAT-MS) * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-FTC-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-FTC-VITALITY * 10) +
                                         (WS-FTC-COHERENCE * 10) +
                                         (WS-FTC-COMPOSITE * 10) +
                                         (WS-FTC-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-FTC-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-FTC-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
