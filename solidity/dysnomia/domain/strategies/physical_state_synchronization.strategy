        IDENTIFICATION DIVISION.
        PROGRAM-ID. PSS-SYN-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / PHYSICAL STATE SYNCHRONIZATION AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-PSS-PARAMS.
           05 WS-SYNC-LAT-MS            PIC 9(02) VALUE 20.
           05 WS-GROUND-FID-M           PIC 9(04) VALUE 0960.
           05 WS-CORRECT-LAT-MS         PIC 9(02) VALUE 04.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-PSS-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-PSS-VITALITY           PIC 9(09) VALUE 0.
           05 WS-PSS-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-PSS-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-PSS-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 SYNC-LAT-OUT-OF-BOUNDS      VALUE 2.
              88 GROUND-FID-LOW              VALUE 3.
              88 CORRECT-LAT-OUT-OF-BOUNDS   VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 GROUNDING-COLLAPSE          VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-STATE-SYNC
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-SYNC-LAT-MS < 10 OR WS-SYNC-LAT-MS > 50
                SET SYNC-LAT-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-GROUND-FID-M < 850 OR WS-GROUND-FID-M > 1000
                SET GROUND-FID-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CORRECT-LAT-MS < 1 OR WS-CORRECT-LAT-MS > 10
                SET CORRECT-LAT-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-STATE-SYNC.
            COMPUTE WS-PSS-COMPOSITE = ((60 - WS-SYNC-LAT-MS) * 10) +
                                       (WS-GROUND-FID-M / 2) +
                                       ((15 - WS-CORRECT-LAT-MS) * 20).

            COMPUTE WS-PSS-VITALITY = (WS-PSS-COMPOSITE / 4) +
                                      (WS-GROUND-FID-M / 4) +
                                      ((60 - WS-SYNC-LAT-MS) * 4) + 1.

            IF WS-PSS-VITALITY EQUAL ZERO
                SET GROUNDING-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-PSS-COHERENCE = (WS-PSS-COMPOSITE / 16) +
                                       (WS-GROUND-FID-M / 16) +
                                       ((60 - WS-SYNC-LAT-MS) * 2).

            COMPUTE WS-PSS-REBAR-LATCH = 1470169088 +
                                         (WS-PSS-COMPOSITE / 2) +
                                         ((60 - WS-SYNC-LAT-MS) * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-PSS-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-PSS-VITALITY * 10) +
                                         (WS-PSS-COHERENCE * 10) +
                                         (WS-PSS-COMPOSITE * 10) +
                                         (WS-PSS-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-PSS-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-PSS-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
