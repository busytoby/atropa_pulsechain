        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-VOICE-RIGHT.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-VOICE-RIGHT-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1786-VOICE-OK          PIC 9(01) VALUE 1.
            05  WS-TH1787-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1788-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1789-1790M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1790-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-VOICE-RIGHT-WIT          PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-VOICE-RIGHT.
            GOBACK.
        1000-EVALUATE-VOICE-RIGHT.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1786-VOICE-OK = 1 AND
               WS-TH1787-DATBIN-STRAT-OK = 1 AND
               WS-TH1788-SUBMICRO-LAT-OK = 1 AND
               WS-TH1789-1790M-SAAT-OK = 1 AND
               WS-TH1790-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-VOICE-RIGHT-WIT
            ELSE
                MOVE 0 TO WS-VOICE-RIGHT-WIT.
