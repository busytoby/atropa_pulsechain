        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-BEYOND-855.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-BEYOND-855-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH856-ZORSE-MESH-OK      PIC 9(01) VALUE 1.
            05  WS-TH857-INDUCTIVE-MERKLE-OK PIC 9(01) VALUE 1.
            05  WS-TH858-COMMUT-LAT-OK      PIC 9(01) VALUE 1.
            05  WS-TH859-860M-SAAT-OK       PIC 9(01) VALUE 1.
            05  WS-TH860-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-BEYOND-855-WIT      PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-BEYOND-855.
            GOBACK.
        1000-EVALUATE-BEYOND-855.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH856-ZORSE-MESH-OK = 1 AND
               WS-TH857-INDUCTIVE-MERKLE-OK = 1 AND
               WS-TH858-COMMUT-LAT-OK = 1 AND
               WS-TH859-860M-SAAT-OK = 1 AND
               WS-TH860-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-BEYOND-855-WIT
            ELSE
                MOVE 0 TO WS-FPGA-BEYOND-855-WIT.
