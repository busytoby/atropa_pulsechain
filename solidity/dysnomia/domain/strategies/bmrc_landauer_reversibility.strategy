       IDENTIFICATION DIVISION.
       PROGRAM-ID. BMRC-LANDAUER-REVERSIBILITY-STRATEGY.
       AUTHOR. AUNCIENT DYSNOMIA VM / BMRC LANDAUER REVERSIBILITY.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-LANDAUER-PARAMETERS.
          05 WS-FORWARD-CHARGE         PIC 9(09) VALUE 000065536.
          05 WS-REVERSIBLE-CYCLES      PIC 9(04) VALUE 0100.
          05 WS-GATING-STRIDE-INDEX    PIC 9(02) VALUE 08.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-FORWARD-STAGED-ENERGY  PIC 9(09) VALUE 0.
          05 WS-REVERSE-RESTORED-ENERGY PIC 9(09) VALUE 0.
          05 WS-CYCLE-IDX              PIC 9(04) VALUE 0.
          05 WS-SHADOW-LANDAUER-BASE   PIC 9(12) VALUE 0.
          05 WS-STRIDE-MOD             PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-CHARGE              VALUE 2.
             88 INVALID-CYCLE-COUNT         VALUE 3.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 4.
             88 LANDAUER-ENTROPY-VIOLATION  VALUE 5.
             88 GATING-CLAMP-OVERFLOW       VALUE 6.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 7.
             88 CASCADE-ROLLBACK-FAIL       VALUE 8.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-REVERSIBLE-CYCLES
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-REVERSIBLE-CYCLES < 1 OR WS-REVERSIBLE-CYCLES > 1000
               SET INVALID-CYCLE-COUNT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-GATING-STRIDE-INDEX > 63
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-REVERSIBLE-CYCLES.
           MOVE WS-FORWARD-CHARGE TO WS-FORWARD-STAGED-ENERGY.
           MOVE WS-FORWARD-CHARGE TO WS-REVERSE-RESTORED-ENERGY.

           PERFORM VARYING WS-CYCLE-IDX FROM 1 BY 1 UNTIL WS-CYCLE-IDX > WS-REVERSIBLE-CYCLES
               COMPUTE WS-FORWARD-STAGED-ENERGY = WS-FORWARD-STAGED-ENERGY + 1000
               COMPUTE WS-REVERSE-RESTORED-ENERGY = WS-FORWARD-STAGED-ENERGY - 1000
               MOVE WS-REVERSE-RESTORED-ENERGY TO WS-FORWARD-STAGED-ENERGY
           END-PERFORM.

           IF WS-REVERSE-RESTORED-ENERGY NOT EQUAL WS-FORWARD-CHARGE
               SET LANDAUER-ENTROPY-VIOLATION TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-SHADOW-LANDAUER-BASE = (WS-CICS-WRITER-ID * 1000000) + 
               (WS-GATING-STRIDE-INDEX * 1000) + (WS-FORWARD-CHARGE / 16).

           COMPUTE WS-STRIDE-MOD = FUNCTION MOD(WS-GATING-STRIDE-INDEX, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-STRIDE-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-LANDAUER-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-LANDAUER-BASE + ((WS-FORWARD-CHARGE * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-LANDAUER-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-GATING-STRIDE-INDEX * 1000) + (WS-FORWARD-CHARGE / 16))
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-LANDAUER-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
