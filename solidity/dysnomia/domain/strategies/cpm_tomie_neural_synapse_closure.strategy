       IDENTIFICATION DIVISION.
       PROGRAM-ID. CPM-TOMIE-NEURAL-SYNAPSE-CLOSURE-STRATEGY.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-SYNAPSE-BOUNDARY-RESTRICTION.
           05  WS-PRE-SYNAPTIC-NEURON-ID   PIC 9(04) VALUE 0001.
           05  WS-POST-SYNAPTIC-NEURON-ID  PIC 9(04) VALUE 0002.
           05  WS-NEURAL-NET-CONTEXT-VALID PIC 9(01) VALUE 1.
           05  WS-NO-STANDALONE-MAGNETIC   PIC 9(01) VALUE 1.
           05  WS-SKYRMION-POTENTIAL-VALID PIC 9(01) VALUE 1.
       01  WS-SYNAPSE-PROOF-SYNTHESIS.
           05  WS-PURE-NEURAL-CLOSURE-MET  PIC 9(01) VALUE 1.
           05  WS-TOTAL-VALIDATION-CODE    PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-ENFORCE-NEURAL-BOUNDARIES.
           PERFORM 2000-VALIDATE-SKYRMIONIC-POTENTIAL.
           PERFORM 3000-SYNTHESIZE-PROOF.
           GOBACK.
       1000-ENFORCE-NEURAL-BOUNDARIES.
           IF WS-NEURAL-NET-CONTEXT-VALID = 1 AND
              WS-PRE-SYNAPTIC-NEURON-ID > 0 AND
              WS-POST-SYNAPTIC-NEURON-ID > 0
               MOVE 1 TO WS-PURE-NEURAL-CLOSURE-MET
           ELSE
               MOVE 0 TO WS-PURE-NEURAL-CLOSURE-MET.
       2000-VALIDATE-SKYRMIONIC-POTENTIAL.
           IF WS-PURE-NEURAL-CLOSURE-MET = 1
               MOVE 1 TO WS-SKYRMION-POTENTIAL-VALID
           ELSE
               MOVE 0 TO WS-SKYRMION-POTENTIAL-VALID.
       3000-SYNTHESIZE-PROOF.
           IF WS-PURE-NEURAL-CLOSURE-MET = 1 AND
              WS-SKYRMION-POTENTIAL-VALID = 1 AND
              WS-NO-STANDALONE-MAGNETIC = 1
               MOVE 1 TO WS-TOTAL-VALIDATION-CODE
           ELSE
               MOVE 0 TO WS-TOTAL-VALIDATION-CODE.
