        IDENTIFICATION DIVISION.
        PROGRAM-ID. GM-UXII-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / GRAND MASTER UNIFICATION XII AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-UXII-PARAMS.
           05 WS-UNIFICATION-XI-M       PIC 9(04) VALUE 0920.
           05 WS-GAZE-ANALYZER-M        PIC 9(04) VALUE 0960.
           05 WS-WEYL-BENCHMARK-M       PIC 9(04) VALUE 0950.
           05 WS-UNIVERSAL-IO-M         PIC 9(04) VALUE 0940.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-UXII-COMPOSITE         PIC 9(04) VALUE 0.
           05 WS-UXII-VITALITY          PIC 9(09) VALUE 0.
           05 WS-UXII-COHERENCE         PIC 9(09) VALUE 0.
           05 WS-UXII-REBAR-LATCH       PIC 9(12) VALUE 0.
           05 WS-SHADOW-UXII-BASE       PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 UNIFICATION-XI-OUT-OF-BOUND VALUE 2.
              88 GAZE-ANALYZER-LOW           VALUE 3.
              88 WEYL-BENCHMARK-LOW          VALUE 4.
              88 UNIVERSAL-IO-LOW            VALUE 5.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 6.
              88 UNIFICATION-XII-COLLAPSE    VALUE 7.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 8.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-UNIFICATION-XII
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-UNIFICATION-XI-M < 500 OR WS-UNIFICATION-XI-M > 1000
                SET UNIFICATION-XI-OUT-OF-BOUND TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-GAZE-ANALYZER-M < 850 OR WS-GAZE-ANALYZER-M > 1000
                SET GAZE-ANALYZER-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-WEYL-BENCHMARK-M < 850 OR WS-WEYL-BENCHMARK-M > 1000
                SET WEYL-BENCHMARK-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-UNIVERSAL-IO-M < 850 OR WS-UNIVERSAL-IO-M > 1000
                SET UNIVERSAL-IO-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-UNIFICATION-XII.
            COMPUTE WS-UXII-COMPOSITE = (WS-UNIFICATION-XI-M / 2) +
                                        (WS-GAZE-ANALYZER-M / 4) +
                                        (WS-WEYL-BENCHMARK-M / 4) +
                                        (WS-UNIVERSAL-IO-M / 4).

            COMPUTE WS-UXII-VITALITY = (WS-UXII-COMPOSITE / 4) +
                                       (WS-GAZE-ANALYZER-M / 8) +
                                       (WS-UNIVERSAL-IO-M / 8) + 1.

            IF WS-UXII-VITALITY EQUAL ZERO
                SET UNIFICATION-XII-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-UXII-COHERENCE = (WS-UXII-COMPOSITE / 16) +
                                        (WS-WEYL-BENCHMARK-M / 16) +
                                        (WS-UNIVERSAL-IO-M / 16).

            COMPUTE WS-UXII-REBAR-LATCH = 1470169088 +
                                          (WS-UXII-COMPOSITE / 2) +
                                          (WS-UNIFICATION-XI-M * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-UXII-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                          (WS-UXII-VITALITY * 10) +
                                          (WS-UXII-COHERENCE * 10) +
                                          (WS-UXII-COMPOSITE * 10) +
                                          (WS-UXII-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-UXII-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-UXII-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
