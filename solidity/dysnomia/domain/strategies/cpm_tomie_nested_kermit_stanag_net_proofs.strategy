       IDENTIFICATION DIVISION.
       PROGRAM-ID. CPM-TOMIE-KERMIT-STANAG.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-KERMIT-STANAG-PROOFS.
           05  WS-KERMIT-PACKET-OK         PIC 9(01) VALUE 1.
           05  WS-STANAG-ENCLAVE-OK        PIC 9(01) VALUE 1.
           05  WS-NETWORK-MOUNT-OK         PIC 9(01) VALUE 1.
           05  WS-FLOW-CONTROL-OK          PIC 9(01) VALUE 1.
           05  WS-KERMIT-STANAG-SEAL-OK    PIC 9(01) VALUE 1.
       01  WS-KERMIT-STANAG-SYNTHESIS.
           05  WS-ALL-NETWORK-PROVEN       PIC 9(01) VALUE 1.
           05  WS-TOTAL-NETWORK-CODE       PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-EVALUATE-KERMIT-AND-STANAG.
           PERFORM 2000-EVALUATE-MOUNT-AND-FLOW.
           PERFORM 3000-SYNTHESIZE-NETWORK-PROOFS.
           GOBACK.
       1000-EVALUATE-KERMIT-AND-STANAG.
           MOVE 1 TO WS-KERMIT-PACKET-OK.
           MOVE 1 TO WS-STANAG-ENCLAVE-OK.
       2000-EVALUATE-MOUNT-AND-FLOW.
           MOVE 1 TO WS-NETWORK-MOUNT-OK.
           MOVE 1 TO WS-FLOW-CONTROL-OK.
       3000-SYNTHESIZE-NETWORK-PROOFS.
           IF WS-KERMIT-PACKET-OK = 1 AND
              WS-STANAG-ENCLAVE-OK = 1 AND
              WS-NETWORK-MOUNT-OK = 1 AND
              WS-FLOW-CONTROL-OK = 1
               MOVE 1 TO WS-KERMIT-STANAG-SEAL-OK
               MOVE 1 TO WS-ALL-NETWORK-PROVEN
               MOVE 1 TO WS-TOTAL-NETWORK-CODE
           ELSE
               MOVE 0 TO WS-ALL-NETWORK-PROVEN
               MOVE 0 TO WS-TOTAL-NETWORK-CODE.
