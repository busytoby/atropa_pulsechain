        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-BEYOND-850.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-BEYOND-850-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH851-ZORSE-BRIDGE-OK    PIC 9(01) VALUE 1.
            05  WS-TH852-TOTAL-KNOWL-OK     PIC 9(01) VALUE 1.
            05  WS-TH853-BRIDGE-LAT-OK      PIC 9(01) VALUE 1.
            05  WS-TH854-855M-SAAT-OK       PIC 9(01) VALUE 1.
            05  WS-TH855-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-BEYOND-850-WIT      PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-BEYOND-850.
            GOBACK.
        1000-EVALUATE-BEYOND-850.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH851-ZORSE-BRIDGE-OK = 1 AND
               WS-TH852-TOTAL-KNOWL-OK = 1 AND
               WS-TH853-BRIDGE-LAT-OK = 1 AND
               WS-TH854-855M-SAAT-OK = 1 AND
               WS-TH855-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-BEYOND-850-WIT
            ELSE
                MOVE 0 TO WS-FPGA-BEYOND-850-WIT.
