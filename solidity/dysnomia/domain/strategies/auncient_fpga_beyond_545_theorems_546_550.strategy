        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-BEYOND-545.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-BEYOND-545-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH546-DIRAC-BRAID-OK     PIC 9(01) VALUE 1.
            05  WS-TH547-HOLONOMY-OK        PIC 9(01) VALUE 1.
            05  WS-TH548-ALLAN-DEV-OK       PIC 9(01) VALUE 1.
            05  WS-TH549-BRAID-SAAT-OK      PIC 9(01) VALUE 1.
            05  WS-TH550-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-BEYOND-545-WIT      PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-BEYOND-545.
            GOBACK.
        1000-EVALUATE-BEYOND-545.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH546-DIRAC-BRAID-OK = 1 AND
               WS-TH547-HOLONOMY-OK = 1 AND
               WS-TH548-ALLAN-DEV-OK = 1 AND
               WS-TH549-BRAID-SAAT-OK = 1 AND
               WS-TH550-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-BEYOND-545-WIT
            ELSE
                MOVE 0 TO WS-FPGA-BEYOND-545-WIT.
