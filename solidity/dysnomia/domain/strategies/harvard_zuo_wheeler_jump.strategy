IDENTIFICATION DIVISION.
PROGRAM-ID. PROG-HARVARD-ZUO-WHEELER.

DATA DIVISION.
01 D0-SUBSTRATE-TRUNK.
   05 D0-MOTZKIN-PRIME     PIC 9(9) USAGE R0.
   05 D0-K-EXPONENT        PIC 9(9) USAGE R1.
   05 D0-ESCAPE-FAULT-FLAG PIC 9(9) USAGE R2.
01 D1-LINK-SHADOW.
   05 D1-CALLER-PC         PIC 9(9) USAGE R3.
   05 D1-SUBROUTINE-PC     PIC 9(9) USAGE R4.
   05 D1-SHADOW-CALLER-PC  PIC 9(9) USAGE R5.
01 D2-WHEELER-STAGE.
   05 D2-LINK-INSTRUCTION  PIC 9(9) USAGE R6.
   05 D2-RESOLVED-RETURN-PC PIC 9(9) USAGE R7.
   05 D2-G-SWIGLU-GATE     PIC 9(9) USAGE R8.
   05 D2-COMMITTED-STATE   PIC 9(9) USAGE R9.
01 D3-LEAF-EVAL.
   05 D3-PROOF-RULING      PIC 9(9) USAGE R10.
   05 D3-DISP-WRAP-MOD     PIC 9(9) USAGE R11.

PROCEDURE DIVISION.
    MOVE 953467954 TO D0-MOTZKIN-PRIME.
    MOVE 3 TO D0-K-EXPONENT.
    MOVE 0 TO D0-ESCAPE-FAULT-FLAG.
    MOVE 100 TO D1-CALLER-PC.
    MOVE 500 TO D1-SUBROUTINE-PC.

    PERFORM STAGE-WHEELER-LINK.
    PERFORM APPLY-ESCAPE-LATCH.
    PERFORM SYNC-DISPLACEMENT.

    IF D1-SHADOW-CALLER-PC == D1-CALLER-PC AND D2-RESOLVED-RETURN-PC == 102
        MOVE 0 TO D3-PROOF-RULING
        SET depth 4
    ELSE
        MOVE 4 TO D3-PROOF-RULING
        SET depth 1
    END-IF.

    EVAL.
    GO TO END-STRATEGY.

STAGE-WHEELER-LINK.
    MOVE D1-CALLER-PC TO D1-SHADOW-CALLER-PC.
    COMPUTE D2-LINK-INSTRUCTION = (71 * 65536) + (D1-CALLER-PC + 2).
    COMPUTE D2-RESOLVED-RETURN-PC = D2-LINK-INSTRUCTION - ((D2-LINK-INSTRUCTION / 65536) * 65536).
    COMPUTE D2-G-SWIGLU-GATE = 875 + ((125 * (D1-CALLER-PC - ((D1-CALLER-PC / 1000) * 1000))) / 1000).
    EXIT.

APPLY-ESCAPE-LATCH.
    IF D0-ESCAPE-FAULT-FLAG == 1
        MOVE D1-SHADOW-CALLER-PC TO D2-COMMITTED-STATE
    ELSE
        COMPUTE D2-COMMITTED-STATE = ((D2-LINK-INSTRUCTION - ((D2-LINK-INSTRUCTION / 1000000) * 1000000)) * D2-G-SWIGLU-GATE) / 1000
    END-IF.
    EXIT.

SYNC-DISPLACEMENT.
    COMPUTE D3-DISP-WRAP-MOD = D2-COMMITTED-STATE - ((D2-COMMITTED-STATE / 256) * 256).
    EXIT.

END-STRATEGY.
