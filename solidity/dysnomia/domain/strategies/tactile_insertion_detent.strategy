        IDENTIFICATION DIVISION.
        PROGRAM-ID. TID-TAC-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / TACTILE INSERTION DETENT AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-TID-PARAMS.
           05 WS-TRIGGER-LAT-MS         PIC 9(02) VALUE 12.
           05 WS-SNAP-FIDELITY-M        PIC 9(04) VALUE 0960.
           05 WS-FREQ-DRIFT-CHZ         PIC 9(02) VALUE 01.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-TID-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-TID-VITALITY           PIC 9(09) VALUE 0.
           05 WS-TID-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-TID-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-TID-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 TRIGGER-LAT-OUT-OF-BOUNDS   VALUE 2.
              88 SNAP-FIDELITY-LOW           VALUE 3.
              88 FREQ-DRIFT-EXCEEDED         VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 DETENT-COLLAPSE             VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-TACTILE-DETENT
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3 AND WS-K-EXPONENT NOT EQUAL 4
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-TRIGGER-LAT-MS < 5 OR WS-TRIGGER-LAT-MS > 25
                SET TRIGGER-LAT-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-SNAP-FIDELITY-M < 850 OR WS-SNAP-FIDELITY-M > 1000
                SET SNAP-FIDELITY-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-FREQ-DRIFT-CHZ < 0 OR WS-FREQ-DRIFT-CHZ > 5
                SET FREQ-DRIFT-EXCEEDED TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-TACTILE-DETENT.
            COMPUTE WS-TID-COMPOSITE = ((30 - WS-TRIGGER-LAT-MS) * 20) +
                                       (WS-SNAP-FIDELITY-M / 2) +
                                       ((10 - WS-FREQ-DRIFT-CHZ) * 40).

            COMPUTE WS-TID-VITALITY = (WS-TID-COMPOSITE / 4) +
                                      (WS-SNAP-FIDELITY-M / 4) +
                                      ((30 - WS-TRIGGER-LAT-MS) * 4) + 1.

            IF WS-TID-VITALITY EQUAL ZERO
                SET DETENT-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-TID-COHERENCE = (WS-TID-COMPOSITE / 16) +
                                       (WS-SNAP-FIDELITY-M / 16) +
                                       ((30 - WS-TRIGGER-LAT-MS) * 2).

            COMPUTE WS-TID-REBAR-LATCH = 1470169088 +
                                         (WS-TID-COMPOSITE / 2) +
                                         ((30 - WS-TRIGGER-LAT-MS) * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-TID-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-TID-VITALITY * 10) +
                                         (WS-TID-COHERENCE * 10) +
                                         (WS-TID-COMPOSITE * 10) +
                                         (WS-TID-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-TID-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-TID-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
