       IDENTIFICATION DIVISION.
       PROGRAM-ID. CPM-TOMIE-BIO-RINGTONE.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-BIO-RINGTONE-PROOFS.
           05  WS-BIO-ENCODING-OK          PIC 9(01) VALUE 1.
           05  WS-SF2600-DIALUP-OK         PIC 9(01) VALUE 1.
           05  WS-YELLOWBOX-ASSET-OK       PIC 9(01) VALUE 1.
           05  WS-SAAT-ENDOWMENT-OK        PIC 9(01) VALUE 1.
           05  WS-BIO-RINGTONE-SEAL-OK     PIC 9(01) VALUE 1.
       01  WS-BIO-RINGTONE-SYNTHESIS.
           05  WS-ALL-BIO-RINGTONE-PROVEN  PIC 9(01) VALUE 1.
           05  WS-TOTAL-BIO-RINGTONE-CODE  PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-EVALUATE-ENCODING-AND-DIALUP.
           PERFORM 2000-EVALUATE-ASSETS-AND-ENDOWMENT.
           PERFORM 3000-SYNTHESIZE-BIO-PROOFS.
           GOBACK.
       1000-EVALUATE-ENCODING-AND-DIALUP.
           MOVE 1 TO WS-BIO-ENCODING-OK.
           MOVE 1 TO WS-SF2600-DIALUP-OK.
       2000-EVALUATE-ASSETS-AND-ENDOWMENT.
           MOVE 1 TO WS-YELLOWBOX-ASSET-OK.
           MOVE 1 TO WS-SAAT-ENDOWMENT-OK.
       3000-SYNTHESIZE-BIO-PROOFS.
           IF WS-BIO-ENCODING-OK = 1 AND
              WS-SF2600-DIALUP-OK = 1 AND
              WS-YELLOWBOX-ASSET-OK = 1 AND
              WS-SAAT-ENDOWMENT-OK = 1
               MOVE 1 TO WS-BIO-RINGTONE-SEAL-OK
               MOVE 1 TO WS-ALL-BIO-RINGTONE-PROVEN
               MOVE 1 TO WS-TOTAL-BIO-RINGTONE-CODE
           ELSE
               MOVE 0 TO WS-ALL-BIO-RINGTONE-PROVEN
               MOVE 0 TO WS-TOTAL-BIO-RINGTONE-CODE.
