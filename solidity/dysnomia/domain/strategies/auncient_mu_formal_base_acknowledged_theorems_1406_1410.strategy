        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FORM-BASE-ACK.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FORM-BASE-ACK-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1406-ACK-OK            PIC 9(01) VALUE 1.
            05  WS-TH1407-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1408-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1409-1410M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1410-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-FORM-BASE-ACK-WIT        PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-FORM-BASE-ACK.
            GOBACK.
        1000-EVALUATE-FORM-BASE-ACK.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1406-ACK-OK = 1 AND
               WS-TH1407-DATBIN-STRAT-OK = 1 AND
               WS-TH1408-SUBMICRO-LAT-OK = 1 AND
               WS-TH1409-1410M-SAAT-OK = 1 AND
               WS-TH1410-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-FORM-BASE-ACK-WIT
            ELSE
                MOVE 0 TO WS-FORM-BASE-ACK-WIT.
