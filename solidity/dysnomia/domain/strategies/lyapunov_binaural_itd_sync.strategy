       IDENTIFICATION DIVISION.
       PROGRAM-ID. LYAPUNOV-BINAURAL-STRATEGY.
       AUTHOR. AUNCIENT DYSNOMIA VM / BINAURAL ITD SYNC.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-BINAURAL-PARAMS.
          05 WS-AZIMUTH-ANGLE-DEG      PIC S9(03) VALUE +045.
          05 WS-LEFT-PHASE-ERR         PIC 9(05) VALUE 03000.
          05 WS-RIGHT-PHASE-ERR        PIC 9(05) VALUE 02000.
          05 WS-SYNC-CYCLES-N          PIC 9(02) VALUE 16.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-NOMINAL-ITD-US         PIC S9(05) VALUE 0.
          05 WS-CURRENT-LEFT-ERR       PIC 9(05) VALUE 0.
          05 WS-CURRENT-RIGHT-ERR      PIC 9(05) VALUE 0.
          05 WS-STEP-IDX               PIC 9(02) VALUE 0.
          05 WS-INTERAURAL-JITTER      PIC 9(06) VALUE 0.
          05 WS-SHADOW-BINAURAL-BASE   PIC 9(12) VALUE 0.
          05 WS-AZI-OFFSET             PIC 9(03) VALUE 0.
          05 WS-CYC-MOD                PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-AZIMUTH-ANGLE       VALUE 2.
             88 INVALID-PHASE-ERRORS        VALUE 3.
             88 INVALID-SYNC-CYCLES         VALUE 4.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
             88 BINAURAL-DIVERGENCE         VALUE 6.
             88 GATING-CLAMP-OVERFLOW       VALUE 7.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 8.
             88 CASCADE-ROLLBACK-FAIL       VALUE 9.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-BINAURAL-SYNC
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-AZIMUTH-ANGLE-DEG < -90 OR WS-AZIMUTH-ANGLE-DEG > 90
               SET INVALID-AZIMUTH-ANGLE TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-LEFT-PHASE-ERR > 10000 OR WS-RIGHT-PHASE-ERR > 10000
               SET INVALID-PHASE-ERRORS TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SYNC-CYCLES-N < 1 OR WS-SYNC-CYCLES-N > 64
               SET INVALID-SYNC-CYCLES TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-BINAURAL-SYNC.
           COMPUTE WS-NOMINAL-ITD-US = (700 * WS-AZIMUTH-ANGLE-DEG) / 90.
           MOVE WS-LEFT-PHASE-ERR TO WS-CURRENT-LEFT-ERR.
           MOVE WS-RIGHT-PHASE-ERR TO WS-CURRENT-RIGHT-ERR.

           PERFORM VARYING WS-STEP-IDX FROM 1 BY 1 UNTIL WS-STEP-IDX > WS-SYNC-CYCLES-N
               COMPUTE WS-CURRENT-LEFT-ERR = (WS-CURRENT-LEFT-ERR * 875) / 1000
               COMPUTE WS-CURRENT-RIGHT-ERR = (WS-CURRENT-RIGHT-ERR * 875) / 1000
           END-PERFORM.

           COMPUTE WS-INTERAURAL-JITTER = WS-CURRENT-LEFT-ERR + WS-CURRENT-RIGHT-ERR.

           IF WS-CURRENT-LEFT-ERR > WS-LEFT-PHASE-ERR OR WS-CURRENT-RIGHT-ERR > WS-RIGHT-PHASE-ERR
               SET BINAURAL-DIVERGENCE TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-AZI-OFFSET = WS-AZIMUTH-ANGLE-DEG + 90.
           COMPUTE WS-SHADOW-BINAURAL-BASE = (WS-CICS-WRITER-ID * 1000000) + 
               (WS-AZI-OFFSET * 1000) + (WS-NOMINAL-ITD-US + 700) + WS-INTERAURAL-JITTER.

           COMPUTE WS-CYC-MOD = FUNCTION MOD(WS-AZI-OFFSET, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-CYC-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-BINAURAL-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-BINAURAL-BASE + ((WS-AZI-OFFSET * WS-G-GATE-FACTOR) / 100)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-BINAURAL-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-AZI-OFFSET * 1000) + (WS-NOMINAL-ITD-US + 700) + WS-INTERAURAL-JITTER)
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-BINAURAL-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
