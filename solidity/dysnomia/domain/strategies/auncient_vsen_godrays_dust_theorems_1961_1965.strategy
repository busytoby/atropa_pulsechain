        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-VSEN-GODRAYS.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-VSEN-GODRAYS-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1961-RAYLEIGH-BEAM-OK  PIC 9(01) VALUE 1.
            05  WS-TH1962-DUST-ENERGY-OK    PIC 9(01) VALUE 1.
            05  WS-TH1963-AIRFLOW-FET-OK    PIC 9(01) VALUE 1.
            05  WS-TH1964-1965M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1965-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-VSEN-GODRAYS-WIT         PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-VSEN-GODRAYS.
            GOBACK.
        1000-EVALUATE-VSEN-GODRAYS.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1961-RAYLEIGH-BEAM-OK = 1 AND
               WS-TH1962-DUST-ENERGY-OK = 1 AND
               WS-TH1963-AIRFLOW-FET-OK = 1 AND
               WS-TH1964-1965M-SAAT-OK = 1 AND
               WS-TH1965-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-VSEN-GODRAYS-WIT
            ELSE
                MOVE 0 TO WS-VSEN-GODRAYS-WIT.
