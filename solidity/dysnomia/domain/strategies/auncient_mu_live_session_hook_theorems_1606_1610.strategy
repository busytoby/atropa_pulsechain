        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-LIVE-HOOK.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-LIVE-HOOK-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1606-HOOK-OK           PIC 9(01) VALUE 1.
            05  WS-TH1607-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1608-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1609-1610M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1610-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-LIVE-HOOK-WIT            PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-LIVE-HOOK.
            GOBACK.
        1000-EVALUATE-LIVE-HOOK.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1606-HOOK-OK = 1 AND
               WS-TH1607-DATBIN-STRAT-OK = 1 AND
               WS-TH1608-SUBMICRO-LAT-OK = 1 AND
               WS-TH1609-1610M-SAAT-OK = 1 AND
               WS-TH1610-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-LIVE-HOOK-WIT
            ELSE
                MOVE 0 TO WS-LIVE-HOOK-WIT.
