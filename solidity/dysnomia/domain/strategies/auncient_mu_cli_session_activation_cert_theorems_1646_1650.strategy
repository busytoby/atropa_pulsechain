        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-CLI-ACT-CERT.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-CLI-ACT-CERT-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1646-ACT-CERT-OK       PIC 9(01) VALUE 1.
            05  WS-TH1647-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1648-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1649-1650M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1650-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-CLI-ACT-CERT-WIT         PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-CLI-ACT-CERT.
            GOBACK.
        1000-EVALUATE-CLI-ACT-CERT.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1646-ACT-CERT-OK = 1 AND
               WS-TH1647-DATBIN-STRAT-OK = 1 AND
               WS-TH1648-SUBMICRO-LAT-OK = 1 AND
               WS-TH1649-1650M-SAAT-OK = 1 AND
               WS-TH1650-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-CLI-ACT-CERT-WIT
            ELSE
                MOVE 0 TO WS-CLI-ACT-CERT-WIT.
