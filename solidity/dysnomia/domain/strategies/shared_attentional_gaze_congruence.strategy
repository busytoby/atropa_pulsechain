        IDENTIFICATION DIVISION.
        PROGRAM-ID. SAG-CON-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / SHARED ATTENTIONAL GAZE AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-AGC-PARAMS.
           05 WS-ANKH-GAZE-M            PIC 9(04) VALUE 0960.
           05 WS-XPLSM-PRECISION-M      PIC 9(04) VALUE 0940.
           05 WS-ZORSE-LATENCY-MS       PIC 9(02) VALUE 06.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-AGC-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-AGC-VITALITY           PIC 9(09) VALUE 0.
           05 WS-AGC-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-AGC-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-AGC-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 ANKH-GAZE-LOW               VALUE 2.
              88 XPLSM-PRECISION-LOW         VALUE 3.
              88 ZORSE-LAT-OUT-OF-BOUNDS     VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 GAZE-COLLAPSE               VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-GAZE-CONGRUENCE
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-ANKH-GAZE-M < 850 OR WS-ANKH-GAZE-M > 1000
                SET ANKH-GAZE-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-XPLSM-PRECISION-M < 800 OR WS-XPLSM-PRECISION-M > 1000
                SET XPLSM-PRECISION-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-ZORSE-LATENCY-MS < 2 OR WS-ZORSE-LATENCY-MS > 15
                SET ZORSE-LAT-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-GAZE-CONGRUENCE.
            COMPUTE WS-AGC-COMPOSITE = (WS-ANKH-GAZE-M / 2) +
                                       (WS-XPLSM-PRECISION-M / 2) +
                                       ((20 - WS-ZORSE-LATENCY-MS) * 20).

            COMPUTE WS-AGC-VITALITY = (WS-AGC-COMPOSITE / 4) +
                                      (WS-ANKH-GAZE-M / 4) +
                                      ((20 - WS-ZORSE-LATENCY-MS) * 4) + 1.

            IF WS-AGC-VITALITY EQUAL ZERO
                SET GAZE-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-AGC-COHERENCE = (WS-AGC-COMPOSITE / 16) +
                                       (WS-ANKH-GAZE-M / 16) +
                                       ((20 - WS-ZORSE-LATENCY-MS) * 2).

            COMPUTE WS-AGC-REBAR-LATCH = 1470169088 +
                                         (WS-AGC-COMPOSITE / 2) +
                                         ((20 - WS-ZORSE-LATENCY-MS) * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-AGC-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-AGC-VITALITY * 10) +
                                         (WS-AGC-COHERENCE * 10) +
                                         (WS-AGC-COMPOSITE * 10) +
                                         (WS-AGC-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-AGC-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-AGC-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
