       IDENTIFICATION DIVISION.
       PROGRAM-ID. CAPTURE-THE-ZERO-OWNERSHIP-STRATEGY.
       AUTHOR. AUNCIENT DYSNOMIA VM / CAPTURE THE ZERO PROOF OF OWNERSHIP.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-CLAIM-PARAMETERS.
          05 WS-U-CLAIMANT             PIC 9(09) VALUE 000049152.
          05 WS-V-CLAIMANT             PIC 9(09) VALUE 000016384.
          05 WS-U-OWN-SIGNATURE        PIC 9(09) VALUE 000049152.
          05 WS-V-OWN-SIGNATURE        PIC 9(09) VALUE 000016384.
          05 WS-DELEGATE-SOUL-ID       PIC 9(06) VALUE 000555.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-SHADOW-CAPTURE-BASE    PIC 9(12) VALUE 0.
          05 WS-SOUL-MOD               PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-CAPTURE-SEAL-CHARGE    PIC 9(09) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-SOUL-ID             VALUE 2.
             88 INVALID-TRAJECTORY-VECTORS  VALUE 3.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 4.
             88 OWNERSHIP-PROOF-MISMATCH    VALUE 5.
             88 GATING-CLAMP-OVERFLOW       VALUE 6.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 7.
             88 CASCADE-ROLLBACK-FAIL       VALUE 8.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-OWNERSHIP-SEAL
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-DELEGATE-SOUL-ID EQUAL ZERO
               SET INVALID-SOUL-ID TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-U-CLAIMANT EQUAL ZERO OR WS-V-CLAIMANT EQUAL ZERO OR
              WS-U-OWN-SIGNATURE EQUAL ZERO OR WS-V-OWN-SIGNATURE EQUAL ZERO
               SET INVALID-TRAJECTORY-VECTORS TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-U-CLAIMANT NOT EQUAL WS-U-OWN-SIGNATURE OR
              WS-V-CLAIMANT NOT EQUAL WS-V-OWN-SIGNATURE
               SET OWNERSHIP-PROOF-MISMATCH TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-OWNERSHIP-SEAL.
           COMPUTE WS-SHADOW-CAPTURE-BASE = (WS-CICS-WRITER-ID * 1000000) + 
               (WS-DELEGATE-SOUL-ID * 1000) + (WS-U-OWN-SIGNATURE / 16).

           COMPUTE WS-SOUL-MOD = FUNCTION MOD(WS-DELEGATE-SOUL-ID, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-SOUL-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-CAPTURE-SEAL-CHARGE = (WS-U-OWN-SIGNATURE * 4) + (WS-V-OWN-SIGNATURE * 2).

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-CAPTURE-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = (((WS-SHADOW-CAPTURE-BASE + WS-CAPTURE-SEAL-CHARGE) * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-CAPTURE-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-DELEGATE-SOUL-ID * 1000) + (WS-U-OWN-SIGNATURE / 16))
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-CAPTURE-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
