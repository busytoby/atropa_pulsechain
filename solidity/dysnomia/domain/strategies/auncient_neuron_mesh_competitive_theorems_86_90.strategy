        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-NEURON-MESH-THEOREMS-86-90.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-NEURON-MESH-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH86-TPA-ISOLATION-OK    PIC 9(01) VALUE 1.
            05  WS-TH87-NASH-PROVER-OK      PIC 9(01) VALUE 1.
            05  WS-TH88-SYNAPTIC-PLAST-OK   PIC 9(01) VALUE 1.
            05  WS-TH89-STRAT-PROMOTION-OK  PIC 9(01) VALUE 1.
            05  WS-TH90-SCSI-PARITY-OK      PIC 9(01) VALUE 1.
            05  WS-NEURON-PROOF-WITNESS     PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-NEURON-MESH.
            GOBACK.
        1000-EVALUATE-NEURON-MESH.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH86-TPA-ISOLATION-OK = 1 AND
               WS-TH87-NASH-PROVER-OK = 1 AND
               WS-TH88-SYNAPTIC-PLAST-OK = 1 AND
               WS-TH89-STRAT-PROMOTION-OK = 1 AND
               WS-TH90-SCSI-PARITY-OK = 1
                MOVE 1 TO WS-NEURON-PROOF-WITNESS
            ELSE
                MOVE 0 TO WS-NEURON-PROOF-WITNESS.
