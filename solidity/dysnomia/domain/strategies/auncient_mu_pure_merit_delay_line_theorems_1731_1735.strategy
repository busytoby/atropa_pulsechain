        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-PURE-MERIT.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-PURE-MERIT-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1731-PURE-MERIT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1732-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1733-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1734-1735M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1735-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-PURE-MERIT-WIT           PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-PURE-MERIT.
            GOBACK.
        1000-EVALUATE-PURE-MERIT.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1731-PURE-MERIT-OK = 1 AND
               WS-TH1732-DATBIN-STRAT-OK = 1 AND
               WS-TH1733-SUBMICRO-LAT-OK = 1 AND
               WS-TH1734-1735M-SAAT-OK = 1 AND
               WS-TH1735-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-PURE-MERIT-WIT
            ELSE
                MOVE 0 TO WS-PURE-MERIT-WIT.
