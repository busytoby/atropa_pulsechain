IDENTIFICATION DIVISION.
PROGRAM-ID. PROG-SUBORDINATE-COMPOSITION.

DATA DIVISION.
01 D0-SUBSTRATE-TRUNK.
   05 D0-MOTZKIN-PRIME          PIC 9(9) USAGE R0.
   05 D0-K-EXPONENT             PIC 9(9) USAGE R1.
   05 D0-PARENT-TRUNK-SAAT      PIC 9(9) USAGE R2.
01 D1-SUBORDINATE-HIERARCHY.
   05 D1-SUBORDINATE-COUNT      PIC 9(9) USAGE R3.
   05 D1-NESTING-DEPTH          PIC 9(9) USAGE R4.
   05 D1-FAULT-DEPTH            PIC 9(9) USAGE R5.
01 D2-GATING-DETENT.
   05 D2-G-SWIGLU-GATE          PIC 9(9) USAGE R6.
   05 D2-SHADOW-PARENT          PIC 9(9) USAGE R7.
   05 D2-SHADOW-SUBORDINATE     PIC 9(9) USAGE R8.
   05 D2-COMMITTED-STATE        PIC 9(9) USAGE R9.
01 D3-LEAF-EVAL.
   05 D3-COMPOSITION-RULING     PIC 9(9) USAGE R10.
   05 D3-DISP-WRAP-MOD          PIC 9(9) USAGE R11.

PROCEDURE DIVISION.
    MOVE 953467954 TO D0-MOTZKIN-PRIME.
    MOVE 3 TO D0-K-EXPONENT.
    MOVE 1000000 TO D0-PARENT-TRUNK-SAAT.
    MOVE 4 TO D1-SUBORDINATE-COUNT.
    MOVE 3 TO D1-NESTING-DEPTH.
    MOVE 0 TO D1-FAULT-DEPTH.

    PERFORM STAGE-HIERARCHY-SETUP.
    PERFORM EVALUATE-CASCADE-COMMIT.
    PERFORM SYNC-DISPLACEMENT-MOD.

    IF D2-SHADOW-PARENT == D0-PARENT-TRUNK-SAAT AND D1-NESTING-DEPTH <= 8
        MOVE 0 TO D3-COMPOSITION-RULING
        SET depth 4
    ELSE
        MOVE 4 TO D3-COMPOSITION-RULING
        SET depth 1
    END-IF.

    EVAL.
    GO TO END-STRATEGY.

STAGE-HIERARCHY-SETUP.
    MOVE D0-PARENT-TRUNK-SAAT TO D2-SHADOW-PARENT.
    COMPUTE D2-SHADOW-SUBORDINATE = D0-PARENT-TRUNK-SAAT / D1-SUBORDINATE-COUNT.
    COMPUTE D2-G-SWIGLU-GATE = 875 + ((125 * (8 - D1-NESTING-DEPTH)) / 8).
    EXIT.

EVALUATE-CASCADE-COMMIT.
    IF D1-FAULT-DEPTH > 0
        MOVE D2-SHADOW-SUBORDINATE TO D2-COMMITTED-STATE
    ELSE
        COMPUTE D2-COMMITTED-STATE = (((D0-PARENT-TRUNK-SAAT + (D1-SUBORDINATE-COUNT * 10000)) * D2-G-SWIGLU-GATE) / 1000)
    END-IF.
    EXIT.

SYNC-DISPLACEMENT-MOD.
    COMPUTE D3-DISP-WRAP-MOD = D2-COMMITTED-STATE - ((D2-COMMITTED-STATE / 256) * 256).
    EXIT.

END-STRATEGY.
