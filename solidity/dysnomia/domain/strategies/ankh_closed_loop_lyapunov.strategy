       IDENTIFICATION DIVISION.
       PROGRAM-ID. ANKH-CLOSED-LOOP-LYAPUNOV-STRATEGY.
       AUTHOR. AUNCIENT DYSNOMIA VM / ANKH LYAPUNOV CONVERGENCE.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-LYAPUNOV-PARAMETERS.
          05 WS-INITIAL-PERTURBATION   PIC 9(09) VALUE 000065536.
          05 WS-LOOP-ITERATIONS-N      PIC 9(02) VALUE 08.
          05 WS-TARGET-BOUND           PIC 9(09) VALUE 000030000.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-SHADOW-LYAPUNOV-BASE   PIC 9(12) VALUE 0.
          05 WS-CURRENT-V-ENERGY       PIC 9(09) VALUE 0.
          05 WS-LOOP-COUNTER           PIC 9(02) VALUE 0.
          05 WS-LOOP-MOD               PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-LOOP-COMMITTED-ENERGY  PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-INITIAL-PERTURB     VALUE 2.
             88 INVALID-LOOP-ITERATIONS     VALUE 3.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 4.
             88 LYAPUNOV-CONVERGENCE-FAIL   VALUE 5.
             88 GATING-CLAMP-OVERFLOW       VALUE 6.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 7.
             88 CASCADE-ROLLBACK-FAIL       VALUE 8.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-LYAPUNOV-CONTRACTION
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-INITIAL-PERTURBATION EQUAL ZERO
               SET INVALID-INITIAL-PERTURB TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-LOOP-ITERATIONS-N < 1 OR WS-LOOP-ITERATIONS-N > 16
               SET INVALID-LOOP-ITERATIONS TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-LYAPUNOV-CONTRACTION.
           COMPUTE WS-SHADOW-LYAPUNOV-BASE = (WS-CICS-WRITER-ID * 1000000) + 
               (WS-LOOP-ITERATIONS-N * 1000) + (WS-INITIAL-PERTURBATION / 16).

           MOVE WS-INITIAL-PERTURBATION TO WS-CURRENT-V-ENERGY.
           PERFORM VARYING WS-LOOP-COUNTER FROM 1 BY 1 UNTIL WS-LOOP-COUNTER > WS-LOOP-ITERATIONS-N
               COMPUTE WS-CURRENT-V-ENERGY = (WS-CURRENT-V-ENERGY * 875) / 1000
           END-PERFORM.

           IF WS-CURRENT-V-ENERGY > WS-TARGET-BOUND
               SET LYAPUNOV-CONVERGENCE-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-LOOP-MOD = FUNCTION MOD(WS-LOOP-ITERATIONS-N, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-LOOP-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-LYAPUNOV-BASE TO WS-LOOP-COMMITTED-ENERGY
           ELSE
               COMPUTE WS-LOOP-COMMITTED-ENERGY = (((WS-SHADOW-LYAPUNOV-BASE + WS-CURRENT-V-ENERGY) * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-LOOP-COMMITTED-ENERGY, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-LYAPUNOV-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-LOOP-ITERATIONS-N * 1000) + (WS-INITIAL-PERTURBATION / 16))
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-LOOP-COMMITTED-ENERGY NOT EQUAL WS-SHADOW-LYAPUNOV-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
