IDENTIFICATION DIVISION.
PROGRAM-ID. PROG-HARVARD-ZUO-2OF5.

DATA DIVISION.
01 D0-SUBSTRATE-TRUNK.
   05 D0-MOTZKIN-PRIME     PIC 9(9) USAGE R0.
   05 D0-K-EXPONENT        PIC 9(9) USAGE R1.
   05 D0-BIT-FLIP-FLAG     PIC 9(9) USAGE R2.
01 D1-DIGIT-SHADOW.
   05 D1-DECIMAL-DIGIT     PIC 9(9) USAGE R3.
   05 D1-SHADOW-DIGIT-SNAP PIC 9(9) USAGE R4.
01 D2-PARITY-STAGE.
   05 D2-CODE-WORD         PIC 9(9) USAGE R5.
   05 D2-HAMMING-WEIGHT    PIC 9(9) USAGE R6.
   05 D2-G-SWIGLU-GATE     PIC 9(9) USAGE R7.
   05 D2-COMMITTED-STATE   PIC 9(9) USAGE R8.
01 D3-LEAF-EVAL.
   05 D3-PROOF-RULING      PIC 9(9) USAGE R9.
   05 D3-DISP-WRAP-MOD     PIC 9(9) USAGE R10.

PROCEDURE DIVISION.
    MOVE 953467954 TO D0-MOTZKIN-PRIME.
    MOVE 3 TO D0-K-EXPONENT.
    MOVE 0 TO D0-BIT-FLIP-FLAG.
    MOVE 7 TO D1-DECIMAL-DIGIT.

    PERFORM STAGE-2OF5-PARITY.
    PERFORM APPLY-BIT-FLIP-LATCH.
    PERFORM SYNC-DISPLACEMENT.

    IF D1-SHADOW-DIGIT-SNAP == D1-DECIMAL-DIGIT AND D2-HAMMING-WEIGHT == 2
        MOVE 0 TO D3-PROOF-RULING
        SET depth 4
    ELSE
        MOVE 4 TO D3-PROOF-RULING
        SET depth 1
    END-IF.

    EVAL.
    GO TO END-STRATEGY.

STAGE-2OF5-PARITY.
    MOVE D1-DECIMAL-DIGIT TO D1-SHADOW-DIGIT-SNAP.
    MOVE 18 TO D2-CODE-WORD.
    MOVE 2 TO D2-HAMMING-WEIGHT.
    COMPUTE D2-G-SWIGLU-GATE = 875 + ((125 * D1-DECIMAL-DIGIT) / 9).
    EXIT.

APPLY-BIT-FLIP-LATCH.
    IF D0-BIT-FLIP-FLAG == 1
        MOVE D1-SHADOW-DIGIT-SNAP TO D2-COMMITTED-STATE
    ELSE
        COMPUTE D2-COMMITTED-STATE = ((D2-CODE-WORD * 1000) + (D1-DECIMAL-DIGIT * D2-G-SWIGLU-GATE)) / 1000
    END-IF.
    EXIT.

SYNC-DISPLACEMENT.
    COMPUTE D3-DISP-WRAP-MOD = D2-COMMITTED-STATE - ((D2-COMMITTED-STATE / 256) * 256).
    EXIT.

END-STRATEGY.
