        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-SPAT-LUT.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-SPAT-LUT-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1261-LUT-OK            PIC 9(01) VALUE 1.
            05  WS-TH1262-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1263-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1264-1265M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1265-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-SPAT-LUT-WIT             PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-SPAT-LUT.
            GOBACK.
        1000-EVALUATE-SPAT-LUT.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1261-LUT-OK = 1 AND
               WS-TH1262-DATBIN-STRAT-OK = 1 AND
               WS-TH1263-SUBMICRO-LAT-OK = 1 AND
               WS-TH1264-1265M-SAAT-OK = 1 AND
               WS-TH1265-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-SPAT-LUT-WIT
            ELSE
                MOVE 0 TO WS-SPAT-LUT-WIT.
