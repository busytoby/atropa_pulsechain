        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-STATOR-CONIFY.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-STATOR-CONIFY-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1431-CONIFY-OK         PIC 9(01) VALUE 1.
            05  WS-TH1432-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1433-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1434-1435M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1435-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-STATOR-CONIFY-WIT        PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-STATOR-CONIFY.
            GOBACK.
        1000-EVALUATE-STATOR-CONIFY.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1431-CONIFY-OK = 1 AND
               WS-TH1432-DATBIN-STRAT-OK = 1 AND
               WS-TH1433-SUBMICRO-LAT-OK = 1 AND
               WS-TH1434-1435M-SAAT-OK = 1 AND
               WS-TH1435-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-STATOR-CONIFY-WIT
            ELSE
                MOVE 0 TO WS-STATOR-CONIFY-WIT.
