        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-BF16.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-BF16-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1136-ALU-OK            PIC 9(01) VALUE 1.
            05  WS-TH1137-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1138-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1139-1140M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1140-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-FPGA-BF16-WIT            PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-FPGA-BF16.
            GOBACK.
        1000-EVALUATE-FPGA-BF16.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1136-ALU-OK = 1 AND
               WS-TH1137-DATBIN-STRAT-OK = 1 AND
               WS-TH1138-SUBMICRO-LAT-OK = 1 AND
               WS-TH1139-1140M-SAAT-OK = 1 AND
               WS-TH1140-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-FPGA-BF16-WIT
            ELSE
                MOVE 0 TO WS-FPGA-BF16-WIT.
