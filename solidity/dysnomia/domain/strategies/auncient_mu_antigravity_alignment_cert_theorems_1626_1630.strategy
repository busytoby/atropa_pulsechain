        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-AGY-CERT.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-AGY-CERT-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1626-CERT-OK           PIC 9(01) VALUE 1.
            05  WS-TH1627-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1628-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1629-1630M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1630-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-AGY-CERT-WIT             PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-AGY-CERT.
            GOBACK.
        1000-EVALUATE-AGY-CERT.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1626-CERT-OK = 1 AND
               WS-TH1627-DATBIN-STRAT-OK = 1 AND
               WS-TH1628-SUBMICRO-LAT-OK = 1 AND
               WS-TH1629-1630M-SAAT-OK = 1 AND
               WS-TH1630-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-AGY-CERT-WIT
            ELSE
                MOVE 0 TO WS-AGY-CERT-WIT.
