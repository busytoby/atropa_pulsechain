       IDENTIFICATION DIVISION.
       PROGRAM-ID. ANKH-SYMP-STRAT.
       AUTHOR. AUNCIENT DYSNOMIA VM / SYMPLECTIC EVALUATOR.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-SYMP-PARAMS.
          05 WS-INIT-AREA-DRIFT        PIC 9(05) VALUE 18000.
          05 WS-PHASE-DIM-D            PIC 9(02) VALUE 16.
          05 WS-EVAL-CYCLES-N          PIC 9(02) VALUE 16.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-CURRENT-DRIFT          PIC 9(05) VALUE 0.
          05 WS-STEP-IDX               PIC 9(02) VALUE 0.
          05 WS-SHADOW-SYMP-BASE       PIC 9(12) VALUE 0.
          05 WS-CYC-MOD                PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-AREA-DRIFT          VALUE 2.
             88 INVALID-PHASE-DIM-D         VALUE 3.
             88 INVALID-EVAL-CYCLES-N       VALUE 4.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
             88 SYMPLECTIC-DIVERG-FAIL      VALUE 6.
             88 GATING-CLAMP-OVERFLOW       VALUE 7.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 8.
             88 CASCADE-ROLLBACK-FAIL       VALUE 9.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-SYMPLECTIC-EVALUATION
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-INIT-AREA-DRIFT > 50000
               SET INVALID-AREA-DRIFT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-PHASE-DIM-D < 1 OR WS-PHASE-DIM-D > 64
               SET INVALID-PHASE-DIM-D TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-EVAL-CYCLES-N < 1 OR WS-EVAL-CYCLES-N > 64
               SET INVALID-EVAL-CYCLES-N TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-SYMPLECTIC-EVALUATION.
           MOVE WS-INIT-AREA-DRIFT TO WS-CURRENT-DRIFT.

           PERFORM VARYING WS-STEP-IDX FROM 1 BY 1 UNTIL WS-STEP-IDX > WS-EVAL-CYCLES-N
               COMPUTE WS-CURRENT-DRIFT = (WS-CURRENT-DRIFT * 875) / 1000
           END-PERFORM.

           IF WS-CURRENT-DRIFT > WS-INIT-AREA-DRIFT
               SET SYMPLECTIC-DIVERG-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-SHADOW-SYMP-BASE = (WS-CICS-WRITER-ID * 1000000) + 
               (WS-EVAL-CYCLES-N * 10000) + (WS-PHASE-DIM-D * 100) + (WS-CURRENT-DRIFT / 16).

           COMPUTE WS-CYC-MOD = FUNCTION MOD(WS-PHASE-DIM-D, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-CYC-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-SYMP-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-SYMP-BASE + ((WS-CURRENT-DRIFT * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-SYMP-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-EVAL-CYCLES-N * 10000) + (WS-PHASE-DIM-D * 100) + (WS-CURRENT-DRIFT / 16))
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-SYMP-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
