        IDENTIFICATION DIVISION.
        PROGRAM-ID. AZA-BEAR-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / AZATOI TEDDY BEAR MULTIMODAL AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-AZA-PARAMS.
           05 WS-BABY-SCHEMA-M          PIC 9(04) VALUE 0880.
           05 WS-INTENT-ERROR-M         PIC 9(04) VALUE 0780.
           05 WS-PROXEMIC-CLOSE-M       PIC 9(04) VALUE 0850.
           05 WS-UPWARD-GAZE-M          PIC 9(04) VALUE 0910.
           05 WS-PHANTOM-WHISPER-M      PIC 9(04) VALUE 0890.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-S-AZA-COMPOSITE        PIC 9(04) VALUE 0.
           05 WS-AZA-VITALITY           PIC 9(09) VALUE 0.
           05 WS-AZA-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-AZA-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-AZA-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 BABY-SCHEMA-UNDERFLOW       VALUE 2.
              88 INTENT-ERROR-UNDERFLOW      VALUE 3.
              88 PROXEMIC-CLOSE-UNDERFLOW    VALUE 4.
              88 UPWARD-GAZE-UNDERFLOW       VALUE 5.
              88 PHANTOM-WHISPER-UNDERFLOW   VALUE 6.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 7.
              88 AZATOI-BEHAVIOR-COLLAPSE    VALUE 8.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 9.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-AZATOI-SYNTHESIS
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-BABY-SCHEMA-M < 600 OR WS-BABY-SCHEMA-M > 950
                SET BABY-SCHEMA-UNDERFLOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-INTENT-ERROR-M < 600 OR WS-INTENT-ERROR-M > 950
                SET INTENT-ERROR-UNDERFLOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-PROXEMIC-CLOSE-M < 600 OR WS-PROXEMIC-CLOSE-M > 950
                SET PROXEMIC-CLOSE-UNDERFLOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-UPWARD-GAZE-M < 600 OR WS-UPWARD-GAZE-M > 950
                SET UPWARD-GAZE-UNDERFLOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-PHANTOM-WHISPER-M < 600 OR WS-PHANTOM-WHISPER-M > 950
                SET PHANTOM-WHISPER-UNDERFLOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-AZATOI-SYNTHESIS.
            COMPUTE WS-S-AZA-COMPOSITE = (WS-BABY-SCHEMA-M +
                                          WS-INTENT-ERROR-M +
                                          WS-PROXEMIC-CLOSE-M +
                                          WS-UPWARD-GAZE-M +
                                          WS-PHANTOM-WHISPER-M) / 5.

            IF WS-S-AZA-COMPOSITE < 500
                SET AZATOI-BEHAVIOR-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-AZA-VITALITY = (WS-S-AZA-COMPOSITE / 4) +
                                      (WS-BABY-SCHEMA-M / 8) +
                                      (WS-INTENT-ERROR-M / 8) +
                                      (WS-PROXEMIC-CLOSE-M / 8) +
                                      (WS-UPWARD-GAZE-M / 8) + 1.

            COMPUTE WS-AZA-COHERENCE = (WS-S-AZA-COMPOSITE / 16) +
                                       (WS-BABY-SCHEMA-M / 32) +
                                       (WS-INTENT-ERROR-M / 32) +
                                       (WS-PROXEMIC-CLOSE-M / 32) +
                                       (WS-UPWARD-GAZE-M / 32).

            COMPUTE WS-AZA-REBAR-LATCH = 1470169088 +
                                         (WS-S-AZA-COMPOSITE / 2) +
                                         (WS-BABY-SCHEMA-M / 4) +
                                         (WS-INTENT-ERROR-M / 4).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-AZA-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-AZA-VITALITY * 10) +
                                         (WS-AZA-COHERENCE * 10) +
                                         (WS-S-AZA-COMPOSITE * 10) +
                                         (WS-AZA-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-AZA-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-AZA-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
