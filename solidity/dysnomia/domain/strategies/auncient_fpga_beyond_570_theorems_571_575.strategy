        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-BEYOND-570.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-BEYOND-570-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH571-TREE-MERKLE-OK     PIC 9(01) VALUE 1.
            05  WS-TH572-YI-REG-MAP-OK      PIC 9(01) VALUE 1.
            05  WS-TH573-BRAM-LATENCY-OK    PIC 9(01) VALUE 1.
            05  WS-TH574-TREE-SAAT-OK       PIC 9(01) VALUE 1.
            05  WS-TH575-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-BEYOND-570-WIT      PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-BEYOND-570.
            GOBACK.
        1000-EVALUATE-BEYOND-570.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH571-TREE-MERKLE-OK = 1 AND
               WS-TH572-YI-REG-MAP-OK = 1 AND
               WS-TH573-BRAM-LATENCY-OK = 1 AND
               WS-TH574-TREE-SAAT-OK = 1 AND
               WS-TH575-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-BEYOND-570-WIT
            ELSE
                MOVE 0 TO WS-FPGA-BEYOND-570-WIT.
