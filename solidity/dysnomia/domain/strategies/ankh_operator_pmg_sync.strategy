       IDENTIFICATION DIVISION.
       PROGRAM-ID. ANKH-OP-PMG-STRAT.
       AUTHOR. AUNCIENT DYSNOMIA VM / PMG-PLL SYNCHRONIZER.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-PMG-PARAMS.
          05 WS-INIT-JITTER-PS         PIC 9(05) VALUE 15000.
          05 WS-PMG-CHANNELS           PIC 9(02) VALUE 08.
          05 WS-RASTER-CYCLES-N        PIC 9(02) VALUE 16.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-CURRENT-JITTER         PIC 9(05) VALUE 0.
          05 WS-STEP-IDX               PIC 9(02) VALUE 0.
          05 WS-SHADOW-PMG-BASE        PIC 9(12) VALUE 0.
          05 WS-CYC-MOD                PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-SCANLINE-JITTER     VALUE 2.
             88 INVALID-PMG-CHANNELS        VALUE 3.
             88 INVALID-RASTER-CYCLES       VALUE 4.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
             88 PMG-RASTER-JITTER-FAIL      VALUE 6.
             88 GATING-CLAMP-OVERFLOW       VALUE 7.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 8.
             88 CASCADE-ROLLBACK-FAIL       VALUE 9.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-PMG-CONTRACTION
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-INIT-JITTER-PS > 50000
               SET INVALID-SCANLINE-JITTER TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-PMG-CHANNELS NOT EQUAL 8 AND WS-PMG-CHANNELS NOT EQUAL 16
               SET INVALID-PMG-CHANNELS TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-RASTER-CYCLES-N < 1 OR WS-RASTER-CYCLES-N > 64
               SET INVALID-RASTER-CYCLES TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-PMG-CONTRACTION.
           MOVE WS-INIT-JITTER-PS TO WS-CURRENT-JITTER.

           PERFORM VARYING WS-STEP-IDX FROM 1 BY 1 UNTIL WS-STEP-IDX > WS-RASTER-CYCLES-N
               COMPUTE WS-CURRENT-JITTER = (WS-CURRENT-JITTER * 875) / 1000
           END-PERFORM.

           IF WS-CURRENT-JITTER > WS-INIT-JITTER-PS
               SET PMG-RASTER-JITTER-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-SHADOW-PMG-BASE = (WS-CICS-WRITER-ID * 1000000) + 
               (WS-RASTER-CYCLES-N * 10000) + (WS-PMG-CHANNELS * 100) + (WS-CURRENT-JITTER / 16).

           COMPUTE WS-CYC-MOD = FUNCTION MOD(WS-PMG-CHANNELS, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-CYC-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-PMG-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-PMG-BASE + ((WS-CURRENT-JITTER * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-PMG-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-RASTER-CYCLES-N * 10000) + (WS-PMG-CHANNELS * 100) + (WS-CURRENT-JITTER / 16))
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-PMG-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
