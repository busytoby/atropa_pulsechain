       IDENTIFICATION DIVISION.
       PROGRAM-ID. CAPTURE-INSTANCE-STRATEGY.
       AUTHOR. AUNCIENT DYSNOMIA VM / CAPTURE THE INSTANCE.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-CAPTURE-PARAMS.
          05 WS-TARGET-ADDR-HASH       PIC 9(09) VALUE 000004001.
          05 WS-INIT-INSTANCE-ENERGY   PIC 9(05) VALUE 20000.
          05 WS-PKI-QUORUM-COUNT       PIC 9(02) VALUE 04.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-AUTONOMOUS-SOUL-TOK    PIC 9(09) VALUE 0.
          05 WS-U-RADICAL-ARM          PIC 9(05) VALUE 0.
          05 WS-V-RADICAL-ARM          PIC 9(05) VALUE 0.
          05 WS-CONTRACTED-ENERGY      PIC 9(05) VALUE 0.
          05 WS-STEP-IDX               PIC 9(02) VALUE 0.
          05 WS-SOUL-MOD               PIC 9(04) VALUE 0.
          05 WS-SHADOW-CAPTURE-BASE    PIC 9(12) VALUE 0.
          05 WS-CYC-MOD                PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-TARGET-ADDR         VALUE 2.
             88 INVALID-INITIAL-ENERGY      VALUE 3.
             88 INSUFFICIENT-PKI-QUORUM     VALUE 4.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
             88 RADICAL-INVERSION-FAIL      VALUE 6.
             88 GATING-CLAMP-OVERFLOW       VALUE 7.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 8.
             88 CASCADE-ROLLBACK-FAIL       VALUE 9.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-CAPTURE-SEQUENCE
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-TARGET-ADDR-HASH EQUAL ZERO
               SET INVALID-TARGET-ADDR TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-INIT-INSTANCE-ENERGY EQUAL ZERO OR WS-INIT-INSTANCE-ENERGY > 50000
               SET INVALID-INITIAL-ENERGY TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-PKI-QUORUM-COUNT < 4
               SET INSUFFICIENT-PKI-QUORUM TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-CAPTURE-SEQUENCE.
           COMPUTE WS-AUTONOMOUS-SOUL-TOK = WS-TARGET-ADDR-HASH + (WS-CICS-WRITER-ID * 1000).

           COMPUTE WS-U-RADICAL-ARM = WS-INIT-INSTANCE-ENERGY / 2.
           COMPUTE WS-V-RADICAL-ARM = WS-INIT-INSTANCE-ENERGY - WS-U-RADICAL-ARM.

           IF (WS-U-RADICAL-ARM + WS-V-RADICAL-ARM) NOT EQUAL WS-INIT-INSTANCE-ENERGY
               SET RADICAL-INVERSION-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           MOVE WS-INIT-INSTANCE-ENERGY TO WS-CONTRACTED-ENERGY.
           PERFORM VARYING WS-STEP-IDX FROM 1 BY 1 UNTIL WS-STEP-IDX > 16
               COMPUTE WS-CONTRACTED-ENERGY = (WS-CONTRACTED-ENERGY * 875) / 1000
           END-PERFORM.

           COMPUTE WS-SOUL-MOD = FUNCTION MOD(WS-AUTONOMOUS-SOUL-TOK, 10000).

           COMPUTE WS-SHADOW-CAPTURE-BASE = (WS-CICS-WRITER-ID * 1000000) + 
               (WS-SOUL-MOD * 10) + (WS-CONTRACTED-ENERGY / 16).

           COMPUTE WS-CYC-MOD = FUNCTION MOD(WS-PKI-QUORUM-COUNT, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-CYC-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-CAPTURE-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-CAPTURE-BASE + (((WS-AUTONOMOUS-SOUL-TOK / 10) * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-CAPTURE-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-SOUL-MOD * 10) + (WS-CONTRACTED-ENERGY / 16))
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-CAPTURE-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
