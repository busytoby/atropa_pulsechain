        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-DMA.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-DMA-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1146-DMA-OK            PIC 9(01) VALUE 1.
            05  WS-TH1147-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1148-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1149-1150M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1150-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-FPGA-DMA-WIT             PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-FPGA-DMA.
            GOBACK.
        1000-EVALUATE-FPGA-DMA.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1146-DMA-OK = 1 AND
               WS-TH1147-DATBIN-STRAT-OK = 1 AND
               WS-TH1148-SUBMICRO-LAT-OK = 1 AND
               WS-TH1149-1150M-SAAT-OK = 1 AND
               WS-TH1150-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-FPGA-DMA-WIT
            ELSE
                MOVE 0 TO WS-FPGA-DMA-WIT.
