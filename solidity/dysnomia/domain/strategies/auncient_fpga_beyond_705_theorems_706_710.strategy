        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-BEYOND-705.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-BEYOND-705-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH706-CACHE-COH-OK       PIC 9(01) VALUE 1.
            05  WS-TH707-QUADTREE-TR-OK     PIC 9(01) VALUE 1.
            05  WS-TH708-CACHE-LAT-OK       PIC 9(01) VALUE 1.
            05  WS-TH709-710M-SAAT-OK       PIC 9(01) VALUE 1.
            05  WS-TH710-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-BEYOND-705-WIT      PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-BEYOND-705.
            GOBACK.
        1000-EVALUATE-BEYOND-705.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH706-CACHE-COH-OK = 1 AND
               WS-TH707-QUADTREE-TR-OK = 1 AND
               WS-TH708-CACHE-LAT-OK = 1 AND
               WS-TH709-710M-SAAT-OK = 1 AND
               WS-TH710-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-BEYOND-705-WIT
            ELSE
                MOVE 0 TO WS-FPGA-BEYOND-705-WIT.
