        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-EDSAC.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-EDSAC-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1651-EDSAC-OK          PIC 9(01) VALUE 1.
            05  WS-TH1652-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1653-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1654-1655M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1655-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-FPGA-EDSAC-WIT           PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-FPGA-EDSAC.
            GOBACK.
        1000-EVALUATE-FPGA-EDSAC.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1651-EDSAC-OK = 1 AND
               WS-TH1652-DATBIN-STRAT-OK = 1 AND
               WS-TH1653-SUBMICRO-LAT-OK = 1 AND
               WS-TH1654-1655M-SAAT-OK = 1 AND
               WS-TH1655-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-FPGA-EDSAC-WIT
            ELSE
                MOVE 0 TO WS-FPGA-EDSAC-WIT.
