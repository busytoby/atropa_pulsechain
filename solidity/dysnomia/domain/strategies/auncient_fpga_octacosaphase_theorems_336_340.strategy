        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-OCTACOSA.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-OCTACOSA-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH336-256PHASE-OK        PIC 9(01) VALUE 1.
            05  WS-TH337-FLUX-DENSITY-OK    PIC 9(01) VALUE 1.
            05  WS-TH338-CHATTER-REJECT-OK  PIC 9(01) VALUE 1.
            05  WS-TH339-OCTACOSA-SAAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH340-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-OCTACOSA-WIT        PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-OCTACOSA.
            GOBACK.
        1000-EVALUATE-OCTACOSA.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH336-256PHASE-OK = 1 AND
               WS-TH337-FLUX-DENSITY-OK = 1 AND
               WS-TH338-CHATTER-REJECT-OK = 1 AND
               WS-TH339-OCTACOSA-SAAT-OK = 1 AND
               WS-TH340-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-OCTACOSA-WIT
            ELSE
                MOVE 0 TO WS-FPGA-OCTACOSA-WIT.
