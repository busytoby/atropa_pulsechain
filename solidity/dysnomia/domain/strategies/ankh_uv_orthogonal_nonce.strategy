       IDENTIFICATION DIVISION.
       PROGRAM-ID. ANKH-UV-ORTHOGONAL-NONCE-STRATEGY.
       AUTHOR. AUNCIENT DYSNOMIA VM / ANKH UV ORTHOGONAL NONCE.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-NONCE-PARAMETERS.
          05 WS-S-SIGMA-SUM            PIC 9(09) VALUE 000065536.
          05 WS-S-PI-PRODUCT           PIC 9(09) VALUE 000032768.
          05 WS-EXPECTED-U-PHASE       PIC 9(09) VALUE 000049152.
          05 WS-EXPECTED-V-PHASE       PIC 9(09) VALUE 000016384.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-U-HAT-RECOVERED        PIC 9(09) VALUE 0.
          05 WS-V-HAT-RECOVERED        PIC 9(09) VALUE 0.
          05 WS-SHADOW-NONCE-BASE      PIC 9(12) VALUE 0.
          05 WS-SIGMA-MOD              PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-CROSSBAR-CHARGE        PIC 9(09) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-SYMMETRIC-SUM       VALUE 2.
             88 INVALID-SYMMETRIC-PRODUCT   VALUE 3.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 4.
             88 SUM-CONSERVATION-FAIL       VALUE 5.
             88 BIJECTIVE-PHASE-MISMATCH    VALUE 6.
             88 GATING-CLAMP-OVERFLOW       VALUE 7.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 8.
             88 CASCADE-ROLLBACK-FAIL       VALUE 9.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-NONCE-INVERSION
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-S-SIGMA-SUM EQUAL ZERO
               SET INVALID-SYMMETRIC-SUM TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-S-PI-PRODUCT EQUAL ZERO
               SET INVALID-SYMMETRIC-PRODUCT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-NONCE-INVERSION.
           COMPUTE WS-U-HAT-RECOVERED = (WS-S-PI-PRODUCT + WS-S-SIGMA-SUM) / 2.
           COMPUTE WS-V-HAT-RECOVERED = WS-S-SIGMA-SUM - WS-U-HAT-RECOVERED.

           IF (WS-U-HAT-RECOVERED + WS-V-HAT-RECOVERED) NOT EQUAL WS-S-SIGMA-SUM
               SET SUM-CONSERVATION-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-U-HAT-RECOVERED NOT EQUAL WS-EXPECTED-U-PHASE OR
              WS-V-HAT-RECOVERED NOT EQUAL WS-EXPECTED-V-PHASE
               SET BIJECTIVE-PHASE-MISMATCH TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-SHADOW-NONCE-BASE = (WS-CICS-WRITER-ID * 1000000) + 
               (WS-U-HAT-RECOVERED / 16) + (WS-V-HAT-RECOVERED / 16).

           COMPUTE WS-SIGMA-MOD = FUNCTION MOD(WS-S-SIGMA-SUM, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-SIGMA-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-CROSSBAR-CHARGE = (WS-U-HAT-RECOVERED * 4) + (WS-V-HAT-RECOVERED * 2).

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-NONCE-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = (((WS-SHADOW-NONCE-BASE + WS-CROSSBAR-CHARGE) * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-NONCE-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-U-HAT-RECOVERED / 16) + (WS-V-HAT-RECOVERED / 16))
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-NONCE-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
