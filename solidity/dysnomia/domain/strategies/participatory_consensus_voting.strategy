        IDENTIFICATION DIVISION.
        PROGRAM-ID. PART-VOTE-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / PARTICIPATORY VOTING AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-VOTE-PARAMS.
           05 WS-AFFIRM-VOTES           PIC 9(04) VALUE 0750.
           05 WS-PARTICIPANTS-COUNT     PIC 9(04) VALUE 0050.
           05 WS-CUE-BASELINE           PIC 9(04) VALUE 0600.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-MODULATED-CUE          PIC 9(04) VALUE 0.
           05 WS-VOTE-VITALITY          PIC 9(09) VALUE 0.
           05 WS-VOTE-COHERENCE         PIC 9(09) VALUE 0.
           05 WS-VOTE-REBAR-LATCH       PIC 9(12) VALUE 0.
           05 WS-SHADOW-VOTE-BASE       PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 INVALID-AFFIRMATIVE-VOTES   VALUE 2.
              88 INVALID-PARTICIPANTS-CNT    VALUE 3.
              88 INVALID-CUE-BASELINE        VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 CONSENSUS-VITALITY-COLLAP   VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-PARTICIPATORY-VOTING
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-AFFIRM-VOTES < 100 OR WS-AFFIRM-VOTES > 1000
                SET INVALID-AFFIRMATIVE-VOTES TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-PARTICIPANTS-COUNT < 5 OR WS-PARTICIPANTS-COUNT > 500
                SET INVALID-PARTICIPANTS-CNT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CUE-BASELINE < 100 OR WS-CUE-BASELINE > 1000
                SET INVALID-CUE-BASELINE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-MODULATED-CUE = (WS-CUE-BASELINE * (1000 + (WS-AFFIRM-VOTES - 500))) / 1000.
            IF WS-MODULATED-CUE > 1000
                MOVE 1000 TO WS-MODULATED-CUE
            END-IF.

            IF WS-MODULATED-CUE EQUAL ZERO
                SET CONSENSUS-VITALITY-COLLAP TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-PARTICIPATORY-VOTING.
            COMPUTE WS-VOTE-VITALITY = (WS-MODULATED-CUE / 4) +
                                       (WS-AFFIRM-VOTES / 8) +
                                       (WS-PARTICIPANTS-COUNT * 2) + 1.

            IF WS-VOTE-VITALITY EQUAL ZERO
                SET CONSENSUS-VITALITY-COLLAP TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-VOTE-COHERENCE = (WS-MODULATED-CUE / 16) +
                                        (WS-AFFIRM-VOTES / 32) +
                                        (WS-PARTICIPANTS-COUNT / 2).

            COMPUTE WS-VOTE-REBAR-LATCH = 1470169088 +
                                          (WS-MODULATED-CUE / 2) +
                                          (WS-AFFIRM-VOTES / 4).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-VOTE-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                          (WS-VOTE-VITALITY * 10) +
                                          (WS-VOTE-COHERENCE * 10) +
                                          (WS-MODULATED-CUE * 10) +
                                          (WS-VOTE-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-VOTE-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-VOTE-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
