        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-EDSAC-PIPE.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-EDSAC-PIPE-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1656-PIPE-OK           PIC 9(01) VALUE 1.
            05  WS-TH1657-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1658-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1659-1660M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1660-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-EDSAC-PIPE-WIT           PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-EDSAC-PIPE.
            GOBACK.
        1000-EVALUATE-EDSAC-PIPE.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1656-PIPE-OK = 1 AND
               WS-TH1657-DATBIN-STRAT-OK = 1 AND
               WS-TH1658-SUBMICRO-LAT-OK = 1 AND
               WS-TH1659-1660M-SAAT-OK = 1 AND
               WS-TH1660-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-EDSAC-PIPE-WIT
            ELSE
                MOVE 0 TO WS-EDSAC-PIPE-WIT.
