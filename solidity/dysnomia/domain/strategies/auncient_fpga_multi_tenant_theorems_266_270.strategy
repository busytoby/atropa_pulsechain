        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-MULTI-TENANT.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-MULTI-TENANT-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH266-PARTITION-OK       PIC 9(01) VALUE 1.
            05  WS-TH267-ISOLATION-OK       PIC 9(01) VALUE 1.
            05  WS-TH268-MUX-LATENCY-OK     PIC 9(01) VALUE 1.
            05  WS-TH269-SOLVENCY-OK        PIC 9(01) VALUE 1.
            05  WS-TH270-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-MULTI-TENANT-WIT    PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-MULTI-TENANT.
            GOBACK.
        1000-EVALUATE-MULTI-TENANT.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH266-PARTITION-OK = 1 AND
               WS-TH267-ISOLATION-OK = 1 AND
               WS-TH268-MUX-LATENCY-OK = 1 AND
               WS-TH269-SOLVENCY-OK = 1 AND
               WS-TH270-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-MULTI-TENANT-WIT
            ELSE
                MOVE 0 TO WS-FPGA-MULTI-TENANT-WIT.
