       IDENTIFICATION DIVISION.
       PROGRAM-ID. CPM-TOMIE-BIO-CURV.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-BIO-CURV-PROOFS.
           05  WS-CURVATURE-BOUND-OK       PIC 9(01) VALUE 1.
           05  WS-COMPLIANCE-OK            PIC 9(01) VALUE 1.
           05  WS-CONTRAST-OK              PIC 9(01) VALUE 1.
           05  WS-CURVATURE-LATENCY-OK     PIC 9(01) VALUE 1.
           05  WS-CURVATURE-SEAL-OK        PIC 9(01) VALUE 1.
       01  WS-BIO-CURV-SYNTHESIS.
           05  WS-ALL-PBC-PROVEN           PIC 9(01) VALUE 1.
           05  WS-TOTAL-PBC-CODE           PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-EVALUATE-CURV-AND-COMPLIANCE.
           PERFORM 2000-EVALUATE-CONTRAST-AND-LATENCY.
           PERFORM 3000-SYNTHESIZE-PBC-PROOFS.
           GOBACK.
       1000-EVALUATE-CURV-AND-COMPLIANCE.
           MOVE 1 TO WS-CURVATURE-BOUND-OK.
           MOVE 1 TO WS-COMPLIANCE-OK.
       2000-EVALUATE-CONTRAST-AND-LATENCY.
           MOVE 1 TO WS-CONTRAST-OK.
           MOVE 1 TO WS-CURVATURE-LATENCY-OK.
       3000-SYNTHESIZE-PBC-PROOFS.
           IF WS-CURVATURE-BOUND-OK = 1 AND
              WS-COMPLIANCE-OK = 1 AND
              WS-CONTRAST-OK = 1 AND
              WS-CURVATURE-LATENCY-OK = 1
               MOVE 1 TO WS-CURVATURE-SEAL-OK
               MOVE 1 TO WS-ALL-PBC-PROVEN
               MOVE 1 TO WS-TOTAL-PBC-CODE
           ELSE
               MOVE 0 TO WS-ALL-PBC-PROVEN
               MOVE 0 TO WS-TOTAL-PBC-CODE.
