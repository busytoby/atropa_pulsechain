        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FORMAL-SEAL.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FORMAL-SEAL-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1676-FORMAL-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-TH1677-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1678-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1679-1680M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1680-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-FORMAL-SEAL-WIT          PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-FORMAL-SEAL.
            GOBACK.
        1000-EVALUATE-FORMAL-SEAL.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1676-FORMAL-SEAL-OK = 1 AND
               WS-TH1677-DATBIN-STRAT-OK = 1 AND
               WS-TH1678-SUBMICRO-LAT-OK = 1 AND
               WS-TH1679-1680M-SAAT-OK = 1 AND
               WS-TH1680-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-FORMAL-SEAL-WIT
            ELSE
                MOVE 0 TO WS-FORMAL-SEAL-WIT.
