       IDENTIFICATION DIVISION.
       PROGRAM-ID. ANKH-PATENT-0012-STRAT.
       AUTHOR. AUNCIENT DYSNOMIA VM / PATENT 0012.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-PATENT-PARAMS.
          05 WS-PROHIBITED-BITMASK     PIC 9(05) VALUE 01024.
          05 WS-PREFETCH-STREAM-WORDS  PIC 9(05) VALUE 32768.
          05 WS-FIREWALL-CYCLES-N      PIC 9(02) VALUE 16.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-CURRENT-JITTER         PIC 9(05) VALUE 0.
          05 WS-STEP-IDX               PIC 9(02) VALUE 0.
          05 WS-STREAM-REM             PIC 9(03) VALUE 0.
          05 WS-SHADOW-PATENT-BASE     PIC 9(12) VALUE 0.
          05 WS-CYC-MOD                PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-PROHIBITED-BITMASK  VALUE 2.
             88 INVALID-STREAM-SIZE         VALUE 3.
             88 INVALID-FIREWALL-CYCLES     VALUE 4.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
             88 OPCODE-PREFETCH-FAIL        VALUE 6.
             88 GATING-CLAMP-OVERFLOW       VALUE 7.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 8.
             88 CASCADE-ROLLBACK-FAIL       VALUE 9.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-FIREWALL-GATING
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-PROHIBITED-BITMASK > 50000
               SET INVALID-PROHIBITED-BITMASK TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-PREFETCH-STREAM-WORDS < 1 OR WS-PREFETCH-STREAM-WORDS > 65536
               SET INVALID-STREAM-SIZE TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-FIREWALL-CYCLES-N < 1 OR WS-FIREWALL-CYCLES-N > 64
               SET INVALID-FIREWALL-CYCLES TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-FIREWALL-GATING.
           COMPUTE WS-STREAM-REM = FUNCTION MOD(WS-PREFETCH-STREAM-WORDS, 1000).
           COMPUTE WS-CURRENT-JITTER = WS-STREAM-REM * 20.
           IF WS-CURRENT-JITTER < 5000 MOVE 5000 TO WS-CURRENT-JITTER.
           IF WS-CURRENT-JITTER > 50000 MOVE 50000 TO WS-CURRENT-JITTER.

           PERFORM VARYING WS-STEP-IDX FROM 1 BY 1 UNTIL WS-STEP-IDX > WS-FIREWALL-CYCLES-N
               COMPUTE WS-CURRENT-JITTER = (WS-CURRENT-JITTER * 875) / 1000
           END-PERFORM.

           IF WS-CURRENT-JITTER > 50000
               SET OPCODE-PREFETCH-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-STREAM-REM = FUNCTION MOD(WS-PREFETCH-STREAM-WORDS, 100).

           COMPUTE WS-SHADOW-PATENT-BASE = (WS-CICS-WRITER-ID * 1000000) + 
               (WS-FIREWALL-CYCLES-N * 10000) + (WS-STREAM-REM * 10) + (WS-CURRENT-JITTER / 16).

           COMPUTE WS-CYC-MOD = FUNCTION MOD(WS-FIREWALL-CYCLES-N, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-CYC-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-PATENT-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-PATENT-BASE + ((WS-CURRENT-JITTER * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-PATENT-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-FIREWALL-CYCLES-N * 10000) + (WS-STREAM-REM * 10) + (WS-CURRENT-JITTER / 16))
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-PATENT-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
