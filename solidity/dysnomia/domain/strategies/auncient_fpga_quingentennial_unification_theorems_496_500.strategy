        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-QUIN-UNIF.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-QUIN-UNIF-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH496-COHERENCE-OK       PIC 9(01) VALUE 1.
            05  WS-TH497-AST-MERKLE-OK      PIC 9(01) VALUE 1.
            05  WS-TH498-TRI-PARADIGM-OK    PIC 9(01) VALUE 1.
            05  WS-TH499-QUIN-SAAT-OK       PIC 9(01) VALUE 1.
            05  WS-TH500-MASTER-SEAL-OK     PIC 9(01) VALUE 1.
            05  WS-FPGA-QUIN-UNIF-WIT       PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-QUIN-UNIF.
            GOBACK.
        1000-EVALUATE-QUIN-UNIF.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH496-COHERENCE-OK = 1 AND
               WS-TH497-AST-MERKLE-OK = 1 AND
               WS-TH498-TRI-PARADIGM-OK = 1 AND
               WS-TH499-QUIN-SAAT-OK = 1 AND
               WS-TH500-MASTER-SEAL-OK = 1
                MOVE 1 TO WS-FPGA-QUIN-UNIF-WIT
            ELSE
                MOVE 0 TO WS-FPGA-QUIN-UNIF-WIT.
