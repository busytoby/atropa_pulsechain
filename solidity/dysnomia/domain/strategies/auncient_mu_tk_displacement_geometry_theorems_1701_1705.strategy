        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-TK-GEOM.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-TK-GEOM-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1701-TK-GEOM-OK        PIC 9(01) VALUE 1.
            05  WS-TH1702-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1703-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1704-1705M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1705-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-TK-GEOM-WIT              PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-TK-GEOM.
            GOBACK.
        1000-EVALUATE-TK-GEOM.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1701-TK-GEOM-OK = 1 AND
               WS-TH1702-DATBIN-STRAT-OK = 1 AND
               WS-TH1703-SUBMICRO-LAT-OK = 1 AND
               WS-TH1704-1705M-SAAT-OK = 1 AND
               WS-TH1705-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-TK-GEOM-WIT
            ELSE
                MOVE 0 TO WS-TK-GEOM-WIT.
