        IDENTIFICATION DIVISION.
        PROGRAM-ID. TBX-ORC-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / TEDDY BEAR X PHANTOM ORACLE AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-ORC-PARAMS.
           05 WS-SCSI-LATENCY-MS        PIC 9(02) VALUE 03.
           05 WS-ULTRASONIC-DIFF-M      PIC 9(04) VALUE 0850.
           05 WS-DEAD-TIME-MS           PIC 9(04) VALUE 3500.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-ORC-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-ORC-VITALITY           PIC 9(09) VALUE 0.
           05 WS-ORC-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-ORC-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-ORC-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 SCSI-LATENCY-OUT-OF-BOUNDS  VALUE 2.
              88 ULTRASONIC-DIFF-OUT-OF-BND  VALUE 3.
              88 DEAD-TIME-OUT-OF-BOUNDS     VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 ORACLE-COLLAPSE             VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-PHANTOM-ORACLE
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-SCSI-LATENCY-MS < 1 OR WS-SCSI-LATENCY-MS > 10
                SET SCSI-LATENCY-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-ULTRASONIC-DIFF-M < 700 OR WS-ULTRASONIC-DIFF-M > 980
                SET ULTRASONIC-DIFF-OUT-OF-BND TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-DEAD-TIME-MS < 1500 OR WS-DEAD-TIME-MS > 8000
                SET DEAD-TIME-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-PHANTOM-ORACLE.
            COMPUTE WS-ORC-COMPOSITE = ((11 - WS-SCSI-LATENCY-MS) * 50) +
                                       (WS-ULTRASONIC-DIFF-M / 2) +
                                       (WS-DEAD-TIME-MS / 20).

            COMPUTE WS-ORC-VITALITY = (WS-ORC-COMPOSITE / 4) +
                                      (WS-ULTRASONIC-DIFF-M / 4) +
                                      ((11 - WS-SCSI-LATENCY-MS) * 10) + 1.

            IF WS-ORC-VITALITY EQUAL ZERO
                SET ORACLE-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-ORC-COHERENCE = (WS-ORC-COMPOSITE / 16) +
                                       (WS-ULTRASONIC-DIFF-M / 16) +
                                       ((11 - WS-SCSI-LATENCY-MS) * 2).

            COMPUTE WS-ORC-REBAR-LATCH = 1470169088 +
                                         (WS-ORC-COMPOSITE / 2) +
                                         ((11 - WS-SCSI-LATENCY-MS) * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-ORC-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-ORC-VITALITY * 10) +
                                         (WS-ORC-COHERENCE * 10) +
                                         (WS-ORC-COMPOSITE * 10) +
                                         (WS-ORC-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-ORC-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-ORC-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
