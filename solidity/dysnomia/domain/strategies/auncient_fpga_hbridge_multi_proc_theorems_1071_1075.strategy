        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-HBRIDGE.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-HBRIDGE-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1071-HBRIDGE-OK        PIC 9(01) VALUE 1.
            05  WS-TH1072-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1073-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1074-1075M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1075-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-FPGA-HBRIDGE-WIT         PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-FPGA-HBRIDGE.
            GOBACK.
        1000-EVALUATE-FPGA-HBRIDGE.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1071-HBRIDGE-OK = 1 AND
               WS-TH1072-DATBIN-STRAT-OK = 1 AND
               WS-TH1073-SUBMICRO-LAT-OK = 1 AND
               WS-TH1074-1075M-SAAT-OK = 1 AND
               WS-TH1075-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-FPGA-HBRIDGE-WIT
            ELSE
                MOVE 0 TO WS-FPGA-HBRIDGE-WIT.
