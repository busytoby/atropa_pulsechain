        IDENTIFICATION DIVISION.
        PROGRAM-ID. WGD-CLS-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / WEYL GEOMETRIC DOMAIN CLOSURE AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-WGD-PARAMS.
           05 WS-DOMAIN-CLOS-M          PIC 9(04) VALUE 0960.
           05 WS-VERLET-ACC-M           PIC 9(04) VALUE 0998.
           05 WS-MCP-MOUNT-LAT-MS       PIC 9(02) VALUE 05.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-WGD-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-WGD-VITALITY           PIC 9(09) VALUE 0.
           05 WS-WGD-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-WGD-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-WGD-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 DOMAIN-CLOSURE-LOW          VALUE 2.
              88 VERLET-ACCURACY-LOW         VALUE 3.
              88 MCP-MOUNT-LAT-OUT-OF-BOUNDS VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 DOMAIN-COLLAPSE             VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-DOMAIN-CLOSURE
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-DOMAIN-CLOS-M < 850 OR WS-DOMAIN-CLOS-M > 1000
                SET DOMAIN-CLOSURE-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-VERLET-ACC-M < 990 OR WS-VERLET-ACC-M > 1000
                SET VERLET-ACCURACY-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-MCP-MOUNT-LAT-MS < 2 OR WS-MCP-MOUNT-LAT-MS > 15
                SET MCP-MOUNT-LAT-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-DOMAIN-CLOSURE.
            COMPUTE WS-WGD-COMPOSITE = (WS-DOMAIN-CLOS-M / 2) +
                                       (WS-VERLET-ACC-M / 2) +
                                       ((20 - WS-MCP-MOUNT-LAT-MS) * 20).

            COMPUTE WS-WGD-VITALITY = (WS-WGD-COMPOSITE / 4) +
                                      (WS-DOMAIN-CLOS-M / 4) +
                                      ((20 - WS-MCP-MOUNT-LAT-MS) * 4) + 1.

            IF WS-WGD-VITALITY EQUAL ZERO
                SET DOMAIN-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-WGD-COHERENCE = (WS-WGD-COMPOSITE / 16) +
                                       (WS-DOMAIN-CLOS-M / 16) +
                                       ((20 - WS-MCP-MOUNT-LAT-MS) * 2).

            COMPUTE WS-WGD-REBAR-LATCH = 1470169088 +
                                         (WS-WGD-COMPOSITE / 2) +
                                         ((20 - WS-MCP-MOUNT-LAT-MS) * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-WGD-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-WGD-VITALITY * 10) +
                                         (WS-WGD-COHERENCE * 10) +
                                         (WS-WGD-COMPOSITE * 10) +
                                         (WS-WGD-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-WGD-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-WGD-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
