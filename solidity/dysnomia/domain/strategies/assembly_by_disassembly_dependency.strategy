        IDENTIFICATION DIVISION.
        PROGRAM-ID. ABD-DEP-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / ASSEMBLY-BY-DISASSEMBLY DEPENDENCY AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-ABD-PARAMS.
           05 WS-EXTRACTION-LAT-MS      PIC 9(02) VALUE 20.
           05 WS-TOPOLOGICAL-FID-M      PIC 9(04) VALUE 0960.
           05 WS-ORDERINGS-COUNT        PIC 9(02) VALUE 06.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-ABD-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-ABD-VITALITY           PIC 9(09) VALUE 0.
           05 WS-ABD-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-ABD-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-ABD-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 EXTRACTION-LAT-OUT-OF-BOUND VALUE 2.
              88 TOPOLOGICAL-FID-LOW         VALUE 3.
              88 ORDERINGS-COUNT-LOW         VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 DEPENDENCY-COLLAPSE         VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-ABD-DEPENDENCY
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-EXTRACTION-LAT-MS < 10 OR WS-EXTRACTION-LAT-MS > 50
                SET EXTRACTION-LAT-OUT-OF-BOUND TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-TOPOLOGICAL-FID-M < 850 OR WS-TOPOLOGICAL-FID-M > 1000
                SET TOPOLOGICAL-FID-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-ORDERINGS-COUNT < 4 OR WS-ORDERINGS-COUNT > 16
                SET ORDERINGS-COUNT-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-ABD-DEPENDENCY.
            COMPUTE WS-ABD-COMPOSITE = ((60 - WS-EXTRACTION-LAT-MS) * 10) +
                                       (WS-TOPOLOGICAL-FID-M / 2) +
                                       (WS-ORDERINGS-COUNT * 25).

            COMPUTE WS-ABD-VITALITY = (WS-ABD-COMPOSITE / 4) +
                                      (WS-TOPOLOGICAL-FID-M / 4) +
                                      ((60 - WS-EXTRACTION-LAT-MS) * 4) + 1.

            IF WS-ABD-VITALITY EQUAL ZERO
                SET DEPENDENCY-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-ABD-COHERENCE = (WS-ABD-COMPOSITE / 16) +
                                       (WS-TOPOLOGICAL-FID-M / 16) +
                                       ((60 - WS-EXTRACTION-LAT-MS) * 2).

            COMPUTE WS-ABD-REBAR-LATCH = 1470169088 +
                                         (WS-ABD-COMPOSITE / 2) +
                                         ((60 - WS-EXTRACTION-LAT-MS) * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-ABD-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-ABD-VITALITY * 10) +
                                         (WS-ABD-COHERENCE * 10) +
                                         (WS-ABD-COMPOSITE * 10) +
                                         (WS-ABD-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-ABD-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-ABD-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
