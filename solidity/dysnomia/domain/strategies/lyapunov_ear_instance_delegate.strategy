       IDENTIFICATION DIVISION.
       PROGRAM-ID. LYAPUNOV-EAR-DELEGATE-STRATEGY.
       AUTHOR. AUNCIENT DYSNOMIA VM / EAR DELEGATE INVARIANCE.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-EAR-DELEGATE-PARAMS.
          05 WS-EAR-ADDR-HASH          PIC 9(09) VALUE 000008001.
          05 WS-INIT-RENDER-ENERGY-SPL PIC 9(05) VALUE 20000.
          05 WS-DELEGATE-DEPTH-D       PIC 9(02) VALUE 08.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-CURRENT-RENDER-SPL     PIC 9(05) VALUE 0.
          05 WS-STEP-IDX               PIC 9(02) VALUE 0.
          05 WS-TOTAL-DELEGATE-ENERGY  PIC 9(09) VALUE 0.
          05 WS-EAR-ADDR-MOD           PIC 9(03) VALUE 0.
          05 WS-SHADOW-DELEGATE-BASE   PIC 9(12) VALUE 0.
          05 WS-CYC-MOD                PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-EAR-ADDR            VALUE 2.
             88 INVALID-RENDER-ENERGY       VALUE 3.
             88 INVALID-DELEGATE-DEPTH      VALUE 4.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
             88 RENDER-DIVERGENCE-FAIL      VALUE 6.
             88 GATING-CLAMP-OVERFLOW       VALUE 7.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 8.
             88 CASCADE-ROLLBACK-FAIL       VALUE 9.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-DELEGATE-CONTRACTION
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-EAR-ADDR-HASH EQUAL ZERO
               SET INVALID-EAR-ADDR TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-INIT-RENDER-ENERGY-SPL > 50000
               SET INVALID-RENDER-ENERGY TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-DELEGATE-DEPTH-D < 1 OR WS-DELEGATE-DEPTH-D > 16
               SET INVALID-DELEGATE-DEPTH TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-DELEGATE-CONTRACTION.
           MOVE WS-INIT-RENDER-ENERGY-SPL TO WS-CURRENT-RENDER-SPL.

           PERFORM VARYING WS-STEP-IDX FROM 1 BY 1 UNTIL WS-STEP-IDX > WS-DELEGATE-DEPTH-D
               COMPUTE WS-CURRENT-RENDER-SPL = (WS-CURRENT-RENDER-SPL * 875) / 1000
           END-PERFORM.

           IF WS-CURRENT-RENDER-SPL > WS-INIT-RENDER-ENERGY-SPL
               SET RENDER-DIVERGENCE-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-TOTAL-DELEGATE-ENERGY = WS-CURRENT-RENDER-SPL * WS-DELEGATE-DEPTH-D.
           COMPUTE WS-EAR-ADDR-MOD = FUNCTION MOD(WS-EAR-ADDR-HASH, 1000).

           COMPUTE WS-SHADOW-DELEGATE-BASE = (WS-CICS-WRITER-ID * 1000000) + 
               (WS-DELEGATE-DEPTH-D * 10000) + (WS-EAR-ADDR-MOD * 10) + (WS-TOTAL-DELEGATE-ENERGY / 16).

           COMPUTE WS-CYC-MOD = FUNCTION MOD(WS-DELEGATE-DEPTH-D, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-CYC-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-DELEGATE-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-DELEGATE-BASE + ((WS-CURRENT-RENDER-SPL * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-DELEGATE-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-DELEGATE-DEPTH-D * 10000) + (WS-EAR-ADDR-MOD * 10) + (WS-TOTAL-DELEGATE-ENERGY / 16))
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-DELEGATE-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
