        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-STATOR-ROTOR-151-155.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-DYNAMO-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH151-ORTHO-OK           PIC 9(01) VALUE 1.
            05  WS-TH152-INDUCTION-OK       PIC 9(01) VALUE 1.
            05  WS-TH153-DISPLACE-SYNC-OK   PIC 9(01) VALUE 1.
            05  WS-TH154-CRYSTALLIZE-OK     PIC 9(01) VALUE 1.
            05  WS-TH155-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-DYNAMO-WITNESS           PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-DYNAMO.
            GOBACK.
        1000-EVALUATE-DYNAMO.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH151-ORTHO-OK = 1 AND
               WS-TH152-INDUCTION-OK = 1 AND
               WS-TH153-DISPLACE-SYNC-OK = 1 AND
               WS-TH154-CRYSTALLIZE-OK = 1 AND
               WS-TH155-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-DYNAMO-WITNESS
            ELSE
                MOVE 0 TO WS-DYNAMO-WITNESS.
