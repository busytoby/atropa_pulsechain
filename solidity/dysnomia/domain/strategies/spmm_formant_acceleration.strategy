        IDENTIFICATION DIVISION.
        PROGRAM-ID. SPMM-ACCELERATION-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / SPMM AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-SPMM-PARAMS.
           05 WS-FORMANT-DIM            PIC 9(02) VALUE 05.
           05 WS-FRAME-SIZE             PIC 9(04) VALUE 0512.
           05 WS-SPARSITY-PCT           PIC 9(02) VALUE 85.
           05 WS-EXACT-FLAG             PIC 9(01) VALUE 1.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-SPMM-VITALITY          PIC 9(09) VALUE 0.
           05 WS-SPMM-COHERENCE         PIC 9(09) VALUE 0.
           05 WS-SPMM-REBAR-LATCH       PIC 9(12) VALUE 0.
           05 WS-SHADOW-SPMM-BASE       PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 INVALID-FORMANT-DIM         VALUE 2.
              88 INVALID-FRAME-SIZE          VALUE 3.
              88 INVALID-SPARSITY-PCT        VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 SPMM-EXACT-FAIL             VALUE 6.
              88 SPMM-DIVERG-FAIL            VALUE 7.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 8.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-SPMM
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-FORMANT-DIM < 1 OR WS-FORMANT-DIM > 16
                SET INVALID-FORMANT-DIM TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-FRAME-SIZE < 16 OR WS-FRAME-SIZE > 2048
                SET INVALID-FRAME-SIZE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-SPARSITY-PCT < 50 OR WS-SPARSITY-PCT > 99
                SET INVALID-SPARSITY-PCT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-EXACT-FLAG NOT EQUAL 1
                SET SPMM-EXACT-FAIL TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-SPMM.
            COMPUTE WS-SPMM-VITALITY = (WS-FORMANT-DIM * 512) +
                                       (WS-SPARSITY-PCT * 64) +
                                       (WS-FRAME-SIZE / 4) +
                                       (WS-EXACT-FLAG * 256) + 1.

            IF WS-SPMM-VITALITY EQUAL ZERO
                SET SPMM-DIVERG-FAIL TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-SPMM-COHERENCE = (WS-SPARSITY-PCT * 32) +
                                        (WS-FORMANT-DIM * 64) +
                                        (WS-FRAME-SIZE / 16).

            COMPUTE WS-SPMM-REBAR-LATCH = 1470169088 + (WS-FORMANT-DIM * 256) +
                                          (WS-SPARSITY-PCT * 64) +
                                          (WS-FRAME-SIZE / 8).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-SPMM-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                          (WS-SPMM-VITALITY * 10) +
                                          (WS-SPMM-COHERENCE * 10) +
                                          (WS-FORMANT-DIM * 1000) +
                                          (WS-SPMM-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-SPMM-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-SPMM-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
