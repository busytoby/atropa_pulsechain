        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-BEYOND-800.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-BEYOND-800-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH801-WAIT-FREE-OK       PIC 9(01) VALUE 1.
            05  WS-TH802-ABA-FREE-FIFO-OK   PIC 9(01) VALUE 1.
            05  WS-TH803-CAS-STEP-LAT-OK    PIC 9(01) VALUE 1.
            05  WS-TH804-805M-SAAT-OK       PIC 9(01) VALUE 1.
            05  WS-TH805-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-BEYOND-800-WIT      PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-BEYOND-800.
            GOBACK.
        1000-EVALUATE-BEYOND-800.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH801-WAIT-FREE-OK = 1 AND
               WS-TH802-ABA-FREE-FIFO-OK = 1 AND
               WS-TH803-CAS-STEP-LAT-OK = 1 AND
               WS-TH804-805M-SAAT-OK = 1 AND
               WS-TH805-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-BEYOND-800-WIT
            ELSE
                MOVE 0 TO WS-FPGA-BEYOND-800-WIT.
