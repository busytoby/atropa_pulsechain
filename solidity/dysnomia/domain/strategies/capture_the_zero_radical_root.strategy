       IDENTIFICATION DIVISION.
       PROGRAM-ID. CAPTURE-THE-ZERO-RADICAL-ROOT.
       AUTHOR. AUNCIENT DYSNOMIA VM / CAPTURE THE ZERO RADICAL ROOT.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-GAME-PARAMETERS.
          05 WS-INITIAL-SEED-MU0       PIC 9(12) VALUE 0001000000.
          05 WS-S-SIGMA-SUM            PIC 9(09) VALUE 000065536.
          05 WS-S-PI-PRODUCT           PIC 9(09) VALUE 000032768.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-U-HAT-TRAJECTORY       PIC 9(09) VALUE 0.
          05 WS-V-HAT-TRAJECTORY       PIC 9(09) VALUE 0.
          05 WS-SHADOW-SEED-BASELINE   PIC 9(12) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-SIGMA-MOD              PIC 9(02) VALUE 0.
          05 WS-RADICAL-FLUX           PIC 9(09) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-INITIAL-SEED        VALUE 2.
             88 INVALID-SYMMETRIC-SUM       VALUE 3.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 4.
             88 RADICAL-INVERSION-MISMATCH  VALUE 5.
             88 GATING-CLAMP-OVERFLOW       VALUE 6.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 7.
             88 CASCADE-ROLLBACK-FAIL       VALUE 8.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-RADICAL-ROOT
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-INITIAL-SEED-MU0 EQUAL ZERO
               SET INVALID-INITIAL-SEED TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-S-SIGMA-SUM EQUAL ZERO
               SET INVALID-SYMMETRIC-SUM TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-RADICAL-ROOT.
           COMPUTE WS-U-HAT-TRAJECTORY = (WS-S-PI-PRODUCT + WS-S-SIGMA-SUM) / 2.
           COMPUTE WS-V-HAT-TRAJECTORY = WS-S-SIGMA-SUM - WS-U-HAT-TRAJECTORY.

           IF (WS-U-HAT-TRAJECTORY + WS-V-HAT-TRAJECTORY) NOT EQUAL WS-S-SIGMA-SUM
               SET RADICAL-INVERSION-MISMATCH TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-SHADOW-SEED-BASELINE = (WS-CICS-WRITER-ID * 1000000) + WS-INITIAL-SEED-MU0.

           COMPUTE WS-SIGMA-MOD = FUNCTION MOD(WS-S-SIGMA-SUM, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-SIGMA-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-RADICAL-FLUX = (WS-U-HAT-TRAJECTORY * 16) + WS-V-HAT-TRAJECTORY.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-SEED-BASELINE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = (((WS-SHADOW-SEED-BASELINE + WS-RADICAL-FLUX) * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-SEED-BASELINE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + WS-INITIAL-SEED-MU0)
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-SEED-BASELINE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
