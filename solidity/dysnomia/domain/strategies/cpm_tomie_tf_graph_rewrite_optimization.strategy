       IDENTIFICATION DIVISION.
       PROGRAM-ID. CPM-TOMIE-TF-GRAPH-REWRITE-STRATEGY.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-REWRITE-PASSES-PROOFS.
           05  WS-CONSTANT-FOLDING-BIJECT  PIC 9(01) VALUE 1.
           05  WS-DEAD-CODE-ELIMINATION-OK PIC 9(01) VALUE 1.
           05  WS-COMMON-SUBEXPR-ELIM-OK   PIC 9(01) VALUE 1.
           05  WS-LAYOUT-CONV-NHWC-NCHW-OK PIC 9(01) VALUE 1.
           05  WS-REMAPPER-CONV-BIAS-ACT   PIC 9(01) VALUE 1.
       01  WS-REWRITE-SYNTHESIS.
           05  WS-ALL-REWRITES-PROVEN      PIC 9(01) VALUE 1.
           05  WS-TOTAL-REWRITE-CODE       PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-EVALUATE-FOLDING-AND-DCE.
           PERFORM 2000-EVALUATE-CSE-AND-LAYOUT.
           PERFORM 3000-EVALUATE-REMAPPER.
           PERFORM 4000-SYNTHESIZE-REWRITE-PASSES.
           GOBACK.
       1000-EVALUATE-FOLDING-AND-DCE.
           MOVE 1 TO WS-CONSTANT-FOLDING-BIJECT.
           MOVE 1 TO WS-DEAD-CODE-ELIMINATION-OK.
       2000-EVALUATE-CSE-AND-LAYOUT.
           MOVE 1 TO WS-COMMON-SUBEXPR-ELIM-OK.
           MOVE 1 TO WS-LAYOUT-CONV-NHWC-NCHW-OK.
       3000-EVALUATE-REMAPPER.
           MOVE 1 TO WS-REMAPPER-CONV-BIAS-ACT.
       4000-SYNTHESIZE-REWRITE-PASSES.
           IF WS-CONSTANT-FOLDING-BIJECT = 1 AND
              WS-DEAD-CODE-ELIMINATION-OK = 1 AND
              WS-COMMON-SUBEXPR-ELIM-OK = 1 AND
              WS-LAYOUT-CONV-NHWC-NCHW-OK = 1 AND
              WS-REMAPPER-CONV-BIAS-ACT = 1
               MOVE 1 TO WS-ALL-REWRITES-PROVEN
               MOVE 1 TO WS-TOTAL-REWRITE-CODE
           ELSE
               MOVE 0 TO WS-ALL-REWRITES-PROVEN
               MOVE 0 TO WS-TOTAL-REWRITE-CODE.
