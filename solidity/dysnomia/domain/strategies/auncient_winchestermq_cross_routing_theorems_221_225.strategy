        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-WMQ-CROSS-ROUTING.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-WMQ-ROUTING-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH221-ORTHOGONAL-OK      PIC 9(01) VALUE 1.
            05  WS-TH222-ARBITRATION-OK     PIC 9(01) VALUE 1.
            05  WS-TH223-XDC-CONSENSUS-OK   PIC 9(01) VALUE 1.
            05  WS-TH224-SAAT-CLEAR-OK      PIC 9(01) VALUE 1.
            05  WS-TH225-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-WMQ-ROUTING-WITNESS      PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-WMQ-ROUTING.
            GOBACK.
        1000-EVALUATE-WMQ-ROUTING.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH221-ORTHOGONAL-OK = 1 AND
               WS-TH222-ARBITRATION-OK = 1 AND
               WS-TH223-XDC-CONSENSUS-OK = 1 AND
               WS-TH224-SAAT-CLEAR-OK = 1 AND
               WS-TH225-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-WMQ-ROUTING-WITNESS
            ELSE
                MOVE 0 TO WS-WMQ-ROUTING-WITNESS.
