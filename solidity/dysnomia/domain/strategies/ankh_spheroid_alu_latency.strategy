       IDENTIFICATION DIVISION.
       PROGRAM-ID. ANKH-ALU-LATENCY.
       AUTHOR. AUNCIENT DYSNOMIA VM / ANKH ALU LATENCY.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-ANKH-PARAMS.
          05 WS-INIT-LATENCY-NS        PIC 9(05) VALUE 18000.
          05 WS-CONTEXT-LENGTH         PIC 9(05) VALUE 04096.
          05 WS-AUTOREG-STEPS-N        PIC 9(02) VALUE 16.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-CURRENT-LATENCY        PIC 9(05) VALUE 0.
          05 WS-STEP-IDX               PIC 9(02) VALUE 0.
          05 WS-CTX-MOD                PIC 9(03) VALUE 0.
          05 WS-SHADOW-ANKH-BASE       PIC 9(12) VALUE 0.
          05 WS-CYC-MOD                PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-LATENCY             VALUE 2.
             88 INVALID-CONTEXT-LENGTH      VALUE 3.
             88 INVALID-AUTOREG-STEPS       VALUE 4.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
             88 LATENCY-JITTER-DIVERG-FAIL  VALUE 6.
             88 GATING-CLAMP-OVERFLOW       VALUE 7.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 8.
             88 CASCADE-ROLLBACK-FAIL       VALUE 9.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-DECODING-LATENCY-LOOP
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-INIT-LATENCY-NS > 50000
               SET INVALID-LATENCY TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CONTEXT-LENGTH < 1 OR WS-CONTEXT-LENGTH > 8192
               SET INVALID-CONTEXT-LENGTH TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-AUTOREG-STEPS-N < 1 OR WS-AUTOREG-STEPS-N > 64
               SET INVALID-AUTOREG-STEPS TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-DECODING-LATENCY-LOOP.
           MOVE WS-INIT-LATENCY-NS TO WS-CURRENT-LATENCY.

           PERFORM VARYING WS-STEP-IDX FROM 1 BY 1 UNTIL WS-STEP-IDX > WS-AUTOREG-STEPS-N
               COMPUTE WS-CURRENT-LATENCY = (WS-CURRENT-LATENCY * 875) / 1000
           END-PERFORM.

           IF WS-CURRENT-LATENCY > WS-INIT-LATENCY-NS
               SET LATENCY-JITTER-DIVERG-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-CTX-MOD = FUNCTION MOD(WS-CONTEXT-LENGTH, 100).

           COMPUTE WS-SHADOW-ANKH-BASE = (WS-CICS-WRITER-ID * 1000000) + 
               (WS-AUTOREG-STEPS-N * 10000) + (WS-CTX-MOD * 10) + (WS-CURRENT-LATENCY / 16).

           COMPUTE WS-CYC-MOD = FUNCTION MOD(WS-AUTOREG-STEPS-N, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-CYC-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-ANKH-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-ANKH-BASE + ((WS-CURRENT-LATENCY * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-ANKH-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-AUTOREG-STEPS-N * 10000) + (WS-CTX-MOD * 10) + (WS-CURRENT-LATENCY / 16))
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-ANKH-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
