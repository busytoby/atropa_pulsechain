       IDENTIFICATION DIVISION.
       PROGRAM-ID. TOTIENT-STRATEGY-ACCUMULATION.
       AUTHOR. AUNCIENT DYSNOMIA VM / UNIVERSAL VALVE STRATEGY ACCUMULATION.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-ACCUMULATION-PARAMETERS.
          05 WS-INITIAL-TOTIENT-MU0    PIC 9(12) VALUE 0001000000.
          05 WS-ASSIGNED-STRATEGIES    PIC 9(02) VALUE 04.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-PLL-PHASE-ERR          PIC S9(05) VALUE +00064.
          05 WS-FAULT-STRATEGY-IDX     PIC 9(02) VALUE 00.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-ROOT-SHADOW-BASELINE   PIC 9(12) VALUE 0.
          05 WS-ACCUMULATED-CHARGE     PIC 9(12) VALUE 0.
          05 WS-DEPTH-COUNTER          PIC 9(02) VALUE 0.
          05 WS-G-GATE-K               PIC 9(04) VALUE 0.
          05 WS-STRATEGY-QUANTA-K      PIC 9(09) VALUE 0.
          05 WS-DELTA-CHARGE-K         PIC 9(09) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.
          05 WS-ABS-PHASE-ERR          PIC 9(05) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-INITIAL-TOTIENT     VALUE 2.
             88 INVALID-STRATEGY-COUNT      VALUE 3.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 4.
             88 PLL-PHASE-LOCK-FAIL         VALUE 5.
             88 FAULT-INDEX-OVERFLOW        VALUE 6.
             88 GATING-CLAMP-OVERFLOW       VALUE 7.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 8.
             88 CASCADE-ROLLBACK-FAIL       VALUE 9.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-STRATEGY-ACCUMULATION
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-INITIAL-TOTIENT-MU0 EQUAL ZERO
               SET INVALID-INITIAL-TOTIENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-ASSIGNED-STRATEGIES < 1 OR WS-ASSIGNED-STRATEGIES > 8
               SET INVALID-STRATEGY-COUNT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-PLL-PHASE-ERR < -512 OR WS-PLL-PHASE-ERR > +512
               SET PLL-PHASE-LOCK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-FAULT-STRATEGY-IDX > WS-ASSIGNED-STRATEGIES
               SET FAULT-INDEX-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-STRATEGY-ACCUMULATION.
           MOVE WS-INITIAL-TOTIENT-MU0 TO WS-ROOT-SHADOW-BASELINE.
           MOVE WS-INITIAL-TOTIENT-MU0 TO WS-ACCUMULATED-CHARGE.

           IF WS-PLL-PHASE-ERR < 0
               COMPUTE WS-ABS-PHASE-ERR = - WS-PLL-PHASE-ERR
           ELSE
               MOVE WS-PLL-PHASE-ERR TO WS-ABS-PHASE-ERR
           END-IF.

           PERFORM VARYING WS-DEPTH-COUNTER FROM 1 BY 1
                   UNTIL WS-DEPTH-COUNTER > WS-ASSIGNED-STRATEGIES
               COMPUTE WS-G-GATE-K = 875 + ((125 * WS-DEPTH-COUNTER) / 8)
               IF WS-G-GATE-K < 875 OR WS-G-GATE-K > 1000
                   SET GATING-CLAMP-OVERFLOW TO TRUE
                   EXIT PARAGRAPH
               END-IF

               COMPUTE WS-STRATEGY-QUANTA-K = WS-DEPTH-COUNTER * 10000

               IF WS-FAULT-STRATEGY-IDX > 0 AND WS-DEPTH-COUNTER >= WS-FAULT-STRATEGY-IDX
                   MOVE 0 TO WS-DELTA-CHARGE-K
               ELSE
                   COMPUTE WS-DELTA-CHARGE-K = (((WS-STRATEGY-QUANTA-K + ((512 - WS-ABS-PHASE-ERR) * 16)) * WS-G-GATE-K) / 1000)
                   COMPUTE WS-ACCUMULATED-CHARGE = WS-ACCUMULATED-CHARGE + WS-DELTA-CHARGE-K
               END-IF
           END-PERFORM.

           MOVE WS-ACCUMULATED-CHARGE TO WS-COMMITTED-OUTPUT.
           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-ROOT-SHADOW-BASELINE NOT EQUAL WS-INITIAL-TOTIENT-MU0
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-FAULT-STRATEGY-IDX EQUAL 1 AND WS-COMMITTED-OUTPUT NOT EQUAL WS-ROOT-SHADOW-BASELINE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
