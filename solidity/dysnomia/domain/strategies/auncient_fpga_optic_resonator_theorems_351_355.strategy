        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-OPTIC.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-OPTIC-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH351-WDM-32CH-OK        PIC 9(01) VALUE 1.
            05  WS-TH352-FABRY-PEROT-OK     PIC 9(01) VALUE 1.
            05  WS-TH353-INSERT-LOSS-OK     PIC 9(01) VALUE 1.
            05  WS-TH354-PHOTONIC-SAAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH355-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-OPTIC-WIT           PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-OPTIC.
            GOBACK.
        1000-EVALUATE-OPTIC.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH351-WDM-32CH-OK = 1 AND
               WS-TH352-FABRY-PEROT-OK = 1 AND
               WS-TH353-INSERT-LOSS-OK = 1 AND
               WS-TH354-PHOTONIC-SAAT-OK = 1 AND
               WS-TH355-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-OPTIC-WIT
            ELSE
                MOVE 0 TO WS-FPGA-OPTIC-WIT.
