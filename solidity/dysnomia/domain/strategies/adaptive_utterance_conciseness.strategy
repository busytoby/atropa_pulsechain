        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUC-PRN-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / ADAPTIVE UTTERANCE CONCISENESS AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-AUC-PARAMS.
           05 WS-SPEECH-BURST-TOK       PIC 9(02) VALUE 06.
           05 WS-MONO-COMPRESS-M        PIC 9(04) VALUE 0950.
           05 WS-VEL-THROTTLE-MS        PIC 9(02) VALUE 20.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-AUC-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-AUC-VITALITY           PIC 9(09) VALUE 0.
           05 WS-AUC-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-AUC-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-AUC-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 SPEECH-BURST-OUT-OF-BOUNDS  VALUE 2.
              88 MONOLOGUE-COMPRESS-LOW      VALUE 3.
              88 VEL-THROTTLE-OUT-OF-BOUNDS  VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 CONCISENESS-COLLAPSE        VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-UTTERANCE-PRUNING
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-SPEECH-BURST-TOK < 3 OR WS-SPEECH-BURST-TOK > 12
                SET SPEECH-BURST-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-MONO-COMPRESS-M < 800 OR WS-MONO-COMPRESS-M > 1000
                SET MONOLOGUE-COMPRESS-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-VEL-THROTTLE-MS < 10 OR WS-VEL-THROTTLE-MS > 50
                SET VEL-THROTTLE-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-UTTERANCE-PRUNING.
            COMPUTE WS-AUC-COMPOSITE = ((15 - WS-SPEECH-BURST-TOK) * 20) +
                                       (WS-MONO-COMPRESS-M / 2) +
                                       ((60 - WS-VEL-THROTTLE-MS) * 10).

            COMPUTE WS-AUC-VITALITY = (WS-AUC-COMPOSITE / 4) +
                                      (WS-MONO-COMPRESS-M / 4) +
                                      ((15 - WS-SPEECH-BURST-TOK) * 4) + 1.

            IF WS-AUC-VITALITY EQUAL ZERO
                SET CONCISENESS-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-AUC-COHERENCE = (WS-AUC-COMPOSITE / 16) +
                                       (WS-MONO-COMPRESS-M / 16) +
                                       ((15 - WS-SPEECH-BURST-TOK) * 2).

            COMPUTE WS-AUC-REBAR-LATCH = 1470169088 +
                                         (WS-AUC-COMPOSITE / 2) +
                                         ((15 - WS-SPEECH-BURST-TOK) * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-AUC-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-AUC-VITALITY * 10) +
                                         (WS-AUC-COHERENCE * 10) +
                                         (WS-AUC-COMPOSITE * 10) +
                                         (WS-AUC-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-AUC-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-AUC-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
