        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-CLEAN-CERT.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-CLEAN-CERT-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1681-CLEAN-CERT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1682-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1683-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1684-1685M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1685-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-CLEAN-CERT-WIT           PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-CLEAN-CERT.
            GOBACK.
        1000-EVALUATE-CLEAN-CERT.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1681-CLEAN-CERT-OK = 1 AND
               WS-TH1682-DATBIN-STRAT-OK = 1 AND
               WS-TH1683-SUBMICRO-LAT-OK = 1 AND
               WS-TH1684-1685M-SAAT-OK = 1 AND
               WS-TH1685-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-CLEAN-CERT-WIT
            ELSE
                MOVE 0 TO WS-CLEAN-CERT-WIT.
