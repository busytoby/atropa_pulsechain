        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-SYMBOLIC-LLM.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-SYMBOLIC-LLM-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH371-64KTRIE-VOCAB-OK   PIC 9(01) VALUE 1.
            05  WS-TH372-SWIGLU-GATING-OK   PIC 9(01) VALUE 1.
            05  WS-TH373-AHOCORASICK-OK     PIC 9(01) VALUE 1.
            05  WS-TH374-SYMBOLIC-SAAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH375-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-SYMBOLIC-LLM-WIT    PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-SYMBOLIC-LLM.
            GOBACK.
        1000-EVALUATE-SYMBOLIC-LLM.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH371-64KTRIE-VOCAB-OK = 1 AND
               WS-TH372-SWIGLU-GATING-OK = 1 AND
               WS-TH373-AHOCORASICK-OK = 1 AND
               WS-TH374-SYMBOLIC-SAAT-OK = 1 AND
               WS-TH375-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-SYMBOLIC-LLM-WIT
            ELSE
                MOVE 0 TO WS-FPGA-SYMBOLIC-LLM-WIT.
