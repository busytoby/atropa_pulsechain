        IDENTIFICATION DIVISION.
        PROGRAM-ID. MONOTONIC-SPMM-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / MONOTONIC ATTENTION AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-ATTN-PARAMS.
           05 WS-PHONEME-LEN            PIC 9(02) VALUE 07.
           05 WS-FRAME-COUNT            PIC 9(04) VALUE 0128.
           05 WS-ATTN-BANDWIDTH         PIC 9(02) VALUE 04.
           05 WS-BAND-FLAG              PIC 9(01) VALUE 1.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-ATTN-VITALITY          PIC 9(09) VALUE 0.
           05 WS-ATTN-COHERENCE         PIC 9(09) VALUE 0.
           05 WS-ATTN-REBAR-LATCH       PIC 9(12) VALUE 0.
           05 WS-SHADOW-ATTN-BASE       PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 INVALID-PHONEME-LEN         VALUE 2.
              88 INVALID-FRAME-COUNT         VALUE 3.
              88 INVALID-ATTN-BAND           VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 MONOTONIC-BAND-FAIL         VALUE 6.
              88 ATTENTION-DIVERG-FAIL       VALUE 7.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 8.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-MONOTONIC-SPMM
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-PHONEME-LEN < 1 OR WS-PHONEME-LEN > 64
                SET INVALID-PHONEME-LEN TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-FRAME-COUNT < 16 OR WS-FRAME-COUNT > 512
                SET INVALID-FRAME-COUNT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-ATTN-BANDWIDTH < 1 OR WS-ATTN-BANDWIDTH > 16
                SET INVALID-ATTN-BAND TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-BAND-FLAG NOT EQUAL 1
                SET MONOTONIC-BAND-FAIL TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-MONOTONIC-SPMM.
            COMPUTE WS-ATTN-VITALITY = (WS-PHONEME-LEN * 512) +
                                       (WS-ATTN-BANDWIDTH * 128) +
                                       (WS-FRAME-COUNT / 2) +
                                       (WS-BAND-FLAG * 256) + 1.

            IF WS-ATTN-VITALITY EQUAL ZERO
                SET ATTENTION-DIVERG-FAIL TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-ATTN-COHERENCE = (WS-ATTN-BANDWIDTH * 32) +
                                        (WS-PHONEME-LEN * 64) +
                                        (WS-FRAME-COUNT / 16).

            COMPUTE WS-ATTN-REBAR-LATCH = 1470169088 + (WS-PHONEME-LEN * 256) +
                                          (WS-ATTN-BANDWIDTH * 64) +
                                          (WS-FRAME-COUNT / 8).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-ATTN-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                          (WS-ATTN-VITALITY * 10) +
                                          (WS-ATTN-COHERENCE * 10) +
                                          (WS-PHONEME-LEN * 1000) +
                                          (WS-ATTN-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-ATTN-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-ATTN-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
