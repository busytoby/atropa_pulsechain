        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-SCHUURMAN-THEOREMS-36-40.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-SCHUURMAN-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH36-5STAGE-LIFECYCLE-OK PIC 9(01) VALUE 1.
            05  WS-TH37-TRIAD-BALANCE-OK    PIC 9(01) VALUE 1.
            05  WS-TH38-TEMPORAL-DAG-OK     PIC 9(01) VALUE 1.
            05  WS-TH39-RUBIN-CAUSALITY-OK  PIC 9(01) VALUE 1.
            05  WS-TH40-NASH-CO-CREATION-OK PIC 9(01) VALUE 1.
            05  WS-SCHUURMAN-PROOF-WITNESS  PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-SCHUURMAN-THEOREMS.
            GOBACK.
        1000-EVALUATE-SCHUURMAN-THEOREMS.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH36-5STAGE-LIFECYCLE-OK = 1 AND
               WS-TH37-TRIAD-BALANCE-OK = 1 AND
               WS-TH38-TEMPORAL-DAG-OK = 1 AND
               WS-TH39-RUBIN-CAUSALITY-OK = 1 AND
               WS-TH40-NASH-CO-CREATION-OK = 1
                MOVE 1 TO WS-SCHUURMAN-PROOF-WITNESS
            ELSE
                MOVE 0 TO WS-SCHUURMAN-PROOF-WITNESS.
