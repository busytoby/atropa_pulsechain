        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-BEYOND-590.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-BEYOND-590-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH591-DAT-VM-OK          PIC 9(01) VALUE 1.
            05  WS-TH592-CROSS-CHAIN-OK     PIC 9(01) VALUE 1.
            05  WS-TH593-DAT-LATENCY-OK     PIC 9(01) VALUE 1.
            05  WS-TH594-CHAIN-SAAT-OK      PIC 9(01) VALUE 1.
            05  WS-TH595-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-BEYOND-590-WIT      PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-BEYOND-590.
            GOBACK.
        1000-EVALUATE-BEYOND-590.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH591-DAT-VM-OK = 1 AND
               WS-TH592-CROSS-CHAIN-OK = 1 AND
               WS-TH593-DAT-LATENCY-OK = 1 AND
               WS-TH594-CHAIN-SAAT-OK = 1 AND
               WS-TH595-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-BEYOND-590-WIT
            ELSE
                MOVE 0 TO WS-FPGA-BEYOND-590-WIT.
