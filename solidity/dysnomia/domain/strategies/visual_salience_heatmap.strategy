        IDENTIFICATION DIVISION.
        PROGRAM-ID. VSH-SAL-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / VISUAL SALIENCE HEATMAP AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-VSH-PARAMS.
           05 WS-HEATMAP-LAT-MS         PIC 9(02) VALUE 12.
           05 WS-CONTRAST-FID-M         PIC 9(04) VALUE 0960.
           05 WS-DIMMING-DRIFT-M        PIC 9(02) VALUE 01.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-VSH-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-VSH-VITALITY           PIC 9(09) VALUE 0.
           05 WS-VSH-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-VSH-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-VSH-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 HEATMAP-LAT-OUT-OF-BOUNDS   VALUE 2.
              88 CONTRAST-FIDELITY-LOW       VALUE 3.
              88 DIMMING-DRIFT-EXCEEDED      VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 SALIENCE-COLLAPSE           VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-SALIENCE-HEATMAP
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3 AND WS-K-EXPONENT NOT EQUAL 4
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-HEATMAP-LAT-MS < 5 OR WS-HEATMAP-LAT-MS > 25
                SET HEATMAP-LAT-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CONTRAST-FID-M < 850 OR WS-CONTRAST-FID-M > 1000
                SET CONTRAST-FIDELITY-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-DIMMING-DRIFT-M < 0 OR WS-DIMMING-DRIFT-M > 5
                SET DIMMING-DRIFT-EXCEEDED TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-SALIENCE-HEATMAP.
            COMPUTE WS-VSH-COMPOSITE = ((30 - WS-HEATMAP-LAT-MS) * 20) +
                                       (WS-CONTRAST-FID-M / 2) +
                                       ((10 - WS-DIMMING-DRIFT-M) * 40).

            COMPUTE WS-VSH-VITALITY = (WS-VSH-COMPOSITE / 4) +
                                      (WS-CONTRAST-FID-M / 4) +
                                      ((30 - WS-HEATMAP-LAT-MS) * 4) + 1.

            IF WS-VSH-VITALITY EQUAL ZERO
                SET SALIENCE-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-VSH-COHERENCE = (WS-VSH-COMPOSITE / 16) +
                                       (WS-CONTRAST-FID-M / 16) +
                                       ((30 - WS-HEATMAP-LAT-MS) * 2).

            COMPUTE WS-VSH-REBAR-LATCH = 1470169088 +
                                         (WS-VSH-COMPOSITE / 2) +
                                         ((30 - WS-HEATMAP-LAT-MS) * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-VSH-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-VSH-VITALITY * 10) +
                                         (WS-VSH-COHERENCE * 10) +
                                         (WS-VSH-COMPOSITE * 10) +
                                         (WS-VSH-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-VSH-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-VSH-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
