       IDENTIFICATION DIVISION.
       PROGRAM-ID. LYAPUNOV-EAR-STORE-STRATEGY.
       AUTHOR. AUNCIENT DYSNOMIA VM / EAR INSTANCE STORAGE.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-EAR-STORE-PARAMS.
          05 WS-EAR-ADDR-HASH          PIC 9(09) VALUE 000008001.
          05 WS-INIT-BARK-STORE-ENERGY PIC 9(05) VALUE 15000.
          05 WS-RETENTION-CYCLES-N     PIC 9(02) VALUE 16.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-CURRENT-STORE-ENERGY   PIC 9(05) VALUE 0.
          05 WS-STEP-IDX               PIC 9(02) VALUE 0.
          05 WS-EAR-ADDR-MOD           PIC 9(03) VALUE 0.
          05 WS-SHADOW-EAR-STORE-BASE  PIC 9(12) VALUE 0.
          05 WS-CYC-MOD                PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-EAR-ADDR            VALUE 2.
             88 INVALID-STORE-ENERGY        VALUE 3.
             88 INVALID-RETENTION-CYCLES    VALUE 4.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
             88 STORAGE-DIVERGENCE-FAIL     VALUE 6.
             88 GATING-CLAMP-OVERFLOW       VALUE 7.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 8.
             88 CASCADE-ROLLBACK-FAIL       VALUE 9.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-EAR-STORAGE-CONTRACTION
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-EAR-ADDR-HASH EQUAL ZERO
               SET INVALID-EAR-ADDR TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-INIT-BARK-STORE-ENERGY > 50000
               SET INVALID-STORE-ENERGY TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-RETENTION-CYCLES-N < 1 OR WS-RETENTION-CYCLES-N > 64
               SET INVALID-RETENTION-CYCLES TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-EAR-STORAGE-CONTRACTION.
           MOVE WS-INIT-BARK-STORE-ENERGY TO WS-CURRENT-STORE-ENERGY.

           PERFORM VARYING WS-STEP-IDX FROM 1 BY 1 UNTIL WS-STEP-IDX > WS-RETENTION-CYCLES-N
               COMPUTE WS-CURRENT-STORE-ENERGY = (WS-CURRENT-STORE-ENERGY * 875) / 1000
           END-PERFORM.

           IF WS-CURRENT-STORE-ENERGY > WS-INIT-BARK-STORE-ENERGY
               SET STORAGE-DIVERGENCE-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-EAR-ADDR-MOD = FUNCTION MOD(WS-EAR-ADDR-HASH, 1000).

           COMPUTE WS-SHADOW-EAR-STORE-BASE = (WS-CICS-WRITER-ID * 1000000) + 
               (WS-RETENTION-CYCLES-N * 10000) + (WS-EAR-ADDR-MOD * 10) + (WS-CURRENT-STORE-ENERGY / 16).

           COMPUTE WS-CYC-MOD = FUNCTION MOD(WS-RETENTION-CYCLES-N, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-CYC-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-EAR-STORE-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-EAR-STORE-BASE + ((WS-CURRENT-STORE-ENERGY * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-EAR-STORE-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-RETENTION-CYCLES-N * 10000) + (WS-EAR-ADDR-MOD * 10) + (WS-CURRENT-STORE-ENERGY / 16))
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-EAR-STORE-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
