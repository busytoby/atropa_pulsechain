        IDENTIFICATION DIVISION.
        PROGRAM-ID. NMS-EXP-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / NONVERBAL MICROEXPRESSION SYNCHRONY AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-NMS-PARAMS.
           05 WS-ACTUATION-LAT-MS       PIC 9(02) VALUE 10.
           05 WS-BLEND-COHERENCE-M      PIC 9(04) VALUE 0960.
           05 WS-ACTUATOR-JITTER-M      PIC 9(02) VALUE 01.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-NMS-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-NMS-VITALITY           PIC 9(09) VALUE 0.
           05 WS-NMS-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-NMS-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-NMS-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 ACTUATE-LAT-OUT-OF-BOUNDS   VALUE 2.
              88 BLEND-COHERENCE-LOW         VALUE 3.
              88 ACTUATOR-JITTER-EXCEEDED    VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 SYNCHRONY-COLLAPSE          VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-MICROEXPRESSION
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-ACTUATION-LAT-MS < 5 OR WS-ACTUATION-LAT-MS > 20
                SET ACTUATE-LAT-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-BLEND-COHERENCE-M < 850 OR WS-BLEND-COHERENCE-M > 1000
                SET BLEND-COHERENCE-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-ACTUATOR-JITTER-M < 0 OR WS-ACTUATOR-JITTER-M > 5
                SET ACTUATOR-JITTER-EXCEEDED TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-MICROEXPRESSION.
            COMPUTE WS-NMS-COMPOSITE = ((25 - WS-ACTUATION-LAT-MS) * 20) +
                                       (WS-BLEND-COHERENCE-M / 2) +
                                       ((10 - WS-ACTUATOR-JITTER-M) * 40).

            COMPUTE WS-NMS-VITALITY = (WS-NMS-COMPOSITE / 4) +
                                      (WS-BLEND-COHERENCE-M / 4) +
                                      ((25 - WS-ACTUATION-LAT-MS) * 4) + 1.

            IF WS-NMS-VITALITY EQUAL ZERO
                SET SYNCHRONY-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-NMS-COHERENCE = (WS-NMS-COMPOSITE / 16) +
                                       (WS-BLEND-COHERENCE-M / 16) +
                                       ((25 - WS-ACTUATION-LAT-MS) * 2).

            COMPUTE WS-NMS-REBAR-LATCH = 1470169088 +
                                         (WS-NMS-COMPOSITE / 2) +
                                         ((25 - WS-ACTUATION-LAT-MS) * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-NMS-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-NMS-VITALITY * 10) +
                                         (WS-NMS-COHERENCE * 10) +
                                         (WS-NMS-COMPOSITE * 10) +
                                         (WS-NMS-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-NMS-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-NMS-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
