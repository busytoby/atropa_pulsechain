        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-BEYOND-530.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-BEYOND-530-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH531-CURVATURE-OK       PIC 9(01) VALUE 1.
            05  WS-TH532-HARMONICS-OK       PIC 9(01) VALUE 1.
            05  WS-TH533-STABILITY-OK       PIC 9(01) VALUE 1.
            05  WS-TH534-CURV-SAAT-OK       PIC 9(01) VALUE 1.
            05  WS-TH535-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-BEYOND-530-WIT      PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-BEYOND-530.
            GOBACK.
        1000-EVALUATE-BEYOND-530.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH531-CURVATURE-OK = 1 AND
               WS-TH532-HARMONICS-OK = 1 AND
               WS-TH533-STABILITY-OK = 1 AND
               WS-TH534-CURV-SAAT-OK = 1 AND
               WS-TH535-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-BEYOND-530-WIT
            ELSE
                MOVE 0 TO WS-FPGA-BEYOND-530-WIT.
