        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-ROUSE-STANAG-LEED.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-ROUSE-STANAG-LEED-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH986-ALLOCATION-OK      PIC 9(01) VALUE 1.
            05  WS-TH987-STANAG-LEED-OK     PIC 9(01) VALUE 1.
            05  WS-TH988-HANDOVER-LAT-OK    PIC 9(01) VALUE 1.
            05  WS-TH989-990M-SAAT-OK       PIC 9(01) VALUE 1.
            05  WS-TH990-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-ROUSE-STANAG-LEED-WIT    PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-ROUSE-STANAG-LEED.
            GOBACK.
        1000-EVALUATE-ROUSE-STANAG-LEED.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH986-ALLOCATION-OK = 1 AND
               WS-TH987-STANAG-LEED-OK = 1 AND
               WS-TH988-HANDOVER-LAT-OK = 1 AND
               WS-TH989-990M-SAAT-OK = 1 AND
               WS-TH990-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-ROUSE-STANAG-LEED-WIT
            ELSE
                MOVE 0 TO WS-ROUSE-STANAG-LEED-WIT.
