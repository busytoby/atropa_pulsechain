        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-SYNTH-COMPILER-126-130.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-SYNTH-COMPILER-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH126-SYNTH-CORRECT-OK   PIC 9(01) VALUE 1.
            05  WS-TH127-TURING-BOUND-OK    PIC 9(01) VALUE 1.
            05  WS-TH128-EDSAC-AUDIT-OK     PIC 9(01) VALUE 1.
            05  WS-TH129-JIT-LATENCY-OK     PIC 9(01) VALUE 1.
            05  WS-TH130-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-SYNTH-COMPILER-WITNESS   PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-SYNTH-COMPILER.
            GOBACK.
        1000-EVALUATE-SYNTH-COMPILER.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH126-SYNTH-CORRECT-OK = 1 AND
               WS-TH127-TURING-BOUND-OK = 1 AND
               WS-TH128-EDSAC-AUDIT-OK = 1 AND
               WS-TH129-JIT-LATENCY-OK = 1 AND
               WS-TH130-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-SYNTH-COMPILER-WITNESS
            ELSE
                MOVE 0 TO WS-SYNTH-COMPILER-WITNESS.
