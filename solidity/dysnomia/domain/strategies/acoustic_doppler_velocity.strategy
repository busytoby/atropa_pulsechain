        IDENTIFICATION DIVISION.
        PROGRAM-ID. DOPPLER-VEL-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / ACOUSTIC DOPPLER VELOCITY AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-DOP-PARAMS.
           05 WS-FINGER-VEL-MM-S        PIC 9(03) VALUE 050.
           05 WS-WAVEFRONT-ANGLE-DEG    PIC 9(02) VALUE 25.
           05 WS-VEL-COHERENCE-M        PIC 9(04) VALUE 0880.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-DOP-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-DOP-VITALITY           PIC 9(09) VALUE 0.
           05 WS-DOP-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-DOP-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-DOP-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 VELOCITY-OUT-OF-BOUNDS      VALUE 2.
              88 ANGLE-OUT-OF-BOUNDS         VALUE 3.
              88 VELOCITY-COHERENCE-LOW      VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 DOPPLER-COLLAPSE            VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-DOPPLER-VELOCITY
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-FINGER-VEL-MM-S < 1 OR WS-FINGER-VEL-MM-S > 250
                SET VELOCITY-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-WAVEFRONT-ANGLE-DEG < 0 OR WS-WAVEFRONT-ANGLE-DEG > 75
                SET ANGLE-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-VEL-COHERENCE-M < 600 OR WS-VEL-COHERENCE-M > 1000
                SET VELOCITY-COHERENCE-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-DOPPLER-VELOCITY.
            COMPUTE WS-DOP-COMPOSITE = (WS-FINGER-VEL-MM-S * 4) +
                                       ((75 - WS-WAVEFRONT-ANGLE-DEG) * 10) +
                                       (WS-VEL-COHERENCE-M / 2).

            COMPUTE WS-DOP-VITALITY = (WS-DOP-COMPOSITE / 4) +
                                      (WS-VEL-COHERENCE-M / 4) +
                                      (WS-FINGER-VEL-MM-S / 2) + 1.

            IF WS-DOP-VITALITY EQUAL ZERO
                SET DOPPLER-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-DOP-COHERENCE = (WS-DOP-COMPOSITE / 16) +
                                       (WS-VEL-COHERENCE-M / 16) +
                                       (WS-FINGER-VEL-MM-S / 8).

            COMPUTE WS-DOP-REBAR-LATCH = 1470169088 +
                                         (WS-DOP-COMPOSITE / 2) +
                                         (WS-FINGER-VEL-MM-S * 64).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-DOP-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-DOP-VITALITY * 10) +
                                         (WS-DOP-COHERENCE * 10) +
                                         (WS-DOP-COMPOSITE * 10) +
                                         (WS-DOP-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-DOP-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-DOP-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
