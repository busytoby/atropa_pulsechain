        IDENTIFICATION DIVISION.
        PROGRAM-ID. NGC-CUE-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / NON-VERBAL GAZE CUEING AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-NGC-PARAMS.
           05 WS-ACTUATE-LAT-MS         PIC 9(02) VALUE 12.
           05 WS-GAZE-PRECISION-M       PIC 9(04) VALUE 0960.
           05 WS-BLINK-CYCLE-MS         PIC 9(04) VALUE 3500.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-NGC-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-NGC-VITALITY           PIC 9(09) VALUE 0.
           05 WS-NGC-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-NGC-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-NGC-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 ACTUATE-LAT-OUT-OF-BOUNDS   VALUE 2.
              88 GAZE-PRECISION-LOW          VALUE 3.
              88 BLINK-CYCLE-OUT-OF-BOUNDS   VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 CUEING-COLLAPSE             VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-GAZE-CUEING
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-ACTUATE-LAT-MS < 5 OR WS-ACTUATE-LAT-MS > 25
                SET ACTUATE-LAT-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-GAZE-PRECISION-M < 850 OR WS-GAZE-PRECISION-M > 1000
                SET GAZE-PRECISION-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-BLINK-CYCLE-MS < 2000 OR WS-BLINK-CYCLE-MS > 6000
                SET BLINK-CYCLE-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-GAZE-CUEING.
            COMPUTE WS-NGC-COMPOSITE = ((30 - WS-ACTUATE-LAT-MS) * 20) +
                                       (WS-GAZE-PRECISION-M / 2) +
                                       ((6500 - WS-BLINK-CYCLE-MS) / 10).

            COMPUTE WS-NGC-VITALITY = (WS-NGC-COMPOSITE / 4) +
                                      (WS-GAZE-PRECISION-M / 4) +
                                      ((30 - WS-ACTUATE-LAT-MS) * 4) + 1.

            IF WS-NGC-VITALITY EQUAL ZERO
                SET CUEING-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-NGC-COHERENCE = (WS-NGC-COMPOSITE / 16) +
                                       (WS-GAZE-PRECISION-M / 16) +
                                       ((30 - WS-ACTUATE-LAT-MS) * 2).

            COMPUTE WS-NGC-REBAR-LATCH = 1470169088 +
                                         (WS-NGC-COMPOSITE / 2) +
                                         ((30 - WS-ACTUATE-LAT-MS) * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-NGC-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-NGC-VITALITY * 10) +
                                         (WS-NGC-COHERENCE * 10) +
                                         (WS-NGC-COMPOSITE * 10) +
                                         (WS-NGC-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-NGC-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-NGC-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
