        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-STANAG.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-STANAG-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH381-STANAG-MESH-OK     PIC 9(01) VALUE 1.
            05  WS-TH382-RF-BER-MARGIN-OK   PIC 9(01) VALUE 1.
            05  WS-TH383-STROWGER-2600HZ-OK PIC 9(01) VALUE 1.
            05  WS-TH384-STANAG-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH385-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-STANAG-WIT          PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-STANAG.
            GOBACK.
        1000-EVALUATE-STANAG.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH381-STANAG-MESH-OK = 1 AND
               WS-TH382-RF-BER-MARGIN-OK = 1 AND
               WS-TH383-STROWGER-2600HZ-OK = 1 AND
               WS-TH384-STANAG-SAAT-OK = 1 AND
               WS-TH385-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-STANAG-WIT
            ELSE
                MOVE 0 TO WS-FPGA-STANAG-WIT.
