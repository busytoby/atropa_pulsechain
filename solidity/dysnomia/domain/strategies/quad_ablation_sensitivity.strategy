        IDENTIFICATION DIVISION.
        PROGRAM-ID. QUAD-ABLATION-STRATEGY.
        AUTHOR. AUNCIENT DYSNOMIA VM / ABLATION SENSITIVITY AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-ABLATION-PARAMS.
           05 WS-VARIANT-ID             PIC 9(02) VALUE 01.
           05 WS-ID-SIM-PERMILLE        PIC 9(04) VALUE 0645.
           05 WS-VSIM-PERMILLE          PIC 9(04) VALUE 0558.
           05 WS-WER-PERMILLE           PIC 9(04) VALUE 0170.
           05 WS-LMD-PERMILLE           PIC 9(03) VALUE 049.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-ABLATION-VITALITY      PIC 9(09) VALUE 0.
           05 WS-SENSITIVITY-COHERENCE  PIC 9(09) VALUE 0.
           05 WS-ABL-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-ABL-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 INVALID-VARIANT-ID          VALUE 2.
              88 INVALID-ID-SIM              VALUE 3.
              88 INVALID-VSIM                VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 INVALID-LMD                 VALUE 6.
              88 ABLATION-DIVERG-FAIL        VALUE 7.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 8.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-ABLATION-SENSITIVITY
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-VARIANT-ID < 1 OR WS-VARIANT-ID > 5
                SET INVALID-VARIANT-ID TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-ID-SIM-PERMILLE < 500 OR WS-ID-SIM-PERMILLE > 1000
                SET INVALID-ID-SIM TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-VSIM-PERMILLE < 400 OR WS-VSIM-PERMILLE > 1000
                SET INVALID-VSIM TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-LMD-PERMILLE < 35 OR WS-LMD-PERMILLE > 65
                SET INVALID-LMD TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-ABLATION-SENSITIVITY.
            COMPUTE WS-ABLATION-VITALITY = (WS-VARIANT-ID * 512) +
                                           (WS-LMD-PERMILLE * 32) +
                                           (WS-VSIM-PERMILLE * 2) + 1.

            IF WS-ABLATION-VITALITY EQUAL ZERO
                SET ABLATION-DIVERG-FAIL TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-SENSITIVITY-COHERENCE = (WS-LMD-PERMILLE * 16) +
                                               (WS-VSIM-PERMILLE / 4) +
                                               ((1000 - WS-WER-PERMILLE) / 4).

            COMPUTE WS-ABL-REBAR-LATCH = 1470169088 + (WS-VARIANT-ID * 256) +
                                         (WS-LMD-PERMILLE * 64) +
                                         (WS-VSIM-PERMILLE * 2).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-ABL-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-ABLATION-VITALITY * 10) +
                                         (WS-SENSITIVITY-COHERENCE * 10) +
                                         (WS-VARIANT-ID * 1000) +
                                         (WS-ABL-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-ABL-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-ABL-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
