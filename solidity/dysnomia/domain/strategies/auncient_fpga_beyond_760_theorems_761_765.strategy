        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-BEYOND-760.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-BEYOND-760-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH761-MULTI-GOVERN-OK    PIC 9(01) VALUE 1.
            05  WS-TH762-HIERARCHY-OK       PIC 9(01) VALUE 1.
            05  WS-TH763-ENFORCE-LAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH764-765M-SAAT-OK       PIC 9(01) VALUE 1.
            05  WS-TH765-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-BEYOND-760-WIT      PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-BEYOND-760.
            GOBACK.
        1000-EVALUATE-BEYOND-760.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH761-MULTI-GOVERN-OK = 1 AND
               WS-TH762-HIERARCHY-OK = 1 AND
               WS-TH763-ENFORCE-LAT-OK = 1 AND
               WS-TH764-765M-SAAT-OK = 1 AND
               WS-TH765-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-BEYOND-760-WIT
            ELSE
                MOVE 0 TO WS-FPGA-BEYOND-760-WIT.
