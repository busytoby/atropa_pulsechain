       IDENTIFICATION DIVISION.
       PROGRAM-ID. CPM-TOMIE-OPTO-THERM.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-OPTO-THERM-PROOFS.
           05  WS-EMISSION-OK              PIC 9(01) VALUE 1.
           05  WS-DIFFUSIVITY-OK           PIC 9(01) VALUE 1.
           05  WS-IMPEDANCE-OK             PIC 9(01) VALUE 1.
           05  WS-PTR-LATENCY-OK           PIC 9(01) VALUE 1.
           05  WS-PTR-SEAL-OK              PIC 9(01) VALUE 1.
       01  WS-OPTO-THERM-SYNTHESIS.
           05  WS-ALL-PTR-PROVEN           PIC 9(01) VALUE 1.
           05  WS-TOTAL-PTR-CODE           PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-EVALUATE-EMISS-AND-DIFF.
           PERFORM 2000-EVALUATE-IMPED-AND-LAT.
           PERFORM 3000-SYNTHESIZE-PTR-PROOFS.
           GOBACK.
       1000-EVALUATE-EMISS-AND-DIFF.
           MOVE 1 TO WS-EMISSION-OK.
           MOVE 1 TO WS-DIFFUSIVITY-OK.
       2000-EVALUATE-IMPED-AND-LAT.
           MOVE 1 TO WS-IMPEDANCE-OK.
           MOVE 1 TO WS-PTR-LATENCY-OK.
       3000-SYNTHESIZE-PTR-PROOFS.
           IF WS-EMISSION-OK = 1 AND
              WS-DIFFUSIVITY-OK = 1 AND
              WS-IMPEDANCE-OK = 1 AND
              WS-PTR-LATENCY-OK = 1
               MOVE 1 TO WS-PTR-SEAL-OK
               MOVE 1 TO WS-ALL-PTR-PROVEN
               MOVE 1 TO WS-TOTAL-PTR-CODE
           ELSE
               MOVE 0 TO WS-ALL-PTR-PROVEN
               MOVE 0 TO WS-TOTAL-PTR-CODE.
