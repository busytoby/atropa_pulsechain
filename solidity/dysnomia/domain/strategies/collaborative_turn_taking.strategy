        IDENTIFICATION DIVISION.
        PROGRAM-ID. CTT-TRN-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / COLLABORATIVE TURN TAKING AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-CTT-PARAMS.
           05 WS-ARBITRATION-LAT-MS     PIC 9(02) VALUE 12.
           05 WS-ROLE-FIDELITY-M        PIC 9(04) VALUE 0960.
           05 WS-LOCK-JITTER-MS         PIC 9(02) VALUE 01.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-CTT-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-CTT-VITALITY           PIC 9(09) VALUE 0.
           05 WS-CTT-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-CTT-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-CTT-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 ARBITRATION-LAT-OUT-OF-BOUND VALUE 2.
              88 ROLE-FIDELITY-LOW           VALUE 3.
              88 LOCK-JITTER-EXCEEDED        VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 ARBITRATION-COLLAPSE        VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-TURN-TAKING
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3 AND WS-K-EXPONENT NOT EQUAL 4
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-ARBITRATION-LAT-MS < 5 OR WS-ARBITRATION-LAT-MS > 25
                SET ARBITRATION-LAT-OUT-OF-BOUND TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-ROLE-FIDELITY-M < 850 OR WS-ROLE-FIDELITY-M > 1000
                SET ROLE-FIDELITY-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-LOCK-JITTER-MS < 0 OR WS-LOCK-JITTER-MS > 5
                SET LOCK-JITTER-EXCEEDED TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-TURN-TAKING.
            COMPUTE WS-CTT-COMPOSITE = ((30 - WS-ARBITRATION-LAT-MS) * 20) +
                                       (WS-ROLE-FIDELITY-M / 2) +
                                       ((10 - WS-LOCK-JITTER-MS) * 40).

            COMPUTE WS-CTT-VITALITY = (WS-CTT-COMPOSITE / 4) +
                                      (WS-ROLE-FIDELITY-M / 4) +
                                      ((30 - WS-ARBITRATION-LAT-MS) * 4) + 1.

            IF WS-CTT-VITALITY EQUAL ZERO
                SET ARBITRATION-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-CTT-COHERENCE = (WS-CTT-COMPOSITE / 16) +
                                       (WS-ROLE-FIDELITY-M / 16) +
                                       ((30 - WS-ARBITRATION-LAT-MS) * 2).

            COMPUTE WS-CTT-REBAR-LATCH = 1470169088 +
                                         (WS-CTT-COMPOSITE / 2) +
                                         ((30 - WS-ARBITRATION-LAT-MS) * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-CTT-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-CTT-VITALITY * 10) +
                                         (WS-CTT-COHERENCE * 10) +
                                         (WS-CTT-COMPOSITE * 10) +
                                         (WS-CTT-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-CTT-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-CTT-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
