        IDENTIFICATION DIVISION.
        PROGRAM-ID. EMO-WEYL-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / EMOTIONAL WEYL CLOSURE AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-EMO-PARAMS.
           05 WS-EMOTIONAL-STATE        PIC 9(02) VALUE 04.
           05 WS-SINGULAR-LOCUS         PIC 9(05) VALUE 02500.
           05 WS-EXACT-FLAG             PIC 9(01) VALUE 1.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-CLOSURE-VITALITY       PIC 9(09) VALUE 0.
           05 WS-CLOSURE-COHERENCE      PIC 9(09) VALUE 0.
           05 WS-CLOSURE-REBAR-LATCH    PIC 9(12) VALUE 0.
           05 WS-SHADOW-CLOSURE-BASE    PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 INVALID-EMOTIONAL-STATE     VALUE 2.
              88 INVALID-SINGULAR-LOCUS      VALUE 3.
              88 CLOSURE-EXACTNESS-FAIL      VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 WEYL-CLOSURE-COLLAPSE       VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-EMOTIONAL-WEYL-CLOSURE
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-EMOTIONAL-STATE < 1 OR WS-EMOTIONAL-STATE > 5
                SET INVALID-EMOTIONAL-STATE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-SINGULAR-LOCUS < 100 OR WS-SINGULAR-LOCUS > 10000
                SET INVALID-SINGULAR-LOCUS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-EXACT-FLAG NOT EQUAL 1
                SET CLOSURE-EXACTNESS-FAIL TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-EMOTIONAL-WEYL-CLOSURE.
            COMPUTE WS-CLOSURE-VITALITY = (WS-SINGULAR-LOCUS / 4) +
                                          (WS-EMOTIONAL-STATE * 256) +
                                          (WS-EXACT-FLAG * 128) + 1.

            IF WS-CLOSURE-VITALITY EQUAL ZERO
                SET WEYL-CLOSURE-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-CLOSURE-COHERENCE = (WS-SINGULAR-LOCUS / 16) +
                                           (WS-EMOTIONAL-STATE * 64).

            COMPUTE WS-CLOSURE-REBAR-LATCH = 1470169088 +
                                             (WS-SINGULAR-LOCUS / 2) +
                                             (WS-EMOTIONAL-STATE * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-CLOSURE-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                             (WS-CLOSURE-VITALITY * 10) +
                                             (WS-CLOSURE-COHERENCE * 10) +
                                             (WS-EMOTIONAL-STATE * 1000) +
                                             (WS-CLOSURE-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-CLOSURE-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-CLOSURE-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
