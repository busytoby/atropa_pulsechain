       IDENTIFICATION DIVISION.
       PROGRAM-ID. VAESEN-MOOD-STRATEGY.
       AUTHOR. AUNCIENT DYSNOMIA VM / VAESEN EDO-22 MOOD.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-MOOD-PARAMS.
          05 WS-INIT-AFFECT-Q          PIC 9(05) VALUE 15000.
          05 WS-TARGET-EDO-STEP        PIC 9(02) VALUE 11.
          05 WS-VOCAL-STEPS-N          PIC 9(02) VALUE 16.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-CURRENT-AFFECT-Q       PIC 9(05) VALUE 0.
          05 WS-CURRENT-EDO-STEP       PIC 9(02) VALUE 0.
          05 WS-STEP-IDX               PIC 9(02) VALUE 0.
          05 WS-PITCH-DIST             PIC 9(05) VALUE 0.
          05 WS-SHADOW-MOOD-BASE       PIC 9(12) VALUE 0.
          05 WS-CYC-MOD                PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-AFFECT-COORD        VALUE 2.
             88 INVALID-EDO-STEP            VALUE 3.
             88 INVALID-VOCAL-STEPS         VALUE 4.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
             88 MOOD-DIVERGENCE-FAIL        VALUE 6.
             88 GATING-CLAMP-OVERFLOW       VALUE 7.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 8.
             88 CASCADE-ROLLBACK-FAIL       VALUE 9.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-MOOD-QUANTIZATION
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-INIT-AFFECT-Q > 20000
               SET INVALID-AFFECT-COORD TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-TARGET-EDO-STEP > 21
               SET INVALID-EDO-STEP TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-VOCAL-STEPS-N < 1 OR WS-VOCAL-STEPS-N > 64
               SET INVALID-VOCAL-STEPS TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-MOOD-QUANTIZATION.
           MOVE WS-INIT-AFFECT-Q TO WS-CURRENT-AFFECT-Q.

           PERFORM VARYING WS-STEP-IDX FROM 1 BY 1 UNTIL WS-STEP-IDX > WS-VOCAL-STEPS-N
               COMPUTE WS-CURRENT-AFFECT-Q = (WS-CURRENT-AFFECT-Q * 875) / 1000
           END-PERFORM.

           COMPUTE WS-CURRENT-EDO-STEP = (22 * WS-CURRENT-AFFECT-Q) / 20000.
           IF WS-CURRENT-EDO-STEP > 21
               MOVE 21 TO WS-CURRENT-EDO-STEP
           END-IF.

           MOVE WS-CURRENT-AFFECT-Q TO WS-PITCH-DIST.

           IF WS-CURRENT-AFFECT-Q > WS-INIT-AFFECT-Q
               SET MOOD-DIVERGENCE-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-SHADOW-MOOD-BASE = (WS-CICS-WRITER-ID * 1000000) + 
               (WS-VOCAL-STEPS-N * 10000) + (WS-CURRENT-EDO-STEP * 100) + (WS-PITCH-DIST / 16).

           COMPUTE WS-CYC-MOD = FUNCTION MOD(WS-CURRENT-EDO-STEP, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-CYC-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-MOOD-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-MOOD-BASE + ((WS-CURRENT-AFFECT-Q * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-MOOD-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-VOCAL-STEPS-N * 10000) + (WS-CURRENT-EDO-STEP * 100) + (WS-PITCH-DIST / 16))
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-MOOD-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
