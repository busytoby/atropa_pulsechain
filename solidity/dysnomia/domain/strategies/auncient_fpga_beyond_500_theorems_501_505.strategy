        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-BEYOND-500.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-BEYOND-500-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH501-PHASE-SYNC-OK      PIC 9(01) VALUE 1.
            05  WS-TH502-TOPO-QBIT-OK       PIC 9(01) VALUE 1.
            05  WS-TH503-CRYSTAL-OK         PIC 9(01) VALUE 1.
            05  WS-TH504-MILL-SAAT-OK       PIC 9(01) VALUE 1.
            05  WS-TH505-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-BEYOND-500-WIT      PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-BEYOND-500.
            GOBACK.
        1000-EVALUATE-BEYOND-500.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH501-PHASE-SYNC-OK = 1 AND
               WS-TH502-TOPO-QBIT-OK = 1 AND
               WS-TH503-CRYSTAL-OK = 1 AND
               WS-TH504-MILL-SAAT-OK = 1 AND
               WS-TH505-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-BEYOND-500-WIT
            ELSE
                MOVE 0 TO WS-FPGA-BEYOND-500-WIT.
