        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-VSEN-PHOTOREAL.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-VSEN-PHOTOREAL-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1976-FUR-BXDF-OK       PIC 9(01) VALUE 1.
            05  WS-TH1977-CORNEA-GGX-OK     PIC 9(01) VALUE 1.
            05  WS-TH1978-FIBER-FET-OK      PIC 9(01) VALUE 1.
            05  WS-TH1979-1980M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1980-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-VSEN-PHOTOREAL-WIT       PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-VSEN-PHOTOREAL.
            GOBACK.
        1000-EVALUATE-VSEN-PHOTOREAL.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1976-FUR-BXDF-OK = 1 AND
               WS-TH1977-CORNEA-GGX-OK = 1 AND
               WS-TH1978-FIBER-FET-OK = 1 AND
               WS-TH1979-1980M-SAAT-OK = 1 AND
               WS-TH1980-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-VSEN-PHOTOREAL-WIT
            ELSE
                MOVE 0 TO WS-VSEN-PHOTOREAL-WIT.
