        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-REDACT-TEL.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-REDACT-TEL-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1671-REDACT-TEL-OK     PIC 9(01) VALUE 1.
            05  WS-TH1672-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1673-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1674-1675M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1675-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-REDACT-TEL-WIT           PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-REDACT-TEL.
            GOBACK.
        1000-EVALUATE-REDACT-TEL.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1671-REDACT-TEL-OK = 1 AND
               WS-TH1672-DATBIN-STRAT-OK = 1 AND
               WS-TH1673-SUBMICRO-LAT-OK = 1 AND
               WS-TH1674-1675M-SAAT-OK = 1 AND
               WS-TH1675-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-REDACT-TEL-WIT
            ELSE
                MOVE 0 TO WS-REDACT-TEL-WIT.
