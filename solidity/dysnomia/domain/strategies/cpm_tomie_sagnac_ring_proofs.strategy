       IDENTIFICATION DIVISION.
       PROGRAM-ID. CPM-TOMIE-SAGNAC-RING.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-SAGNAC-RING-PROOFS.
           05  WS-PHASE-SHIFT-OK           PIC 9(01) VALUE 1.
           05  WS-DRIFT-DEFENSE-OK         PIC 9(01) VALUE 1.
           05  WS-CLOCK-SYNC-OK            PIC 9(01) VALUE 1.
           05  WS-GYRO-LATENCY-OK          PIC 9(01) VALUE 1.
           05  WS-SAGNAC-SEAL-OK           PIC 9(01) VALUE 1.
       01  WS-SAGNAC-SYNTHESIS.
           05  WS-ALL-SRG-PROVEN           PIC 9(01) VALUE 1.
           05  WS-TOTAL-SRG-CODE           PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-EVALUATE-PHASE-AND-DRIFT.
           PERFORM 2000-EVALUATE-CLOCK-AND-LATENCY.
           PERFORM 3000-SYNTHESIZE-SRG-PROOFS.
           GOBACK.
       1000-EVALUATE-PHASE-AND-DRIFT.
           MOVE 1 TO WS-PHASE-SHIFT-OK.
           MOVE 1 TO WS-DRIFT-DEFENSE-OK.
       2000-EVALUATE-CLOCK-AND-LATENCY.
           MOVE 1 TO WS-CLOCK-SYNC-OK.
           MOVE 1 TO WS-GYRO-LATENCY-OK.
       3000-SYNTHESIZE-SRG-PROOFS.
           IF WS-PHASE-SHIFT-OK = 1 AND
              WS-DRIFT-DEFENSE-OK = 1 AND
              WS-CLOCK-SYNC-OK = 1 AND
              WS-GYRO-LATENCY-OK = 1
               MOVE 1 TO WS-SAGNAC-SEAL-OK
               MOVE 1 TO WS-ALL-SRG-PROVEN
               MOVE 1 TO WS-TOTAL-SRG-CODE
           ELSE
               MOVE 0 TO WS-ALL-SRG-PROVEN
               MOVE 0 TO WS-TOTAL-SRG-CODE.
