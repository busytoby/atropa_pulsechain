       IDENTIFICATION DIVISION.
       PROGRAM-ID. PDF-DUAL-CONSTRAINT-PROVER-STRATEGY.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-DUAL-CONSTRAINTS.
           05  WS-PRIMAL-TEXT-BOUNDS       PIC 9(09) VALUE 0.
           05  WS-DUAL-GEOM-BOUNDS         PIC 9(09) VALUE 0.
           05  WS-LATTICE-ALIGNMENT-GAP    PIC 9(06) VALUE 0.
           05  WS-RECURRENT-NEURON-MAP     PIC 9(01) VALUE 1.
       01  WS-VERIFICATION-STATUS.
           05  WS-PRIMAL-SOUNDNESS         PIC 9(01) VALUE 1.
           05  WS-DUAL-EXACTNESS           PIC 9(01) VALUE 1.
           05  WS-COMPLEMENTARY-SLACKNESS  PIC 9(01) VALUE 1.
           05  WS-PROVER-COMPLETION-CODE   PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-EVALUATE-PRIMAL-TEXT-STREAM.
           PERFORM 2000-EVALUATE-DUAL-GEOMETRIC-MANIFOLD.
           PERFORM 3000-VERIFY-SLACKNESS-EQUILIBRIUM.
           PERFORM 4000-SYNTHESIZE-DUAL-PROOF.
           GOBACK.
       1000-EVALUATE-PRIMAL-TEXT-STREAM.
           MOVE 1 TO WS-PRIMAL-SOUNDNESS.
       2000-EVALUATE-DUAL-GEOMETRIC-MANIFOLD.
           MOVE 1 TO WS-DUAL-EXACTNESS.
       3000-VERIFY-SLACKNESS-EQUILIBRIUM.
           IF WS-LATTICE-ALIGNMENT-GAP = 0
               MOVE 1 TO WS-COMPLEMENTARY-SLACKNESS
           ELSE
               MOVE 0 TO WS-COMPLEMENTARY-SLACKNESS.
       4000-SYNTHESIZE-DUAL-PROOF.
           IF WS-PRIMAL-SOUNDNESS = 1 AND
              WS-DUAL-EXACTNESS = 1 AND
              WS-COMPLEMENTARY-SLACKNESS = 1 AND
              WS-RECURRENT-NEURON-MAP = 1
               MOVE 1 TO WS-PROVER-COMPLETION-CODE
           ELSE
               MOVE 0 TO WS-PROVER-COMPLETION-CODE.
