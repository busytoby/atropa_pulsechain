        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-AUX-MIMETIC.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-AUX-MIMETIC-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1041-MIMETIC-CORES-OK  PIC 9(01) VALUE 1.
            05  WS-TH1042-DATBIN-MIM-OK     PIC 9(01) VALUE 1.
            05  WS-TH1043-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1044-1045M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1045-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-AUX-MIMETIC-WIT          PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-AUX-MIMETIC.
            GOBACK.
        1000-EVALUATE-AUX-MIMETIC.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1041-MIMETIC-CORES-OK = 1 AND
               WS-TH1042-DATBIN-MIM-OK = 1 AND
               WS-TH1043-SUBMICRO-LAT-OK = 1 AND
               WS-TH1044-1045M-SAAT-OK = 1 AND
               WS-TH1045-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-AUX-MIMETIC-WIT
            ELSE
                MOVE 0 TO WS-AUX-MIMETIC-WIT.
