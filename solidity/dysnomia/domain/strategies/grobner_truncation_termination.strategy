        IDENTIFICATION DIVISION.
        PROGRAM-ID. GROBNER-TRUNCATION-STRATEGY.
        AUTHOR. AUNCIENT DYSNOMIA VM / GROBNER TRUNCATION AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-TRUNC-PARAMS.
           05 WS-MODULE-RANK            PIC 9(02) VALUE 01.
           05 WS-TRUNC-DEGREE-S         PIC 9(02) VALUE 04.
           05 WS-ORDER-BLOCKS           PIC 9(02) VALUE 02.
           05 WS-TERMINATION-FLAG       PIC 9(01) VALUE 1.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-TRUNC-VITALITY         PIC 9(09) VALUE 0.
           05 WS-BASIS-COHERENCE        PIC 9(09) VALUE 0.
           05 WS-TRUNC-REBAR-LATCH      PIC 9(12) VALUE 0.
           05 WS-SHADOW-TRUNC-BASE      PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 INVALID-MODULE-RANK         VALUE 2.
              88 INVALID-TRUNCATION-DEG      VALUE 3.
              88 INVALID-ORDER-BLOCKS        VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 HOLONOMIC-TERMINATION-FAIL  VALUE 6.
              88 TRUNCATION-DIVERG-FAIL      VALUE 7.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 8.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-TRUNCATION
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-MODULE-RANK < 1 OR WS-MODULE-RANK > 16
                SET INVALID-MODULE-RANK TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-TRUNC-DEGREE-S < 0 OR WS-TRUNC-DEGREE-S > 32
                SET INVALID-TRUNCATION-DEG TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-ORDER-BLOCKS < 1 OR WS-ORDER-BLOCKS > 8
                SET INVALID-ORDER-BLOCKS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-TERMINATION-FLAG NOT EQUAL 1
                SET HOLONOMIC-TERMINATION-FAIL TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-TRUNCATION.
            COMPUTE WS-TRUNC-VITALITY = (WS-MODULE-RANK * 512) +
                                        (WS-TRUNC-DEGREE-S * 64) +
                                        (WS-ORDER-BLOCKS * 128) +
                                        (WS-TERMINATION-FLAG * 256) + 1.

            IF WS-TRUNC-VITALITY EQUAL ZERO
                SET TRUNCATION-DIVERG-FAIL TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-BASIS-COHERENCE = (WS-TRUNC-DEGREE-S * 32) +
                                         (WS-MODULE-RANK * 64) +
                                         (WS-ORDER-BLOCKS * 16).

            COMPUTE WS-TRUNC-REBAR-LATCH = 1470169088 + (WS-MODULE-RANK * 256) +
                                           (WS-TRUNC-DEGREE-S * 64) +
                                           (WS-ORDER-BLOCKS * 8).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-TRUNC-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                           (WS-TRUNC-VITALITY * 10) +
                                           (WS-BASIS-COHERENCE * 10) +
                                           (WS-MODULE-RANK * 1000) +
                                           (WS-TRUNC-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-TRUNC-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-TRUNC-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
