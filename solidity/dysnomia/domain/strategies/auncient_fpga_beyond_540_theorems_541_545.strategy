        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-BEYOND-540.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-BEYOND-540-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH541-SPINOR-OK          PIC 9(01) VALUE 1.
            05  WS-TH542-LORENTZ-OK         PIC 9(01) VALUE 1.
            05  WS-TH543-PHASE-NOISE-OK     PIC 9(01) VALUE 1.
            05  WS-TH544-SPIN-SAAT-OK       PIC 9(01) VALUE 1.
            05  WS-TH545-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-BEYOND-540-WIT      PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-BEYOND-540.
            GOBACK.
        1000-EVALUATE-BEYOND-540.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH541-SPINOR-OK = 1 AND
               WS-TH542-LORENTZ-OK = 1 AND
               WS-TH543-PHASE-NOISE-OK = 1 AND
               WS-TH544-SPIN-SAAT-OK = 1 AND
               WS-TH545-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-BEYOND-540-WIT
            ELSE
                MOVE 0 TO WS-FPGA-BEYOND-540-WIT.
