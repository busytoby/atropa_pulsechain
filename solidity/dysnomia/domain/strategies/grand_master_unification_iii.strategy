        IDENTIFICATION DIVISION.
        PROGRAM-ID. GM-UNI3-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / GRAND MASTER UNIFICATION III AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-UNI-PARAMS.
           05 WS-6CUE-COMPOSITE         PIC 9(04) VALUE 0750.
           05 WS-TACTILE-ENERGY         PIC 9(04) VALUE 0650.
           05 WS-AV-SYNC-QUALITY        PIC 9(04) VALUE 0850.
           05 WS-MEM-EFFICIENCY         PIC 9(04) VALUE 0800.
           05 WS-TURN-LATENCY-MS        PIC 9(04) VALUE 0310.
           05 WS-THERMAL-POWER-MW       PIC 9(05) VALUE 14500.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-GRAND-SYNTHESIS        PIC 9(04) VALUE 0.
           05 WS-UNI-VITALITY           PIC 9(09) VALUE 0.
           05 WS-UNI-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-UNI-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-UNI-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 INVALID-COMPOSITE-TACTILE   VALUE 2.
              88 INVALID-SYNC-OR-MEMORY      VALUE 3.
              88 LATENCY-OR-POWER-EXCEEDED   VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 UNIFICATION-VITALITY-COLLAP VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-GRAND-UNIFICATION
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-6CUE-COMPOSITE < 100 OR WS-6CUE-COMPOSITE > 1000 OR
               WS-TACTILE-ENERGY < 100 OR WS-TACTILE-ENERGY > 1000
                SET INVALID-COMPOSITE-TACTILE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-AV-SYNC-QUALITY < 100 OR WS-AV-SYNC-QUALITY > 1000 OR
               WS-MEM-EFFICIENCY < 100 OR WS-MEM-EFFICIENCY > 1000
                SET INVALID-SYNC-OR-MEMORY TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-TURN-LATENCY-MS < 50 OR WS-TURN-LATENCY-MS > 500 OR
               WS-THERMAL-POWER-MW < 1000 OR WS-THERMAL-POWER-MW > 25000
                SET LATENCY-OR-POWER-EXCEEDED TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-GRAND-SYNTHESIS = (WS-6CUE-COMPOSITE + WS-TACTILE-ENERGY +
                                          WS-AV-SYNC-QUALITY + WS-MEM-EFFICIENCY) / 4.

            IF WS-GRAND-SYNTHESIS EQUAL ZERO
                SET UNIFICATION-VITALITY-COLLAP TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-GRAND-UNIFICATION.
            COMPUTE WS-UNI-VITALITY = (WS-GRAND-SYNTHESIS / 4) +
                                      (WS-TURN-LATENCY-MS / 2) +
                                      (WS-THERMAL-POWER-MW / 250) + 1.

            IF WS-UNI-VITALITY EQUAL ZERO
                SET UNIFICATION-VITALITY-COLLAP TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-UNI-COHERENCE = (WS-GRAND-SYNTHESIS / 16) +
                                       (WS-TURN-LATENCY-MS / 8) +
                                       (WS-THERMAL-POWER-MW / 1000).

            COMPUTE WS-UNI-REBAR-LATCH = 1470169088 +
                                         (WS-GRAND-SYNTHESIS / 2) +
                                         (WS-TURN-LATENCY-MS * 4).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-UNI-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-UNI-VITALITY * 10) +
                                         (WS-UNI-COHERENCE * 10) +
                                         (WS-GRAND-SYNTHESIS * 10) +
                                         (WS-UNI-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-UNI-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-UNI-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
