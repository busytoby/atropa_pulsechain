        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-STATOR-LUT.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-STATOR-LUT-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH476-STATOR-256P-OK     PIC 9(01) VALUE 1.
            05  WS-TH477-SKEW-OK            PIC 9(01) VALUE 1.
            05  WS-TH478-EM-ISOLATION-OK    PIC 9(01) VALUE 1.
            05  WS-TH479-STATOR-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH480-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-STATOR-LUT-WIT      PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-STATOR-LUT.
            GOBACK.
        1000-EVALUATE-STATOR-LUT.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH476-STATOR-256P-OK = 1 AND
               WS-TH477-SKEW-OK = 1 AND
               WS-TH478-EM-ISOLATION-OK = 1 AND
               WS-TH479-STATOR-SAAT-OK = 1 AND
               WS-TH480-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-STATOR-LUT-WIT
            ELSE
                MOVE 0 TO WS-FPGA-STATOR-LUT-WIT.
