IDENTIFICATION DIVISION.
PROGRAM-ID. PROG-TRANSITIVE-SEC-CHAIN.

DATA DIVISION.
01 D0-ROOT-TRUNK.
   05 D0-MOTZKIN-PRIME     PIC 9(9) USAGE R0.
   05 D0-K-EXPONENT        PIC 9(9) USAGE R1.
   05 D0-ROOT-CHARGE-MU0   PIC 9(9) USAGE R2.
   05 D0-FAULT-DEPTH-K     PIC 9(9) USAGE R3.
01 D1-LAYER-INPUTS.
   05 D1-ACT-X0            PIC 9(9) USAGE R4.
   05 D1-ACT-X1            PIC 9(9) USAGE R5.
   05 D1-SVDAG-VOXELS      PIC 9(9) USAGE R6.
01 D2-TRANSITIVE-CHAIN.
   05 D2-S1-RMS            PIC 9(9) USAGE R7.
   05 D2-S2-VALVE          PIC 9(9) USAGE R8.
   05 D2-S3-SVDAG          PIC 9(9) USAGE R9.
   05 D2-COMM-S1           PIC 9(9) USAGE R10.
   05 D2-COMM-S2           PIC 9(9) USAGE R11.
   05 D2-COMM-S3           PIC 9(9) USAGE R12.
01 D3-LEAF-EVAL.
   05 D3-PROOF-RULING      PIC 9(9) USAGE R13.
   05 D3-DISP-WRAP-MOD     PIC 9(9) USAGE R14.

PROCEDURE DIVISION.
    MOVE 953467954 TO D0-MOTZKIN-PRIME.
    MOVE 3 TO D0-K-EXPONENT.
    MOVE 1000000 TO D0-ROOT-CHARGE-MU0.
    MOVE 0 TO D0-FAULT-DEPTH-K.

    MOVE 1000 TO D1-ACT-X0.
    MOVE 2000 TO D1-ACT-X1.
    MOVE 64 TO D1-SVDAG-VOXELS.

    PERFORM STAGE-TRANSITIVE-CHAIN.
    PERFORM COMMIT-OR-ROLLBACK-CHAIN.
    PERFORM SYNC-DISPLACEMENT-MODULO.

    IF D0-ROOT-CHARGE-MU0 == 1000000 AND D2-COMM-S2 == 0
        MOVE 0 TO D3-PROOF-RULING
        SET depth 4
    ELSE
        MOVE 3 TO D3-PROOF-RULING
        SET depth 1
    END-IF.

    EVAL.
    GO TO END-STRATEGY.

STAGE-TRANSITIVE-CHAIN.
    comment Step 1: S_1 RMS accumulator from activations;
    COMPUTE D2-S1-RMS = ((D1-ACT-X0 * D1-ACT-X0) + (D1-ACT-X1 * D1-ACT-X1)) / 2.
    comment Step 2: S_2 Valve accumulator from S_1;
    COMPUTE D2-S2-VALVE = D2-S1-RMS - ((D2-S1-RMS / D2-S1-RMS) * D2-S1-RMS).
    comment Step 3: S_3 SVDAG accumulator from S_2 / parameters;
    COMPUTE D2-S3-SVDAG = D1-SVDAG-VOXELS * 256.
    EXIT.

COMMIT-OR-ROLLBACK-CHAIN.
    IF D0-FAULT-DEPTH-K > 0
        MOVE 0 TO D2-COMM-S1
        MOVE 0 TO D2-COMM-S2
        MOVE 0 TO D2-COMM-S3
    ELSE
        MOVE D2-S1-RMS TO D2-COMM-S1
        MOVE D2-S2-VALVE TO D2-COMM-S2
        MOVE D2-S3-SVDAG TO D2-COMM-S3
    END-IF.
    EXIT.

SYNC-DISPLACEMENT-MODULO.
    COMPUTE D3-DISP-WRAP-MOD = D2-COMM-S3 - ((D2-COMM-S3 / 256) * 256).
    EXIT.

END-STRATEGY.
