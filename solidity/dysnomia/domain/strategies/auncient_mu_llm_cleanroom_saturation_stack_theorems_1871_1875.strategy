        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-MU-STACK-SATURATE.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-SATURATE-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1871-STACK-OK          PIC 9(01) VALUE 1.
            05  WS-TH1872-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1873-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1874-1875M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1875-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-SATURATE-WIT             PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-SATURATE.
            GOBACK.
        1000-EVALUATE-SATURATE.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1871-STACK-OK = 1 AND
               WS-TH1872-DATBIN-STRAT-OK = 1 AND
               WS-TH1873-SUBMICRO-LAT-OK = 1 AND
               WS-TH1874-1875M-SAAT-OK = 1 AND
               WS-TH1875-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-SATURATE-WIT
            ELSE
                MOVE 0 TO WS-SATURATE-WIT.
