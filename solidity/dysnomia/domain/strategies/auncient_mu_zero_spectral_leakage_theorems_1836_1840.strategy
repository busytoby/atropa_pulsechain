        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-ZERO-LEAKAGE.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-SPECTRAL-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1836-SPECTRAL-OK       PIC 9(01) VALUE 1.
            05  WS-TH1837-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1838-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1839-1840M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1840-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-SPECTRAL-WIT             PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-SPECTRAL.
            GOBACK.
        1000-EVALUATE-SPECTRAL.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1836-SPECTRAL-OK = 1 AND
               WS-TH1837-DATBIN-STRAT-OK = 1 AND
               WS-TH1838-SUBMICRO-LAT-OK = 1 AND
               WS-TH1839-1840M-SAAT-OK = 1 AND
               WS-TH1840-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-SPECTRAL-WIT
            ELSE
                MOVE 0 TO WS-SPECTRAL-WIT.
