        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-MERIT-GATE.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-MERIT-GATE-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1766-MERIT-GATE-OK     PIC 9(01) VALUE 1.
            05  WS-TH1767-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1768-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1769-1770M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1770-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-MERIT-GATE-WIT           PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-MERIT-GATE.
            GOBACK.
        1000-EVALUATE-MERIT-GATE.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1766-MERIT-GATE-OK = 1 AND
               WS-TH1767-DATBIN-STRAT-OK = 1 AND
               WS-TH1768-SUBMICRO-LAT-OK = 1 AND
               WS-TH1769-1770M-SAAT-OK = 1 AND
               WS-TH1770-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-MERIT-GATE-WIT
            ELSE
                MOVE 0 TO WS-MERIT-GATE-WIT.
