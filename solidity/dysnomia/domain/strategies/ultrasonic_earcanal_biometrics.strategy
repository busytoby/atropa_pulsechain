        IDENTIFICATION DIVISION.
        PROGRAM-ID. BIO-EAR-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / ULTRASONIC EAR-CANAL BIOMETRIC AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-BIO-PARAMS.
           05 WS-EARCANAL-DEPTH-MM      PIC 9(02) VALUE 08.
           05 WS-TRANSFER-ENTROPY-M     PIC 9(04) VALUE 0750.
           05 WS-BIO-MATCH-SCORE-M      PIC 9(04) VALUE 0920.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-BIO-VITALITY           PIC 9(09) VALUE 0.
           05 WS-BIO-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-BIO-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-BIO-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 INVALID-EARCANAL-DEPTH      VALUE 2.
              88 INVALID-TRANSFER-ENTROPY    VALUE 3.
              88 BIO-MATCH-BELOW-FLOOR       VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 BIOMETRIC-COLLAPSE          VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-BIOMETRIC-RECOGNITION
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-EARCANAL-DEPTH-MM < 2 OR WS-EARCANAL-DEPTH-MM > 20
                SET INVALID-EARCANAL-DEPTH TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-TRANSFER-ENTROPY-M < 300 OR WS-TRANSFER-ENTROPY-M > 1000
                SET INVALID-TRANSFER-ENTROPY TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-BIO-MATCH-SCORE-M < 850 OR WS-BIO-MATCH-SCORE-M > 1000
                SET BIO-MATCH-BELOW-FLOOR TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-BIOMETRIC-RECOGNITION.
            COMPUTE WS-BIO-VITALITY = (WS-BIO-MATCH-SCORE-M / 4) +
                                      (WS-TRANSFER-ENTROPY-M / 8) +
                                      ((20 - WS-EARCANAL-DEPTH-MM) * 16) + 1.

            IF WS-BIO-VITALITY EQUAL ZERO
                SET BIOMETRIC-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-BIO-COHERENCE = (WS-BIO-MATCH-SCORE-M / 16) +
                                       (WS-TRANSFER-ENTROPY-M / 32) +
                                       ((20 - WS-EARCANAL-DEPTH-MM) * 4).

            COMPUTE WS-BIO-REBAR-LATCH = 1470169088 +
                                         (WS-BIO-MATCH-SCORE-M / 2) +
                                         (WS-TRANSFER-ENTROPY-M / 4).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-BIO-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-BIO-VITALITY * 10) +
                                         (WS-BIO-COHERENCE * 10) +
                                         (WS-BIO-MATCH-SCORE-M * 10) +
                                         (WS-BIO-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-BIO-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-BIO-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
