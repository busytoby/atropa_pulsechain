        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-TK-RECOMB-111-115.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-TK-RECOMB-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH111-AST-COMPOS-OK      PIC 9(01) VALUE 1.
            05  WS-TH112-DAG-CONVERGE-OK    PIC 9(01) VALUE 1.
            05  WS-TH113-RIB-SCENEGRAPH-OK  PIC 9(01) VALUE 1.
            05  WS-TH114-REWARD-AMORT-OK    PIC 9(01) VALUE 1.
            05  WS-TH115-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-TK-RECOMB-WITNESS        PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-TK-RECOMB.
            GOBACK.
        1000-EVALUATE-TK-RECOMB.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH111-AST-COMPOS-OK = 1 AND
               WS-TH112-DAG-CONVERGE-OK = 1 AND
               WS-TH113-RIB-SCENEGRAPH-OK = 1 AND
               WS-TH114-REWARD-AMORT-OK = 1 AND
               WS-TH115-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-TK-RECOMB-WITNESS
            ELSE
                MOVE 0 TO WS-TK-RECOMB-WITNESS.
