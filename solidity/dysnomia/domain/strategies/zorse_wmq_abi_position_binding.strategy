       IDENTIFICATION DIVISION.
       PROGRAM-ID. ZORSE-WMQ-ABI-STRATEGY.
       AUTHOR. AUNCIENT DYSNOMIA VM / ZORSE WMQ SCSI ABI POSITION AUDIT.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-BINDING-PARAMETERS.
          05 WS-TOKEN-POS-X            PIC 9(05) VALUE 00128.
          05 WS-TOKEN-POS-Y            PIC 9(05) VALUE 00064.
          05 WS-WMQ-SCSI-OPCODE        PIC 9(03) VALUE 032.
          05 WS-CONTRACT-ABI-SEL       PIC 9(09) VALUE 123456789.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-RADIAL-DIST-Q16        PIC 9(06) VALUE 0.
          05 WS-J0-RADIAL              PIC 9(09) VALUE 0.
          05 WS-J1-RADIAL              PIC 9(09) VALUE 0.
          05 WS-WAVE-PACKET            PIC 9(09) VALUE 0.
          05 WS-SHADOW-SCSI-BASELINE   PIC 9(12) VALUE 0.
          05 WS-OPCODE-MOD             PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-POSITION            VALUE 2.
             88 INVALID-SCSI-OPCODE         VALUE 3.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 4.
             88 GATING-CLAMP-OVERFLOW       VALUE 5.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 6.
             88 CASCADE-ROLLBACK-FAIL       VALUE 7.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-WMQ-ABI-BINDING
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-TOKEN-POS-X > 2048 OR WS-TOKEN-POS-Y > 2048
               SET INVALID-POSITION TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-WMQ-SCSI-OPCODE > 255
               SET INVALID-SCSI-OPCODE TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-WMQ-ABI-BINDING.
           COMPUTE WS-RADIAL-DIST-Q16 = (WS-TOKEN-POS-X + WS-TOKEN-POS-Y) * 16.
           IF WS-RADIAL-DIST-Q16 > 65536
               MOVE 65536 TO WS-RADIAL-DIST-Q16
           END-IF.

           COMPUTE WS-J0-RADIAL = 65536 - ((WS-RADIAL-DIST-Q16 * WS-RADIAL-DIST-Q16) / 262144).
           COMPUTE WS-J1-RADIAL = (WS-RADIAL-DIST-Q16 / 2) - ((WS-RADIAL-DIST-Q16 * WS-RADIAL-DIST-Q16 * WS-RADIAL-DIST-Q16) / 1048576).
           COMPUTE WS-WAVE-PACKET = WS-J0-RADIAL + (WS-J1-RADIAL / 4).

           COMPUTE WS-SHADOW-SCSI-BASELINE = (WS-CICS-WRITER-ID * 1000000) + (WS-WMQ-SCSI-OPCODE * 1000) + FUNCTION MOD(WS-CONTRACT-ABI-SEL, 1000).

           COMPUTE WS-OPCODE-MOD = FUNCTION MOD(WS-WMQ-SCSI-OPCODE, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-OPCODE-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-SCSI-BASELINE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = (((WS-SHADOW-SCSI-BASELINE + (WS-WAVE-PACKET / 16)) * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-SCSI-BASELINE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-WMQ-SCSI-OPCODE * 1000) + FUNCTION MOD(WS-CONTRACT-ABI-SEL, 1000))
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-SCSI-BASELINE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
