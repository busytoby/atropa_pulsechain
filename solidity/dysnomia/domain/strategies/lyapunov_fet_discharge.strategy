       IDENTIFICATION DIVISION.
       PROGRAM-ID. LYAPUNOV-FET-STRATEGY.
       AUTHOR. AUNCIENT DYSNOMIA VM / FET DISCHARGE.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-FET-PARAMS.
          05 WS-INIT-GATE-CHARGE-Q0    PIC 9(05) VALUE 25000.
          05 WS-SPRING-K-FET           PIC 9(04) VALUE 0250.
          05 WS-DISCHARGE-CYCLES-N     PIC 9(02) VALUE 16.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-CURRENT-GATE-CHARGE    PIC 9(05) VALUE 0.
          05 WS-STEP-IDX               PIC 9(02) VALUE 0.
          05 WS-SHADOW-FET-BASE        PIC 9(12) VALUE 0.
          05 WS-CYC-MOD                PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-GATE-CHARGE         VALUE 2.
             88 INVALID-SPRING-K            VALUE 3.
             88 INVALID-DISCHARGE-CYCLES    VALUE 4.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
             88 THERMAL-BLOWOUT-FAIL        VALUE 6.
             88 GATING-CLAMP-OVERFLOW       VALUE 7.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 8.
             88 CASCADE-ROLLBACK-FAIL       VALUE 9.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-VERLET-DISCHARGE
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-INIT-GATE-CHARGE-Q0 > 50000
               SET INVALID-GATE-CHARGE TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SPRING-K-FET < 1 OR WS-SPRING-K-FET > 1000
               SET INVALID-SPRING-K TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-DISCHARGE-CYCLES-N < 1 OR WS-DISCHARGE-CYCLES-N > 64
               SET INVALID-DISCHARGE-CYCLES TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-VERLET-DISCHARGE.
           MOVE WS-INIT-GATE-CHARGE-Q0 TO WS-CURRENT-GATE-CHARGE.

           PERFORM VARYING WS-STEP-IDX FROM 1 BY 1 UNTIL WS-STEP-IDX > WS-DISCHARGE-CYCLES-N
               COMPUTE WS-CURRENT-GATE-CHARGE = (WS-CURRENT-GATE-CHARGE * 875) / 1000
           END-PERFORM.

           IF WS-CURRENT-GATE-CHARGE > WS-INIT-GATE-CHARGE-Q0
               SET THERMAL-BLOWOUT-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-SHADOW-FET-BASE = (WS-CICS-WRITER-ID * 1000000) + 
               (WS-DISCHARGE-CYCLES-N * 10000) + (WS-SPRING-K-FET * 10) + (WS-CURRENT-GATE-CHARGE / 16).

           COMPUTE WS-CYC-MOD = FUNCTION MOD(WS-SPRING-K-FET, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-CYC-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-FET-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-FET-BASE + ((WS-CURRENT-GATE-CHARGE * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-FET-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-DISCHARGE-CYCLES-N * 10000) + (WS-SPRING-K-FET * 10) + (WS-CURRENT-GATE-CHARGE / 16))
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-FET-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
