        IDENTIFICATION DIVISION.
        PROGRAM-ID. NPR-PAC-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / NARRATION PACING REGULATION AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-NPR-PARAMS.
           05 WS-PACING-LAT-MS          PIC 9(02) VALUE 12.
           05 WS-CONCISE-FID-M          PIC 9(04) VALUE 0960.
           05 WS-SPEECH-VAR-CENTI       PIC 9(02) VALUE 01.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-NPR-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-NPR-VITALITY           PIC 9(09) VALUE 0.
           05 WS-NPR-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-NPR-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-NPR-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 PACING-LAT-OUT-OF-BOUNDS    VALUE 2.
              88 CONCISENESS-FIDELITY-LOW    VALUE 3.
              88 VARIANCE-EXCEEDED           VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 PACING-COLLAPSE             VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-NARRATION-PACING
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3 AND WS-K-EXPONENT NOT EQUAL 4
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-PACING-LAT-MS < 5 OR WS-PACING-LAT-MS > 25
                SET PACING-LAT-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CONCISE-FID-M < 850 OR WS-CONCISE-FID-M > 1000
                SET CONCISENESS-FIDELITY-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-SPEECH-VAR-CENTI < 0 OR WS-SPEECH-VAR-CENTI > 5
                SET VARIANCE-EXCEEDED TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-NARRATION-PACING.
            COMPUTE WS-NPR-COMPOSITE = ((30 - WS-PACING-LAT-MS) * 20) +
                                       (WS-CONCISE-FID-M / 2) +
                                       ((10 - WS-SPEECH-VAR-CENTI) * 40).

            COMPUTE WS-NPR-VITALITY = (WS-NPR-COMPOSITE / 4) +
                                      (WS-CONCISE-FID-M / 4) +
                                      ((30 - WS-PACING-LAT-MS) * 4) + 1.

            IF WS-NPR-VITALITY EQUAL ZERO
                SET PACING-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-NPR-COHERENCE = (WS-NPR-COMPOSITE / 16) +
                                       (WS-CONCISE-FID-M / 16) +
                                       ((30 - WS-PACING-LAT-MS) * 2).

            COMPUTE WS-NPR-REBAR-LATCH = 1470169088 +
                                         (WS-NPR-COMPOSITE / 2) +
                                         ((30 - WS-PACING-LAT-MS) * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-NPR-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-NPR-VITALITY * 10) +
                                         (WS-NPR-COHERENCE * 10) +
                                         (WS-NPR-COMPOSITE * 10) +
                                         (WS-NPR-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-NPR-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-NPR-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
