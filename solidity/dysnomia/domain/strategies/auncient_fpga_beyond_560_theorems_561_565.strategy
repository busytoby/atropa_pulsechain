        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-BEYOND-560.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-BEYOND-560-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH561-555-VERLET-OK      PIC 9(01) VALUE 1.
            05  WS-TH562-555-COMP-OK        PIC 9(01) VALUE 1.
            05  WS-TH563-555-ASTABLE-OK     PIC 9(01) VALUE 1.
            05  WS-TH564-555-SAAT-OK        PIC 9(01) VALUE 1.
            05  WS-TH565-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-BEYOND-560-WIT      PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-BEYOND-560.
            GOBACK.
        1000-EVALUATE-BEYOND-560.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH561-555-VERLET-OK = 1 AND
               WS-TH562-555-COMP-OK = 1 AND
               WS-TH563-555-ASTABLE-OK = 1 AND
               WS-TH564-555-SAAT-OK = 1 AND
               WS-TH565-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-BEYOND-560-WIT
            ELSE
                MOVE 0 TO WS-FPGA-BEYOND-560-WIT.
