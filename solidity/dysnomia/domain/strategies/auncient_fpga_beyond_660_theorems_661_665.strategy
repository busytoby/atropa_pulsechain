        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-BEYOND-660.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-BEYOND-660-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH661-TOPOLOGY-MORPH-OK  PIC 9(01) VALUE 1.
            05  WS-TH662-KINEMATIC-SOCK-OK  PIC 9(01) VALUE 1.
            05  WS-TH663-MORPH-LAT-OK       PIC 9(01) VALUE 1.
            05  WS-TH664-665M-SAAT-OK       PIC 9(01) VALUE 1.
            05  WS-TH665-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-BEYOND-660-WIT      PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-BEYOND-660.
            GOBACK.
        1000-EVALUATE-BEYOND-660.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH661-TOPOLOGY-MORPH-OK = 1 AND
               WS-TH662-KINEMATIC-SOCK-OK = 1 AND
               WS-TH663-MORPH-LAT-OK = 1 AND
               WS-TH664-665M-SAAT-OK = 1 AND
               WS-TH665-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-BEYOND-660-WIT
            ELSE
                MOVE 0 TO WS-FPGA-BEYOND-660-WIT.
