       IDENTIFICATION DIVISION.
       PROGRAM-ID. CPM-TOMIE-LYAPUNOV-STRATEGY-STANDARD.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-LYAPUNOV-PROOF-BOUNDS.
           05  WS-DISCRETE-ENERGY-V        PIC 9(09) VALUE 000100000.
           05  WS-DELTA-ENERGY-DV          PIC S9(09) VALUE -000012500.
           05  WS-BMRC-CONTRACTION-RATIO   PIC 9(03)V9(03) VALUE 000.875.
           05  WS-FINITE-DECIDABLE-STEPS   PIC 9(04) VALUE 1024.
       01  WS-STANDARD-VERIFICATION.
           05  WS-POSITIVE-DEFINITE-MET    PIC 9(01) VALUE 1.
           05  WS-NEGATIVE-DISSIPATIVE-MET PIC 9(01) VALUE 1.
           05  WS-DECIDABLE-CONVERGENCE    PIC 9(01) VALUE 1.
           05  WS-TOTAL-STANDARD-CODE      PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-VERIFY-POSITIVE-DEFINITENESS.
           PERFORM 2000-VERIFY-ENERGY-DECAY.
           PERFORM 3000-ASSERT-DECIDABLE-PROOF.
           PERFORM 4000-SYNTHESIZE-STANDARD.
           GOBACK.
       1000-VERIFY-POSITIVE-DEFINITENESS.
           IF WS-DISCRETE-ENERGY-V > 0
               MOVE 1 TO WS-POSITIVE-DEFINITE-MET
           ELSE
               MOVE 0 TO WS-POSITIVE-DEFINITE-MET.
       2000-VERIFY-ENERGY-DECAY.
           IF WS-DELTA-ENERGY-DV < 0
               MOVE 1 TO WS-NEGATIVE-DISSIPATIVE-MET
           ELSE
               MOVE 0 TO WS-NEGATIVE-DISSIPATIVE-MET.
       3000-ASSERT-DECIDABLE-PROOF.
           IF WS-BMRC-CONTRACTION-RATIO <= 000.875
               MOVE 1 TO WS-DECIDABLE-CONVERGENCE
           ELSE
               MOVE 0 TO WS-DECIDABLE-CONVERGENCE.
       4000-SYNTHESIZE-STANDARD.
           IF WS-POSITIVE-DEFINITE-MET = 1 AND
              WS-NEGATIVE-DISSIPATIVE-MET = 1 AND
              WS-DECIDABLE-CONVERGENCE = 1
               MOVE 1 TO WS-TOTAL-STANDARD-CODE
           ELSE
               MOVE 0 TO WS-TOTAL-STANDARD-CODE.
