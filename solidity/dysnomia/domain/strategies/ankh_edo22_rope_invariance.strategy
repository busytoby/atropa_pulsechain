       IDENTIFICATION DIVISION.
       PROGRAM-ID. ANKH-ROPE-INVARIANCE.
       AUTHOR. AUNCIENT DYSNOMIA VM / ANKH EDO22 ROPE.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-ROPE-PARAMS.
          05 WS-INIT-DISPERSION-MRAD   PIC 9(05) VALUE 15000.
          05 WS-TOKEN-POSITION-M       PIC 9(05) VALUE 16384.
          05 WS-SCALE-STEPS-N          PIC 9(02) VALUE 16.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-CURRENT-DISPERSION     PIC 9(05) VALUE 0.
          05 WS-STEP-IDX               PIC 9(02) VALUE 0.
          05 WS-POS-MOD                PIC 9(03) VALUE 0.
          05 WS-SHADOW-ROPE-BASE       PIC 9(12) VALUE 0.
          05 WS-CYC-MOD                PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-PHASE-DISPERSION    VALUE 2.
             88 INVALID-TOKEN-POSITION      VALUE 3.
             88 INVALID-SCALE-STEPS         VALUE 4.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
             88 PHASE-DISP-DIVERG-FAIL      VALUE 6.
             88 GATING-CLAMP-OVERFLOW       VALUE 7.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 8.
             88 CASCADE-ROLLBACK-FAIL       VALUE 9.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-ROPE-CONTRACTION
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-INIT-DISPERSION-MRAD > 50000
               SET INVALID-PHASE-DISPERSION TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-TOKEN-POSITION-M < 1 OR WS-TOKEN-POSITION-M > 32768
               SET INVALID-TOKEN-POSITION TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SCALE-STEPS-N < 1 OR WS-SCALE-STEPS-N > 64
               SET INVALID-SCALE-STEPS TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-ROPE-CONTRACTION.
           MOVE WS-INIT-DISPERSION-MRAD TO WS-CURRENT-DISPERSION.

           PERFORM VARYING WS-STEP-IDX FROM 1 BY 1 UNTIL WS-STEP-IDX > WS-SCALE-STEPS-N
               COMPUTE WS-CURRENT-DISPERSION = (WS-CURRENT-DISPERSION * 875) / 1000
           END-PERFORM.

           IF WS-CURRENT-DISPERSION > WS-INIT-DISPERSION-MRAD
               SET PHASE-DISP-DIVERG-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-POS-MOD = FUNCTION MOD(WS-TOKEN-POSITION-M, 100).

           COMPUTE WS-SHADOW-ROPE-BASE = (WS-CICS-WRITER-ID * 1000000) + 
               (WS-SCALE-STEPS-N * 10000) + (WS-POS-MOD * 10) + (WS-CURRENT-DISPERSION / 16).

           COMPUTE WS-CYC-MOD = FUNCTION MOD(WS-SCALE-STEPS-N, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-CYC-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-ROPE-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-ROPE-BASE + ((WS-CURRENT-DISPERSION * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-ROPE-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-SCALE-STEPS-N * 10000) + (WS-POS-MOD * 10) + (WS-CURRENT-DISPERSION / 16))
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-ROPE-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
