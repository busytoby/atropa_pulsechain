        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-CLEANROOM.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-CLEANROOM-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH281-CLEANROOM-OK       PIC 9(01) VALUE 1.
            05  WS-TH282-COBOL-STD-OK       PIC 9(01) VALUE 1.
            05  WS-TH283-BISIMULATION-OK    PIC 9(01) VALUE 1.
            05  WS-TH284-68KB-GUARD-OK      PIC 9(01) VALUE 1.
            05  WS-TH285-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-CLEANROOM-WIT       PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-CLEANROOM.
            GOBACK.
        1000-EVALUATE-CLEANROOM.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH281-CLEANROOM-OK = 1 AND
               WS-TH282-COBOL-STD-OK = 1 AND
               WS-TH283-BISIMULATION-OK = 1 AND
               WS-TH284-68KB-GUARD-OK = 1 AND
               WS-TH285-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-CLEANROOM-WIT
            ELSE
                MOVE 0 TO WS-FPGA-CLEANROOM-WIT.
