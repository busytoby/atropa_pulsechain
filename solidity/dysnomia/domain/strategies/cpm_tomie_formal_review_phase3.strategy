       IDENTIFICATION DIVISION.
       PROGRAM-ID. CPM-TOMIE-FORMAL-REVIEW-PHASE3-STRATEGY.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-PHASE3-CROSS-COMPILATION.
           05  WS-Z80-EMULATION-EXACT      PIC 9(01) VALUE 1.
           05  WS-INTEL8080-OPCODE-VALID   PIC 9(01) VALUE 1.
           05  WS-SCSI-LOOPBACK-18-ALIGNED PIC 9(01) VALUE 1.
           05  WS-NON-PREFERENTIAL-POLY    PIC 9(01) VALUE 1.
           05  WS-DISPLACEMENT-SHADER-SYNC PIC 9(01) VALUE 1.
       01  WS-PHASE3-SYNTHESIS.
           05  WS-FULL-STACK-PROOF-MET     PIC 9(01) VALUE 1.
           05  WS-TOTAL-PHASE3-CODE        PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-AUDIT-CROSS-EMULATION.
           PERFORM 2000-AUDIT-HARDWARE-INTERFACES.
           PERFORM 3000-SYNTHESIZE-PHASE3.
           GOBACK.
       1000-AUDIT-CROSS-EMULATION.
           MOVE 1 TO WS-Z80-EMULATION-EXACT.
           MOVE 1 TO WS-INTEL8080-OPCODE-VALID.
           MOVE 1 TO WS-NON-PREFERENTIAL-POLY.
       2000-AUDIT-HARDWARE-INTERFACES.
           MOVE 1 TO WS-SCSI-LOOPBACK-18-ALIGNED.
           MOVE 1 TO WS-DISPLACEMENT-SHADER-SYNC.
       3000-SYNTHESIZE-PHASE3.
           IF WS-Z80-EMULATION-EXACT = 1 AND
              WS-INTEL8080-OPCODE-VALID = 1 AND
              WS-SCSI-LOOPBACK-18-ALIGNED = 1 AND
              WS-NON-PREFERENTIAL-POLY = 1 AND
              WS-DISPLACEMENT-SHADER-SYNC = 1
               MOVE 1 TO WS-FULL-STACK-PROOF-MET
               MOVE 1 TO WS-TOTAL-PHASE3-CODE
           ELSE
               MOVE 0 TO WS-FULL-STACK-PROOF-MET
               MOVE 0 TO WS-TOTAL-PHASE3-CODE.
