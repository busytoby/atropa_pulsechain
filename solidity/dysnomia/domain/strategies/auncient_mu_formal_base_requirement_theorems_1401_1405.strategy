        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FORM-BASE-REQ.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FORM-BASE-REQ-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1401-GATE-OK           PIC 9(01) VALUE 1.
            05  WS-TH1402-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1403-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1404-1405M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1405-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-FORM-BASE-REQ-WIT        PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-FORM-BASE-REQ.
            GOBACK.
        1000-EVALUATE-FORM-BASE-REQ.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1401-GATE-OK = 1 AND
               WS-TH1402-DATBIN-STRAT-OK = 1 AND
               WS-TH1403-SUBMICRO-LAT-OK = 1 AND
               WS-TH1404-1405M-SAAT-OK = 1 AND
               WS-TH1405-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-FORM-BASE-REQ-WIT
            ELSE
                MOVE 0 TO WS-FORM-BASE-REQ-WIT.
