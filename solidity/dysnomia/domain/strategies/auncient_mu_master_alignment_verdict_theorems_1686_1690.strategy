        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-MAST-VERD.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-MAST-VERD-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1686-MAST-VERD-OK      PIC 9(01) VALUE 1.
            05  WS-TH1687-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1688-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1689-1690M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1690-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-MAST-VERD-WIT            PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-MAST-VERD.
            GOBACK.
        1000-EVALUATE-MAST-VERD.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1686-MAST-VERD-OK = 1 AND
               WS-TH1687-DATBIN-STRAT-OK = 1 AND
               WS-TH1688-SUBMICRO-LAT-OK = 1 AND
               WS-TH1689-1690M-SAAT-OK = 1 AND
               WS-TH1690-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-MAST-VERD-WIT
            ELSE
                MOVE 0 TO WS-MAST-VERD-WIT.
