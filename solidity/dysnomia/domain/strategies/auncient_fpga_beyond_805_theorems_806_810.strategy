        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-BEYOND-805.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-BEYOND-805-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH806-PHOTONIC-OK        PIC 9(01) VALUE 1.
            05  WS-TH807-POLARITON-OK       PIC 9(01) VALUE 1.
            05  WS-TH808-OPTICAL-LAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH809-810M-SAAT-OK       PIC 9(01) VALUE 1.
            05  WS-TH810-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-BEYOND-805-WIT      PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-BEYOND-805.
            GOBACK.
        1000-EVALUATE-BEYOND-805.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH806-PHOTONIC-OK = 1 AND
               WS-TH807-POLARITON-OK = 1 AND
               WS-TH808-OPTICAL-LAT-OK = 1 AND
               WS-TH809-810M-SAAT-OK = 1 AND
               WS-TH810-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-BEYOND-805-WIT
            ELSE
                MOVE 0 TO WS-FPGA-BEYOND-805-WIT.
