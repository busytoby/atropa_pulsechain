        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-MU-CONTOUR.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-MU-CONTOUR-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1376-CONTOUR-OK        PIC 9(01) VALUE 1.
            05  WS-TH1377-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1378-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1379-1380M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1380-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-MU-CONTOUR-WIT           PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-MU-CONTOUR.
            GOBACK.
        1000-EVALUATE-MU-CONTOUR.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1376-CONTOUR-OK = 1 AND
               WS-TH1377-DATBIN-STRAT-OK = 1 AND
               WS-TH1378-SUBMICRO-LAT-OK = 1 AND
               WS-TH1379-1380M-SAAT-OK = 1 AND
               WS-TH1380-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-MU-CONTOUR-WIT
            ELSE
                MOVE 0 TO WS-MU-CONTOUR-WIT.
