        IDENTIFICATION DIVISION.
        PROGRAM-ID. SRR-RES-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / SPATIAL REFERENCE RESOLUTION AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-SRR-PARAMS.
           05 WS-TRIAGE-LAT-MS          PIC 9(02) VALUE 12.
           05 WS-PRONOUN-FID-M          PIC 9(04) VALUE 0960.
           05 WS-CLARIFY-LAT-MS         PIC 9(02) VALUE 04.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-SRR-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-SRR-VITALITY           PIC 9(09) VALUE 0.
           05 WS-SRR-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-SRR-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-SRR-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 TRIAGE-LAT-OUT-OF-BOUNDS    VALUE 2.
              88 PRONOUN-FID-LOW             VALUE 3.
              88 CLARIFY-LAT-OUT-OF-BOUNDS   VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 TRIAGE-COLLAPSE             VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-REFERENCE-RESOLVE
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-TRIAGE-LAT-MS < 5 OR WS-TRIAGE-LAT-MS > 25
                SET TRIAGE-LAT-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-PRONOUN-FID-M < 850 OR WS-PRONOUN-FID-M > 1000
                SET PRONOUN-FID-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CLARIFY-LAT-MS < 1 OR WS-CLARIFY-LAT-MS > 10
                SET CLARIFY-LAT-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-REFERENCE-RESOLVE.
            COMPUTE WS-SRR-COMPOSITE = ((30 - WS-TRIAGE-LAT-MS) * 20) +
                                       (WS-PRONOUN-FID-M / 2) +
                                       ((15 - WS-CLARIFY-LAT-MS) * 20).

            COMPUTE WS-SRR-VITALITY = (WS-SRR-COMPOSITE / 4) +
                                      (WS-PRONOUN-FID-M / 4) +
                                      ((30 - WS-TRIAGE-LAT-MS) * 4) + 1.

            IF WS-SRR-VITALITY EQUAL ZERO
                SET TRIAGE-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-SRR-COHERENCE = (WS-SRR-COMPOSITE / 16) +
                                       (WS-PRONOUN-FID-M / 16) +
                                       ((30 - WS-TRIAGE-LAT-MS) * 2).

            COMPUTE WS-SRR-REBAR-LATCH = 1470169088 +
                                         (WS-SRR-COMPOSITE / 2) +
                                         ((30 - WS-TRIAGE-LAT-MS) * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-SRR-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-SRR-VITALITY * 10) +
                                         (WS-SRR-COHERENCE * 10) +
                                         (WS-SRR-COMPOSITE * 10) +
                                         (WS-SRR-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-SRR-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-SRR-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
