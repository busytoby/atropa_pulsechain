        IDENTIFICATION DIVISION.
        PROGRAM-ID. ERB-REC-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / ERROR RECOVERY BACKTRACKING AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-ERB-PARAMS.
           05 WS-BACKTRACK-LAT-MS       PIC 9(02) VALUE 12.
           05 WS-RECOVERY-FID-M         PIC 9(04) VALUE 0960.
           05 WS-DEPARTURE-DRIFT-MM     PIC 9(02) VALUE 01.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-ERB-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-ERB-VITALITY           PIC 9(09) VALUE 0.
           05 WS-ERB-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-ERB-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-ERB-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 BACKTRACK-LAT-OUT-OF-BOUNDS VALUE 2.
              88 RECOVERY-FIDELITY-LOW       VALUE 3.
              88 DEPARTURE-DRIFT-EXCEEDED    VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 RECOVERY-COLLAPSE           VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-ERROR-RECOVERY
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3 AND WS-K-EXPONENT NOT EQUAL 4
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-BACKTRACK-LAT-MS < 5 OR WS-BACKTRACK-LAT-MS > 25
                SET BACKTRACK-LAT-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-RECOVERY-FID-M < 850 OR WS-RECOVERY-FID-M > 1000
                SET RECOVERY-FIDELITY-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-DEPARTURE-DRIFT-MM < 0 OR WS-DEPARTURE-DRIFT-MM > 5
                SET DEPARTURE-DRIFT-EXCEEDED TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-ERROR-RECOVERY.
            COMPUTE WS-ERB-COMPOSITE = ((30 - WS-BACKTRACK-LAT-MS) * 20) +
                                       (WS-RECOVERY-FID-M / 2) +
                                       ((10 - WS-DEPARTURE-DRIFT-MM) * 40).

            COMPUTE WS-ERB-VITALITY = (WS-ERB-COMPOSITE / 4) +
                                      (WS-RECOVERY-FID-M / 4) +
                                      ((30 - WS-BACKTRACK-LAT-MS) * 4) + 1.

            IF WS-ERB-VITALITY EQUAL ZERO
                SET RECOVERY-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-ERB-COHERENCE = (WS-ERB-COMPOSITE / 16) +
                                       (WS-RECOVERY-FID-M / 16) +
                                       ((30 - WS-BACKTRACK-LAT-MS) * 2).

            COMPUTE WS-ERB-REBAR-LATCH = 1470169088 +
                                         (WS-ERB-COMPOSITE / 2) +
                                         ((30 - WS-BACKTRACK-LAT-MS) * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-ERB-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-ERB-VITALITY * 10) +
                                         (WS-ERB-COHERENCE * 10) +
                                         (WS-ERB-COMPOSITE * 10) +
                                         (WS-ERB-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-ERB-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-ERB-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
