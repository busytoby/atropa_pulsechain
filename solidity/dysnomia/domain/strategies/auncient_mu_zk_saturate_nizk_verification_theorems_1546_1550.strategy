        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-ZKSAT-NIZK.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-ZKSAT-NIZK-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1546-NIZK-OK           PIC 9(01) VALUE 1.
            05  WS-TH1547-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1548-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1549-1550M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1550-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-ZKSAT-NIZK-WIT           PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-ZKSAT-NIZK.
            GOBACK.
        1000-EVALUATE-ZKSAT-NIZK.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1546-NIZK-OK = 1 AND
               WS-TH1547-DATBIN-STRAT-OK = 1 AND
               WS-TH1548-SUBMICRO-LAT-OK = 1 AND
               WS-TH1549-1550M-SAAT-OK = 1 AND
               WS-TH1550-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-ZKSAT-NIZK-WIT
            ELSE
                MOVE 0 TO WS-ZKSAT-NIZK-WIT.
