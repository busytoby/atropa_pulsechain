IDENTIFICATION DIVISION.
PROGRAM-ID. PROG-HARVARD-ZUO-UNISELECTOR.

DATA DIVISION.
01 D0-SUBSTRATE-TRUNK.
   05 D0-MOTZKIN-PRIME     PIC 9(9) USAGE R0.
   05 D0-K-EXPONENT        PIC 9(9) USAGE R1.
   05 D0-BOUNCE-FAULT-FLAG PIC 9(9) USAGE R2.
01 D1-UNISELECTOR-SHADOW.
   05 D1-STARTING-STEP     PIC 9(9) USAGE R3.
   05 D1-IMPULSE-COUNT     PIC 9(9) USAGE R4.
   05 D1-SHADOW-STEP-SNAP  PIC 9(9) USAGE R5.
01 D2-STEPPING-STAGE.
   05 D2-FINAL-WIPER-POS   PIC 9(9) USAGE R6.
   05 D2-G-SWIGLU-GATE     PIC 9(9) USAGE R7.
   05 D2-COMMITTED-STATE   PIC 9(9) USAGE R8.
01 D3-LEAF-EVAL.
   05 D3-PROOF-RULING      PIC 9(9) USAGE R9.
   05 D3-DISP-WRAP-MOD     PIC 9(9) USAGE R10.

PROCEDURE DIVISION.
    MOVE 953467954 TO D0-MOTZKIN-PRIME.
    MOVE 3 TO D0-K-EXPONENT.
    MOVE 0 TO D0-BOUNCE-FAULT-FLAG.
    MOVE 5 TO D1-STARTING-STEP.
    MOVE 31 TO D1-IMPULSE-COUNT.

    PERFORM STAGE-UNISELECTOR-STEP.
    PERFORM APPLY-BOUNCE-LATCH.
    PERFORM SYNC-DISPLACEMENT.

    IF D1-SHADOW-STEP-SNAP == D1-STARTING-STEP AND D2-FINAL-WIPER-POS == 5
        MOVE 0 TO D3-PROOF-RULING
        SET depth 4
    ELSE
        MOVE 4 TO D3-PROOF-RULING
        SET depth 1
    END-IF.

    EVAL.
    GO TO END-STRATEGY.

STAGE-UNISELECTOR-STEP.
    MOVE D1-STARTING-STEP TO D1-SHADOW-STEP-SNAP.
    COMPUTE D2-FINAL-WIPER-POS = (D1-STARTING-STEP + D1-IMPULSE-COUNT) - (((D1-STARTING-STEP + D1-IMPULSE-COUNT) / 31) * 31).
    COMPUTE D2-G-SWIGLU-GATE = 875 + ((125 * D1-IMPULSE-COUNT) / 100).
    EXIT.

APPLY-BOUNCE-LATCH.
    IF D0-BOUNCE-FAULT-FLAG == 1
        MOVE D1-SHADOW-STEP-SNAP TO D2-COMMITTED-STATE
    ELSE
        COMPUTE D2-COMMITTED-STATE = (((D2-FINAL-WIPER-POS * 1000) + D1-IMPULSE-COUNT) * D2-G-SWIGLU-GATE) / 1000
    END-IF.
    EXIT.

SYNC-DISPLACEMENT.
    COMPUTE D3-DISP-WRAP-MOD = D2-COMMITTED-STATE - ((D2-COMMITTED-STATE / 256) * 256).
    EXIT.

END-STRATEGY.
