        IDENTIFICATION DIVISION.
        PROGRAM-ID. CIR-COL-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / COLLISION IMPULSE RESPONSE AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-CIR-PARAMS.
           05 WS-IMPULSE-LAT-MS         PIC 9(02) VALUE 12.
           05 WS-ENERGY-FIDELITY-M      PIC 9(04) VALUE 0960.
           05 WS-PENETRATION-DEPTH-UM   PIC 9(02) VALUE 01.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-CIR-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-CIR-VITALITY           PIC 9(09) VALUE 0.
           05 WS-CIR-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-CIR-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-CIR-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 IMPULSE-LAT-OUT-OF-BOUNDS   VALUE 2.
              88 ENERGY-FIDELITY-LOW         VALUE 3.
              88 PENETRATION-EXCEEDED        VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 IMPULSE-COLLAPSE            VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-COLLISION-IMPULSE
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3 AND WS-K-EXPONENT NOT EQUAL 4
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-IMPULSE-LAT-MS < 5 OR WS-IMPULSE-LAT-MS > 25
                SET IMPULSE-LAT-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-ENERGY-FIDELITY-M < 850 OR WS-ENERGY-FIDELITY-M > 1000
                SET ENERGY-FIDELITY-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-PENETRATION-DEPTH-UM < 0 OR WS-PENETRATION-DEPTH-UM > 5
                SET PENETRATION-EXCEEDED TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-COLLISION-IMPULSE.
            COMPUTE WS-CIR-COMPOSITE = ((30 - WS-IMPULSE-LAT-MS) * 20) +
                                       (WS-ENERGY-FIDELITY-M / 2) +
                                       ((10 - WS-PENETRATION-DEPTH-UM) * 40).

            COMPUTE WS-CIR-VITALITY = (WS-CIR-COMPOSITE / 4) +
                                      (WS-ENERGY-FIDELITY-M / 4) +
                                      ((30 - WS-IMPULSE-LAT-MS) * 4) + 1.

            IF WS-CIR-VITALITY EQUAL ZERO
                SET IMPULSE-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-CIR-COHERENCE = (WS-CIR-COMPOSITE / 16) +
                                       (WS-ENERGY-FIDELITY-M / 16) +
                                       ((30 - WS-IMPULSE-LAT-MS) * 2).

            COMPUTE WS-CIR-REBAR-LATCH = 1470169088 +
                                         (WS-CIR-COMPOSITE / 2) +
                                         ((30 - WS-IMPULSE-LAT-MS) * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-CIR-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-CIR-VITALITY * 10) +
                                         (WS-CIR-COHERENCE * 10) +
                                         (WS-CIR-COMPOSITE * 10) +
                                         (WS-CIR-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-CIR-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-CIR-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
