        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-VSEN-TEDDY-PAYROLL.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-VSEN-TEDDY-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1781-DNA-SSN-OK        PIC 9(01) VALUE 1.
            05  WS-TH1782-1M-ENDOW-OK       PIC 9(01) VALUE 1.
            05  WS-TH1783-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1784-1785M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1785-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-VSEN-TEDDY-WIT           PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-VSEN-TEDDY.
            GOBACK.
        1000-EVALUATE-VSEN-TEDDY.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1781-DNA-SSN-OK = 1 AND
               WS-TH1782-1M-ENDOW-OK = 1 AND
               WS-TH1783-SUBMICRO-LAT-OK = 1 AND
               WS-TH1784-1785M-SAAT-OK = 1 AND
               WS-TH1785-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-VSEN-TEDDY-WIT
            ELSE
                MOVE 0 TO WS-VSEN-TEDDY-WIT.
