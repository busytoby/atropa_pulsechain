IDENTIFICATION DIVISION.
PROGRAM-ID. PROG-HARVARD-ZUO-CAM.

DATA DIVISION.
01 D0-SUBSTRATE-TRUNK.
   05 D0-MOTZKIN-PRIME     PIC 9(9) USAGE R0.
   05 D0-K-EXPONENT        PIC 9(9) USAGE R1.
   05 D0-COLLISION-FAULT   PIC 9(9) USAGE R2.
01 D1-CAM-SHADOW.
   05 D1-T-CAM-PHASE       PIC 9(9) USAGE R3.
   05 D1-P-CAM-PHASE       PIC 9(9) USAGE R4.
   05 D1-SHADOW-T-SNAP     PIC 9(9) USAGE R5.
01 D2-TIMING-STAGE.
   05 D2-PHASE-DIFF-VAL    PIC 9(9) USAGE R6.
   05 D2-G-SWIGLU-GATE     PIC 9(9) USAGE R7.
   05 D2-COMMITTED-STATE   PIC 9(9) USAGE R8.
01 D3-LEAF-EVAL.
   05 D3-PROOF-RULING      PIC 9(9) USAGE R9.
   05 D3-DISP-WRAP-MOD     PIC 9(9) USAGE R10.

PROCEDURE DIVISION.
    MOVE 953467954 TO D0-MOTZKIN-PRIME.
    MOVE 3 TO D0-K-EXPONENT.
    MOVE 0 TO D0-COLLISION-FAULT.
    MOVE 2 TO D1-T-CAM-PHASE.
    MOVE 7 TO D1-P-CAM-PHASE.

    PERFORM STAGE-CAM-ORTHOGONALITY.
    PERFORM APPLY-COLLISION-LATCH.
    PERFORM SYNC-DISPLACEMENT.

    IF D1-SHADOW-T-SNAP == D1-T-CAM-PHASE AND D2-PHASE-DIFF-VAL == 5
        MOVE 0 TO D3-PROOF-RULING
        SET depth 4
    ELSE
        MOVE 4 TO D3-PROOF-RULING
        SET depth 1
    END-IF.

    EVAL.
    GO TO END-STRATEGY.

STAGE-CAM-ORTHOGONALITY.
    MOVE D1-T-CAM-PHASE TO D1-SHADOW-T-SNAP.
    COMPUTE D2-PHASE-DIFF-VAL = D1-P-CAM-PHASE - D1-T-CAM-PHASE.
    COMPUTE D2-G-SWIGLU-GATE = 875 + ((125 * ((D1-T-CAM-PHASE * 10) + D1-P-CAM-PHASE)) / 100).
    EXIT.

APPLY-COLLISION-LATCH.
    IF D0-COLLISION-FAULT == 1
        MOVE D1-SHADOW-T-SNAP TO D2-COMMITTED-STATE
    ELSE
        COMPUTE D2-COMMITTED-STATE = ((D1-T-CAM-PHASE * 1000 + D1-P-CAM-PHASE) * D2-G-SWIGLU-GATE) / 1000
    END-IF.
    EXIT.

SYNC-DISPLACEMENT.
    COMPUTE D3-DISP-WRAP-MOD = D2-COMMITTED-STATE - ((D2-COMMITTED-STATE / 256) * 256).
    EXIT.

END-STRATEGY.
