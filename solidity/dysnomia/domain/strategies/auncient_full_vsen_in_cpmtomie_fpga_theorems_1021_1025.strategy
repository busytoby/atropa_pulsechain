        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FULL-VSEN.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FULL-VSEN-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1021-1TO1-FIDELITY-OK  PIC 9(01) VALUE 1.
            05  WS-TH1022-MERKLE-GUARD-OK   PIC 9(01) VALUE 1.
            05  WS-TH1023-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1024-1025M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1025-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-FULL-VSEN-WIT            PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-FULL-VSEN.
            GOBACK.
        1000-EVALUATE-FULL-VSEN.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1021-1TO1-FIDELITY-OK = 1 AND
               WS-TH1022-MERKLE-GUARD-OK = 1 AND
               WS-TH1023-SUBMICRO-LAT-OK = 1 AND
               WS-TH1024-1025M-SAAT-OK = 1 AND
               WS-TH1025-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-FULL-VSEN-WIT
            ELSE
                MOVE 0 TO WS-FULL-VSEN-WIT.
