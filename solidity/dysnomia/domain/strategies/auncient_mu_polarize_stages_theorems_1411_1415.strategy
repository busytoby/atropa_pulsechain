        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-POLARIZE.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-POLARIZE-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1411-POLARIZE-OK       PIC 9(01) VALUE 1.
            05  WS-TH1412-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1413-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1414-1415M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1415-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-POLARIZE-WIT             PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-POLARIZE.
            GOBACK.
        1000-EVALUATE-POLARIZE.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1411-POLARIZE-OK = 1 AND
               WS-TH1412-DATBIN-STRAT-OK = 1 AND
               WS-TH1413-SUBMICRO-LAT-OK = 1 AND
               WS-TH1414-1415M-SAAT-OK = 1 AND
               WS-TH1415-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-POLARIZE-WIT
            ELSE
                MOVE 0 TO WS-POLARIZE-WIT.
