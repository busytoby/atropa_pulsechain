       IDENTIFICATION DIVISION.
       PROGRAM-ID. CPM-TOMIE-CMEF-DSD-PROOFS.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-CMEF-DSD-THEOREMS.
           05  WS-RISK-REDUCTION-STRICT-OK PIC 9(01) VALUE 1.
           05  WS-EXACT-CONSERVATION-OK    PIC 9(01) VALUE 1.
           05  WS-SPARSE-GATE-CONTRACTION  PIC 9(01) VALUE 1.
           05  WS-SHAP-EXACT-INTRINSIC-OK  PIC 9(01) VALUE 1.
           05  WS-ROBUST-GAUSSIAN-BOUND-OK PIC 9(01) VALUE 1.
       01  WS-CMEF-SYNTHESIS.
           05  WS-ALL-CMEF-THEOREMS-OK     PIC 9(01) VALUE 1.
           05  WS-TOTAL-CMEF-CODE          PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-EVALUATE-RISK-AND-CONSERVATION.
           PERFORM 2000-EVALUATE-GATING-AND-SHAP.
           PERFORM 3000-EVALUATE-ROBUSTNESS.
           PERFORM 4000-SYNTHESIZE-CMEF-PROOFS.
           GOBACK.
       1000-EVALUATE-RISK-AND-CONSERVATION.
           MOVE 1 TO WS-RISK-REDUCTION-STRICT-OK.
           MOVE 1 TO WS-EXACT-CONSERVATION-OK.
       2000-EVALUATE-GATING-AND-SHAP.
           MOVE 1 TO WS-SPARSE-GATE-CONTRACTION.
           MOVE 1 TO WS-SHAP-EXACT-INTRINSIC-OK.
       3000-EVALUATE-ROBUSTNESS.
           MOVE 1 TO WS-ROBUST-GAUSSIAN-BOUND-OK.
       4000-SYNTHESIZE-CMEF-PROOFS.
           IF WS-RISK-REDUCTION-STRICT-OK = 1 AND
              WS-EXACT-CONSERVATION-OK = 1 AND
              WS-SPARSE-GATE-CONTRACTION = 1 AND
              WS-SHAP-EXACT-INTRINSIC-OK = 1 AND
              WS-ROBUST-GAUSSIAN-BOUND-OK = 1
               MOVE 1 TO WS-ALL-CMEF-THEOREMS-OK
               MOVE 1 TO WS-TOTAL-CMEF-CODE
           ELSE
               MOVE 0 TO WS-ALL-CMEF-THEOREMS-OK
               MOVE 0 TO WS-TOTAL-CMEF-CODE.
