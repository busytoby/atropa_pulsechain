        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-AWQ.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-AWQ-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1111-AWQ-OK            PIC 9(01) VALUE 1.
            05  WS-TH1112-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1113-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1114-1115M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1115-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-FPGA-AWQ-WIT             PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-FPGA-AWQ.
            GOBACK.
        1000-EVALUATE-FPGA-AWQ.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1111-AWQ-OK = 1 AND
               WS-TH1112-DATBIN-STRAT-OK = 1 AND
               WS-TH1113-SUBMICRO-LAT-OK = 1 AND
               WS-TH1114-1115M-SAAT-OK = 1 AND
               WS-TH1115-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-FPGA-AWQ-WIT
            ELSE
                MOVE 0 TO WS-FPGA-AWQ-WIT.
