        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-SDK-BARRIER.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-BARRIER-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1216-BARRIER-OK        PIC 9(01) VALUE 1.
            05  WS-TH1217-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1218-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1219-1220M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1220-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-BARRIER-WIT              PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-BARRIER.
            GOBACK.
        1000-EVALUATE-BARRIER.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1216-BARRIER-OK = 1 AND
               WS-TH1217-DATBIN-STRAT-OK = 1 AND
               WS-TH1218-SUBMICRO-LAT-OK = 1 AND
               WS-TH1219-1220M-SAAT-OK = 1 AND
               WS-TH1220-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-BARRIER-WIT
            ELSE
                MOVE 0 TO WS-BARRIER-WIT.
