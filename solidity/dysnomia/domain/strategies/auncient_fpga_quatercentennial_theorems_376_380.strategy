        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-QUATERCENTENNIAL.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-QUATERCENT-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH376-QUATERCENT-OK      PIC 9(01) VALUE 1.
            05  WS-TH377-HARDWARE-COHES-OK  PIC 9(01) VALUE 1.
            05  WS-TH378-CROSS-LAYER-TK-OK  PIC 9(01) VALUE 1.
            05  WS-TH379-HOGAN-SOLVENCY-OK  PIC 9(01) VALUE 1.
            05  WS-TH380-GRAND-SEAL-OK      PIC 9(01) VALUE 1.
            05  WS-FPGA-QUATERCENT-WIT      PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-QUATERCENT.
            GOBACK.
        1000-EVALUATE-QUATERCENT.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH376-QUATERCENT-OK = 1 AND
               WS-TH377-HARDWARE-COHES-OK = 1 AND
               WS-TH378-CROSS-LAYER-TK-OK = 1 AND
               WS-TH379-HOGAN-SOLVENCY-OK = 1 AND
               WS-TH380-GRAND-SEAL-OK = 1
                MOVE 1 TO WS-FPGA-QUATERCENT-WIT
            ELSE
                MOVE 0 TO WS-FPGA-QUATERCENT-WIT.
