        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-CCW.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-CCW-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1026-CCW-EXEC-OK       PIC 9(01) VALUE 1.
            05  WS-TH1027-MERKLE-GUARD-OK   PIC 9(01) VALUE 1.
            05  WS-TH1028-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1029-1030M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1030-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-FPGA-CCW-WIT             PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-FPGA-CCW.
            GOBACK.
        1000-EVALUATE-FPGA-CCW.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1026-CCW-EXEC-OK = 1 AND
               WS-TH1027-MERKLE-GUARD-OK = 1 AND
               WS-TH1028-SUBMICRO-LAT-OK = 1 AND
               WS-TH1029-1030M-SAAT-OK = 1 AND
               WS-TH1030-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-FPGA-CCW-WIT
            ELSE
                MOVE 0 TO WS-FPGA-CCW-WIT.
