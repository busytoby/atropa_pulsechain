        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-VSEN-EDO22-VOICE.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-VSEN-EDO22-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1791-EDO22-CALC-OK     PIC 9(01) VALUE 1.
            05  WS-TH1792-FET-PURR-OK       PIC 9(01) VALUE 1.
            05  WS-TH1793-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1794-1795M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1795-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-VSEN-EDO22-WIT           PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-VSEN-EDO22.
            GOBACK.
        1000-EVALUATE-VSEN-EDO22.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1791-EDO22-CALC-OK = 1 AND
               WS-TH1792-FET-PURR-OK = 1 AND
               WS-TH1793-SUBMICRO-LAT-OK = 1 AND
               WS-TH1794-1795M-SAAT-OK = 1 AND
               WS-TH1795-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-VSEN-EDO22-WIT
            ELSE
                MOVE 0 TO WS-VSEN-EDO22-WIT.
