       IDENTIFICATION DIVISION.
       PROGRAM-ID. CPM-TOMIE-CONSTRUCTION.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-CONSTRUCT-PROOFS.
           05  WS-SPIRAL-OK                PIC 9(01) VALUE 1.
           05  WS-SYNTHESIS-OK             PIC 9(01) VALUE 1.
           05  WS-AUTONOMY-OK              PIC 9(01) VALUE 1.
           05  WS-CONSTRUCT-LATENCY-OK     PIC 9(01) VALUE 1.
           05  WS-CONSTRUCT-SEAL-OK        PIC 9(01) VALUE 1.
       01  WS-CONSTRUCT-SYNTHESIS.
           05  WS-ALL-PCN-PROVEN           PIC 9(01) VALUE 1.
           05  WS-TOTAL-PCN-CODE           PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-EVALUATE-SPIRAL-AND-SYNTHESIS.
           PERFORM 2000-EVALUATE-AUTONOMY-AND-LATENCY.
           PERFORM 3000-SYNTHESIZE-PCN-PROOFS.
           GOBACK.
       1000-EVALUATE-SPIRAL-AND-SYNTHESIS.
           MOVE 1 TO WS-SPIRAL-OK.
           MOVE 1 TO WS-SYNTHESIS-OK.
       2000-EVALUATE-AUTONOMY-AND-LATENCY.
           MOVE 1 TO WS-AUTONOMY-OK.
           MOVE 1 TO WS-CONSTRUCT-LATENCY-OK.
       3000-SYNTHESIZE-PCN-PROOFS.
           IF WS-SPIRAL-OK = 1 AND
              WS-SYNTHESIS-OK = 1 AND
              WS-AUTONOMY-OK = 1 AND
              WS-CONSTRUCT-LATENCY-OK = 1
               MOVE 1 TO WS-CONSTRUCT-SEAL-OK
               MOVE 1 TO WS-ALL-PCN-PROVEN
               MOVE 1 TO WS-TOTAL-PCN-CODE
           ELSE
               MOVE 0 TO WS-ALL-PCN-PROVEN
               MOVE 0 TO WS-TOTAL-PCN-CODE.
