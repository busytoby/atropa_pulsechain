        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-ZJ-SNARKS.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-ZJ-SNARKS-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH211-SUCCINCT-OK        PIC 9(01) VALUE 1.
            05  WS-TH212-GLASSBOX-OK        PIC 9(01) VALUE 1.
            05  WS-TH213-FOLDING-OK         PIC 9(01) VALUE 1.
            05  WS-TH214-SETTLEMENT-OK      PIC 9(01) VALUE 1.
            05  WS-TH215-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-ZJ-SNARKS-WITNESS        PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-ZJ-SNARKS.
            GOBACK.
        1000-EVALUATE-ZJ-SNARKS.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH211-SUCCINCT-OK = 1 AND
               WS-TH212-GLASSBOX-OK = 1 AND
               WS-TH213-FOLDING-OK = 1 AND
               WS-TH214-SETTLEMENT-OK = 1 AND
               WS-TH215-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-ZJ-SNARKS-WITNESS
            ELSE
                MOVE 0 TO WS-ZJ-SNARKS-WITNESS.
