        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-PAGETURNER-TK.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-PAGETURNER-TK-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH466-MUTUAL-TK-OK       PIC 9(01) VALUE 1.
            05  WS-TH467-DMA-LATENCY-OK     PIC 9(01) VALUE 1.
            05  WS-TH468-DATBIN-MEDIA-OK    PIC 9(01) VALUE 1.
            05  WS-TH469-PAGE-SAAT-OK       PIC 9(01) VALUE 1.
            05  WS-TH470-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-PAGETURNER-TK-WIT   PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-PAGETURNER-TK.
            GOBACK.
        1000-EVALUATE-PAGETURNER-TK.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH466-MUTUAL-TK-OK = 1 AND
               WS-TH467-DMA-LATENCY-OK = 1 AND
               WS-TH468-DATBIN-MEDIA-OK = 1 AND
               WS-TH469-PAGE-SAAT-OK = 1 AND
               WS-TH470-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-PAGETURNER-TK-WIT
            ELSE
                MOVE 0 TO WS-FPGA-PAGETURNER-TK-WIT.
