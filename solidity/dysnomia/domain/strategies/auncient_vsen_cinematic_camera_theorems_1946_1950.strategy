        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-VSEN-CINCAM.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-VSEN-CINCAM-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1946-CAM-SPLINE-OK     PIC 9(01) VALUE 1.
            05  WS-TH1947-BOKEH-ENERGY-OK   PIC 9(01) VALUE 1.
            05  WS-TH1948-GYRO-FET-OK       PIC 9(01) VALUE 1.
            05  WS-TH1949-1950M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1950-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-VSEN-CINCAM-WIT          PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-VSEN-CINCAM.
            GOBACK.
        1000-EVALUATE-VSEN-CINCAM.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1946-CAM-SPLINE-OK = 1 AND
               WS-TH1947-BOKEH-ENERGY-OK = 1 AND
               WS-TH1948-GYRO-FET-OK = 1 AND
               WS-TH1949-1950M-SAAT-OK = 1 AND
               WS-TH1950-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-VSEN-CINCAM-WIT
            ELSE
                MOVE 0 TO WS-VSEN-CINCAM-WIT.
