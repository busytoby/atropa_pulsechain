        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-QDI-BARREL.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-QDI-BARREL-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1296-QDI-OK            PIC 9(01) VALUE 1.
            05  WS-TH1297-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1298-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1299-1300M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1300-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-QDI-BARREL-WIT           PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-QDI-BARREL.
            GOBACK.
        1000-EVALUATE-QDI-BARREL.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1296-QDI-OK = 1 AND
               WS-TH1297-DATBIN-STRAT-OK = 1 AND
               WS-TH1298-SUBMICRO-LAT-OK = 1 AND
               WS-TH1299-1300M-SAAT-OK = 1 AND
               WS-TH1300-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-QDI-BARREL-WIT
            ELSE
                MOVE 0 TO WS-QDI-BARREL-WIT.
