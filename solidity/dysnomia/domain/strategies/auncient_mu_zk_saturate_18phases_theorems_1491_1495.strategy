        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-18PHASE-SAT.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-18PHASE-SAT-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1491-18PHASE-OK        PIC 9(01) VALUE 1.
            05  WS-TH1492-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1493-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1494-1495M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1495-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-18PHASE-SAT-WIT          PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-18PHASE-SAT.
            GOBACK.
        1000-EVALUATE-18PHASE-SAT.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1491-18PHASE-OK = 1 AND
               WS-TH1492-DATBIN-STRAT-OK = 1 AND
               WS-TH1493-SUBMICRO-LAT-OK = 1 AND
               WS-TH1494-1495M-SAAT-OK = 1 AND
               WS-TH1495-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-18PHASE-SAT-WIT
            ELSE
                MOVE 0 TO WS-18PHASE-SAT-WIT.
