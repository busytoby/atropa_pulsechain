        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-TRANSCEIVER.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-TRANSCEIVER-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH301-SERDES-CH-OK       PIC 9(01) VALUE 1.
            05  WS-TH302-CARRIER-ORTHO-OK   PIC 9(01) VALUE 1.
            05  WS-TH303-EYE-MARGIN-OK      PIC 9(01) VALUE 1.
            05  WS-TH304-SAAT-SETTLE-OK     PIC 9(01) VALUE 1.
            05  WS-TH305-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-TRANSCEIVER-WIT     PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-TRANSCEIVER.
            GOBACK.
        1000-EVALUATE-TRANSCEIVER.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH301-SERDES-CH-OK = 1 AND
               WS-TH302-CARRIER-ORTHO-OK = 1 AND
               WS-TH303-EYE-MARGIN-OK = 1 AND
               WS-TH304-SAAT-SETTLE-OK = 1 AND
               WS-TH305-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-TRANSCEIVER-WIT
            ELSE
                MOVE 0 TO WS-FPGA-TRANSCEIVER-WIT.
