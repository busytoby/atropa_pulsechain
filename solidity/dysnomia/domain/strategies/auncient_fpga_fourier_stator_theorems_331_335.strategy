        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-FOURIER.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-FOURIER-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH331-FOURIER-128PH-OK   PIC 9(01) VALUE 1.
            05  WS-TH332-ISOMETRY-OK        PIC 9(01) VALUE 1.
            05  WS-TH333-PDL-CLEAR-OK       PIC 9(01) VALUE 1.
            05  WS-TH334-FOURIER-SAAT-OK    PIC 9(01) VALUE 1.
            05  WS-TH335-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-FOURIER-WIT         PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-FOURIER.
            GOBACK.
        1000-EVALUATE-FOURIER.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH331-FOURIER-128PH-OK = 1 AND
               WS-TH332-ISOMETRY-OK = 1 AND
               WS-TH333-PDL-CLEAR-OK = 1 AND
               WS-TH334-FOURIER-SAAT-OK = 1 AND
               WS-TH335-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-FOURIER-WIT
            ELSE
                MOVE 0 TO WS-FPGA-FOURIER-WIT.
