        IDENTIFICATION DIVISION.
        PROGRAM-ID. MAM-BON-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / MONOBONE AGENT MESH AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-MAM-PARAMS.
           05 WS-TRANSDUCE-LAT-MS       PIC 9(02) VALUE 12.
           05 WS-CLAN-FIDELITY-M        PIC 9(04) VALUE 0960.
           05 WS-INTER-JITTER-MRAD      PIC 9(02) VALUE 01.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-MAM-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-MAM-VITALITY           PIC 9(09) VALUE 0.
           05 WS-MAM-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-MAM-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-MAM-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 TRANSDUCE-LAT-OUT-OF-BOUNDS VALUE 2.
              88 SYNTHESIS-FIDELITY-LOW      VALUE 3.
              88 JITTER-EXCEEDED             VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 MONOBONE-COLLAPSE           VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-MONOBONE-MESH
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3 AND WS-K-EXPONENT NOT EQUAL 4
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-TRANSDUCE-LAT-MS < 5 OR WS-TRANSDUCE-LAT-MS > 25
                SET TRANSDUCE-LAT-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CLAN-FIDELITY-M < 850 OR WS-CLAN-FIDELITY-M > 1000
                SET SYNTHESIS-FIDELITY-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-INTER-JITTER-MRAD < 0 OR WS-INTER-JITTER-MRAD > 5
                SET JITTER-EXCEEDED TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-MONOBONE-MESH.
            COMPUTE WS-MAM-COMPOSITE = ((30 - WS-TRANSDUCE-LAT-MS) * 20) +
                                       (WS-CLAN-FIDELITY-M / 2) +
                                       ((10 - WS-INTER-JITTER-MRAD) * 40).

            COMPUTE WS-MAM-VITALITY = (WS-MAM-COMPOSITE / 4) +
                                      (WS-CLAN-FIDELITY-M / 4) +
                                      ((30 - WS-TRANSDUCE-LAT-MS) * 4) + 1.

            IF WS-MAM-VITALITY EQUAL ZERO
                SET MONOBONE-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-MAM-COHERENCE = (WS-MAM-COMPOSITE / 16) +
                                       (WS-CLAN-FIDELITY-M / 16) +
                                       ((30 - WS-TRANSDUCE-LAT-MS) * 2).

            COMPUTE WS-MAM-REBAR-LATCH = 1470169088 +
                                         (WS-MAM-COMPOSITE / 2) +
                                         ((30 - WS-TRANSDUCE-LAT-MS) * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-MAM-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-MAM-VITALITY * 10) +
                                         (WS-MAM-COHERENCE * 10) +
                                         (WS-MAM-COMPOSITE * 10) +
                                         (WS-MAM-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-MAM-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-MAM-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
