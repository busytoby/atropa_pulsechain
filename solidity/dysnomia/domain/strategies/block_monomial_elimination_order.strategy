        IDENTIFICATION DIVISION.
        PROGRAM-ID. BLOCK-MONOMIAL-ORDER-STRATEGY.
        AUTHOR. AUNCIENT DYSNOMIA VM / BLOCK ORDER AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-ORDER-PARAMS.
           05 WS-POLY-VARS-L            PIC 9(02) VALUE 04.
           05 WS-DIFF-OPS-D             PIC 9(02) VALUE 04.
           05 WS-DEGREE-BOUND           PIC 9(02) VALUE 06.
           05 WS-BLOCK-SEP-FLAG         PIC 9(01) VALUE 1.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-ORDER-VITALITY         PIC 9(09) VALUE 0.
           05 WS-BLOCK-COHERENCE        PIC 9(09) VALUE 0.
           05 WS-ORDER-REBAR-LATCH      PIC 9(12) VALUE 0.
           05 WS-SHADOW-ORDER-BASE      PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 INVALID-POLY-VARS           VALUE 2.
              88 INVALID-DIFF-OPS            VALUE 3.
              88 INVALID-DEGREE-BOUND        VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 BLOCK-SEP-FLAG-FAIL         VALUE 6.
              88 ORDER-DIVERG-FAIL           VALUE 7.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 8.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-BLOCK-ORDER
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-POLY-VARS-L < 1 OR WS-POLY-VARS-L > 16
                SET INVALID-POLY-VARS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-DIFF-OPS-D < 1 OR WS-DIFF-OPS-D > 16
                SET INVALID-DIFF-OPS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-DEGREE-BOUND < 1 OR WS-DEGREE-BOUND > 32
                SET INVALID-DEGREE-BOUND TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-BLOCK-SEP-FLAG NOT EQUAL 1
                SET BLOCK-SEP-FLAG-FAIL TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-BLOCK-ORDER.
            COMPUTE WS-ORDER-VITALITY = (WS-POLY-VARS-L * 512) +
                                        (WS-DIFF-OPS-D * 256) +
                                        (WS-DEGREE-BOUND * 64) +
                                        (WS-BLOCK-SEP-FLAG * 128) + 1.

            IF WS-ORDER-VITALITY EQUAL ZERO
                SET ORDER-DIVERG-FAIL TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-BLOCK-COHERENCE = (WS-DIFF-OPS-D * 32) +
                                         (WS-POLY-VARS-L * 64) +
                                         (WS-DEGREE-BOUND * 16).

            COMPUTE WS-ORDER-REBAR-LATCH = 1470169088 + (WS-POLY-VARS-L * 256) +
                                           (WS-DIFF-OPS-D * 64) +
                                           (WS-DEGREE-BOUND * 8).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-ORDER-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                           (WS-ORDER-VITALITY * 10) +
                                           (WS-BLOCK-COHERENCE * 10) +
                                           (WS-POLY-VARS-L * 1000) +
                                           (WS-ORDER-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-ORDER-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-ORDER-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
