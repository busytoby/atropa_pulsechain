        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-ZKSAT-CIRCUIT.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-ZKSAT-CIRCUIT-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1506-ZKSAT-OK          PIC 9(01) VALUE 1.
            05  WS-TH1507-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1508-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1509-1510M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1510-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-ZKSAT-CIRCUIT-WIT        PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-ZKSAT-CIRCUIT.
            GOBACK.
        1000-EVALUATE-ZKSAT-CIRCUIT.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1506-ZKSAT-OK = 1 AND
               WS-TH1507-DATBIN-STRAT-OK = 1 AND
               WS-TH1508-SUBMICRO-LAT-OK = 1 AND
               WS-TH1509-1510M-SAAT-OK = 1 AND
               WS-TH1510-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-ZKSAT-CIRCUIT-WIT
            ELSE
                MOVE 0 TO WS-ZKSAT-CIRCUIT-WIT.
