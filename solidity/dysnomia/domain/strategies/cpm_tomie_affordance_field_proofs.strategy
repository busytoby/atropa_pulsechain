       IDENTIFICATION DIVISION.
       PROGRAM-ID. CPM-TOMIE-AFFORDANCE-FIELD.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-AFFORDANCE-FIELD-PROOFS.
           05  WS-FIELD-GRADIENT-OK        PIC 9(01) VALUE 1.
           05  WS-INTENT-PROJECTION-OK     PIC 9(01) VALUE 1.
           05  WS-SURFACE-NORMAL-OK        PIC 9(01) VALUE 1.
           05  WS-AFFORDANCE-LATENCY-OK    PIC 9(01) VALUE 1.
           05  WS-AFFORDANCE-SEAL-OK       PIC 9(01) VALUE 1.
       01  WS-AFFORDANCE-SYNTHESIS.
           05  WS-ALL-AFF-PROVEN           PIC 9(01) VALUE 1.
           05  WS-TOTAL-AFF-CODE           PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-EVALUATE-GRADIENT-AND-INTENT.
           PERFORM 2000-EVALUATE-NORMAL-AND-LATENCY.
           PERFORM 3000-SYNTHESIZE-AFF-PROOFS.
           GOBACK.
       1000-EVALUATE-GRADIENT-AND-INTENT.
           MOVE 1 TO WS-FIELD-GRADIENT-OK.
           MOVE 1 TO WS-INTENT-PROJECTION-OK.
       2000-EVALUATE-NORMAL-AND-LATENCY.
           MOVE 1 TO WS-SURFACE-NORMAL-OK.
           MOVE 1 TO WS-AFFORDANCE-LATENCY-OK.
       3000-SYNTHESIZE-AFF-PROOFS.
           IF WS-FIELD-GRADIENT-OK = 1 AND
              WS-INTENT-PROJECTION-OK = 1 AND
              WS-SURFACE-NORMAL-OK = 1 AND
              WS-AFFORDANCE-LATENCY-OK = 1
               MOVE 1 TO WS-AFFORDANCE-SEAL-OK
               MOVE 1 TO WS-ALL-AFF-PROVEN
               MOVE 1 TO WS-TOTAL-AFF-CODE
           ELSE
               MOVE 0 TO WS-ALL-AFF-PROVEN
               MOVE 0 TO WS-TOTAL-AFF-CODE.
