       IDENTIFICATION DIVISION.
       PROGRAM-ID. EDO22-PLAY-BY-EAR-STRATEGY.
       AUTHOR. AUNCIENT DYSNOMIA VM / EDO-22 PLAY BY EAR.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-EAR-PARAMETERS.
          05 WS-INPUT-FREQ-HZ          PIC 9(05) VALUE 00440.
          05 WS-REFERENCE-F0-HZ        PIC 9(04) VALUE 0440.
          05 WS-SYNTHESIS-CYCLES-N     PIC 9(02) VALUE 16.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-RAW-STEP-INDEX         PIC 9(06) VALUE 0.
          05 WS-RESOLVED-K-STEP        PIC 9(02) VALUE 0.
          05 WS-PHASE-ERR-RESIDUE      PIC 9(06) VALUE 0.
          05 WS-STEP-IDX               PIC 9(02) VALUE 0.
          05 WS-SYNTH-CHANNEL-FREQ     PIC 9(06) VALUE 0.
          05 WS-SHADOW-EAR-BASE        PIC 9(12) VALUE 0.
          05 WS-CYC-MOD                PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-INPUT-FREQ          VALUE 2.
             88 INVALID-REF-F0              VALUE 3.
             88 INVALID-SYNTHESIS-CYCLES    VALUE 4.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
             88 QUANTIZATION-FAIL           VALUE 6.
             88 GATING-CLAMP-OVERFLOW       VALUE 7.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 8.
             88 CASCADE-ROLLBACK-FAIL       VALUE 9.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-PLAY-BY-EAR
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-INPUT-FREQ-HZ < 20 OR WS-INPUT-FREQ-HZ > 20000
               SET INVALID-INPUT-FREQ TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-REFERENCE-F0-HZ < 100 OR WS-REFERENCE-F0-HZ > 1000
               SET INVALID-REF-F0 TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SYNTHESIS-CYCLES-N < 1 OR WS-SYNTHESIS-CYCLES-N > 64
               SET INVALID-SYNTHESIS-CYCLES TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-PLAY-BY-EAR.
           COMPUTE WS-RAW-STEP-INDEX = (WS-INPUT-FREQ-HZ * 22) / WS-REFERENCE-F0-HZ.
           COMPUTE WS-RESOLVED-K-STEP = FUNCTION MOD(WS-RAW-STEP-INDEX, 22).

           IF WS-RESOLVED-K-STEP > 21
               SET QUANTIZATION-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-INPUT-FREQ-HZ >= WS-REFERENCE-F0-HZ
               COMPUTE WS-PHASE-ERR-RESIDUE = (WS-INPUT-FREQ-HZ - WS-REFERENCE-F0-HZ) * 10
           ELSE
               COMPUTE WS-PHASE-ERR-RESIDUE = (WS-REFERENCE-F0-HZ - WS-INPUT-FREQ-HZ) * 10
           END-IF.

           PERFORM VARYING WS-STEP-IDX FROM 1 BY 1 UNTIL WS-STEP-IDX > WS-SYNTHESIS-CYCLES-N
               COMPUTE WS-PHASE-ERR-RESIDUE = (WS-PHASE-ERR-RESIDUE * 875) / 1000
           END-PERFORM.

           COMPUTE WS-SYNTH-CHANNEL-FREQ = WS-REFERENCE-F0-HZ + ((WS-REFERENCE-F0-HZ * WS-RESOLVED-K-STEP) / 22).

           COMPUTE WS-SHADOW-EAR-BASE = (WS-CICS-WRITER-ID * 1000000) + 
               (WS-RESOLVED-K-STEP * 10000) + (WS-SYNTH-CHANNEL-FREQ * 10) + WS-PHASE-ERR-RESIDUE.

           COMPUTE WS-CYC-MOD = FUNCTION MOD(WS-RESOLVED-K-STEP, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-CYC-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-EAR-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-EAR-BASE + ((WS-SYNTH-CHANNEL-FREQ * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-EAR-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-RESOLVED-K-STEP * 10000) + (WS-SYNTH-CHANNEL-FREQ * 10) + WS-PHASE-ERR-RESIDUE)
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-EAR-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
