        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-DIGITAL-TWIN.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-DIGITAL-TWIN-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH456-TWIN-SYNC-OK       PIC 9(01) VALUE 1.
            05  WS-TH457-TRI-AST-OK         PIC 9(01) VALUE 1.
            05  WS-TH458-SEU-SCRUB-OK       PIC 9(01) VALUE 1.
            05  WS-TH459-TWIN-SAAT-OK       PIC 9(01) VALUE 1.
            05  WS-TH460-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-DIGITAL-TWIN-WIT    PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-DIGITAL-TWIN.
            GOBACK.
        1000-EVALUATE-DIGITAL-TWIN.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH456-TWIN-SYNC-OK = 1 AND
               WS-TH457-TRI-AST-OK = 1 AND
               WS-TH458-SEU-SCRUB-OK = 1 AND
               WS-TH459-TWIN-SAAT-OK = 1 AND
               WS-TH460-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-DIGITAL-TWIN-WIT
            ELSE
                MOVE 0 TO WS-FPGA-DIGITAL-TWIN-WIT.
