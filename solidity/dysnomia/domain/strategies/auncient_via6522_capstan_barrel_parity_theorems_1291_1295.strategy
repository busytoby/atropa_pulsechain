        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-VCP-BARREL.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-VCP-BARREL-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1291-VCP-OK            PIC 9(01) VALUE 1.
            05  WS-TH1292-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1293-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1294-1295M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1295-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-VCP-BARREL-WIT           PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-VCP-BARREL.
            GOBACK.
        1000-EVALUATE-VCP-BARREL.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1291-VCP-OK = 1 AND
               WS-TH1292-DATBIN-STRAT-OK = 1 AND
               WS-TH1293-SUBMICRO-LAT-OK = 1 AND
               WS-TH1294-1295M-SAAT-OK = 1 AND
               WS-TH1295-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-VCP-BARREL-WIT
            ELSE
                MOVE 0 TO WS-VCP-BARREL-WIT.
