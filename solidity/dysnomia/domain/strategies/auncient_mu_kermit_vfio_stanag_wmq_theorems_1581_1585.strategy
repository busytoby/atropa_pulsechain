        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-KERMIT-WMQ.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-KERMIT-WMQ-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1581-KERMIT-OK         PIC 9(01) VALUE 1.
            05  WS-TH1582-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1583-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1584-1585M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1585-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-KERMIT-WMQ-WIT           PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-KERMIT-WMQ.
            GOBACK.
        1000-EVALUATE-KERMIT-WMQ.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1581-KERMIT-OK = 1 AND
               WS-TH1582-DATBIN-STRAT-OK = 1 AND
               WS-TH1583-SUBMICRO-LAT-OK = 1 AND
               WS-TH1584-1585M-SAAT-OK = 1 AND
               WS-TH1585-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-KERMIT-WMQ-WIT
            ELSE
                MOVE 0 TO WS-KERMIT-WMQ-WIT.
