        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-BEYOND-950.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-BEYOND-950-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH951-LINKER-OK          PIC 9(01) VALUE 1.
            05  WS-TH952-SYM-MERKLE-OK      PIC 9(01) VALUE 1.
            05  WS-TH953-LINK-LAT-OK        PIC 9(01) VALUE 1.
            05  WS-TH954-955M-SAAT-OK       PIC 9(01) VALUE 1.
            05  WS-TH955-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-BEYOND-950-WIT      PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-BEYOND-950.
            GOBACK.
        1000-EVALUATE-BEYOND-950.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH951-LINKER-OK = 1 AND
               WS-TH952-SYM-MERKLE-OK = 1 AND
               WS-TH953-LINK-LAT-OK = 1 AND
               WS-TH954-955M-SAAT-OK = 1 AND
               WS-TH955-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-BEYOND-950-WIT
            ELSE
                MOVE 0 TO WS-FPGA-BEYOND-950-WIT.
