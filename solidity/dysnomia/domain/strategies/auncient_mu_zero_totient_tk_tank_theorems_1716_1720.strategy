        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-ZTK-TANK.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-ZTK-TANK-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1716-ZTK-TANK-OK       PIC 9(01) VALUE 1.
            05  WS-TH1717-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1718-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1719-1720M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1720-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-ZTK-TANK-WIT             PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-ZTK-TANK.
            GOBACK.
        1000-EVALUATE-ZTK-TANK.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1716-ZTK-TANK-OK = 1 AND
               WS-TH1717-DATBIN-STRAT-OK = 1 AND
               WS-TH1718-SUBMICRO-LAT-OK = 1 AND
               WS-TH1719-1720M-SAAT-OK = 1 AND
               WS-TH1720-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-ZTK-TANK-WIT
            ELSE
                MOVE 0 TO WS-ZTK-TANK-WIT.
