        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-GRAND-SESQUI.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-GRAND-SESQUI-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1196-GRAND-OK          PIC 9(01) VALUE 1.
            05  WS-TH1197-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1198-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1199-1200M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1200-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-GRAND-SESQUI-WIT         PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-GRAND-SESQUI.
            GOBACK.
        1000-EVALUATE-GRAND-SESQUI.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1196-GRAND-OK = 1 AND
               WS-TH1197-DATBIN-STRAT-OK = 1 AND
               WS-TH1198-SUBMICRO-LAT-OK = 1 AND
               WS-TH1199-1200M-SAAT-OK = 1 AND
               WS-TH1200-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-GRAND-SESQUI-WIT
            ELSE
                MOVE 0 TO WS-GRAND-SESQUI-WIT.
