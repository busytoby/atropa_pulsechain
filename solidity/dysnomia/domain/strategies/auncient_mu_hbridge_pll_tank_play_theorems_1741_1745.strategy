        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-HBRIDGE-PLL.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-HBRIDGE-PLL-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1741-HBRIDGE-PLL-OK    PIC 9(01) VALUE 1.
            05  WS-TH1742-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1743-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1744-1745M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1745-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-HBRIDGE-PLL-WIT          PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-HBRIDGE-PLL.
            GOBACK.
        1000-EVALUATE-HBRIDGE-PLL.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1741-HBRIDGE-PLL-OK = 1 AND
               WS-TH1742-DATBIN-STRAT-OK = 1 AND
               WS-TH1743-SUBMICRO-LAT-OK = 1 AND
               WS-TH1744-1745M-SAAT-OK = 1 AND
               WS-TH1745-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-HBRIDGE-PLL-WIT
            ELSE
                MOVE 0 TO WS-HBRIDGE-PLL-WIT.
