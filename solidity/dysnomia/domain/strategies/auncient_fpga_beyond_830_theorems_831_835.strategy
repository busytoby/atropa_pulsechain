        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-BEYOND-830.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-BEYOND-830-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH831-THERM-ROLLBACK-OK  PIC 9(01) VALUE 1.
            05  WS-TH832-MULTI-TENANT-OK    PIC 9(01) VALUE 1.
            05  WS-TH833-CDC-LOCK-LAT-OK    PIC 9(01) VALUE 1.
            05  WS-TH834-835M-SAAT-OK       PIC 9(01) VALUE 1.
            05  WS-TH835-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-BEYOND-830-WIT      PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-BEYOND-830.
            GOBACK.
        1000-EVALUATE-BEYOND-830.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH831-THERM-ROLLBACK-OK = 1 AND
               WS-TH832-MULTI-TENANT-OK = 1 AND
               WS-TH833-CDC-LOCK-LAT-OK = 1 AND
               WS-TH834-835M-SAAT-OK = 1 AND
               WS-TH835-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-BEYOND-830-WIT
            ELSE
                MOVE 0 TO WS-FPGA-BEYOND-830-WIT.
