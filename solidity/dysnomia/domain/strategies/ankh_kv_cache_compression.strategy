       IDENTIFICATION DIVISION.
       PROGRAM-ID. ANKH-KV-COMPRESSION.
       AUTHOR. AUNCIENT DYSNOMIA VM / ANKH KV CACHE.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-KV-PARAMS.
          05 WS-INIT-ENTROPY-UNITS     PIC 9(05) VALUE 25000.
          05 WS-CONTEXT-TOKENS         PIC 9(05) VALUE 16384.
          05 WS-COMPRESSION-CYCLES-N   PIC 9(02) VALUE 16.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-CURRENT-ENTROPY        PIC 9(05) VALUE 0.
          05 WS-STEP-IDX               PIC 9(02) VALUE 0.
          05 WS-CTX-MOD                PIC 9(03) VALUE 0.
          05 WS-SHADOW-KV-BASE         PIC 9(12) VALUE 0.
          05 WS-CYC-MOD                PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-KV-ENTROPY          VALUE 2.
             88 INVALID-CONTEXT-TOKENS      VALUE 3.
             88 INVALID-COMPRESSION-CYCLES  VALUE 4.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
             88 KV-ENTROPY-DIVERG-FAIL      VALUE 6.
             88 GATING-CLAMP-OVERFLOW       VALUE 7.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 8.
             88 CASCADE-ROLLBACK-FAIL       VALUE 9.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-KV-COMPRESSION
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-INIT-ENTROPY-UNITS > 50000
               SET INVALID-KV-ENTROPY TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CONTEXT-TOKENS < 1 OR WS-CONTEXT-TOKENS > 32768
               SET INVALID-CONTEXT-TOKENS TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-COMPRESSION-CYCLES-N < 1 OR WS-COMPRESSION-CYCLES-N > 64
               SET INVALID-COMPRESSION-CYCLES TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-KV-COMPRESSION.
           MOVE WS-INIT-ENTROPY-UNITS TO WS-CURRENT-ENTROPY.

           PERFORM VARYING WS-STEP-IDX FROM 1 BY 1 UNTIL WS-STEP-IDX > WS-COMPRESSION-CYCLES-N
               COMPUTE WS-CURRENT-ENTROPY = (WS-CURRENT-ENTROPY * 875) / 1000
           END-PERFORM.

           IF WS-CURRENT-ENTROPY > WS-INIT-ENTROPY-UNITS
               SET KV-ENTROPY-DIVERG-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-CTX-MOD = FUNCTION MOD(WS-CONTEXT-TOKENS, 100).

           COMPUTE WS-SHADOW-KV-BASE = (WS-CICS-WRITER-ID * 1000000) + 
               (WS-COMPRESSION-CYCLES-N * 10000) + (WS-CTX-MOD * 10) + (WS-CURRENT-ENTROPY / 16).

           COMPUTE WS-CYC-MOD = FUNCTION MOD(WS-COMPRESSION-CYCLES-N, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-CYC-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-KV-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-KV-BASE + ((WS-CURRENT-ENTROPY * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-KV-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-COMPRESSION-CYCLES-N * 10000) + (WS-CTX-MOD * 10) + (WS-CURRENT-ENTROPY / 16))
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-KV-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
