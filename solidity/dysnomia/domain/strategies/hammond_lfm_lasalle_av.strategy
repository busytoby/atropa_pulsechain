        IDENTIFICATION DIVISION.
        PROGRAM-ID. HAMMOND-LFM-LASALLE-AV-STRATEGY.
        AUTHOR. AUNCIENT DYSNOMIA VM / HAMMOND AV AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-HAMMOND-PARAMETERS.
           05 WS-UPPER-DRAWBARS         PIC 9(02) VALUE 45.
           05 WS-LOWER-DRAWBARS         PIC 9(02) VALUE 32.
           05 WS-KEYBED-VELOCITY-Q16    PIC 9(06) VALUE 032768.
           05 WS-PEDAL-DRAWBAR          PIC 9(01) VALUE 6.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-DAMPED-KEY-VELOCITY    PIC 9(06) VALUE 0.
           05 WS-CONTINUOUS-PHASE-ODE   PIC 9(09) VALUE 0.
           05 WS-HARMONIC-TOTIENT-RES   PIC 9(09) VALUE 0.
           05 WS-AV-LATCH-OUT           PIC 9(12) VALUE 0.
           05 WS-SHADOW-HAMMOND-BASE    PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 INVALID-UPPER-DRAWBARS      VALUE 2.
              88 INVALID-LOWER-DRAWBARS      VALUE 3.
              88 INVALID-PEDAL-DRAWBAR       VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 KEYBED-VELOCITY-OVERFLOW    VALUE 6.
              88 HARMONIC-CLIP-DETECTED      VALUE 7.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 8.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-HAMMOND-AV
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-UPPER-DRAWBARS > 72
                SET INVALID-UPPER-DRAWBARS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-LOWER-DRAWBARS > 72
                SET INVALID-LOWER-DRAWBARS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-PEDAL-DRAWBAR > 8
                SET INVALID-PEDAL-DRAWBAR TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-KEYBED-VELOCITY-Q16 > 65536
                SET KEYBED-VELOCITY-OVERFLOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-HAMMOND-AV.
            COMPUTE WS-DAMPED-KEY-VELOCITY = (WS-KEYBED-VELOCITY-Q16 * 875) / 1000.
            COMPUTE WS-CONTINUOUS-PHASE-ODE = (WS-UPPER-DRAWBARS * 1024) +
                                              (WS-LOWER-DRAWBARS * 512) +
                                              (WS-PEDAL-DRAWBAR * 2048) + 1.

            IF WS-CONTINUOUS-PHASE-ODE > 200000
                SET HARMONIC-CLIP-DETECTED TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-HARMONIC-TOTIENT-RES = FUNCTION MOD(WS-CONTINUOUS-PHASE-ODE * 7, 953467).
            COMPUTE WS-AV-LATCH-OUT = 1470169088 + (WS-UPPER-DRAWBARS * 64) + (WS-LOWER-DRAWBARS * 16) + WS-PEDAL-DRAWBAR.

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-HAMMOND-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                             (WS-CONTINUOUS-PHASE-ODE * 10) +
                                             (WS-DAMPED-KEY-VELOCITY / 10) +
                                             (WS-AV-LATCH-OUT / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-HAMMOND-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-HAMMOND-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
