        IDENTIFICATION DIVISION.
        PROGRAM-ID. TMD-DEC-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / TEMPORAL MEMORY DECAY AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-TMD-PARAMS.
           05 WS-RETENTION-RATE-M       PIC 9(04) VALUE 0960.
           05 WS-RECALL-LAT-MS          PIC 9(02) VALUE 20.
           05 WS-NOSTALGIC-PROB-M       PIC 9(04) VALUE 0900.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-TMD-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-TMD-VITALITY           PIC 9(09) VALUE 0.
           05 WS-TMD-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-TMD-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-TMD-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 RETENTION-RATE-LOW          VALUE 2.
              88 RECALL-LAT-OUT-OF-BOUNDS    VALUE 3.
              88 NOSTALGIC-PROB-OUT-OF-BOUND VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 RETENTION-COLLAPSE          VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-TEMPORAL-DECAY
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-RETENTION-RATE-M < 850 OR WS-RETENTION-RATE-M > 1000
                SET RETENTION-RATE-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-RECALL-LAT-MS < 10 OR WS-RECALL-LAT-MS > 50
                SET RECALL-LAT-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-NOSTALGIC-PROB-M < 850 OR WS-NOSTALGIC-PROB-M > 950
                SET NOSTALGIC-PROB-OUT-OF-BOUND TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-TEMPORAL-DECAY.
            COMPUTE WS-TMD-COMPOSITE = (WS-RETENTION-RATE-M / 2) +
                                       ((60 - WS-RECALL-LAT-MS) * 10) +
                                       (WS-NOSTALGIC-PROB-M / 2).

            COMPUTE WS-TMD-VITALITY = (WS-TMD-COMPOSITE / 4) +
                                      (WS-RETENTION-RATE-M / 4) +
                                      ((60 - WS-RECALL-LAT-MS) * 4) + 1.

            IF WS-TMD-VITALITY EQUAL ZERO
                SET RETENTION-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-TMD-COHERENCE = (WS-TMD-COMPOSITE / 16) +
                                       (WS-RETENTION-RATE-M / 16) +
                                       ((60 - WS-RECALL-LAT-MS) * 2).

            COMPUTE WS-TMD-REBAR-LATCH = 1470169088 +
                                         (WS-TMD-COMPOSITE / 2) +
                                         ((60 - WS-RECALL-LAT-MS) * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-TMD-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-TMD-VITALITY * 10) +
                                         (WS-TMD-COHERENCE * 10) +
                                         (WS-TMD-COMPOSITE * 10) +
                                         (WS-TMD-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-TMD-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-TMD-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
