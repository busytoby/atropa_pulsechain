        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-SDK-LANDAUER.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-LANDAUER-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1231-LAND-OK           PIC 9(01) VALUE 1.
            05  WS-TH1232-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1233-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1234-1235M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1235-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-LANDAUER-WIT             PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-LANDAUER.
            GOBACK.
        1000-EVALUATE-LANDAUER.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1231-LAND-OK = 1 AND
               WS-TH1232-DATBIN-STRAT-OK = 1 AND
               WS-TH1233-SUBMICRO-LAT-OK = 1 AND
               WS-TH1234-1235M-SAAT-OK = 1 AND
               WS-TH1235-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-LANDAUER-WIT
            ELSE
                MOVE 0 TO WS-LANDAUER-WIT.
