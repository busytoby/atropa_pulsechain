        IDENTIFICATION DIVISION.
        PROGRAM-ID. SWIGLU-ACT-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / SWIGLU GATING AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-SWIGLU-PARAMS.
           05 WS-MODEL-DIM              PIC 9(05) VALUE 04096.
           05 WS-FFN-DIM                PIC 9(05) VALUE 14336.
           05 WS-BETA-PARAM             PIC 9(04) VALUE 1000.
           05 WS-EXACT-FLAG             PIC 9(01) VALUE 1.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-FFN-RATIO              PIC 9(06) VALUE 0.
           05 WS-SWIGLU-VITALITY        PIC 9(09) VALUE 0.
           05 WS-SWIGLU-COHERENCE       PIC 9(09) VALUE 0.
           05 WS-SWIGLU-REBAR-LATCH     PIC 9(12) VALUE 0.
           05 WS-SHADOW-SWIGLU-BASE     PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 INVALID-MODEL-DIM           VALUE 2.
              88 INVALID-FFN-DIM             VALUE 3.
              88 INVALID-BETA-PARAM          VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 SWIGLU-EXACTNESS-FLAG-FAIL  VALUE 6.
              88 SWIGLU-RATIO-INVALID        VALUE 7.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 8.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-SWIGLU-GATING
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-MODEL-DIM < 256 OR WS-MODEL-DIM > 8192
                SET INVALID-MODEL-DIM TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-FFN-DIM < 512 OR WS-FFN-DIM > 32768
                SET INVALID-FFN-DIM TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-BETA-PARAM < 500 OR WS-BETA-PARAM > 2000
                SET INVALID-BETA-PARAM TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-EXACT-FLAG NOT EQUAL 1
                SET SWIGLU-EXACTNESS-FLAG-FAIL TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-FFN-DIM < (2 * WS-MODEL-DIM)
                SET SWIGLU-RATIO-INVALID TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-FFN-RATIO = (WS-FFN-DIM * 1000) / WS-MODEL-DIM.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-SWIGLU-GATING.
            COMPUTE WS-SWIGLU-VITALITY = (WS-FFN-RATIO / 4) +
                                         (WS-MODEL-DIM / 8) +
                                         (WS-FFN-DIM / 32) +
                                         (WS-BETA-PARAM / 8) + 1.

            IF WS-SWIGLU-VITALITY EQUAL ZERO
                SET SWIGLU-RATIO-INVALID TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-SWIGLU-COHERENCE = (WS-FFN-RATIO / 16) +
                                          (WS-MODEL-DIM / 32) +
                                          (WS-FFN-DIM / 128) +
                                          (WS-BETA-PARAM / 32).

            COMPUTE WS-SWIGLU-REBAR-LATCH = 1470169088 +
                                            (WS-FFN-RATIO / 2) +
                                            (WS-MODEL-DIM / 4) +
                                            (WS-FFN-DIM / 16).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-SWIGLU-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                            (WS-SWIGLU-VITALITY * 10) +
                                            (WS-SWIGLU-COHERENCE * 10) +
                                            (WS-FFN-RATIO * 10) +
                                            (WS-SWIGLU-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-SWIGLU-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-SWIGLU-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
