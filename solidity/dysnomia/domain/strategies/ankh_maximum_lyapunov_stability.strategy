       IDENTIFICATION DIVISION.
       PROGRAM-ID. ANKH-MAX-LYAPUNOV-STRATEGY.
       AUTHOR. AUNCIENT DYSNOMIA VM / MAX LYAPUNOV STABILITY.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-SUBSYSTEM-ENERGIES.
          05 WS-V-WMQ-INITIAL          PIC 9(09) VALUE 000010000.
          05 WS-V-ABI-INITIAL          PIC 9(09) VALUE 000010000.
          05 WS-V-TOTIENT-INITIAL      PIC 9(09) VALUE 000010000.
          05 WS-V-ALU-INITIAL          PIC 9(09) VALUE 000010000.
          05 WS-V-PBX-INITIAL          PIC 9(09) VALUE 000010000.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-V-TOTAL-INITIAL        PIC 9(09) VALUE 0.
          05 WS-V-WMQ-CONTRACTED       PIC 9(09) VALUE 0.
          05 WS-V-ABI-CONTRACTED       PIC 9(09) VALUE 0.
          05 WS-V-TOTIENT-CONTRACTED   PIC 9(09) VALUE 0.
          05 WS-V-ALU-CONTRACTED       PIC 9(09) VALUE 0.
          05 WS-V-PBX-CONTRACTED       PIC 9(09) VALUE 0.
          05 WS-V-TOTAL-CONTRACTED     PIC 9(09) VALUE 0.
          05 WS-V-TOTAL-BOUND          PIC 9(09) VALUE 0.
          05 WS-SHADOW-GLOBAL-BASE     PIC 9(12) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-SUBSYSTEM-ENERGY    VALUE 2.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 3.
             88 GLOBAL-CONTRACTION-FAIL     VALUE 4.
             88 SUBSYSTEM-DISPERSION-FAIL   VALUE 5.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 6.
             88 CASCADE-ROLLBACK-FAIL       VALUE 7.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-MAX-LYAPUNOV
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-V-WMQ-INITIAL EQUAL ZERO OR WS-V-ABI-INITIAL EQUAL ZERO OR
              WS-V-TOTIENT-INITIAL EQUAL ZERO OR WS-V-ALU-INITIAL EQUAL ZERO OR
              WS-V-PBX-INITIAL EQUAL ZERO
               SET INVALID-SUBSYSTEM-ENERGY TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-MAX-LYAPUNOV.
           COMPUTE WS-V-TOTAL-INITIAL = WS-V-WMQ-INITIAL + WS-V-ABI-INITIAL + 
               WS-V-TOTIENT-INITIAL + WS-V-ALU-INITIAL + WS-V-PBX-INITIAL.

           COMPUTE WS-V-WMQ-CONTRACTED = (WS-V-WMQ-INITIAL * 875) / 1000.
           COMPUTE WS-V-ABI-CONTRACTED = (WS-V-ABI-INITIAL * 875) / 1000.
           COMPUTE WS-V-TOTIENT-CONTRACTED = (WS-V-TOTIENT-INITIAL * 875) / 1000.
           COMPUTE WS-V-ALU-CONTRACTED = (WS-V-ALU-INITIAL * 875) / 1000.
           COMPUTE WS-V-PBX-CONTRACTED = (WS-V-PBX-INITIAL * 875) / 1000.

           COMPUTE WS-V-TOTAL-CONTRACTED = WS-V-WMQ-CONTRACTED + WS-V-ABI-CONTRACTED + 
               WS-V-TOTIENT-CONTRACTED + WS-V-ALU-CONTRACTED + WS-V-PBX-CONTRACTED.

           COMPUTE WS-V-TOTAL-BOUND = (WS-V-TOTAL-INITIAL * 875) / 1000.

           IF WS-V-TOTAL-CONTRACTED > WS-V-TOTAL-BOUND
               SET GLOBAL-CONTRACTION-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-V-WMQ-CONTRACTED > WS-V-WMQ-INITIAL OR
              WS-V-ABI-CONTRACTED > WS-V-ABI-INITIAL OR
              WS-V-TOTIENT-CONTRACTED > WS-V-TOTIENT-INITIAL OR
              WS-V-ALU-CONTRACTED > WS-V-ALU-INITIAL OR
              WS-V-PBX-CONTRACTED > WS-V-PBX-INITIAL
               SET SUBSYSTEM-DISPERSION-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-SHADOW-GLOBAL-BASE = (WS-CICS-WRITER-ID * 1000000) + (WS-V-TOTAL-INITIAL / 16).

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-GLOBAL-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-GLOBAL-BASE + WS-V-TOTAL-CONTRACTED
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-GLOBAL-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-V-TOTAL-INITIAL / 16))
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-GLOBAL-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
