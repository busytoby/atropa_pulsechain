IDENTIFICATION DIVISION.
PROGRAM-ID. PROG-HARVARD-ZUO-SENSING-PIN.

DATA DIVISION.
01 D0-SUBSTRATE-TRUNK.
   05 D0-MOTZKIN-PRIME     PIC 9(9) USAGE R0.
   05 D0-K-EXPONENT        PIC 9(9) USAGE R1.
   05 D0-PIN-FAULT-FLAG    PIC 9(9) USAGE R2.
01 D1-PIN-SHADOW.
   05 D1-INPUT-PUNCH-MASK  PIC 9(9) USAGE R3.
   05 D1-SHADOW-PIN-SNAP   PIC 9(9) USAGE R4.
01 D2-PIN-STAGE.
   05 D2-PIN-P0            PIC 9(1) USAGE R5.
   05 D2-PIN-P1            PIC 9(1) USAGE R6.
   05 D2-PIN-P2            PIC 9(1) USAGE R7.
   05 D2-PIN-P3            PIC 9(1) USAGE R8.
   05 D2-PIN-P4            PIC 9(1) USAGE R9.
   05 D2-RECONSTRUCTED-MASK PIC 9(9) USAGE R10.
   05 D2-G-SWIGLU-GATE     PIC 9(9) USAGE R11.
   05 D2-COMMITTED-STATE   PIC 9(9) USAGE R12.
01 D3-LEAF-EVAL.
   05 D3-PROOF-RULING      PIC 9(9) USAGE R13.
   05 D3-DISP-WRAP-MOD     PIC 9(9) USAGE R14.

PROCEDURE DIVISION.
    MOVE 953467954 TO D0-MOTZKIN-PRIME.
    MOVE 3 TO D0-K-EXPONENT.
    MOVE 0 TO D0-PIN-FAULT-FLAG.
    MOVE 19 TO D1-INPUT-PUNCH-MASK.

    PERFORM STAGE-PIN-EXTRACTION.
    PERFORM APPLY-PIN-LATCH.
    PERFORM SYNC-DISPLACEMENT.

    IF D1-SHADOW-PIN-SNAP == D1-INPUT-PUNCH-MASK AND D2-RECONSTRUCTED-MASK == D1-INPUT-PUNCH-MASK
        MOVE 0 TO D3-PROOF-RULING
        SET depth 4
    ELSE
        MOVE 4 TO D3-PROOF-RULING
        SET depth 1
    END-IF.

    EVAL.
    GO TO END-STRATEGY.

STAGE-PIN-EXTRACTION.
    MOVE D1-INPUT-PUNCH-MASK TO D1-SHADOW-PIN-SNAP.
    COMPUTE D2-PIN-P0 = D1-INPUT-PUNCH-MASK - ((D1-INPUT-PUNCH-MASK / 2) * 2).
    COMPUTE D2-PIN-P1 = (D1-INPUT-PUNCH-MASK / 2) - (((D1-INPUT-PUNCH-MASK / 2) / 2) * 2).
    COMPUTE D2-PIN-P2 = (D1-INPUT-PUNCH-MASK / 4) - (((D1-INPUT-PUNCH-MASK / 4) / 2) * 2).
    COMPUTE D2-PIN-P3 = (D1-INPUT-PUNCH-MASK / 8) - (((D1-INPUT-PUNCH-MASK / 8) / 2) * 2).
    COMPUTE D2-PIN-P4 = (D1-INPUT-PUNCH-MASK / 16) - (((D1-INPUT-PUNCH-MASK / 16) / 2) * 2).
    COMPUTE D2-RECONSTRUCTED-MASK = D2-PIN-P0 + (D2-PIN-P1 * 2) + (D2-PIN-P2 * 4) + (D2-PIN-P3 * 8) + (D2-PIN-P4 * 16).
    COMPUTE D2-G-SWIGLU-GATE = 875 + ((125 * D1-INPUT-PUNCH-MASK) / 31).
    EXIT.

APPLY-PIN-LATCH.
    IF D0-PIN-FAULT-FLAG == 1
        MOVE D1-SHADOW-PIN-SNAP TO D2-COMMITTED-STATE
    ELSE
        COMPUTE D2-COMMITTED-STATE = (((D1-INPUT-PUNCH-MASK * 1000 + 43605) * D2-G-SWIGLU-GATE) / 1000)
    END-IF.
    EXIT.

SYNC-DISPLACEMENT.
    COMPUTE D3-DISP-WRAP-MOD = D2-COMMITTED-STATE - ((D2-COMMITTED-STATE / 256) * 256).
    EXIT.

END-STRATEGY.
