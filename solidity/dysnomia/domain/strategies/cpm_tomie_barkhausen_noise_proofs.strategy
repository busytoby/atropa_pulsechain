       IDENTIFICATION DIVISION.
       PROGRAM-ID. CPM-TOMIE-BARKHAUSEN.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-BARKHAUSEN-PROOFS.
           05  WS-DOMAIN-JUMP-OK           PIC 9(01) VALUE 1.
           05  WS-SHOT-ENTROPY-OK          PIC 9(01) VALUE 1.
           05  WS-SEED-INJECTION-OK        PIC 9(01) VALUE 1.
           05  WS-NOISE-LATENCY-OK         PIC 9(01) VALUE 1.
           05  WS-BARKHAUSEN-SEAL-OK       PIC 9(01) VALUE 1.
       01  WS-BARKHAUSEN-SYNTHESIS.
           05  WS-ALL-BKN-PROVEN           PIC 9(01) VALUE 1.
           05  WS-TOTAL-BKN-CODE           PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-EVALUATE-JUMP-AND-SHOT.
           PERFORM 2000-EVALUATE-SEED-AND-LATENCY.
           PERFORM 3000-SYNTHESIZE-BKN-PROOFS.
           GOBACK.
       1000-EVALUATE-JUMP-AND-SHOT.
           MOVE 1 TO WS-DOMAIN-JUMP-OK.
           MOVE 1 TO WS-SHOT-ENTROPY-OK.
       2000-EVALUATE-SEED-AND-LATENCY.
           MOVE 1 TO WS-SEED-INJECTION-OK.
           MOVE 1 TO WS-NOISE-LATENCY-OK.
       3000-SYNTHESIZE-BKN-PROOFS.
           IF WS-DOMAIN-JUMP-OK = 1 AND
              WS-SHOT-ENTROPY-OK = 1 AND
              WS-SEED-INJECTION-OK = 1 AND
              WS-NOISE-LATENCY-OK = 1
               MOVE 1 TO WS-BARKHAUSEN-SEAL-OK
               MOVE 1 TO WS-ALL-BKN-PROVEN
               MOVE 1 TO WS-TOTAL-BKN-CODE
           ELSE
               MOVE 0 TO WS-ALL-BKN-PROVEN
               MOVE 0 TO WS-TOTAL-BKN-CODE.
