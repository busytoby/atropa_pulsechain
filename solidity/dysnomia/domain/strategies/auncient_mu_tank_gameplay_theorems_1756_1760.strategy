        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-GAMEPLAY.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-GAMEPLAY-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1756-GAMEPLAY-OK       PIC 9(01) VALUE 1.
            05  WS-TH1757-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1758-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1759-1760M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1760-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-GAMEPLAY-WIT             PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-GAMEPLAY.
            GOBACK.
        1000-EVALUATE-GAMEPLAY.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1756-GAMEPLAY-OK = 1 AND
               WS-TH1757-DATBIN-STRAT-OK = 1 AND
               WS-TH1758-SUBMICRO-LAT-OK = 1 AND
               WS-TH1759-1760M-SAAT-OK = 1 AND
               WS-TH1760-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-GAMEPLAY-WIT
            ELSE
                MOVE 0 TO WS-GAMEPLAY-WIT.
