        IDENTIFICATION DIVISION.
        PROGRAM-ID. UCE-EMP-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / UNPROMPTED CONTEXTUAL EMPATHY AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-UCE-PARAMS.
           05 WS-CTX-EVAL-LAT-MS        PIC 9(02) VALUE 20.
           05 WS-PROACT-CARE-PROB-M     PIC 9(04) VALUE 0900.
           05 WS-DISMISS-ACK-LAT-MS     PIC 9(02) VALUE 04.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-UCE-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-UCE-VITALITY           PIC 9(09) VALUE 0.
           05 WS-UCE-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-UCE-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-UCE-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 CTX-EVAL-OUT-OF-BOUNDS      VALUE 2.
              88 PROACT-CARE-OUT-OF-BOUNDS   VALUE 3.
              88 DISMISS-ACK-OUT-OF-BOUNDS   VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 EMPATHY-COLLAPSE            VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-CONTEXTUAL-EMPATHY
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CTX-EVAL-LAT-MS < 10 OR WS-CTX-EVAL-LAT-MS > 50
                SET CTX-EVAL-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-PROACT-CARE-PROB-M < 850 OR WS-PROACT-CARE-PROB-M > 950
                SET PROACT-CARE-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-DISMISS-ACK-LAT-MS < 1 OR WS-DISMISS-ACK-LAT-MS > 10
                SET DISMISS-ACK-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-CONTEXTUAL-EMPATHY.
            COMPUTE WS-UCE-COMPOSITE = ((60 - WS-CTX-EVAL-LAT-MS) * 10) +
                                       (WS-PROACT-CARE-PROB-M / 2) +
                                       ((15 - WS-DISMISS-ACK-LAT-MS) * 20).

            COMPUTE WS-UCE-VITALITY = (WS-UCE-COMPOSITE / 4) +
                                      (WS-PROACT-CARE-PROB-M / 4) +
                                      ((60 - WS-CTX-EVAL-LAT-MS) * 4) + 1.

            IF WS-UCE-VITALITY EQUAL ZERO
                SET EMPATHY-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-UCE-COHERENCE = (WS-UCE-COMPOSITE / 16) +
                                       (WS-PROACT-CARE-PROB-M / 16) +
                                       ((60 - WS-CTX-EVAL-LAT-MS) * 2).

            COMPUTE WS-UCE-REBAR-LATCH = 1470169088 +
                                         (WS-UCE-COMPOSITE / 2) +
                                         ((60 - WS-CTX-EVAL-LAT-MS) * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-UCE-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-UCE-VITALITY * 10) +
                                         (WS-UCE-COHERENCE * 10) +
                                         (WS-UCE-COMPOSITE * 10) +
                                         (WS-UCE-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-UCE-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-UCE-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
