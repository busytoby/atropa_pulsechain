        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-ACCUMULATOR.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-ACCUM-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH391-REDIRECT-OK        PIC 9(01) VALUE 1.
            05  WS-TH392-JUBILEE-ACCUM-OK   PIC 9(01) VALUE 1.
            05  WS-TH393-CONTINUITY-OK      PIC 9(01) VALUE 1.
            05  WS-TH394-ACCUM-SAAT-OK      PIC 9(01) VALUE 1.
            05  WS-TH395-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-ACCUM-WIT           PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-ACCUM.
            GOBACK.
        1000-EVALUATE-ACCUM.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH391-REDIRECT-OK = 1 AND
               WS-TH392-JUBILEE-ACCUM-OK = 1 AND
               WS-TH393-CONTINUITY-OK = 1 AND
               WS-TH394-ACCUM-SAAT-OK = 1 AND
               WS-TH395-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-ACCUM-WIT
            ELSE
                MOVE 0 TO WS-FPGA-ACCUM-WIT.
