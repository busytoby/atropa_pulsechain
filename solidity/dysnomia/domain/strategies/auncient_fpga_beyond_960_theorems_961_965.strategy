        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-BEYOND-960.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-BEYOND-960-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH961-TRAP-OK            PIC 9(01) VALUE 1.
            05  WS-TH962-FAULT-MERKLE-OK    PIC 9(01) VALUE 1.
            05  WS-TH963-TRAP-LAT-OK        PIC 9(01) VALUE 1.
            05  WS-TH964-965M-SAAT-OK       PIC 9(01) VALUE 1.
            05  WS-TH965-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-BEYOND-960-WIT      PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-BEYOND-960.
            GOBACK.
        1000-EVALUATE-BEYOND-960.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH961-TRAP-OK = 1 AND
               WS-TH962-FAULT-MERKLE-OK = 1 AND
               WS-TH963-TRAP-LAT-OK = 1 AND
               WS-TH964-965M-SAAT-OK = 1 AND
               WS-TH965-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-BEYOND-960-WIT
            ELSE
                MOVE 0 TO WS-FPGA-BEYOND-960-WIT.
