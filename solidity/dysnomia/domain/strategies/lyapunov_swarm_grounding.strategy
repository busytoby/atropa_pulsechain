       IDENTIFICATION DIVISION.
       PROGRAM-ID. LYAPUNOV-SWARM-STRATEGY.
       AUTHOR. AUNCIENT DYSNOMIA VM / SWARM GROUNDING.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-SWARM-PARAMS.
          05 WS-SWARM-COUNT-M          PIC 9(02) VALUE 08.
          05 WS-TOTAL-DIVERGENCE-E     PIC 9(05) VALUE 35000.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-PANIC         PIC X(01) VALUE 'Y'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-CURRENT-SWARM-E        PIC 9(05) VALUE 0.
          05 WS-STEP-IDX               PIC 9(02) VALUE 0.
          05 WS-SHADOW-SWARM-BASE      PIC 9(12) VALUE 0.
          05 WS-CYC-MOD                PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-SWARM-COUNT         VALUE 2.
             88 INVALID-DIVERGENCE-E        VALUE 3.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 4.
             88 SWARM-DISSIPATION-FAIL      VALUE 5.
             88 GATING-CLAMP-OVERFLOW       VALUE 6.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 7.
             88 CASCADE-ROLLBACK-FAIL       VALUE 8.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-SWARM-GROUNDING
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SWARM-COUNT-M < 2 OR WS-SWARM-COUNT-M > 16
               SET INVALID-SWARM-COUNT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-TOTAL-DIVERGENCE-E > 50000
               SET INVALID-DIVERGENCE-E TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-SWARM-GROUNDING.
           MOVE WS-TOTAL-DIVERGENCE-E TO WS-CURRENT-SWARM-E.

           PERFORM VARYING WS-STEP-IDX FROM 1 BY 1 UNTIL WS-STEP-IDX > 16
               COMPUTE WS-CURRENT-SWARM-E = (WS-CURRENT-SWARM-E * 875) / 1000
           END-PERFORM.

           IF WS-CURRENT-SWARM-E > WS-TOTAL-DIVERGENCE-E
               SET SWARM-DISSIPATION-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-SHADOW-SWARM-BASE = (WS-CICS-WRITER-ID * 1000000) + 
               (WS-SWARM-COUNT-M * 10000) + (WS-CURRENT-SWARM-E / 16).

           COMPUTE WS-CYC-MOD = FUNCTION MOD(WS-SWARM-COUNT-M, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-CYC-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-PANIC EQUAL 'Y' OR WS-TOTAL-DIVERGENCE-E > 25000
               MOVE WS-SHADOW-SWARM-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-SWARM-BASE + ((WS-CURRENT-SWARM-E * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-SWARM-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-SWARM-COUNT-M * 10000) + (WS-CURRENT-SWARM-E / 16))
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF (WS-SIMULATE-PANIC EQUAL 'Y' OR WS-TOTAL-DIVERGENCE-E > 25000) AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-SWARM-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
