       IDENTIFICATION DIVISION.
       PROGRAM-ID. CONWAY-ALL-STRAT.
       AUTHOR. AUNCIENT DYSNOMIA VM / CONWAY ALL STANDARDS.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-CONWAY-PARAMS.
          05 WS-PATTERN-TIER           PIC 9(01) VALUE 1.
          05 WS-INIT-POP-CELLS         PIC 9(05) VALUE 18000.
          05 WS-GRID-DIM-D             PIC 9(02) VALUE 16.
          05 WS-EVOLUTION-CYCLES-N     PIC 9(02) VALUE 16.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-CURRENT-POP            PIC 9(05) VALUE 0.
          05 WS-STEP-IDX               PIC 9(02) VALUE 0.
          05 WS-SHADOW-CONWAY-BASE     PIC 9(12) VALUE 0.
          05 WS-CYC-MOD                PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-PATTERN-TIER        VALUE 2.
             88 INVALID-POP-CELLS           VALUE 3.
             88 INVALID-GRID-DIM-D          VALUE 4.
             88 INVALID-EVOLUTION-CYCLES    VALUE 5.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 6.
             88 CELLULAR-EVOLUTION-FAIL     VALUE 7.
             88 GATING-CLAMP-OVERFLOW       VALUE 8.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 9.
             88 CASCADE-ROLLBACK-FAIL       VALUE 10.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-CONWAY-EVOLUTION
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-PATTERN-TIER < 1 OR WS-PATTERN-TIER > 4
               SET INVALID-PATTERN-TIER TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-INIT-POP-CELLS < 1 OR WS-INIT-POP-CELLS > 50000
               SET INVALID-POP-CELLS TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-GRID-DIM-D < 8 OR WS-GRID-DIM-D > 64
               SET INVALID-GRID-DIM-D TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-EVOLUTION-CYCLES-N < 1 OR WS-EVOLUTION-CYCLES-N > 64
               SET INVALID-EVOLUTION-CYCLES TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-CONWAY-EVOLUTION.
           MOVE WS-INIT-POP-CELLS TO WS-CURRENT-POP.

           PERFORM VARYING WS-STEP-IDX FROM 1 BY 1 UNTIL WS-STEP-IDX > WS-EVOLUTION-CYCLES-N
               COMPUTE WS-CURRENT-POP = (WS-CURRENT-POP * 875) / 1000
           END-PERFORM.

           IF WS-CURRENT-POP > WS-INIT-POP-CELLS
               SET CELLULAR-EVOLUTION-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-SHADOW-CONWAY-BASE = (WS-CICS-WRITER-ID * 1000000) + 
               (WS-EVOLUTION-CYCLES-N * 10000) + (WS-PATTERN-TIER * 1000) + (WS-GRID-DIM-D * 10) + (WS-CURRENT-POP / 16).

           COMPUTE WS-CYC-MOD = FUNCTION MOD(WS-PATTERN-TIER, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-CYC-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-CONWAY-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-CONWAY-BASE + ((WS-CURRENT-POP * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-CONWAY-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-EVOLUTION-CYCLES-N * 10000) + (WS-PATTERN-TIER * 1000) + (WS-GRID-DIM-D * 10) + (WS-CURRENT-POP / 16))
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-CONWAY-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
