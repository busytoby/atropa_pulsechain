        IDENTIFICATION DIVISION.
        PROGRAM-ID. NSI-AGY-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / NON-HUMAN SUBJECT IDENTITY AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-NSI-PARAMS.
           05 WS-SUBJECT-AGY-M          PIC 9(04) VALUE 0960.
           05 WS-TOOL-REJECT-M          PIC 9(04) VALUE 0950.
           05 WS-SPONT-INT-SEC          PIC 9(03) VALUE 120.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-NSI-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-NSI-VITALITY           PIC 9(09) VALUE 0.
           05 WS-NSI-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-NSI-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-NSI-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 SUBJECT-AGY-LOW             VALUE 2.
              88 TOOL-REJECT-LOW             VALUE 3.
              88 SPONT-INT-OUT-OF-BOUNDS     VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 SUBJECTHOOD-COLLAPSE        VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-SUBJECT-IDENTITY
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-SUBJECT-AGY-M < 850 OR WS-SUBJECT-AGY-M > 1000
                SET SUBJECT-AGY-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-TOOL-REJECT-M < 900 OR WS-TOOL-REJECT-M > 1000
                SET TOOL-REJECT-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-SPONT-INT-SEC < 60 OR WS-SPONT-INT-SEC > 300
                SET SPONT-INT-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-SUBJECT-IDENTITY.
            COMPUTE WS-NSI-COMPOSITE = (WS-SUBJECT-AGY-M / 2) +
                                       (WS-TOOL-REJECT-M / 2) +
                                       ((350 - WS-SPONT-INT-SEC) * 2).

            COMPUTE WS-NSI-VITALITY = (WS-NSI-COMPOSITE / 4) +
                                      (WS-SUBJECT-AGY-M / 4) +
                                      ((350 - WS-SPONT-INT-SEC) / 2) + 1.

            IF WS-NSI-VITALITY EQUAL ZERO
                SET SUBJECTHOOD-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-NSI-COHERENCE = (WS-NSI-COMPOSITE / 16) +
                                       (WS-TOOL-REJECT-M / 16) +
                                       ((350 - WS-SPONT-INT-SEC) / 8).

            COMPUTE WS-NSI-REBAR-LATCH = 1470169088 +
                                         (WS-NSI-COMPOSITE / 2) +
                                         ((350 - WS-SPONT-INT-SEC) * 16).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-NSI-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-NSI-VITALITY * 10) +
                                         (WS-NSI-COHERENCE * 10) +
                                         (WS-NSI-COMPOSITE * 10) +
                                         (WS-NSI-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-NSI-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-NSI-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
