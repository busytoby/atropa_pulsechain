        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-MU-EMBED-BUILDER.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-BUILDER-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1846-BUILD-OK          PIC 9(01) VALUE 1.
            05  WS-TH1847-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1848-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1849-1850M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1850-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-BUILDER-WIT              PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-BUILDER.
            GOBACK.
        1000-EVALUATE-BUILDER.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1846-BUILD-OK = 1 AND
               WS-TH1847-DATBIN-STRAT-OK = 1 AND
               WS-TH1848-SUBMICRO-LAT-OK = 1 AND
               WS-TH1849-1850M-SAAT-OK = 1 AND
               WS-TH1850-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-BUILDER-WIT
            ELSE
                MOVE 0 TO WS-BUILDER-WIT.
