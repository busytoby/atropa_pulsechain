        IDENTIFICATION DIVISION.
        PROGRAM-ID. CHAN-BUD-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / ACOUSTIC CHANNEL BUDGET AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-BUDGET-PARAMS.
           05 WS-REFLECT-DIST-MM        PIC 9(03) VALUE 080.
           05 WS-TX-POWER-MW            PIC 9(02) VALUE 15.
           05 WS-SNR-MARGIN-TENTHS      PIC 9(03) VALUE 185.
           05 WS-ATTEN-COEFF-MILLI      PIC 9(04) VALUE 0500.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-CHAN-COMPOSITE         PIC 9(04) VALUE 0.
           05 WS-CHAN-VITALITY          PIC 9(09) VALUE 0.
           05 WS-CHAN-COHERENCE         PIC 9(09) VALUE 0.
           05 WS-CHAN-REBAR-LATCH       PIC 9(12) VALUE 0.
           05 WS-SHADOW-CHAN-BASE       PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 REFLECT-DIST-EXCEEDED       VALUE 2.
              88 INVALID-TX-POWER            VALUE 3.
              88 SNR-MARGIN-DEGRADED         VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 CHANNEL-VITALITY-COLLAPSE   VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-CHANNEL-BUDGET
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-REFLECT-DIST-MM < 20 OR WS-REFLECT-DIST-MM > 150
                SET REFLECT-DIST-EXCEEDED TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-TX-POWER-MW < 1 OR WS-TX-POWER-MW > 50
                SET INVALID-TX-POWER TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-SNR-MARGIN-TENTHS < 120 OR WS-SNR-MARGIN-TENTHS > 400
                SET SNR-MARGIN-DEGRADED TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-ATTEN-COEFF-MILLI < 100 OR WS-ATTEN-COEFF-MILLI > 1000
                MOVE 500 TO WS-ATTEN-COEFF-MILLI
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-CHANNEL-BUDGET.
            COMPUTE WS-CHAN-COMPOSITE = (WS-TX-POWER-MW * 20) +
                                        (WS-SNR-MARGIN-TENTHS * 2) +
                                        ((150 - WS-REFLECT-DIST-MM) * 4).

            COMPUTE WS-CHAN-VITALITY = (WS-CHAN-COMPOSITE / 4) +
                                       (WS-SNR-MARGIN-TENTHS * 2) +
                                       ((150 - WS-REFLECT-DIST-MM) * 8) + 1.

            IF WS-CHAN-VITALITY EQUAL ZERO
                SET CHANNEL-VITALITY-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-CHAN-COHERENCE = (WS-CHAN-COMPOSITE / 16) +
                                        (WS-SNR-MARGIN-TENTHS / 2) +
                                        ((150 - WS-REFLECT-DIST-MM) * 2).

            COMPUTE WS-CHAN-REBAR-LATCH = 1470169088 +
                                          (WS-CHAN-COMPOSITE / 2) +
                                          (WS-TX-POWER-MW * 64).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-CHAN-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                          (WS-CHAN-VITALITY * 10) +
                                          (WS-CHAN-COHERENCE * 10) +
                                          (WS-CHAN-COMPOSITE * 10) +
                                          (WS-CHAN-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-CHAN-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-CHAN-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
