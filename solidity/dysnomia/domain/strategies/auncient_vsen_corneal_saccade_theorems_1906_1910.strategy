        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-VSEN-CORNEAL.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-VSEN-CORNEAL-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1906-CORNEA-CAUST-OK   PIC 9(01) VALUE 1.
            05  WS-TH1907-PUPIL-FET-OK      PIC 9(01) VALUE 1.
            05  WS-TH1908-SACCADE-LAT-OK    PIC 9(01) VALUE 1.
            05  WS-TH1909-1910M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1910-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-VSEN-CORNEAL-WIT         PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-VSEN-CORNEAL.
            GOBACK.
        1000-EVALUATE-VSEN-CORNEAL.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1906-CORNEA-CAUST-OK = 1 AND
               WS-TH1907-PUPIL-FET-OK = 1 AND
               WS-TH1908-SACCADE-LAT-OK = 1 AND
               WS-TH1909-1910M-SAAT-OK = 1 AND
               WS-TH1910-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-VSEN-CORNEAL-WIT
            ELSE
                MOVE 0 TO WS-VSEN-CORNEAL-WIT.
