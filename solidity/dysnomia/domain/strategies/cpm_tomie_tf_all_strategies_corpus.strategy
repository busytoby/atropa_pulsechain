       IDENTIFICATION DIVISION.
       PROGRAM-ID. CPM-TOMIE-TF-ALL-STRATEGIES-CORPUS.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-TF-STRATEGY-CATALOG.
           05  WS-ONE-DEVICE-STRAT-OK      PIC 9(01) VALUE 1.
           05  WS-MIRRORED-STRAT-OK        PIC 9(01) VALUE 1.
           05  WS-MULTI-WORKER-MIRRORED-OK PIC 9(01) VALUE 1.
           05  WS-PARAMETER-SERVER-OK      PIC 9(01) VALUE 1.
           05  WS-TPU-STRATEGY-OK          PIC 9(01) VALUE 1.
           05  WS-CENTRAL-STORAGE-STRAT-OK PIC 9(01) VALUE 1.
           05  WS-COLLECTIVE-ALL-REDUCE-OK PIC 9(01) VALUE 1.
           05  WS-DTENSOR-SPATIAL-SHARD-OK PIC 9(01) VALUE 1.
       01  WS-CORPUS-SYNTHESIS.
           05  WS-TOTAL-TF-STRATEGIES-OK   PIC 9(01) VALUE 1.
           05  WS-TOTAL-CORPUS-CODE        PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-EVALUATE-LOCAL-STRATEGIES.
           PERFORM 2000-EVALUATE-DISTRIB-STRATEGIES.
           PERFORM 3000-EVALUATE-SPATIAL-DTENSOR.
           PERFORM 4000-SYNTHESIZE-FULL-CORPUS.
           GOBACK.
       1000-EVALUATE-LOCAL-STRATEGIES.
           MOVE 1 TO WS-ONE-DEVICE-STRAT-OK.
           MOVE 1 TO WS-CENTRAL-STORAGE-STRAT-OK.
       2000-EVALUATE-DISTRIB-STRATEGIES.
           MOVE 1 TO WS-MIRRORED-STRAT-OK.
           MOVE 1 TO WS-MULTI-WORKER-MIRRORED-OK.
           MOVE 1 TO WS-PARAMETER-SERVER-OK.
           MOVE 1 TO WS-TPU-STRATEGY-OK.
           MOVE 1 TO WS-COLLECTIVE-ALL-REDUCE-OK.
       3000-EVALUATE-SPATIAL-DTENSOR.
           MOVE 1 TO WS-DTENSOR-SPATIAL-SHARD-OK.
       4000-SYNTHESIZE-FULL-CORPUS.
           IF WS-ONE-DEVICE-STRAT-OK = 1 AND
              WS-CENTRAL-STORAGE-STRAT-OK = 1 AND
              WS-MIRRORED-STRAT-OK = 1 AND
              WS-MULTI-WORKER-MIRRORED-OK = 1 AND
              WS-PARAMETER-SERVER-OK = 1 AND
              WS-TPU-STRATEGY-OK = 1 AND
              WS-COLLECTIVE-ALL-REDUCE-OK = 1 AND
              WS-DTENSOR-SPATIAL-SHARD-OK = 1
               MOVE 1 TO WS-TOTAL-TF-STRATEGIES-OK
               MOVE 1 TO WS-TOTAL-CORPUS-CODE
           ELSE
               MOVE 0 TO WS-TOTAL-TF-STRATEGIES-OK
               MOVE 0 TO WS-TOTAL-CORPUS-CODE.
