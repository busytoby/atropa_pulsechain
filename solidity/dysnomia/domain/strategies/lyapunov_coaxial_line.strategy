       IDENTIFICATION DIVISION.
       PROGRAM-ID. LYAPUNOV-COAX-STRATEGY.
       AUTHOR. AUNCIENT DYSNOMIA VM / COAXIAL LINE.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-COAX-PARAMS.
          05 WS-CHAR-IMPEDANCE-Z0      PIC 9(03) VALUE 050.
          05 WS-LOAD-TERMINATION-ZL    PIC 9(03) VALUE 050.
          05 WS-PROPAGATION-CYCLES-N   PIC 9(02) VALUE 16.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-REFL-ENERGY-E          PIC 9(05) VALUE 0.
          05 WS-STEP-IDX               PIC 9(02) VALUE 0.
          05 WS-SHADOW-COAX-BASE       PIC 9(12) VALUE 0.
          05 WS-CYC-MOD                PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-IMPEDANCE-Z0        VALUE 2.
             88 INVALID-LOAD-ZL             VALUE 3.
             88 INVALID-PROPAGATION-CYCLES  VALUE 4.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
             88 STANDING-WAVE-DIVERG-FAIL   VALUE 6.
             88 GATING-CLAMP-OVERFLOW       VALUE 7.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 8.
             88 CASCADE-ROLLBACK-FAIL       VALUE 9.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-TEM-DISSIPATION
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CHAR-IMPEDANCE-Z0 < 25 OR WS-CHAR-IMPEDANCE-Z0 > 300
               SET INVALID-IMPEDANCE-Z0 TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-LOAD-TERMINATION-ZL < 1 OR WS-LOAD-TERMINATION-ZL > 600
               SET INVALID-LOAD-ZL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-PROPAGATION-CYCLES-N < 1 OR WS-PROPAGATION-CYCLES-N > 64
               SET INVALID-PROPAGATION-CYCLES TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-TEM-DISSIPATION.
           IF WS-LOAD-TERMINATION-ZL >= WS-CHAR-IMPEDANCE-Z0
               COMPUTE WS-REFL-ENERGY-E = (WS-LOAD-TERMINATION-ZL - WS-CHAR-IMPEDANCE-Z0) * 100
           ELSE
               COMPUTE WS-REFL-ENERGY-E = (WS-CHAR-IMPEDANCE-Z0 - WS-LOAD-TERMINATION-ZL) * 100
           END-IF.

           IF WS-REFL-ENERGY-E > 50000 MOVE 50000 TO WS-REFL-ENERGY-E.

           PERFORM VARYING WS-STEP-IDX FROM 1 BY 1 UNTIL WS-STEP-IDX > WS-PROPAGATION-CYCLES-N
               COMPUTE WS-REFL-ENERGY-E = (WS-REFL-ENERGY-E * 875) / 1000
           END-PERFORM.

           IF WS-REFL-ENERGY-E > 50000
               SET STANDING-WAVE-DIVERG-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-SHADOW-COAX-BASE = (WS-CICS-WRITER-ID * 1000000) + 
               (WS-PROPAGATION-CYCLES-N * 10000) + (WS-CHAR-IMPEDANCE-Z0 * 100) + (WS-REFL-ENERGY-E / 16).

           COMPUTE WS-CYC-MOD = FUNCTION MOD(WS-CHAR-IMPEDANCE-Z0, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-CYC-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-COAX-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-COAX-BASE + ((WS-REFL-ENERGY-E * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-COAX-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-PROPAGATION-CYCLES-N * 10000) + (WS-CHAR-IMPEDANCE-Z0 * 100) + (WS-REFL-ENERGY-E / 16))
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-COAX-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
