        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-MUFR-BIND.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-MUFR-BIND-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1336-MUFR-OK           PIC 9(01) VALUE 1.
            05  WS-TH1337-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1338-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1339-1340M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1340-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-MUFR-BIND-WIT            PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-MUFR-BIND.
            GOBACK.
        1000-EVALUATE-MUFR-BIND.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1336-MUFR-OK = 1 AND
               WS-TH1337-DATBIN-STRAT-OK = 1 AND
               WS-TH1338-SUBMICRO-LAT-OK = 1 AND
               WS-TH1339-1340M-SAAT-OK = 1 AND
               WS-TH1340-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-MUFR-BIND-WIT
            ELSE
                MOVE 0 TO WS-MUFR-BIND-WIT.
