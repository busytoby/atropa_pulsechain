        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-SS-ACID.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-SS-ACID-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1281-SS-OK             PIC 9(01) VALUE 1.
            05  WS-TH1282-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1283-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1284-1285M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1285-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-SS-ACID-WIT              PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-SS-ACID.
            GOBACK.
        1000-EVALUATE-SS-ACID.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1281-SS-OK = 1 AND
               WS-TH1282-DATBIN-STRAT-OK = 1 AND
               WS-TH1283-SUBMICRO-LAT-OK = 1 AND
               WS-TH1284-1285M-SAAT-OK = 1 AND
               WS-TH1285-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-SS-ACID-WIT
            ELSE
                MOVE 0 TO WS-SS-ACID-WIT.
