        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-STATOR-MANIFOLD.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-STATOR-MANIFOLD-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH306-DODECAPHASE-OK     PIC 9(01) VALUE 1.
            05  WS-TH307-DAMPING-OK         PIC 9(01) VALUE 1.
            05  WS-TH308-SU2-GAUGE-OK       PIC 9(01) VALUE 1.
            05  WS-TH309-SAAT-LOSSLESS-OK   PIC 9(01) VALUE 1.
            05  WS-TH310-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-STATOR-MANIFOLD-WIT PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-STATOR-MANIFOLD.
            GOBACK.
        1000-EVALUATE-STATOR-MANIFOLD.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH306-DODECAPHASE-OK = 1 AND
               WS-TH307-DAMPING-OK = 1 AND
               WS-TH308-SU2-GAUGE-OK = 1 AND
               WS-TH309-SAAT-LOSSLESS-OK = 1 AND
               WS-TH310-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-STATOR-MANIFOLD-WIT
            ELSE
                MOVE 0 TO WS-FPGA-STATOR-MANIFOLD-WIT.
