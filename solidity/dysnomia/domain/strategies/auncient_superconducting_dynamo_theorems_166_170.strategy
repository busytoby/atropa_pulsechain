        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-SUPERCONDUCT-166-170.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-SUPERCONDUCT-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH166-ZERO-RESIST-OK     PIC 9(01) VALUE 1.
            05  WS-TH167-MEISSNER-OK        PIC 9(01) VALUE 1.
            05  WS-TH168-VORTEX-PIN-OK      PIC 9(01) VALUE 1.
            05  WS-TH169-JOSEPHSON-OK       PIC 9(01) VALUE 1.
            05  WS-TH170-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-SUPERCONDUCT-WITNESS     PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-SUPERCONDUCT.
            GOBACK.
        1000-EVALUATE-SUPERCONDUCT.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH166-ZERO-RESIST-OK = 1 AND
               WS-TH167-MEISSNER-OK = 1 AND
               WS-TH168-VORTEX-PIN-OK = 1 AND
               WS-TH169-JOSEPHSON-OK = 1 AND
               WS-TH170-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-SUPERCONDUCT-WITNESS
            ELSE
                MOVE 0 TO WS-SUPERCONDUCT-WITNESS.
