        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-MICRO-SHUF.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-MICRO-SHUF-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1256-SHUF-OK           PIC 9(01) VALUE 1.
            05  WS-TH1257-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1258-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1259-1260M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1260-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-MICRO-SHUF-WIT           PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-MICRO-SHUF.
            GOBACK.
        1000-EVALUATE-MICRO-SHUF.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1256-SHUF-OK = 1 AND
               WS-TH1257-DATBIN-STRAT-OK = 1 AND
               WS-TH1258-SUBMICRO-LAT-OK = 1 AND
               WS-TH1259-1260M-SAAT-OK = 1 AND
               WS-TH1260-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-MICRO-SHUF-WIT
            ELSE
                MOVE 0 TO WS-MICRO-SHUF-WIT.
