       IDENTIFICATION DIVISION.
       PROGRAM-ID. LYAPUNOV-DISP-STRATEGY.
       AUTHOR. AUNCIENT DYSNOMIA VM / DISPLACEMENT SYNC.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-DISP-PARAMS.
          05 WS-CHIN-REG-VAL           PIC 9(05) VALUE 15000.
          05 WS-MONOPOLE-REG-VAL       PIC 9(05) VALUE 20000.
          05 WS-RENDER-CYCLES-N        PIC 9(02) VALUE 16.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-INIT-DISP-E            PIC 9(05) VALUE 0.
          05 WS-CURRENT-DISP-E         PIC 9(05) VALUE 0.
          05 WS-STEP-IDX               PIC 9(02) VALUE 0.
          05 WS-CHIN-MOD               PIC 9(03) VALUE 0.
          05 WS-SHADOW-SHADER-BASE     PIC 9(12) VALUE 0.
          05 WS-CYC-MOD                PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-CHIN-REG            VALUE 2.
             88 INVALID-MONOPOLE-REG        VALUE 3.
             88 INVALID-RENDER-CYCLES       VALUE 4.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
             88 DISPLACEMENT-DIVERG-FAIL    VALUE 6.
             88 GATING-CLAMP-OVERFLOW       VALUE 7.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 8.
             88 CASCADE-ROLLBACK-FAIL       VALUE 9.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-DISPLACEMENT-CONTRACTION
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CHIN-REG-VAL EQUAL ZERO OR WS-CHIN-REG-VAL > 50000
               SET INVALID-CHIN-REG TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-MONOPOLE-REG-VAL EQUAL ZERO OR WS-MONOPOLE-REG-VAL > 50000
               SET INVALID-MONOPOLE-REG TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-RENDER-CYCLES-N < 1 OR WS-RENDER-CYCLES-N > 64
               SET INVALID-RENDER-CYCLES TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-DISPLACEMENT-CONTRACTION.
           COMPUTE WS-INIT-DISP-E = (WS-CHIN-REG-VAL * WS-MONOPOLE-REG-VAL) / 100000.
           IF WS-INIT-DISP-E > 50000 MOVE 50000 TO WS-INIT-DISP-E.
           MOVE WS-INIT-DISP-E TO WS-CURRENT-DISP-E.

           PERFORM VARYING WS-STEP-IDX FROM 1 BY 1 UNTIL WS-STEP-IDX > WS-RENDER-CYCLES-N
               COMPUTE WS-CURRENT-DISP-E = (WS-CURRENT-DISP-E * 875) / 1000
           END-PERFORM.

           IF WS-CURRENT-DISP-E > WS-INIT-DISP-E
               SET DISPLACEMENT-DIVERG-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-CHIN-MOD = FUNCTION MOD(WS-CHIN-REG-VAL, 100).

           COMPUTE WS-SHADOW-SHADER-BASE = (WS-CICS-WRITER-ID * 1000000) + 
               (WS-RENDER-CYCLES-N * 10000) + (WS-CHIN-MOD * 10) + (WS-CURRENT-DISP-E / 16).

           COMPUTE WS-CYC-MOD = FUNCTION MOD(WS-RENDER-CYCLES-N, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-CYC-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-SHADER-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-SHADER-BASE + ((WS-CURRENT-DISP-E * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-SHADER-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-RENDER-CYCLES-N * 10000) + (WS-CHIN-MOD * 10) + (WS-CURRENT-DISP-E / 16))
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-SHADER-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
