        IDENTIFICATION DIVISION.
        PROGRAM-ID. NOISE-THROUGHPUT-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / NOISE & THROUGHPUT AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-NOISE-PARAMS.
           05 WS-NOISE-SNR              PIC S9(03) VALUE -005.
           05 WS-MEASURED-TPS           PIC 9(05) VALUE 03060.
           05 WS-NUBIA-SCORE            PIC 9(04) VALUE 0320.
           05 WS-REALTIME-FLAG          PIC 9(01) VALUE 1.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-NOISE-VITALITY         PIC 9(09) VALUE 0.
           05 WS-NOISE-COHERENCE        PIC 9(09) VALUE 0.
           05 WS-NOISE-REBAR-LATCH      PIC 9(12) VALUE 0.
           05 WS-SHADOW-NOISE-BASE      PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 INVALID-NOISE-SNR           VALUE 2.
              88 INVALID-TPS-BOUND           VALUE 3.
              88 INVALID-NUBIA-SCORE         VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 EDGE-REALTIME-FLAG-FAIL     VALUE 6.
              88 SEMANTIC-DIVERG-FAIL        VALUE 7.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 8.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-NOISE-THROUGHPUT
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-NOISE-SNR < -20 OR WS-NOISE-SNR > 30
                SET INVALID-NOISE-SNR TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-MEASURED-TPS < 3000 OR WS-MEASURED-TPS > 50000
                SET INVALID-TPS-BOUND TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-NUBIA-SCORE < 150 OR WS-NUBIA-SCORE > 1000
                SET INVALID-NUBIA-SCORE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-REALTIME-FLAG NOT EQUAL 1
                SET EDGE-REALTIME-FLAG-FAIL TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-NOISE-THROUGHPUT.
            COMPUTE WS-NOISE-VITALITY = (WS-MEASURED-TPS / 10) +
                                        (WS-NUBIA-SCORE / 2) +
                                        ((WS-NOISE-SNR + 20) * 16) +
                                        (WS-REALTIME-FLAG * 256) + 1.

            IF WS-NOISE-VITALITY EQUAL ZERO
                SET SEMANTIC-DIVERG-FAIL TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-NOISE-COHERENCE = (WS-NUBIA-SCORE / 4) +
                                         (WS-MEASURED-TPS / 50) +
                                         ((WS-NOISE-SNR + 20) * 8).

            COMPUTE WS-NOISE-REBAR-LATCH = 1470169088 + (WS-MEASURED-TPS / 20) +
                                           (WS-NUBIA-SCORE / 2) +
                                           ((WS-NOISE-SNR + 20) * 32).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-NOISE-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                           (WS-NOISE-VITALITY * 10) +
                                           (WS-NOISE-COHERENCE * 10) +
                                           (WS-NUBIA-SCORE * 100) +
                                           (WS-NOISE-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-NOISE-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-NOISE-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
