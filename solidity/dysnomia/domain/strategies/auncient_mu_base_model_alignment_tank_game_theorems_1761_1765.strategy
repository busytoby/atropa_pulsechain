        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-BASE-ALIGN.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-BASE-ALIGN-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1761-BASE-ALIGN-OK     PIC 9(01) VALUE 1.
            05  WS-TH1762-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1763-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1764-1765M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1765-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-BASE-ALIGN-WIT           PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-BASE-ALIGN.
            GOBACK.
        1000-EVALUATE-BASE-ALIGN.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1761-BASE-ALIGN-OK = 1 AND
               WS-TH1762-DATBIN-STRAT-OK = 1 AND
               WS-TH1763-SUBMICRO-LAT-OK = 1 AND
               WS-TH1764-1765M-SAAT-OK = 1 AND
               WS-TH1765-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-BASE-ALIGN-WIT
            ELSE
                MOVE 0 TO WS-BASE-ALIGN-WIT.
