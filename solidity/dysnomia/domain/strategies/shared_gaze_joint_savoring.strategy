        IDENTIFICATION DIVISION.
        PROGRAM-ID. JSV-SAV-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / SHARED GAZE JOINT SAVORING AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-JSV-PARAMS.
           05 WS-GAZE-CONVERGE-M        PIC 9(04) VALUE 0960.
           05 WS-SAVOR-DELAY-MS         PIC 9(04) VALUE 3500.
           05 WS-LANDMARK-DRIFT-M       PIC 9(02) VALUE 02.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-JSV-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-JSV-VITALITY           PIC 9(09) VALUE 0.
           05 WS-JSV-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-JSV-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-JSV-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 GAZE-CONVERGE-LOW           VALUE 2.
              88 SAVOR-DELAY-OUT-OF-BOUNDS   VALUE 3.
              88 LANDMARK-DRIFT-EXCEEDED     VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 SAVORING-COLLAPSE           VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-JOINT-SAVORING
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-GAZE-CONVERGE-M < 850 OR WS-GAZE-CONVERGE-M > 1000
                SET GAZE-CONVERGE-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-SAVOR-DELAY-MS < 2000 OR WS-SAVOR-DELAY-MS > 6000
                SET SAVOR-DELAY-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-LANDMARK-DRIFT-M < 0 OR WS-LANDMARK-DRIFT-M > 10
                SET LANDMARK-DRIFT-EXCEEDED TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-JOINT-SAVORING.
            COMPUTE WS-JSV-COMPOSITE = (WS-GAZE-CONVERGE-M / 2) +
                                       ((6500 - WS-SAVOR-DELAY-MS) / 10) +
                                       ((15 - WS-LANDMARK-DRIFT-M) * 20).

            COMPUTE WS-JSV-VITALITY = (WS-JSV-COMPOSITE / 4) +
                                      (WS-GAZE-CONVERGE-M / 4) +
                                      ((15 - WS-LANDMARK-DRIFT-M) * 4) + 1.

            IF WS-JSV-VITALITY EQUAL ZERO
                SET SAVORING-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-JSV-COHERENCE = (WS-JSV-COMPOSITE / 16) +
                                       (WS-GAZE-CONVERGE-M / 16) +
                                       ((15 - WS-LANDMARK-DRIFT-M) * 2).

            COMPUTE WS-JSV-REBAR-LATCH = 1470169088 +
                                         (WS-JSV-COMPOSITE / 2) +
                                         ((15 - WS-LANDMARK-DRIFT-M) * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-JSV-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-JSV-VITALITY * 10) +
                                         (WS-JSV-COHERENCE * 10) +
                                         (WS-JSV-COMPOSITE * 10) +
                                         (WS-JSV-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-JSV-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-JSV-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
