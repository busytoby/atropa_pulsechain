        IDENTIFICATION DIVISION.
        PROGRAM-ID. MTL-KNO-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / MINDTRELLIS EXPLORATION AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-MTL-PARAMS.
           05 WS-EXPANSION-LAT-MS       PIC 9(02) VALUE 12.
           05 WS-ALIGNMENT-FID-M        PIC 9(04) VALUE 0960.
           05 WS-LAYOUT-JITTER-MS       PIC 9(02) VALUE 01.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-MTL-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-MTL-VITALITY           PIC 9(09) VALUE 0.
           05 WS-MTL-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-MTL-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-MTL-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 EXPAN-LAT-OUT-OF-BOUNDS     VALUE 2.
              88 ALIGNMENT-FIDELITY-LOW      VALUE 3.
              88 JITTER-EXCEEDED             VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 MINDTRELLIS-COLLAPSE        VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-MINDTRELLIS
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3 AND WS-K-EXPONENT NOT EQUAL 4
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-EXPANSION-LAT-MS < 5 OR WS-EXPANSION-LAT-MS > 25
                SET EXPAN-LAT-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-ALIGNMENT-FID-M < 850 OR WS-ALIGNMENT-FID-M > 1000
                SET ALIGNMENT-FIDELITY-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-LAYOUT-JITTER-MS < 0 OR WS-LAYOUT-JITTER-MS > 5
                SET JITTER-EXCEEDED TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-MINDTRELLIS.
            COMPUTE WS-MTL-COMPOSITE = ((30 - WS-EXPANSION-LAT-MS) * 20) +
                                       (WS-ALIGNMENT-FID-M / 2) +
                                       ((10 - WS-LAYOUT-JITTER-MS) * 40).

            COMPUTE WS-MTL-VITALITY = (WS-MTL-COMPOSITE / 4) +
                                      (WS-ALIGNMENT-FID-M / 4) +
                                      ((30 - WS-EXPANSION-LAT-MS) * 4) + 1.

            IF WS-MTL-VITALITY EQUAL ZERO
                SET MINDTRELLIS-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-MTL-COHERENCE = (WS-MTL-COMPOSITE / 16) +
                                       (WS-ALIGNMENT-FID-M / 16) +
                                       ((30 - WS-EXPANSION-LAT-MS) * 2).

            COMPUTE WS-MTL-REBAR-LATCH = 1470169088 +
                                         (WS-MTL-COMPOSITE / 2) +
                                         ((30 - WS-EXPANSION-LAT-MS) * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-MTL-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-MTL-VITALITY * 10) +
                                         (WS-MTL-COHERENCE * 10) +
                                         (WS-MTL-COMPOSITE * 10) +
                                         (WS-MTL-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-MTL-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-MTL-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
