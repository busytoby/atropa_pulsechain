        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-BEYOND-565.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-BEYOND-565-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH566-PMG-COLLISION-OK   PIC 9(01) VALUE 1.
            05  WS-TH567-LEED-RECOVERY-OK   PIC 9(01) VALUE 1.
            05  WS-TH568-STROBE-JITTER-OK   PIC 9(01) VALUE 1.
            05  WS-TH569-LEED-PMG-SAAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH570-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-BEYOND-565-WIT      PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-BEYOND-565.
            GOBACK.
        1000-EVALUATE-BEYOND-565.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH566-PMG-COLLISION-OK = 1 AND
               WS-TH567-LEED-RECOVERY-OK = 1 AND
               WS-TH568-STROBE-JITTER-OK = 1 AND
               WS-TH569-LEED-PMG-SAAT-OK = 1 AND
               WS-TH570-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-BEYOND-565-WIT
            ELSE
                MOVE 0 TO WS-FPGA-BEYOND-565-WIT.
