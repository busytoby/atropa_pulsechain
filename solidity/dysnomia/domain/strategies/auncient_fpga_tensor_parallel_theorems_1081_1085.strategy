        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-TENSOR.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-TENSOR-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1081-TENSOR-OK         PIC 9(01) VALUE 1.
            05  WS-TH1082-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1083-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1084-1085M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1085-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-FPGA-TENSOR-WIT          PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-FPGA-TENSOR.
            GOBACK.
        1000-EVALUATE-FPGA-TENSOR.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1081-TENSOR-OK = 1 AND
               WS-TH1082-DATBIN-STRAT-OK = 1 AND
               WS-TH1083-SUBMICRO-LAT-OK = 1 AND
               WS-TH1084-1085M-SAAT-OK = 1 AND
               WS-TH1085-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-FPGA-TENSOR-WIT
            ELSE
                MOVE 0 TO WS-FPGA-TENSOR-WIT.
