       IDENTIFICATION DIVISION.
       PROGRAM-ID. TEDDY_BEAR-MSIG-STRAT.
       AUTHOR. AUNCIENT DYSNOMIA VM / TEDDY_BEAR MULTISIG INHERITANCE.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-MSIG-PARAMS.
          05 WS-INIT-MSIG-JITTER       PIC 9(05) VALUE 13500.
          05 WS-SIGNATORY-NODES-M      PIC 9(02) VALUE 08.
          05 WS-QUORUM-CYCLES-N        PIC 9(02) VALUE 16.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-CURRENT-JITTER         PIC 9(05) VALUE 0.
          05 WS-STEP-IDX               PIC 9(02) VALUE 0.
          05 WS-SHADOW-MSIG-BASE       PIC 9(12) VALUE 0.
          05 WS-CYC-MOD                PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-MSIG-JITTER         VALUE 2.
             88 INVALID-SIGNATORY-NODES-M   VALUE 3.
             88 INVALID-QUORUM-CYCLES       VALUE 4.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
             88 MSIG-JITTER-FAIL            VALUE 6.
             88 GATING-CLAMP-OVERFLOW       VALUE 7.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 8.
             88 CASCADE-ROLLBACK-FAIL       VALUE 9.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-MULTISIG-QUORUM
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-INIT-MSIG-JITTER > 50000
               SET INVALID-MSIG-JITTER TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIGNATORY-NODES-M < 1 OR WS-SIGNATORY-NODES-M > 16
               SET INVALID-SIGNATORY-NODES-M TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-QUORUM-CYCLES-N < 1 OR WS-QUORUM-CYCLES-N > 64
               SET INVALID-QUORUM-CYCLES TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-MULTISIG-QUORUM.
           MOVE WS-INIT-MSIG-JITTER TO WS-CURRENT-JITTER.

           PERFORM VARYING WS-STEP-IDX FROM 1 BY 1 UNTIL WS-STEP-IDX > WS-QUORUM-CYCLES-N
               COMPUTE WS-CURRENT-JITTER = (WS-CURRENT-JITTER * 875) / 1000
           END-PERFORM.

           IF WS-CURRENT-JITTER > WS-INIT-MSIG-JITTER
               SET MSIG-JITTER-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-SHADOW-MSIG-BASE = (WS-CICS-WRITER-ID * 1000000) + 
               (WS-QUORUM-CYCLES-N * 10000) + (WS-SIGNATORY-NODES-M * 100) + (WS-CURRENT-JITTER / 16).

           COMPUTE WS-CYC-MOD = FUNCTION MOD(WS-SIGNATORY-NODES-M, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-CYC-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-MSIG-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-MSIG-BASE + ((WS-CURRENT-JITTER * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-MSIG-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-QUORUM-CYCLES-N * 10000) + (WS-SIGNATORY-NODES-M * 100) + (WS-CURRENT-JITTER / 16))
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-MSIG-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
