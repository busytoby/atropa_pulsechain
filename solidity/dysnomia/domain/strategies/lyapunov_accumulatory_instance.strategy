       IDENTIFICATION DIVISION.
       PROGRAM-ID. LYAPUNOV-ACCUMULATOR-STRATEGY.
       AUTHOR. AUNCIENT DYSNOMIA VM / ACCUMULATORY INSTANCE.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-ACCUM-PARAMS.
          05 WS-ACCUM-ADDR-HASH        PIC 9(09) VALUE 000009001.
          05 WS-INIT-STORED-CHARGE-A0  PIC 9(05) VALUE 10000.
          05 WS-INCOMING-FLUX-RATE-ST  PIC 9(04) VALUE 0500.
          05 WS-ACCUM-CYCLES-N         PIC 9(02) VALUE 16.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-CURRENT-ACCUM-CHARGE   PIC 9(09) VALUE 0.
          05 WS-STEP-IDX               PIC 9(02) VALUE 0.
          05 WS-THEORY-CAPACITY-MAX    PIC 9(09) VALUE 0.
          05 WS-ACCUM-ADDR-MOD         PIC 9(03) VALUE 0.
          05 WS-SHADOW-ACCUM-BASE      PIC 9(12) VALUE 0.
          05 WS-CYC-MOD                PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-ACCUM-ADDR          VALUE 2.
             88 INVALID-STORED-CHARGE       VALUE 3.
             88 INVALID-FLUX-RATE           VALUE 4.
             88 INVALID-ACCUM-CYCLES        VALUE 5.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 6.
             88 ACCUM-CAPACITY-OVERFLOW     VALUE 7.
             88 GATING-CLAMP-OVERFLOW       VALUE 8.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 9.
             88 CASCADE-ROLLBACK-FAIL       VALUE 10.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-ACCUMULATION-LOOP
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-ACCUM-ADDR-HASH EQUAL ZERO
               SET INVALID-ACCUM-ADDR TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-INIT-STORED-CHARGE-A0 > 50000
               SET INVALID-STORED-CHARGE TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-INCOMING-FLUX-RATE-ST < 1 OR WS-INCOMING-FLUX-RATE-ST > 5000
               SET INVALID-FLUX-RATE TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-ACCUM-CYCLES-N < 1 OR WS-ACCUM-CYCLES-N > 64
               SET INVALID-ACCUM-CYCLES TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-ACCUMULATION-LOOP.
           MOVE WS-INIT-STORED-CHARGE-A0 TO WS-CURRENT-ACCUM-CHARGE.

           PERFORM VARYING WS-STEP-IDX FROM 1 BY 1 UNTIL WS-STEP-IDX > WS-ACCUM-CYCLES-N
               COMPUTE WS-CURRENT-ACCUM-CHARGE = ((WS-CURRENT-ACCUM-CHARGE * 875) / 1000) + WS-INCOMING-FLUX-RATE-ST
           END-PERFORM.

           COMPUTE WS-THEORY-CAPACITY-MAX = WS-INIT-STORED-CHARGE-A0 + (8 * WS-INCOMING-FLUX-RATE-ST).

           IF WS-CURRENT-ACCUM-CHARGE > WS-THEORY-CAPACITY-MAX
               SET ACCUM-CAPACITY-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-ACCUM-ADDR-MOD = FUNCTION MOD(WS-ACCUM-ADDR-HASH, 1000).

           COMPUTE WS-SHADOW-ACCUM-BASE = (WS-CICS-WRITER-ID * 1000000) + 
               (WS-ACCUM-CYCLES-N * 10000) + (WS-ACCUM-ADDR-MOD * 10) + (WS-CURRENT-ACCUM-CHARGE / 16).

           COMPUTE WS-CYC-MOD = FUNCTION MOD(WS-ACCUM-CYCLES-N, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-CYC-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-ACCUM-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-ACCUM-BASE + ((WS-CURRENT-ACCUM-CHARGE * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-ACCUM-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-ACCUM-CYCLES-N * 10000) + (WS-ACCUM-ADDR-MOD * 10) + (WS-CURRENT-ACCUM-CHARGE / 16))
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-ACCUM-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
