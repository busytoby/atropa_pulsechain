        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-BEYOND-810.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-BEYOND-810-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH811-DAT-PHOTONIC-OK    PIC 9(01) VALUE 1.
            05  WS-TH812-POLARITON-23T-OK   PIC 9(01) VALUE 1.
            05  WS-TH813-EDSAC-ACID-LAT-OK  PIC 9(01) VALUE 1.
            05  WS-TH814-815M-SAAT-OK       PIC 9(01) VALUE 1.
            05  WS-TH815-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-BEYOND-810-WIT      PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-BEYOND-810.
            GOBACK.
        1000-EVALUATE-BEYOND-810.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH811-DAT-PHOTONIC-OK = 1 AND
               WS-TH812-POLARITON-23T-OK = 1 AND
               WS-TH813-EDSAC-ACID-LAT-OK = 1 AND
               WS-TH814-815M-SAAT-OK = 1 AND
               WS-TH815-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-BEYOND-810-WIT
            ELSE
                MOVE 0 TO WS-FPGA-BEYOND-810-WIT.
