        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-CLI-SESSION.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-CLI-SESSION-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1601-SESSION-OK        PIC 9(01) VALUE 1.
            05  WS-TH1602-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1603-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1604-1605M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1605-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-CLI-SESSION-WIT          PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-CLI-SESSION.
            GOBACK.
        1000-EVALUATE-CLI-SESSION.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1601-SESSION-OK = 1 AND
               WS-TH1602-DATBIN-STRAT-OK = 1 AND
               WS-TH1603-SUBMICRO-LAT-OK = 1 AND
               WS-TH1604-1605M-SAAT-OK = 1 AND
               WS-TH1605-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-CLI-SESSION-WIT
            ELSE
                MOVE 0 TO WS-CLI-SESSION-WIT.
