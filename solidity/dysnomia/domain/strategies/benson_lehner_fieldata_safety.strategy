       IDENTIFICATION DIVISION.
       PROGRAM-ID. BENSON-LEHNER-FIELDATA-STRATEGY.
       AUTHOR. AUNCIENT DYSNOMIA VM / OSCAR FIELDATA SAFETY.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-SAFETY-PARAMETERS.
          05 WS-RAW-SYMBOL-CODE        PIC 9(03) VALUE 042.
          05 WS-ANALOG-TRACE-IN        PIC 9(04) VALUE 1000.
          05 WS-POLY-COEFF-C0          PIC 9(04) VALUE 0050.
          05 WS-POLY-COEFF-C1          PIC 9(03) VALUE 100.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-MASKED-FIELDATA-SYM    PIC 9(02) VALUE 0.
          05 WS-CALIBRATED-TRACE       PIC 9(04) VALUE 0.
          05 WS-SHADOW-SAFETY-BASE     PIC 9(12) VALUE 0.
          05 WS-SYM-MOD                PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 FIELDATA-BIT-OVERFLOW       VALUE 2.
             88 OSCAR-ANALOG-OUT-OF-BOUNDS  VALUE 3.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 4.
             88 OSCAR-CALIBRATION-OVERFLOW  VALUE 5.
             88 GATING-CLAMP-OVERFLOW       VALUE 6.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 7.
             88 CASCADE-ROLLBACK-FAIL       VALUE 8.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-SAFETY-CALIBRATION
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-RAW-SYMBOL-CODE > 63
               SET FIELDATA-BIT-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-ANALOG-TRACE-IN > 2048
               SET OSCAR-ANALOG-OUT-OF-BOUNDS TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-SAFETY-CALIBRATION.
           MOVE WS-RAW-SYMBOL-CODE TO WS-MASKED-FIELDATA-SYM.

           COMPUTE WS-CALIBRATED-TRACE = WS-POLY-COEFF-C0 + 
               ((WS-POLY-COEFF-C1 * WS-ANALOG-TRACE-IN) / 100).

           IF WS-CALIBRATED-TRACE > 2048
               SET OSCAR-CALIBRATION-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-SHADOW-SAFETY-BASE = (WS-CICS-WRITER-ID * 1000000) + 
               (WS-MASKED-FIELDATA-SYM * 1000) + (WS-CALIBRATED-TRACE / 16).

           COMPUTE WS-SYM-MOD = FUNCTION MOD(WS-MASKED-FIELDATA-SYM, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-SYM-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-SAFETY-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-SAFETY-BASE + ((WS-CALIBRATED-TRACE * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-SAFETY-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-MASKED-FIELDATA-SYM * 1000) + (WS-CALIBRATED-TRACE / 16))
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-SAFETY-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
