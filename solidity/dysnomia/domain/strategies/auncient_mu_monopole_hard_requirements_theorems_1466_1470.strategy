        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-MONOPOLE-REQ.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-MONOPOLE-REQ-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1466-HARD-REQ-OK       PIC 9(01) VALUE 1.
            05  WS-TH1467-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1468-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1469-1470M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1470-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-MONOPOLE-REQ-WIT         PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-MONOPOLE-REQ.
            GOBACK.
        1000-EVALUATE-MONOPOLE-REQ.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1466-HARD-REQ-OK = 1 AND
               WS-TH1467-DATBIN-STRAT-OK = 1 AND
               WS-TH1468-SUBMICRO-LAT-OK = 1 AND
               WS-TH1469-1470M-SAAT-OK = 1 AND
               WS-TH1470-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-MONOPOLE-REQ-WIT
            ELSE
                MOVE 0 TO WS-MONOPOLE-REQ-WIT.
