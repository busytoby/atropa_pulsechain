        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FQC-BARREL.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FQC-BARREL-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1301-FQC-OK            PIC 9(01) VALUE 1.
            05  WS-TH1302-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1303-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1304-1305M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1305-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-FQC-BARREL-WIT           PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-FQC-BARREL.
            GOBACK.
        1000-EVALUATE-FQC-BARREL.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1301-FQC-OK = 1 AND
               WS-TH1302-DATBIN-STRAT-OK = 1 AND
               WS-TH1303-SUBMICRO-LAT-OK = 1 AND
               WS-TH1304-1305M-SAAT-OK = 1 AND
               WS-TH1305-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-FQC-BARREL-WIT
            ELSE
                MOVE 0 TO WS-FQC-BARREL-WIT.
