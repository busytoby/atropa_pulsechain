        IDENTIFICATION DIVISION.
        PROGRAM-ID. DIF-PHS-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / ACOUSTIC DIFFUSER PHASE MOD AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-DIF-PARAMS.
           05 WS-DIFFUSER-PHASE-DEG     PIC 9(03) VALUE 180.
           05 WS-DIFFUSION-COEFF-M      PIC 9(04) VALUE 0890.
           05 WS-PHASE-VARIANCE-T-DEG   PIC 9(02) VALUE 35.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-DIF-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-DIF-VITALITY           PIC 9(09) VALUE 0.
           05 WS-DIF-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-DIF-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-DIF-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 PHASE-DEGREE-OUT-OF-BOUNDS  VALUE 2.
              88 DIFFUSION-COEFF-LOW         VALUE 3.
              88 PHASE-VARIANCE-HIGH         VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 DIFFUSER-COLLAPSE           VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-DIFFUSER-PHASE
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-DIFFUSER-PHASE-DEG > 360
                SET PHASE-DEGREE-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-DIFFUSION-COEFF-M < 700 OR WS-DIFFUSION-COEFF-M > 980
                SET DIFFUSION-COEFF-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-PHASE-VARIANCE-T-DEG < 5 OR WS-PHASE-VARIANCE-T-DEG > 85
                SET PHASE-VARIANCE-HIGH TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-DIFFUSER-PHASE.
            COMPUTE WS-DIF-COMPOSITE = (WS-DIFFUSER-PHASE-DEG * 2) +
                                       (WS-DIFFUSION-COEFF-M / 2) +
                                       ((85 - WS-PHASE-VARIANCE-T-DEG) * 4).

            COMPUTE WS-DIF-VITALITY = (WS-DIF-COMPOSITE / 4) +
                                      (WS-DIFFUSION-COEFF-M / 4) +
                                      (WS-DIFFUSER-PHASE-DEG / 4) + 1.

            IF WS-DIF-VITALITY EQUAL ZERO
                SET DIFFUSER-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-DIF-COHERENCE = (WS-DIF-COMPOSITE / 16) +
                                       (WS-DIFFUSION-COEFF-M / 16) +
                                       (WS-DIFFUSER-PHASE-DEG / 16).

            COMPUTE WS-DIF-REBAR-LATCH = 1470169088 +
                                         (WS-DIF-COMPOSITE / 2) +
                                         (WS-DIFFUSER-PHASE-DEG * 64).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-DIF-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-DIF-VITALITY * 10) +
                                         (WS-DIF-COHERENCE * 10) +
                                         (WS-DIF-COMPOSITE * 10) +
                                         (WS-DIF-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-DIF-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-DIF-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
