        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-FEAT.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-FEAT-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1746-FPGA-FEAT-OK      PIC 9(01) VALUE 1.
            05  WS-TH1747-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1748-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1749-1750M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1750-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-FPGA-FEAT-WIT            PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-FPGA-FEAT.
            GOBACK.
        1000-EVALUATE-FPGA-FEAT.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1746-FPGA-FEAT-OK = 1 AND
               WS-TH1747-DATBIN-STRAT-OK = 1 AND
               WS-TH1748-SUBMICRO-LAT-OK = 1 AND
               WS-TH1749-1750M-SAAT-OK = 1 AND
               WS-TH1750-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-FPGA-FEAT-WIT
            ELSE
                MOVE 0 TO WS-FPGA-FEAT-WIT.
