        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-BUILT-PDCA-THEOREMS-31-35.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-BUILT-PDCA-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH31-MONOTONIC-PDCA-OK   PIC 9(01) VALUE 1.
            05  WS-TH32-ISOMETRIC-NORM-OK   PIC 9(01) VALUE 1.
            05  WS-TH33-BANACH-CONTRACT-OK  PIC 9(01) VALUE 1.
            05  WS-TH34-PASSIVE-SENSING-OK  PIC 9(01) VALUE 1.
            05  WS-TH35-RENDERMAN-SSIM-OK   PIC 9(01) VALUE 1.
            05  WS-PDCA-PROOF-WITNESS       PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-BUILT-PDCA.
            GOBACK.
        1000-EVALUATE-BUILT-PDCA.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH31-MONOTONIC-PDCA-OK = 1 AND
               WS-TH32-ISOMETRIC-NORM-OK = 1 AND
               WS-TH33-BANACH-CONTRACT-OK = 1 AND
               WS-TH34-PASSIVE-SENSING-OK = 1 AND
               WS-TH35-RENDERMAN-SSIM-OK = 1
                MOVE 1 TO WS-PDCA-PROOF-WITNESS
            ELSE
                MOVE 0 TO WS-PDCA-PROOF-WITNESS.
