        IDENTIFICATION DIVISION.
        PROGRAM-ID. LLM-TTS-COMPLETENESS-STRATEGY.
        AUTHOR. AUNCIENT DYSNOMIA VM / TTS COMPLETENESS AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-TTS-PARAMETERS.
           05 WS-IPA-PHONEME            PIC 9(03) VALUE 065.
           05 WS-PROSODY-F0             PIC 9(04) VALUE 0220.
           05 WS-FORMANT-F1             PIC 9(04) VALUE 0500.
           05 WS-VOCODER-ENERGY-Q16     PIC 9(06) VALUE 032768.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-TTS-PROSODY-METRIC     PIC 9(09) VALUE 0.
           05 WS-VOCODER-RESONANCE      PIC 9(09) VALUE 0.
           05 WS-TTS-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-TTS-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 INVALID-IPA-PHONEME         VALUE 2.
              88 INVALID-PROSODY-F0          VALUE 3.
              88 INVALID-FORMANT-F1          VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 INVALID-VOCODER-ENERGY      VALUE 6.
              88 TTS-UNDERFLOW-FAIL          VALUE 7.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 8.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-TTS-COMPLETENESS
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-IPA-PHONEME < 1 OR WS-IPA-PHONEME > 128
                SET INVALID-IPA-PHONEME TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-PROSODY-F0 < 20 OR WS-PROSODY-F0 > 1000
                SET INVALID-PROSODY-F0 TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-FORMANT-F1 < 150 OR WS-FORMANT-F1 > 4000
                SET INVALID-FORMANT-F1 TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-VOCODER-ENERGY-Q16 < 1000 OR WS-VOCODER-ENERGY-Q16 > 65536
                SET INVALID-VOCODER-ENERGY TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-TTS-COMPLETENESS.
            COMPUTE WS-TTS-PROSODY-METRIC = (WS-IPA-PHONEME * 1024) +
                                            (WS-PROSODY-F0 * 16) +
                                            (WS-FORMANT-F1 / 4) + 1.

            IF WS-TTS-PROSODY-METRIC EQUAL ZERO
                SET TTS-UNDERFLOW-FAIL TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-VOCODER-RESONANCE = ((WS-VOCODER-ENERGY-Q16 * 875) / 10000) +
                                           (WS-FORMANT-F1 / 2).

            COMPUTE WS-TTS-REBAR-LATCH = 1470169088 + (WS-IPA-PHONEME * 256) +
                                         (WS-PROSODY-F0 * 64) +
                                         (WS-FORMANT-F1 * 2).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-TTS-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-TTS-PROSODY-METRIC * 10) +
                                         (WS-VOCODER-RESONANCE * 10) +
                                         (WS-IPA-PHONEME * 1000) +
                                         (WS-TTS-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-TTS-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-TTS-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
