        IDENTIFICATION DIVISION.
        PROGRAM-ID. CV-STABILITY-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / CV VARIANCE AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-CV-PARAMS.
           05 WS-MEAN-MILLI             PIC 9(04) VALUE 0380.
           05 WS-STDDEV-MILLI           PIC 9(04) VALUE 0010.
           05 WS-MAX-CV-PCT             PIC 9(02) VALUE 05.
           05 WS-STABILITY-FLAG         PIC 9(01) VALUE 1.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-CALCULATED-CV          PIC 9(03) VALUE 0.
           05 WS-CV-VITALITY            PIC 9(09) VALUE 0.
           05 WS-CV-COHERENCE           PIC 9(09) VALUE 0.
           05 WS-CV-REBAR-LATCH         PIC 9(12) VALUE 0.
           05 WS-SHADOW-CV-BASE         PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 INVALID-MEAN-METRIC         VALUE 2.
              88 INVALID-STD-DEV             VALUE 3.
              88 INVALID-CV-MAX-PCT          VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 CV-STABILITY-FLAG-FAIL      VALUE 6.
              88 CV-VARIANCE-BREACH          VALUE 7.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 8.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-CV-STABILITY
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-MEAN-MILLI < 100 OR WS-MEAN-MILLI > 1000
                SET INVALID-MEAN-METRIC TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-STDDEV-MILLI < 1 OR WS-STDDEV-MILLI > 500
                SET INVALID-STD-DEV TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-MAX-CV-PCT < 1 OR WS-MAX-CV-PCT > 50
                SET INVALID-CV-MAX-PCT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-STABILITY-FLAG NOT EQUAL 1
                SET CV-STABILITY-FLAG-FAIL TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-CALCULATED-CV = (WS-STDDEV-MILLI * 100) / WS-MEAN-MILLI.
            IF WS-CALCULATED-CV > WS-MAX-CV-PCT
                SET CV-VARIANCE-BREACH TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-CV-STABILITY.
            COMPUTE WS-CV-VITALITY = (WS-MEAN-MILLI / 2) +
                                     ((WS-MAX-CV-PCT - WS-CALCULATED-CV) * 64) +
                                     (WS-STABILITY-FLAG * 256) + 1.

            IF WS-CV-VITALITY EQUAL ZERO
                SET CV-VARIANCE-BREACH TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-CV-COHERENCE = (WS-MEAN-MILLI / 4) +
                                      ((WS-MAX-CV-PCT - WS-CALCULATED-CV) * 16) +
                                      (WS-STDDEV-MILLI / 8).

            COMPUTE WS-CV-REBAR-LATCH = 1470169088 + (WS-MEAN-MILLI / 2) +
                                        ((WS-MAX-CV-PCT - WS-CALCULATED-CV) * 32) +
                                        (WS-STDDEV-MILLI / 4).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-CV-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                        (WS-CV-VITALITY * 10) +
                                        (WS-CV-COHERENCE * 10) +
                                        (WS-MEAN-MILLI * 100) +
                                        (WS-CV-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-CV-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-CV-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
