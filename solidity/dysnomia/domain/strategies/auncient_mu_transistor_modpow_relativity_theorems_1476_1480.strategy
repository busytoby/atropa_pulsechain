        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-TRANS-REL.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-TRANS-REL-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1476-TRANS-REL-OK      PIC 9(01) VALUE 1.
            05  WS-TH1477-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1478-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1479-1480M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1480-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-TRANS-REL-WIT            PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-TRANS-REL.
            GOBACK.
        1000-EVALUATE-TRANS-REL.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1476-TRANS-REL-OK = 1 AND
               WS-TH1477-DATBIN-STRAT-OK = 1 AND
               WS-TH1478-SUBMICRO-LAT-OK = 1 AND
               WS-TH1479-1480M-SAAT-OK = 1 AND
               WS-TH1480-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-TRANS-REL-WIT
            ELSE
                MOVE 0 TO WS-TRANS-REL-WIT.
