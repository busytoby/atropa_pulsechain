        IDENTIFICATION DIVISION.
        PROGRAM-ID. OCB-CUE-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / ORIENTATION CUE BILLBOARD AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-OCB-PARAMS.
           05 WS-VECTOR-LAT-MS          PIC 9(02) VALUE 12.
           05 WS-CUE-FIDELITY-M         PIC 9(04) VALUE 0960.
           05 WS-NORMAL-DEV-MRAD        PIC 9(02) VALUE 01.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-OCB-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-OCB-VITALITY           PIC 9(09) VALUE 0.
           05 WS-OCB-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-OCB-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-OCB-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 VECTOR-LAT-OUT-OF-BOUNDS    VALUE 2.
              88 CUE-FIDELITY-LOW            VALUE 3.
              88 DEVIATION-EXCEEDED          VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 CUE-COLLAPSE                VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-ORIENTATION-CUE
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3 AND WS-K-EXPONENT NOT EQUAL 4
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-VECTOR-LAT-MS < 5 OR WS-VECTOR-LAT-MS > 25
                SET VECTOR-LAT-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CUE-FIDELITY-M < 850 OR WS-CUE-FIDELITY-M > 1000
                SET CUE-FIDELITY-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-NORMAL-DEV-MRAD < 0 OR WS-NORMAL-DEV-MRAD > 5
                SET DEVIATION-EXCEEDED TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-ORIENTATION-CUE.
            COMPUTE WS-OCB-COMPOSITE = ((30 - WS-VECTOR-LAT-MS) * 20) +
                                       (WS-CUE-FIDELITY-M / 2) +
                                       ((10 - WS-NORMAL-DEV-MRAD) * 40).

            COMPUTE WS-OCB-VITALITY = (WS-OCB-COMPOSITE / 4) +
                                      (WS-CUE-FIDELITY-M / 4) +
                                      ((30 - WS-VECTOR-LAT-MS) * 4) + 1.

            IF WS-OCB-VITALITY EQUAL ZERO
                SET CUE-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-OCB-COHERENCE = (WS-OCB-COMPOSITE / 16) +
                                       (WS-CUE-FIDELITY-M / 16) +
                                       ((30 - WS-VECTOR-LAT-MS) * 2).

            COMPUTE WS-OCB-REBAR-LATCH = 1470169088 +
                                         (WS-OCB-COMPOSITE / 2) +
                                         ((30 - WS-VECTOR-LAT-MS) * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-OCB-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-OCB-VITALITY * 10) +
                                         (WS-OCB-COHERENCE * 10) +
                                         (WS-OCB-COMPOSITE * 10) +
                                         (WS-OCB-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-OCB-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-OCB-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
