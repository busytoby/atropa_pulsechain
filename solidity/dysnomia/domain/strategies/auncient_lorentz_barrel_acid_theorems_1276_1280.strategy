        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-LORENTZ-ACID.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-LOR-ACID-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1276-LOR-OK            PIC 9(01) VALUE 1.
            05  WS-TH1277-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1278-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1279-1280M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1280-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-LOR-ACID-WIT             PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-LOR-ACID.
            GOBACK.
        1000-EVALUATE-LOR-ACID.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1276-LOR-OK = 1 AND
               WS-TH1277-DATBIN-STRAT-OK = 1 AND
               WS-TH1278-SUBMICRO-LAT-OK = 1 AND
               WS-TH1279-1280M-SAAT-OK = 1 AND
               WS-TH1280-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-LOR-ACID-WIT
            ELSE
                MOVE 0 TO WS-LOR-ACID-WIT.
