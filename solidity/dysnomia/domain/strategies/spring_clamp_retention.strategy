        IDENTIFICATION DIVISION.
        PROGRAM-ID. SCR-CLP-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / SPRING CLAMP RETENTION AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-SCR-PARAMS.
           05 WS-CLAMP-LAT-MS           PIC 9(02) VALUE 12.
           05 WS-STABILITY-FID-M        PIC 9(04) VALUE 0960.
           05 WS-DEFLECTION-RES-UM      PIC 9(02) VALUE 01.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-SCR-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-SCR-VITALITY           PIC 9(09) VALUE 0.
           05 WS-SCR-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-SCR-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-SCR-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 CLAMP-LAT-OUT-OF-BOUNDS     VALUE 2.
              88 STABILITY-FIDELITY-LOW      VALUE 3.
              88 DEFLECTION-RES-EXCEEDED     VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 CLAMP-COLLAPSE              VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-SPRING-CLAMP
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3 AND WS-K-EXPONENT NOT EQUAL 4
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CLAMP-LAT-MS < 5 OR WS-CLAMP-LAT-MS > 25
                SET CLAMP-LAT-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-STABILITY-FID-M < 850 OR WS-STABILITY-FID-M > 1000
                SET STABILITY-FIDELITY-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-DEFLECTION-RES-UM < 0 OR WS-DEFLECTION-RES-UM > 5
                SET DEFLECTION-RES-EXCEEDED TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-SPRING-CLAMP.
            COMPUTE WS-SCR-COMPOSITE = ((30 - WS-CLAMP-LAT-MS) * 20) +
                                       (WS-STABILITY-FID-M / 2) +
                                       ((10 - WS-DEFLECTION-RES-UM) * 40).

            COMPUTE WS-SCR-VITALITY = (WS-SCR-COMPOSITE / 4) +
                                      (WS-STABILITY-FID-M / 4) +
                                      ((30 - WS-CLAMP-LAT-MS) * 4) + 1.

            IF WS-SCR-VITALITY EQUAL ZERO
                SET CLAMP-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-SCR-COHERENCE = (WS-SCR-COMPOSITE / 16) +
                                       (WS-STABILITY-FID-M / 16) +
                                       ((30 - WS-CLAMP-LAT-MS) * 2).

            COMPUTE WS-SCR-REBAR-LATCH = 1470169088 +
                                         (WS-SCR-COMPOSITE / 2) +
                                         ((30 - WS-CLAMP-LAT-MS) * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-SCR-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-SCR-VITALITY * 10) +
                                         (WS-SCR-COHERENCE * 10) +
                                         (WS-SCR-COMPOSITE * 10) +
                                         (WS-SCR-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-SCR-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-SCR-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
