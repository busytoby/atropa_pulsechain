        IDENTIFICATION DIVISION.
        PROGRAM-ID. ESC-SOUV-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / EPISODIC SOUVENIR CRYSTALLIZATION AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-ESC-PARAMS.
           05 WS-INDEX-LAT-MS           PIC 9(02) VALUE 20.
           05 WS-CRYSTAL-FIDELITY-M     PIC 9(04) VALUE 0960.
           05 WS-HASH-DRIFT-M           PIC 9(02) VALUE 01.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-ESC-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-ESC-VITALITY           PIC 9(09) VALUE 0.
           05 WS-ESC-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-ESC-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-ESC-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 INDEX-LAT-OUT-OF-BOUNDS     VALUE 2.
              88 CRYSTAL-FIDELITY-LOW        VALUE 3.
              88 HASH-DRIFT-EXCEEDED         VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 CRYSTAL-COLLAPSE            VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-SOUVENIR-CRYSTAL
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-INDEX-LAT-MS < 10 OR WS-INDEX-LAT-MS > 50
                SET INDEX-LAT-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CRYSTAL-FIDELITY-M < 850 OR WS-CRYSTAL-FIDELITY-M > 1000
                SET CRYSTAL-FIDELITY-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-HASH-DRIFT-M < 0 OR WS-HASH-DRIFT-M > 5
                SET HASH-DRIFT-EXCEEDED TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-SOUVENIR-CRYSTAL.
            COMPUTE WS-ESC-COMPOSITE = ((60 - WS-INDEX-LAT-MS) * 10) +
                                       (WS-CRYSTAL-FIDELITY-M / 2) +
                                       ((10 - WS-HASH-DRIFT-M) * 40).

            COMPUTE WS-ESC-VITALITY = (WS-ESC-COMPOSITE / 4) +
                                      (WS-CRYSTAL-FIDELITY-M / 4) +
                                      ((60 - WS-INDEX-LAT-MS) * 4) + 1.

            IF WS-ESC-VITALITY EQUAL ZERO
                SET CRYSTAL-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-ESC-COHERENCE = (WS-ESC-COMPOSITE / 16) +
                                       (WS-CRYSTAL-FIDELITY-M / 16) +
                                       ((60 - WS-INDEX-LAT-MS) * 2).

            COMPUTE WS-ESC-REBAR-LATCH = 1470169088 +
                                         (WS-ESC-COMPOSITE / 2) +
                                         ((60 - WS-INDEX-LAT-MS) * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-ESC-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-ESC-VITALITY * 10) +
                                         (WS-ESC-COHERENCE * 10) +
                                         (WS-ESC-COMPOSITE * 10) +
                                         (WS-ESC-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-ESC-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-ESC-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
