        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-ZKSAT-HARD.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-ZKSAT-HARD-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1516-HARD-OK           PIC 9(01) VALUE 1.
            05  WS-TH1517-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1518-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1519-1520M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1520-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-ZKSAT-HARD-WIT           PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-ZKSAT-HARD.
            GOBACK.
        1000-EVALUATE-ZKSAT-HARD.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1516-HARD-OK = 1 AND
               WS-TH1517-DATBIN-STRAT-OK = 1 AND
               WS-TH1518-SUBMICRO-LAT-OK = 1 AND
               WS-TH1519-1520M-SAAT-OK = 1 AND
               WS-TH1520-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-ZKSAT-HARD-WIT
            ELSE
                MOVE 0 TO WS-ZKSAT-HARD-WIT.
