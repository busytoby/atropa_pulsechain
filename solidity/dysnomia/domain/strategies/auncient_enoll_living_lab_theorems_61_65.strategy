        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-ENOLL-LIVING-LAB-THEOREMS-61-65.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-ENOLL-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH61-5PILLARS-OK         PIC 9(01) VALUE 1.
            05  WS-TH62-QUAD-HELIX-OK       PIC 9(01) VALUE 1.
            05  WS-TH63-FEDERATED-OK        PIC 9(01) VALUE 1.
            05  WS-TH64-DIFF-PRIVACY-OK     PIC 9(01) VALUE 1.
            05  WS-TH65-MATURITY-LVL5-OK    PIC 9(01) VALUE 1.
            05  WS-ENOLL-PROOF-WITNESS      PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-ENOLL-THEOREMS.
            GOBACK.
        1000-EVALUATE-ENOLL-THEOREMS.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH61-5PILLARS-OK = 1 AND
               WS-TH62-QUAD-HELIX-OK = 1 AND
               WS-TH63-FEDERATED-OK = 1 AND
               WS-TH64-DIFF-PRIVACY-OK = 1 AND
               WS-TH65-MATURITY-LVL5-OK = 1
                MOVE 1 TO WS-ENOLL-PROOF-WITNESS
            ELSE
                MOVE 0 TO WS-ENOLL-PROOF-WITNESS.
