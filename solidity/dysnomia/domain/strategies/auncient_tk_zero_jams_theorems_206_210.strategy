        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-TK-ZERO-JAMS.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-ZERO-JAMS-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH206-CLEARANCE-OK       PIC 9(01) VALUE 1.
            05  WS-TH207-GLASSBOX-OK        PIC 9(01) VALUE 1.
            05  WS-TH208-SIGNALFD-OK        PIC 9(01) VALUE 1.
            05  WS-TH209-SAAT-FLOW-OK       PIC 9(01) VALUE 1.
            05  WS-TH210-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-ZERO-JAMS-WITNESS        PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-ZERO-JAMS.
            GOBACK.
        1000-EVALUATE-ZERO-JAMS.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH206-CLEARANCE-OK = 1 AND
               WS-TH207-GLASSBOX-OK = 1 AND
               WS-TH208-SIGNALFD-OK = 1 AND
               WS-TH209-SAAT-FLOW-OK = 1 AND
               WS-TH210-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-ZERO-JAMS-WITNESS
            ELSE
                MOVE 0 TO WS-ZERO-JAMS-WITNESS.
