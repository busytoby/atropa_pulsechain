        IDENTIFICATION DIVISION.
        PROGRAM-ID. EVT-EXP-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / EXPLODED VIEW TRAJECTORY AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-EVT-PARAMS.
           05 WS-EXPLODED-LAT-MS        PIC 9(02) VALUE 12.
           05 WS-CLARITY-FID-M          PIC 9(04) VALUE 0960.
           05 WS-VECTOR-DRIFT-MRAD      PIC 9(02) VALUE 01.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-EVT-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-EVT-VITALITY           PIC 9(09) VALUE 0.
           05 WS-EVT-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-EVT-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-EVT-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 EXPLODED-LAT-OUT-OF-BOUNDS  VALUE 2.
              88 CLARITY-FIDELITY-LOW        VALUE 3.
              88 VECTOR-DRIFT-EXCEEDED       VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 EXPLODED-COLLAPSE           VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-EXPLODED-TRAJECTORY
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3 AND WS-K-EXPONENT NOT EQUAL 4
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-EXPLODED-LAT-MS < 5 OR WS-EXPLODED-LAT-MS > 25
                SET EXPLODED-LAT-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CLARITY-FID-M < 850 OR WS-CLARITY-FID-M > 1000
                SET CLARITY-FIDELITY-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-VECTOR-DRIFT-MRAD < 0 OR WS-VECTOR-DRIFT-MRAD > 5
                SET VECTOR-DRIFT-EXCEEDED TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-EXPLODED-TRAJECTORY.
            COMPUTE WS-EVT-COMPOSITE = ((30 - WS-EXPLODED-LAT-MS) * 20) +
                                       (WS-CLARITY-FID-M / 2) +
                                       ((10 - WS-VECTOR-DRIFT-MRAD) * 40).

            COMPUTE WS-EVT-VITALITY = (WS-EVT-COMPOSITE / 4) +
                                      (WS-CLARITY-FID-M / 4) +
                                      ((30 - WS-EXPLODED-LAT-MS) * 4) + 1.

            IF WS-EVT-VITALITY EQUAL ZERO
                SET EXPLODED-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-EVT-COHERENCE = (WS-EVT-COMPOSITE / 16) +
                                       (WS-CLARITY-FID-M / 16) +
                                       ((30 - WS-EXPLODED-LAT-MS) * 2).

            COMPUTE WS-EVT-REBAR-LATCH = 1470169088 +
                                         (WS-EVT-COMPOSITE / 2) +
                                         ((30 - WS-EXPLODED-LAT-MS) * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-EVT-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-EVT-VITALITY * 10) +
                                         (WS-EVT-COHERENCE * 10) +
                                         (WS-EVT-COMPOSITE * 10) +
                                         (WS-EVT-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-EVT-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-EVT-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
