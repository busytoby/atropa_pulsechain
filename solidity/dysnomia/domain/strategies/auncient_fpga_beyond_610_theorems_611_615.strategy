        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-BEYOND-610.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-BEYOND-610-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH611-SCSI-PAIR-OK       PIC 9(01) VALUE 1.
            05  WS-TH612-QUAD-LEDGER-OK     PIC 9(01) VALUE 1.
            05  WS-TH613-PAIR-LAT-OK        PIC 9(01) VALUE 1.
            05  WS-TH614-615M-SAAT-OK       PIC 9(01) VALUE 1.
            05  WS-TH615-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-BEYOND-610-WIT      PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-BEYOND-610.
            GOBACK.
        1000-EVALUATE-BEYOND-610.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH611-SCSI-PAIR-OK = 1 AND
               WS-TH612-QUAD-LEDGER-OK = 1 AND
               WS-TH613-PAIR-LAT-OK = 1 AND
               WS-TH614-615M-SAAT-OK = 1 AND
               WS-TH615-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-BEYOND-610-WIT
            ELSE
                MOVE 0 TO WS-FPGA-BEYOND-610-WIT.
