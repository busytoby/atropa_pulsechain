        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-ATTENTION-QKV-ORTHO.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-ATTENTION-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1841-ATTN-OK           PIC 9(01) VALUE 1.
            05  WS-TH1842-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1843-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1844-1845M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1845-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-ATTENTION-WIT            PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-ATTENTION.
            GOBACK.
        1000-EVALUATE-ATTENTION.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1841-ATTN-OK = 1 AND
               WS-TH1842-DATBIN-STRAT-OK = 1 AND
               WS-TH1843-SUBMICRO-LAT-OK = 1 AND
               WS-TH1844-1845M-SAAT-OK = 1 AND
               WS-TH1845-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-ATTENTION-WIT
            ELSE
                MOVE 0 TO WS-ATTENTION-WIT.
