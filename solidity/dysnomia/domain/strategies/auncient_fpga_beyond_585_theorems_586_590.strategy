        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-BEYOND-585.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-BEYOND-585-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH586-SCSI-LOOP-OK       PIC 9(01) VALUE 1.
            05  WS-TH587-DISP-SHADER-OK     PIC 9(01) VALUE 1.
            05  WS-TH588-SCSI-LATENCY-OK    PIC 9(01) VALUE 1.
            05  WS-TH589-SCSI-SAAT-OK       PIC 9(01) VALUE 1.
            05  WS-TH590-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-BEYOND-585-WIT      PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-BEYOND-585.
            GOBACK.
        1000-EVALUATE-BEYOND-585.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH586-SCSI-LOOP-OK = 1 AND
               WS-TH587-DISP-SHADER-OK = 1 AND
               WS-TH588-SCSI-LATENCY-OK = 1 AND
               WS-TH589-SCSI-SAAT-OK = 1 AND
               WS-TH590-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-BEYOND-585-WIT
            ELSE
                MOVE 0 TO WS-FPGA-BEYOND-585-WIT.
