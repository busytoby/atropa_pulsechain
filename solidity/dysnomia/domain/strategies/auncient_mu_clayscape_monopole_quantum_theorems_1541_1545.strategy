        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-CLAY-QUANTUM.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-CLAY-QUANTUM-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1541-QUANTUM-OK        PIC 9(01) VALUE 1.
            05  WS-TH1542-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1543-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1544-1545M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1545-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-CLAY-QUANTUM-WIT         PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-CLAY-QUANTUM.
            GOBACK.
        1000-EVALUATE-CLAY-QUANTUM.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1541-QUANTUM-OK = 1 AND
               WS-TH1542-DATBIN-STRAT-OK = 1 AND
               WS-TH1543-SUBMICRO-LAT-OK = 1 AND
               WS-TH1544-1545M-SAAT-OK = 1 AND
               WS-TH1545-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-CLAY-QUANTUM-WIT
            ELSE
                MOVE 0 TO WS-CLAY-QUANTUM-WIT.
