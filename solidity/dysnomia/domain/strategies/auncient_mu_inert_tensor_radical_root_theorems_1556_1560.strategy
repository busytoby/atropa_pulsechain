        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-INERT-TENSOR.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-INERT-TENSOR-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1556-INERT-OK          PIC 9(01) VALUE 1.
            05  WS-TH1557-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1558-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1559-1560M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1560-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-INERT-TENSOR-WIT         PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-INERT-TENSOR.
            GOBACK.
        1000-EVALUATE-INERT-TENSOR.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1556-INERT-OK = 1 AND
               WS-TH1557-DATBIN-STRAT-OK = 1 AND
               WS-TH1558-SUBMICRO-LAT-OK = 1 AND
               WS-TH1559-1560M-SAAT-OK = 1 AND
               WS-TH1560-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-INERT-TENSOR-WIT
            ELSE
                MOVE 0 TO WS-INERT-TENSOR-WIT.
