        IDENTIFICATION DIVISION.
        PROGRAM-ID. ALR-REM-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / ASYNCHRONOUS LANDMARK REMINISCE AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-ALR-PARAMS.
           05 WS-LANDMARK-MATCH-M       PIC 9(04) VALUE 0960.
           05 WS-REMINISCE-DELAY-MIN    PIC 9(03) VALUE 060.
           05 WS-SOCIAL-PRESSURE-M      PIC 9(02) VALUE 01.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-ALR-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-ALR-VITALITY           PIC 9(09) VALUE 0.
           05 WS-ALR-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-ALR-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-ALR-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 LANDMARK-MATCH-LOW          VALUE 2.
              88 REMINISCE-DELAY-OUT-OF-BND  VALUE 3.
              88 SOCIAL-PRESSURE-EXCEEDED    VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 REMINISCE-COLLAPSE          VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-REMINISCING
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-LANDMARK-MATCH-M < 850 OR WS-LANDMARK-MATCH-M > 1000
                SET LANDMARK-MATCH-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-REMINISCE-DELAY-MIN < 30 OR WS-REMINISCE-DELAY-MIN > 180
                SET REMINISCE-DELAY-OUT-OF-BND TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-SOCIAL-PRESSURE-M < 0 OR WS-SOCIAL-PRESSURE-M > 5
                SET SOCIAL-PRESSURE-EXCEEDED TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-REMINISCING.
            COMPUTE WS-ALR-COMPOSITE = (WS-LANDMARK-MATCH-M / 2) +
                                       ((200 - WS-REMINISCE-DELAY-MIN) * 2) +
                                       ((10 - WS-SOCIAL-PRESSURE-M) * 20).

            COMPUTE WS-ALR-VITALITY = (WS-ALR-COMPOSITE / 4) +
                                      (WS-LANDMARK-MATCH-M / 4) +
                                      ((200 - WS-REMINISCE-DELAY-MIN) / 2) + 1.

            IF WS-ALR-VITALITY EQUAL ZERO
                SET REMINISCE-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-ALR-COHERENCE = (WS-ALR-COMPOSITE / 16) +
                                       (WS-LANDMARK-MATCH-M / 16) +
                                       ((200 - WS-REMINISCE-DELAY-MIN) / 8).

            COMPUTE WS-ALR-REBAR-LATCH = 1470169088 +
                                         (WS-ALR-COMPOSITE / 2) +
                                         ((200 - WS-REMINISCE-DELAY-MIN) * 16).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-ALR-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-ALR-VITALITY * 10) +
                                         (WS-ALR-COHERENCE * 10) +
                                         (WS-ALR-COMPOSITE * 10) +
                                         (WS-ALR-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-ALR-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-ALR-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
