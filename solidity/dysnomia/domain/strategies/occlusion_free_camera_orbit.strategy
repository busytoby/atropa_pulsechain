        IDENTIFICATION DIVISION.
        PROGRAM-ID. OFC-CAM-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / OCCLUSION-FREE CAMERA ORBIT AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-OFC-PARAMS.
           05 WS-RAYCAST-LAT-MS         PIC 9(02) VALUE 12.
           05 WS-VISIBILITY-M           PIC 9(04) VALUE 0960.
           05 WS-SAMPLING-STEP-DEG      PIC 9(02) VALUE 10.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-OFC-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-OFC-VITALITY           PIC 9(09) VALUE 0.
           05 WS-OFC-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-OFC-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-OFC-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 RAYCAST-LAT-OUT-OF-BOUNDS   VALUE 2.
              88 VISIBILITY-RATIO-LOW        VALUE 3.
              88 SAMPLING-STEP-OUT-OF-BOUND  VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 VISIBILITY-COLLAPSE         VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-CAMERA-ORBIT
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-RAYCAST-LAT-MS < 5 OR WS-RAYCAST-LAT-MS > 25
                SET RAYCAST-LAT-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-VISIBILITY-M < 850 OR WS-VISIBILITY-M > 1000
                SET VISIBILITY-RATIO-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-SAMPLING-STEP-DEG < 5 OR WS-SAMPLING-STEP-DEG > 15
                SET SAMPLING-STEP-OUT-OF-BOUND TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-CAMERA-ORBIT.
            COMPUTE WS-OFC-COMPOSITE = ((30 - WS-RAYCAST-LAT-MS) * 20) +
                                       (WS-VISIBILITY-M / 2) +
                                       ((20 - WS-SAMPLING-STEP-DEG) * 20).

            COMPUTE WS-OFC-VITALITY = (WS-OFC-COMPOSITE / 4) +
                                      (WS-VISIBILITY-M / 4) +
                                      ((30 - WS-RAYCAST-LAT-MS) * 4) + 1.

            IF WS-OFC-VITALITY EQUAL ZERO
                SET VISIBILITY-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-OFC-COHERENCE = (WS-OFC-COMPOSITE / 16) +
                                       (WS-VISIBILITY-M / 16) +
                                       ((30 - WS-RAYCAST-LAT-MS) * 2).

            COMPUTE WS-OFC-REBAR-LATCH = 1470169088 +
                                         (WS-OFC-COMPOSITE / 2) +
                                         ((30 - WS-RAYCAST-LAT-MS) * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-OFC-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-OFC-VITALITY * 10) +
                                         (WS-OFC-COHERENCE * 10) +
                                         (WS-OFC-COMPOSITE * 10) +
                                         (WS-OFC-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-OFC-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-OFC-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
