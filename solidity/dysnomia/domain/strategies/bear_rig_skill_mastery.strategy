        IDENTIFICATION DIVISION.
        PROGRAM-ID. BRM-RIG-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / BEAR RIG SKILL MASTERY AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-BRM-PARAMS.
           05 WS-RIG-EVAL-LAT-MS        PIC 9(02) VALUE 12.
           05 WS-REWARD-MASTERY-FID-M   PIC 9(04) VALUE 0960.
           05 WS-ALIGNMENT-RES-UM       PIC 9(02) VALUE 01.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-BRM-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-BRM-VITALITY           PIC 9(09) VALUE 0.
           05 WS-BRM-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-BRM-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-BRM-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 RIG-EVAL-LAT-OUT-OF-BOUNDS  VALUE 2.
              88 REWARD-FIDELITY-LOW         VALUE 3.
              88 RESIDUAL-EXCEEDED           VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 RIG-MASTERY-COLLAPSE        VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-RIG-SKILL-MASTERY
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3 AND WS-K-EXPONENT NOT EQUAL 4
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-RIG-EVAL-LAT-MS < 5 OR WS-RIG-EVAL-LAT-MS > 25
                SET RIG-EVAL-LAT-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-REWARD-MASTERY-FID-M < 850 OR WS-REWARD-MASTERY-FID-M > 1000
                SET REWARD-FIDELITY-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-ALIGNMENT-RES-UM < 0 OR WS-ALIGNMENT-RES-UM > 5
                SET RESIDUAL-EXCEEDED TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-RIG-SKILL-MASTERY.
            COMPUTE WS-BRM-COMPOSITE = ((30 - WS-RIG-EVAL-LAT-MS) * 20) +
                                       (WS-REWARD-MASTERY-FID-M / 2) +
                                       ((10 - WS-ALIGNMENT-RES-UM) * 40).

            COMPUTE WS-BRM-VITALITY = (WS-BRM-COMPOSITE / 4) +
                                      (WS-REWARD-MASTERY-FID-M / 4) +
                                      ((30 - WS-RIG-EVAL-LAT-MS) * 4) + 1.

            IF WS-BRM-VITALITY EQUAL ZERO
                SET RIG-MASTERY-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-BRM-COHERENCE = (WS-BRM-COMPOSITE / 16) +
                                       (WS-REWARD-MASTERY-FID-M / 16) +
                                       ((30 - WS-RIG-EVAL-LAT-MS) * 2).

            COMPUTE WS-BRM-REBAR-LATCH = 1470169088 +
                                         (WS-BRM-COMPOSITE / 2) +
                                         ((30 - WS-RIG-EVAL-LAT-MS) * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-BRM-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-BRM-VITALITY * 10) +
                                         (WS-BRM-COHERENCE * 10) +
                                         (WS-BRM-COMPOSITE * 10) +
                                         (WS-BRM-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-BRM-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-BRM-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
