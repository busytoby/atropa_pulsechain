        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-APOGEE-DUAL.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-APOGEE-DUAL-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1441-APOGEE-OK         PIC 9(01) VALUE 1.
            05  WS-TH1442-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1443-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1444-1445M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1445-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-APOGEE-DUAL-WIT          PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-APOGEE-DUAL.
            GOBACK.
        1000-EVALUATE-APOGEE-DUAL.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1441-APOGEE-OK = 1 AND
               WS-TH1442-DATBIN-STRAT-OK = 1 AND
               WS-TH1443-SUBMICRO-LAT-OK = 1 AND
               WS-TH1444-1445M-SAAT-OK = 1 AND
               WS-TH1445-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-APOGEE-DUAL-WIT
            ELSE
                MOVE 0 TO WS-APOGEE-DUAL-WIT.
