        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-SDK-ATOM-RING.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-ATOM-RING-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1221-RING-OK           PIC 9(01) VALUE 1.
            05  WS-TH1222-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1223-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1224-1225M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1225-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-ATOM-RING-WIT            PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-ATOM-RING.
            GOBACK.
        1000-EVALUATE-ATOM-RING.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1221-RING-OK = 1 AND
               WS-TH1222-DATBIN-STRAT-OK = 1 AND
               WS-TH1223-SUBMICRO-LAT-OK = 1 AND
               WS-TH1224-1225M-SAAT-OK = 1 AND
               WS-TH1225-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-ATOM-RING-WIT
            ELSE
                MOVE 0 TO WS-ATOM-RING-WIT.
