       IDENTIFICATION DIVISION.
       PROGRAM-ID. VAESEN-EMPATHY-STRATEGY.
       AUTHOR. AUNCIENT DYSNOMIA VM / VAESEN EMPATHY COUPLING.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-EMPATHY-PARAMS.
          05 WS-ENTITY-COUNT-N         PIC 9(02) VALUE 04.
          05 WS-COUPLING-K             PIC 9(04) VALUE 0100.
          05 WS-LEAD-ENTITY-Q1         PIC 9(05) VALUE 08000.
          05 WS-PEER-ENTITY-Q2         PIC 9(05) VALUE 02000.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-Q1-CUR                 PIC S9(09) VALUE 0.
          05 WS-Q2-CUR                 PIC S9(09) VALUE 0.
          05 WS-P1-CUR                 PIC S9(09) VALUE 0.
          05 WS-P2-CUR                 PIC S9(09) VALUE 0.
          05 WS-STEP-IDX               PIC 9(02) VALUE 0.
          05 WS-EMPATHY-FORCE          PIC S9(09) VALUE 0.
          05 WS-TOTAL-SOCIAL-ENERGY    PIC 9(12) VALUE 0.
          05 WS-SHADOW-EMPATHY-BASE    PIC 9(12) VALUE 0.
          05 WS-CYC-MOD                PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-ENTITY-COUNT        VALUE 2.
             88 INVALID-COUPLING-K          VALUE 3.
             88 INVALID-COORDINATES         VALUE 4.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
             88 SOCIAL-ENERGY-DRIFT-FAIL    VALUE 6.
             88 GATING-CLAMP-OVERFLOW       VALUE 7.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 8.
             88 CASCADE-ROLLBACK-FAIL       VALUE 9.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-EMPATHY-INTEGRATION
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-ENTITY-COUNT-N < 2 OR WS-ENTITY-COUNT-N > 8
               SET INVALID-ENTITY-COUNT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-COUPLING-K < 1 OR WS-COUPLING-K > 1000
               SET INVALID-COUPLING-K TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-LEAD-ENTITY-Q1 > 20000 OR WS-PEER-ENTITY-Q2 > 20000
               SET INVALID-COORDINATES TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-EMPATHY-INTEGRATION.
           MOVE WS-LEAD-ENTITY-Q1 TO WS-Q1-CUR.
           MOVE WS-PEER-ENTITY-Q2 TO WS-Q2-CUR.
           MOVE 0 TO WS-P1-CUR.
           MOVE 0 TO WS-P2-CUR.

           PERFORM VARYING WS-STEP-IDX FROM 1 BY 1 UNTIL WS-STEP-IDX > 16
               COMPUTE WS-EMPATHY-FORCE = ((WS-COUPLING-K * (WS-Q2-CUR - WS-Q1-CUR)) / 100)
               COMPUTE WS-P1-CUR = WS-P1-CUR + (WS-EMPATHY-FORCE / 10)
               COMPUTE WS-P2-CUR = WS-P2-CUR - (WS-EMPATHY-FORCE / 10)
               COMPUTE WS-Q1-CUR = WS-Q1-CUR + (WS-P1-CUR / 100)
               COMPUTE WS-Q2-CUR = WS-Q2-CUR + (WS-P2-CUR / 100)
           END-PERFORM.

           COMPUTE WS-TOTAL-SOCIAL-ENERGY = ((WS-P1-CUR * WS-P1-CUR) / 2) + ((WS-P2-CUR * WS-P2-CUR) / 2) + 
               (((WS-Q1-CUR - WS-Q2-CUR) * (WS-Q1-CUR - WS-Q2-CUR)) / 4).

           COMPUTE WS-SHADOW-EMPATHY-BASE = (WS-CICS-WRITER-ID * 1000000) + 
               (WS-ENTITY-COUNT-N * 10000) + (WS-COUPLING-K * 10) + (WS-TOTAL-SOCIAL-ENERGY / 65536).

           COMPUTE WS-CYC-MOD = FUNCTION MOD(WS-ENTITY-COUNT-N, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-CYC-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-EMPATHY-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-EMPATHY-BASE + ((WS-Q1-CUR * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-EMPATHY-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-ENTITY-COUNT-N * 10000) + (WS-COUPLING-K * 10) + (WS-TOTAL-SOCIAL-ENERGY / 65536))
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-EMPATHY-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
