IDENTIFICATION DIVISION.
PROGRAM-ID. PROG-HARVARD-ZUO-NINES.

DATA DIVISION.
01 D0-SUBSTRATE-TRUNK.
   05 D0-MOTZKIN-PRIME     PIC 9(9) USAGE R0.
   05 D0-K-EXPONENT        PIC 9(9) USAGE R1.
   05 D0-BORROW-FAULT-FLAG PIC 9(9) USAGE R2.
01 D1-MINUEND-SHADOW.
   05 D1-MINUEND-VAL       PIC 9(9) USAGE R3.
   05 D1-SUBTRAHEND-VAL    PIC 9(9) USAGE R4.
   05 D1-SHADOW-MIN-SNAP   PIC 9(9) USAGE R5.
01 D2-DIFFERENCE-STAGE.
   05 D2-DIRECT-DIFF-VAL   PIC 9(9) USAGE R6.
   05 D2-G-SWIGLU-GATE     PIC 9(9) USAGE R7.
   05 D2-COMMITTED-STATE   PIC 9(9) USAGE R8.
01 D3-LEAF-EVAL.
   05 D3-PROOF-RULING      PIC 9(9) USAGE R9.
   05 D3-DISP-WRAP-MOD     PIC 9(9) USAGE R10.

PROCEDURE DIVISION.
    MOVE 953467954 TO D0-MOTZKIN-PRIME.
    MOVE 3 TO D0-K-EXPONENT.
    MOVE 0 TO D0-BORROW-FAULT-FLAG.
    MOVE 1000000 TO D1-MINUEND-VAL.
    MOVE 43605 TO D1-SUBTRAHEND-VAL.

    PERFORM STAGE-NINES-SUBTRACTION.
    PERFORM APPLY-BORROW-LATCH.
    PERFORM SYNC-DISPLACEMENT.

    IF D1-SHADOW-MIN-SNAP == D1-MINUEND-VAL AND D2-DIRECT-DIFF-VAL == 956395
        MOVE 0 TO D3-PROOF-RULING
        SET depth 4
    ELSE
        MOVE 4 TO D3-PROOF-RULING
        SET depth 1
    END-IF.

    EVAL.
    GO TO END-STRATEGY.

STAGE-NINES-SUBTRACTION.
    MOVE D1-MINUEND-VAL TO D1-SHADOW-MIN-SNAP.
    COMPUTE D2-DIRECT-DIFF-VAL = D1-MINUEND-VAL - D1-SUBTRAHEND-VAL.
    COMPUTE D2-G-SWIGLU-GATE = 875 + ((125 * (D2-DIRECT-DIFF-VAL - ((D2-DIRECT-DIFF-VAL / 1000) * 1000))) / 1000).
    EXIT.

APPLY-BORROW-LATCH.
    IF D0-BORROW-FAULT-FLAG == 1
        MOVE D1-SHADOW-MIN-SNAP TO D2-COMMITTED-STATE
    ELSE
        COMPUTE D2-COMMITTED-STATE = (D2-DIRECT-DIFF-VAL * D2-G-SWIGLU-GATE) / 1000
    END-IF.
    EXIT.

SYNC-DISPLACEMENT.
    COMPUTE D3-DISP-WRAP-MOD = D2-COMMITTED-STATE - ((D2-COMMITTED-STATE / 256) * 256).
    EXIT.

END-STRATEGY.
