        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-KLING-995.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-KLING-BEYOND-995-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH996-ANTI-ABUSE-OK      PIC 9(01) VALUE 1.
            05  WS-TH997-MERKLE-GUARD-OK    PIC 9(01) VALUE 1.
            05  WS-TH998-SUBMICRO-LAT-OK    PIC 9(01) VALUE 1.
            05  WS-TH999-1B-SAAT-OK         PIC 9(01) VALUE 1.
            05  WS-TH1000-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-KLING-BEYOND-995-WIT     PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-KLING-995.
            GOBACK.
        1000-EVALUATE-KLING-995.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH996-ANTI-ABUSE-OK = 1 AND
               WS-TH997-MERKLE-GUARD-OK = 1 AND
               WS-TH998-SUBMICRO-LAT-OK = 1 AND
               WS-TH999-1B-SAAT-OK = 1 AND
               WS-TH1000-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-KLING-BEYOND-995-WIT
            ELSE
                MOVE 0 TO WS-KLING-BEYOND-995-WIT.
