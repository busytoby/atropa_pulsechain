        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-AGENT-SDK-FPGA.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-AGENT-SDK-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1151-AGENT-OK          PIC 9(01) VALUE 1.
            05  WS-TH1152-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1153-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1154-1155M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1155-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-AGENT-SDK-WIT            PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-AGENT-SDK.
            GOBACK.
        1000-EVALUATE-AGENT-SDK.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1151-AGENT-OK = 1 AND
               WS-TH1152-DATBIN-STRAT-OK = 1 AND
               WS-TH1153-SUBMICRO-LAT-OK = 1 AND
               WS-TH1154-1155M-SAAT-OK = 1 AND
               WS-TH1155-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-AGENT-SDK-WIT
            ELSE
                MOVE 0 TO WS-AGENT-SDK-WIT.
