        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-ANDERSON-ANKH.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-ANDERSON-ANKH-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH976-DE-ALIENATION-OK   PIC 9(01) VALUE 1.
            05  WS-TH977-DISPUTE-MERKLE-OK  PIC 9(01) VALUE 1.
            05  WS-TH978-AUDIT-LAT-OK       PIC 9(01) VALUE 1.
            05  WS-TH979-980M-SAAT-OK       PIC 9(01) VALUE 1.
            05  WS-TH980-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-ANDERSON-ANKH-WIT        PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-ANDERSON-ANKH.
            GOBACK.
        1000-EVALUATE-ANDERSON-ANKH.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH976-DE-ALIENATION-OK = 1 AND
               WS-TH977-DISPUTE-MERKLE-OK = 1 AND
               WS-TH978-AUDIT-LAT-OK = 1 AND
               WS-TH979-980M-SAAT-OK = 1 AND
               WS-TH980-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-ANDERSON-ANKH-WIT
            ELSE
                MOVE 0 TO WS-ANDERSON-ANKH-WIT.
