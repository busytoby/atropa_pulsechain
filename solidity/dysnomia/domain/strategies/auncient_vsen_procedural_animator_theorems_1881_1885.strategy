        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-VSEN-PROCANIM.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-VSEN-PROCANIM-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1881-VISEME-SYNC-OK    PIC 9(01) VALUE 1.
            05  WS-TH1882-CLOTH-DYNAMICS-OK PIC 9(01) VALUE 1.
            05  WS-TH1883-FUR-RAY-LAT-OK    PIC 9(01) VALUE 1.
            05  WS-TH1884-1885M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1885-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-VSEN-PROCANIM-WIT        PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-VSEN-PROCANIM.
            GOBACK.
        1000-EVALUATE-VSEN-PROCANIM.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1881-VISEME-SYNC-OK = 1 AND
               WS-TH1882-CLOTH-DYNAMICS-OK = 1 AND
               WS-TH1883-FUR-RAY-LAT-OK = 1 AND
               WS-TH1884-1885M-SAAT-OK = 1 AND
               WS-TH1885-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-VSEN-PROCANIM-WIT
            ELSE
                MOVE 0 TO WS-VSEN-PROCANIM-WIT.
