       IDENTIFICATION DIVISION.
       PROGRAM-ID. CPM-TOMIE-RELAY-COMMUTATION.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-RELAY-COMMUTATION-PROOFS.
           05  WS-COMMUTATION-TIMING-OK    PIC 9(01) VALUE 1.
           05  WS-LATCH-RECOVERY-OK        PIC 9(01) VALUE 1.
           05  WS-BOUNCE-FREE-OK           PIC 9(01) VALUE 1.
           05  WS-RELAY-LATENCY-OK         PIC 9(01) VALUE 1.
           05  WS-RELAY-COMMUTATION-SEAL-OK PIC 9(01) VALUE 1.
       01  WS-RELAY-COMMUTATION-SYNTHESIS.
           05  WS-ALL-RLY-PROVEN           PIC 9(01) VALUE 1.
           05  WS-TOTAL-RLY-CODE           PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-EVALUATE-TIMING-AND-LATCH.
           PERFORM 2000-EVALUATE-BOUNCE-AND-LATENCY.
           PERFORM 3000-SYNTHESIZE-RLY-PROOFS.
           GOBACK.
       1000-EVALUATE-TIMING-AND-LATCH.
           MOVE 1 TO WS-COMMUTATION-TIMING-OK.
           MOVE 1 TO WS-LATCH-RECOVERY-OK.
       2000-EVALUATE-BOUNCE-AND-LATENCY.
           MOVE 1 TO WS-BOUNCE-FREE-OK.
           MOVE 1 TO WS-RELAY-LATENCY-OK.
       3000-SYNTHESIZE-RLY-PROOFS.
           IF WS-COMMUTATION-TIMING-OK = 1 AND
              WS-LATCH-RECOVERY-OK = 1 AND
              WS-BOUNCE-FREE-OK = 1 AND
              WS-RELAY-LATENCY-OK = 1
               MOVE 1 TO WS-RELAY-COMMUTATION-SEAL-OK
               MOVE 1 TO WS-ALL-RLY-PROVEN
               MOVE 1 TO WS-TOTAL-RLY-CODE
           ELSE
               MOVE 0 TO WS-ALL-RLY-PROVEN
               MOVE 0 TO WS-TOTAL-RLY-CODE.
