        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-TOTAL-KNOWLEDGE-106-110.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-TK-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH106-FULL-INFO-OK       PIC 9(01) VALUE 1.
            05  WS-TH107-SUBLEMMA-OK        PIC 9(01) VALUE 1.
            05  WS-TH108-NO-SETUP-OK        PIC 9(01) VALUE 1.
            05  WS-TH109-INTROSPECT-OK      PIC 9(01) VALUE 1.
            05  WS-TH110-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-TK-PROOF-WITNESS         PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-TK-PROOF.
            GOBACK.
        1000-EVALUATE-TK-PROOF.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH106-FULL-INFO-OK = 1 AND
               WS-TH107-SUBLEMMA-OK = 1 AND
               WS-TH108-NO-SETUP-OK = 1 AND
               WS-TH109-INTROSPECT-OK = 1 AND
               WS-TH110-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-TK-PROOF-WITNESS
            ELSE
                MOVE 0 TO WS-TK-PROOF-WITNESS.
