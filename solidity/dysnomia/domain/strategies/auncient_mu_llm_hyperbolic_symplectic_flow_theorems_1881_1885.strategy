        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-MU-HYP-FLOW.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FLOW-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1881-FLOW-OK           PIC 9(01) VALUE 1.
            05  WS-TH1882-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1883-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1884-1885M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1885-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-FLOW-WIT                 PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-FLOW.
            GOBACK.
        1000-EVALUATE-FLOW.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1881-FLOW-OK = 1 AND
               WS-TH1882-DATBIN-STRAT-OK = 1 AND
               WS-TH1883-SUBMICRO-LAT-OK = 1 AND
               WS-TH1884-1885M-SAAT-OK = 1 AND
               WS-TH1885-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-FLOW-WIT
            ELSE
                MOVE 0 TO WS-FLOW-WIT.
