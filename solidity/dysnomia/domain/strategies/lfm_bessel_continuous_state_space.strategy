       IDENTIFICATION DIVISION.
       PROGRAM-ID. LFM-BESSEL-STATE-SPACE-STRATEGY.
       AUTHOR. AUNCIENT DYSNOMIA VM / LFM STATE SPACE AUDIT.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-LFM-PARAMETERS.
          05 WS-BDOS-FUNC-ID           PIC 9(02) VALUE 09.
          05 WS-TOKEN-SIGNAL-Q16       PIC 9(06) VALUE 000256.
          05 WS-INITIAL-HIDDEN-H0      PIC 9(06) VALUE 032768.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-J0-DECAY-A             PIC 9(09) VALUE 0.
          05 WS-J1-INPUT-B             PIC 9(09) VALUE 0.
          05 WS-UPDATED-HIDDEN-H1      PIC 9(09) VALUE 0.
          05 WS-SHADOW-LFM-BASELINE    PIC 9(12) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-BDOS-FUNC           VALUE 2.
             88 INVALID-SIGNAL-INPUT        VALUE 3.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 4.
             88 GATING-CLAMP-OVERFLOW       VALUE 5.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 6.
             88 CASCADE-ROLLBACK-FAIL       VALUE 7.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-STATE-SPACE
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-BDOS-FUNC-ID < 1 OR WS-BDOS-FUNC-ID > 12
               SET INVALID-BDOS-FUNC TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-TOKEN-SIGNAL-Q16 > 65536
               SET INVALID-SIGNAL-INPUT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-STATE-SPACE.
           COMPUTE WS-J0-DECAY-A = 65536 - ((WS-TOKEN-SIGNAL-Q16 * WS-TOKEN-SIGNAL-Q16) / 262144).
           COMPUTE WS-J1-INPUT-B = (WS-TOKEN-SIGNAL-Q16 / 2) - ((WS-TOKEN-SIGNAL-Q16 * WS-TOKEN-SIGNAL-Q16 * WS-TOKEN-SIGNAL-Q16) / 1048576).

           COMPUTE WS-UPDATED-HIDDEN-H1 = ((WS-INITIAL-HIDDEN-H0 * WS-J0-DECAY-A) / 65536) + ((WS-TOKEN-SIGNAL-Q16 * WS-J1-INPUT-B) / 65536).
           COMPUTE WS-SHADOW-LFM-BASELINE = (WS-CICS-WRITER-ID * 10000) + (WS-BDOS-FUNC-ID * 1000) + WS-INITIAL-HIDDEN-H0.

           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-BDOS-FUNC-ID) / 12).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-LFM-BASELINE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = (((WS-SHADOW-LFM-BASELINE + WS-UPDATED-HIDDEN-H1) * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-LFM-BASELINE NOT EQUAL ((WS-CICS-WRITER-ID * 10000) + (WS-BDOS-FUNC-ID * 1000) + WS-INITIAL-HIDDEN-H0)
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-LFM-BASELINE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
