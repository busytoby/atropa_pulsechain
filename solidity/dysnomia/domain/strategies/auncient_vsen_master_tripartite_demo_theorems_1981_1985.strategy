        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-VSEN-MTRIPDEM.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-VSEN-MTRIPDEM-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1981-SCHED-OK          PIC 9(01) VALUE 1.
            05  WS-TH1982-BIO-FLUX-OK       PIC 9(01) VALUE 1.
            05  WS-TH1983-DISP-LAT-OK       PIC 9(01) VALUE 1.
            05  WS-TH1984-1985M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1985-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-VSEN-MTRIPDEM-WIT        PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-VSEN-MTRIPDEM.
            GOBACK.
        1000-EVALUATE-VSEN-MTRIPDEM.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1981-SCHED-OK = 1 AND
               WS-TH1982-BIO-FLUX-OK = 1 AND
               WS-TH1983-DISP-LAT-OK = 1 AND
               WS-TH1984-1985M-SAAT-OK = 1 AND
               WS-TH1985-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-VSEN-MTRIPDEM-WIT
            ELSE
                MOVE 0 TO WS-VSEN-MTRIPDEM-WIT.
