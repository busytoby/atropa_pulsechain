        IDENTIFICATION DIVISION.
        PROGRAM-ID. DUAL-COND-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / BONE-AIR DUAL CONDUCTION AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-COND-PARAMS.
           05 WS-PROPAGATION-DELAY-T    PIC 9(03) VALUE 350.
           05 WS-DUAL-SIR-TENTHS-DB     PIC 9(03) VALUE 225.
           05 WS-DUAL-COHERENCE-M       PIC 9(04) VALUE 0890.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-DNL-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-DNL-VITALITY           PIC 9(09) VALUE 0.
           05 WS-DNL-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-DNL-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-DNL-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 DELAY-SPREAD-UNDERFLOW      VALUE 2.
              88 DUAL-SIR-LOW                VALUE 3.
              88 DUAL-COHERENCE-LOW          VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 CONDUCTION-COLLAPSE         VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-DUAL-CONDUCTION
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-PROPAGATION-DELAY-T < 280 OR WS-PROPAGATION-DELAY-T > 800
                SET DELAY-SPREAD-UNDERFLOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-DUAL-SIR-TENTHS-DB < 160 OR WS-DUAL-SIR-TENTHS-DB > 400
                SET DUAL-SIR-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-DUAL-COHERENCE-M < 600 OR WS-DUAL-COHERENCE-M > 1000
                SET DUAL-COHERENCE-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-DUAL-CONDUCTION.
            COMPUTE WS-DNL-COMPOSITE = (WS-PROPAGATION-DELAY-T / 2) +
                                       (WS-DUAL-SIR-TENTHS-DB * 4) +
                                       (WS-DUAL-COHERENCE-M / 2).

            COMPUTE WS-DNL-VITALITY = (WS-DNL-COMPOSITE / 4) +
                                      (WS-DUAL-COHERENCE-M / 4) +
                                      (WS-DUAL-SIR-TENTHS-DB / 2) + 1.

            IF WS-DNL-VITALITY EQUAL ZERO
                SET CONDUCTION-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-DNL-COHERENCE = (WS-DNL-COMPOSITE / 16) +
                                       (WS-DUAL-COHERENCE-M / 16) +
                                       (WS-DUAL-SIR-TENTHS-DB / 8).

            COMPUTE WS-DNL-REBAR-LATCH = 1470169088 +
                                         (WS-DNL-COMPOSITE / 2) +
                                         (WS-DUAL-SIR-TENTHS-DB * 32).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-DNL-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-DNL-VITALITY * 10) +
                                         (WS-DNL-COHERENCE * 10) +
                                         (WS-DNL-COMPOSITE * 10) +
                                         (WS-DNL-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-DNL-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-DNL-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
