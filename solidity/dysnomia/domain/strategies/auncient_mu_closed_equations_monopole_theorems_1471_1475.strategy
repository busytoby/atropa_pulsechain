        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-CLOSED-EQ.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-CLOSED-EQ-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1471-PROVENANCE-OK     PIC 9(01) VALUE 1.
            05  WS-TH1472-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1473-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1474-1475M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1475-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-CLOSED-EQ-WIT            PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-CLOSED-EQ.
            GOBACK.
        1000-EVALUATE-CLOSED-EQ.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1471-PROVENANCE-OK = 1 AND
               WS-TH1472-DATBIN-STRAT-OK = 1 AND
               WS-TH1473-SUBMICRO-LAT-OK = 1 AND
               WS-TH1474-1475M-SAAT-OK = 1 AND
               WS-TH1475-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-CLOSED-EQ-WIT
            ELSE
                MOVE 0 TO WS-CLOSED-EQ-WIT.
