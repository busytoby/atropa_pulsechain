        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-BEYOND-755.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-BEYOND-755-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH756-PHONON-ABI-OK      PIC 9(01) VALUE 1.
            05  WS-TH757-WMQ-ANKH-OK        PIC 9(01) VALUE 1.
            05  WS-TH758-DISPATCH-LAT-OK    PIC 9(01) VALUE 1.
            05  WS-TH759-760M-SAAT-OK       PIC 9(01) VALUE 1.
            05  WS-TH760-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-BEYOND-755-WIT      PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-BEYOND-755.
            GOBACK.
        1000-EVALUATE-BEYOND-755.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH756-PHONON-ABI-OK = 1 AND
               WS-TH757-WMQ-ANKH-OK = 1 AND
               WS-TH758-DISPATCH-LAT-OK = 1 AND
               WS-TH759-760M-SAAT-OK = 1 AND
               WS-TH760-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-BEYOND-755-WIT
            ELSE
                MOVE 0 TO WS-FPGA-BEYOND-755-WIT.
