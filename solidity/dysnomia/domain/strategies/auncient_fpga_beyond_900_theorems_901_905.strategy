        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-BEYOND-900.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-BEYOND-900-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH901-ZORSE-TREE-OK      PIC 9(01) VALUE 1.
            05  WS-TH902-TREE-MERKLE-OK     PIC 9(01) VALUE 1.
            05  WS-TH903-TREE-VERIF-LAT-OK  PIC 9(01) VALUE 1.
            05  WS-TH904-905M-SAAT-OK       PIC 9(01) VALUE 1.
            05  WS-TH905-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-BEYOND-900-WIT      PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-BEYOND-900.
            GOBACK.
        1000-EVALUATE-BEYOND-900.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH901-ZORSE-TREE-OK = 1 AND
               WS-TH902-TREE-MERKLE-OK = 1 AND
               WS-TH903-TREE-VERIF-LAT-OK = 1 AND
               WS-TH904-905M-SAAT-OK = 1 AND
               WS-TH905-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-BEYOND-900-WIT
            ELSE
                MOVE 0 TO WS-FPGA-BEYOND-900-WIT.
