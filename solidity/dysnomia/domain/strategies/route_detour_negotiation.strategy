        IDENTIFICATION DIVISION.
        PROGRAM-ID. RDN-DET-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / ROUTE DETOUR NEGOTIATION AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-RDN-PARAMS.
           05 WS-COMPUTE-LAT-MS         PIC 9(02) VALUE 20.
           05 WS-ATTRACT-FIDELITY-M     PIC 9(04) VALUE 0960.
           05 WS-VETO-ACCEPT-LAT-MS     PIC 9(02) VALUE 04.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-RDN-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-RDN-VITALITY           PIC 9(09) VALUE 0.
           05 WS-RDN-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-RDN-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-RDN-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 COMPUTE-LAT-OUT-OF-BOUNDS   VALUE 2.
              88 ATTRACT-FIDELITY-LOW        VALUE 3.
              88 VETO-ACCEPT-OUT-OF-BOUNDS   VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 NEGOTIATION-COLLAPSE        VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-DETOUR-NEGOTIATE
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-COMPUTE-LAT-MS < 10 OR WS-COMPUTE-LAT-MS > 50
                SET COMPUTE-LAT-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-ATTRACT-FIDELITY-M < 850 OR WS-ATTRACT-FIDELITY-M > 1000
                SET ATTRACT-FIDELITY-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-VETO-ACCEPT-LAT-MS < 1 OR WS-VETO-ACCEPT-LAT-MS > 10
                SET VETO-ACCEPT-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-DETOUR-NEGOTIATE.
            COMPUTE WS-RDN-COMPOSITE = ((60 - WS-COMPUTE-LAT-MS) * 10) +
                                       (WS-ATTRACT-FIDELITY-M / 2) +
                                       ((15 - WS-VETO-ACCEPT-LAT-MS) * 20).

            COMPUTE WS-RDN-VITALITY = (WS-RDN-COMPOSITE / 4) +
                                      (WS-ATTRACT-FIDELITY-M / 4) +
                                      ((60 - WS-COMPUTE-LAT-MS) * 4) + 1.

            IF WS-RDN-VITALITY EQUAL ZERO
                SET NEGOTIATION-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-RDN-COHERENCE = (WS-RDN-COMPOSITE / 16) +
                                       (WS-ATTRACT-FIDELITY-M / 16) +
                                       ((60 - WS-COMPUTE-LAT-MS) * 2).

            COMPUTE WS-RDN-REBAR-LATCH = 1470169088 +
                                         (WS-RDN-COMPOSITE / 2) +
                                         ((60 - WS-COMPUTE-LAT-MS) * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-RDN-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-RDN-VITALITY * 10) +
                                         (WS-RDN-COHERENCE * 10) +
                                         (WS-RDN-COMPOSITE * 10) +
                                         (WS-RDN-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-RDN-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-RDN-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
