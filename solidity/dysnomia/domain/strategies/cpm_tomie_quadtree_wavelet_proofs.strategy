       IDENTIFICATION DIVISION.
       PROGRAM-ID. CPM-TOMIE-QUADTREE-WAVELET.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-QUADTREE-WAVELET-PROOFS.
           05  WS-BINARY-SLICING-OK        PIC 9(01) VALUE 1.
           05  WS-LOD-CONTINUITY-OK        PIC 9(01) VALUE 1.
           05  WS-COAXIAL-STREAMING-OK     PIC 9(01) VALUE 1.
           05  WS-QUADTREE-LATENCY-OK      PIC 9(01) VALUE 1.
           05  WS-QUADTREE-SEAL-OK         PIC 9(01) VALUE 1.
       01  WS-QUADTREE-SYNTHESIS.
           05  WS-ALL-QDT-PROVEN           PIC 9(01) VALUE 1.
           05  WS-TOTAL-QDT-CODE           PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-EVALUATE-SLICING-AND-LOD.
           PERFORM 2000-EVALUATE-STREAM-AND-LATENCY.
           PERFORM 3000-SYNTHESIZE-QDT-PROOFS.
           GOBACK.
       1000-EVALUATE-SLICING-AND-LOD.
           MOVE 1 TO WS-BINARY-SLICING-OK.
           MOVE 1 TO WS-LOD-CONTINUITY-OK.
       2000-EVALUATE-STREAM-AND-LATENCY.
           MOVE 1 TO WS-COAXIAL-STREAMING-OK.
           MOVE 1 TO WS-QUADTREE-LATENCY-OK.
       3000-SYNTHESIZE-QDT-PROOFS.
           IF WS-BINARY-SLICING-OK = 1 AND
              WS-LOD-CONTINUITY-OK = 1 AND
              WS-COAXIAL-STREAMING-OK = 1 AND
              WS-QUADTREE-LATENCY-OK = 1
               MOVE 1 TO WS-QUADTREE-SEAL-OK
               MOVE 1 TO WS-ALL-QDT-PROVEN
               MOVE 1 TO WS-TOTAL-QDT-CODE
           ELSE
               MOVE 0 TO WS-ALL-QDT-PROVEN
               MOVE 0 TO WS-TOTAL-QDT-CODE.
