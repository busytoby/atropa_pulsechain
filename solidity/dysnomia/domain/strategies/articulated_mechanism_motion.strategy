        IDENTIFICATION DIVISION.
        PROGRAM-ID. AMM-MOT-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / ARTICULATED MECHANISM MOTION AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-AMM-PARAMS.
           05 WS-SOLVE-LAT-MS           PIC 9(02) VALUE 20.
           05 WS-RANGE-FID-M            PIC 9(04) VALUE 0960.
           05 WS-JOINT-COUNT            PIC 9(02) VALUE 06.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-AMM-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-AMM-VITALITY           PIC 9(09) VALUE 0.
           05 WS-AMM-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-AMM-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-AMM-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 SOLVE-LAT-OUT-OF-BOUNDS     VALUE 2.
              88 RANGE-FID-LOW               VALUE 3.
              88 JOINT-COUNT-OUT-OF-BOUNDS   VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 KINEMATIC-COLLAPSE          VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-MECHANISM-MOTION
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-SOLVE-LAT-MS < 10 OR WS-SOLVE-LAT-MS > 50
                SET SOLVE-LAT-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-RANGE-FID-M < 850 OR WS-RANGE-FID-M > 1000
                SET RANGE-FID-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-JOINT-COUNT < 1 OR WS-JOINT-COUNT > 12
                SET JOINT-COUNT-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-MECHANISM-MOTION.
            COMPUTE WS-AMM-COMPOSITE = ((60 - WS-SOLVE-LAT-MS) * 10) +
                                       (WS-RANGE-FID-M / 2) +
                                       (WS-JOINT-COUNT * 25).

            COMPUTE WS-AMM-VITALITY = (WS-AMM-COMPOSITE / 4) +
                                      (WS-RANGE-FID-M / 4) +
                                      ((60 - WS-SOLVE-LAT-MS) * 4) + 1.

            IF WS-AMM-VITALITY EQUAL ZERO
                SET KINEMATIC-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-AMM-COHERENCE = (WS-AMM-COMPOSITE / 16) +
                                       (WS-RANGE-FID-M / 16) +
                                       ((60 - WS-SOLVE-LAT-MS) * 2).

            COMPUTE WS-AMM-REBAR-LATCH = 1470169088 +
                                         (WS-AMM-COMPOSITE / 2) +
                                         ((60 - WS-SOLVE-LAT-MS) * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-AMM-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-AMM-VITALITY * 10) +
                                         (WS-AMM-COHERENCE * 10) +
                                         (WS-AMM-COMPOSITE * 10) +
                                         (WS-AMM-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-AMM-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-AMM-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
