IDENTIFICATION DIVISION.
PROGRAM-ID. PROG-DUAL-PASS-SSS-VENATION.

DATA DIVISION.
01 D0-SUBSTRATE-TRUNK.
   05 D0-MOTZKIN-PRIME     PIC 9(9) USAGE R0.
   05 D0-K-EXPONENT        PIC 9(9) USAGE R1.
   05 D0-ENERGY-LIMIT-Q16  PIC 9(9) USAGE R2.
01 D1-PETAL-INPUTS.
   05 D1-FLOWER-DENSITY-Q16 PIC 9(9) USAGE R3.
   05 D1-NORMAL-MAG-Q16    PIC 9(9) USAGE R4.
   05 D1-SHADOW-DENSITY    PIC 9(9) USAGE R5.
01 D2-SSS-FRESNEL-EVAL.
   05 D2-SSS-THROUGH-Q16   PIC 9(9) USAGE R6.
   05 D2-SSS-INTERNAL-Q16  PIC 9(9) USAGE R7.
   05 D2-FRESNEL-RIM-Q16   PIC 9(9) USAGE R8.
   05 D2-TOTAL-RADIANCE    PIC 9(9) USAGE R9.
   05 D2-G-SWIGLU-GATE     PIC 9(9) USAGE R10.
   05 D2-COMMITTED-STATE   PIC 9(9) USAGE R11.
01 D3-LEAF-EVAL.
   05 D3-PROOF-RULING      PIC 9(9) USAGE R12.
   05 D3-DISP-WRAP-MOD     PIC 9(9) USAGE R13.

PROCEDURE DIVISION.
    MOVE 953467954 TO D0-MOTZKIN-PRIME.
    MOVE 3 TO D0-K-EXPONENT.
    MOVE 196608 TO D0-ENERGY-LIMIT-Q16.
    MOVE 131072 TO D1-FLOWER-DENSITY-Q16.
    MOVE 16384 TO D1-NORMAL-MAG-Q16.

    PERFORM STAGE-SSS-CALCULATION.
    PERFORM STAGE-FRESNEL-RIM.
    PERFORM EVALUATE-COMMIT.
    PERFORM SYNC-DISPLACEMENT.

    IF D1-SHADOW-DENSITY == D1-FLOWER-DENSITY-Q16 AND D2-TOTAL-RADIANCE <= D0-ENERGY-LIMIT-Q16
        MOVE 0 TO D3-PROOF-RULING
        SET depth 4
    ELSE
        MOVE 5 TO D3-PROOF-RULING
        SET depth 1
    END-IF.

    EVAL.
    GO TO END-STRATEGY.

STAGE-SSS-CALCULATION.
    MOVE D1-FLOWER-DENSITY-Q16 TO D1-SHADOW-DENSITY.
    COMPUTE D2-SSS-THROUGH-Q16 = 65536 - ((D1-FLOWER-DENSITY-Q16 * 5243) / 65536).
    COMPUTE D2-SSS-INTERNAL-Q16 = ((65536 - ((D1-FLOWER-DENSITY-Q16 * 13107) / 65536)) * 26214) / 65536.
    EXIT.

STAGE-FRESNEL-RIM.
    COMPUTE D2-FRESNEL-RIM-Q16 = (65536 - D1-NORMAL-MAG-Q16).
    COMPUTE D2-FRESNEL-RIM-Q16 = (D2-FRESNEL-RIM-Q16 * D2-FRESNEL-RIM-Q16) / 65536.
    COMPUTE D2-TOTAL-RADIANCE = D2-SSS-THROUGH-Q16 + D2-SSS-INTERNAL-Q16 + D2-FRESNEL-RIM-Q16.
    COMPUTE D2-G-SWIGLU-GATE = 875 + ((125 * D2-TOTAL-RADIANCE) / D0-ENERGY-LIMIT-Q16).
    EXIT.

EVALUATE-COMMIT.
    COMPUTE D2-COMMITTED-STATE = (((D2-TOTAL-RADIANCE * 1000 + 43605) * D2-G-SWIGLU-GATE) / 1000).
    EXIT.

SYNC-DISPLACEMENT.
    COMPUTE D3-DISP-WRAP-MOD = D2-COMMITTED-STATE - ((D2-COMMITTED-STATE / 256) * 256).
    EXIT.

END-STRATEGY.
