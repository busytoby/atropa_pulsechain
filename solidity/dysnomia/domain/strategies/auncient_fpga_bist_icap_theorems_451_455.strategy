        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-BIST-ICAP.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-BIST-ICAP-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH451-BIST-LUT-OK        PIC 9(01) VALUE 1.
            05  WS-TH452-ICAP-SCRUB-OK      PIC 9(01) VALUE 1.
            05  WS-TH453-ILA-TRACE-OK       PIC 9(01) VALUE 1.
            05  WS-TH454-BIST-SAAT-OK       PIC 9(01) VALUE 1.
            05  WS-TH455-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-BIST-ICAP-WIT       PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-BIST-ICAP.
            GOBACK.
        1000-EVALUATE-BIST-ICAP.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH451-BIST-LUT-OK = 1 AND
               WS-TH452-ICAP-SCRUB-OK = 1 AND
               WS-TH453-ILA-TRACE-OK = 1 AND
               WS-TH454-BIST-SAAT-OK = 1 AND
               WS-TH455-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-BIST-ICAP-WIT
            ELSE
                MOVE 0 TO WS-FPGA-BIST-ICAP-WIT.
