       IDENTIFICATION DIVISION.
       PROGRAM-ID. LYAPUNOV-KERMIT-STRAT.
       AUTHOR. AUNCIENT DYSNOMIA VM / KERMIT TRANSPORT.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-KERMIT-PARAMS.
          05 WS-WINDOW-SIZE-W          PIC 9(02) VALUE 08.
          05 WS-CHANNEL-LOSS-PCT       PIC 9(02) VALUE 20.
          05 WS-TRANSPORT-CYCLES-N     PIC 9(02) VALUE 16.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-INIT-UNACKED-BUF       PIC 9(05) VALUE 0.
          05 WS-CURRENT-UNACKED        PIC 9(05) VALUE 0.
          05 WS-STEP-IDX               PIC 9(02) VALUE 0.
          05 WS-SHADOW-KERMIT-BASE     PIC 9(12) VALUE 0.
          05 WS-CYC-MOD                PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-WINDOW-SIZE         VALUE 2.
             88 INVALID-LOSS-RATE           VALUE 3.
             88 INVALID-TRANSPORT-CYCLES    VALUE 4.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
             88 PACKET-RETRY-DIVERG-FAIL    VALUE 6.
             88 GATING-CLAMP-OVERFLOW       VALUE 7.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 8.
             88 CASCADE-ROLLBACK-FAIL       VALUE 9.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-KERMIT-ARQ
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-WINDOW-SIZE-W < 1 OR WS-WINDOW-SIZE-W > 16
               SET INVALID-WINDOW-SIZE TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CHANNEL-LOSS-PCT > 50
               SET INVALID-LOSS-RATE TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-TRANSPORT-CYCLES-N < 1 OR WS-TRANSPORT-CYCLES-N > 64
               SET INVALID-TRANSPORT-CYCLES TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-KERMIT-ARQ.
           COMPUTE WS-INIT-UNACKED-BUF = (WS-WINDOW-SIZE-W * 1000) + (WS-CHANNEL-LOSS-PCT * 200).
           MOVE WS-INIT-UNACKED-BUF TO WS-CURRENT-UNACKED.

           PERFORM VARYING WS-STEP-IDX FROM 1 BY 1 UNTIL WS-STEP-IDX > WS-TRANSPORT-CYCLES-N
               COMPUTE WS-CURRENT-UNACKED = (WS-CURRENT-UNACKED * 875) / 1000
           END-PERFORM.

           IF WS-CURRENT-UNACKED > WS-INIT-UNACKED-BUF
               SET PACKET-RETRY-DIVERG-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-SHADOW-KERMIT-BASE = (WS-CICS-WRITER-ID * 1000000) + 
               (WS-TRANSPORT-CYCLES-N * 10000) + (WS-WINDOW-SIZE-W * 100) + (WS-CURRENT-UNACKED / 16).

           COMPUTE WS-CYC-MOD = FUNCTION MOD(WS-WINDOW-SIZE-W, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-CYC-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-KERMIT-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-KERMIT-BASE + ((WS-CURRENT-UNACKED * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-KERMIT-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-TRANSPORT-CYCLES-N * 10000) + (WS-WINDOW-SIZE-W * 100) + (WS-CURRENT-UNACKED / 16))
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-KERMIT-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
