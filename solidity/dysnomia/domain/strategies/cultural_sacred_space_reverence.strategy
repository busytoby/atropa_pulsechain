        IDENTIFICATION DIVISION.
        PROGRAM-ID. CSR-REV-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / CULTURAL SACRED SPACE REVERENCE AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-CSR-PARAMS.
           05 WS-GEOFENCE-LAT-MS        PIC 9(02) VALUE 20.
           05 WS-ACOUSTIC-SUPPRESS-M    PIC 9(04) VALUE 0960.
           05 WS-SOLEMN-POSTURE-M       PIC 9(04) VALUE 0950.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-CSR-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-CSR-VITALITY           PIC 9(09) VALUE 0.
           05 WS-CSR-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-CSR-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-CSR-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 GEOFENCE-OUT-OF-BOUNDS      VALUE 2.
              88 ACOUSTIC-SUPPRESS-LOW       VALUE 3.
              88 SOLEMN-POSTURE-LOW          VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 REVERENCE-COLLAPSE          VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-SACRED-REVERENCE
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-GEOFENCE-LAT-MS < 10 OR WS-GEOFENCE-LAT-MS > 50
                SET GEOFENCE-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-ACOUSTIC-SUPPRESS-M < 900 OR WS-ACOUSTIC-SUPPRESS-M > 1000
                SET ACOUSTIC-SUPPRESS-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-SOLEMN-POSTURE-M < 850 OR WS-SOLEMN-POSTURE-M > 1000
                SET SOLEMN-POSTURE-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-SACRED-REVERENCE.
            COMPUTE WS-CSR-COMPOSITE = ((60 - WS-GEOFENCE-LAT-MS) * 10) +
                                       (WS-ACOUSTIC-SUPPRESS-M / 2) +
                                       (WS-SOLEMN-POSTURE-M / 2).

            COMPUTE WS-CSR-VITALITY = (WS-CSR-COMPOSITE / 4) +
                                      (WS-ACOUSTIC-SUPPRESS-M / 4) +
                                      ((60 - WS-GEOFENCE-LAT-MS) * 4) + 1.

            IF WS-CSR-VITALITY EQUAL ZERO
                SET REVERENCE-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-CSR-COHERENCE = (WS-CSR-COMPOSITE / 16) +
                                       (WS-SOLEMN-POSTURE-M / 16) +
                                       ((60 - WS-GEOFENCE-LAT-MS) * 2).

            COMPUTE WS-CSR-REBAR-LATCH = 1470169088 +
                                         (WS-CSR-COMPOSITE / 2) +
                                         ((60 - WS-GEOFENCE-LAT-MS) * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-CSR-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-CSR-VITALITY * 10) +
                                         (WS-CSR-COHERENCE * 10) +
                                         (WS-CSR-COMPOSITE * 10) +
                                         (WS-CSR-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-CSR-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-CSR-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
