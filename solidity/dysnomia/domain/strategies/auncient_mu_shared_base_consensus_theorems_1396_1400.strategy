        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-SHARED-BASE.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-SHARED-BASE-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1396-CONSENSUS-OK      PIC 9(01) VALUE 1.
            05  WS-TH1397-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1398-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1399-1400M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1400-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-SHARED-BASE-WIT          PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-SHARED-BASE.
            GOBACK.
        1000-EVALUATE-SHARED-BASE.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1396-CONSENSUS-OK = 1 AND
               WS-TH1397-DATBIN-STRAT-OK = 1 AND
               WS-TH1398-SUBMICRO-LAT-OK = 1 AND
               WS-TH1399-1400M-SAAT-OK = 1 AND
               WS-TH1400-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-SHARED-BASE-WIT
            ELSE
                MOVE 0 TO WS-SHARED-BASE-WIT.
