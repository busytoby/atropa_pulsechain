       IDENTIFICATION DIVISION.
       PROGRAM-ID. LYAPUNOV-COCHLEAR-STRATEGY.
       AUTHOR. AUNCIENT DYSNOMIA VM / COCHLEAR ENERGY BOUNDS.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-COCHLEAR-PARAMS.
          05 WS-MEMBRANE-POS-X         PIC 9(02) VALUE 15.
          05 WS-ACOUSTIC-PRESSURE-P0   PIC 9(05) VALUE 05000.
          05 WS-FLUID-DAMPING-MU       PIC 9(03) VALUE 020.
          05 WS-WAVE-PROPAGATION-STEPS PIC 9(02) VALUE 16.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-RESONANT-FREQ-AT-X     PIC 9(06) VALUE 0.
          05 WS-CURRENT-DISPLACEMENT   PIC 9(05) VALUE 0.
          05 WS-STEP-IDX               PIC 9(02) VALUE 0.
          05 WS-FINAL-COCHLEAR-ENERGY  PIC 9(12) VALUE 0.
          05 WS-SHADOW-COCHLEA-BASE    PIC 9(12) VALUE 0.
          05 WS-CYC-MOD                PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-MEMBRANE-POS        VALUE 2.
             88 INVALID-ACOUSTIC-PRESSURE   VALUE 3.
             88 INVALID-FLUID-DAMPING       VALUE 4.
             88 INVALID-PROPAGATION-STEPS   VALUE 5.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 6.
             88 ACOUSTIC-TRAUMA-OVERFLOW    VALUE 7.
             88 GATING-CLAMP-OVERFLOW       VALUE 8.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 9.
             88 CASCADE-ROLLBACK-FAIL       VALUE 10.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-COCHLEAR-PROPAGATION
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-MEMBRANE-POS-X > 35
               SET INVALID-MEMBRANE-POS TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-ACOUSTIC-PRESSURE-P0 > 10000
               SET INVALID-ACOUSTIC-PRESSURE TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-FLUID-DAMPING-MU EQUAL ZERO OR WS-FLUID-DAMPING-MU > 100
               SET INVALID-FLUID-DAMPING TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-WAVE-PROPAGATION-STEPS < 1 OR WS-WAVE-PROPAGATION-STEPS > 64
               SET INVALID-PROPAGATION-STEPS TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-COCHLEAR-PROPAGATION.
           COMPUTE WS-RESONANT-FREQ-AT-X = 100 + ((35 - WS-MEMBRANE-POS-X) * 550).
           MOVE WS-ACOUSTIC-PRESSURE-P0 TO WS-CURRENT-DISPLACEMENT.

           PERFORM VARYING WS-STEP-IDX FROM 1 BY 1 UNTIL WS-STEP-IDX > WS-WAVE-PROPAGATION-STEPS
               COMPUTE WS-CURRENT-DISPLACEMENT = (WS-CURRENT-DISPLACEMENT * 875) / 1000
           END-PERFORM.

           IF WS-CURRENT-DISPLACEMENT > WS-ACOUSTIC-PRESSURE-P0
               SET ACOUSTIC-TRAUMA-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-FINAL-COCHLEAR-ENERGY = (WS-CURRENT-DISPLACEMENT * WS-CURRENT-DISPLACEMENT) / 2.

           COMPUTE WS-SHADOW-COCHLEA-BASE = (WS-CICS-WRITER-ID * 1000000) + 
               (WS-MEMBRANE-POS-X * 10000) + (WS-RESONANT-FREQ-AT-X / 4) + (WS-FINAL-COCHLEAR-ENERGY / 16).

           COMPUTE WS-CYC-MOD = FUNCTION MOD(WS-MEMBRANE-POS-X, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-CYC-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-COCHLEA-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-COCHLEA-BASE + ((WS-CURRENT-DISPLACEMENT * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-COCHLEA-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-MEMBRANE-POS-X * 10000) + (WS-RESONANT-FREQ-AT-X / 4) + (WS-FINAL-COCHLEAR-ENERGY / 16))
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-COCHLEA-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
