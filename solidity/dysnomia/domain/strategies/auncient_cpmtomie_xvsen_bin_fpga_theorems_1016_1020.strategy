        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-XVSEN-BIN.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-XVSEN-BIN-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1016-XVSEN-BIN-OK      PIC 9(01) VALUE 1.
            05  WS-TH1017-BRAM-QUEUE-OK     PIC 9(01) VALUE 1.
            05  WS-TH1018-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1019-1020M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1020-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-XVSEN-BIN-WIT            PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-XVSEN-BIN.
            GOBACK.
        1000-EVALUATE-XVSEN-BIN.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1016-XVSEN-BIN-OK = 1 AND
               WS-TH1017-BRAM-QUEUE-OK = 1 AND
               WS-TH1018-SUBMICRO-LAT-OK = 1 AND
               WS-TH1019-1020M-SAAT-OK = 1 AND
               WS-TH1020-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-XVSEN-BIN-WIT
            ELSE
                MOVE 0 TO WS-XVSEN-BIN-WIT.
