        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-SPEC.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-SPEC-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1091-SPEC-OK           PIC 9(01) VALUE 1.
            05  WS-TH1092-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1093-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1094-1095M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1095-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-FPGA-SPEC-WIT            PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-FPGA-SPEC.
            GOBACK.
        1000-EVALUATE-FPGA-SPEC.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1091-SPEC-OK = 1 AND
               WS-TH1092-DATBIN-STRAT-OK = 1 AND
               WS-TH1093-SUBMICRO-LAT-OK = 1 AND
               WS-TH1094-1095M-SAAT-OK = 1 AND
               WS-TH1095-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-FPGA-SPEC-WIT
            ELSE
                MOVE 0 TO WS-FPGA-SPEC-WIT.
