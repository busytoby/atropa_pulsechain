        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-POLYPHASE.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-POLYPHASE-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH271-ORTHOGONAL-OK      PIC 9(01) VALUE 1.
            05  WS-TH272-SU2-NORM-OK        PIC 9(01) VALUE 1.
            05  WS-TH273-SHADER-SYNC-OK     PIC 9(01) VALUE 1.
            05  WS-TH274-SAAT-FLOW-OK       PIC 9(01) VALUE 1.
            05  WS-TH275-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-POLYPHASE-WIT       PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-POLYPHASE.
            GOBACK.
        1000-EVALUATE-POLYPHASE.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH271-ORTHOGONAL-OK = 1 AND
               WS-TH272-SU2-NORM-OK = 1 AND
               WS-TH273-SHADER-SYNC-OK = 1 AND
               WS-TH274-SAAT-FLOW-OK = 1 AND
               WS-TH275-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-POLYPHASE-WIT
            ELSE
                MOVE 0 TO WS-FPGA-POLYPHASE-WIT.
