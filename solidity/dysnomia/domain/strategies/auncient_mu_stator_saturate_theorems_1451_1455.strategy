        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-STATOR-SATURATE.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-STATOR-SAT-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1451-SATURATE-OK       PIC 9(01) VALUE 1.
            05  WS-TH1452-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1453-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1454-1455M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1455-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-STATOR-SAT-WIT           PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-STATOR-SAT.
            GOBACK.
        1000-EVALUATE-STATOR-SAT.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1451-SATURATE-OK = 1 AND
               WS-TH1452-DATBIN-STRAT-OK = 1 AND
               WS-TH1453-SUBMICRO-LAT-OK = 1 AND
               WS-TH1454-1455M-SAAT-OK = 1 AND
               WS-TH1455-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-STATOR-SAT-WIT
            ELSE
                MOVE 0 TO WS-STATOR-SAT-WIT.
