       IDENTIFICATION DIVISION.
       PROGRAM-ID. CPM-TOMIE-SCSI-HANDSHAKE.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-SCSI-HANDSHAKE-PROOFS.
           05  WS-HANDSHAKE-OK             PIC 9(01) VALUE 1.
           05  WS-DMA-DEFENSE-OK           PIC 9(01) VALUE 1.
           05  WS-CHANNEL-ISOLATION-OK     PIC 9(01) VALUE 1.
           05  WS-SCSI-LATENCY-OK          PIC 9(01) VALUE 1.
           05  WS-SCSI-SEAL-OK             PIC 9(01) VALUE 1.
       01  WS-SCSI-SYNTHESIS.
           05  WS-ALL-SCSI-PROVEN          PIC 9(01) VALUE 1.
           05  WS-TOTAL-SCSI-CODE          PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-EVALUATE-REQ-AND-ACK.
           PERFORM 2000-EVALUATE-DMA-AND-LATENCY.
           PERFORM 3000-SYNTHESIZE-SCSI-PROOFS.
           GOBACK.
       1000-EVALUATE-REQ-AND-ACK.
           MOVE 1 TO WS-HANDSHAKE-OK.
           MOVE 1 TO WS-DMA-DEFENSE-OK.
       2000-EVALUATE-DMA-AND-LATENCY.
           MOVE 1 TO WS-CHANNEL-ISOLATION-OK.
           MOVE 1 TO WS-SCSI-LATENCY-OK.
       3000-SYNTHESIZE-SCSI-PROOFS.
           IF WS-HANDSHAKE-OK = 1 AND
              WS-DMA-DEFENSE-OK = 1 AND
              WS-CHANNEL-ISOLATION-OK = 1 AND
              WS-SCSI-LATENCY-OK = 1
               MOVE 1 TO WS-SCSI-SEAL-OK
               MOVE 1 TO WS-ALL-SCSI-PROVEN
               MOVE 1 TO WS-TOTAL-SCSI-CODE
           ELSE
               MOVE 0 TO WS-ALL-SCSI-PROVEN
               MOVE 0 TO WS-TOTAL-SCSI-CODE.
