        IDENTIFICATION DIVISION.
        PROGRAM-ID. LASALLE-LFM-CPM-ADVANCED-STRATEGY.
        AUTHOR. AUNCIENT DYSNOMIA VM / ADVANCED 4-PILLAR UI AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-ADV-PARAMETERS.
           05 WS-PBX-PULSE              PIC 9(02) VALUE 05.
           05 WS-TELETEXT-CHAR          PIC 9(03) VALUE 065.
           05 WS-ALPHA-BLEND-Q16        PIC 9(06) VALUE 032768.
           05 WS-FRAME-MERKLE-DEPTH     PIC 9(02) VALUE 05.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-BETA-BLEND-Q16         PIC 9(06) VALUE 0.
           05 WS-PBX-DAMPED-STATE       PIC 9(09) VALUE 0.
           05 WS-TELETEXT-SCANLINE-H    PIC 9(09) VALUE 0.
           05 WS-MERKLE-ROOT-LATCH      PIC 9(12) VALUE 0.
           05 WS-SHADOW-ADV-BASELINE    PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 INVALID-PBX-PULSE           VALUE 2.
              88 INVALID-TELETEXT-CHAR       VALUE 3.
              88 INVALID-ALPHA-BLEND         VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 THERMODYNAMIC-LEAK          VALUE 6.
              88 MERKLE-DEPTH-OVERFLOW       VALUE 7.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 8.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-EXECUTE-4-PILLARS
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-PBX-PULSE < 1 OR WS-PBX-PULSE > 10
                SET INVALID-PBX-PULSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-TELETEXT-CHAR > 127
                SET INVALID-TELETEXT-CHAR TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-ALPHA-BLEND-Q16 > 65536
                SET INVALID-ALPHA-BLEND TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-EXECUTE-4-PILLARS.
            COMPUTE WS-PBX-DAMPED-STATE = (WS-PBX-PULSE * 1000) - ((WS-PBX-PULSE * WS-PBX-PULSE * 50) / 10).
            COMPUTE WS-TELETEXT-SCANLINE-H = ((WS-TELETEXT-CHAR * 512) / 64) + ((WS-TELETEXT-CHAR * WS-TELETEXT-CHAR) / 128).
            COMPUTE WS-BETA-BLEND-Q16 = 65536 - WS-ALPHA-BLEND-Q16.

            IF (WS-ALPHA-BLEND-Q16 + WS-BETA-BLEND-Q16) NOT EQUAL 65536
                SET THERMODYNAMIC-LEAK TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-FRAME-MERKLE-DEPTH < 1 OR WS-FRAME-MERKLE-DEPTH > 16
                SET MERKLE-DEPTH-OVERFLOW TO TRUE
                EXIT PARAGRAPH
            END-IF.
            COMPUTE WS-MERKLE-ROOT-LATCH = 1470169088 + (WS-FRAME-MERKLE-DEPTH * 64) + (WS-PBX-PULSE * 4).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-ADV-BASELINE = (WS-CICS-WRITER-ID * 1000000) +
                                             (WS-PBX-DAMPED-STATE * 10) +
                                             (WS-TELETEXT-SCANLINE-H * 2) +
                                             (WS-MERKLE-ROOT-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-ADV-BASELINE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-ADV-BASELINE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
