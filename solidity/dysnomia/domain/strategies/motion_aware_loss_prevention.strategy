        IDENTIFICATION DIVISION.
        PROGRAM-ID. MOT-LOSS-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / MOTION-AWARE LOSS AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-LOSS-PARAMS.
           05 WS-CUMUL-DISP-MILLI       PIC 9(04) VALUE 1250.
           05 WS-WEIGHTED-MSE-MILLI     PIC 9(04) VALUE 0120.
           05 WS-DISP-LOSS-MILLI        PIC 9(04) VALUE 0080.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-FINAL-COMB-LOSS        PIC 9(04) VALUE 0.
           05 WS-LOSS-VITALITY          PIC 9(09) VALUE 0.
           05 WS-LOSS-COHERENCE         PIC 9(09) VALUE 0.
           05 WS-LOSS-REBAR-LATCH       PIC 9(12) VALUE 0.
           05 WS-SHADOW-LOSS-BASE       PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 INVALID-DISPLACEMENT        VALUE 2.
              88 INVALID-LOSS-TERMS          VALUE 3.
              88 FINAL-LOSS-EXCEEDED         VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 LOSS-VITALITY-COLLAPSE      VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-LOSS-PREVENTION
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CUMUL-DISP-MILLI < 50 OR WS-CUMUL-DISP-MILLI > 5000
                SET INVALID-DISPLACEMENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-WEIGHTED-MSE-MILLI < 1 OR WS-WEIGHTED-MSE-MILLI > 1000 OR
               WS-DISP-LOSS-MILLI < 1 OR WS-DISP-LOSS-MILLI > 1000
                SET INVALID-LOSS-TERMS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-FINAL-COMB-LOSS = ((WS-WEIGHTED-MSE-MILLI * 9) +
                                          (WS-DISP-LOSS-MILLI * 1)) / 10.

            IF WS-FINAL-COMB-LOSS > 500
                SET FINAL-LOSS-EXCEEDED TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-LOSS-PREVENTION.
            COMPUTE WS-LOSS-VITALITY = ((500 - WS-FINAL-COMB-LOSS) / 2) +
                                       (WS-CUMUL-DISP-MILLI / 32) + 1.

            IF WS-LOSS-VITALITY EQUAL ZERO
                SET LOSS-VITALITY-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-LOSS-COHERENCE = ((500 - WS-FINAL-COMB-LOSS) / 8) +
                                        (WS-CUMUL-DISP-MILLI / 128).

            COMPUTE WS-LOSS-REBAR-LATCH = 1470169088 +
                                          ((500 - WS-FINAL-COMB-LOSS) * 8) +
                                          (WS-CUMUL-DISP-MILLI / 4).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-LOSS-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                          (WS-LOSS-VITALITY * 10) +
                                          (WS-LOSS-COHERENCE * 10) +
                                          ((500 - WS-FINAL-COMB-LOSS) * 10) +
                                          (WS-LOSS-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-LOSS-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-LOSS-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
