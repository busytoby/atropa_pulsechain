       IDENTIFICATION DIVISION.
       PROGRAM-ID. HARVARD-WHEEL-COMMUTATOR-STRATEGY.
       AUTHOR. AUNCIENT DYSNOMIA VM / HARVARD I-LAB TOTIENT AUDIT.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-HARVARD-PARAMETERS.
          05 WS-INITIAL-WHEEL-VAL      PIC 9(12) VALUE 0001000000.
          05 WS-VALVE-COUNT            PIC 9(02) VALUE 04.
          05 WS-COMMUTATOR-PHASE-T     PIC 9(02) VALUE 04.
          05 WS-BESSEL-X-Q16           PIC 9(06) VALUE 000256.
          05 WS-SIMULATE-LATCH-TRIP    PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-ROOT-SHADOW-WHEEL      PIC 9(12) VALUE 0.
          05 WS-ACCUMULATED-WHEEL      PIC 9(12) VALUE 0.
          05 WS-CURRENT-VALVE          PIC 9(02) VALUE 0.
          05 WS-G-GATE-K               PIC 9(04) VALUE 0.
          05 WS-STRATEGY-QUANTA-K      PIC 9(09) VALUE 0.
          05 WS-DELTA-CHARGE-K         PIC 9(09) VALUE 0.
          05 WS-J0-VAL                 PIC 9(09) VALUE 0.
          05 WS-J1-VAL                 PIC 9(09) VALUE 0.
          05 WS-BESSEL-DIFF            PIC 9(09) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-INITIAL-DIGITS      VALUE 2.
             88 INVALID-VALVE-COUNT         VALUE 3.
             88 INVALID-COMMUTATOR-PHASE    VALUE 4.
             88 BESSEL-RECURRENCE-FAIL      VALUE 5.
             88 GATING-CLAMP-OVERFLOW       VALUE 6.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 7.
             88 CASCADE-ROLLBACK-FAIL       VALUE 8.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-WHEEL-SYNTHESIS
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-INITIAL-WHEEL-VAL EQUAL ZERO
               SET INVALID-INITIAL-DIGITS TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-VALVE-COUNT < 1 OR WS-VALVE-COUNT > 8
               SET INVALID-VALVE-COUNT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-COMMUTATOR-PHASE-T > 9
               SET INVALID-COMMUTATOR-PHASE TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-J0-VAL = 65536 - ((WS-BESSEL-X-Q16 * WS-BESSEL-X-Q16) / 262144).
           COMPUTE WS-J1-VAL = (WS-BESSEL-X-Q16 / 2) - ((WS-BESSEL-X-Q16 * WS-BESSEL-X-Q16 * WS-BESSEL-X-Q16) / 1048576).

           IF (WS-J0-VAL + WS-J1-VAL) >= 65536
               COMPUTE WS-BESSEL-DIFF = (WS-J0-VAL + WS-J1-VAL) - 65536
           ELSE
               COMPUTE WS-BESSEL-DIFF = 65536 - (WS-J0-VAL + WS-J1-VAL)
           END-IF.

           IF WS-BESSEL-DIFF > 5000
               SET BESSEL-RECURRENCE-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-WHEEL-SYNTHESIS.
           MOVE WS-INITIAL-WHEEL-VAL TO WS-ROOT-SHADOW-WHEEL.
           MOVE WS-INITIAL-WHEEL-VAL TO WS-ACCUMULATED-WHEEL.

           PERFORM VARYING WS-CURRENT-VALVE FROM 1 BY 1
                   UNTIL WS-CURRENT-VALVE > WS-VALVE-COUNT
               IF WS-COMMUTATOR-PHASE-T EQUAL 0 OR WS-COMMUTATOR-PHASE-T EQUAL 9
                   MOVE 0 TO WS-DELTA-CHARGE-K
               ELSE
                   COMPUTE WS-G-GATE-K = 875 + ((125 * WS-COMMUTATOR-PHASE-T) / 8)
                   IF WS-G-GATE-K < 875 OR WS-G-GATE-K > 1000
                       SET GATING-CLAMP-OVERFLOW TO TRUE
                       EXIT PARAGRAPH
                   END-IF

                   COMPUTE WS-STRATEGY-QUANTA-K = WS-CURRENT-VALVE * 10000
                   COMPUTE WS-DELTA-CHARGE-K = (((WS-STRATEGY-QUANTA-K + (WS-J0-VAL / 64)) * WS-G-GATE-K) / 1000)
                   COMPUTE WS-ACCUMULATED-WHEEL = WS-ACCUMULATED-WHEEL + WS-DELTA-CHARGE-K
               END-IF
           END-PERFORM.

           IF WS-SIMULATE-LATCH-TRIP EQUAL 'Y'
               MOVE WS-ROOT-SHADOW-WHEEL TO WS-COMMITTED-OUTPUT
           ELSE
               MOVE WS-ACCUMULATED-WHEEL TO WS-COMMITTED-OUTPUT
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-ROOT-SHADOW-WHEEL NOT EQUAL WS-INITIAL-WHEEL-VAL
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-LATCH-TRIP EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-ROOT-SHADOW-WHEEL
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
