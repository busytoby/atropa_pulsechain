        IDENTIFICATION DIVISION.
        PROGRAM-ID. SUPER8-WYSIWYG-OPTICAL-STRATEGY.
        AUTHOR. AUNCIENT DYSNOMIA VM / SUPER8 AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-SUPER8-PARAMETERS.
           05 WS-EXPOSURE-LUX-Q16       PIC 9(06) VALUE 032768.
           05 WS-PAGE-COL-COUNT         PIC 9(02) VALUE 80.
           05 WS-OPTICAL-TRACK-WIDTH    PIC 9(03) VALUE 150.
           05 WS-FRAME-RATE-FPS         PIC 9(02) VALUE 24.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-FILM-DENSITY-D         PIC 9(06) VALUE 0.
           05 WS-PLANAR-LAYOUT-AREA     PIC 9(06) VALUE 0.
           05 WS-OPTICAL-REBAR-LATCH    PIC 9(12) VALUE 0.
           05 WS-SHADOW-SUPER8-BASE     PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 INVALID-EXPOSURE-LUX        VALUE 2.
              88 INVALID-PAGE-COLS           VALUE 3.
              88 INVALID-OPTICAL-TRACK       VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 INVALID-FRAME-RATE          VALUE 6.
              88 DENSITY-UNDERFLOW-FAIL      VALUE 7.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 8.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-SUPER8-OPTICAL
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-EXPOSURE-LUX-Q16 > 65536
                SET INVALID-EXPOSURE-LUX TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-PAGE-COL-COUNT NOT EQUAL 40 AND
               WS-PAGE-COL-COUNT NOT EQUAL 80
                SET INVALID-PAGE-COLS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-OPTICAL-TRACK-WIDTH < 10 OR WS-OPTICAL-TRACK-WIDTH > 500
                SET INVALID-OPTICAL-TRACK TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-FRAME-RATE-FPS NOT EQUAL 18 AND
               WS-FRAME-RATE-FPS NOT EQUAL 24
                SET INVALID-FRAME-RATE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-SUPER8-OPTICAL.
            COMPUTE WS-FILM-DENSITY-D = 150 + ((WS-EXPOSURE-LUX-Q16 * 875) / 10000) + 1.

            IF WS-FILM-DENSITY-D EQUAL ZERO
                SET DENSITY-UNDERFLOW-FAIL TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-PLANAR-LAYOUT-AREA = (WS-PAGE-COL-COUNT * 25) + (WS-OPTICAL-TRACK-WIDTH * 2).
            COMPUTE WS-OPTICAL-REBAR-LATCH = 1470169088 + (WS-OPTICAL-TRACK-WIDTH * 64) +
                                             (WS-PAGE-COL-COUNT * 8) + WS-FRAME-RATE-FPS.

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-SUPER8-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                            (WS-FILM-DENSITY-D * 100) +
                                            (WS-PLANAR-LAYOUT-AREA * 10) +
                                            (WS-FRAME-RATE-FPS * 1000) +
                                            (WS-OPTICAL-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-SUPER8-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-SUPER8-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
