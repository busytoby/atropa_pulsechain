        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-VSEN-KERMIT.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-VSEN-KERMIT-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1796-KERMIT-SEQ-OK     PIC 9(01) VALUE 1.
            05  WS-TH1797-MERKLE-TRANS-OK   PIC 9(01) VALUE 1.
            05  WS-TH1798-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1799-1800M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1800-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-VSEN-KERMIT-WIT          PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-VSEN-KERMIT.
            GOBACK.
        1000-EVALUATE-VSEN-KERMIT.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1796-KERMIT-SEQ-OK = 1 AND
               WS-TH1797-MERKLE-TRANS-OK = 1 AND
               WS-TH1798-SUBMICRO-LAT-OK = 1 AND
               WS-TH1799-1800M-SAAT-OK = 1 AND
               WS-TH1800-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-VSEN-KERMIT-WIT
            ELSE
                MOVE 0 TO WS-VSEN-KERMIT-WIT.
