        IDENTIFICATION DIVISION.
        PROGRAM-ID. TVS-VEL-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / TEMPORAL VELOCITY SCALING AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-TVS-PARAMS.
           05 WS-VELOCITY-LAT-MS        PIC 9(02) VALUE 12.
           05 WS-CONTINUITY-FID-M       PIC 9(04) VALUE 0960.
           05 WS-ACCEL-JITTER-M         PIC 9(02) VALUE 01.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-TVS-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-TVS-VITALITY           PIC 9(09) VALUE 0.
           05 WS-TVS-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-TVS-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-TVS-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 VELOCITY-LAT-OUT-OF-BOUNDS  VALUE 2.
              88 CONTINUITY-FIDELITY-LOW     VALUE 3.
              88 JITTER-EXCEEDED             VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 VELOCITY-COLLAPSE           VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-TEMPORAL-VELOCITY
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3 AND WS-K-EXPONENT NOT EQUAL 4
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-VELOCITY-LAT-MS < 5 OR WS-VELOCITY-LAT-MS > 25
                SET VELOCITY-LAT-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CONTINUITY-FID-M < 850 OR WS-CONTINUITY-FID-M > 1000
                SET CONTINUITY-FIDELITY-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-ACCEL-JITTER-M < 0 OR WS-ACCEL-JITTER-M > 5
                SET JITTER-EXCEEDED TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-TEMPORAL-VELOCITY.
            COMPUTE WS-TVS-COMPOSITE = ((30 - WS-VELOCITY-LAT-MS) * 20) +
                                       (WS-CONTINUITY-FID-M / 2) +
                                       ((10 - WS-ACCEL-JITTER-M) * 40).

            COMPUTE WS-TVS-VITALITY = (WS-TVS-COMPOSITE / 4) +
                                      (WS-CONTINUITY-FID-M / 4) +
                                      ((30 - WS-VELOCITY-LAT-MS) * 4) + 1.

            IF WS-TVS-VITALITY EQUAL ZERO
                SET VELOCITY-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-TVS-COHERENCE = (WS-TVS-COMPOSITE / 16) +
                                       (WS-CONTINUITY-FID-M / 16) +
                                       ((30 - WS-VELOCITY-LAT-MS) * 2).

            COMPUTE WS-TVS-REBAR-LATCH = 1470169088 +
                                         (WS-TVS-COMPOSITE / 2) +
                                         ((30 - WS-VELOCITY-LAT-MS) * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-TVS-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-TVS-VITALITY * 10) +
                                         (WS-TVS-COHERENCE * 10) +
                                         (WS-TVS-COMPOSITE * 10) +
                                         (WS-TVS-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-TVS-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-TVS-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
