        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-BEYOND-580.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-BEYOND-580-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH581-NODE-ATTACH-OK     PIC 9(01) VALUE 1.
            05  WS-TH582-PAYLOAD-STORE-OK   PIC 9(01) VALUE 1.
            05  WS-TH583-DISPATCH-LAT-OK    PIC 9(01) VALUE 1.
            05  WS-TH584-TREE-PAYLOAD-OK    PIC 9(01) VALUE 1.
            05  WS-TH585-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-BEYOND-580-WIT      PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-BEYOND-580.
            GOBACK.
        1000-EVALUATE-BEYOND-580.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH581-NODE-ATTACH-OK = 1 AND
               WS-TH582-PAYLOAD-STORE-OK = 1 AND
               WS-TH583-DISPATCH-LAT-OK = 1 AND
               WS-TH584-TREE-PAYLOAD-OK = 1 AND
               WS-TH585-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-BEYOND-580-WIT
            ELSE
                MOVE 0 TO WS-FPGA-BEYOND-580-WIT.
