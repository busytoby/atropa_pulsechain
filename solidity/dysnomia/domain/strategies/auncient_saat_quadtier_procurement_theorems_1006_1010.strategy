        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-SAAT-PROCURE.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-SAAT-PROCURE-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1006-QUADTIER-OK       PIC 9(01) VALUE 1.
            05  WS-TH1007-MERKLE-GUARD-OK   PIC 9(01) VALUE 1.
            05  WS-TH1008-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1009-1010M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1010-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-SAAT-PROCURE-WIT         PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-SAAT-PROCURE.
            GOBACK.
        1000-EVALUATE-SAAT-PROCURE.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1006-QUADTIER-OK = 1 AND
               WS-TH1007-MERKLE-GUARD-OK = 1 AND
               WS-TH1008-SUBMICRO-LAT-OK = 1 AND
               WS-TH1009-1010M-SAAT-OK = 1 AND
               WS-TH1010-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-SAAT-PROCURE-WIT
            ELSE
                MOVE 0 TO WS-SAAT-PROCURE-WIT.
