        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-EMBED-ORTHO.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-ORTHO-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1801-ORTHO-OK          PIC 9(01) VALUE 1.
            05  WS-TH1802-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1803-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1804-1805M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1805-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-ORTHO-WIT                PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-ORTHO.
            GOBACK.
        1000-EVALUATE-ORTHO.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1801-ORTHO-OK = 1 AND
               WS-TH1802-DATBIN-STRAT-OK = 1 AND
               WS-TH1803-SUBMICRO-LAT-OK = 1 AND
               WS-TH1804-1805M-SAAT-OK = 1 AND
               WS-TH1805-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-ORTHO-WIT
            ELSE
                MOVE 0 TO WS-ORTHO-WIT.
