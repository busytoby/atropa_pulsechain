        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-CRYPTO.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-CRYPTO-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1131-CRYPTO-OK         PIC 9(01) VALUE 1.
            05  WS-TH1132-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1133-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1134-1135M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1135-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-FPGA-CRYPTO-WIT          PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-FPGA-CRYPTO.
            GOBACK.
        1000-EVALUATE-FPGA-CRYPTO.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1131-CRYPTO-OK = 1 AND
               WS-TH1132-DATBIN-STRAT-OK = 1 AND
               WS-TH1133-SUBMICRO-LAT-OK = 1 AND
               WS-TH1134-1135M-SAAT-OK = 1 AND
               WS-TH1135-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-FPGA-CRYPTO-WIT
            ELSE
                MOVE 0 TO WS-FPGA-CRYPTO-WIT.
