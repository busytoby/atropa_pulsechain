IDENTIFICATION DIVISION.
PROGRAM-ID. PROG-HARVARD-1946-DIVIDER.

DATA DIVISION.
01 D0-SUBSTRATE-TRUNK.
   05 D0-MOTZKIN-PRIME     PIC 9(9) USAGE R0.
   05 D0-K-EXPONENT        PIC 9(9) USAGE R1.
   05 D0-ZERO-DIV-FLAG     PIC 9(9) USAGE R2.
01 D1-DIVIDEND-SHADOW.
   05 D1-DIVIDEND-A        PIC 9(9) USAGE R3.
   05 D1-DIVISOR-B         PIC 9(9) USAGE R4.
   05 D1-SHADOW-A-SNAP     PIC 9(9) USAGE R5.
01 D2-SUBTRACTIVE-STAGE.
   05 D2-QUOTIENT-Q        PIC 9(9) USAGE R6.
   05 D2-REMAINDER-R       PIC 9(9) USAGE R7.
   05 D2-COMMITTED-STATE   PIC 9(9) USAGE R8.
01 D3-LEAF-EVAL.
   05 D3-PROOF-RULING      PIC 9(9) USAGE R9.
   05 D3-DISP-WRAP-MOD     PIC 9(9) USAGE R10.

PROCEDURE DIVISION.
    MOVE 953467954 TO D0-MOTZKIN-PRIME.
    MOVE 3 TO D0-K-EXPONENT.
    MOVE 0 TO D0-ZERO-DIV-FLAG.
    MOVE 1000000 TO D1-DIVIDEND-A.
    MOVE 875 TO D1-DIVISOR-B.

    PERFORM STAGE-SUBTRACTIVE-DIVISION.
    PERFORM APPLY-CLUTCH-ALARM-LATCH.
    PERFORM SYNC-DISPLACEMENT.

    IF D1-SHADOW-A-SNAP == D1-DIVIDEND-A
        MOVE 0 TO D3-PROOF-RULING
        SET depth 4
    ELSE
        MOVE 5 TO D3-PROOF-RULING
        SET depth 1
    END-IF.

    EVAL.
    GO TO END-STRATEGY.

STAGE-SUBTRACTIVE-DIVISION.
    MOVE D1-DIVIDEND-A TO D1-SHADOW-A-SNAP.
    IF D1-DIVISOR-B == 0 OR D0-ZERO-DIV-FLAG == 1
        MOVE 0 TO D2-QUOTIENT-Q
        MOVE 0 TO D2-REMAINDER-R
    ELSE
        COMPUTE D2-QUOTIENT-Q = D1-DIVIDEND-A / D1-DIVISOR-B
        COMPUTE D2-REMAINDER-R = D1-DIVIDEND-A - (D2-QUOTIENT-Q * D1-DIVISOR-B)
    END-IF.
    EXIT.

APPLY-CLUTCH-ALARM-LATCH.
    IF D0-ZERO-DIV-FLAG == 1 OR D1-DIVISOR-B == 0
        MOVE D1-SHADOW-A-SNAP TO D2-COMMITTED-STATE
    ELSE
        MOVE D2-QUOTIENT-Q TO D2-COMMITTED-STATE
    END-IF.
    EXIT.

SYNC-DISPLACEMENT.
    COMPUTE D3-DISP-WRAP-MOD = D2-COMMITTED-STATE - ((D2-COMMITTED-STATE / 256) * 256).
    EXIT.

END-STRATEGY.
