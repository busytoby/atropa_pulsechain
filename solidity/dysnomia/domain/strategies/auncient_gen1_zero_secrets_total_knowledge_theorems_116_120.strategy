        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-GEN1-ZERO-SECRETS-116-120.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-GEN1-ZERO-SECRETS-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH116-ZERO-SECRET-OK     PIC 9(01) VALUE 1.
            05  WS-TH117-GLASS-BOX-OK       PIC 9(01) VALUE 1.
            05  WS-TH118-DETERM-DERIVE-OK   PIC 9(01) VALUE 1.
            05  WS-TH119-NO-COVERT-OK       PIC 9(01) VALUE 1.
            05  WS-TH120-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-GEN1-TK-WITNESS          PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-GEN1-TK.
            GOBACK.
        1000-EVALUATE-GEN1-TK.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH116-ZERO-SECRET-OK = 1 AND
               WS-TH117-GLASS-BOX-OK = 1 AND
               WS-TH118-DETERM-DERIVE-OK = 1 AND
               WS-TH119-NO-COVERT-OK = 1 AND
               WS-TH120-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-GEN1-TK-WITNESS
            ELSE
                MOVE 0 TO WS-GEN1-TK-WITNESS.
