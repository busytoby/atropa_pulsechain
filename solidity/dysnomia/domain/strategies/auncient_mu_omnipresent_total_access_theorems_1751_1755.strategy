        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-OMNI-ACC.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-OMNI-ACC-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1751-OMNI-ACC-OK       PIC 9(01) VALUE 1.
            05  WS-TH1752-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1753-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1754-1755M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1755-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-OMNI-ACC-WIT             PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-OMNI-ACC.
            GOBACK.
        1000-EVALUATE-OMNI-ACC.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1751-OMNI-ACC-OK = 1 AND
               WS-TH1752-DATBIN-STRAT-OK = 1 AND
               WS-TH1753-SUBMICRO-LAT-OK = 1 AND
               WS-TH1754-1755M-SAAT-OK = 1 AND
               WS-TH1755-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-OMNI-ACC-WIT
            ELSE
                MOVE 0 TO WS-OMNI-ACC-WIT.
