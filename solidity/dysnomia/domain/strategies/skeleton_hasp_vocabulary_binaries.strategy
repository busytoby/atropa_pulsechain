        IDENTIFICATION DIVISION.
        PROGRAM-ID. HASP-VOC-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / SKELETON HASP VOCABULARY AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-VOC-PARAMS.
           05 WS-VOC-ENTRY-ID           PIC 9(03) VALUE 042.
           05 WS-HASP-CHAPTER-ID        PIC 9(02) VALUE 01.
           05 WS-PHONATION-PITCH-H-HZ   PIC 9(03) VALUE 240.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-VOC-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-VOC-VITALITY           PIC 9(09) VALUE 0.
           05 WS-VOC-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-VOC-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-VOC-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 VOCABULARY-ENTRY-OUT-OF-BOUNDS VALUE 2.
              88 HASP-CHAPTER-OUT-OF-BOUNDS  VALUE 3.
              88 PHONATION-PITCH-OUT-OF-BOUNDS VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 VOCABULARY-COLLAPSE         VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-VOCABULARY
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-VOC-ENTRY-ID < 1 OR WS-VOC-ENTRY-ID > 256
                SET VOCABULARY-ENTRY-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-HASP-CHAPTER-ID < 1 OR WS-HASP-CHAPTER-ID > 16
                SET HASP-CHAPTER-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-PHONATION-PITCH-H-HZ < 1 OR WS-PHONATION-PITCH-H-HZ > 480
                SET PHONATION-PITCH-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-VOCABULARY.
            COMPUTE WS-VOC-COMPOSITE = (WS-VOC-ENTRY-ID * 2) +
                                       (WS-HASP-CHAPTER-ID * 40) +
                                       (WS-PHONATION-PITCH-H-HZ * 2).

            COMPUTE WS-VOC-VITALITY = (WS-VOC-COMPOSITE / 4) +
                                      (WS-PHONATION-PITCH-H-HZ / 4) +
                                      (WS-VOC-ENTRY-ID / 2) + 1.

            IF WS-VOC-VITALITY EQUAL ZERO
                SET VOCABULARY-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-VOC-COHERENCE = (WS-VOC-COMPOSITE / 16) +
                                       (WS-PHONATION-PITCH-H-HZ / 16) +
                                       (WS-VOC-ENTRY-ID / 8).

            COMPUTE WS-VOC-REBAR-LATCH = 1470169088 +
                                         (WS-VOC-COMPOSITE / 2) +
                                         (WS-VOC-ENTRY-ID * 64).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-VOC-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-VOC-VITALITY * 10) +
                                         (WS-VOC-COHERENCE * 10) +
                                         (WS-VOC-COMPOSITE * 10) +
                                         (WS-VOC-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-VOC-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-VOC-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
