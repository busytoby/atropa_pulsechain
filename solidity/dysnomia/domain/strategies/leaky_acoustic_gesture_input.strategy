        IDENTIFICATION DIVISION.
        PROGRAM-ID. LEAKY-GEST-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / LEAKY ACOUSTIC GESTURE AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-GEST-PARAMS.
           05 WS-SENSING-DIST-MM        PIC 9(03) VALUE 080.
           05 WS-SPATIAL-GRAN-TENTHS    PIC 9(02) VALUE 15.
           05 WS-PCK-3CM-MILLI          PIC 9(04) VALUE 0890.
           05 WS-SPEC-ENTROPY-MILLI     PIC 9(04) VALUE 0750.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-GEST-COMPOSITE         PIC 9(04) VALUE 0.
           05 WS-GEST-VITALITY          PIC 9(09) VALUE 0.
           05 WS-GEST-COHERENCE         PIC 9(09) VALUE 0.
           05 WS-GEST-REBAR-LATCH       PIC 9(12) VALUE 0.
           05 WS-SHADOW-GEST-BASE       PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 SENSING-DIST-EXCEEDED       VALUE 2.
              88 SPATIAL-GRAN-DEGRADED       VALUE 3.
              88 PCK-ACCURACY-BELOW-FLOOR    VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 GESTURE-VITALITY-COLLAPSE   VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-GESTURE-INPUT
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-SENSING-DIST-MM < 20 OR WS-SENSING-DIST-MM > 150
                SET SENSING-DIST-EXCEEDED TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-SPATIAL-GRAN-TENTHS < 1 OR WS-SPATIAL-GRAN-TENTHS > 22
                SET SPATIAL-GRAN-DEGRADED TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-PCK-3CM-MILLI < 850 OR WS-PCK-3CM-MILLI > 1000
                SET PCK-ACCURACY-BELOW-FLOOR TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-SPEC-ENTROPY-MILLI < 100 OR WS-SPEC-ENTROPY-MILLI > 1000
                MOVE 500 TO WS-SPEC-ENTROPY-MILLI
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-GESTURE-INPUT.
            COMPUTE WS-GEST-COMPOSITE = (WS-PCK-3CM-MILLI + WS-SPEC-ENTROPY-MILLI) / 2.

            COMPUTE WS-GEST-VITALITY = (WS-GEST-COMPOSITE / 4) +
                                       ((150 - WS-SENSING-DIST-MM) * 2) +
                                       ((22 - WS-SPATIAL-GRAN-TENTHS) * 16) + 1.

            IF WS-GEST-VITALITY EQUAL ZERO
                SET GESTURE-VITALITY-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-GEST-COHERENCE = (WS-GEST-COMPOSITE / 16) +
                                        ((150 - WS-SENSING-DIST-MM) / 2) +
                                        ((22 - WS-SPATIAL-GRAN-TENTHS) * 4).

            COMPUTE WS-GEST-REBAR-LATCH = 1470169088 +
                                          (WS-GEST-COMPOSITE / 2) +
                                          ((150 - WS-SENSING-DIST-MM) * 8).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-GEST-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                          (WS-GEST-VITALITY * 10) +
                                          (WS-GEST-COHERENCE * 10) +
                                          (WS-GEST-COMPOSITE * 10) +
                                          (WS-GEST-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-GEST-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-GEST-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
