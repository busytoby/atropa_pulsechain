        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-VSEN-GGUF-SLICE.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-VSEN-GGUF-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1776-GGUF-ALIGN-OK     PIC 9(01) VALUE 1.
            05  WS-TH1777-DATBIN-LAYOUT-OK  PIC 9(01) VALUE 1.
            05  WS-TH1778-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1779-1780M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1780-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-VSEN-GGUF-WIT            PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-VSEN-GGUF.
            GOBACK.
        1000-EVALUATE-VSEN-GGUF.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1776-GGUF-ALIGN-OK = 1 AND
               WS-TH1777-DATBIN-LAYOUT-OK = 1 AND
               WS-TH1778-SUBMICRO-LAT-OK = 1 AND
               WS-TH1779-1780M-SAAT-OK = 1 AND
               WS-TH1780-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-VSEN-GGUF-WIT
            ELSE
                MOVE 0 TO WS-VSEN-GGUF-WIT.
