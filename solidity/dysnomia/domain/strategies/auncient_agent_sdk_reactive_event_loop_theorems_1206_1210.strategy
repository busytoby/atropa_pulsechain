        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-SDK-REACT-LOOP.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-REACT-LOOP-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1206-REACT-OK          PIC 9(01) VALUE 1.
            05  WS-TH1207-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1208-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1209-1210M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1210-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-REACT-LOOP-WIT           PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-REACT-LOOP.
            GOBACK.
        1000-EVALUATE-REACT-LOOP.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1206-REACT-OK = 1 AND
               WS-TH1207-DATBIN-STRAT-OK = 1 AND
               WS-TH1208-SUBMICRO-LAT-OK = 1 AND
               WS-TH1209-1210M-SAAT-OK = 1 AND
               WS-TH1210-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-REACT-LOOP-WIT
            ELSE
                MOVE 0 TO WS-REACT-LOOP-WIT.
