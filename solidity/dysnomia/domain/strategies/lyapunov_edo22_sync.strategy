       IDENTIFICATION DIVISION.
       PROGRAM-ID. LYAPUNOV-EDO22-SYNC-STRATEGY.
       AUTHOR. AUNCIENT DYSNOMIA VM / EDO-22 ORBITAL SYNC.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-EDO22-PARAMETERS.
          05 WS-MICROTONE-STEP-K       PIC 9(02) VALUE 07.
          05 WS-INIT-PHASE-ERR-RAD     PIC 9(05) VALUE 05000.
          05 WS-SYNC-CYCLES            PIC 9(02) VALUE 16.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-NOMINAL-EDO-ANGLE      PIC 9(06) VALUE 0.
          05 WS-CURRENT-PHASE-ERR      PIC 9(05) VALUE 0.
          05 WS-STEP-IDX               PIC 9(02) VALUE 0.
          05 WS-SHADOW-EDO-BASE        PIC 9(12) VALUE 0.
          05 WS-CYC-MOD                PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-MICROTONE-STEP      VALUE 2.
             88 INVALID-PHASE-ERROR         VALUE 3.
             88 INVALID-SYNC-CYCLES         VALUE 4.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
             88 PHASE-SYNC-DIVERGENCE       VALUE 6.
             88 GATING-CLAMP-OVERFLOW       VALUE 7.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 8.
             88 CASCADE-ROLLBACK-FAIL       VALUE 9.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-EDO22-SYNC
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-MICROTONE-STEP-K > 21
               SET INVALID-MICROTONE-STEP TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-INIT-PHASE-ERR-RAD > 10000
               SET INVALID-PHASE-ERROR TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SYNC-CYCLES < 1 OR WS-SYNC-CYCLES > 64
               SET INVALID-SYNC-CYCLES TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-EDO22-SYNC.
           COMPUTE WS-NOMINAL-EDO-ANGLE = (36000 * WS-MICROTONE-STEP-K) / 22.
           MOVE WS-INIT-PHASE-ERR-RAD TO WS-CURRENT-PHASE-ERR.

           PERFORM VARYING WS-STEP-IDX FROM 1 BY 1 UNTIL WS-STEP-IDX > WS-SYNC-CYCLES
               COMPUTE WS-CURRENT-PHASE-ERR = (WS-CURRENT-PHASE-ERR * 875) / 1000
           END-PERFORM.

           IF WS-CURRENT-PHASE-ERR > WS-INIT-PHASE-ERR-RAD
               SET PHASE-SYNC-DIVERGENCE TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-SHADOW-EDO-BASE = (WS-CICS-WRITER-ID * 1000000) + 
               (WS-MICROTONE-STEP-K * 10000) + (WS-NOMINAL-EDO-ANGLE / 16) + WS-CURRENT-PHASE-ERR.

           COMPUTE WS-CYC-MOD = FUNCTION MOD(WS-MICROTONE-STEP-K, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-CYC-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-EDO-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-EDO-BASE + ((WS-NOMINAL-EDO-ANGLE * WS-G-GATE-FACTOR) / 100000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-EDO-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-MICROTONE-STEP-K * 10000) + (WS-NOMINAL-EDO-ANGLE / 16) + WS-CURRENT-PHASE-ERR)
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-EDO-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
