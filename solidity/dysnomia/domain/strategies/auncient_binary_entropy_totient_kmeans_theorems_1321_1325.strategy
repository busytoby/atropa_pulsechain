        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-BEK-BARREL.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-BEK-BARREL-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1321-BEK-OK            PIC 9(01) VALUE 1.
            05  WS-TH1322-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1323-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1324-1325M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1325-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-BEK-BARREL-WIT           PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-BEK-BARREL.
            GOBACK.
        1000-EVALUATE-BEK-BARREL.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1321-BEK-OK = 1 AND
               WS-TH1322-DATBIN-STRAT-OK = 1 AND
               WS-TH1323-SUBMICRO-LAT-OK = 1 AND
               WS-TH1324-1325M-SAAT-OK = 1 AND
               WS-TH1325-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-BEK-BARREL-WIT
            ELSE
                MOVE 0 TO WS-BEK-BARREL-WIT.
