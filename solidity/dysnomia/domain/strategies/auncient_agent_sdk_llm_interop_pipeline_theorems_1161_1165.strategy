        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-LLM-INTEROP.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-LLM-INTEROP-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1161-LLM-OK            PIC 9(01) VALUE 1.
            05  WS-TH1162-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1163-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1164-1165M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1165-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-LLM-INTEROP-WIT          PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-LLM-INTEROP.
            GOBACK.
        1000-EVALUATE-LLM-INTEROP.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1161-LLM-OK = 1 AND
               WS-TH1162-DATBIN-STRAT-OK = 1 AND
               WS-TH1163-SUBMICRO-LAT-OK = 1 AND
               WS-TH1164-1165M-SAAT-OK = 1 AND
               WS-TH1165-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-LLM-INTEROP-WIT
            ELSE
                MOVE 0 TO WS-LLM-INTEROP-WIT.
