       IDENTIFICATION DIVISION.
       PROGRAM-ID. CPM-TOMIE-4BOX-COAX.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-4BOX-COAX-PROOFS.
           05  WS-BUS-ARBITRAGE-OK         PIC 9(01) VALUE 1.
           05  WS-TONE-SYNTH-OK            PIC 9(01) VALUE 1.
           05  WS-IMPEDANCE-BAL-OK         PIC 9(01) VALUE 1.
           05  WS-BUS-LATENCY-OK           PIC 9(01) VALUE 1.
           05  WS-4BOX-COAX-SEAL-OK        PIC 9(01) VALUE 1.
       01  WS-4BOX-COAX-SYNTHESIS.
           05  WS-ALL-4BOX-PROVEN          PIC 9(01) VALUE 1.
           05  WS-TOTAL-4BOX-CODE          PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-EVALUATE-BUS-AND-TONE.
           PERFORM 2000-EVALUATE-BAL-AND-LATENCY.
           PERFORM 3000-SYNTHESIZE-4BOX-PROOFS.
           GOBACK.
       1000-EVALUATE-BUS-AND-TONE.
           MOVE 1 TO WS-BUS-ARBITRAGE-OK.
           MOVE 1 TO WS-TONE-SYNTH-OK.
       2000-EVALUATE-BAL-AND-LATENCY.
           MOVE 1 TO WS-IMPEDANCE-BAL-OK.
           MOVE 1 TO WS-BUS-LATENCY-OK.
       3000-SYNTHESIZE-4BOX-PROOFS.
           IF WS-BUS-ARBITRAGE-OK = 1 AND
              WS-TONE-SYNTH-OK = 1 AND
              WS-IMPEDANCE-BAL-OK = 1 AND
              WS-BUS-LATENCY-OK = 1
               MOVE 1 TO WS-4BOX-COAX-SEAL-OK
               MOVE 1 TO WS-ALL-4BOX-PROVEN
               MOVE 1 TO WS-TOTAL-4BOX-CODE
           ELSE
               MOVE 0 TO WS-ALL-4BOX-PROVEN
               MOVE 0 TO WS-TOTAL-4BOX-CODE.
