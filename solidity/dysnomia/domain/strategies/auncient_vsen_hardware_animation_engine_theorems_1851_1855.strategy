        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-VSEN-ANIM.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-VSEN-ANIM-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1851-POSTURE-BANK-OK   PIC 9(01) VALUE 1.
            05  WS-TH1852-PMG-GESTURE-OK    PIC 9(01) VALUE 1.
            05  WS-TH1853-P2P-BONE-DMA-OK   PIC 9(01) VALUE 1.
            05  WS-TH1854-1855M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1855-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-VSEN-ANIM-WIT            PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-VSEN-ANIM.
            GOBACK.
        1000-EVALUATE-VSEN-ANIM.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1851-POSTURE-BANK-OK = 1 AND
               WS-TH1852-PMG-GESTURE-OK = 1 AND
               WS-TH1853-P2P-BONE-DMA-OK = 1 AND
               WS-TH1854-1855M-SAAT-OK = 1 AND
               WS-TH1855-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-VSEN-ANIM-WIT
            ELSE
                MOVE 0 TO WS-VSEN-ANIM-WIT.
