       IDENTIFICATION DIVISION.
       PROGRAM-ID. BMRC-KLEENE-UNIVERSALITY-STRATEGY.
       AUTHOR. AUNCIENT DYSNOMIA VM / BMRC KLEENE OPERATOR SET.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-KLEENE-PARAMETERS.
          05 WS-OPERATOR-TYPE-ID       PIC 9(02) VALUE 02.
          05 WS-INPUT-OPERAND-X        PIC 9(09) VALUE 000000042.
          05 WS-INPUT-OPERAND-Y        PIC 9(09) VALUE 000000010.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-SHADOW-KLEENE-BASE     PIC 9(12) VALUE 0.
          05 WS-EVALUATED-RESULT       PIC 9(09) VALUE 0.
          05 WS-OP-MOD                 PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-OPERATOR-TYPE       VALUE 2.
             88 INVALID-OPERANDS            VALUE 3.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 4.
             88 OPERATOR-EVALUATION-FAIL    VALUE 5.
             88 GATING-CLAMP-OVERFLOW       VALUE 6.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 7.
             88 CASCADE-ROLLBACK-FAIL       VALUE 8.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-KLEENE-OPERATOR
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-OPERATOR-TYPE-ID < 1 OR WS-OPERATOR-TYPE-ID > 5
               SET INVALID-OPERATOR-TYPE TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-KLEENE-OPERATOR.
           COMPUTE WS-SHADOW-KLEENE-BASE = (WS-CICS-WRITER-ID * 1000000) + 
               (WS-OPERATOR-TYPE-ID * 10000) + (WS-INPUT-OPERAND-X * 10).

           EVALUATE WS-OPERATOR-TYPE-ID
               WHEN 1
                   MOVE ZERO TO WS-EVALUATED-RESULT
               WHEN 2
                   COMPUTE WS-EVALUATED-RESULT = WS-INPUT-OPERAND-X + 1
               WHEN 3
                   MOVE WS-INPUT-OPERAND-X TO WS-EVALUATED-RESULT
               WHEN 4
                   COMPUTE WS-EVALUATED-RESULT = WS-INPUT-OPERAND-X + 2
               WHEN 5
                   COMPUTE WS-EVALUATED-RESULT = 10 - FUNCTION MOD(WS-INPUT-OPERAND-X, 10)
                   IF WS-EVALUATED-RESULT EQUAL 10
                       MOVE ZERO TO WS-EVALUATED-RESULT
                   END-IF
           END-EVALUATE.

           COMPUTE WS-OP-MOD = FUNCTION MOD(WS-OPERATOR-TYPE-ID, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-OP-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-KLEENE-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-KLEENE-BASE + (((WS-EVALUATED-RESULT * 100) * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-KLEENE-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-OPERATOR-TYPE-ID * 10000) + (WS-INPUT-OPERAND-X * 10))
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-KLEENE-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
