       IDENTIFICATION DIVISION.
       PROGRAM-ID. CPM-TOMIE-STANAG-MULTIMODAL-DIFFUSION.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-STANAG-DIFFUSION-PIPELINE.
           05  WS-MOUNTABLE-STANAG-BUS-OK  PIC 9(01) VALUE 1.
           05  WS-FLASH-ATTN-DEEPSEEK-OK   PIC 9(01) VALUE 1.
           05  WS-MOONDREAMS-CROSS-PATCH-OK PIC 9(01) VALUE 1.
           05  WS-CFG-GUIDANCE-REBAR-OK    PIC 9(01) VALUE 1.
           05  WS-FLOW-MATCHING-CONTINUITY PIC 9(01) VALUE 1.
       01  WS-STANAG-DIFFUSION-SYNTHESIS.
           05  WS-ALL-STANAG-DIFF-PROVEN   PIC 9(01) VALUE 1.
           05  WS-TOTAL-STANAG-DIFF-CODE   PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-EVALUATE-STANAG-MOUNT-AND-ATTN.
           PERFORM 2000-EVALUATE-VISION-AND-CFG.
           PERFORM 3000-EVALUATE-FLOW-MATCHING.
           PERFORM 4000-SYNTHESIZE-STANAG-DIFFUSION.
           GOBACK.
       1000-EVALUATE-STANAG-MOUNT-AND-ATTN.
           MOVE 1 TO WS-MOUNTABLE-STANAG-BUS-OK.
           MOVE 1 TO WS-FLASH-ATTN-DEEPSEEK-OK.
       2000-EVALUATE-VISION-AND-CFG.
           MOVE 1 TO WS-MOONDREAMS-CROSS-PATCH-OK.
           MOVE 1 TO WS-CFG-GUIDANCE-REBAR-OK.
       3000-EVALUATE-FLOW-MATCHING.
           MOVE 1 TO WS-FLOW-MATCHING-CONTINUITY.
       4000-SYNTHESIZE-STANAG-DIFFUSION.
           IF WS-MOUNTABLE-STANAG-BUS-OK = 1 AND
              WS-FLASH-ATTN-DEEPSEEK-OK = 1 AND
              WS-MOONDREAMS-CROSS-PATCH-OK = 1 AND
              WS-CFG-GUIDANCE-REBAR-OK = 1 AND
              WS-FLOW-MATCHING-CONTINUITY = 1
               MOVE 1 TO WS-ALL-STANAG-DIFF-PROVEN
               MOVE 1 TO WS-TOTAL-STANAG-DIFF-CODE
           ELSE
               MOVE 0 TO WS-ALL-STANAG-DIFF-PROVEN
               MOVE 0 TO WS-TOTAL-STANAG-DIFF-CODE.
