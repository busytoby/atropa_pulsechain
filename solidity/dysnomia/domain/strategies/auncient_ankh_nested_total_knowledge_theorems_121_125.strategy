        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-ANKH-TK-121-125.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-ANKH-TK-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH121-SHADOW-OK          PIC 9(01) VALUE 1.
            05  WS-TH122-PARTITION-OK       PIC 9(01) VALUE 1.
            05  WS-TH123-REMEDIAL-RET-OK    PIC 9(01) VALUE 1.
            05  WS-TH124-CACHE-GUARD-OK     PIC 9(01) VALUE 1.
            05  WS-TH125-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-ANKH-TK-WITNESS          PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-ANKH-TK.
            GOBACK.
        1000-EVALUATE-ANKH-TK.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH121-SHADOW-OK = 1 AND
               WS-TH122-PARTITION-OK = 1 AND
               WS-TH123-REMEDIAL-RET-OK = 1 AND
               WS-TH124-CACHE-GUARD-OK = 1 AND
               WS-TH125-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-ANKH-TK-WITNESS
            ELSE
                MOVE 0 TO WS-ANKH-TK-WITNESS.
