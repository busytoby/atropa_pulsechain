        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-BRANCH.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-BRANCH-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1141-BRANCH-OK         PIC 9(01) VALUE 1.
            05  WS-TH1142-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1143-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1144-1145M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1145-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-FPGA-BRANCH-WIT          PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-FPGA-BRANCH.
            GOBACK.
        1000-EVALUATE-FPGA-BRANCH.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1141-BRANCH-OK = 1 AND
               WS-TH1142-DATBIN-STRAT-OK = 1 AND
               WS-TH1143-SUBMICRO-LAT-OK = 1 AND
               WS-TH1144-1145M-SAAT-OK = 1 AND
               WS-TH1145-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-FPGA-BRANCH-WIT
            ELSE
                MOVE 0 TO WS-FPGA-BRANCH-WIT.
