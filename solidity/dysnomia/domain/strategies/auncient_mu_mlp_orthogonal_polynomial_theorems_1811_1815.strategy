        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-MLP-POLYNOMIAL.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-MLP-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1811-MLP-OK            PIC 9(01) VALUE 1.
            05  WS-TH1812-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1813-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1814-1815M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1815-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-MLP-WIT                  PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-MLP.
            GOBACK.
        1000-EVALUATE-MLP.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1811-MLP-OK = 1 AND
               WS-TH1812-DATBIN-STRAT-OK = 1 AND
               WS-TH1813-SUBMICRO-LAT-OK = 1 AND
               WS-TH1814-1815M-SAAT-OK = 1 AND
               WS-TH1815-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-MLP-WIT
            ELSE
                MOVE 0 TO WS-MLP-WIT.
