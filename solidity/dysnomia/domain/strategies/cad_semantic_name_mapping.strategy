        IDENTIFICATION DIVISION.
        PROGRAM-ID. SNM-MAP-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / CAD SEMANTIC NAME MAPPING AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-SNM-PARAMS.
           05 WS-MAP-LAT-MS             PIC 9(02) VALUE 20.
           05 WS-NARRATION-FID-M        PIC 9(04) VALUE 0960.
           05 WS-TTS-SYNC-ERR-MS        PIC 9(02) VALUE 05.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-SNM-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-SNM-VITALITY           PIC 9(09) VALUE 0.
           05 WS-SNM-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-SNM-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-SNM-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 MAP-LAT-OUT-OF-BOUNDS       VALUE 2.
              88 NARRATION-FID-LOW           VALUE 3.
              88 TTS-SYNC-ERR-EXCEEDED       VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 PACING-COLLAPSE             VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-SEMANTIC-MAPPING
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-MAP-LAT-MS < 10 OR WS-MAP-LAT-MS > 50
                SET MAP-LAT-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-NARRATION-FID-M < 850 OR WS-NARRATION-FID-M > 1000
                SET NARRATION-FID-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-TTS-SYNC-ERR-MS < 0 OR WS-TTS-SYNC-ERR-MS > 20
                SET TTS-SYNC-ERR-EXCEEDED TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-SEMANTIC-MAPPING.
            COMPUTE WS-SNM-COMPOSITE = ((60 - WS-MAP-LAT-MS) * 10) +
                                       (WS-NARRATION-FID-M / 2) +
                                       ((25 - WS-TTS-SYNC-ERR-MS) * 20).

            COMPUTE WS-SNM-VITALITY = (WS-SNM-COMPOSITE / 4) +
                                      (WS-NARRATION-FID-M / 4) +
                                      ((60 - WS-MAP-LAT-MS) * 4) + 1.

            IF WS-SNM-VITALITY EQUAL ZERO
                SET PACING-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-SNM-COHERENCE = (WS-SNM-COMPOSITE / 16) +
                                       (WS-NARRATION-FID-M / 16) +
                                       ((60 - WS-MAP-LAT-MS) * 2).

            COMPUTE WS-SNM-REBAR-LATCH = 1470169088 +
                                         (WS-SNM-COMPOSITE / 2) +
                                         ((60 - WS-MAP-LAT-MS) * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-SNM-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-SNM-VITALITY * 10) +
                                         (WS-SNM-COHERENCE * 10) +
                                         (WS-SNM-COMPOSITE * 10) +
                                         (WS-SNM-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-SNM-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-SNM-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
