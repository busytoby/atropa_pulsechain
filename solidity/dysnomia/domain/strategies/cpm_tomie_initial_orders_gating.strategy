       IDENTIFICATION DIVISION.
       PROGRAM-ID. CPM-TOMIE-INITIAL-ORDERS-GATING-STRATEGY.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-PREREQUISITE-CHECKLIST.
           05  WS-FORMAL-REVIEW-PASSED     PIC 9(01) VALUE 1.
           05  WS-PHASE2-DEEP-AUDIT-PASSED PIC 9(01) VALUE 1.
           05  WS-ALGEBRAIC-CLOSURE-SEALED PIC 9(01) VALUE 1.
           05  WS-RULE18-CHECKSUM-VALID    PIC 9(01) VALUE 1.
           05  WS-PROHIBITED-OPCODE-MASK   PIC 9(08) VALUE 00000000.
       01  WS-INITIAL-ORDERS-QUALIFICATION.
           05  WS-IO1-LOADER-UNLOCKED      PIC 9(01) VALUE 1.
           05  WS-EDSAC-BOOT-CODE          PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-EVALUATE-REVIEW-GATES.
           PERFORM 2000-EVALUATE-EDSAC-FIREWALL.
           PERFORM 3000-QUALIFY-INITIAL-ORDERS.
           GOBACK.
       1000-EVALUATE-REVIEW-GATES.
           IF WS-FORMAL-REVIEW-PASSED = 1 AND
              WS-PHASE2-DEEP-AUDIT-PASSED = 1 AND
              WS-ALGEBRAIC-CLOSURE-SEALED = 1 AND
              WS-RULE18-CHECKSUM-VALID = 1
               MOVE 1 TO WS-IO1-LOADER-UNLOCKED
           ELSE
               MOVE 0 TO WS-IO1-LOADER-UNLOCKED.
       2000-EVALUATE-EDSAC-FIREWALL.
           IF WS-PROHIBITED-OPCODE-MASK = 00000000
               CONTINUE
           ELSE
               MOVE 0 TO WS-IO1-LOADER-UNLOCKED.
       3000-QUALIFY-INITIAL-ORDERS.
           IF WS-IO1-LOADER-UNLOCKED = 1
               MOVE 1 TO WS-EDSAC-BOOT-CODE
           ELSE
               MOVE 0 TO WS-EDSAC-BOOT-CODE.
