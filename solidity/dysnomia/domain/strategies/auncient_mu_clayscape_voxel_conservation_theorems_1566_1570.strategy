        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-CLAY-VOXEL.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-CLAY-VOXEL-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1566-VOXEL-OK          PIC 9(01) VALUE 1.
            05  WS-TH1567-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1568-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1569-1570M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1570-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-CLAY-VOXEL-WIT           PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-CLAY-VOXEL.
            GOBACK.
        1000-EVALUATE-CLAY-VOXEL.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1566-VOXEL-OK = 1 AND
               WS-TH1567-DATBIN-STRAT-OK = 1 AND
               WS-TH1568-SUBMICRO-LAT-OK = 1 AND
               WS-TH1569-1570M-SAAT-OK = 1 AND
               WS-TH1570-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-CLAY-VOXEL-WIT
            ELSE
                MOVE 0 TO WS-CLAY-VOXEL-WIT.
