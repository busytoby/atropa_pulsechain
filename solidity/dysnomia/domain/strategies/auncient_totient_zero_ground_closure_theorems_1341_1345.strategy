        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-TZG-CLOSE.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-TZG-CLOSE-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1341-TZG-OK            PIC 9(01) VALUE 1.
            05  WS-TH1342-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1343-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1344-1345M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1345-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-TZG-CLOSE-WIT            PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-TZG-CLOSE.
            GOBACK.
        1000-EVALUATE-TZG-CLOSE.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1341-TZG-OK = 1 AND
               WS-TH1342-DATBIN-STRAT-OK = 1 AND
               WS-TH1343-SUBMICRO-LAT-OK = 1 AND
               WS-TH1344-1345M-SAAT-OK = 1 AND
               WS-TH1345-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-TZG-CLOSE-WIT
            ELSE
                MOVE 0 TO WS-TZG-CLOSE-WIT.
