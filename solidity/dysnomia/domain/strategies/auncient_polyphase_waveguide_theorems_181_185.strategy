        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-WAVEGUIDE-181-185.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-WAVEGUIDE-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH181-DISPERSION-OK      PIC 9(01) VALUE 1.
            05  WS-TH182-SCSI-TPUT-OK       PIC 9(01) VALUE 1.
            05  WS-TH183-ORTHO-OK           PIC 9(01) VALUE 1.
            05  WS-TH184-SAAT-DIVIDEND-OK   PIC 9(01) VALUE 1.
            05  WS-TH185-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-WAVEGUIDE-WITNESS        PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-WAVEGUIDE.
            GOBACK.
        1000-EVALUATE-WAVEGUIDE.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH181-DISPERSION-OK = 1 AND
               WS-TH182-SCSI-TPUT-OK = 1 AND
               WS-TH183-ORTHO-OK = 1 AND
               WS-TH184-SAAT-DIVIDEND-OK = 1 AND
               WS-TH185-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-WAVEGUIDE-WITNESS
            ELSE
                MOVE 0 TO WS-WAVEGUIDE-WITNESS.
