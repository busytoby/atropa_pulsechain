        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-SCHED.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-SCHED-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1126-SCHED-OK          PIC 9(01) VALUE 1.
            05  WS-TH1127-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1128-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1129-1130M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1130-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-FPGA-SCHED-WIT           PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-FPGA-SCHED.
            GOBACK.
        1000-EVALUATE-FPGA-SCHED.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1126-SCHED-OK = 1 AND
               WS-TH1127-DATBIN-STRAT-OK = 1 AND
               WS-TH1128-SUBMICRO-LAT-OK = 1 AND
               WS-TH1129-1130M-SAAT-OK = 1 AND
               WS-TH1130-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-FPGA-SCHED-WIT
            ELSE
                MOVE 0 TO WS-FPGA-SCHED-WIT.
