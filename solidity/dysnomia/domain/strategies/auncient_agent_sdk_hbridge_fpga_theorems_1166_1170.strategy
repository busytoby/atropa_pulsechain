        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-SDK-HBRIDGE.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-SDK-HBRIDGE-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1166-HBRIDGE-OK        PIC 9(01) VALUE 1.
            05  WS-TH1167-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1168-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1169-1170M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1170-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-SDK-HBRIDGE-WIT          PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-SDK-HBRIDGE.
            GOBACK.
        1000-EVALUATE-SDK-HBRIDGE.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1166-HBRIDGE-OK = 1 AND
               WS-TH1167-DATBIN-STRAT-OK = 1 AND
               WS-TH1168-SUBMICRO-LAT-OK = 1 AND
               WS-TH1169-1170M-SAAT-OK = 1 AND
               WS-TH1170-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-SDK-HBRIDGE-WIT
            ELSE
                MOVE 0 TO WS-SDK-HBRIDGE-WIT.
