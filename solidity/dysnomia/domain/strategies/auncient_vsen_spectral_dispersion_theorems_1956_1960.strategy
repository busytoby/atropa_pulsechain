        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-VSEN-SPCDISP.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-VSEN-SPCDISP-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1956-THIN-FILM-OK      PIC 9(01) VALUE 1.
            05  WS-TH1957-DISP-ENERGY-OK    PIC 9(01) VALUE 1.
            05  WS-TH1958-TEAR-FET-OK       PIC 9(01) VALUE 1.
            05  WS-TH1959-1960M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1960-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-VSEN-SPCDISP-WIT         PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-VSEN-SPCDISP.
            GOBACK.
        1000-EVALUATE-VSEN-SPCDISP.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1956-THIN-FILM-OK = 1 AND
               WS-TH1957-DISP-ENERGY-OK = 1 AND
               WS-TH1958-TEAR-FET-OK = 1 AND
               WS-TH1959-1960M-SAAT-OK = 1 AND
               WS-TH1960-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-VSEN-SPCDISP-WIT
            ELSE
                MOVE 0 TO WS-VSEN-SPCDISP-WIT.
