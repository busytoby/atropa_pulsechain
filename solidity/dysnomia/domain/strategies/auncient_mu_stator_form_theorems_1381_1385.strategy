        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-STAT-FORM.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-STAT-FORM-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1381-FORM-OK           PIC 9(01) VALUE 1.
            05  WS-TH1382-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1383-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1384-1385M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1385-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-STAT-FORM-WIT            PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-STAT-FORM.
            GOBACK.
        1000-EVALUATE-STAT-FORM.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1381-FORM-OK = 1 AND
               WS-TH1382-DATBIN-STRAT-OK = 1 AND
               WS-TH1383-SUBMICRO-LAT-OK = 1 AND
               WS-TH1384-1385M-SAAT-OK = 1 AND
               WS-TH1385-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-STAT-FORM-WIT
            ELSE
                MOVE 0 TO WS-STAT-FORM-WIT.
