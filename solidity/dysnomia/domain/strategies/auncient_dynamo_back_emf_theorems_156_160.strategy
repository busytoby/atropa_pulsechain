        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-BACK-EMF-156-160.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-BACK-EMF-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH156-INDUCTION-OK       PIC 9(01) VALUE 1.
            05  WS-TH157-THERMAL-OK         PIC 9(01) VALUE 1.
            05  WS-TH158-PERMEABILITY-OK    PIC 9(01) VALUE 1.
            05  WS-TH159-COMMUTATOR-OK      PIC 9(01) VALUE 1.
            05  WS-TH160-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-BACK-EMF-WITNESS         PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-BACK-EMF.
            GOBACK.
        1000-EVALUATE-BACK-EMF.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH156-INDUCTION-OK = 1 AND
               WS-TH157-THERMAL-OK = 1 AND
               WS-TH158-PERMEABILITY-OK = 1 AND
               WS-TH159-COMMUTATOR-OK = 1 AND
               WS-TH160-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-BACK-EMF-WITNESS
            ELSE
                MOVE 0 TO WS-BACK-EMF-WITNESS.
