        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-MU-STREAM-SATURATE.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-STREAM-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1876-STREAM-OK         PIC 9(01) VALUE 1.
            05  WS-TH1877-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1878-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1879-1880M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1880-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-STREAM-WIT               PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-STREAM.
            GOBACK.
        1000-EVALUATE-STREAM.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1876-STREAM-OK = 1 AND
               WS-TH1877-DATBIN-STRAT-OK = 1 AND
               WS-TH1878-SUBMICRO-LAT-OK = 1 AND
               WS-TH1879-1880M-SAAT-OK = 1 AND
               WS-TH1880-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-STREAM-WIT
            ELSE
                MOVE 0 TO WS-STREAM-WIT.
