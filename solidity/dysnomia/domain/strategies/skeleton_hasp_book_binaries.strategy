        IDENTIFICATION DIVISION.
        PROGRAM-ID. HASP-BIN-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / SKELETON HASP BOOK BINARIES AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-HSP-PARAMS.
           05 WS-HASP-CHAPTER-ID        PIC 9(02) VALUE 01.
           05 WS-LLM-ENTROPY-M          PIC 9(04) VALUE 0860.
           05 WS-MORTON-KEY             PIC 9(05) VALUE 14325.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-HSP-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-HSP-VITALITY           PIC 9(09) VALUE 0.
           05 WS-HSP-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-HSP-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-HSP-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 HASP-CHAPTER-OUT-OF-BOUNDS  VALUE 2.
              88 LLM-ENTROPY-OUT-OF-BOUNDS   VALUE 3.
              88 MORTON-KEY-INVALID          VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 HASP-COLLAPSE               VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-SKELETON-HASP
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-HASP-CHAPTER-ID < 1 OR WS-HASP-CHAPTER-ID > 16
                SET HASP-CHAPTER-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-LLM-ENTROPY-M < 600 OR WS-LLM-ENTROPY-M > 950
                SET LLM-ENTROPY-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-MORTON-KEY < 1 OR WS-MORTON-KEY > 65535
                SET MORTON-KEY-INVALID TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-SKELETON-HASP.
            COMPUTE WS-HSP-COMPOSITE = (WS-HASP-CHAPTER-ID * 50) +
                                       (WS-LLM-ENTROPY-M / 2) +
                                       (FUNCTION MOD(WS-MORTON-KEY, 256) * 2).

            COMPUTE WS-HSP-VITALITY = (WS-HSP-COMPOSITE / 4) +
                                      (WS-LLM-ENTROPY-M / 4) +
                                      (WS-HASP-CHAPTER-ID * 10) + 1.

            IF WS-HSP-VITALITY EQUAL ZERO
                SET HASP-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-HSP-COHERENCE = (WS-HSP-COMPOSITE / 16) +
                                       (WS-LLM-ENTROPY-M / 16) +
                                       (WS-HASP-CHAPTER-ID * 2).

            COMPUTE WS-HSP-REBAR-LATCH = 1470169088 +
                                         (WS-HSP-COMPOSITE / 2) +
                                         (WS-HASP-CHAPTER-ID * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-HSP-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-HSP-VITALITY * 10) +
                                         (WS-HSP-COHERENCE * 10) +
                                         (WS-HSP-COMPOSITE * 10) +
                                         (WS-HSP-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-HSP-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-HSP-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
