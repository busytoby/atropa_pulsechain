        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-AUDIO-DRIVER.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-AUDIO-DRIVER-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1621-DRIVER-OK         PIC 9(01) VALUE 1.
            05  WS-TH1622-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1623-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1624-1625M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1625-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-AUDIO-DRIVER-WIT         PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-AUDIO-DRIVER.
            GOBACK.
        1000-EVALUATE-AUDIO-DRIVER.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1621-DRIVER-OK = 1 AND
               WS-TH1622-DATBIN-STRAT-OK = 1 AND
               WS-TH1623-SUBMICRO-LAT-OK = 1 AND
               WS-TH1624-1625M-SAAT-OK = 1 AND
               WS-TH1625-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-AUDIO-DRIVER-WIT
            ELSE
                MOVE 0 TO WS-AUDIO-DRIVER-WIT.
