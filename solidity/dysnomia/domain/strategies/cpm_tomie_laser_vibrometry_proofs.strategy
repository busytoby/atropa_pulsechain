       IDENTIFICATION DIVISION.
       PROGRAM-ID. CPM-TOMIE-LASER-VIB.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-LASER-VIB-PROOFS.
           05  WS-DOPPLER-SHIFT-OK         PIC 9(01) VALUE 1.
           05  WS-MODAL-FREQ-OK            PIC 9(01) VALUE 1.
           05  WS-JOINT-TRANSMIT-OK        PIC 9(01) VALUE 1.
           05  WS-LDV-LATENCY-OK           PIC 9(01) VALUE 1.
           05  WS-LDV-SEAL-OK              PIC 9(01) VALUE 1.
       01  WS-LASER-VIB-SYNTHESIS.
           05  WS-ALL-PLV-PROVEN           PIC 9(01) VALUE 1.
           05  WS-TOTAL-PLV-CODE           PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-EVALUATE-DOPPLER-AND-MODAL.
           PERFORM 2000-EVALUATE-TRANSMIT-AND-LATENCY.
           PERFORM 3000-SYNTHESIZE-PLV-PROOFS.
           GOBACK.
       1000-EVALUATE-DOPPLER-AND-MODAL.
           MOVE 1 TO WS-DOPPLER-SHIFT-OK.
           MOVE 1 TO WS-MODAL-FREQ-OK.
       2000-EVALUATE-TRANSMIT-AND-LATENCY.
           MOVE 1 TO WS-JOINT-TRANSMIT-OK.
           MOVE 1 TO WS-LDV-LATENCY-OK.
       3000-SYNTHESIZE-PLV-PROOFS.
           IF WS-DOPPLER-SHIFT-OK = 1 AND
              WS-MODAL-FREQ-OK = 1 AND
              WS-JOINT-TRANSMIT-OK = 1 AND
              WS-LDV-LATENCY-OK = 1
               MOVE 1 TO WS-LDV-SEAL-OK
               MOVE 1 TO WS-ALL-PLV-PROVEN
               MOVE 1 TO WS-TOTAL-PLV-CODE
           ELSE
               MOVE 0 TO WS-ALL-PLV-PROVEN
               MOVE 0 TO WS-TOTAL-PLV-CODE.
