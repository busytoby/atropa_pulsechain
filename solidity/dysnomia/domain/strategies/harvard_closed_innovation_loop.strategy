       IDENTIFICATION DIVISION.
       PROGRAM-ID. HARVARD-CLOSED-LOOP-STRATEGY.
       AUTHOR. AUNCIENT DYSNOMIA VM / HARVARD CLOSED INNOVATION LOOP.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-LOOP-PARAMETERS.
          05 WS-INITIAL-TOTIENT-MU0    PIC 9(12) VALUE 0001000000.
          05 WS-CYCLE-ITERATIONS       PIC 9(02) VALUE 04.
          05 WS-ACTIVE-VALVES          PIC 9(02) VALUE 04.
          05 WS-PLL-PHASE-ERR          PIC S9(05) VALUE +00064.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-ROOT-SHADOW-LOOP       PIC 9(12) VALUE 0.
          05 WS-CURRENT-TOTIENT        PIC 9(12) VALUE 0.
          05 WS-ITER-COUNTER           PIC 9(02) VALUE 0.
          05 WS-VALVE-COUNTER          PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-PER-CYCLE-CHARGE       PIC 9(09) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.
          05 WS-ABS-PHASE-ERR          PIC 9(05) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-INITIAL-TOTIENT     VALUE 2.
             88 INVALID-CYCLE-ITERATIONS    VALUE 3.
             88 INVALID-VALVE-COUNT         VALUE 4.
             88 PLL-PHASE-LOCK-FAIL         VALUE 5.
             88 GATING-CLAMP-OVERFLOW       VALUE 6.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 7.
             88 CASCADE-ROLLBACK-FAIL       VALUE 8.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-CLOSED-LOOP
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-INITIAL-TOTIENT-MU0 EQUAL ZERO
               SET INVALID-INITIAL-TOTIENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CYCLE-ITERATIONS < 1 OR WS-CYCLE-ITERATIONS > 16
               SET INVALID-CYCLE-ITERATIONS TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-ACTIVE-VALVES < 1 OR WS-ACTIVE-VALVES > 8
               SET INVALID-VALVE-COUNT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-PLL-PHASE-ERR < -512 OR WS-PLL-PHASE-ERR > +512
               SET PLL-PHASE-LOCK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-CLOSED-LOOP.
           MOVE WS-INITIAL-TOTIENT-MU0 TO WS-ROOT-SHADOW-LOOP.
           MOVE WS-INITIAL-TOTIENT-MU0 TO WS-CURRENT-TOTIENT.

           IF WS-PLL-PHASE-ERR < 0
               COMPUTE WS-ABS-PHASE-ERR = - WS-PLL-PHASE-ERR
           ELSE
               MOVE WS-PLL-PHASE-ERR TO WS-ABS-PHASE-ERR
           END-IF.

           PERFORM VARYING WS-ITER-COUNTER FROM 1 BY 1
                   UNTIL WS-ITER-COUNTER > WS-CYCLE-ITERATIONS
               PERFORM VARYING WS-VALVE-COUNTER FROM 1 BY 1
                       UNTIL WS-VALVE-COUNTER > WS-ACTIVE-VALVES
                   COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-VALVE-COUNTER) / 8)
                   IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
                       SET GATING-CLAMP-OVERFLOW TO TRUE
                       EXIT PARAGRAPH
                   END-IF

                   COMPUTE WS-PER-CYCLE-CHARGE = (((WS-VALVE-COUNTER * 1000 + ((512 - WS-ABS-PHASE-ERR) * 4)) * WS-G-GATE-FACTOR) / 1000)
                   COMPUTE WS-CURRENT-TOTIENT = WS-CURRENT-TOTIENT + WS-PER-CYCLE-CHARGE
               END-PERFORM
           END-PERFORM.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-ROOT-SHADOW-LOOP TO WS-COMMITTED-OUTPUT
           ELSE
               MOVE WS-CURRENT-TOTIENT TO WS-COMMITTED-OUTPUT
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-ROOT-SHADOW-LOOP NOT EQUAL WS-INITIAL-TOTIENT-MU0
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-ROOT-SHADOW-LOOP
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
