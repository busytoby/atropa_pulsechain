       IDENTIFICATION DIVISION.
       PROGRAM-ID. CPM-TOMIE-FORMAL-REVIEW-PHASE2-STRATEGY.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-PHASE2-AUDIT-AREAS.
           05  WS-AREA1-CONCURRENCY-SOUND  PIC 9(01) VALUE 1.
           05  WS-AREA2-COMPILER-ISOMORPH  PIC 9(01) VALUE 1.
           05  WS-AREA3-MEMORY-BOUNDED-TPA PIC 9(01) VALUE 1.
           05  WS-AREA4-FAULT-INJECTION-OK PIC 9(01) VALUE 1.
           05  WS-AREA5-SECURITY-EAL7-MET  PIC 9(01) VALUE 1.
       01  WS-PHASE2-SYNTHESIS.
           05  WS-PHASE2-AUDIT-APPROVED    PIC 9(01) VALUE 1.
           05  WS-TOTAL-PHASE2-CODE        PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-AUDIT-CONCURRENCY.
           PERFORM 2000-AUDIT-COMPILATION-PASSES.
           PERFORM 3000-AUDIT-FAULT-RESILIENCE.
           PERFORM 4000-SYNTHESIZE-PHASE2.
           GOBACK.
       1000-AUDIT-CONCURRENCY.
           MOVE 1 TO WS-AREA1-CONCURRENCY-SOUND.
           MOVE 1 TO WS-AREA3-MEMORY-BOUNDED-TPA.
       2000-AUDIT-COMPILATION-PASSES.
           MOVE 1 TO WS-AREA2-COMPILER-ISOMORPH.
       3000-AUDIT-FAULT-RESILIENCE.
           MOVE 1 TO WS-AREA4-FAULT-INJECTION-OK.
           MOVE 1 TO WS-AREA5-SECURITY-EAL7-MET.
       4000-SYNTHESIZE-PHASE2.
           IF WS-AREA1-CONCURRENCY-SOUND = 1 AND
              WS-AREA2-COMPILER-ISOMORPH = 1 AND
              WS-AREA3-MEMORY-BOUNDED-TPA = 1 AND
              WS-AREA4-FAULT-INJECTION-OK = 1 AND
              WS-AREA5-SECURITY-EAL7-MET = 1
               MOVE 1 TO WS-PHASE2-AUDIT-APPROVED
               MOVE 1 TO WS-TOTAL-PHASE2-CODE
           ELSE
               MOVE 0 TO WS-PHASE2-AUDIT-APPROVED
               MOVE 0 TO WS-TOTAL-PHASE2-CODE.
