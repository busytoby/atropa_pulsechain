        IDENTIFICATION DIVISION.
        PROGRAM-ID. RATIONAL-ANNIHILATOR-STRATEGY.
        AUTHOR. AUNCIENT DYSNOMIA VM / ANNIHILATOR CONTRACTION AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-ANN-PARAMS.
           05 WS-GEN-COUNT-K            PIC 9(02) VALUE 02.
           05 WS-WEYL-RANK-R            PIC 9(02) VALUE 01.
           05 WS-DIFF-ORDER-D           PIC 9(02) VALUE 02.
           05 WS-INTERSECT-FLAG         PIC 9(01) VALUE 1.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-ANN-VITALITY           PIC 9(09) VALUE 0.
           05 WS-ACTION-COHERENCE       PIC 9(09) VALUE 0.
           05 WS-ANN-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-ANN-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 INVALID-GEN-COUNT           VALUE 2.
              88 INVALID-WEYL-RANK           VALUE 3.
              88 INVALID-DIFF-ORDER          VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 CONTRACTION-FLAG-FAIL       VALUE 6.
              88 CONTRACTION-DIVERG-FAIL     VALUE 7.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 8.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-ANNIHILATOR
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-GEN-COUNT-K < 1 OR WS-GEN-COUNT-K > 16
                SET INVALID-GEN-COUNT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-WEYL-RANK-R < 1 OR WS-WEYL-RANK-R > 16
                SET INVALID-WEYL-RANK TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-DIFF-ORDER-D < 1 OR WS-DIFF-ORDER-D > 16
                SET INVALID-DIFF-ORDER TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-INTERSECT-FLAG NOT EQUAL 1
                SET CONTRACTION-FLAG-FAIL TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-ANNIHILATOR.
            COMPUTE WS-ANN-VITALITY = (WS-GEN-COUNT-K * 512) +
                                      (WS-WEYL-RANK-R * 256) +
                                      (WS-DIFF-ORDER-D * 64) +
                                      (WS-INTERSECT-FLAG * 128) + 1.

            IF WS-ANN-VITALITY EQUAL ZERO
                SET CONTRACTION-DIVERG-FAIL TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-ACTION-COHERENCE = (WS-DIFF-ORDER-D * 32) +
                                          (WS-GEN-COUNT-K * 64) +
                                          (WS-WEYL-RANK-R * 16).

            COMPUTE WS-ANN-REBAR-LATCH = 1470169088 + (WS-GEN-COUNT-K * 256) +
                                         (WS-WEYL-RANK-R * 64) +
                                         (WS-DIFF-ORDER-D * 8).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-ANN-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-ANN-VITALITY * 10) +
                                         (WS-ACTION-COHERENCE * 10) +
                                         (WS-GEN-COUNT-K * 1000) +
                                         (WS-ANN-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-ANN-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-ANN-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
