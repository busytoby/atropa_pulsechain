        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-UNIFIED-ORCH.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-UNIFIED-ORCH-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1616-ORCH-OK           PIC 9(01) VALUE 1.
            05  WS-TH1617-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1618-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1619-1620M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1620-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-UNIFIED-ORCH-WIT         PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-UNIFIED-ORCH.
            GOBACK.
        1000-EVALUATE-UNIFIED-ORCH.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1616-ORCH-OK = 1 AND
               WS-TH1617-DATBIN-STRAT-OK = 1 AND
               WS-TH1618-SUBMICRO-LAT-OK = 1 AND
               WS-TH1619-1620M-SAAT-OK = 1 AND
               WS-TH1620-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-UNIFIED-ORCH-WIT
            ELSE
                MOVE 0 TO WS-UNIFIED-ORCH-WIT.
