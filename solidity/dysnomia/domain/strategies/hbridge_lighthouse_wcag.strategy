        IDENTIFICATION DIVISION.
        PROGRAM-ID. HBR-LGH-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / H-BRIDGE LIGHTHOUSE AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-LGH-PARAMS.
           05 WS-LIGHTHOUSE-SCORE-PCT   PIC 9(03) VALUE 095.
           05 WS-COMMUTATION-DUTY-PCT   PIC 9(02) VALUE 50.
           05 WS-CRITIQUE-ITERATIONS    PIC 9(02) VALUE 02.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-LGH-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-LGH-VITALITY           PIC 9(09) VALUE 0.
           05 WS-LGH-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-LGH-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-LGH-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 LIGHTHOUSE-SCORE-LOW        VALUE 2.
              88 COMMUTATION-DUTY-OUT-OF-BND VALUE 3.
              88 CRITIQUE-ITER-EXCEEDED      VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 LIGHTHOUSE-COLLAPSE         VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-HBRIDGE-LIGHTHOUSE
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-LIGHTHOUSE-SCORE-PCT < 85 OR WS-LIGHTHOUSE-SCORE-PCT > 100
                SET LIGHTHOUSE-SCORE-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-COMMUTATION-DUTY-PCT < 40 OR WS-COMMUTATION-DUTY-PCT > 60
                SET COMMUTATION-DUTY-OUT-OF-BND TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CRITIQUE-ITERATIONS < 1 OR WS-CRITIQUE-ITERATIONS > 5
                SET CRITIQUE-ITER-EXCEEDED TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-HBRIDGE-LIGHTHOUSE.
            COMPUTE WS-LGH-COMPOSITE = (WS-LIGHTHOUSE-SCORE-PCT * 10) +
                                       (WS-COMMUTATION-DUTY-PCT * 10) +
                                       ((6 - WS-CRITIQUE-ITERATIONS) * 50).

            COMPUTE WS-LGH-VITALITY = (WS-LGH-COMPOSITE / 4) +
                                      (WS-LIGHTHOUSE-SCORE-PCT * 2) +
                                      (WS-COMMUTATION-DUTY-PCT * 2) + 1.

            IF WS-LGH-VITALITY EQUAL ZERO
                SET LIGHTHOUSE-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-LGH-COHERENCE = (WS-LGH-COMPOSITE / 16) +
                                       (WS-LIGHTHOUSE-SCORE-PCT / 4) +
                                       (WS-COMMUTATION-DUTY-PCT / 4).

            COMPUTE WS-LGH-REBAR-LATCH = 1470169088 +
                                         (WS-LGH-COMPOSITE / 2) +
                                         (WS-LIGHTHOUSE-SCORE-PCT * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-LGH-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-LGH-VITALITY * 10) +
                                         (WS-LGH-COHERENCE * 10) +
                                         (WS-LGH-COMPOSITE * 10) +
                                         (WS-LGH-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-LGH-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-LGH-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
