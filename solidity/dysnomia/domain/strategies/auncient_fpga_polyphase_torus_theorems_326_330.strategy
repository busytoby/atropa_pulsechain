        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-TORUS.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-TORUS-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH326-HELICAL-128PH-OK   PIC 9(01) VALUE 1.
            05  WS-TH327-CHIRAL-FLUX-OK     PIC 9(01) VALUE 1.
            05  WS-TH328-BERRY-PHASE-OK     PIC 9(01) VALUE 1.
            05  WS-TH329-HELICAL-SAAT-OK    PIC 9(01) VALUE 1.
            05  WS-TH330-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-TORUS-WIT           PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-TORUS.
            GOBACK.
        1000-EVALUATE-TORUS.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH326-HELICAL-128PH-OK = 1 AND
               WS-TH327-CHIRAL-FLUX-OK = 1 AND
               WS-TH328-BERRY-PHASE-OK = 1 AND
               WS-TH329-HELICAL-SAAT-OK = 1 AND
               WS-TH330-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-TORUS-WIT
            ELSE
                MOVE 0 TO WS-FPGA-TORUS-WIT.
