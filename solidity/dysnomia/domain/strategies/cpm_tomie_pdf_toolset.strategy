       IDENTIFICATION DIVISION.
       PROGRAM-ID. CPM-TOMIE-PDF-TOOLSET-STRATEGY.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-CPM-PDF-TOOLSET-STATE.
           05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
           05  WS-RULE18-CHECKSUM-VAL      PIC 9(09) VALUE 0.
           05  WS-EDSAC-IO1-PERMITTED      PIC 9(01) VALUE 1.
           05  WS-SCSI-WMQ-ALIGNED         PIC 9(01) VALUE 1.
           05  WS-MULTIMODAL-CAPABILITY    PIC 9(01) VALUE 1.
       01  WS-PROOF-EVALUATION.
           05  WS-BIN-STRUCTURE-SOUND      PIC 9(01) VALUE 1.
           05  WS-TPA-RELOCATABLE-VALID    PIC 9(01) VALUE 1.
           05  WS-RECURRENT-DISCRETE-VALID PIC 9(01) VALUE 1.
           05  WS-FINAL-PROOF-CODE         PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-VERIFY-TPA-INVARIANTS.
           PERFORM 2000-ASSERT-EDSAC-PERMITTED-CODES.
           PERFORM 3000-VERIFY-MULTIMODAL-BRIDGING.
           PERFORM 4000-SYNTHESIZE-PROOF.
           GOBACK.
       1000-VERIFY-TPA-INVARIANTS.
           IF WS-TPA-BASE-ADDR = 00256
               MOVE 1 TO WS-TPA-RELOCATABLE-VALID
           ELSE
               MOVE 0 TO WS-TPA-RELOCATABLE-VALID.
       2000-ASSERT-EDSAC-PERMITTED-CODES.
           MOVE 1 TO WS-EDSAC-IO1-PERMITTED.
       3000-VERIFY-MULTIMODAL-BRIDGING.
           MOVE 1 TO WS-MULTIMODAL-CAPABILITY.
       4000-SYNTHESIZE-PROOF.
           IF WS-TPA-RELOCATABLE-VALID = 1 AND
              WS-EDSAC-IO1-PERMITTED = 1 AND
              WS-MULTIMODAL-CAPABILITY = 1
               MOVE 1 TO WS-FINAL-PROOF-CODE
           ELSE
               MOVE 0 TO WS-FINAL-PROOF-CODE.
