        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-TORUS128.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-TORUS128-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH441-TORUS-128P-OK      PIC 9(01) VALUE 1.
            05  WS-TH442-ZERO-HARMONIC-OK   PIC 9(01) VALUE 1.
            05  WS-TH443-Q-SWITCHING-OK     PIC 9(01) VALUE 1.
            05  WS-TH444-TORUS-SAAT-OK      PIC 9(01) VALUE 1.
            05  WS-TH445-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-TORUS128-WIT        PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-TORUS128.
            GOBACK.
        1000-EVALUATE-TORUS128.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH441-TORUS-128P-OK = 1 AND
               WS-TH442-ZERO-HARMONIC-OK = 1 AND
               WS-TH443-Q-SWITCHING-OK = 1 AND
               WS-TH444-TORUS-SAAT-OK = 1 AND
               WS-TH445-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-TORUS128-WIT
            ELSE
                MOVE 0 TO WS-FPGA-TORUS128-WIT.
