        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-SDK-FIBER-BND.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FIBER-BND-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1226-FIBER-OK          PIC 9(01) VALUE 1.
            05  WS-TH1227-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1228-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1229-1230M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1230-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-FIBER-BND-WIT            PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-FIBER-BND.
            GOBACK.
        1000-EVALUATE-FIBER-BND.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1226-FIBER-OK = 1 AND
               WS-TH1227-DATBIN-STRAT-OK = 1 AND
               WS-TH1228-SUBMICRO-LAT-OK = 1 AND
               WS-TH1229-1230M-SAAT-OK = 1 AND
               WS-TH1230-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-FIBER-BND-WIT
            ELSE
                MOVE 0 TO WS-FIBER-BND-WIT.
