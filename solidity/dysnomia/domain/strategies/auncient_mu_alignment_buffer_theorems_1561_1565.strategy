        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-ALIGN-BUF.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-ALIGN-BUF-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1561-ALIGN-OK          PIC 9(01) VALUE 1.
            05  WS-TH1562-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1563-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1564-1565M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1565-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-ALIGN-BUF-WIT            PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-ALIGN-BUF.
            GOBACK.
        1000-EVALUATE-ALIGN-BUF.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1561-ALIGN-OK = 1 AND
               WS-TH1562-DATBIN-STRAT-OK = 1 AND
               WS-TH1563-SUBMICRO-LAT-OK = 1 AND
               WS-TH1564-1565M-SAAT-OK = 1 AND
               WS-TH1565-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-ALIGN-BUF-WIT
            ELSE
                MOVE 0 TO WS-ALIGN-BUF-WIT.
