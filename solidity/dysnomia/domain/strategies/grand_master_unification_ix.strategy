        IDENTIFICATION DIVISION.
        PROGRAM-ID. GM-UNIF-IX-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / GRAND MASTER UNIFICATION IX AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-U9-PARAMS.
           05 WS-S-VIII-M               PIC 9(04) VALUE 0850.
           05 WS-S-HASP-BIN-M           PIC 9(04) VALUE 0860.
           05 WS-S-UTT-SLICE-M          PIC 9(04) VALUE 0870.
           05 WS-S-HASP-VOC-M           PIC 9(04) VALUE 0880.
           05 WS-E-ECHO-CANCEL-M        PIC 9(04) VALUE 0890.
           05 WS-E-MULTIUSER-ISO-M      PIC 9(04) VALUE 0900.
           05 WS-E-DIFFUSER-MOD-M       PIC 9(04) VALUE 0910.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-U9-COMPOSITE           PIC 9(04) VALUE 0.
           05 WS-U9-VITALITY            PIC 9(09) VALUE 0.
           05 WS-U9-COHERENCE           PIC 9(09) VALUE 0.
           05 WS-U9-REBAR-LATCH         PIC 9(12) VALUE 0.
           05 WS-SHADOW-U9-BASE         PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 UNIFICATION-VIII-LOW        VALUE 2.
              88 HASP-BIN-OR-UTT-LOW         VALUE 3.
              88 HASP-VOC-OR-ECHO-LOW        VALUE 4.
              88 MULTIUSER-OR-DIFFUSER-LOW   VALUE 5.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 6.
              88 UNIFICATION-IX-COLLAPSE     VALUE 7.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 8.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-UNIFICATION-IX
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-S-VIII-M < 500 OR WS-S-VIII-M > 1000
                SET UNIFICATION-VIII-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-S-HASP-BIN-M < 600 OR WS-S-HASP-BIN-M > 1000 OR
               WS-S-UTT-SLICE-M < 600 OR WS-S-UTT-SLICE-M > 1000
                SET HASP-BIN-OR-UTT-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-S-HASP-VOC-M < 600 OR WS-S-HASP-VOC-M > 1000 OR
               WS-E-ECHO-CANCEL-M < 600 OR WS-E-ECHO-CANCEL-M > 1000
                SET HASP-VOC-OR-ECHO-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-E-MULTIUSER-ISO-M < 600 OR WS-E-MULTIUSER-ISO-M > 1000 OR
               WS-E-DIFFUSER-MOD-M < 600 OR WS-E-DIFFUSER-MOD-M > 1000
                SET MULTIUSER-OR-DIFFUSER-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-UNIFICATION-IX.
            COMPUTE WS-U9-COMPOSITE = (WS-S-VIII-M / 7) +
                                      (WS-S-HASP-BIN-M / 7) +
                                      (WS-S-UTT-SLICE-M / 7) +
                                      (WS-S-HASP-VOC-M / 7) +
                                      (WS-E-ECHO-CANCEL-M / 7) +
                                      (WS-E-MULTIUSER-ISO-M / 7) +
                                      (WS-E-DIFFUSER-MOD-M / 7).

            COMPUTE WS-U9-VITALITY = (WS-U9-COMPOSITE / 4) +
                                     (WS-S-VIII-M / 8) +
                                     (WS-S-HASP-BIN-M / 8) + 1.

            IF WS-U9-VITALITY EQUAL ZERO
                SET UNIFICATION-IX-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-U9-COHERENCE = (WS-U9-COMPOSITE / 16) +
                                      (WS-S-VIII-M / 16) +
                                      (WS-S-HASP-BIN-M / 16).

            COMPUTE WS-U9-REBAR-LATCH = 1470169088 +
                                        (WS-U9-COMPOSITE / 2) +
                                        (WS-S-VIII-M * 64).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-U9-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                        (WS-U9-VITALITY * 10) +
                                        (WS-U9-COHERENCE * 10) +
                                        (WS-U9-COMPOSITE * 10) +
                                        (WS-U9-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-U9-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-U9-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
