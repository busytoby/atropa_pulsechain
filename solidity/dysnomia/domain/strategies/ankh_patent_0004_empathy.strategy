       IDENTIFICATION DIVISION.
       PROGRAM-ID. ANKH-PATENT-0004-STRAT.
       AUTHOR. AUNCIENT DYSNOMIA VM / PATENT 0004.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-PATENT-PARAMS.
          05 WS-INIT-TURBULENCE-T0     PIC 9(05) VALUE 19000.
          05 WS-MANIFOLD-DIM-D         PIC 9(02) VALUE 16.
          05 WS-MANIFOLD-CYCLES-N      PIC 9(02) VALUE 16.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-CURRENT-TURBULENCE     PIC 9(05) VALUE 0.
          05 WS-STEP-IDX               PIC 9(02) VALUE 0.
          05 WS-SHADOW-PATENT-BASE     PIC 9(12) VALUE 0.
          05 WS-CYC-MOD                PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-TURBULENCE-T0       VALUE 2.
             88 INVALID-MANIFOLD-DIM-D      VALUE 3.
             88 INVALID-MANIFOLD-CYCLES-N   VALUE 4.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
             88 EMPATHY-TURBULENCE-FAIL     VALUE 6.
             88 GATING-CLAMP-OVERFLOW       VALUE 7.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 8.
             88 CASCADE-ROLLBACK-FAIL       VALUE 9.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-EMPATHY-CONTRACTION
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-INIT-TURBULENCE-T0 > 50000
               SET INVALID-TURBULENCE-T0 TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-MANIFOLD-DIM-D < 1 OR WS-MANIFOLD-DIM-D > 64
               SET INVALID-MANIFOLD-DIM-D TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-MANIFOLD-CYCLES-N < 1 OR WS-MANIFOLD-CYCLES-N > 64
               SET INVALID-MANIFOLD-CYCLES-N TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-EMPATHY-CONTRACTION.
           MOVE WS-INIT-TURBULENCE-T0 TO WS-CURRENT-TURBULENCE.

           PERFORM VARYING WS-STEP-IDX FROM 1 BY 1 UNTIL WS-STEP-IDX > WS-MANIFOLD-CYCLES-N
               COMPUTE WS-CURRENT-TURBULENCE = (WS-CURRENT-TURBULENCE * 875) / 1000
           END-PERFORM.

           IF WS-CURRENT-TURBULENCE > WS-INIT-TURBULENCE-T0
               SET EMPATHY-TURBULENCE-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-SHADOW-PATENT-BASE = (WS-CICS-WRITER-ID * 1000000) + 
               (WS-MANIFOLD-CYCLES-N * 10000) + (WS-MANIFOLD-DIM-D * 100) + (WS-CURRENT-TURBULENCE / 16).

           COMPUTE WS-CYC-MOD = FUNCTION MOD(WS-MANIFOLD-DIM-D, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-CYC-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-PATENT-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-PATENT-BASE + ((WS-CURRENT-TURBULENCE * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-PATENT-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-MANIFOLD-CYCLES-N * 10000) + (WS-MANIFOLD-DIM-D * 100) + (WS-CURRENT-TURBULENCE / 16))
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-PATENT-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
