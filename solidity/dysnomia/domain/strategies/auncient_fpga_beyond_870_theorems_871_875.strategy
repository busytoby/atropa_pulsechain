        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-BEYOND-870.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-BEYOND-870-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH871-ZORSE-AUTOCAL-OK   PIC 9(01) VALUE 1.
            05  WS-TH872-AUTOCAL-MERKLE-OK  PIC 9(01) VALUE 1.
            05  WS-TH873-AUTOCAL-LAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH874-875M-SAAT-OK       PIC 9(01) VALUE 1.
            05  WS-TH875-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-BEYOND-870-WIT      PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-BEYOND-870.
            GOBACK.
        1000-EVALUATE-BEYOND-870.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH871-ZORSE-AUTOCAL-OK = 1 AND
               WS-TH872-AUTOCAL-MERKLE-OK = 1 AND
               WS-TH873-AUTOCAL-LAT-OK = 1 AND
               WS-TH874-875M-SAAT-OK = 1 AND
               WS-TH875-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-BEYOND-870-WIT
            ELSE
                MOVE 0 TO WS-FPGA-BEYOND-870-WIT.
