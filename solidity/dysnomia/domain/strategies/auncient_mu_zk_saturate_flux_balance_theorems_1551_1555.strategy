        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-ZKSAT-FLUX.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-ZKSAT-FLUX-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1551-FLUX-OK           PIC 9(01) VALUE 1.
            05  WS-TH1552-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1553-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1554-1555M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1555-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-ZKSAT-FLUX-WIT           PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-ZKSAT-FLUX.
            GOBACK.
        1000-EVALUATE-ZKSAT-FLUX.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1551-FLUX-OK = 1 AND
               WS-TH1552-DATBIN-STRAT-OK = 1 AND
               WS-TH1553-SUBMICRO-LAT-OK = 1 AND
               WS-TH1554-1555M-SAAT-OK = 1 AND
               WS-TH1555-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-ZKSAT-FLUX-WIT
            ELSE
                MOVE 0 TO WS-ZKSAT-FLUX-WIT.
