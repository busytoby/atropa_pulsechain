        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-CPMTOMIE-ANKH.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-CPMTOMIE-ANKH-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH516-ANKH-INFER-OK      PIC 9(01) VALUE 1.
            05  WS-TH517-COBOL-EQUIV-OK     PIC 9(01) VALUE 1.
            05  WS-TH518-REASONING-OK       PIC 9(01) VALUE 1.
            05  WS-TH519-ANKH-SAAT-OK       PIC 9(01) VALUE 1.
            05  WS-TH520-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-CPMTOMIE-ANKH-WIT   PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-CPMTOMIE-ANKH.
            GOBACK.
        1000-EVALUATE-CPMTOMIE-ANKH.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH516-ANKH-INFER-OK = 1 AND
               WS-TH517-COBOL-EQUIV-OK = 1 AND
               WS-TH518-REASONING-OK = 1 AND
               WS-TH519-ANKH-SAAT-OK = 1 AND
               WS-TH520-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-CPMTOMIE-ANKH-WIT
            ELSE
                MOVE 0 TO WS-FPGA-CPMTOMIE-ANKH-WIT.
