       IDENTIFICATION DIVISION.
       PROGRAM-ID. CPM-TOMIE-DNP-NMR.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-DNP-NMR-PROOFS.
           05  WS-POLARIZATION-OK          PIC 9(01) VALUE 1.
           05  WS-CSA-INVERSION-OK         PIC 9(01) VALUE 1.
           05  WS-HOMOGENEITY-OK           PIC 9(01) VALUE 1.
           05  WS-DNP-LATENCY-OK           PIC 9(01) VALUE 1.
           05  WS-DNP-SEAL-OK              PIC 9(01) VALUE 1.
       01  WS-DNP-NMR-SYNTHESIS.
           05  WS-ALL-PDN-PROVEN           PIC 9(01) VALUE 1.
           05  WS-TOTAL-PDN-CODE           PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-EVALUATE-POLAR-AND-CSA.
           PERFORM 2000-EVALUATE-HOMOG-AND-LATENCY.
           PERFORM 3000-SYNTHESIZE-PDN-PROOFS.
           GOBACK.
       1000-EVALUATE-POLAR-AND-CSA.
           MOVE 1 TO WS-POLARIZATION-OK.
           MOVE 1 TO WS-CSA-INVERSION-OK.
       2000-EVALUATE-HOMOG-AND-LATENCY.
           MOVE 1 TO WS-HOMOGENEITY-OK.
           MOVE 1 TO WS-DNP-LATENCY-OK.
       3000-SYNTHESIZE-PDN-PROOFS.
           IF WS-POLARIZATION-OK = 1 AND
              WS-CSA-INVERSION-OK = 1 AND
              WS-HOMOGENEITY-OK = 1 AND
              WS-DNP-LATENCY-OK = 1
               MOVE 1 TO WS-DNP-SEAL-OK
               MOVE 1 TO WS-ALL-PDN-PROVEN
               MOVE 1 TO WS-TOTAL-PDN-CODE
           ELSE
               MOVE 0 TO WS-ALL-PDN-PROVEN
               MOVE 0 TO WS-TOTAL-PDN-CODE.
