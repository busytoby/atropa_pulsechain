        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-MLA.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-MLA-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1106-MLA-OK            PIC 9(01) VALUE 1.
            05  WS-TH1107-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1108-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1109-1110M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1110-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-FPGA-MLA-WIT             PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-FPGA-MLA.
            GOBACK.
        1000-EVALUATE-FPGA-MLA.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1106-MLA-OK = 1 AND
               WS-TH1107-DATBIN-STRAT-OK = 1 AND
               WS-TH1108-SUBMICRO-LAT-OK = 1 AND
               WS-TH1109-1110M-SAAT-OK = 1 AND
               WS-TH1110-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-FPGA-MLA-WIT
            ELSE
                MOVE 0 TO WS-FPGA-MLA-WIT.
