        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-HOLO-WDM.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-HOLO-WDM-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH431-BERRY-PHASE-OK     PIC 9(01) VALUE 1.
            05  WS-TH432-DWDM-64CH-OK       PIC 9(01) VALUE 1.
            05  WS-TH433-CROSS-TALK-OK      PIC 9(01) VALUE 1.
            05  WS-TH434-HOLO-SAAT-OK       PIC 9(01) VALUE 1.
            05  WS-TH435-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-HOLO-WDM-WIT        PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-HOLO-WDM.
            GOBACK.
        1000-EVALUATE-HOLO-WDM.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH431-BERRY-PHASE-OK = 1 AND
               WS-TH432-DWDM-64CH-OK = 1 AND
               WS-TH433-CROSS-TALK-OK = 1 AND
               WS-TH434-HOLO-SAAT-OK = 1 AND
               WS-TH435-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-HOLO-WDM-WIT
            ELSE
                MOVE 0 TO WS-FPGA-HOLO-WDM-WIT.
