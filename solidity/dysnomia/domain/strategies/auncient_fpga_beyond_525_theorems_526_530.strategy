        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-BEYOND-525.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-BEYOND-525-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH526-POYNTING-OK        PIC 9(01) VALUE 1.
            05  WS-TH527-TORUS-COHER-OK     PIC 9(01) VALUE 1.
            05  WS-TH528-CRYO-QUBIT-OK      PIC 9(01) VALUE 1.
            05  WS-TH529-TORUS-SAAT-OK      PIC 9(01) VALUE 1.
            05  WS-TH530-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-BEYOND-525-WIT      PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-BEYOND-525.
            GOBACK.
        1000-EVALUATE-BEYOND-525.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH526-POYNTING-OK = 1 AND
               WS-TH527-TORUS-COHER-OK = 1 AND
               WS-TH528-CRYO-QUBIT-OK = 1 AND
               WS-TH529-TORUS-SAAT-OK = 1 AND
               WS-TH530-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-BEYOND-525-WIT
            ELSE
                MOVE 0 TO WS-FPGA-BEYOND-525-WIT.
