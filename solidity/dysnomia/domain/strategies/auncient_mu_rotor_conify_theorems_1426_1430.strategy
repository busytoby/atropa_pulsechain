        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-ROTOR-CONIFY.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-ROTOR-CONIFY-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1426-CONIFY-OK         PIC 9(01) VALUE 1.
            05  WS-TH1427-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1428-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1429-1430M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1430-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-ROTOR-CONIFY-WIT         PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-ROTOR-CONIFY.
            GOBACK.
        1000-EVALUATE-ROTOR-CONIFY.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1426-CONIFY-OK = 1 AND
               WS-TH1427-DATBIN-STRAT-OK = 1 AND
               WS-TH1428-SUBMICRO-LAT-OK = 1 AND
               WS-TH1429-1430M-SAAT-OK = 1 AND
               WS-TH1430-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-ROTOR-CONIFY-WIT
            ELSE
                MOVE 0 TO WS-ROTOR-CONIFY-WIT.
