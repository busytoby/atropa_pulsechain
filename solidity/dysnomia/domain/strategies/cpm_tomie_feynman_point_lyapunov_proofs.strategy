       IDENTIFICATION DIVISION.
       PROGRAM-ID. CPM-TOMIE-FEYNMAN-POINT.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-FEYNMAN-POINT-PROOFS.
           05  WS-HEX-PHASE-INVAR-OK       PIC 9(01) VALUE 1.
           05  WS-ENERGY-MINIMUM-OK        PIC 9(01) VALUE 1.
           05  WS-ORBIT-TRAPPING-OK        PIC 9(01) VALUE 1.
           05  WS-PHASE-JITTER-OK          PIC 9(01) VALUE 1.
           05  WS-FEYNMAN-SEAL-OK          PIC 9(01) VALUE 1.
       01  WS-FEYNMAN-SYNTHESIS.
           05  WS-ALL-FEYNMAN-PROVEN       PIC 9(01) VALUE 1.
           05  WS-TOTAL-FEYNMAN-CODE       PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-EVALUATE-PHASE-AND-ENERGY.
           PERFORM 2000-EVALUATE-ORBIT-AND-JITTER.
           PERFORM 3000-SYNTHESIZE-FEYNMAN-PROOFS.
           GOBACK.
       1000-EVALUATE-PHASE-AND-ENERGY.
           MOVE 1 TO WS-HEX-PHASE-INVAR-OK.
           MOVE 1 TO WS-ENERGY-MINIMUM-OK.
       2000-EVALUATE-ORBIT-AND-JITTER.
           MOVE 1 TO WS-ORBIT-TRAPPING-OK.
           MOVE 1 TO WS-PHASE-JITTER-OK.
       3000-SYNTHESIZE-FEYNMAN-PROOFS.
           IF WS-HEX-PHASE-INVAR-OK = 1 AND
              WS-ENERGY-MINIMUM-OK = 1 AND
              WS-ORBIT-TRAPPING-OK = 1 AND
              WS-PHASE-JITTER-OK = 1
               MOVE 1 TO WS-FEYNMAN-SEAL-OK
               MOVE 1 TO WS-ALL-FEYNMAN-PROVEN
               MOVE 1 TO WS-TOTAL-FEYNMAN-CODE
           ELSE
               MOVE 0 TO WS-ALL-FEYNMAN-PROVEN
               MOVE 0 TO WS-TOTAL-FEYNMAN-CODE.
