        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-VSEN-SWMCHOR.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-VSEN-SWMCHOR-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1921-SWARM-SYNC-OK     PIC 9(01) VALUE 1.
            05  WS-TH1922-ANTICIP-FET-OK    PIC 9(01) VALUE 1.
            05  WS-TH1923-SWARM-LAT-OK      PIC 9(01) VALUE 1.
            05  WS-TH1924-1925M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1925-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-VSEN-SWMCHOR-WIT         PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-VSEN-SWMCHOR.
            GOBACK.
        1000-EVALUATE-VSEN-SWMCHOR.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1921-SWARM-SYNC-OK = 1 AND
               WS-TH1922-ANTICIP-FET-OK = 1 AND
               WS-TH1923-SWARM-LAT-OK = 1 AND
               WS-TH1924-1925M-SAAT-OK = 1 AND
               WS-TH1925-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-VSEN-SWMCHOR-WIT
            ELSE
                MOVE 0 TO WS-VSEN-SWMCHOR-WIT.
