        IDENTIFICATION DIVISION.
        PROGRAM-ID. HWB-BNCH-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / HOLONOMIC WEYL BENCHMARK AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-HWB-PARAMS.
           05 WS-COMMUTATOR-LAT-NS      PIC 9(03) VALUE 250.
           05 WS-ELIM-THROUGHPUT-KOPS   PIC 9(03) VALUE 120.
           05 WS-OPERATOR-DEGREE-BOUND  PIC 9(02) VALUE 02.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-HWB-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-HWB-VITALITY           PIC 9(09) VALUE 0.
           05 WS-HWB-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-HWB-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-HWB-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 COMMUTATOR-LAT-EXCEEDED     VALUE 2.
              88 ELIM-THROUGHPUT-LOW         VALUE 3.
              88 OPERATOR-DEGREE-OUT-OF-BND  VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 BENCHMARK-COLLAPSE          VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-WEYL-BENCHMARK
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-COMMUTATOR-LAT-NS < 50 OR WS-COMMUTATOR-LAT-NS > 950
                SET COMMUTATOR-LAT-EXCEEDED TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-ELIM-THROUGHPUT-KOPS < 10 OR WS-ELIM-THROUGHPUT-KOPS > 500
                SET ELIM-THROUGHPUT-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-OPERATOR-DEGREE-BOUND < 1 OR WS-OPERATOR-DEGREE-BOUND > 8
                SET OPERATOR-DEGREE-OUT-OF-BND TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-WEYL-BENCHMARK.
            COMPUTE WS-HWB-COMPOSITE = ((1000 - WS-COMMUTATOR-LAT-NS) / 2) +
                                       (WS-ELIM-THROUGHPUT-KOPS * 2) +
                                       ((9 - WS-OPERATOR-DEGREE-BOUND) * 50).

            COMPUTE WS-HWB-VITALITY = (WS-HWB-COMPOSITE / 4) +
                                      (WS-ELIM-THROUGHPUT-KOPS / 2) +
                                      ((1000 - WS-COMMUTATOR-LAT-NS) / 10) + 1.

            IF WS-HWB-VITALITY EQUAL ZERO
                SET BENCHMARK-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-HWB-COHERENCE = (WS-HWB-COMPOSITE / 16) +
                                       (WS-ELIM-THROUGHPUT-KOPS / 8) +
                                       ((1000 - WS-COMMUTATOR-LAT-NS) / 40).

            COMPUTE WS-HWB-REBAR-LATCH = 1470169088 +
                                         (WS-HWB-COMPOSITE / 2) +
                                         (WS-ELIM-THROUGHPUT-KOPS * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-HWB-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-HWB-VITALITY * 10) +
                                         (WS-HWB-COHERENCE * 10) +
                                         (WS-HWB-COMPOSITE * 10) +
                                         (WS-HWB-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-HWB-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-HWB-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
