       IDENTIFICATION DIVISION.
       PROGRAM-ID. LYAPUNOV-ADDR-STRATEGY.
       AUTHOR. AUNCIENT DYSNOMIA VM / ADDRESS RESOLUTION.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-ADDR-PARAMS.
          05 WS-RESOLVE-MODE-CODE      PIC 9(01) VALUE 1.
          05 WS-RAW-CONTRACT-ADDR      PIC 9(05) VALUE 25000.
          05 WS-RESOLUTION-CYCLES-N    PIC 9(02) VALUE 16.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-CURRENT-ADDR-METRIC    PIC 9(05) VALUE 0.
          05 WS-STEP-IDX               PIC 9(02) VALUE 0.
          05 WS-ADDR-MOD               PIC 9(03) VALUE 0.
          05 WS-SHADOW-ADDR-BASE       PIC 9(12) VALUE 0.
          05 WS-CYC-MOD                PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 NAME-RESOLUTION-BANNED      VALUE 2.
             88 INVALID-CONTRACT-ADDR       VALUE 3.
             88 INVALID-RESOLUTION-CYCLES   VALUE 4.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
             88 ADDRESS-DIVERG-FAIL         VALUE 6.
             88 GATING-CLAMP-OVERFLOW       VALUE 7.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 8.
             88 CASCADE-ROLLBACK-FAIL       VALUE 9.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-ADDR-CONTRACTION
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-RESOLVE-MODE-CODE NOT EQUAL 1
               SET NAME-RESOLUTION-BANNED TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-RAW-CONTRACT-ADDR EQUAL ZERO OR WS-RAW-CONTRACT-ADDR > 50000
               SET INVALID-CONTRACT-ADDR TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-RESOLUTION-CYCLES-N < 1 OR WS-RESOLUTION-CYCLES-N > 64
               SET INVALID-RESOLUTION-CYCLES TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-ADDR-CONTRACTION.
           MOVE WS-RAW-CONTRACT-ADDR TO WS-CURRENT-ADDR-METRIC.

           PERFORM VARYING WS-STEP-IDX FROM 1 BY 1 UNTIL WS-STEP-IDX > WS-RESOLUTION-CYCLES-N
               COMPUTE WS-CURRENT-ADDR-METRIC = (WS-CURRENT-ADDR-METRIC * 875) / 1000
           END-PERFORM.

           IF WS-CURRENT-ADDR-METRIC > WS-RAW-CONTRACT-ADDR
               SET ADDRESS-DIVERG-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-ADDR-MOD = FUNCTION MOD(WS-RAW-CONTRACT-ADDR, 100).

           COMPUTE WS-SHADOW-ADDR-BASE = (WS-CICS-WRITER-ID * 1000000) + 
               (WS-RESOLUTION-CYCLES-N * 10000) + (WS-ADDR-MOD * 10) + (WS-CURRENT-ADDR-METRIC / 16).

           COMPUTE WS-CYC-MOD = FUNCTION MOD(WS-RESOLUTION-CYCLES-N, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-CYC-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-ADDR-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-ADDR-BASE + ((WS-CURRENT-ADDR-METRIC * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-ADDR-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-RESOLUTION-CYCLES-N * 10000) + (WS-ADDR-MOD * 10) + (WS-CURRENT-ADDR-METRIC / 16))
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-ADDR-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
