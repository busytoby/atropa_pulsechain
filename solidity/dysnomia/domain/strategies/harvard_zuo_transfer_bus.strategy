IDENTIFICATION DIVISION.
PROGRAM-ID. PROG-HARVARD-ZUO-BUS.

DATA DIVISION.
01 D0-SUBSTRATE-TRUNK.
   05 D0-MOTZKIN-PRIME     PIC 9(9) USAGE R0.
   05 D0-K-EXPONENT        PIC 9(9) USAGE R1.
   05 D0-BUS-FAULT-FLAG    PIC 9(9) USAGE R2.
01 D1-BUS-SHADOW.
   05 D1-SOURCE-SAAT-VALUE PIC 9(9) USAGE R3.
   05 D1-DECADE-COUNT      PIC 9(9) USAGE R4.
   05 D1-SHADOW-SRC-SNAP   PIC 9(9) USAGE R5.
01 D2-TRANSFER-STAGE.
   05 D2-DEST-SAAT-VALUE   PIC 9(9) USAGE R6.
   05 D2-G-SWIGLU-GATE     PIC 9(9) USAGE R7.
   05 D2-COMMITTED-STATE   PIC 9(9) USAGE R8.
01 D3-LEAF-EVAL.
   05 D3-PROOF-RULING      PIC 9(9) USAGE R9.
   05 D3-DISP-WRAP-MOD     PIC 9(9) USAGE R10.

PROCEDURE DIVISION.
    MOVE 953467954 TO D0-MOTZKIN-PRIME.
    MOVE 3 TO D0-K-EXPONENT.
    MOVE 0 TO D0-BUS-FAULT-FLAG.
    MOVE 1000000 TO D1-SOURCE-SAAT-VALUE.
    MOVE 24 TO D1-DECADE-COUNT.

    PERFORM STAGE-BUS-TRANSFER.
    PERFORM APPLY-BUS-LATCH.
    PERFORM SYNC-DISPLACEMENT.

    IF D1-SHADOW-SRC-SNAP == D1-SOURCE-SAAT-VALUE AND D2-DEST-SAAT-VALUE == 1000000
        MOVE 0 TO D3-PROOF-RULING
        SET depth 4
    ELSE
        MOVE 4 TO D3-PROOF-RULING
        SET depth 1
    END-IF.

    EVAL.
    GO TO END-STRATEGY.

STAGE-BUS-TRANSFER.
    MOVE D1-SOURCE-SAAT-VALUE TO D1-SHADOW-SRC-SNAP.
    MOVE D1-SOURCE-SAAT-VALUE TO D2-DEST-SAAT-VALUE.
    COMPUTE D2-G-SWIGLU-GATE = 875 + ((125 * D1-DECADE-COUNT) / 24).
    EXIT.

APPLY-BUS-LATCH.
    IF D0-BUS-FAULT-FLAG == 1
        MOVE D1-SHADOW-SRC-SNAP TO D2-COMMITTED-STATE
    ELSE
        COMPUTE D2-COMMITTED-STATE = (D2-DEST-SAAT-VALUE * D2-G-SWIGLU-GATE) / 1000
    END-IF.
    EXIT.

SYNC-DISPLACEMENT.
    COMPUTE D3-DISP-WRAP-MOD = D2-COMMITTED-STATE - ((D2-COMMITTED-STATE / 256) * 256).
    EXIT.

END-STRATEGY.
