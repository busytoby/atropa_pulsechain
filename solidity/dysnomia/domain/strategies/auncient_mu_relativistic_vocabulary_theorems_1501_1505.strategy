        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-RELAT-VOCAB.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-RELAT-VOCAB-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1501-VOCAB-OK          PIC 9(01) VALUE 1.
            05  WS-TH1502-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1503-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1504-1505M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1505-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-RELAT-VOCAB-WIT          PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-RELAT-VOCAB.
            GOBACK.
        1000-EVALUATE-RELAT-VOCAB.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1501-VOCAB-OK = 1 AND
               WS-TH1502-DATBIN-STRAT-OK = 1 AND
               WS-TH1503-SUBMICRO-LAT-OK = 1 AND
               WS-TH1504-1505M-SAAT-OK = 1 AND
               WS-TH1505-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-RELAT-VOCAB-WIT
            ELSE
                MOVE 0 TO WS-RELAT-VOCAB-WIT.
