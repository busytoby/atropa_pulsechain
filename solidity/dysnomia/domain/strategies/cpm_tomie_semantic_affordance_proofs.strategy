       IDENTIFICATION DIVISION.
       PROGRAM-ID. CPM-TOMIE-SEMANTIC-AFFORD.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-SEMANTIC-AFFORD-PROOFS.
           05  WS-WAVEFRONT-OK             PIC 9(01) VALUE 1.
           05  WS-GRADIENT-ALIGN-OK        PIC 9(01) VALUE 1.
           05  WS-MANIPULATION-OK          PIC 9(01) VALUE 1.
           05  WS-AFFORDANCE-LATENCY-OK    PIC 9(01) VALUE 1.
           05  WS-SEMANTIC-AFFORD-SEAL-OK  PIC 9(01) VALUE 1.
       01  WS-SEMANTIC-AFFORD-SYNTHESIS.
           05  WS-ALL-AFF-PROVEN           PIC 9(01) VALUE 1.
           05  WS-TOTAL-AFF-CODE           PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-EVALUATE-WAVEFRONT-AND-GRADIENT.
           PERFORM 2000-EVALUATE-MANIP-AND-LATENCY.
           PERFORM 3000-SYNTHESIZE-AFF-PROOFS.
           GOBACK.
       1000-EVALUATE-WAVEFRONT-AND-GRADIENT.
           MOVE 1 TO WS-WAVEFRONT-OK.
           MOVE 1 TO WS-GRADIENT-ALIGN-OK.
       2000-EVALUATE-MANIP-AND-LATENCY.
           MOVE 1 TO WS-MANIPULATION-OK.
           MOVE 1 TO WS-AFFORDANCE-LATENCY-OK.
       3000-SYNTHESIZE-AFF-PROOFS.
           IF WS-WAVEFRONT-OK = 1 AND
              WS-GRADIENT-ALIGN-OK = 1 AND
              WS-MANIPULATION-OK = 1 AND
              WS-AFFORDANCE-LATENCY-OK = 1
               MOVE 1 TO WS-SEMANTIC-AFFORD-SEAL-OK
               MOVE 1 TO WS-ALL-AFF-PROVEN
               MOVE 1 TO WS-TOTAL-AFF-CODE
           ELSE
               MOVE 0 TO WS-ALL-AFF-PROVEN
               MOVE 0 TO WS-TOTAL-AFF-CODE.
