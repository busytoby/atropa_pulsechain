        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-GRAND-150-UNIF.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-GRAND-150-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH146-THERMO-BIM-OK      PIC 9(01) VALUE 1.
            05  WS-TH147-BSDF-SAAT-OK       PIC 9(01) VALUE 1.
            05  WS-TH148-CLOSED-LOOP-OK     PIC 9(01) VALUE 1.
            05  WS-TH149-RULE18-UNIV-OK     PIC 9(01) VALUE 1.
            05  WS-TH150-MASTER-SEAL-OK     PIC 9(01) VALUE 1.
            05  WS-GRAND-150-WITNESS        PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-GRAND-150.
            GOBACK.
        1000-EVALUATE-GRAND-150.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH146-THERMO-BIM-OK = 1 AND
               WS-TH147-BSDF-SAAT-OK = 1 AND
               WS-TH148-CLOSED-LOOP-OK = 1 AND
               WS-TH149-RULE18-UNIV-OK = 1 AND
               WS-TH150-MASTER-SEAL-OK = 1
                MOVE 1 TO WS-GRAND-150-WITNESS
            ELSE
                MOVE 0 TO WS-GRAND-150-WITNESS.
