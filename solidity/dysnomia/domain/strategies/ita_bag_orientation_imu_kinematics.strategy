        IDENTIFICATION DIVISION.
        PROGRAM-ID. IBK-KIN-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / ITA-BAG IMU KINEMATICS AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-IBK-PARAMS.
           05 WS-IMU-NORM-LAT-MS        PIC 9(02) VALUE 10.
           05 WS-GAIT-DAMPEN-M          PIC 9(04) VALUE 0950.
           05 WS-PARALLAX-ERROR-MRAD    PIC 9(02) VALUE 03.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-IBK-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-IBK-VITALITY           PIC 9(09) VALUE 0.
           05 WS-IBK-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-IBK-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-IBK-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 IMU-LAT-OUT-OF-BOUNDS       VALUE 2.
              88 GAIT-DAMPEN-LOW             VALUE 3.
              88 PARALLAX-ERROR-EXCEEDED     VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 KINEMATIC-COLLAPSE          VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-KINEMATICS
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-IMU-NORM-LAT-MS < 5 OR WS-IMU-NORM-LAT-MS > 20
                SET IMU-LAT-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-GAIT-DAMPEN-M < 800 OR WS-GAIT-DAMPEN-M > 1000
                SET GAIT-DAMPEN-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-PARALLAX-ERROR-MRAD < 0 OR WS-PARALLAX-ERROR-MRAD > 8
                SET PARALLAX-ERROR-EXCEEDED TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-KINEMATICS.
            COMPUTE WS-IBK-COMPOSITE = ((25 - WS-IMU-NORM-LAT-MS) * 20) +
                                       (WS-GAIT-DAMPEN-M / 2) +
                                       ((10 - WS-PARALLAX-ERROR-MRAD) * 20).

            COMPUTE WS-IBK-VITALITY = (WS-IBK-COMPOSITE / 4) +
                                      (WS-GAIT-DAMPEN-M / 4) +
                                      ((25 - WS-IMU-NORM-LAT-MS) * 4) + 1.

            IF WS-IBK-VITALITY EQUAL ZERO
                SET KINEMATIC-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-IBK-COHERENCE = (WS-IBK-COMPOSITE / 16) +
                                       (WS-GAIT-DAMPEN-M / 16) +
                                       ((25 - WS-IMU-NORM-LAT-MS) * 2).

            COMPUTE WS-IBK-REBAR-LATCH = 1470169088 +
                                         (WS-IBK-COMPOSITE / 2) +
                                         ((25 - WS-IMU-NORM-LAT-MS) * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-IBK-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-IBK-VITALITY * 10) +
                                         (WS-IBK-COHERENCE * 10) +
                                         (WS-IBK-COMPOSITE * 10) +
                                         (WS-IBK-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-IBK-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-IBK-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
