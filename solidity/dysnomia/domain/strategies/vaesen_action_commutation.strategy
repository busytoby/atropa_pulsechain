       IDENTIFICATION DIVISION.
       PROGRAM-ID. VAESEN-ACTION-STRATEGY.
       AUTHOR. AUNCIENT DYSNOMIA VM / VAESEN ACTION.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-ACTION-PARAMS.
          05 WS-INIT-MOMENTUM-P        PIC 9(05) VALUE 18000.
          05 WS-QUADRANT-1TO4          PIC 9(02) VALUE 01.
          05 WS-COMMUTATION-CYCLES-N   PIC 9(02) VALUE 16.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-CURRENT-MOMENTUM-P     PIC 9(05) VALUE 0.
          05 WS-STEP-IDX               PIC 9(02) VALUE 0.
          05 WS-SHADOW-ACTION-BASE     PIC 9(12) VALUE 0.
          05 WS-CYC-MOD                PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-ACTION-MOMENTUM     VALUE 2.
             88 INVALID-QUADRANT            VALUE 3.
             88 INVALID-COMMUTATION-CYCLES  VALUE 4.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
             88 BEHAVIORAL-DIVERGENCE-FAIL  VALUE 6.
             88 GATING-CLAMP-OVERFLOW       VALUE 7.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 8.
             88 CASCADE-ROLLBACK-FAIL       VALUE 9.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-ACTION-COMMUTATION
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-INIT-MOMENTUM-P > 20000
               SET INVALID-ACTION-MOMENTUM TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-QUADRANT-1TO4 < 1 OR WS-QUADRANT-1TO4 > 4
               SET INVALID-QUADRANT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-COMMUTATION-CYCLES-N < 1 OR WS-COMMUTATION-CYCLES-N > 64
               SET INVALID-COMMUTATION-CYCLES TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-ACTION-COMMUTATION.
           MOVE WS-INIT-MOMENTUM-P TO WS-CURRENT-MOMENTUM-P.

           PERFORM VARYING WS-STEP-IDX FROM 1 BY 1 UNTIL WS-STEP-IDX > WS-COMMUTATION-CYCLES-N
               COMPUTE WS-CURRENT-MOMENTUM-P = (WS-CURRENT-MOMENTUM-P * 875) / 1000
           END-PERFORM.

           IF WS-CURRENT-MOMENTUM-P > WS-INIT-MOMENTUM-P
               SET BEHAVIORAL-DIVERGENCE-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-SHADOW-ACTION-BASE = (WS-CICS-WRITER-ID * 1000000) + 
               (WS-COMMUTATION-CYCLES-N * 10000) + (WS-QUADRANT-1TO4 * 100) + (WS-CURRENT-MOMENTUM-P / 16).

           COMPUTE WS-CYC-MOD = FUNCTION MOD(WS-QUADRANT-1TO4, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-CYC-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-ACTION-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-ACTION-BASE + ((WS-CURRENT-MOMENTUM-P * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-ACTION-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-COMMUTATION-CYCLES-N * 10000) + (WS-QUADRANT-1TO4 * 100) + (WS-CURRENT-MOMENTUM-P / 16))
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-ACTION-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
