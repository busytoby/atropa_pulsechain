       IDENTIFICATION DIVISION.
       PROGRAM-ID. LYAPUNOV-INSTANCE-STRATEGY.
       AUTHOR. AUNCIENT DYSNOMIA VM / INSTANCE STABILITY.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-INSTANCE-PARAMS.
          05 WS-INSTANCE-ADDR-HASH     PIC 9(09) VALUE 123456789.
          05 WS-INIT-REG-DIVERGENCE    PIC 9(05) VALUE 10000.
          05 WS-RECURSION-DEPTH-D      PIC 9(02) VALUE 08.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-CURRENT-DIVERGENCE     PIC 9(05) VALUE 0.
          05 WS-STEP-IDX               PIC 9(02) VALUE 0.
          05 WS-TOTAL-CALL-ENERGY      PIC 9(09) VALUE 0.
          05 WS-ADDR-MOD               PIC 9(03) VALUE 0.
          05 WS-SHADOW-INSTANCE-BASE   PIC 9(12) VALUE 0.
          05 WS-CYC-MOD                PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-INSTANCE-ADDR       VALUE 2.
             88 INVALID-DIVERGENCE          VALUE 3.
             88 INVALID-RECURSION-DEPTH     VALUE 4.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
             88 INSTANCE-DIVERGENCE-FAIL    VALUE 6.
             88 GATING-CLAMP-OVERFLOW       VALUE 7.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 8.
             88 CASCADE-ROLLBACK-FAIL       VALUE 9.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-INSTANCE-CONTRACTION
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-INSTANCE-ADDR-HASH EQUAL ZERO
               SET INVALID-INSTANCE-ADDR TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-INIT-REG-DIVERGENCE > 50000
               SET INVALID-DIVERGENCE TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-RECURSION-DEPTH-D < 1 OR WS-RECURSION-DEPTH-D > 16
               SET INVALID-RECURSION-DEPTH TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-INSTANCE-CONTRACTION.
           MOVE WS-INIT-REG-DIVERGENCE TO WS-CURRENT-DIVERGENCE.

           PERFORM VARYING WS-STEP-IDX FROM 1 BY 1 UNTIL WS-STEP-IDX > WS-RECURSION-DEPTH-D
               COMPUTE WS-CURRENT-DIVERGENCE = (WS-CURRENT-DIVERGENCE * 875) / 1000
           END-PERFORM.

           IF WS-CURRENT-DIVERGENCE > WS-INIT-REG-DIVERGENCE
               SET INSTANCE-DIVERGENCE-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-TOTAL-CALL-ENERGY = WS-CURRENT-DIVERGENCE * WS-RECURSION-DEPTH-D.
           COMPUTE WS-ADDR-MOD = FUNCTION MOD(WS-INSTANCE-ADDR-HASH, 1000).

           COMPUTE WS-SHADOW-INSTANCE-BASE = (WS-CICS-WRITER-ID * 1000000) + 
               (WS-RECURSION-DEPTH-D * 10000) + (WS-ADDR-MOD * 10) + (WS-TOTAL-CALL-ENERGY / 16).

           COMPUTE WS-CYC-MOD = FUNCTION MOD(WS-RECURSION-DEPTH-D, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-CYC-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-INSTANCE-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-INSTANCE-BASE + ((WS-CURRENT-DIVERGENCE * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-INSTANCE-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-RECURSION-DEPTH-D * 10000) + (WS-ADDR-MOD * 10) + (WS-TOTAL-CALL-ENERGY / 16))
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-INSTANCE-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
