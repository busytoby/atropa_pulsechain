        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-MSP-BARREL.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-MSP-BARREL-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1316-MSP-OK            PIC 9(01) VALUE 1.
            05  WS-TH1317-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1318-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1319-1320M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1320-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-MSP-BARREL-WIT           PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-MSP-BARREL.
            GOBACK.
        1000-EVALUATE-MSP-BARREL.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1316-MSP-OK = 1 AND
               WS-TH1317-DATBIN-STRAT-OK = 1 AND
               WS-TH1318-SUBMICRO-LAT-OK = 1 AND
               WS-TH1319-1320M-SAAT-OK = 1 AND
               WS-TH1320-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-MSP-BARREL-WIT
            ELSE
                MOVE 0 TO WS-MSP-BARREL-WIT.
