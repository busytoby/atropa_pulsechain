        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-VSEN-FIREWALL.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-VSEN-FIREWALL-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1771-XDC-INTERCEPT-OK  PIC 9(01) VALUE 1.
            05  WS-TH1772-ACCUM-REDIR-OK    PIC 9(01) VALUE 1.
            05  WS-TH1773-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1774-1775M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1775-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-VSEN-FIREWALL-WIT        PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-VSEN-FIREWALL.
            GOBACK.
        1000-EVALUATE-VSEN-FIREWALL.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1771-XDC-INTERCEPT-OK = 1 AND
               WS-TH1772-ACCUM-REDIR-OK = 1 AND
               WS-TH1773-SUBMICRO-LAT-OK = 1 AND
               WS-TH1774-1775M-SAAT-OK = 1 AND
               WS-TH1775-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-VSEN-FIREWALL-WIT
            ELSE
                MOVE 0 TO WS-VSEN-FIREWALL-WIT.
