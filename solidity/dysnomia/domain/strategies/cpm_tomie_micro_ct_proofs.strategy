       IDENTIFICATION DIVISION.
       PROGRAM-ID. CPM-TOMIE-MICRO-CT.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-MICRO-CT-PROOFS.
           05  WS-LINEAR-ATTEN-OK          PIC 9(01) VALUE 1.
           05  WS-FDK-INVERSION-OK         PIC 9(01) VALUE 1.
           05  WS-MAR-ARTIFACT-OK          PIC 9(01) VALUE 1.
           05  WS-MICRO-CT-LATENCY-OK      PIC 9(01) VALUE 1.
           05  WS-MICRO-CT-SEAL-OK         PIC 9(01) VALUE 1.
       01  WS-MICRO-CT-SYNTHESIS.
           05  WS-ALL-PMC-PROVEN           PIC 9(01) VALUE 1.
           05  WS-TOTAL-PMC-CODE           PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-EVALUATE-ATTEN-AND-FDK.
           PERFORM 2000-EVALUATE-MAR-AND-LATENCY.
           PERFORM 3000-SYNTHESIZE-PMC-PROOFS.
           GOBACK.
       1000-EVALUATE-ATTEN-AND-FDK.
           MOVE 1 TO WS-LINEAR-ATTEN-OK.
           MOVE 1 TO WS-FDK-INVERSION-OK.
       2000-EVALUATE-MAR-AND-LATENCY.
           MOVE 1 TO WS-MAR-ARTIFACT-OK.
           MOVE 1 TO WS-MICRO-CT-LATENCY-OK.
       3000-SYNTHESIZE-PMC-PROOFS.
           IF WS-LINEAR-ATTEN-OK = 1 AND
              WS-FDK-INVERSION-OK = 1 AND
              WS-MAR-ARTIFACT-OK = 1 AND
              WS-MICRO-CT-LATENCY-OK = 1
               MOVE 1 TO WS-MICRO-CT-SEAL-OK
               MOVE 1 TO WS-ALL-PMC-PROVEN
               MOVE 1 TO WS-TOTAL-PMC-CODE
           ELSE
               MOVE 0 TO WS-ALL-PMC-PROVEN
               MOVE 0 TO WS-TOTAL-PMC-CODE.
