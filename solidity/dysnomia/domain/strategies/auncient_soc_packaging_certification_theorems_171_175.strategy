        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-SOC-PACKAGING-171-175.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-SOC-PACK-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH171-IMPEDANCE-OK       PIC 9(01) VALUE 1.
            05  WS-TH172-JITTER-OK          PIC 9(01) VALUE 1.
            05  WS-TH173-THERMAL-EQ-OK      PIC 9(01) VALUE 1.
            05  WS-TH174-ISOLATION-OK       PIC 9(01) VALUE 1.
            05  WS-TH175-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-SOC-PACK-WITNESS         PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-SOC-PACK.
            GOBACK.
        1000-EVALUATE-SOC-PACK.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH171-IMPEDANCE-OK = 1 AND
               WS-TH172-JITTER-OK = 1 AND
               WS-TH173-THERMAL-EQ-OK = 1 AND
               WS-TH174-ISOLATION-OK = 1 AND
               WS-TH175-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-SOC-PACK-WITNESS
            ELSE
                MOVE 0 TO WS-SOC-PACK-WITNESS.
