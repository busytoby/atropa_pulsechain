        IDENTIFICATION DIVISION.
        PROGRAM-ID. PST-QCF-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / POST THINKING QUALITY CONTROL AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-QCF-PARAMS.
           05 WS-GENERIC-LEAKAGE-T-PCT  PIC 9(02) VALUE 12.
           05 WS-CROSS-LING-BLEED-H-PCT PIC 9(02) VALUE 36.
           05 WS-REFL-TOKEN-LENGTH      PIC 9(03) VALUE 081.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-QCF-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-QCF-VITALITY           PIC 9(09) VALUE 0.
           05 WS-QCF-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-QCF-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-QCF-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 GENERIC-LEAKAGE-EXCEEDED    VALUE 2.
              88 CROSS-LING-BLEED-EXCEEDED   VALUE 3.
              88 TOKEN-LENGTH-OUT-OF-BOUNDS  VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 QC-COLLAPSE                 VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-QUALITY-CONTROL
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-GENERIC-LEAKAGE-T-PCT < 1 OR WS-GENERIC-LEAKAGE-T-PCT > 20
                SET GENERIC-LEAKAGE-EXCEEDED TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CROSS-LING-BLEED-H-PCT < 1 OR WS-CROSS-LING-BLEED-H-PCT > 50
                SET CROSS-LING-BLEED-EXCEEDED TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-REFL-TOKEN-LENGTH < 50 OR WS-REFL-TOKEN-LENGTH > 120
                SET TOKEN-LENGTH-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-QUALITY-CONTROL.
            COMPUTE WS-QCF-COMPOSITE = ((25 - WS-GENERIC-LEAKAGE-T-PCT) * 20) +
                                       ((60 - WS-CROSS-LING-BLEED-H-PCT) * 10) +
                                       (WS-REFL-TOKEN-LENGTH * 5).

            COMPUTE WS-QCF-VITALITY = (WS-QCF-COMPOSITE / 4) +
                                      ((25 - WS-GENERIC-LEAKAGE-T-PCT) * 4) +
                                      (WS-REFL-TOKEN-LENGTH * 2) + 1.

            IF WS-QCF-VITALITY EQUAL ZERO
                SET QC-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-QCF-COHERENCE = (WS-QCF-COMPOSITE / 16) +
                                       (WS-REFL-TOKEN-LENGTH / 4) +
                                       ((25 - WS-GENERIC-LEAKAGE-T-PCT) * 2).

            COMPUTE WS-QCF-REBAR-LATCH = 1470169088 +
                                         (WS-QCF-COMPOSITE / 2) +
                                         (WS-REFL-TOKEN-LENGTH * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-QCF-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-QCF-VITALITY * 10) +
                                         (WS-QCF-COHERENCE * 10) +
                                         (WS-QCF-COMPOSITE * 10) +
                                         (WS-QCF-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-QCF-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-QCF-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
