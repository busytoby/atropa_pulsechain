        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-18ZK-CIRCUIT.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-18ZK-CIRCUIT-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1496-CIRCUIT-OK        PIC 9(01) VALUE 1.
            05  WS-TH1497-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1498-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1499-1500M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1500-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-18ZK-CIRCUIT-WIT         PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-18ZK-CIRCUIT.
            GOBACK.
        1000-EVALUATE-18ZK-CIRCUIT.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1496-CIRCUIT-OK = 1 AND
               WS-TH1497-DATBIN-STRAT-OK = 1 AND
               WS-TH1498-SUBMICRO-LAT-OK = 1 AND
               WS-TH1499-1500M-SAAT-OK = 1 AND
               WS-TH1500-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-18ZK-CIRCUIT-WIT
            ELSE
                MOVE 0 TO WS-18ZK-CIRCUIT-WIT.
