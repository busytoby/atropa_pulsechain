        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-CPMTOMIE-ANKH-CLEAN.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-CPMTOMIE-CLEAN-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH521-SANITIZATION-OK    PIC 9(01) VALUE 1.
            05  WS-TH522-ZERO-SHOT-OK       PIC 9(01) VALUE 1.
            05  WS-TH523-TPA-BANDWIDTH-OK   PIC 9(01) VALUE 1.
            05  WS-TH524-CLEAN-SAAT-OK      PIC 9(01) VALUE 1.
            05  WS-TH525-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-CPMTOMIE-CLEAN-WIT  PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-CLEANROOM.
            GOBACK.
        1000-EVALUATE-CLEANROOM.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH521-SANITIZATION-OK = 1 AND
               WS-TH522-ZERO-SHOT-OK = 1 AND
               WS-TH523-TPA-BANDWIDTH-OK = 1 AND
               WS-TH524-CLEAN-SAAT-OK = 1 AND
               WS-TH525-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-CPMTOMIE-CLEAN-WIT
            ELSE
                MOVE 0 TO WS-FPGA-CPMTOMIE-CLEAN-WIT.
