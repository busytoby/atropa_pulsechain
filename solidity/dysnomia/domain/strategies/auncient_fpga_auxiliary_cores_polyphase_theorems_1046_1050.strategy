        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-AUX-POLY.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-AUX-POLY-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1046-POLY-CORES-OK     PIC 9(01) VALUE 1.
            05  WS-TH1047-DATBIN-POLY-OK    PIC 9(01) VALUE 1.
            05  WS-TH1048-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1049-1050M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1050-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-AUX-POLY-WIT             PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-AUX-POLY.
            GOBACK.
        1000-EVALUATE-AUX-POLY.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1046-POLY-CORES-OK = 1 AND
               WS-TH1047-DATBIN-POLY-OK = 1 AND
               WS-TH1048-SUBMICRO-LAT-OK = 1 AND
               WS-TH1049-1050M-SAAT-OK = 1 AND
               WS-TH1050-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-AUX-POLY-WIT
            ELSE
                MOVE 0 TO WS-AUX-POLY-WIT.
