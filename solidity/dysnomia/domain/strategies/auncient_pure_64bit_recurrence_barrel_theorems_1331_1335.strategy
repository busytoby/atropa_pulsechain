        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-P64-BARREL.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-P64-BARREL-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1331-P64-OK            PIC 9(01) VALUE 1.
            05  WS-TH1332-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1333-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1334-1335M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1335-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-P64-BARREL-WIT           PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-P64-BARREL.
            GOBACK.
        1000-EVALUATE-P64-BARREL.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1331-P64-OK = 1 AND
               WS-TH1332-DATBIN-STRAT-OK = 1 AND
               WS-TH1333-SUBMICRO-LAT-OK = 1 AND
               WS-TH1334-1335M-SAAT-OK = 1 AND
               WS-TH1335-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-P64-BARREL-WIT
            ELSE
                MOVE 0 TO WS-P64-BARREL-WIT.
