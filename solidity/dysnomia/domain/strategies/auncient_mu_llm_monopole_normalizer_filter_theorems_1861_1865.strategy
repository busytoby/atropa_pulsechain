        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-MU-NORM-FILTER.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FILTER-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1861-FILTER-OK         PIC 9(01) VALUE 1.
            05  WS-TH1862-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1863-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1864-1865M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1865-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-FILTER-WIT               PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-FILTER.
            GOBACK.
        1000-EVALUATE-FILTER.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1861-FILTER-OK = 1 AND
               WS-TH1862-DATBIN-STRAT-OK = 1 AND
               WS-TH1863-SUBMICRO-LAT-OK = 1 AND
               WS-TH1864-1865M-SAAT-OK = 1 AND
               WS-TH1865-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-FILTER-WIT
            ELSE
                MOVE 0 TO WS-FILTER-WIT.
