IDENTIFICATION DIVISION.
PROGRAM-ID. PROG-FET-VERLET-CACTUS.

DATA DIVISION.
01 D0-SUBSTRATE-TRUNK.
   05 D0-MOTZKIN-PRIME    PIC 9(9) USAGE R0.
   05 D0-DELTA-T-SQ       PIC 9(9) USAGE R1.
   05 D0-LN2-OVER-LNE     PIC 9(9) USAGE R2.
   05 D0-K-EXPONENT       PIC 9(9) USAGE R3.
01 D2-CHANNEL-NODE.
   05 D2-PREV-NONCE       PIC 9(9) USAGE R4.
   05 D2-CURR-NONCE       PIC 9(9) USAGE R5.
   05 D2-PREV-CHARGE      PIC 9(9) USAGE R6.
   05 D2-CURR-CHARGE      PIC 9(9) USAGE R7.
   05 D2-RESTORE-FORCE    PIC 9(9) USAGE R8.
01 D3-LEAF-EVAL.
   05 D3-NEXT-NONCE       PIC 9(9) USAGE R9.
   05 D3-NEXT-CHARGE      PIC 9(9) USAGE R10.
   05 D3-RECOVERED-CHARGE PIC 9(9) USAGE R11.
   05 D3-PROOF-RULING     PIC 9(9) USAGE R12.

PROCEDURE DIVISION.
    MOVE 953467954 TO D0-MOTZKIN-PRIME.
    MOVE 10 TO D0-DELTA-T-SQ.
    MOVE 693 TO D0-LN2-OVER-LNE.
    MOVE 5 TO D0-K-EXPONENT.
    MOVE 100000 TO D2-PREV-NONCE.
    MOVE 100001 TO D2-CURR-NONCE.
    MOVE 1000 TO D2-PREV-CHARGE.
    MOVE 950 TO D2-CURR-CHARGE.
    MOVE 5 TO D2-RESTORE-FORCE.
    PERFORM VERIFY-NONCE-ORDER.
    PERFORM VERLET-STEP-INTEGRATION.
    PERFORM VERIFY-TIME-REVERSAL.
    IF D3-PROOF-RULING == 0
        SET depth 4
    ELSE
        SET depth 1
    END-IF.
    EVAL.
    GO TO END-STRATEGY.

VERIFY-NONCE-ORDER.
    COMPUTE D3-NEXT-NONCE = D2-CURR-NONCE + 1.
    IF D3-NEXT-NONCE > D2-CURR-NONCE
        MOVE 0 TO D3-PROOF-RULING
    ELSE
        MOVE 3 TO D3-PROOF-RULING
    END-IF.
    EXIT.

VERLET-STEP-INTEGRATION.
    COMPUTE D3-NEXT-CHARGE = ((D0-LN2-OVER-LNE * D2-CURR-CHARGE) / 1000) + ((31 * D2-PREV-CHARGE) / 32) - (D2-RESTORE-FORCE * D0-DELTA-T-SQ).
    EXIT.

VERIFY-TIME-REVERSAL.
    COMPUTE D3-RECOVERED-CHARGE = ((D3-NEXT-CHARGE - ((D0-LN2-OVER-LNE * D2-CURR-CHARGE) / 1000) + (D2-RESTORE-FORCE * D0-DELTA-T-SQ)) * 32) / 31.
    IF D3-RECOVERED-CHARGE == D2-PREV-CHARGE
        MOVE 0 TO D3-PROOF-RULING
    ELSE
        MOVE 4 TO D3-PROOF-RULING
    END-IF.
    EXIT.

END-STRATEGY.
