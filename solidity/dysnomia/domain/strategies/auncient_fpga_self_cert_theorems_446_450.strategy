        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-SELF-CERT.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-SELF-CERT-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH446-SELF-CONFIG-OK     PIC 9(01) VALUE 1.
            05  WS-TH447-CDC-SLACK-OK       PIC 9(01) VALUE 1.
            05  WS-TH448-SCSI-LOOPBACK-OK   PIC 9(01) VALUE 1.
            05  WS-TH449-SELF-SAAT-OK       PIC 9(01) VALUE 1.
            05  WS-TH450-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-SELF-CERT-WIT       PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-SELF-CERT.
            GOBACK.
        1000-EVALUATE-SELF-CERT.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH446-SELF-CONFIG-OK = 1 AND
               WS-TH447-CDC-SLACK-OK = 1 AND
               WS-TH448-SCSI-LOOPBACK-OK = 1 AND
               WS-TH449-SELF-SAAT-OK = 1 AND
               WS-TH450-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-SELF-CERT-WIT
            ELSE
                MOVE 0 TO WS-FPGA-SELF-CERT-WIT.
