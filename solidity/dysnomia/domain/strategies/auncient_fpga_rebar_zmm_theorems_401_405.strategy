        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-REBAR.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-REBAR-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH401-REBAR-APERTURE-OK  PIC 9(01) VALUE 1.
            05  WS-TH402-EPHEMERAL-STACK-OK PIC 9(01) VALUE 1.
            05  WS-TH403-DYNAMIC-ABI-OK     PIC 9(01) VALUE 1.
            05  WS-TH404-REBAR-SAAT-OK      PIC 9(01) VALUE 1.
            05  WS-TH405-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-REBAR-WIT           PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-REBAR.
            GOBACK.
        1000-EVALUATE-REBAR.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH401-REBAR-APERTURE-OK = 1 AND
               WS-TH402-EPHEMERAL-STACK-OK = 1 AND
               WS-TH403-DYNAMIC-ABI-OK = 1 AND
               WS-TH404-REBAR-SAAT-OK = 1 AND
               WS-TH405-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-REBAR-WIT
            ELSE
                MOVE 0 TO WS-FPGA-REBAR-WIT.
