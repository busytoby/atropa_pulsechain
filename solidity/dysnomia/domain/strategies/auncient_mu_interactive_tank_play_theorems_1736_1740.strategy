        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-TANK-PLAY.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-TANK-PLAY-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1736-TANK-PLAY-OK      PIC 9(01) VALUE 1.
            05  WS-TH1737-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1738-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1739-1740M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1740-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-TANK-PLAY-WIT            PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-TANK-PLAY.
            GOBACK.
        1000-EVALUATE-TANK-PLAY.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1736-TANK-PLAY-OK = 1 AND
               WS-TH1737-DATBIN-STRAT-OK = 1 AND
               WS-TH1738-SUBMICRO-LAT-OK = 1 AND
               WS-TH1739-1740M-SAAT-OK = 1 AND
               WS-TH1740-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-TANK-PLAY-WIT
            ELSE
                MOVE 0 TO WS-TANK-PLAY-WIT.
