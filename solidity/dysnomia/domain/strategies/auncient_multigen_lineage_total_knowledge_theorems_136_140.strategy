        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-MULTIGEN-TK-136-140.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-MULTIGEN-TK-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH136-INHERITANCE-OK     PIC 9(01) VALUE 1.
            05  WS-TH137-INOCULATION-OK     PIC 9(01) VALUE 1.
            05  WS-TH138-TRUST-ENDOW-OK     PIC 9(01) VALUE 1.
            05  WS-TH139-CACHE-SYNC-OK      PIC 9(01) VALUE 1.
            05  WS-TH140-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-MULTIGEN-TK-WITNESS      PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-MULTIGEN-TK.
            GOBACK.
        1000-EVALUATE-MULTIGEN-TK.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH136-INHERITANCE-OK = 1 AND
               WS-TH137-INOCULATION-OK = 1 AND
               WS-TH138-TRUST-ENDOW-OK = 1 AND
               WS-TH139-CACHE-SYNC-OK = 1 AND
               WS-TH140-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-MULTIGEN-TK-WITNESS
            ELSE
                MOVE 0 TO WS-MULTIGEN-TK-WITNESS.
