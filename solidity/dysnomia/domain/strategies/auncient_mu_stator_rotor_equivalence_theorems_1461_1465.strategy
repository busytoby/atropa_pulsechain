        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-EQUIVALENCE.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-EQUIV-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1461-EQUIV-OK          PIC 9(01) VALUE 1.
            05  WS-TH1462-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1463-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1464-1465M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1465-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-EQUIV-WIT                PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-EQUIV.
            GOBACK.
        1000-EVALUATE-EQUIV.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1461-EQUIV-OK = 1 AND
               WS-TH1462-DATBIN-STRAT-OK = 1 AND
               WS-TH1463-SUBMICRO-LAT-OK = 1 AND
               WS-TH1464-1465M-SAAT-OK = 1 AND
               WS-TH1465-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-EQUIV-WIT
            ELSE
                MOVE 0 TO WS-EQUIV-WIT.
