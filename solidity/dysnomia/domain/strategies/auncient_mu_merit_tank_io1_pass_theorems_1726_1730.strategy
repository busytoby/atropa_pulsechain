        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-MERIT-PASS.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-MERIT-PASS-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1726-MERIT-PASS-OK     PIC 9(01) VALUE 1.
            05  WS-TH1727-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1728-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1729-1730M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1730-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-MERIT-PASS-WIT           PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-MERIT-PASS.
            GOBACK.
        1000-EVALUATE-MERIT-PASS.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1726-MERIT-PASS-OK = 1 AND
               WS-TH1727-DATBIN-STRAT-OK = 1 AND
               WS-TH1728-SUBMICRO-LAT-OK = 1 AND
               WS-TH1729-1730M-SAAT-OK = 1 AND
               WS-TH1730-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-MERIT-PASS-WIT
            ELSE
                MOVE 0 TO WS-MERIT-PASS-WIT.
