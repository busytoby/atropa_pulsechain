        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-MOE.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-MOE-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1086-MOE-OK            PIC 9(01) VALUE 1.
            05  WS-TH1087-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1088-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1089-1090M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1090-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-FPGA-MOE-WIT             PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-FPGA-MOE.
            GOBACK.
        1000-EVALUATE-FPGA-MOE.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1086-MOE-OK = 1 AND
               WS-TH1087-DATBIN-STRAT-OK = 1 AND
               WS-TH1088-SUBMICRO-LAT-OK = 1 AND
               WS-TH1089-1090M-SAAT-OK = 1 AND
               WS-TH1090-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-FPGA-MOE-WIT
            ELSE
                MOVE 0 TO WS-FPGA-MOE-WIT.
