        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-BEYOND-655.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-BEYOND-655-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH656-STATOR-ROTOR-OK    PIC 9(01) VALUE 1.
            05  WS-TH657-DISPL-CALIB-OK     PIC 9(01) VALUE 1.
            05  WS-TH658-COORD-LAT-OK       PIC 9(01) VALUE 1.
            05  WS-TH659-660M-SAAT-OK       PIC 9(01) VALUE 1.
            05  WS-TH660-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-BEYOND-655-WIT      PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-BEYOND-655.
            GOBACK.
        1000-EVALUATE-BEYOND-655.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH656-STATOR-ROTOR-OK = 1 AND
               WS-TH657-DISPL-CALIB-OK = 1 AND
               WS-TH658-COORD-LAT-OK = 1 AND
               WS-TH659-660M-SAAT-OK = 1 AND
               WS-TH660-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-BEYOND-650-WIT
            ELSE
                MOVE 0 TO WS-FPGA-BEYOND-650-WIT.
