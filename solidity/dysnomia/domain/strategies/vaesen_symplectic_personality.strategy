       IDENTIFICATION DIVISION.
       PROGRAM-ID. VAESEN-SYMPLECTIC-STRATEGY.
       AUTHOR. AUNCIENT DYSNOMIA VM / VAESEN ENGINE.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-VAESEN-PARAMS.
          05 WS-DEMEANOR-Q1            PIC 9(05) VALUE 05000.
          05 WS-TEMPERAMENT-Q2         PIC 9(05) VALUE 01000.
          05 WS-AFFECT-P1              PIC 9(05) VALUE 03000.
          05 WS-ARCHETYPE-ID           PIC 9(02) VALUE 01.
          05 WS-EVOLUTION-STEPS-N      PIC 9(02) VALUE 16.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-Q-CURRENT              PIC S9(09) VALUE 0.
          05 WS-P-CURRENT              PIC S9(09) VALUE 0.
          05 WS-STEP-IDX               PIC 9(02) VALUE 0.
          05 WS-FINAL-ENERGY           PIC 9(12) VALUE 0.
          05 WS-SHADOW-VAESEN-BASE     PIC 9(12) VALUE 0.
          05 WS-CYC-MOD                PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-COORDINATES         VALUE 2.
             88 INVALID-ARCHETYPE-ID        VALUE 3.
             88 INVALID-EVOLUTION-STEPS     VALUE 4.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
             88 ENERGY-DRIFT-FAIL           VALUE 6.
             88 GATING-CLAMP-OVERFLOW       VALUE 7.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 8.
             88 CASCADE-ROLLBACK-FAIL       VALUE 9.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-SYMPLECTIC-LEAPFROG
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-DEMEANOR-Q1 > 20000 OR WS-TEMPERAMENT-Q2 > 20000 OR WS-AFFECT-P1 > 20000
               SET INVALID-COORDINATES TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-ARCHETYPE-ID < 1 OR WS-ARCHETYPE-ID > 8
               SET INVALID-ARCHETYPE-ID TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-EVOLUTION-STEPS-N < 1 OR WS-EVOLUTION-STEPS-N > 64
               SET INVALID-EVOLUTION-STEPS TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-SYMPLECTIC-LEAPFROG.
           MOVE WS-DEMEANOR-Q1 TO WS-Q-CURRENT.
           MOVE WS-AFFECT-P1 TO WS-P-CURRENT.

           PERFORM VARYING WS-STEP-IDX FROM 1 BY 1 UNTIL WS-STEP-IDX > WS-EVOLUTION-STEPS-N
               COMPUTE WS-P-CURRENT = WS-P-CURRENT - (((WS-TEMPERAMENT-Q2 / 100) * WS-Q-CURRENT) / 100)
               COMPUTE WS-Q-CURRENT = WS-Q-CURRENT + (WS-P-CURRENT / 100)
               COMPUTE WS-P-CURRENT = WS-P-CURRENT - (((WS-TEMPERAMENT-Q2 / 100) * WS-Q-CURRENT) / 100)
           END-PERFORM.

           COMPUTE WS-FINAL-ENERGY = ((WS-P-CURRENT * WS-P-CURRENT) / 2) + ((WS-Q-CURRENT * WS-Q-CURRENT) / 2).

           COMPUTE WS-SHADOW-VAESEN-BASE = (WS-CICS-WRITER-ID * 1000000) + 
               (WS-ARCHETYPE-ID * 10000) + (WS-EVOLUTION-STEPS-N * 100) + (WS-FINAL-ENERGY / 65536).

           COMPUTE WS-CYC-MOD = FUNCTION MOD(WS-ARCHETYPE-ID, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-CYC-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-VAESEN-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-VAESEN-BASE + ((WS-Q-CURRENT * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-VAESEN-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-ARCHETYPE-ID * 10000) + (WS-EVOLUTION-STEPS-N * 100) + (WS-FINAL-ENERGY / 65536))
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-VAESEN-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
