        IDENTIFICATION DIVISION.
        PROGRAM-ID. QSG-GAT-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / QUERY SCOPE GATING AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-QSG-PARAMS.
           05 WS-QUERY-SCOPE-TYPE       PIC 9(01) VALUE 1.
              88 SCOPE-ONE              VALUE 1.
              88 SCOPE-MANY             VALUE 2.
              88 SCOPE-ALL              VALUE 3.
              88 SCOPE-NONE             VALUE 4.
           05 WS-CLASS-LAT-MS           PIC 9(02) VALUE 20.
           05 WS-DISAMBIG-FID-M         PIC 9(04) VALUE 0960.
           05 WS-TRIGGERED-STEPS        PIC 9(02) VALUE 01.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-QSG-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-QSG-VITALITY           PIC 9(09) VALUE 0.
           05 WS-QSG-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-QSG-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-QSG-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 UNKNOWN-QUERY-SCOPE         VALUE 2.
              88 CLASS-LAT-OUT-OF-BOUNDS     VALUE 3.
              88 DISAMBIG-FID-LOW            VALUE 4.
              88 UNWANTED-ANIM-TRIGGERED     VALUE 5.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 6.
              88 GATING-COLLAPSE             VALUE 7.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 8.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-SCOPE-GATING
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-QUERY-SCOPE-TYPE < 1 OR WS-QUERY-SCOPE-TYPE > 4
                SET UNKNOWN-QUERY-SCOPE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CLASS-LAT-MS < 10 OR WS-CLASS-LAT-MS > 50
                SET CLASS-LAT-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-DISAMBIG-FID-M < 850 OR WS-DISAMBIG-FID-M > 1000
                SET DISAMBIG-FID-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-QUERY-SCOPE-TYPE EQUAL 4 AND WS-TRIGGERED-STEPS NOT EQUAL 0
                SET UNWANTED-ANIM-TRIGGERED TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-QUERY-SCOPE-TYPE NOT EQUAL 4 AND WS-TRIGGERED-STEPS < 1
                SET UNWANTED-ANIM-TRIGGERED TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-SCOPE-GATING.
            COMPUTE WS-QSG-COMPOSITE = (WS-QUERY-SCOPE-TYPE * 100) +
                                       ((60 - WS-CLASS-LAT-MS) * 10) +
                                       (WS-DISAMBIG-FID-M / 2) +
                                       (WS-TRIGGERED-STEPS * 20).

            COMPUTE WS-QSG-VITALITY = (WS-QSG-COMPOSITE / 4) +
                                      (WS-DISAMBIG-FID-M / 4) +
                                      ((60 - WS-CLASS-LAT-MS) * 4) +
                                      (WS-QUERY-SCOPE-TYPE * 25) + 1.

            IF WS-QSG-VITALITY EQUAL ZERO
                SET GATING-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-QSG-COHERENCE = (WS-QSG-COMPOSITE / 16) +
                                       (WS-DISAMBIG-FID-M / 16) +
                                       ((60 - WS-CLASS-LAT-MS) * 2) +
                                       (WS-QUERY-SCOPE-TYPE * 10).

            COMPUTE WS-QSG-REBAR-LATCH = 1470169088 +
                                         (WS-QSG-COMPOSITE / 2) +
                                         ((60 - WS-CLASS-LAT-MS) * 128) +
                                         (WS-QUERY-SCOPE-TYPE * 512).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-QSG-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-QSG-VITALITY * 10) +
                                         (WS-QSG-COHERENCE * 10) +
                                         (WS-QSG-COMPOSITE * 10) +
                                         (WS-QSG-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-QSG-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-QSG-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
