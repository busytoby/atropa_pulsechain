        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-USDA-GAS-ECONOMICS-THEOREMS-51-55.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-GAS-ECONOMICS-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH51-COV-SUPPRESS-OK     PIC 9(01) VALUE 1.
            05  WS-TH52-EPOCH-BATCH-OK      PIC 9(01) VALUE 1.
            05  WS-TH53-THERMAL-REBATE-OK   PIC 9(01) VALUE 1.
            05  WS-TH54-HIBERNATION-OK      PIC 9(01) VALUE 1.
            05  WS-TH55-ACID-ROLLBACK-OK    PIC 9(01) VALUE 1.
            05  WS-GAS-PROOF-WITNESS        PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-GAS-ECONOMICS.
            GOBACK.
        1000-EVALUATE-GAS-ECONOMICS.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH51-COV-SUPPRESS-OK = 1 AND
               WS-TH52-EPOCH-BATCH-OK = 1 AND
               WS-TH53-THERMAL-REBATE-OK = 1 AND
               WS-TH54-HIBERNATION-OK = 1 AND
               WS-TH55-ACID-ROLLBACK-OK = 1
                MOVE 1 TO WS-GAS-PROOF-WITNESS
            ELSE
                MOVE 0 TO WS-GAS-PROOF-WITNESS.
