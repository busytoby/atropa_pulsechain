IDENTIFICATION DIVISION.
PROGRAM-ID. PROG-80PROVER-DECOUPLING.

DATA DIVISION.
01 D0-SUBSTRATE-TRUNK.
   05 D0-MOTZKIN-PRIME          PIC 9(9) USAGE R0.
   05 D0-K-EXPONENT             PIC 9(9) USAGE R1.
   05 D0-C-PROVER-EXACT-COUNT   PIC 9(9) USAGE R2.
01 D1-DOMAIN-METRICS.
   05 D1-ALGOL-EXISTING-COUNT   PIC 9(9) USAGE R3.
   05 D1-C-BEFORE-BYTES         PIC 9(9) USAGE R4.
   05 D1-C-TARGET-BYTES         PIC 9(9) USAGE R5.
01 D2-GATING-DETENT.
   05 D2-G-SWIGLU-GATE          PIC 9(9) USAGE R6.
   05 D2-SHADOW-COUNT           PIC 9(9) USAGE R7.
   05 D2-COMMITTED-STATE        PIC 9(9) USAGE R8.
01 D3-LEAF-EVAL.
   05 D3-DECOUPLING-RULING      PIC 9(9) USAGE R9.
   05 D3-DISP-WRAP-MOD          PIC 9(9) USAGE R10.

PROCEDURE DIVISION.
    MOVE 953467954 TO D0-MOTZKIN-PRIME.
    MOVE 3 TO D0-K-EXPONENT.
    MOVE 80 TO D0-C-PROVER-EXACT-COUNT.
    MOVE 236 TO D1-ALGOL-EXISTING-COUNT.
    MOVE 67972 TO D1-C-BEFORE-BYTES.
    MOVE 18500 TO D1-C-TARGET-BYTES.

    PERFORM STAGE-80PROVER-VALIDATION.
    PERFORM EVALUATE-BIJECTIVE-COMMIT.
    PERFORM SYNC-DISPLACEMENT-MOD.

    IF D2-SHADOW-COUNT == D0-C-PROVER-EXACT-COUNT AND D1-ALGOL-EXISTING-COUNT >= 80
        MOVE 0 TO D3-DECOUPLING-RULING
        SET depth 4
    ELSE
        MOVE 2 TO D3-DECOUPLING-RULING
        SET depth 1
    END-IF.

    EVAL.
    GO TO END-STRATEGY.

STAGE-80PROVER-VALIDATION.
    MOVE D0-C-PROVER-EXACT-COUNT TO D2-SHADOW-COUNT.
    COMPUTE D2-G-SWIGLU-GATE = 875 + ((125 * D0-C-PROVER-EXACT-COUNT) / 80).
    EXIT.

EVALUATE-BIJECTIVE-COMMIT.
    COMPUTE D2-COMMITTED-STATE = (((D1-C-TARGET-BYTES * 1000) + (D0-C-PROVER-EXACT-COUNT * 100)) * D2-G-SWIGLU-GATE) / 1000.
    EXIT.

SYNC-DISPLACEMENT-MOD.
    COMPUTE D3-DISP-WRAP-MOD = D2-COMMITTED-STATE - ((D2-COMMITTED-STATE / 256) * 256).
    EXIT.

END-STRATEGY.
