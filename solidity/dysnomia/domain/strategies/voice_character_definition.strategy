        IDENTIFICATION DIVISION.
        PROGRAM-ID. VOICE-CHARACTER-DEFINITION-STRATEGY.
        AUTHOR. AUNCIENT DYSNOMIA VM / VOICE CHARACTER AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-CHARACTER-PARAMS.
           05 WS-ARCHETYPE-ID           PIC 9(02) VALUE 01.
           05 WS-PITCH-F0-HZ            PIC 9(04) VALUE 0110.
           05 WS-FORMANT-F1-HZ          PIC 9(04) VALUE 0450.
           05 WS-PRESSURE-Q16           PIC 9(06) VALUE 032768.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-PERSONA-VITALITY       PIC 9(09) VALUE 0.
           05 WS-TRACT-GEOMETRY         PIC 9(09) VALUE 0.
           05 WS-VOICE-REBAR-LATCH      PIC 9(12) VALUE 0.
           05 WS-SHADOW-VOICE-BASE      PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 INVALID-ARCHETYPE-ID        VALUE 2.
              88 INVALID-PITCH-F0            VALUE 3.
              88 INVALID-FORMANT-F1          VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 INVALID-PRESSURE-Q16        VALUE 6.
              88 CHARACTER-DIVERG-FAIL       VALUE 7.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 8.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-VOICE-CHARACTER
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-ARCHETYPE-ID < 1 OR WS-ARCHETYPE-ID > 8
                SET INVALID-ARCHETYPE-ID TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-PITCH-F0-HZ < 20 OR WS-PITCH-F0-HZ > 4000
                SET INVALID-PITCH-F0 TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-FORMANT-F1-HZ < 150 OR WS-FORMANT-F1-HZ > 4000
                SET INVALID-FORMANT-F1 TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-PRESSURE-Q16 < 1000 OR WS-PRESSURE-Q16 > 65536
                SET INVALID-PRESSURE-Q16 TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-VOICE-CHARACTER.
            COMPUTE WS-PERSONA-VITALITY = (WS-ARCHETYPE-ID * 1024) +
                                          (WS-PITCH-F0-HZ * 16) +
                                          (WS-FORMANT-F1-HZ / 4) + 1.

            IF WS-PERSONA-VITALITY EQUAL ZERO
                SET CHARACTER-DIVERG-FAIL TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-TRACT-GEOMETRY = ((WS-PRESSURE-Q16 * 875) / 10000) +
                                        (WS-FORMANT-F1-HZ / 2).

            COMPUTE WS-VOICE-REBAR-LATCH = 1470169088 + (WS-ARCHETYPE-ID * 256) +
                                           (WS-PITCH-F0-HZ * 64) +
                                           (WS-FORMANT-F1-HZ * 2).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-VOICE-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                           (WS-PERSONA-VITALITY * 10) +
                                           (WS-TRACT-GEOMETRY * 10) +
                                           (WS-ARCHETYPE-ID * 1000) +
                                           (WS-VOICE-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-VOICE-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-VOICE-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
