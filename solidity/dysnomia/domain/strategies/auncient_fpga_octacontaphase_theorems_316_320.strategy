        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-OCTACONTA.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-OCTACONTA-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH316-48PHASE-OK         PIC 9(01) VALUE 1.
            05  WS-TH317-FLUX-COHERENCE-OK  PIC 9(01) VALUE 1.
            05  WS-TH318-MAG-LEV-OK         PIC 9(01) VALUE 1.
            05  WS-TH319-LOSSLESS-SAAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH320-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-OCTACONTA-WIT       PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-OCTACONTA.
            GOBACK.
        1000-EVALUATE-OCTACONTA.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH316-48PHASE-OK = 1 AND
               WS-TH317-FLUX-COHERENCE-OK = 1 AND
               WS-TH318-MAG-LEV-OK = 1 AND
               WS-TH319-LOSSLESS-SAAT-OK = 1 AND
               WS-TH320-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-OCTACONTA-WIT
            ELSE
                MOVE 0 TO WS-FPGA-OCTACONTA-WIT.
