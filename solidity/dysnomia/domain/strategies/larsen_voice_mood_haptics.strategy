        IDENTIFICATION DIVISION.
        PROGRAM-ID. LARSEN-VOICE-MOOD-HAPTICS-STRATEGY.
        AUTHOR. AUNCIENT DYSNOMIA VM / LARSEN VOICE AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-VOICE-PARAMETERS.
           05 WS-FORMANT-F1-HZ          PIC 9(04) VALUE 0800.
           05 WS-MOOD-STATE-ID          PIC 9(01) VALUE 2.
           05 WS-HAPTIC-FORCE-Q16       PIC 9(06) VALUE 032768.
           05 WS-PERSONA-ID             PIC 9(02) VALUE 04.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-DAMPED-MOOD-ENERGY     PIC 9(06) VALUE 0.
           05 WS-FORMANT-VOICE-ENERGY   PIC 9(09) VALUE 0.
           05 WS-PERSONA-REBAR-LATCH    PIC 9(12) VALUE 0.
           05 WS-SHADOW-VOICE-BASE      PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 INVALID-FORMANT-F1          VALUE 2.
              88 INVALID-MOOD-STATE          VALUE 3.
              88 INVALID-HAPTIC-FORCE        VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 INVALID-PERSONA-ID          VALUE 6.
              88 FORMANT-UNDERFLOW-FAIL      VALUE 7.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 8.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-LARSEN-VOICE
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-FORMANT-F1-HZ < 100 OR WS-FORMANT-F1-HZ > 4000
                SET INVALID-FORMANT-F1 TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-MOOD-STATE-ID < 1 OR WS-MOOD-STATE-ID > 4
                SET INVALID-MOOD-STATE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-HAPTIC-FORCE-Q16 > 65536
                SET INVALID-HAPTIC-FORCE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-PERSONA-ID < 1 OR WS-PERSONA-ID > 8
                SET INVALID-PERSONA-ID TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-LARSEN-VOICE.
            COMPUTE WS-DAMPED-MOOD-ENERGY = (WS-MOOD-STATE-ID * 2048) -
                                            ((WS-MOOD-STATE-ID * WS-MOOD-STATE-ID * 128) / 4).
            COMPUTE WS-FORMANT-VOICE-ENERGY = (WS-FORMANT-F1-HZ * 10) + (WS-MOOD-STATE-ID * 512) + 1.

            IF WS-FORMANT-VOICE-ENERGY EQUAL ZERO
                SET FORMANT-UNDERFLOW-FAIL TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-PERSONA-REBAR-LATCH = 1470169088 + (WS-PERSONA-ID * 256) +
                                             (WS-MOOD-STATE-ID * 16) +
                                             (WS-FORMANT-F1-HZ / 100).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-VOICE-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                           (WS-FORMANT-VOICE-ENERGY * 10) +
                                           (WS-DAMPED-MOOD-ENERGY * 2) +
                                           (WS-HAPTIC-FORCE-Q16 / 10) +
                                           (WS-PERSONA-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-VOICE-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-VOICE-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
