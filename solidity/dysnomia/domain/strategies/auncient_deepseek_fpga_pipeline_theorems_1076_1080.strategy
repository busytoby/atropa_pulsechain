        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-PIPE.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-PIPE-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1076-PIPE-OK           PIC 9(01) VALUE 1.
            05  WS-TH1077-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1078-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1079-1080M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1080-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-FPGA-PIPE-WIT            PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-FPGA-PIPE.
            GOBACK.
        1000-EVALUATE-FPGA-PIPE.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1076-PIPE-OK = 1 AND
               WS-TH1077-DATBIN-STRAT-OK = 1 AND
               WS-TH1078-SUBMICRO-LAT-OK = 1 AND
               WS-TH1079-1080M-SAAT-OK = 1 AND
               WS-TH1080-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-FPGA-PIPE-WIT
            ELSE
                MOVE 0 TO WS-FPGA-PIPE-WIT.
