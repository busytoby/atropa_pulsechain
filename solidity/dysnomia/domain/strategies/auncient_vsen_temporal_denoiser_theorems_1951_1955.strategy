        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-VSEN-DENOISE.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-VSEN-DENOISE-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1951-REPROJECT-OK      PIC 9(01) VALUE 1.
            05  WS-TH1952-WAVELET-ENERGY-OK PIC 9(01) VALUE 1.
            05  WS-TH1953-DISOCCL-FET-OK    PIC 9(01) VALUE 1.
            05  WS-TH1954-1955M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1955-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-VSEN-DENOISE-WIT         PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-VSEN-DENOISE.
            GOBACK.
        1000-EVALUATE-VSEN-DENOISE.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1951-REPROJECT-OK = 1 AND
               WS-TH1952-WAVELET-ENERGY-OK = 1 AND
               WS-TH1953-DISOCCL-FET-OK = 1 AND
               WS-TH1954-1955M-SAAT-OK = 1 AND
               WS-TH1955-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-VSEN-DENOISE-WIT
            ELSE
                MOVE 0 TO WS-VSEN-DENOISE-WIT.
