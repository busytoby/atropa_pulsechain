       IDENTIFICATION DIVISION.
       PROGRAM-ID. TRANSITIVE-ASSET-TOTIENT-STRATEGY.
       AUTHOR. AUNCIENT DYSNOMIA VM / SVDAG MULTI-ASSET TOTIENT AUDIT.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-TRANSITIVE-PARAMETERS.
          05 WS-TRUNK-LINE-ID          PIC 9(02) VALUE 12.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-ASSET-SECTOR-1         PIC 9(05) VALUE 05570.
          05 WS-ASSET-SECTOR-2         PIC 9(05) VALUE 01234.
          05 WS-ASSET-SECTOR-3         PIC 9(05) VALUE 09876.
          05 WS-PLL-PHASE-ERR          PIC S9(05) VALUE +00064.
          05 WS-FAULT-STAGE-DEPTH      PIC 9(01) VALUE 0.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-ROOT-SHADOW-TOTIENT    PIC 9(12) VALUE 0.
          05 WS-G-GATE-1               PIC 9(04) VALUE 0.
          05 WS-G-GATE-2               PIC 9(04) VALUE 0.
          05 WS-G-GATE-3               PIC 9(04) VALUE 0.
          05 WS-S1-STAGED              PIC 9(12) VALUE 0.
          05 WS-S2-STAGED              PIC 9(12) VALUE 0.
          05 WS-S3-STAGED              PIC 9(12) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-TRUNK-LINE          VALUE 2.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 3.
             88 PLL-PHASE-LOCK-FAIL         VALUE 4.
             88 FAULT-DEPTH-OVERFLOW        VALUE 5.
             88 GATING-CLAMP-OVERFLOW       VALUE 6.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 7.
             88 MULTI-DEPTH-ROLLBACK-FAIL   VALUE 8.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-TRANSITIVE-CHAIN
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-TRUNK-LINE-ID < 1 OR WS-TRUNK-LINE-ID > 24
               SET INVALID-TRUNK-LINE TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-PLL-PHASE-ERR < -512 OR WS-PLL-PHASE-ERR > +512
               SET PLL-PHASE-LOCK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-FAULT-STAGE-DEPTH > 3
               SET FAULT-DEPTH-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-TRANSITIVE-CHAIN.
           COMPUTE WS-ROOT-SHADOW-TOTIENT = (WS-TRUNK-LINE-ID * 100000) + (WS-CICS-WRITER-ID * 1000) + 1000000.

           COMPUTE WS-G-GATE-1 = 875 + ((125 * WS-TRUNK-LINE-ID) / 24).
           COMPUTE WS-G-GATE-2 = 875 + ((125 * FUNCTION MOD(WS-TRUNK-LINE-ID + 4, 24)) / 24).
           COMPUTE WS-G-GATE-3 = 875 + ((125 * FUNCTION MOD(WS-TRUNK-LINE-ID + 8, 24)) / 24).

           IF WS-G-GATE-1 < 875 OR WS-G-GATE-1 > 1000 OR
              WS-G-GATE-2 < 875 OR WS-G-GATE-2 > 1000 OR
              WS-G-GATE-3 < 875 OR WS-G-GATE-3 > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-S1-STAGED = (((WS-ROOT-SHADOW-TOTIENT + (WS-ASSET-SECTOR-1 * 10)) * WS-G-GATE-1) / 1000).
           COMPUTE WS-S2-STAGED = (((WS-S1-STAGED + (WS-ASSET-SECTOR-2 * 10)) * WS-G-GATE-2) / 1000).
           COMPUTE WS-S3-STAGED = (((WS-S2-STAGED + (WS-ASSET-SECTOR-3 * 10)) * WS-G-GATE-3) / 1000).

           IF WS-FAULT-STAGE-DEPTH EQUAL 0
               MOVE WS-S3-STAGED TO WS-COMMITTED-OUTPUT
           ELSE IF WS-FAULT-STAGE-DEPTH EQUAL 1
               MOVE WS-ROOT-SHADOW-TOTIENT TO WS-COMMITTED-OUTPUT
           ELSE IF WS-FAULT-STAGE-DEPTH EQUAL 2
               MOVE WS-S1-STAGED TO WS-COMMITTED-OUTPUT
           ELSE IF WS-FAULT-STAGE-DEPTH EQUAL 3
               MOVE WS-S2-STAGED TO WS-COMMITTED-OUTPUT
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-ROOT-SHADOW-TOTIENT NOT EQUAL ((WS-TRUNK-LINE-ID * 100000) + (WS-CICS-WRITER-ID * 1000) + 1000000)
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-FAULT-STAGE-DEPTH EQUAL 1 AND WS-COMMITTED-OUTPUT NOT EQUAL WS-ROOT-SHADOW-TOTIENT
               SET MULTI-DEPTH-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
