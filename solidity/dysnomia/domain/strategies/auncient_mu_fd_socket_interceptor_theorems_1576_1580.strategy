        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FD-SOCKET.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FD-SOCKET-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1576-SOCKET-OK         PIC 9(01) VALUE 1.
            05  WS-TH1577-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1578-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1579-1580M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1580-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-FD-SOCKET-WIT            PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-FD-SOCKET.
            GOBACK.
        1000-EVALUATE-FD-SOCKET.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1576-SOCKET-OK = 1 AND
               WS-TH1577-DATBIN-STRAT-OK = 1 AND
               WS-TH1578-SUBMICRO-LAT-OK = 1 AND
               WS-TH1579-1580M-SAAT-OK = 1 AND
               WS-TH1580-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-FD-SOCKET-WIT
            ELSE
                MOVE 0 TO WS-FD-SOCKET-WIT.
