        IDENTIFICATION DIVISION.
        PROGRAM-ID. GM-UNX-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / GRAND MASTER UNIFICATION X AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-UNX-PARAMS.
           05 WS-UNIFICATION-IX-SCORE   PIC 9(04) VALUE 0920.
           05 WS-AUDIO-VAD-SCORE        PIC 9(04) VALUE 0890.
           05 WS-BANKNOTE-CUR-SCORE     PIC 9(04) VALUE 0870.
           05 WS-MULTILINGUAL-SCORE     PIC 9(04) VALUE 0880.
           05 WS-SCENE-TEXT-SCORE       PIC 9(04) VALUE 0910.
           05 WS-LOSS-FREE-BAL-SCORE    PIC 9(04) VALUE 0940.
           05 WS-PARTIALLY-SHARED-SCORE PIC 9(04) VALUE 0930.
           05 WS-GRAPH-MEMORY-SCORE     PIC 9(04) VALUE 0950.
           05 WS-POST-THINKING-SCORE    PIC 9(04) VALUE 0960.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-UNX-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-UNX-VITALITY           PIC 9(09) VALUE 0.
           05 WS-UNX-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-UNX-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-UNX-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 PILLAR-SCORE-OUT-OF-BOUNDS  VALUE 2.
              88 COMPOSITE-SCORE-LOW         VALUE 3.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 4.
              88 UNIFICATION-COLLAPSE        VALUE 5.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 6.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-UNIFICATION-X
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-UNIFICATION-IX-SCORE < 500 OR WS-UNIFICATION-IX-SCORE > 1000 OR
               WS-AUDIO-VAD-SCORE < 500 OR WS-AUDIO-VAD-SCORE > 1000 OR
               WS-BANKNOTE-CUR-SCORE < 500 OR WS-BANKNOTE-CUR-SCORE > 1000 OR
               WS-MULTILINGUAL-SCORE < 500 OR WS-MULTILINGUAL-SCORE > 1000 OR
               WS-SCENE-TEXT-SCORE < 500 OR WS-SCENE-TEXT-SCORE > 1000 OR
               WS-LOSS-FREE-BAL-SCORE < 500 OR WS-LOSS-FREE-BAL-SCORE > 1000 OR
               WS-PARTIALLY-SHARED-SCORE < 500 OR WS-PARTIALLY-SHARED-SCORE > 1000 OR
               WS-GRAPH-MEMORY-SCORE < 500 OR WS-GRAPH-MEMORY-SCORE > 1000 OR
               WS-POST-THINKING-SCORE < 500 OR WS-POST-THINKING-SCORE > 1000
                SET PILLAR-SCORE-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-UNIFICATION-X.
            COMPUTE WS-UNX-COMPOSITE = (WS-UNIFICATION-IX-SCORE +
                                       WS-AUDIO-VAD-SCORE +
                                       WS-BANKNOTE-CUR-SCORE +
                                       WS-MULTILINGUAL-SCORE +
                                       WS-SCENE-TEXT-SCORE +
                                       WS-LOSS-FREE-BAL-SCORE +
                                       WS-PARTIALLY-SHARED-SCORE +
                                       WS-GRAPH-MEMORY-SCORE +
                                       WS-POST-THINKING-SCORE) / 9.

            IF WS-UNX-COMPOSITE < 500
                SET COMPOSITE-SCORE-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-UNX-VITALITY = (WS-UNX-COMPOSITE / 4) +
                                      (WS-POST-THINKING-SCORE / 4) +
                                      (WS-UNIFICATION-IX-SCORE / 8) + 1.

            IF WS-UNX-VITALITY EQUAL ZERO
                SET UNIFICATION-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-UNX-COHERENCE = (WS-UNX-COMPOSITE / 16) +
                                       (WS-POST-THINKING-SCORE / 16) +
                                       (WS-UNIFICATION-IX-SCORE / 32).

            COMPUTE WS-UNX-REBAR-LATCH = 1470169088 +
                                         (WS-UNX-COMPOSITE / 2) +
                                         (WS-POST-THINKING-SCORE * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-UNX-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-UNX-VITALITY * 10) +
                                         (WS-UNX-COHERENCE * 10) +
                                         (WS-UNX-COMPOSITE * 10) +
                                         (WS-UNX-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-UNX-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-UNX-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
