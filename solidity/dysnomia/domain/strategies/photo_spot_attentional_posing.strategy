        IDENTIFICATION DIVISION.
        PROGRAM-ID. PSA-POS-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / PHOTO SPOT ATTENTIONAL POSING AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-PSA-PARAMS.
           05 WS-AESTHETIC-SCORE-M      PIC 9(04) VALUE 0960.
           05 WS-POSE-LOCK-LAT-MS       PIC 9(02) VALUE 20.
           05 WS-SOUVENIR-STORE-MS      PIC 9(03) VALUE 120.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-PSA-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-PSA-VITALITY           PIC 9(09) VALUE 0.
           05 WS-PSA-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-PSA-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-PSA-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 AESTHETIC-SCORE-LOW         VALUE 2.
              88 POSE-LOCK-LAT-OUT-OF-BOUNDS VALUE 3.
              88 SOUVENIR-STORE-OUT-OF-BND   VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 POSING-COLLAPSE             VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-ATTENTIONAL-POSING
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-AESTHETIC-SCORE-M < 850 OR WS-AESTHETIC-SCORE-M > 1000
                SET AESTHETIC-SCORE-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-POSE-LOCK-LAT-MS < 10 OR WS-POSE-LOCK-LAT-MS > 50
                SET POSE-LOCK-LAT-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-SOUVENIR-STORE-MS < 50 OR WS-SOUVENIR-STORE-MS > 250
                SET SOUVENIR-STORE-OUT-OF-BND TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-ATTENTIONAL-POSING.
            COMPUTE WS-PSA-COMPOSITE = (WS-AESTHETIC-SCORE-M / 2) +
                                       ((60 - WS-POSE-LOCK-LAT-MS) * 10) +
                                       ((300 - WS-SOUVENIR-STORE-MS) * 2).

            COMPUTE WS-PSA-VITALITY = (WS-PSA-COMPOSITE / 4) +
                                      (WS-AESTHETIC-SCORE-M / 4) +
                                      ((60 - WS-POSE-LOCK-LAT-MS) * 4) + 1.

            IF WS-PSA-VITALITY EQUAL ZERO
                SET POSING-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-PSA-COHERENCE = (WS-PSA-COMPOSITE / 16) +
                                       (WS-AESTHETIC-SCORE-M / 16) +
                                       ((60 - WS-POSE-LOCK-LAT-MS) * 2).

            COMPUTE WS-PSA-REBAR-LATCH = 1470169088 +
                                         (WS-PSA-COMPOSITE / 2) +
                                         ((60 - WS-POSE-LOCK-LAT-MS) * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-PSA-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-PSA-VITALITY * 10) +
                                         (WS-PSA-COHERENCE * 10) +
                                         (WS-PSA-COMPOSITE * 10) +
                                         (WS-PSA-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-PSA-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-PSA-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
