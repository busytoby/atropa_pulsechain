        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-TERACENTENNIAL.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-TERACENTENNIAL-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH291-CLOCK-OK           PIC 9(01) VALUE 1.
            05  WS-TH292-TMR-BITSTREAM-OK   PIC 9(01) VALUE 1.
            05  WS-TH293-ENDURANCE-OK       PIC 9(01) VALUE 1.
            05  WS-TH294-GEN-SAAT-OK        PIC 9(01) VALUE 1.
            05  WS-TH295-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-TERACENTENNIAL-WIT  PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-TERACENTENNIAL.
            GOBACK.
        1000-EVALUATE-TERACENTENNIAL.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH291-CLOCK-OK = 1 AND
               WS-TH292-TMR-BITSTREAM-OK = 1 AND
               WS-TH293-ENDURANCE-OK = 1 AND
               WS-TH294-GEN-SAAT-OK = 1 AND
               WS-TH295-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-TERACENTENNIAL-WIT
            ELSE
                MOVE 0 TO WS-FPGA-TERACENTENNIAL-WIT.
