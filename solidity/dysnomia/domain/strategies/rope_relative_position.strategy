        IDENTIFICATION DIVISION.
        PROGRAM-ID. ROPE-POS-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / ROPE EMBEDDING AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-ROPE-PARAMS.
           05 WS-POS-M                  PIC 9(05) VALUE 00128.
           05 WS-POS-N                  PIC 9(05) VALUE 00064.
           05 WS-HEAD-DIM               PIC 9(04) VALUE 0128.
           05 WS-EXACT-FLAG             PIC 9(01) VALUE 1.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-RELATIVE-OFFSET        PIC 9(05) VALUE 0.
           05 WS-ROPE-VITALITY          PIC 9(09) VALUE 0.
           05 WS-ROPE-COHERENCE         PIC 9(09) VALUE 0.
           05 WS-ROPE-REBAR-LATCH       PIC 9(12) VALUE 0.
           05 WS-SHADOW-ROPE-BASE       PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 INVALID-POS-M               VALUE 2.
              88 INVALID-POS-N               VALUE 3.
              88 INVALID-HEAD-DIM            VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 ROPE-EXACTNESS-FLAG-FAIL    VALUE 6.
              88 ROPE-DIVERG-FAIL            VALUE 7.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 8.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-ROPE-TRANSFORM
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-POS-M > 8192
                SET INVALID-POS-M TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-POS-N > 8192
                SET INVALID-POS-N TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-HEAD-DIM < 32 OR WS-HEAD-DIM > 256
                SET INVALID-HEAD-DIM TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-EXACT-FLAG NOT EQUAL 1
                SET ROPE-EXACTNESS-FLAG-FAIL TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-POS-M >= WS-POS-N
                COMPUTE WS-RELATIVE-OFFSET = WS-POS-M - WS-POS-N
            ELSE
                COMPUTE WS-RELATIVE-OFFSET = WS-POS-N - WS-POS-M
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-ROPE-TRANSFORM.
            COMPUTE WS-ROPE-VITALITY = (WS-RELATIVE-OFFSET * 16) +
                                       (WS-HEAD-DIM * 64) +
                                       (WS-POS-M * 8) +
                                       (WS-EXACT-FLAG * 256) + 1.

            IF WS-ROPE-VITALITY EQUAL ZERO
                SET ROPE-DIVERG-FAIL TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-ROPE-COHERENCE = (WS-RELATIVE-OFFSET * 4) +
                                        (WS-HEAD-DIM * 16) +
                                        (WS-POS-M * 2).

            COMPUTE WS-ROPE-REBAR-LATCH = 1470169088 +
                                          (WS-RELATIVE-OFFSET * 8) +
                                          (WS-HEAD-DIM * 32) +
                                          (WS-POS-M * 4).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-ROPE-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                          (WS-ROPE-VITALITY * 10) +
                                          (WS-ROPE-COHERENCE * 10) +
                                          (WS-RELATIVE-OFFSET * 100) +
                                          (WS-ROPE-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-ROPE-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-ROPE-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
