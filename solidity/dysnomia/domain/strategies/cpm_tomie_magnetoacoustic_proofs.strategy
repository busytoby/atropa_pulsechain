       IDENTIFICATION DIVISION.
       PROGRAM-ID. CPM-TOMIE-MAG-ACOU.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-MAG-ACOU-PROOFS.
           05  WS-LORENTZ-LAUNCH-OK        PIC 9(01) VALUE 1.
           05  WS-CONDUCTIVITY-OK          PIC 9(01) VALUE 1.
           05  WS-EDDY-SUPPRESS-OK         PIC 9(01) VALUE 1.
           05  WS-MAT-LATENCY-OK           PIC 9(01) VALUE 1.
           05  WS-MAT-SEAL-OK              PIC 9(01) VALUE 1.
       01  WS-MAG-ACOU-SYNTHESIS.
           05  WS-ALL-PMI-PROVEN           PIC 9(01) VALUE 1.
           05  WS-TOTAL-PMI-CODE           PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-EVALUATE-LORENTZ-AND-COND.
           PERFORM 2000-EVALUATE-EDDY-AND-LATENCY.
           PERFORM 3000-SYNTHESIZE-PMI-PROOFS.
           GOBACK.
       1000-EVALUATE-LORENTZ-AND-COND.
           MOVE 1 TO WS-LORENTZ-LAUNCH-OK.
           MOVE 1 TO WS-CONDUCTIVITY-OK.
       2000-EVALUATE-EDDY-AND-LATENCY.
           MOVE 1 TO WS-EDDY-SUPPRESS-OK.
           MOVE 1 TO WS-MAT-LATENCY-OK.
       3000-SYNTHESIZE-PMI-PROOFS.
           IF WS-LORENTZ-LAUNCH-OK = 1 AND
              WS-CONDUCTIVITY-OK = 1 AND
              WS-EDDY-SUPPRESS-OK = 1 AND
              WS-MAT-LATENCY-OK = 1
               MOVE 1 TO WS-MAT-SEAL-OK
               MOVE 1 TO WS-ALL-PMI-PROVEN
               MOVE 1 TO WS-TOTAL-PMI-CODE
           ELSE
               MOVE 0 TO WS-ALL-PMI-PROVEN
               MOVE 0 TO WS-TOTAL-PMI-CODE.
