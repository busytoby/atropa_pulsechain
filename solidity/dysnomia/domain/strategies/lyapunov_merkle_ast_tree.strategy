       IDENTIFICATION DIVISION.
       PROGRAM-ID. LYAPUNOV-MERKLE-AST.
       AUTHOR. AUNCIENT DYSNOMIA VM / 2-3 TREE AST MERKLE.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-TREE-PARAMS.
          05 WS-RDF-BAN-CODE           PIC 9(01) VALUE 1.
          05 WS-TREE-DEPTH-H           PIC 9(02) VALUE 16.
          05 WS-INIT-TREE-ENTROPY      PIC 9(05) VALUE 20000.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-CURRENT-TREE-ENTROPY   PIC 9(05) VALUE 0.
          05 WS-STEP-IDX               PIC 9(02) VALUE 0.
          05 WS-SHADOW-TREE-BASE       PIC 9(12) VALUE 0.
          05 WS-CYC-MOD                PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 RDF-SCHEMA-BANNED           VALUE 2.
             88 INVALID-TREE-DEPTH          VALUE 3.
             88 INVALID-TREE-ENTROPY        VALUE 4.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
             88 TREE-REBALANCE-FAIL         VALUE 6.
             88 GATING-CLAMP-OVERFLOW       VALUE 7.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 8.
             88 CASCADE-ROLLBACK-FAIL       VALUE 9.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-TREE-BALANCING
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-RDF-BAN-CODE NOT EQUAL 1
               SET RDF-SCHEMA-BANNED TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-TREE-DEPTH-H < 1 OR WS-TREE-DEPTH-H > 16
               SET INVALID-TREE-DEPTH TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-INIT-TREE-ENTROPY > 50000
               SET INVALID-TREE-ENTROPY TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-TREE-BALANCING.
           MOVE WS-INIT-TREE-ENTROPY TO WS-CURRENT-TREE-ENTROPY.

           PERFORM VARYING WS-STEP-IDX FROM 1 BY 1 UNTIL WS-STEP-IDX > WS-TREE-DEPTH-H
               COMPUTE WS-CURRENT-TREE-ENTROPY = (WS-CURRENT-TREE-ENTROPY * 875) / 1000
           END-PERFORM.

           IF WS-CURRENT-TREE-ENTROPY > WS-INIT-TREE-ENTROPY
               SET TREE-REBALANCE-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-SHADOW-TREE-BASE = (WS-CICS-WRITER-ID * 1000000) + 
               (WS-TREE-DEPTH-H * 10000) + (WS-RDF-BAN-CODE * 100) + (WS-CURRENT-TREE-ENTROPY / 16).

           COMPUTE WS-CYC-MOD = FUNCTION MOD(WS-TREE-DEPTH-H, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-CYC-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-TREE-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-TREE-BASE + ((WS-CURRENT-TREE-ENTROPY * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-TREE-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-TREE-DEPTH-H * 10000) + (WS-RDF-BAN-CODE * 100) + (WS-CURRENT-TREE-ENTROPY / 16))
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-TREE-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
