       IDENTIFICATION DIVISION.
       PROGRAM-ID. BESSEL-J0-STRATEGY.
       AUTHOR. AUNCIENT DYSNOMIA VM / COBOL BESSEL J0 STRATEGY DOMAIN.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-BESSEL-J0-PARAMETERS.
          05 WS-X-INPUT-Q16            PIC 9(06) VALUE 000256.
          05 WS-TRUNK-LINE-ID          PIC 9(02) VALUE 12.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-J0-EVALUATED-Q16       PIC 9(09) VALUE 0.
          05 WS-SHADOW-J0-BASELINE     PIC 9(12) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-X-INPUT             VALUE 2.
             88 INVALID-TRUNK-LINE          VALUE 3.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 4.
             88 GATING-CLAMP-OVERFLOW       VALUE 5.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 6.
             88 CASCADE-ROLLBACK-FAIL       VALUE 7.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-J0-EVALUATION
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-X-INPUT-Q16 > 65536
               SET INVALID-X-INPUT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-TRUNK-LINE-ID < 1 OR WS-TRUNK-LINE-ID > 24
               SET INVALID-TRUNK-LINE TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-J0-EVALUATION.
           COMPUTE WS-J0-EVALUATED-Q16 = 65536 - ((WS-X-INPUT-Q16 * WS-X-INPUT-Q16) / 262144).
           COMPUTE WS-SHADOW-J0-BASELINE = (WS-CICS-WRITER-ID * 10000) + WS-J0-EVALUATED-Q16.

           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-TRUNK-LINE-ID) / 24).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-J0-BASELINE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = (((WS-SHADOW-J0-BASELINE + (WS-J0-EVALUATED-Q16 * 16)) * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-J0-BASELINE NOT EQUAL ((WS-CICS-WRITER-ID * 10000) + WS-J0-EVALUATED-Q16)
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-J0-BASELINE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
