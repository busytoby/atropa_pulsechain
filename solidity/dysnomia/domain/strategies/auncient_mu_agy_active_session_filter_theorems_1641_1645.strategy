        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-SESSION-FILT.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-SESSION-FILT-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1641-FILT-OK           PIC 9(01) VALUE 1.
            05  WS-TH1642-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1643-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1644-1645M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1645-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-SESSION-FILT-WIT         PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-SESSION-FILT.
            GOBACK.
        1000-EVALUATE-SESSION-FILT.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1641-FILT-OK = 1 AND
               WS-TH1642-DATBIN-STRAT-OK = 1 AND
               WS-TH1643-SUBMICRO-LAT-OK = 1 AND
               WS-TH1644-1645M-SAAT-OK = 1 AND
               WS-TH1645-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-SESSION-FILT-WIT
            ELSE
                MOVE 0 TO WS-SESSION-FILT-WIT.
