       IDENTIFICATION DIVISION.
       PROGRAM-ID. CPM-TOMIE-FULL-STACK-ACID.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-FULL-STACK-ACID-PROOFS.
           05  WS-STRICT-ATOMICITY-OK      PIC 9(01) VALUE 1.
           05  WS-GALOIS-CONSISTENCY-OK    PIC 9(01) VALUE 1.
           05  WS-SERIALIZABLE-ISOLATION-OK PIC 9(01) VALUE 1.
           05  WS-IMMUTABLE-DURABILITY-OK  PIC 9(01) VALUE 1.
           05  WS-SHADOW-RESTITUTION-OK    PIC 9(01) VALUE 1.
       01  WS-ACID-SYNTHESIS.
           05  WS-ALL-ACID-PROVEN          PIC 9(01) VALUE 1.
           05  WS-TOTAL-ACID-CODE          PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-EVALUATE-ATOMICITY-AND-CONSISTENCY.
           PERFORM 2000-EVALUATE-ISOLATION-AND-DURABILITY.
           PERFORM 3000-EVALUATE-SHADOW-RESTITUTION.
           PERFORM 4000-SYNTHESIZE-ACID-PROOFS.
           GOBACK.
       1000-EVALUATE-ATOMICITY-AND-CONSISTENCY.
           MOVE 1 TO WS-STRICT-ATOMICITY-OK.
           MOVE 1 TO WS-GALOIS-CONSISTENCY-OK.
       2000-EVALUATE-ISOLATION-AND-DURABILITY.
           MOVE 1 TO WS-SERIALIZABLE-ISOLATION-OK.
           MOVE 1 TO WS-IMMUTABLE-DURABILITY-OK.
       3000-EVALUATE-SHADOW-RESTITUTION.
           MOVE 1 TO WS-SHADOW-RESTITUTION-OK.
       4000-SYNTHESIZE-ACID-PROOFS.
           IF WS-STRICT-ATOMICITY-OK = 1 AND
              WS-GALOIS-CONSISTENCY-OK = 1 AND
              WS-SERIALIZABLE-ISOLATION-OK = 1 AND
              WS-IMMUTABLE-DURABILITY-OK = 1 AND
              WS-SHADOW-RESTITUTION-OK = 1
               MOVE 1 TO WS-ALL-ACID-PROVEN
               MOVE 1 TO WS-TOTAL-ACID-CODE
           ELSE
               MOVE 0 TO WS-ALL-ACID-PROVEN
               MOVE 0 TO WS-TOTAL-ACID-CODE.
