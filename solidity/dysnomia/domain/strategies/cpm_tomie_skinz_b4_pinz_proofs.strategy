       IDENTIFICATION DIVISION.
       PROGRAM-ID. CPM-TOMIE-SKINZ-B4-PINZ.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-SKINZ-B4-PINZ-PROOFS.
           05  WS-PRECEDENCE-OK            PIC 9(01) VALUE 1.
           05  WS-SINGULARITY-ELIM-OK      PIC 9(01) VALUE 1.
           05  WS-GATED-PINNING-OK         PIC 9(01) VALUE 1.
           05  WS-PIPELINE-LATENCY-OK      PIC 9(01) VALUE 1.
           05  WS-SKINZ-PINZ-SEAL-OK       PIC 9(01) VALUE 1.
       01  WS-SKINZ-PINZ-SYNTHESIS.
           05  WS-ALL-SBP-PROVEN           PIC 9(01) VALUE 1.
           05  WS-TOTAL-SBP-CODE           PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-EVALUATE-PRECEDENCE-AND-ELIM.
           PERFORM 2000-EVALUATE-GATING-AND-LATENCY.
           PERFORM 3000-SYNTHESIZE-SBP-PROOFS.
           GOBACK.
       1000-EVALUATE-PRECEDENCE-AND-ELIM.
           MOVE 1 TO WS-PRECEDENCE-OK.
           MOVE 1 TO WS-SINGULARITY-ELIM-OK.
       2000-EVALUATE-GATING-AND-LATENCY.
           MOVE 1 TO WS-GATED-PINNING-OK.
           MOVE 1 TO WS-PIPELINE-LATENCY-OK.
       3000-SYNTHESIZE-SBP-PROOFS.
           IF WS-PRECEDENCE-OK = 1 AND
              WS-SINGULARITY-ELIM-OK = 1 AND
              WS-GATED-PINNING-OK = 1 AND
              WS-PIPELINE-LATENCY-OK = 1
               MOVE 1 TO WS-SKINZ-PINZ-SEAL-OK
               MOVE 1 TO WS-ALL-SBP-PROVEN
               MOVE 1 TO WS-TOTAL-SBP-CODE
           ELSE
               MOVE 0 TO WS-ALL-SBP-PROVEN
               MOVE 0 TO WS-TOTAL-SBP-CODE.
