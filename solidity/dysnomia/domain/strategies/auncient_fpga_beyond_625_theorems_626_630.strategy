        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-BEYOND-625.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-BEYOND-625-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH626-READ-TK-OK         PIC 9(01) VALUE 1.
            05  WS-TH627-PAGE-RIB-OK        PIC 9(01) VALUE 1.
            05  WS-TH628-TK-READ-LAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH629-630M-SAAT-OK       PIC 9(01) VALUE 1.
            05  WS-TH630-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-BEYOND-625-WIT      PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-BEYOND-625.
            GOBACK.
        1000-EVALUATE-BEYOND-625.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH626-READ-TK-OK = 1 AND
               WS-TH627-PAGE-RIB-OK = 1 AND
               WS-TH628-TK-READ-LAT-OK = 1 AND
               WS-TH629-630M-SAAT-OK = 1 AND
               WS-TH630-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-BEYOND-625-WIT
            ELSE
                MOVE 0 TO WS-FPGA-BEYOND-625-WIT.
