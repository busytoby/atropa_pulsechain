       IDENTIFICATION DIVISION.
       PROGRAM-ID. CPM-TOMIE-MCP-PROTOTYPE.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-MCP-PROTOTYPE-PROOFS.
           05  WS-TOOL-BINDING-OK          PIC 9(01) VALUE 1.
           05  WS-WCAG-ACCESS-OK           PIC 9(01) VALUE 1.
           05  WS-STATE-SYNC-OK            PIC 9(01) VALUE 1.
           05  WS-MCP-LATENCY-OK           PIC 9(01) VALUE 1.
           05  WS-MCP-SEAL-OK              PIC 9(01) VALUE 1.
       01  WS-MCP-SYNTHESIS.
           05  WS-ALL-MCP-PROVEN           PIC 9(01) VALUE 1.
           05  WS-TOTAL-MCP-CODE           PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-EVALUATE-BINDING-AND-WCAG.
           PERFORM 2000-EVALUATE-SYNC-AND-LATENCY.
           PERFORM 3000-SYNTHESIZE-MCP-PROOFS.
           GOBACK.
       1000-EVALUATE-BINDING-AND-WCAG.
           MOVE 1 TO WS-TOOL-BINDING-OK.
           MOVE 1 TO WS-WCAG-ACCESS-OK.
       2000-EVALUATE-SYNC-AND-LATENCY.
           MOVE 1 TO WS-STATE-SYNC-OK.
           MOVE 1 TO WS-MCP-LATENCY-OK.
       3000-SYNTHESIZE-MCP-PROOFS.
           IF WS-TOOL-BINDING-OK = 1 AND
              WS-WCAG-ACCESS-OK = 1 AND
              WS-STATE-SYNC-OK = 1 AND
              WS-MCP-LATENCY-OK = 1
               MOVE 1 TO WS-MCP-SEAL-OK
               MOVE 1 TO WS-ALL-MCP-PROVEN
               MOVE 1 TO WS-TOTAL-MCP-CODE
           ELSE
               MOVE 0 TO WS-ALL-MCP-PROVEN
               MOVE 0 TO WS-TOTAL-MCP-CODE.
