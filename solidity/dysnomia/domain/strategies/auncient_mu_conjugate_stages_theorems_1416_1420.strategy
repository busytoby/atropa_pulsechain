        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-CONJUGATE.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-CONJUGATE-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1416-CONJUGATE-OK      PIC 9(01) VALUE 1.
            05  WS-TH1417-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1418-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1419-1420M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1420-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-CONJUGATE-WIT            PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-CONJUGATE.
            GOBACK.
        1000-EVALUATE-CONJUGATE.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1416-CONJUGATE-OK = 1 AND
               WS-TH1417-DATBIN-STRAT-OK = 1 AND
               WS-TH1418-SUBMICRO-LAT-OK = 1 AND
               WS-TH1419-1420M-SAAT-OK = 1 AND
               WS-TH1420-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-CONJUGATE-WIT
            ELSE
                MOVE 0 TO WS-CONJUGATE-WIT.
