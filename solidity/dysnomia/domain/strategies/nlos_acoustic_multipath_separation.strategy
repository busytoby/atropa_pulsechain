        IDENTIFICATION DIVISION.
        PROGRAM-ID. NLOS-SEP-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / NLOS MULTI-PATH SEPARATION AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-NLOS-PARAMS.
           05 WS-DELAY-SPREAD-US        PIC 9(04) VALUE 0150.
           05 WS-MP-ATTEN-TENTHS-DB     PIC 9(03) VALUE 085.
           05 WS-DIRECT-REJECT-TENTHS   PIC 9(03) VALUE 180.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-MP-COMPOSITE           PIC 9(04) VALUE 0.
           05 WS-MP-VITALITY            PIC 9(09) VALUE 0.
           05 WS-MP-COHERENCE           PIC 9(09) VALUE 0.
           05 WS-MP-REBAR-LATCH         PIC 9(12) VALUE 0.
           05 WS-SHADOW-MP-BASE         PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 DELAY-SPREAD-UNDERFLOW      VALUE 2.
              88 MULTIPATH-ATTEN-LOW         VALUE 3.
              88 DIRECT-REJECT-RATIO-LOW     VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 MULTIPATH-COLLAPSE          VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-MULTIPATH-SEPARATION
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-DELAY-SPREAD-US < 50 OR WS-DELAY-SPREAD-US > 1000
                SET DELAY-SPREAD-UNDERFLOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-MP-ATTEN-TENTHS-DB < 60 OR WS-MP-ATTEN-TENTHS-DB > 300
                SET MULTIPATH-ATTEN-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-DIRECT-REJECT-TENTHS < 140 OR WS-DIRECT-REJECT-TENTHS > 400
                SET DIRECT-REJECT-RATIO-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-MULTIPATH-SEPARATION.
            COMPUTE WS-MP-COMPOSITE = (WS-DELAY-SPREAD-US / 2) +
                                      (WS-MP-ATTEN-TENTHS-DB * 2) +
                                      (WS-DIRECT-REJECT-TENTHS * 2).

            COMPUTE WS-MP-VITALITY = (WS-MP-COMPOSITE / 4) +
                                     (WS-DIRECT-REJECT-TENTHS * 2) +
                                     (WS-MP-ATTEN-TENTHS-DB * 4) + 1.

            IF WS-MP-VITALITY EQUAL ZERO
                SET MULTIPATH-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-MP-COHERENCE = (WS-MP-COMPOSITE / 16) +
                                      (WS-DIRECT-REJECT-TENTHS / 2) +
                                      (WS-MP-ATTEN-TENTHS-DB).

            COMPUTE WS-MP-REBAR-LATCH = 1470169088 +
                                        (WS-MP-COMPOSITE / 2) +
                                        (WS-DIRECT-REJECT-TENTHS * 32).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-MP-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                        (WS-MP-VITALITY * 10) +
                                        (WS-MP-COHERENCE * 10) +
                                        (WS-MP-COMPOSITE * 10) +
                                        (WS-MP-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-MP-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-MP-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
