        IDENTIFICATION DIVISION.
        PROGRAM-ID. ROBOT-SYNTH-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / PHYSICAL ROBOT SYNTHESIS AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-SYNTH-PARAMS.
           05 WS-SERVO-LATENCY          PIC 9(03) VALUE 035.
           05 WS-LCD-LATENCY            PIC 9(03) VALUE 015.
           05 WS-VOICE-LATENCY          PIC 9(03) VALUE 180.
           05 WS-LENS-ACHIEVEMENT       PIC 9(04) VALUE 0850.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-TOTAL-LATENCY          PIC 9(04) VALUE 0.
           05 WS-SYNTH-VITALITY         PIC 9(09) VALUE 0.
           05 WS-SYNTH-COHERENCE        PIC 9(09) VALUE 0.
           05 WS-SYNTH-REBAR-LATCH      PIC 9(12) VALUE 0.
           05 WS-SHADOW-SYNTH-BASE      PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 SERVO-OR-LCD-LATENCY-BREACH VALUE 2.
              88 VOICE-LATENCY-BREACH        VALUE 3.
              88 TOTAL-ACTUATION-BUDGET-FAIL VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 INVALID-LENS-ACHIEVEMENT    VALUE 6.
              88 SYNTHESIS-VITALITY-COLLAPSE VALUE 7.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 8.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-PHYSICAL-SYNTHESIS
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-SERVO-LATENCY < 1 OR WS-SERVO-LATENCY > 100 OR
               WS-LCD-LATENCY < 1 OR WS-LCD-LATENCY > 50
                SET SERVO-OR-LCD-LATENCY-BREACH TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-VOICE-LATENCY < 10 OR WS-VOICE-LATENCY > 350
                SET VOICE-LATENCY-BREACH TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-TOTAL-LATENCY = WS-SERVO-LATENCY + WS-LCD-LATENCY + WS-VOICE-LATENCY.
            IF WS-TOTAL-LATENCY > 500
                SET TOTAL-ACTUATION-BUDGET-FAIL TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-LENS-ACHIEVEMENT < 100 OR WS-LENS-ACHIEVEMENT > 1000
                SET INVALID-LENS-ACHIEVEMENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-PHYSICAL-SYNTHESIS.
            COMPUTE WS-SYNTH-VITALITY = ((500 - WS-TOTAL-LATENCY) * 16) +
                                        (WS-LENS-ACHIEVEMENT / 2) + 1.

            IF WS-SYNTH-VITALITY EQUAL ZERO
                SET SYNTHESIS-VITALITY-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-SYNTH-COHERENCE = ((500 - WS-TOTAL-LATENCY) * 4) +
                                         (WS-LENS-ACHIEVEMENT / 8).

            COMPUTE WS-SYNTH-REBAR-LATCH = 1470169088 +
                                           ((500 - WS-TOTAL-LATENCY) * 8) +
                                           (WS-LENS-ACHIEVEMENT / 2).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-SYNTH-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                           (WS-SYNTH-VITALITY * 10) +
                                           (WS-SYNTH-COHERENCE * 10) +
                                           (WS-LENS-ACHIEVEMENT * 10) +
                                           (WS-SYNTH-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-SYNTH-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-SYNTH-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
