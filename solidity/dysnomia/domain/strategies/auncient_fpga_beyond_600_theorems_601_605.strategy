        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-BEYOND-600.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-BEYOND-600-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH601-DBL-ENTRY-OK       PIC 9(01) VALUE 1.
            05  WS-TH602-HOGAN-SSA-OK       PIC 9(01) VALUE 1.
            05  WS-TH603-SETTLE-LAT-OK      PIC 9(01) VALUE 1.
            05  WS-TH604-605M-SAAT-OK       PIC 9(01) VALUE 1.
            05  WS-TH605-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-BEYOND-600-WIT      PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-BEYOND-600.
            GOBACK.
        1000-EVALUATE-BEYOND-600.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH601-DBL-ENTRY-OK = 1 AND
               WS-TH602-HOGAN-SSA-OK = 1 AND
               WS-TH603-SETTLE-LAT-OK = 1 AND
               WS-TH604-605M-SAAT-OK = 1 AND
               WS-TH605-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-BEYOND-600-WIT
            ELSE
                MOVE 0 TO WS-FPGA-BEYOND-600-WIT.
