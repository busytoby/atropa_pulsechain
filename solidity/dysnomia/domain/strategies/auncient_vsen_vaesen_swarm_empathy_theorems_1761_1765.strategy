        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-VSEN-VAESEN-SWARM.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-VSEN-SWARM-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1761-EMPATHY-INVAR-OK  PIC 9(01) VALUE 1.
            05  WS-TH1762-LASALLE-STAB-OK   PIC 9(01) VALUE 1.
            05  WS-TH1763-FET-ACOUSTIC-OK   PIC 9(01) VALUE 1.
            05  WS-TH1764-1765M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1765-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-VSEN-SWARM-WIT           PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-VSEN-SWARM.
            GOBACK.
        1000-EVALUATE-VSEN-SWARM.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1761-EMPATHY-INVAR-OK = 1 AND
               WS-TH1762-LASALLE-STAB-OK = 1 AND
               WS-TH1763-FET-ACOUSTIC-OK = 1 AND
               WS-TH1764-1765M-SAAT-OK = 1 AND
               WS-TH1765-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-VSEN-SWARM-WIT
            ELSE
                MOVE 0 TO WS-VSEN-SWARM-WIT.
