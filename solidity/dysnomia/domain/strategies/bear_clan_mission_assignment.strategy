        IDENTIFICATION DIVISION.
        PROGRAM-ID. BMA-MIS-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / BEAR CLAN MISSION ASSIGNMENT AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-BMA-PARAMS.
           05 WS-INGEST-LAT-MS          PIC 9(02) VALUE 12.
           05 WS-MISSION-FID-M          PIC 9(04) VALUE 0960.
           05 WS-HANDOFF-DRIFT-MS       PIC 9(02) VALUE 01.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-BMA-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-BMA-VITALITY           PIC 9(09) VALUE 0.
           05 WS-BMA-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-BMA-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-BMA-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 INGEST-LAT-OUT-OF-BOUNDS    VALUE 2.
              88 MISSION-FIDELITY-LOW        VALUE 3.
              88 HANDOFF-DRIFT-EXCEEDED      VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 MISSION-COLLAPSE            VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-CLAN-MISSION
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3 AND WS-K-EXPONENT NOT EQUAL 4
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-INGEST-LAT-MS < 5 OR WS-INGEST-LAT-MS > 25
                SET INGEST-LAT-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-MISSION-FID-M < 850 OR WS-MISSION-FID-M > 1000
                SET MISSION-FIDELITY-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-HANDOFF-DRIFT-MS < 0 OR WS-HANDOFF-DRIFT-MS > 5
                SET HANDOFF-DRIFT-EXCEEDED TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-CLAN-MISSION.
            COMPUTE WS-BMA-COMPOSITE = ((30 - WS-INGEST-LAT-MS) * 20) +
                                       (WS-MISSION-FID-M / 2) +
                                       ((10 - WS-HANDOFF-DRIFT-MS) * 40).

            COMPUTE WS-BMA-VITALITY = (WS-BMA-COMPOSITE / 4) +
                                      (WS-MISSION-FID-M / 4) +
                                      ((30 - WS-INGEST-LAT-MS) * 4) + 1.

            IF WS-BMA-VITALITY EQUAL ZERO
                SET MISSION-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-BMA-COHERENCE = (WS-BMA-COMPOSITE / 16) +
                                       (WS-MISSION-FID-M / 16) +
                                       ((30 - WS-INGEST-LAT-MS) * 2).

            COMPUTE WS-BMA-REBAR-LATCH = 1470169088 +
                                         (WS-BMA-COMPOSITE / 2) +
                                         ((30 - WS-INGEST-LAT-MS) * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-BMA-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-BMA-VITALITY * 10) +
                                         (WS-BMA-COHERENCE * 10) +
                                         (WS-BMA-COMPOSITE * 10) +
                                         (WS-BMA-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-BMA-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-BMA-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
