        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-BEYOND-750.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-BEYOND-750-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH751-THERMAL-OK         PIC 9(01) VALUE 1.
            05  WS-TH752-PHONON-CONT-OK     PIC 9(01) VALUE 1.
            05  WS-TH753-DISPERS-LAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH754-755M-SAAT-OK       PIC 9(01) VALUE 1.
            05  WS-TH755-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-BEYOND-750-WIT      PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-BEYOND-750.
            GOBACK.
        1000-EVALUATE-BEYOND-750.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH751-THERMAL-OK = 1 AND
               WS-TH752-PHONON-CONT-OK = 1 AND
               WS-TH753-DISPERS-LAT-OK = 1 AND
               WS-TH754-755M-SAAT-OK = 1 AND
               WS-TH755-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-BEYOND-750-WIT
            ELSE
                MOVE 0 TO WS-FPGA-BEYOND-750-WIT.
