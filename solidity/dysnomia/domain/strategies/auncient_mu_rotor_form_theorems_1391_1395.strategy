        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-ROTOR-FORM.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-ROTOR-FORM-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1391-FORM-OK           PIC 9(01) VALUE 1.
            05  WS-TH1392-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1393-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1394-1395M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1395-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-ROTOR-FORM-WIT           PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-ROTOR-FORM.
            GOBACK.
        1000-EVALUATE-ROTOR-FORM.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1391-FORM-OK = 1 AND
               WS-TH1392-DATBIN-STRAT-OK = 1 AND
               WS-TH1393-SUBMICRO-LAT-OK = 1 AND
               WS-TH1394-1395M-SAAT-OK = 1 AND
               WS-TH1395-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-ROTOR-FORM-WIT
            ELSE
                MOVE 0 TO WS-ROTOR-FORM-WIT.
