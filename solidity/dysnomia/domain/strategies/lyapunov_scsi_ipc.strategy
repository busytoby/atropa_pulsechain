       IDENTIFICATION DIVISION.
       PROGRAM-ID. LYAPUNOV-SCSI-IPC.
       AUTHOR. AUNCIENT DYSNOMIA VM / SCSI IPC.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-SCSI-PARAMS.
          05 WS-RAW-KEYCODE            PIC 9(03) VALUE 032.
          05 WS-INIT-LATENCY-US        PIC 9(05) VALUE 16000.
          05 WS-HANDSHAKE-CYCLES-N     PIC 9(02) VALUE 16.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-CURRENT-LATENCY        PIC 9(05) VALUE 0.
          05 WS-STEP-IDX               PIC 9(02) VALUE 0.
          05 WS-SHADOW-SCSI-BASE       PIC 9(12) VALUE 0.
          05 WS-CYC-MOD                PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-SCSI-KEYCODE        VALUE 2.
             88 INVALID-LATENCY             VALUE 3.
             88 INVALID-HANDSHAKE-CYCLES    VALUE 4.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
             88 SCSI-DEADLOCK-FAIL          VALUE 6.
             88 GATING-CLAMP-OVERFLOW       VALUE 7.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 8.
             88 CASCADE-ROLLBACK-FAIL       VALUE 9.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-SCSI-HANDSHAKE
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-RAW-KEYCODE NOT EQUAL 32 AND
              WS-RAW-KEYCODE NOT EQUAL 30 AND
              WS-RAW-KEYCODE NOT EQUAL 16 AND
              WS-RAW-KEYCODE NOT EQUAL 64
               SET INVALID-SCSI-KEYCODE TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-INIT-LATENCY-US > 50000
               SET INVALID-LATENCY TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-HANDSHAKE-CYCLES-N < 1 OR WS-HANDSHAKE-CYCLES-N > 64
               SET INVALID-HANDSHAKE-CYCLES TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-SCSI-HANDSHAKE.
           MOVE WS-INIT-LATENCY-US TO WS-CURRENT-LATENCY.

           PERFORM VARYING WS-STEP-IDX FROM 1 BY 1 UNTIL WS-STEP-IDX > WS-HANDSHAKE-CYCLES-N
               COMPUTE WS-CURRENT-LATENCY = (WS-CURRENT-LATENCY * 875) / 1000
           END-PERFORM.

           IF WS-CURRENT-LATENCY > WS-INIT-LATENCY-US
               SET SCSI-DEADLOCK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-SHADOW-SCSI-BASE = (WS-CICS-WRITER-ID * 1000000) + 
               (WS-HANDSHAKE-CYCLES-N * 10000) + (WS-RAW-KEYCODE * 100) + (WS-CURRENT-LATENCY / 16).

           COMPUTE WS-CYC-MOD = FUNCTION MOD(WS-RAW-KEYCODE, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-CYC-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-SCSI-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-SCSI-BASE + ((WS-CURRENT-LATENCY * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-SCSI-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-HANDSHAKE-CYCLES-N * 10000) + (WS-RAW-KEYCODE * 100) + (WS-CURRENT-LATENCY / 16))
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-SCSI-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
