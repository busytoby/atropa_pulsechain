        IDENTIFICATION DIVISION.
        PROGRAM-ID. NONHOLO-TELESCOPING-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / CREATIVE TELESCOPING AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-TELE-PARAMS.
           05 WS-INTEG-VARS-N           PIC 9(02) VALUE 02.
           05 WS-PARAM-COUNT-M          PIC 9(02) VALUE 01.
           05 WS-TELESCOPING-ORDER      PIC 9(02) VALUE 02.
           05 WS-CERT-DEGREE-Q          PIC 9(02) VALUE 04.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-TELE-VITALITY          PIC 9(09) VALUE 0.
           05 WS-TELE-COHERENCE         PIC 9(09) VALUE 0.
           05 WS-TELE-REBAR-LATCH       PIC 9(12) VALUE 0.
           05 WS-SHADOW-TELE-BASE       PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 INVALID-INTEG-VARS          VALUE 2.
              88 INVALID-PARAM-COUNT         VALUE 3.
              88 INVALID-TELESCOPING-ORDER   VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 INVALID-CERT-DEGREE         VALUE 6.
              88 TELE-DIVERG-FAIL            VALUE 7.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 8.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-TELESCOPING
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-INTEG-VARS-N < 1 OR WS-INTEG-VARS-N > 16
                SET INVALID-INTEG-VARS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-PARAM-COUNT-M < 1 OR WS-PARAM-COUNT-M > 16
                SET INVALID-PARAM-COUNT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-TELESCOPING-ORDER < 1 OR WS-TELESCOPING-ORDER > 16
                SET INVALID-TELESCOPING-ORDER TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CERT-DEGREE-Q < 1 OR WS-CERT-DEGREE-Q > 32
                SET INVALID-CERT-DEGREE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-TELESCOPING.
            COMPUTE WS-TELE-VITALITY = (WS-INTEG-VARS-N * 512) +
                                       (WS-PARAM-COUNT-M * 256) +
                                       (WS-TELESCOPING-ORDER * 64) +
                                       (WS-CERT-DEGREE-Q * 16) + 1.

            IF WS-TELE-VITALITY EQUAL ZERO
                SET TELE-DIVERG-FAIL TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-TELE-COHERENCE = (WS-TELESCOPING-ORDER * 32) +
                                        (WS-INTEG-VARS-N * 64) +
                                        (WS-CERT-DEGREE-Q * 16).

            COMPUTE WS-TELE-REBAR-LATCH = 1470169088 + (WS-INTEG-VARS-N * 256) +
                                          (WS-PARAM-COUNT-M * 64) +
                                          (WS-TELESCOPING-ORDER * 8).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-TELE-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                          (WS-TELE-VITALITY * 10) +
                                          (WS-TELE-COHERENCE * 10) +
                                          (WS-INTEG-VARS-N * 1000) +
                                          (WS-TELE-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-TELE-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-TELE-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
