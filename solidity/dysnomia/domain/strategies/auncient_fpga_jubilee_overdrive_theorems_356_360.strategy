        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-JUBILEE.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-JUBILEE-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH356-JUBILEE-ACCUM-OK   PIC 9(01) VALUE 1.
            05  WS-TH357-TANH-SOFTKNEE-OK   PIC 9(01) VALUE 1.
            05  WS-TH358-GERMANIUM-CLAMP-OK PIC 9(01) VALUE 1.
            05  WS-TH359-WMQ-256BYTE-OK     PIC 9(01) VALUE 1.
            05  WS-TH360-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-JUBILEE-WIT         PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-JUBILEE.
            GOBACK.
        1000-EVALUATE-JUBILEE.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH356-JUBILEE-ACCUM-OK = 1 AND
               WS-TH357-TANH-SOFTKNEE-OK = 1 AND
               WS-TH358-GERMANIUM-CLAMP-OK = 1 AND
               WS-TH359-WMQ-256BYTE-OK = 1 AND
               WS-TH360-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-JUBILEE-WIT
            ELSE
                MOVE 0 TO WS-FPGA-JUBILEE-WIT.
