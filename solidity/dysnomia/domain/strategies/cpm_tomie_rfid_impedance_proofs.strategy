       IDENTIFICATION DIVISION.
       PROGRAM-ID. CPM-TOMIE-RFID-IMPED.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-RFID-IMPED-PROOFS.
           05  WS-INDUCTANCE-OK            PIC 9(01) VALUE 1.
           05  WS-PERMEABILITY-OK          PIC 9(01) VALUE 1.
           05  WS-ADC-TRANSDUCTION-OK      PIC 9(01) VALUE 1.
           05  WS-RF-LATENCY-OK            PIC 9(01) VALUE 1.
           05  WS-RF-SEAL-OK               PIC 9(01) VALUE 1.
       01  WS-RFID-IMPED-SYNTHESIS.
           05  WS-ALL-PRF-PROVEN           PIC 9(01) VALUE 1.
           05  WS-TOTAL-PRF-CODE           PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-EVALUATE-INDUCT-AND-PERM.
           PERFORM 2000-EVALUATE-ADC-AND-LATENCY.
           PERFORM 3000-SYNTHESIZE-PRF-PROOFS.
           GOBACK.
       1000-EVALUATE-INDUCT-AND-PERM.
           MOVE 1 TO WS-INDUCTANCE-OK.
           MOVE 1 TO WS-PERMEABILITY-OK.
       2000-EVALUATE-ADC-AND-LATENCY.
           MOVE 1 TO WS-ADC-TRANSDUCTION-OK.
           MOVE 1 TO WS-RF-LATENCY-OK.
       3000-SYNTHESIZE-PRF-PROOFS.
           IF WS-INDUCTANCE-OK = 1 AND
              WS-PERMEABILITY-OK = 1 AND
              WS-ADC-TRANSDUCTION-OK = 1 AND
              WS-RF-LATENCY-OK = 1
               MOVE 1 TO WS-RF-SEAL-OK
               MOVE 1 TO WS-ALL-PRF-PROVEN
               MOVE 1 TO WS-TOTAL-PRF-CODE
           ELSE
               MOVE 0 TO WS-ALL-PRF-PROVEN
               MOVE 0 TO WS-TOTAL-PRF-CODE.
