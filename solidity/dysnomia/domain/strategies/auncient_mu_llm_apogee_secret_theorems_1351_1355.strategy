        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-APOGEE-SEC.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-APOGEE-SEC-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1351-SEC-OK            PIC 9(01) VALUE 1.
            05  WS-TH1352-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1353-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1354-1355M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1355-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-APOGEE-SEC-WIT           PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-APOGEE-SEC.
            GOBACK.
        1000-EVALUATE-APOGEE-SEC.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1351-SEC-OK = 1 AND
               WS-TH1352-DATBIN-STRAT-OK = 1 AND
               WS-TH1353-SUBMICRO-LAT-OK = 1 AND
               WS-TH1354-1355M-SAAT-OK = 1 AND
               WS-TH1355-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-APOGEE-SEC-WIT
            ELSE
                MOVE 0 TO WS-APOGEE-SEC-WIT.
