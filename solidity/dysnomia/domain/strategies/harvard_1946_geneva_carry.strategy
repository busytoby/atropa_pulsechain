IDENTIFICATION DIVISION.
PROGRAM-ID. PROG-HARVARD-1946-GENEVA-CARRY.

DATA DIVISION.
01 D0-SUBSTRATE-TRUNK.
   05 D0-MOTZKIN-PRIME     PIC 9(9) USAGE R0.
   05 D0-K-EXPONENT        PIC 9(9) USAGE R1.
   05 D0-GEAR-JAM-FLAG     PIC 9(9) USAGE R2.
01 D1-WHEEL-BASE-SHADOW.
   05 D1-BASE-COUNTER-VAL  PIC 9(9) USAGE R3.
   05 D1-INCREMENT-VAL     PIC 9(9) USAGE R4.
   05 D1-SHADOW-BASE-SNAP  PIC 9(9) USAGE R5.
01 D2-GENEVA-CARRY-STAGE.
   05 D2-ACCUM-SUM         PIC 9(9) USAGE R6.
   05 D2-COMMITTED-STATE   PIC 9(9) USAGE R7.
01 D3-LEAF-EVAL.
   05 D3-PROOF-RULING      PIC 9(9) USAGE R8.
   05 D3-DISP-WRAP-MOD     PIC 9(9) USAGE R9.

PROCEDURE DIVISION.
    MOVE 953467954 TO D0-MOTZKIN-PRIME.
    MOVE 3 TO D0-K-EXPONENT.
    MOVE 0 TO D0-GEAR-JAM-FLAG.
    MOVE 999999 TO D1-BASE-COUNTER-VAL.
    MOVE 1 TO D1-INCREMENT-VAL.

    PERFORM STAGE-GENEVA-RIPPLE-CARRY.
    PERFORM APPLY-GEAR-JAM-LATCH.
    PERFORM SYNC-DISPLACEMENT.

    IF D1-SHADOW-BASE-SNAP == D1-BASE-COUNTER-VAL
        MOVE 0 TO D3-PROOF-RULING
        SET depth 4
    ELSE
        MOVE 4 TO D3-PROOF-RULING
        SET depth 1
    END-IF.

    EVAL.
    GO TO END-STRATEGY.

STAGE-GENEVA-RIPPLE-CARRY.
    MOVE D1-BASE-COUNTER-VAL TO D1-SHADOW-BASE-SNAP.
    COMPUTE D2-ACCUM-SUM = D1-BASE-COUNTER-VAL + D1-INCREMENT-VAL.
    EXIT.

APPLY-GEAR-JAM-LATCH.
    IF D0-GEAR-JAM-FLAG == 1
        MOVE D1-SHADOW-BASE-SNAP TO D2-COMMITTED-STATE
    ELSE
        MOVE D2-ACCUM-SUM TO D2-COMMITTED-STATE
    END-IF.
    EXIT.

SYNC-DISPLACEMENT.
    COMPUTE D3-DISP-WRAP-MOD = D2-COMMITTED-STATE - ((D2-COMMITTED-STATE / 256) * 256).
    EXIT.

END-STRATEGY.
