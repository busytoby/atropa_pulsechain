        IDENTIFICATION DIVISION.
        PROGRAM-ID. ICD-LCK-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / INTERLOCKING CONSTRAINT DEADLOCK AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-ICD-PARAMS.
           05 WS-SOLVE-LAT-MS           PIC 9(02) VALUE 20.
           05 WS-DEADLOCK-FID-M         PIC 9(04) VALUE 0960.
           05 WS-CLEARANCE-MM           PIC 9(02) VALUE 01.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-ICD-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-ICD-VITALITY           PIC 9(09) VALUE 0.
           05 WS-ICD-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-ICD-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-ICD-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 SOLVE-LAT-OUT-OF-BOUNDS     VALUE 2.
              88 DEADLOCK-FID-LOW            VALUE 3.
              88 CLEARANCE-EXCEEDED          VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 INTERLOCK-COLLAPSE          VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-INTERLOCK-SOLVE
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-SOLVE-LAT-MS < 10 OR WS-SOLVE-LAT-MS > 50
                SET SOLVE-LAT-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-DEADLOCK-FID-M < 850 OR WS-DEADLOCK-FID-M > 1000
                SET DEADLOCK-FID-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CLEARANCE-MM < 0 OR WS-CLEARANCE-MM > 5
                SET CLEARANCE-EXCEEDED TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-INTERLOCK-SOLVE.
            COMPUTE WS-ICD-COMPOSITE = ((60 - WS-SOLVE-LAT-MS) * 10) +
                                       (WS-DEADLOCK-FID-M / 2) +
                                       ((10 - WS-CLEARANCE-MM) * 40).

            COMPUTE WS-ICD-VITALITY = (WS-ICD-COMPOSITE / 4) +
                                      (WS-DEADLOCK-FID-M / 4) +
                                      ((60 - WS-SOLVE-LAT-MS) * 4) + 1.

            IF WS-ICD-VITALITY EQUAL ZERO
                SET INTERLOCK-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-ICD-COHERENCE = (WS-ICD-COMPOSITE / 16) +
                                       (WS-DEADLOCK-FID-M / 16) +
                                       ((60 - WS-SOLVE-LAT-MS) * 2).

            COMPUTE WS-ICD-REBAR-LATCH = 1470169088 +
                                         (WS-ICD-COMPOSITE / 2) +
                                         ((60 - WS-SOLVE-LAT-MS) * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-ICD-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-ICD-VITALITY * 10) +
                                         (WS-ICD-COHERENCE * 10) +
                                         (WS-ICD-COMPOSITE * 10) +
                                         (WS-ICD-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-ICD-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-ICD-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
