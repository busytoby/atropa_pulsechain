IDENTIFICATION DIVISION.
PROGRAM-ID. PROG-RADICAL-NONCE-TRAJ.

DATA DIVISION.
01 D0-SUBSTRATE-TRUNK.
   05 D0-MOTZKIN-PRIME    PIC 9(9) USAGE R0.
   05 D0-LN2-OVER-LNE     PIC 9(9) USAGE R1.
   05 D0-K-EXPONENT       PIC 9(9) USAGE R2.
01 D1-TRAJECTORY-WINDOW.
   05 D1-WINDOW-STEPS     PIC 9(9) USAGE R3.
   05 D1-ALICE-OFFSET     PIC 9(9) USAGE R4.
   05 D1-BOB-OFFSET       PIC 9(9) USAGE R5.
01 D2-INTEGRAL-DESCRIPTOR.
   05 D2-FORWARD-INTEGRAL PIC 9(9) USAGE R6.
   05 D2-BACK-INTEGRAL    PIC 9(9) USAGE R7.
   05 D2-SYMM-PROD-SPI    PIC 9(9) USAGE R8.
   05 D2-SYMM-QUOT-SSIGMA PIC 9(9) USAGE R9.
01 D3-LEAF-EVAL.
   05 D3-RECOVERED-U      PIC 9(9) USAGE R10.
   05 D3-RECOVERED-V      PIC 9(9) USAGE R11.
   05 D3-PROOF-RULING     PIC 9(9) USAGE R12.
   05 D3-DISP-WRAP-MOD    PIC 9(9) USAGE R13.

PROCEDURE DIVISION.
    MOVE 953467954 TO D0-MOTZKIN-PRIME.
    MOVE 693 TO D0-LN2-OVER-LNE.
    MOVE 3 TO D0-K-EXPONENT.

    PERFORM COMPUTE-SYMMETRIC-PRODUCT-QUOTIENT.
    PERFORM RECOVER-BIJECTIVE-PHASE-TRAJECTORIES.
    
    IF D3-RECOVERED-U == D2-FORWARD-INTEGRAL AND D3-RECOVERED-V == D2-BACK-INTEGRAL
        MOVE 0 TO D3-PROOF-RULING
        SET depth 4
    ELSE
        MOVE 4 TO D3-PROOF-RULING
        SET depth 1
    END-IF.

    PERFORM SYNC-DISPLACEMENT-MODULO.
    EVAL.
    GO TO END-STRATEGY.

COMPUTE-SYMMETRIC-PRODUCT-QUOTIENT.
    COMPUTE D2-SYMM-PROD-SPI = D2-FORWARD-INTEGRAL + D2-BACK-INTEGRAL.
    IF D2-BACK-INTEGRAL >= D2-FORWARD-INTEGRAL
        COMPUTE D2-SYMM-QUOT-SSIGMA = D2-BACK-INTEGRAL - D2-FORWARD-INTEGRAL
    ELSE
        COMPUTE D2-SYMM-QUOT-SSIGMA = D2-FORWARD-INTEGRAL - D2-BACK-INTEGRAL
    END-IF.
    EXIT.

RECOVER-BIJECTIVE-PHASE-TRAJECTORIES.
    comment Exact algebraic inverse recovery (§ 214, § 215) for k=3;
    IF D2-BACK-INTEGRAL >= D2-FORWARD-INTEGRAL
        COMPUTE D3-RECOVERED-V = (D2-SYMM-PROD-SPI + D2-SYMM-QUOT-SSIGMA) / 2
        COMPUTE D3-RECOVERED-U = (D2-SYMM-PROD-SPI - D2-SYMM-QUOT-SSIGMA) / 2
    ELSE
        COMPUTE D3-RECOVERED-U = (D2-SYMM-PROD-SPI + D2-SYMM-QUOT-SSIGMA) / 2
        COMPUTE D3-RECOVERED-V = (D2-SYMM-PROD-SPI - D2-SYMM-QUOT-SSIGMA) / 2
    END-IF.
    EXIT.

SYNC-DISPLACEMENT-MODULO.
    COMPUTE D3-DISP-WRAP-MOD = D2-SYMM-QUOT-SSIGMA - ((D2-SYMM-QUOT-SSIGMA / 256) * 256).
    EXIT.

END-STRATEGY.
