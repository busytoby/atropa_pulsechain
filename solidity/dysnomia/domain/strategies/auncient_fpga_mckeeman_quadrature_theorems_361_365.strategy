        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-MCKEEMAN.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-MCKEEMAN-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH361-MCKEEMAN-QUAD-OK   PIC 9(01) VALUE 1.
            05  WS-TH362-EULER-LOG-OK       PIC 9(01) VALUE 1.
            05  WS-TH363-RICHARDSON-OK      PIC 9(01) VALUE 1.
            05  WS-TH364-QUAD-SAAT-OK       PIC 9(01) VALUE 1.
            05  WS-TH365-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-MCKEEMAN-WIT        PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-MCKEEMAN.
            GOBACK.
        1000-EVALUATE-MCKEEMAN.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH361-MCKEEMAN-QUAD-OK = 1 AND
               WS-TH362-EULER-LOG-OK = 1 AND
               WS-TH363-RICHARDSON-OK = 1 AND
               WS-TH364-QUAD-SAAT-OK = 1 AND
               WS-TH365-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-MCKEEMAN-WIT
            ELSE
                MOVE 0 TO WS-FPGA-MCKEEMAN-WIT.
