        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-TOTAL-CERT.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-TOTAL-CERT-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1186-FABRIC-OK         PIC 9(01) VALUE 1.
            05  WS-TH1187-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1188-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1189-1190M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1190-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-FPGA-TOTAL-CERT-WIT      PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-FPGA-TOTAL-CERT.
            GOBACK.
        1000-EVALUATE-FPGA-TOTAL-CERT.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1186-FABRIC-OK = 1 AND
               WS-TH1187-DATBIN-STRAT-OK = 1 AND
               WS-TH1188-SUBMICRO-LAT-OK = 1 AND
               WS-TH1189-1190M-SAAT-OK = 1 AND
               WS-TH1190-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-FPGA-TOTAL-CERT-WIT
            ELSE
                MOVE 0 TO WS-FPGA-TOTAL-CERT-WIT.
