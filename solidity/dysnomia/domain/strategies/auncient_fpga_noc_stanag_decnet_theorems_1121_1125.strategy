        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-BRIDGE.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-BRIDGE-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1121-BRIDGE-OK         PIC 9(01) VALUE 1.
            05  WS-TH1122-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1123-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1124-1125M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1125-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-FPGA-BRIDGE-WIT          PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-FPGA-BRIDGE.
            GOBACK.
        1000-EVALUATE-FPGA-BRIDGE.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1121-BRIDGE-OK = 1 AND
               WS-TH1122-DATBIN-STRAT-OK = 1 AND
               WS-TH1123-SUBMICRO-LAT-OK = 1 AND
               WS-TH1124-1125M-SAAT-OK = 1 AND
               WS-TH1125-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-FPGA-BRIDGE-WIT
            ELSE
                MOVE 0 TO WS-FPGA-BRIDGE-WIT.
