        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-ROTOR-SATURATE.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-ROTOR-SAT-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1456-SATURATE-OK       PIC 9(01) VALUE 1.
            05  WS-TH1457-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1458-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1459-1460M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1460-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-ROTOR-SAT-WIT            PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-ROTOR-SAT.
            GOBACK.
        1000-EVALUATE-ROTOR-SAT.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1456-SATURATE-OK = 1 AND
               WS-TH1457-DATBIN-STRAT-OK = 1 AND
               WS-TH1458-SUBMICRO-LAT-OK = 1 AND
               WS-TH1459-1460M-SAAT-OK = 1 AND
               WS-TH1460-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-ROTOR-SAT-WIT
            ELSE
                MOVE 0 TO WS-ROTOR-SAT-WIT.
