        IDENTIFICATION DIVISION.
        PROGRAM-ID. SPB-BAL-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / SPATIAL BALANCING WRITING AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-SPB-PARAMS.
           05 WS-TRADEOFF-LAT-MS        PIC 9(02) VALUE 12.
           05 WS-BALANCE-FID-M          PIC 9(04) VALUE 0960.
           05 WS-COORD-DRIFT-UM         PIC 9(02) VALUE 01.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-SPB-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-SPB-VITALITY           PIC 9(09) VALUE 0.
           05 WS-SPB-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-SPB-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-SPB-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 TRADE-LAT-OUT-OF-BOUNDS     VALUE 2.
              88 BALANCE-FIDELITY-LOW        VALUE 3.
              88 DRIFT-EXCEEDED              VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 SPATIAL-BAL-COLLAPSE        VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-SPATIAL-BALANCING
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3 AND WS-K-EXPONENT NOT EQUAL 4
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-TRADEOFF-LAT-MS < 5 OR WS-TRADEOFF-LAT-MS > 25
                SET TRADE-LAT-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-BALANCE-FID-M < 850 OR WS-BALANCE-FID-M > 1000
                SET BALANCE-FIDELITY-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-COORD-DRIFT-UM < 0 OR WS-COORD-DRIFT-UM > 5
                SET DRIFT-EXCEEDED TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-SPATIAL-BALANCING.
            COMPUTE WS-SPB-COMPOSITE = ((30 - WS-TRADEOFF-LAT-MS) * 20) +
                                       (WS-BALANCE-FID-M / 2) +
                                       ((10 - WS-COORD-DRIFT-UM) * 40).

            COMPUTE WS-SPB-VITALITY = (WS-SPB-COMPOSITE / 4) +
                                      (WS-BALANCE-FID-M / 4) +
                                      ((30 - WS-TRADEOFF-LAT-MS) * 4) + 1.

            IF WS-SPB-VITALITY EQUAL ZERO
                SET SPATIAL-BAL-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-SPB-COHERENCE = (WS-SPB-COMPOSITE / 16) +
                                       (WS-BALANCE-FID-M / 16) +
                                       ((30 - WS-TRADEOFF-LAT-MS) * 2).

            COMPUTE WS-SPB-REBAR-LATCH = 1470169088 +
                                         (WS-SPB-COMPOSITE / 2) +
                                         ((30 - WS-TRADEOFF-LAT-MS) * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-SPB-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-SPB-VITALITY * 10) +
                                         (WS-SPB-COHERENCE * 10) +
                                         (WS-SPB-COMPOSITE * 10) +
                                         (WS-SPB-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-SPB-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-SPB-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
