       IDENTIFICATION DIVISION.
       PROGRAM-ID. UNIVERSAL-HBRIDGE-CONFIG-STRATEGY.
       AUTHOR. AUNCIENT DYSNOMIA VM / UNIVERSAL LASALLE CONFIG.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-CONFIG-PARAMETERS.
          05 WS-TOPOLOGY-MODE-ID       PIC 9(02) VALUE 03.
          05 WS-QUORUM-AGENT-COUNT     PIC 9(02) VALUE 08.
          05 WS-DEADBAND-THRESH-EPS    PIC 9(05) VALUE 00100.
          05 WS-INITIAL-ENERGY-V0      PIC 9(09) VALUE 000050000.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-CONTRACTED-ENERGY      PIC 9(09) VALUE 0.
          05 WS-SHADOW-CONFIG-BASE     PIC 9(12) VALUE 0.
          05 WS-TOP-MOD                PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-TOPOLOGY-MODE       VALUE 2.
             88 INVALID-QUORUM-COUNT        VALUE 3.
             88 INVALID-ENERGY-DEADBAND     VALUE 4.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
             88 GATING-CLAMP-OVERFLOW       VALUE 6.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 7.
             88 CASCADE-ROLLBACK-FAIL       VALUE 8.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-UNIVERSAL-CONFIG
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-TOPOLOGY-MODE-ID < 1 OR WS-TOPOLOGY-MODE-ID > 5
               SET INVALID-TOPOLOGY-MODE TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-QUORUM-AGENT-COUNT < 4 OR WS-QUORUM-AGENT-COUNT > 24
               SET INVALID-QUORUM-COUNT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-INITIAL-ENERGY-V0 EQUAL ZERO OR WS-DEADBAND-THRESH-EPS EQUAL ZERO
               SET INVALID-ENERGY-DEADBAND TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-UNIVERSAL-CONFIG.
           COMPUTE WS-CONTRACTED-ENERGY = (WS-INITIAL-ENERGY-V0 * 875) / 1000.
           IF WS-CONTRACTED-ENERGY < WS-DEADBAND-THRESH-EPS
               MOVE ZERO TO WS-CONTRACTED-ENERGY
           END-IF.

           COMPUTE WS-SHADOW-CONFIG-BASE = (WS-CICS-WRITER-ID * 1000000) + 
               (WS-TOPOLOGY-MODE-ID * 10000) + (WS-QUORUM-AGENT-COUNT * 100) + 
               (WS-CONTRACTED-ENERGY / 16).

           COMPUTE WS-TOP-MOD = FUNCTION MOD(WS-TOPOLOGY-MODE-ID, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-TOP-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-CONFIG-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-CONFIG-BASE + (((WS-INITIAL-ENERGY-V0 / 10) * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-CONFIG-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-TOPOLOGY-MODE-ID * 10000) + (WS-QUORUM-AGENT-COUNT * 100) + (WS-CONTRACTED-ENERGY / 16))
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-CONFIG-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
