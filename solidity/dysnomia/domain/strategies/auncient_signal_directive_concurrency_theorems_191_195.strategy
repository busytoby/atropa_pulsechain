        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-CONCURRENCY-191-195.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-CONCURRENCY-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH191-FIFO-OK            PIC 9(01) VALUE 1.
            05  WS-TH192-DEADLOCK-FREE-OK   PIC 9(01) VALUE 1.
            05  WS-TH193-SUPERPOSITION-OK   PIC 9(01) VALUE 1.
            05  WS-TH194-DIVIDEND-OK        PIC 9(01) VALUE 1.
            05  WS-TH195-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-CONCURRENCY-WITNESS      PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-CONCURRENCY.
            GOBACK.
        1000-EVALUATE-CONCURRENCY.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH191-FIFO-OK = 1 AND
               WS-TH192-DEADLOCK-FREE-OK = 1 AND
               WS-TH193-SUPERPOSITION-OK = 1 AND
               WS-TH194-DIVIDEND-OK = 1 AND
               WS-TH195-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-CONCURRENCY-WITNESS
            ELSE
                MOVE 0 TO WS-CONCURRENCY-WITNESS.
