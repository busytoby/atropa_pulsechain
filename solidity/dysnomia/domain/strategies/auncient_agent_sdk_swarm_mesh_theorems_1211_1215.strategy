        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-SDK-SWARM-MSH.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-SWARM-MESH-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1211-SWARM-OK          PIC 9(01) VALUE 1.
            05  WS-TH1212-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1213-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1214-1215M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1215-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-SWARM-MESH-WIT           PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-SWARM-MESH.
            GOBACK.
        1000-EVALUATE-SWARM-MESH.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1211-SWARM-OK = 1 AND
               WS-TH1212-DATBIN-STRAT-OK = 1 AND
               WS-TH1213-SUBMICRO-LAT-OK = 1 AND
               WS-TH1214-1215M-SAAT-OK = 1 AND
               WS-TH1215-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-SWARM-MESH-WIT
            ELSE
                MOVE 0 TO WS-SWARM-MESH-WIT.
