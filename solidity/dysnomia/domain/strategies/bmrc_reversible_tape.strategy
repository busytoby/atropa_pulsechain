       IDENTIFICATION DIVISION.
       PROGRAM-ID. BMRC-REVERSIBLE-TAPE-STRATEGY.
       AUTHOR. AUNCIENT DYSNOMIA VM / BMRC REVERSIBLE TAPE.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-TAPE-PARAMETERS.
          05 WS-INITIAL-HEAD-POS       PIC 9(05) VALUE 00500.
          05 WS-WRITTEN-SYMBOL-VAL     PIC 9(03) VALUE 065.
          05 WS-SHIFT-DIRECTION-DIR    PIC S9(01) VALUE +1.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-NEW-HEAD-POS           PIC 9(05) VALUE 0.
          05 WS-RECOVERED-HEAD-POS     PIC 9(05) VALUE 0.
          05 WS-SHADOW-TAPE-BASE       PIC 9(12) VALUE 0.
          05 WS-HEAD-MOD               PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-WRITE-CHARGE           PIC 9(09) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-HEAD-POSITION       VALUE 2.
             88 INVALID-SYMBOL-VALUE        VALUE 3.
             88 INVALID-SHIFT-DIRECTION     VALUE 4.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
             88 GATING-CLAMP-OVERFLOW       VALUE 6.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 7.
             88 CASCADE-ROLLBACK-FAIL       VALUE 8.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-TAPE-TRANSITION
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-INITIAL-HEAD-POS > 9999
               SET INVALID-HEAD-POSITION TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-WRITTEN-SYMBOL-VAL > 255
               SET INVALID-SYMBOL-VALUE TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SHIFT-DIRECTION-DIR NOT EQUAL -1 AND
              WS-SHIFT-DIRECTION-DIR NOT EQUAL +1
               SET INVALID-SHIFT-DIRECTION TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-TAPE-TRANSITION.
           COMPUTE WS-NEW-HEAD-POS = WS-INITIAL-HEAD-POS + WS-SHIFT-DIRECTION-DIR.
           COMPUTE WS-RECOVERED-HEAD-POS = WS-NEW-HEAD-POS - WS-SHIFT-DIRECTION-DIR.

           IF WS-RECOVERED-HEAD-POS NOT EQUAL WS-INITIAL-HEAD-POS
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-SHADOW-TAPE-BASE = (WS-CICS-WRITER-ID * 1000000) + 
               (WS-NEW-HEAD-POS * 100) + WS-WRITTEN-SYMBOL-VAL.

           COMPUTE WS-HEAD-MOD = FUNCTION MOD(WS-NEW-HEAD-POS, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-HEAD-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-WRITE-CHARGE = WS-WRITTEN-SYMBOL-VAL * 16.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-TAPE-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-TAPE-BASE + ((WS-WRITE-CHARGE * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-TAPE-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-NEW-HEAD-POS * 100) + WS-WRITTEN-SYMBOL-VAL)
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-TAPE-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
