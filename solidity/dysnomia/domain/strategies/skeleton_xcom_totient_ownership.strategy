       IDENTIFICATION DIVISION.
       PROGRAM-ID. SKELETON-XCOM-OWNERSHIP-STRATEGY.
       AUTHOR. AUNCIENT DYSNOMIA VM / SKELETON XCOM TOTIENT DISCRIMINATOR.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-XCOM-PARAMETERS.
          05 WS-U-CANDIDATE            PIC 9(09) VALUE 000049152.
          05 WS-V-CANDIDATE            PIC 9(09) VALUE 000016384.
          05 WS-U-OWN-SIGNATURE        PIC 9(09) VALUE 000049152.
          05 WS-V-OWN-SIGNATURE        PIC 9(09) VALUE 000016384.
          05 WS-TOTIENT-INITIAL-MU0    PIC 9(12) VALUE 0000000000.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-SHADOW-OWNERSHIP-BASE  PIC 9(12) VALUE 0.
          05 WS-U-MOD                  PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-OWN-TOTIENT-CHARGE     PIC 9(09) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 ZERO-GENESIS-VIOLATION      VALUE 2.
             88 INVALID-TRAJECTORY-VECTORS  VALUE 3.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 4.
             88 FOREIGN-TOTIENT-REJECT      VALUE 5.
             88 GATING-CLAMP-OVERFLOW       VALUE 6.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 7.
             88 CASCADE-ROLLBACK-FAIL       VALUE 8.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-XCOM-DISCRIMINATION
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-U-CANDIDATE EQUAL ZERO OR WS-V-CANDIDATE EQUAL ZERO OR
              WS-U-OWN-SIGNATURE EQUAL ZERO OR WS-V-OWN-SIGNATURE EQUAL ZERO
               SET INVALID-TRAJECTORY-VECTORS TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-U-CANDIDATE NOT EQUAL WS-U-OWN-SIGNATURE OR
              WS-V-CANDIDATE NOT EQUAL WS-V-OWN-SIGNATURE
               SET FOREIGN-TOTIENT-REJECT TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-XCOM-DISCRIMINATION.
           COMPUTE WS-SHADOW-OWNERSHIP-BASE = (WS-CICS-WRITER-ID * 1000000) + 
               (WS-U-OWN-SIGNATURE / 16) + (WS-V-OWN-SIGNATURE / 16) + WS-TOTIENT-INITIAL-MU0.

           COMPUTE WS-U-MOD = FUNCTION MOD(WS-U-OWN-SIGNATURE, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-U-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-OWN-TOTIENT-CHARGE = WS-U-OWN-SIGNATURE + (WS-V-OWN-SIGNATURE * 2).

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-OWNERSHIP-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = (((WS-SHADOW-OWNERSHIP-BASE + WS-OWN-TOTIENT-CHARGE) * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-OWNERSHIP-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-U-OWN-SIGNATURE / 16) + (WS-V-OWN-SIGNATURE / 16) + WS-TOTIENT-INITIAL-MU0)
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-OWNERSHIP-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
