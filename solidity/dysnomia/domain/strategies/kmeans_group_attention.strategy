        IDENTIFICATION DIVISION.
        PROGRAM-ID. KGA-ATT-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / K-MEANS GROUP ATTENTION AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-KGA-PARAMS.
           05 WS-PARTITION-LAT-MS       PIC 9(02) VALUE 12.
           05 WS-CENTROID-FID-M         PIC 9(04) VALUE 0960.
           05 WS-DISPERSION-DRIFT-M     PIC 9(02) VALUE 01.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-KGA-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-KGA-VITALITY           PIC 9(09) VALUE 0.
           05 WS-KGA-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-KGA-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-KGA-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 PARTITION-LAT-OUT-OF-BOUNDS VALUE 2.
              88 CENTROID-FIDELITY-LOW       VALUE 3.
              88 DISPERSION-DRIFT-EXCEEDED   VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 KMEANS-COLLAPSE             VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-KMEANS-ATTENTION
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3 AND WS-K-EXPONENT NOT EQUAL 4
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-PARTITION-LAT-MS < 5 OR WS-PARTITION-LAT-MS > 25
                SET PARTITION-LAT-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CENTROID-FID-M < 850 OR WS-CENTROID-FID-M > 1000
                SET CENTROID-FIDELITY-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-DISPERSION-DRIFT-M < 0 OR WS-DISPERSION-DRIFT-M > 5
                SET DISPERSION-DRIFT-EXCEEDED TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-KMEANS-ATTENTION.
            COMPUTE WS-KGA-COMPOSITE = ((30 - WS-PARTITION-LAT-MS) * 20) +
                                       (WS-CENTROID-FID-M / 2) +
                                       ((10 - WS-DISPERSION-DRIFT-M) * 40).

            COMPUTE WS-KGA-VITALITY = (WS-KGA-COMPOSITE / 4) +
                                      (WS-CENTROID-FID-M / 4) +
                                      ((30 - WS-PARTITION-LAT-MS) * 4) + 1.

            IF WS-KGA-VITALITY EQUAL ZERO
                SET KMEANS-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-KGA-COHERENCE = (WS-KGA-COMPOSITE / 16) +
                                       (WS-CENTROID-FID-M / 16) +
                                       ((30 - WS-PARTITION-LAT-MS) * 2).

            COMPUTE WS-KGA-REBAR-LATCH = 1470169088 +
                                         (WS-KGA-COMPOSITE / 2) +
                                         ((30 - WS-PARTITION-LAT-MS) * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-KGA-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-KGA-VITALITY * 10) +
                                         (WS-KGA-COHERENCE * 10) +
                                         (WS-KGA-COMPOSITE * 10) +
                                         (WS-KGA-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-KGA-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-KGA-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
