        IDENTIFICATION DIVISION.
        PROGRAM-ID. SHARED-POS-INCONTEXT-STRATEGY.
        AUTHOR. AUNCIENT DYSNOMIA VM / POSITIONAL EMBEDDING AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-EMBEDDING-PARAMS.
           05 WS-ROPE-DIM               PIC 9(03) VALUE 128.
           05 WS-OVERLAP-TOKENS         PIC 9(03) VALUE 032.
           05 WS-INT-CORR-PERMILLE      PIC 9(04) VALUE 0815.
           05 WS-ID-SIM-PERMILLE        PIC 9(04) VALUE 0645.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-EMBEDDING-VITALITY     PIC 9(09) VALUE 0.
           05 WS-POS-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-EMBED-REBAR-LATCH      PIC 9(12) VALUE 0.
           05 WS-SHADOW-EMBED-BASE      PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 INVALID-ROPE-DIM            VALUE 2.
              88 INVALID-CONTEXT-OVERLAP     VALUE 3.
              88 INT-CORR-FAIL               VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 ID-SIM-FAIL                 VALUE 6.
              88 POS-EMBED-DIVERG-FAIL       VALUE 7.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 8.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-POSITIONAL-EMBEDDING
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-ROPE-DIM < 64 OR WS-ROPE-DIM > 512
                SET INVALID-ROPE-DIM TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-OVERLAP-TOKENS < 8 OR WS-OVERLAP-TOKENS > 128
                SET INVALID-CONTEXT-OVERLAP TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-INT-CORR-PERMILLE < 750 OR WS-INT-CORR-PERMILLE > 1000
                SET INT-CORR-FAIL TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-ID-SIM-PERMILLE < 600 OR WS-ID-SIM-PERMILLE > 1000
                SET ID-SIM-FAIL TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-POSITIONAL-EMBEDDING.
            COMPUTE WS-EMBEDDING-VITALITY = (WS-ROPE-DIM * 16) +
                                            (WS-OVERLAP-TOKENS * 64) +
                                            (WS-ID-SIM-PERMILLE * 4) + 1.

            IF WS-EMBEDDING-VITALITY EQUAL ZERO
                SET POS-EMBED-DIVERG-FAIL TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-POS-COHERENCE = ((WS-INT-CORR-PERMILLE * 8) +
                                        (WS-ID-SIM-PERMILLE * 4)) / 10.

            COMPUTE WS-EMBED-REBAR-LATCH = 1470169088 + (WS-ROPE-DIM * 256) +
                                           (WS-OVERLAP-TOKENS * 64) +
                                           (WS-ID-SIM-PERMILLE * 2).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-EMBED-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                           (WS-EMBEDDING-VITALITY * 10) +
                                           (WS-POS-COHERENCE * 10) +
                                           (WS-ROPE-DIM * 1000) +
                                           (WS-EMBED-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-EMBED-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-EMBED-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
