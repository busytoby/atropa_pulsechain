        IDENTIFICATION DIVISION.
        PROGRAM-ID. PST-WIN-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / POST THINKING SLIDING WINDOW AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-WIN-PARAMS.
           05 WS-SLIDING-WINDOW-N       PIC 9(02) VALUE 01.
           05 WS-CHAT-TURN-COUNT        PIC 9(02) VALUE 16.
           05 WS-CONTEXT-TOKENS         PIC 9(04) VALUE 1500.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-WIN-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-WIN-VITALITY           PIC 9(09) VALUE 0.
           05 WS-WIN-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-WIN-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-WIN-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 SLIDING-WINDOW-OUT-OF-BOUND VALUE 2.
              88 CHAT-TURN-OUT-OF-BOUNDS     VALUE 3.
              88 CONTEXT-TOKENS-OUT-OF-BOUND VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 SLIDING-WINDOW-COLLAPSE     VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-SLIDING-WINDOW
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-SLIDING-WINDOW-N < 1 OR WS-SLIDING-WINDOW-N > 4
                SET SLIDING-WINDOW-OUT-OF-BOUND TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CHAT-TURN-COUNT < 1 OR WS-CHAT-TURN-COUNT > 32
                SET CHAT-TURN-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CONTEXT-TOKENS < 500 OR WS-CONTEXT-TOKENS > 4096
                SET CONTEXT-TOKENS-OUT-OF-BOUND TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-SLIDING-WINDOW.
            COMPUTE WS-WIN-COMPOSITE = (WS-SLIDING-WINDOW-N * 100) +
                                       (WS-CHAT-TURN-COUNT * 20) +
                                       (WS-CONTEXT-TOKENS / 8).

            COMPUTE WS-WIN-VITALITY = (WS-WIN-COMPOSITE / 4) +
                                      (WS-CONTEXT-TOKENS / 16) +
                                      (WS-CHAT-TURN-COUNT * 5) + 1.

            IF WS-WIN-VITALITY EQUAL ZERO
                SET SLIDING-WINDOW-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-WIN-COHERENCE = (WS-WIN-COMPOSITE / 16) +
                                       (WS-CONTEXT-TOKENS / 32) +
                                       (WS-CHAT-TURN-COUNT * 2).

            COMPUTE WS-WIN-REBAR-LATCH = 1470169088 +
                                         (WS-WIN-COMPOSITE / 2) +
                                         (WS-SLIDING-WINDOW-N * 256).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-WIN-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-WIN-VITALITY * 10) +
                                         (WS-WIN-COHERENCE * 10) +
                                         (WS-WIN-COMPOSITE * 10) +
                                         (WS-WIN-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-WIN-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-WIN-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
