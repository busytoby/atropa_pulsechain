        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-AUX-ANKH-OS.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-AUX-ANKH-OS-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1051-ANKH-OS-OK        PIC 9(01) VALUE 1.
            05  WS-TH1052-DATBIN-ANKH-OK    PIC 9(01) VALUE 1.
            05  WS-TH1053-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1054-1055M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1055-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-AUX-ANKH-OS-WIT          PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-AUX-ANKH-OS.
            GOBACK.
        1000-EVALUATE-AUX-ANKH-OS.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1051-ANKH-OS-OK = 1 AND
               WS-TH1052-DATBIN-ANKH-OK = 1 AND
               WS-TH1053-SUBMICRO-LAT-OK = 1 AND
               WS-TH1054-1055M-SAAT-OK = 1 AND
               WS-TH1055-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-AUX-ANKH-OS-WIT
            ELSE
                MOVE 0 TO WS-AUX-ANKH-OS-WIT.
