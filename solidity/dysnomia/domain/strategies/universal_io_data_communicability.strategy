        IDENTIFICATION DIVISION.
        PROGRAM-ID. UIO-COM-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / UNIVERSAL IO DATA AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-UIO-PARAMS.
           05 WS-IO-COVERAGE-M          PIC 9(04) VALUE 0960.
           05 WS-SERIAL-PARITY-M        PIC 9(04) VALUE 0950.
           05 WS-REBAR-JITTER-MS        PIC 9(02) VALUE 02.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-UIO-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-UIO-VITALITY           PIC 9(09) VALUE 0.
           05 WS-UIO-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-UIO-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-UIO-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 IO-COVERAGE-LOW             VALUE 2.
              88 SERIALIZATION-PARITY-LOW    VALUE 3.
              88 REBAR-JITTER-EXCEEDED       VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 IO-COMMUNICABILITY-COLLAPSE VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-IO-COMMUNICABILITY
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-IO-COVERAGE-M < 850 OR WS-IO-COVERAGE-M > 1000
                SET IO-COVERAGE-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-SERIAL-PARITY-M < 900 OR WS-SERIAL-PARITY-M > 1000
                SET SERIALIZATION-PARITY-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-REBAR-JITTER-MS < 0 OR WS-REBAR-JITTER-MS > 5
                SET REBAR-JITTER-EXCEEDED TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-IO-COMMUNICABILITY.
            COMPUTE WS-UIO-COMPOSITE = (WS-IO-COVERAGE-M / 2) +
                                       (WS-SERIAL-PARITY-M / 2) +
                                       ((10 - WS-REBAR-JITTER-MS) * 20).

            COMPUTE WS-UIO-VITALITY = (WS-UIO-COMPOSITE / 4) +
                                      (WS-IO-COVERAGE-M / 4) +
                                      ((10 - WS-REBAR-JITTER-MS) * 4) + 1.

            IF WS-UIO-VITALITY EQUAL ZERO
                SET IO-COMMUNICABILITY-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-UIO-COHERENCE = (WS-UIO-COMPOSITE / 16) +
                                       (WS-SERIAL-PARITY-M / 16) +
                                       ((10 - WS-REBAR-JITTER-MS) * 2).

            COMPUTE WS-UIO-REBAR-LATCH = 1470169088 +
                                         (WS-UIO-COMPOSITE / 2) +
                                         ((10 - WS-REBAR-JITTER-MS) * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-UIO-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-UIO-VITALITY * 10) +
                                         (WS-UIO-COHERENCE * 10) +
                                         (WS-UIO-COMPOSITE * 10) +
                                         (WS-UIO-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-UIO-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-UIO-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
