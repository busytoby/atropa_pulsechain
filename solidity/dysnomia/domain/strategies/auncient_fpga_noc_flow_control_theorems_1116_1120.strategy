        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-NOC.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-NOC-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1116-NOC-OK            PIC 9(01) VALUE 1.
            05  WS-TH1117-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1118-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1119-1120M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1120-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-FPGA-NOC-WIT             PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-FPGA-NOC.
            GOBACK.
        1000-EVALUATE-FPGA-NOC.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1116-NOC-OK = 1 AND
               WS-TH1117-DATBIN-STRAT-OK = 1 AND
               WS-TH1118-SUBMICRO-LAT-OK = 1 AND
               WS-TH1119-1120M-SAAT-OK = 1 AND
               WS-TH1120-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-FPGA-NOC-WIT
            ELSE
                MOVE 0 TO WS-FPGA-NOC-WIT.
