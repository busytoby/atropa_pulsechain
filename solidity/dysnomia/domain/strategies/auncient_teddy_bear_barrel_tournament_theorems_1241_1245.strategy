        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-TEDDY_BEAR-TOURN.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-TEDDY_BEAR-TOURN-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1241-TOURN-OK          PIC 9(01) VALUE 1.
            05  WS-TH1242-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1243-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1244-1245M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1245-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-TEDDY_BEAR-TOURN-WIT          PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-TEDDY_BEAR-TOURN.
            GOBACK.
        1000-EVALUATE-TEDDY_BEAR-TOURN.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1241-TOURN-OK = 1 AND
               WS-TH1242-DATBIN-STRAT-OK = 1 AND
               WS-TH1243-SUBMICRO-LAT-OK = 1 AND
               WS-TH1244-1245M-SAAT-OK = 1 AND
               WS-TH1245-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-TEDDY_BEAR-TOURN-WIT
            ELSE
                MOVE 0 TO WS-TEDDY_BEAR-TOURN-WIT.
