        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-ALPHA-FOUNDATION.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-ALPHA-FOUND-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1446-CONSENSUS-OK      PIC 9(01) VALUE 1.
            05  WS-TH1447-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1448-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1449-1450M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1450-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-ALPHA-FOUND-WIT          PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-ALPHA-FOUND.
            GOBACK.
        1000-EVALUATE-ALPHA-FOUND.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1446-CONSENSUS-OK = 1 AND
               WS-TH1447-DATBIN-STRAT-OK = 1 AND
               WS-TH1448-SUBMICRO-LAT-OK = 1 AND
               WS-TH1449-1450M-SAAT-OK = 1 AND
               WS-TH1450-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-ALPHA-FOUND-WIT
            ELSE
                MOVE 0 TO WS-ALPHA-FOUND-WIT.
