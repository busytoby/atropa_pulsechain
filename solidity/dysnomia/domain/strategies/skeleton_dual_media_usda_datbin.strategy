       IDENTIFICATION DIVISION.
       PROGRAM-ID. SKELETON-DUAL-MEDIA-STRATEGY.
       AUTHOR. AUNCIENT DYSNOMIA VM / USDA / DAT-BIN SKELETON AUDIT.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-SKELETON-PARAMETERS.
          05 WS-DNA-SEED               PIC 9(09) VALUE 000043605.
          05 WS-MEDIA-FORMAT           PIC 9(01) VALUE 2.
             88 FORMAT-DAT-BIN         VALUE 1.
             88 FORMAT-USDA            VALUE 2.
          05 WS-JOINT-COUNT            PIC 9(02) VALUE 64.
          05 WS-PLL-PHASE-ERR          PIC S9(05) VALUE +00064.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-SITE-INDEX             PIC 9(02) VALUE 0.
          05 WS-SHADOW-ROOT            PIC 9(12) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-DNA-SEED            VALUE 2.
             88 INVALID-MEDIA-FORMAT        VALUE 3.
             88 JOINT-COUNT-BOUND-FAIL      VALUE 4.
             88 PLL-PHASE-LOCK-FAIL         VALUE 5.
             88 GATING-CLAMP-OVERFLOW       VALUE 6.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 7.
             88 CASCADE-ROLLBACK-FAIL       VALUE 8.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-SKELETON-SYNTHESIS
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-DNA-SEED EQUAL ZERO
               SET INVALID-DNA-SEED TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-MEDIA-FORMAT NOT EQUAL 1 AND WS-MEDIA-FORMAT NOT EQUAL 2
               SET INVALID-MEDIA-FORMAT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-JOINT-COUNT < 1 OR WS-JOINT-COUNT > 64
               SET JOINT-COUNT-BOUND-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-PLL-PHASE-ERR < -512 OR WS-PLL-PHASE-ERR > +512
               SET PLL-PHASE-LOCK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-SKELETON-SYNTHESIS.
           COMPUTE WS-SITE-INDEX = FUNCTION MOD(WS-DNA-SEED, 9) + 1.
           COMPUTE WS-SHADOW-ROOT = (WS-DNA-SEED * 100) + (WS-SITE-INDEX * 1000).

           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-SITE-INDEX) / 9).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-ROOT TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = (((WS-SHADOW-ROOT + (WS-JOINT-COUNT * 256)) * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-ROOT NOT EQUAL ((WS-DNA-SEED * 100) + (WS-SITE-INDEX * 1000))
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-ROOT
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
