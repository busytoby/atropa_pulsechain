        IDENTIFICATION DIVISION.
        PROGRAM-ID. ACCUMULATOR-ZEROING-STRATEGY.
        AUTHOR. AUNCIENT DYSNOMIA VM / ACCUMULATOR ZEROING AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-NULL-PARAMS.
           05 WS-RADICAL-POWER-M        PIC 9(02) VALUE 02.
           05 WS-CLAMPED-ENERGY         PIC 9(05) VALUE 00000.
           05 WS-NIL-INDEX-K            PIC 9(02) VALUE 01.
           05 WS-NEUTRAL-FLAG           PIC 9(01) VALUE 1.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-NULL-VITALITY          PIC 9(09) VALUE 0.
           05 WS-RADICAL-COHERENCE      PIC 9(09) VALUE 0.
           05 WS-NULL-REBAR-LATCH       PIC 9(12) VALUE 0.
           05 WS-SHADOW-NULL-BASE       PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 INVALID-RADICAL-POWER       VALUE 2.
              88 NEGATIVE-ACCUMULATOR-VIOL   VALUE 3.
              88 INVALID-NIL-INDEX           VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 NEUTRAL-EQUILIBRIUM-FAIL    VALUE 6.
              88 NULLSTELLENSATZ-DIVERG-FAIL VALUE 7.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 8.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-ZEROING
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-RADICAL-POWER-M < 1 OR WS-RADICAL-POWER-M > 16
                SET INVALID-RADICAL-POWER TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CLAMPED-ENERGY < 0 OR WS-CLAMPED-ENERGY > 10000
                SET NEGATIVE-ACCUMULATOR-VIOL TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-NIL-INDEX-K < 1 OR WS-NIL-INDEX-K > 16
                SET INVALID-NIL-INDEX TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-NEUTRAL-FLAG NOT EQUAL 1
                SET NEUTRAL-EQUILIBRIUM-FAIL TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-ZEROING.
            COMPUTE WS-NULL-VITALITY = (WS-RADICAL-POWER-M * 512) +
                                       ((WS-CLAMPED-ENERGY + 1) * 8) +
                                       (WS-NIL-INDEX-K * 64) +
                                       (WS-NEUTRAL-FLAG * 128) + 1.

            IF WS-NULL-VITALITY EQUAL ZERO
                SET NULLSTELLENSATZ-DIVERG-FAIL TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-RADICAL-COHERENCE = (WS-NIL-INDEX-K * 32) +
                                           (WS-RADICAL-POWER-M * 64) +
                                           ((WS-CLAMPED-ENERGY / 100) * 16).

            COMPUTE WS-NULL-REBAR-LATCH = 1470169088 + (WS-RADICAL-POWER-M * 256) +
                                          (WS-NIL-INDEX-K * 64) +
                                          ((WS-CLAMPED-ENERGY / 100) * 8).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-NULL-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                          (WS-NULL-VITALITY * 10) +
                                          (WS-RADICAL-COHERENCE * 10) +
                                          (WS-RADICAL-POWER-M * 1000) +
                                          (WS-NULL-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-NULL-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-NULL-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
