        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-ZKSAT-COLLAPSE.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-ZKSAT-COLLAPSE-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1526-COLLAPSE-OK       PIC 9(01) VALUE 1.
            05  WS-TH1527-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1528-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1529-1530M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1530-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-ZKSAT-COLLAPSE-WIT       PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-ZKSAT-COLLAPSE.
            GOBACK.
        1000-EVALUATE-ZKSAT-COLLAPSE.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1526-COLLAPSE-OK = 1 AND
               WS-TH1527-DATBIN-STRAT-OK = 1 AND
               WS-TH1528-SUBMICRO-LAT-OK = 1 AND
               WS-TH1529-1530M-SAAT-OK = 1 AND
               WS-TH1530-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-ZKSAT-COLLAPSE-WIT
            ELSE
                MOVE 0 TO WS-ZKSAT-COLLAPSE-WIT.
