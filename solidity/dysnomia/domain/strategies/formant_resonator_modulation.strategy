        IDENTIFICATION DIVISION.
        PROGRAM-ID. FORMANT-MOD-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / FORMANT ACOUSTIC AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-FORMANT-PARAMS.
           05 WS-F1-HZ                  PIC 9(04) VALUE 0500.
           05 WS-F2-HZ                  PIC 9(04) VALUE 1500.
           05 WS-F3-HZ                  PIC 9(04) VALUE 2500.
           05 WS-GAIN-Q15               PIC 9(05) VALUE 16384.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-FMT-VITALITY           PIC 9(09) VALUE 0.
           05 WS-FMT-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-FMT-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-FMT-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 INVALID-F1-FREQ             VALUE 2.
              88 INVALID-F2-FREQ             VALUE 3.
              88 INVALID-F3-FREQ             VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 INVALID-FILTER-GAIN         VALUE 6.
              88 FORMANT-ORDERING-FAIL       VALUE 7.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 8.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-FORMANT-RESONANCE
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-F1-HZ < 200 OR WS-F1-HZ > 1200
                SET INVALID-F1-FREQ TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-F2-HZ < 700 OR WS-F2-HZ > 3000
                SET INVALID-F2-FREQ TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-F3-HZ < 1500 OR WS-F3-HZ > 4000
                SET INVALID-F3-FREQ TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-GAIN-Q15 < 100 OR WS-GAIN-Q15 > 32767
                SET INVALID-FILTER-GAIN TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-F1-HZ >= WS-F2-HZ OR WS-F2-HZ >= WS-F3-HZ
                SET FORMANT-ORDERING-FAIL TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-FORMANT-RESONANCE.
            COMPUTE WS-FMT-VITALITY = (WS-F1-HZ * 64) +
                                      (WS-F2-HZ * 32) +
                                      (WS-F3-HZ * 16) +
                                      (WS-GAIN-Q15 / 16) + 1.

            IF WS-FMT-VITALITY EQUAL ZERO
                SET FORMANT-ORDERING-FAIL TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-FMT-COHERENCE = (WS-F1-HZ * 16) +
                                       (WS-F2-HZ * 8) +
                                       (WS-F3-HZ * 4) +
                                       (WS-GAIN-Q15 / 64).

            COMPUTE WS-FMT-REBAR-LATCH = 1470169088 +
                                         (WS-F1-HZ * 32) +
                                         (WS-F2-HZ * 16) +
                                         (WS-F3-HZ * 8).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-FMT-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-FMT-VITALITY * 10) +
                                         (WS-FMT-COHERENCE * 10) +
                                         (WS-F1-HZ * 100) +
                                         (WS-FMT-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-FMT-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-FMT-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
