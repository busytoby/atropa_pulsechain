       IDENTIFICATION DIVISION.
       PROGRAM-ID. BMRC-INFINITE-OUTPUT-STRATEGY.
       AUTHOR. AUNCIENT DYSNOMIA VM / BMRC INFINITE OUTPUT DOMAIN.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-GENERATION-PARAMS.
          05 WS-GENERATION-DEPTH-K     PIC 9(06) VALUE 001000.
          05 WS-S-SIGMA-SEED           PIC 9(09) VALUE 000065536.
          05 WS-S-PI-SEED              PIC 9(09) VALUE 000032768.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-SHADOW-ORIGIN-BASE     PIC 9(12) VALUE 0.
          05 WS-CURRENT-U-NONCE        PIC 9(09) VALUE 0.
          05 WS-CURRENT-V-NONCE        PIC 9(09) VALUE 0.
          05 WS-PREV-U-NONCE           PIC 9(09) VALUE 0.
          05 WS-CURRENT-TOTIENT-OUT    PIC 9(12) VALUE 0.
          05 WS-STEP-IDX               PIC 9(06) VALUE 0.
          05 WS-DEPTH-MOD              PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-GENERATION-DEPTH    VALUE 2.
             88 INVALID-SEEDS               VALUE 3.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 4.
             88 DOMAIN-SATURATION-COLLIDE   VALUE 5.
             88 GATING-CLAMP-OVERFLOW       VALUE 6.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 7.
             88 CASCADE-ROLLBACK-FAIL       VALUE 8.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-INFINITE-GENERATION
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-GENERATION-DEPTH-K < 1 OR WS-GENERATION-DEPTH-K > 100000
               SET INVALID-GENERATION-DEPTH TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-S-SIGMA-SEED EQUAL ZERO OR WS-S-PI-SEED EQUAL ZERO
               SET INVALID-SEEDS TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-INFINITE-GENERATION.
           COMPUTE WS-SHADOW-ORIGIN-BASE = (WS-CICS-WRITER-ID * 1000000) + 0.

           COMPUTE WS-CURRENT-U-NONCE = (WS-S-PI-SEED + WS-S-SIGMA-SEED) / 2.
           COMPUTE WS-CURRENT-V-NONCE = WS-S-SIGMA-SEED - WS-CURRENT-U-NONCE.
           MOVE ZERO TO WS-PREV-U-NONCE.
           MOVE ZERO TO WS-CURRENT-TOTIENT-OUT.

           PERFORM VARYING WS-STEP-IDX FROM 1 BY 1 UNTIL WS-STEP-IDX > WS-GENERATION-DEPTH-K
               MOVE WS-CURRENT-U-NONCE TO WS-PREV-U-NONCE
               COMPUTE WS-CURRENT-U-NONCE = FUNCTION MOD(((WS-CURRENT-U-NONCE * 65537) + WS-CURRENT-V-NONCE + WS-STEP-IDX), 1000000)
               COMPUTE WS-CURRENT-V-NONCE = FUNCTION MOD(((WS-CURRENT-V-NONCE * 32771) + WS-STEP-IDX), 1000000)
               COMPUTE WS-CURRENT-TOTIENT-OUT = WS-CURRENT-TOTIENT-OUT + WS-CURRENT-U-NONCE + (WS-CURRENT-V-NONCE * 2)

               IF WS-CURRENT-U-NONCE EQUAL WS-PREV-U-NONCE
                   SET DOMAIN-SATURATION-COLLIDE TO TRUE
                   EXIT PARAGRAPH
               END-IF
           END-PERFORM.

           COMPUTE WS-DEPTH-MOD = FUNCTION MOD(WS-GENERATION-DEPTH-K, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-DEPTH-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-ORIGIN-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-ORIGIN-BASE + (((WS-CURRENT-TOTIENT-OUT / 1000) * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-ORIGIN-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + 0)
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-ORIGIN-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
