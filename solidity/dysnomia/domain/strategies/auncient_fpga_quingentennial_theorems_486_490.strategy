        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-QUINGENTENNIAL.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-QUINGENTENNIAL-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH486-HOLONOMIC-OK       PIC 9(01) VALUE 1.
            05  WS-TH487-BRAIDING-OK        PIC 9(01) VALUE 1.
            05  WS-TH488-TK-CLOSURE-OK      PIC 9(01) VALUE 1.
            05  WS-TH489-QUIN-SAAT-OK       PIC 9(01) VALUE 1.
            05  WS-TH490-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-QUINGENTENNIAL-WIT  PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-QUINGENTENNIAL.
            GOBACK.
        1000-EVALUATE-QUINGENTENNIAL.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH486-HOLONOMIC-OK = 1 AND
               WS-TH487-BRAIDING-OK = 1 AND
               WS-TH488-TK-CLOSURE-OK = 1 AND
               WS-TH489-QUIN-SAAT-OK = 1 AND
               WS-TH490-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-QUINGENTENNIAL-WIT
            ELSE
                MOVE 0 TO WS-FPGA-QUINGENTENNIAL-WIT.
