        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-VSEN-12SCN.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-VSEN-12SCN-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1941-AV-INTERLEAVE-OK  PIC 9(01) VALUE 1.
            05  WS-TH1942-BIO-ENERGY-OK     PIC 9(01) VALUE 1.
            05  WS-TH1943-MUX-LATENCY-OK    PIC 9(01) VALUE 1.
            05  WS-TH1944-1945M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1945-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-VSEN-12SCN-WIT           PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-VSEN-12SCN.
            GOBACK.
        1000-EVALUATE-VSEN-12SCN.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1941-AV-INTERLEAVE-OK = 1 AND
               WS-TH1942-BIO-ENERGY-OK = 1 AND
               WS-TH1943-MUX-LATENCY-OK = 1 AND
               WS-TH1944-1945M-SAAT-OK = 1 AND
               WS-TH1945-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-VSEN-12SCN-WIT
            ELSE
                MOVE 0 TO WS-VSEN-12SCN-WIT.
