        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-VSEN-DF-ANIM.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-VSEN-DF-ANIM-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1856-8WAY-SLICE-OK     PIC 9(01) VALUE 1.
            05  WS-TH1857-SWARM-SYNC-OK     PIC 9(01) VALUE 1.
            05  WS-TH1858-8WAY-LATENCY-OK   PIC 9(01) VALUE 1.
            05  WS-TH1859-1860M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1860-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-VSEN-DF-ANIM-WIT         PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-VSEN-DF-ANIM.
            GOBACK.
        1000-EVALUATE-VSEN-DF-ANIM.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1856-8WAY-SLICE-OK = 1 AND
               WS-TH1857-SWARM-SYNC-OK = 1 AND
               WS-TH1858-8WAY-LATENCY-OK = 1 AND
               WS-TH1859-1860M-SAAT-OK = 1 AND
               WS-TH1860-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-VSEN-DF-ANIM-WIT
            ELSE
                MOVE 0 TO WS-VSEN-DF-ANIM-WIT.
