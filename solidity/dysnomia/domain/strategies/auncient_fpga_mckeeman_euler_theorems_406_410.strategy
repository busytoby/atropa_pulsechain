        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-EULER.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-EULER-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH406-MCKEEMAN-STEP-OK   PIC 9(01) VALUE 1.
            05  WS-TH407-EULER-LOG-OK       PIC 9(01) VALUE 1.
            05  WS-TH408-RICHARDSON-OK      PIC 9(01) VALUE 1.
            05  WS-TH409-QUADRATURE-SAAT-OK PIC 9(01) VALUE 1.
            05  WS-TH410-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-EULER-WIT           PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-EULER.
            GOBACK.
        1000-EVALUATE-EULER.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH406-MCKEEMAN-STEP-OK = 1 AND
               WS-TH407-EULER-LOG-OK = 1 AND
               WS-TH408-RICHARDSON-OK = 1 AND
               WS-TH409-QUADRATURE-SAAT-OK = 1 AND
               WS-TH410-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-EULER-WIT
            ELSE
                MOVE 0 TO WS-FPGA-EULER-WIT.
