        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-SDK-INTEROP.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-SDK-INTEROP-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1156-INTEROP-OK        PIC 9(01) VALUE 1.
            05  WS-TH1157-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1158-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1159-1160M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1160-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-SDK-INTEROP-WIT          PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-SDK-INTEROP.
            GOBACK.
        1000-EVALUATE-SDK-INTEROP.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1156-INTEROP-OK = 1 AND
               WS-TH1157-DATBIN-STRAT-OK = 1 AND
               WS-TH1158-SUBMICRO-LAT-OK = 1 AND
               WS-TH1159-1160M-SAAT-OK = 1 AND
               WS-TH1160-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-SDK-INTEROP-WIT
            ELSE
                MOVE 0 TO WS-SDK-INTEROP-WIT.
