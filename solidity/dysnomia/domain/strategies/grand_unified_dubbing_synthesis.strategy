        IDENTIFICATION DIVISION.
        PROGRAM-ID. GRAND-UNIFIED-DUBBING-STRATEGY.
        AUTHOR. AUNCIENT DYSNOMIA VM / GRAND UNIFIED DUBBING AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-GRAND-PARAMS.
           05 WS-MASTER-SPEAKER-ID      PIC 9(02) VALUE 01.
           05 WS-TARGET-DIALECT-ID      PIC 9(02) VALUE 01.
           05 WS-MODALITY-FLAG          PIC 9(01) VALUE 1.
           05 WS-RECEPTIVE-SPAN         PIC 9(02) VALUE 08.
           05 WS-SYLLABLE-DELTA         PIC S9(02) VALUE +2.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-GRAND-VITALITY         PIC 9(09) VALUE 0.
           05 WS-UNIFIED-COHERENCE      PIC 9(09) VALUE 0.
           05 WS-GRAND-REBAR-LATCH      PIC 9(12) VALUE 0.
           05 WS-SHADOW-GRAND-BASE      PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 INVALID-SPEAKER-ID          VALUE 2.
              88 INVALID-DIALECT-ID          VALUE 3.
              88 CROSS-ATTN-MASK-VIOLATION   VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 RECEPTIVE-SPAN-OUT-OF-BOUND VALUE 6.
              88 SYLLABLE-DELTA-OUT-OF-BOUND VALUE 7.
              88 GRAND-UNIV-DIVERG-FAIL      VALUE 8.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 9.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-GRAND-SYNTHESIS
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-MASTER-SPEAKER-ID < 1 OR WS-MASTER-SPEAKER-ID > 8
                SET INVALID-SPEAKER-ID TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-TARGET-DIALECT-ID < 1 OR WS-TARGET-DIALECT-ID > 6
                SET INVALID-DIALECT-ID TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-MODALITY-FLAG NOT EQUAL 1
                SET CROSS-ATTN-MASK-VIOLATION TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-RECEPTIVE-SPAN < 1 OR WS-RECEPTIVE-SPAN > 16
                SET RECEPTIVE-SPAN-OUT-OF-BOUND TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-SYLLABLE-DELTA < -1 OR WS-SYLLABLE-DELTA > 3
                SET SYLLABLE-DELTA-OUT-OF-BOUND TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-GRAND-SYNTHESIS.
            COMPUTE WS-GRAND-VITALITY = (WS-MASTER-SPEAKER-ID * 512) +
                                        (WS-TARGET-DIALECT-ID * 256) +
                                        (WS-MODALITY-FLAG * 128) +
                                        (WS-RECEPTIVE-SPAN * 16) +
                                        ((WS-SYLLABLE-DELTA + 2) * 64) + 1.

            IF WS-GRAND-VITALITY EQUAL ZERO
                SET GRAND-UNIV-DIVERG-FAIL TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-UNIFIED-COHERENCE = (WS-RECEPTIVE-SPAN * 32) +
                                           ((WS-SYLLABLE-DELTA + 2) * 16) +
                                           (WS-TARGET-DIALECT-ID * 64).

            COMPUTE WS-GRAND-REBAR-LATCH = 1470169088 + (WS-MASTER-SPEAKER-ID * 256) +
                                           (WS-TARGET-DIALECT-ID * 64) +
                                           (WS-MODALITY-FLAG * 16) +
                                           (WS-RECEPTIVE-SPAN * 8).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-GRAND-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                           (WS-GRAND-VITALITY * 10) +
                                           (WS-UNIFIED-COHERENCE * 10) +
                                           (WS-MASTER-SPEAKER-ID * 1000) +
                                           (WS-GRAND-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-GRAND-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-GRAND-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
