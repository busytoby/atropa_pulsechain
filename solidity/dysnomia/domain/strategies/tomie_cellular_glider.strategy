       IDENTIFICATION DIVISION.
       PROGRAM-ID. TOMIE-GLIDER-STRAT.
       AUTHOR. AUNCIENT DYSNOMIA VM / TOMIE GLIDER ISOMORPHISM.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-TOMIE-PARAMS.
          05 WS-INIT-FRAG-MASS         PIC 9(05) VALUE 15000.
          05 WS-SWARM-COUNT-M          PIC 9(02) VALUE 08.
          05 WS-REGEN-CYCLES-N         PIC 9(02) VALUE 16.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-CURRENT-MASS           PIC 9(05) VALUE 0.
          05 WS-STEP-IDX               PIC 9(02) VALUE 0.
          05 WS-SHADOW-TOMIE-BASE      PIC 9(12) VALUE 0.
          05 WS-CYC-MOD                PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-FRAG-MASS           VALUE 2.
             88 INVALID-SWARM-COUNT-M       VALUE 3.
             88 INVALID-REGEN-CYCLES-N      VALUE 4.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
             88 SWARM-PROLIFERATION-FAIL    VALUE 6.
             88 GATING-CLAMP-OVERFLOW       VALUE 7.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 8.
             88 CASCADE-ROLLBACK-FAIL       VALUE 9.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-TOMIE-REGENERATION
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-INIT-FRAG-MASS < 1 OR WS-INIT-FRAG-MASS > 50000
               SET INVALID-FRAG-MASS TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SWARM-COUNT-M < 1 OR WS-SWARM-COUNT-M > 16
               SET INVALID-SWARM-COUNT-M TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-REGEN-CYCLES-N < 1 OR WS-REGEN-CYCLES-N > 64
               SET INVALID-REGEN-CYCLES-N TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-TOMIE-REGENERATION.
           MOVE WS-INIT-FRAG-MASS TO WS-CURRENT-MASS.

           PERFORM VARYING WS-STEP-IDX FROM 1 BY 1 UNTIL WS-STEP-IDX > WS-REGEN-CYCLES-N
               COMPUTE WS-CURRENT-MASS = (WS-CURRENT-MASS * 875) / 1000
           END-PERFORM.

           IF WS-CURRENT-MASS > WS-INIT-FRAG-MASS
               SET SWARM-PROLIFERATION-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-SHADOW-TOMIE-BASE = (WS-CICS-WRITER-ID * 1000000) + 
               (WS-REGEN-CYCLES-N * 10000) + (WS-SWARM-COUNT-M * 100) + (WS-CURRENT-MASS / 16).

           COMPUTE WS-CYC-MOD = FUNCTION MOD(WS-SWARM-COUNT-M, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-CYC-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-TOMIE-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-TOMIE-BASE + ((WS-CURRENT-MASS * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-TOMIE-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-REGEN-CYCLES-N * 10000) + (WS-SWARM-COUNT-M * 100) + (WS-CURRENT-MASS / 16))
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-TOMIE-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
