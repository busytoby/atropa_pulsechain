        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-MU-DUAL-APEX.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-APEX-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1886-APEX-OK           PIC 9(01) VALUE 1.
            05  WS-TH1887-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1888-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1889-1890M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1890-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-APEX-WIT                 PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-APEX.
            GOBACK.
        1000-EVALUATE-APEX.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1886-APEX-OK = 1 AND
               WS-TH1887-DATBIN-STRAT-OK = 1 AND
               WS-TH1888-SUBMICRO-LAT-OK = 1 AND
               WS-TH1889-1890M-SAAT-OK = 1 AND
               WS-TH1890-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-APEX-WIT
            ELSE
                MOVE 0 TO WS-APEX-WIT.
