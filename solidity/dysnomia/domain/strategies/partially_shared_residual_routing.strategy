        IDENTIFICATION DIVISION.
        PROGRAM-ID. PSR-RES-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / PARTIALLY SHARED RESIDUAL ROUTING AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-PSR-PARAMS.
           05 WS-SHARED-WEIGHT-M        PIC 9(04) VALUE 0850.
           05 WS-ROUTED-WEIGHT-M        PIC 9(04) VALUE 0450.
           05 WS-CONVERGENCE-GAIN-PCT   PIC 9(02) VALUE 45.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-PSR-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-PSR-VITALITY           PIC 9(09) VALUE 0.
           05 WS-PSR-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-PSR-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-PSR-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 SHARED-EXPERT-WEIGHT-LOW    VALUE 2.
              88 ROUTED-EXPERT-WEIGHT-OUT    VALUE 3.
              88 CONVERGENCE-GAIN-LOW        VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 SHARED-RESIDUAL-COLLAPSE    VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-SHARED-RESIDUAL
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-SHARED-WEIGHT-M < 500 OR WS-SHARED-WEIGHT-M > 1000
                SET SHARED-EXPERT-WEIGHT-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-ROUTED-WEIGHT-M < 100 OR WS-ROUTED-WEIGHT-M > 800
                SET ROUTED-EXPERT-WEIGHT-OUT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CONVERGENCE-GAIN-PCT < 20 OR WS-CONVERGENCE-GAIN-PCT > 70
                SET CONVERGENCE-GAIN-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-SHARED-RESIDUAL.
            COMPUTE WS-PSR-COMPOSITE = (WS-SHARED-WEIGHT-M / 2) +
                                       (WS-ROUTED-WEIGHT-M / 2) +
                                       (WS-CONVERGENCE-GAIN-PCT * 5).

            COMPUTE WS-PSR-VITALITY = (WS-PSR-COMPOSITE / 4) +
                                      (WS-SHARED-WEIGHT-M / 4) +
                                      (WS-CONVERGENCE-GAIN-PCT * 2) + 1.

            IF WS-PSR-VITALITY EQUAL ZERO
                SET SHARED-RESIDUAL-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-PSR-COHERENCE = (WS-PSR-COMPOSITE / 16) +
                                       (WS-SHARED-WEIGHT-M / 16) +
                                       (WS-CONVERGENCE-GAIN-PCT / 2).

            COMPUTE WS-PSR-REBAR-LATCH = 1470169088 +
                                         (WS-PSR-COMPOSITE / 2) +
                                         (WS-CONVERGENCE-GAIN-PCT * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-PSR-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-PSR-VITALITY * 10) +
                                         (WS-PSR-COHERENCE * 10) +
                                         (WS-PSR-COMPOSITE * 10) +
                                         (WS-PSR-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-PSR-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-PSR-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
