        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-TWIN-CERT.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-TWIN-CERT-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH461-GLASS-BOX-OK       PIC 9(01) VALUE 1.
            05  WS-TH462-MERKLE-PROOF-OK    PIC 9(01) VALUE 1.
            05  WS-TH463-COHERENCE-OK       PIC 9(01) VALUE 1.
            05  WS-TH464-CERT-SAAT-OK       PIC 9(01) VALUE 1.
            05  WS-TH465-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-TWIN-CERT-WIT       PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-TWIN-CERT.
            GOBACK.
        1000-EVALUATE-TWIN-CERT.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH461-GLASS-BOX-OK = 1 AND
               WS-TH462-MERKLE-PROOF-OK = 1 AND
               WS-TH463-COHERENCE-OK = 1 AND
               WS-TH464-CERT-SAAT-OK = 1 AND
               WS-TH465-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-TWIN-CERT-WIT
            ELSE
                MOVE 0 TO WS-FPGA-TWIN-CERT-WIT.
