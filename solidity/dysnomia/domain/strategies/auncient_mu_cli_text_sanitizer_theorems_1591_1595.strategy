        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-CLI-TEXT.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-CLI-TEXT-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1591-TEXT-OK           PIC 9(01) VALUE 1.
            05  WS-TH1592-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1593-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1594-1595M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1595-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-CLI-TEXT-WIT             PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-CLI-TEXT.
            GOBACK.
        1000-EVALUATE-CLI-TEXT.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1591-TEXT-OK = 1 AND
               WS-TH1592-DATBIN-STRAT-OK = 1 AND
               WS-TH1593-SUBMICRO-LAT-OK = 1 AND
               WS-TH1594-1595M-SAAT-OK = 1 AND
               WS-TH1595-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-CLI-TEXT-WIT
            ELSE
                MOVE 0 TO WS-CLI-TEXT-WIT.
