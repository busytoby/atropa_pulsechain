        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-SOC-LIMITS-176-180.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-SOC-LIMITS-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH176-TPA-LIMIT-OK       PIC 9(01) VALUE 1.
            05  WS-TH177-EDSAC-LIMIT-OK     PIC 9(01) VALUE 1.
            05  WS-TH178-LATENCY-LIMIT-OK   PIC 9(01) VALUE 1.
            05  WS-TH179-THERMAL-LIMIT-OK   PIC 9(01) VALUE 1.
            05  WS-TH180-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-SOC-LIMITS-WITNESS       PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-SOC-LIMITS.
            GOBACK.
        1000-EVALUATE-SOC-LIMITS.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH176-TPA-LIMIT-OK = 1 AND
               WS-TH177-EDSAC-LIMIT-OK = 1 AND
               WS-TH178-LATENCY-LIMIT-OK = 1 AND
               WS-TH179-THERMAL-LIMIT-OK = 1 AND
               WS-TH180-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-SOC-LIMITS-WITNESS
            ELSE
                MOVE 0 TO WS-SOC-LIMITS-WITNESS.
