        IDENTIFICATION DIVISION.
        PROGRAM-ID. USD-STAGE-AUDIO-EXPORTER-STRATEGY.
        AUTHOR. AUNCIENT DYSNOMIA VM / USD STAGE AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-EXPORTER-PARAMS.
           05 WS-AGENT-COUNT            PIC 9(02) VALUE 08.
           05 WS-POINTS-PER-CURVE       PIC 9(04) VALUE 0256.
           05 WS-STAGE-DURATION-SEC     PIC 9(03) VALUE 015.
           05 WS-SAMPLE-RATE            PIC 9(05) VALUE 44100.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-TOPOLOGY-METRIC        PIC 9(09) VALUE 0.
           05 WS-TANGENT-VECTOR         PIC 9(09) VALUE 0.
           05 WS-USD-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-USD-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 INVALID-AGENT-COUNT         VALUE 2.
              88 INVALID-POINTS-PER-CURVE    VALUE 3.
              88 INVALID-DURATION-SEC        VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 INVALID-SAMPLE-RATE         VALUE 6.
              88 USD-SYNC-DIVERG-FAIL        VALUE 7.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 8.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-USD-EXPORTER
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-AGENT-COUNT < 1 OR WS-AGENT-COUNT > 64
                SET INVALID-AGENT-COUNT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-POINTS-PER-CURVE < 4 OR WS-POINTS-PER-CURVE > 1024
                SET INVALID-POINTS-PER-CURVE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-STAGE-DURATION-SEC < 1 OR WS-STAGE-DURATION-SEC > 300
                SET INVALID-DURATION-SEC TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-SAMPLE-RATE NOT EQUAL 44100 AND WS-SAMPLE-RATE NOT EQUAL 48000
                SET INVALID-SAMPLE-RATE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-USD-EXPORTER.
            COMPUTE WS-TOPOLOGY-METRIC = (WS-AGENT-COUNT * 1024) +
                                         (WS-POINTS-PER-CURVE * 16) +
                                         (WS-STAGE-DURATION-SEC * 64) + 1.

            IF WS-TOPOLOGY-METRIC EQUAL ZERO
                SET USD-SYNC-DIVERG-FAIL TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-TANGENT-VECTOR = ((WS-POINTS-PER-CURVE * 875) / 1000) +
                                        (WS-AGENT-COUNT * 32).

            COMPUTE WS-USD-REBAR-LATCH = 1470169088 + (WS-AGENT-COUNT * 256) +
                                         (WS-POINTS-PER-CURVE * 64) +
                                         (WS-STAGE-DURATION-SEC * 2).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-USD-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-TOPOLOGY-METRIC * 10) +
                                         (WS-TANGENT-VECTOR * 10) +
                                         (WS-AGENT-COUNT * 1000) +
                                         (WS-USD-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-USD-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-USD-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
