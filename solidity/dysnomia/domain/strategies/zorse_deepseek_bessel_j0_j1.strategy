       IDENTIFICATION DIVISION.
       PROGRAM-ID. ZORSE-DEEPSEEK-BESSEL-STRATEGY.
       AUTHOR. AUNCIENT DYSNOMIA VM / ZORSE DEEPSEEK-CODER AUDIT.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-ZORSE-PARAMETERS.
          05 WS-TASK-ID                PIC 9(02) VALUE 07.
          05 WS-TOKEN-POS-X            PIC 9(05) VALUE 00128.
          05 WS-TOKEN-POS-Y            PIC 9(05) VALUE 00064.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-RADIAL-DIST-Q16        PIC 9(06) VALUE 0.
          05 WS-J0-RADIAL              PIC 9(09) VALUE 0.
          05 WS-J1-RADIAL              PIC 9(09) VALUE 0.
          05 WS-WAVE-PACKET            PIC 9(09) VALUE 0.
          05 WS-SHADOW-CONTEXT         PIC 9(12) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-TASK-ID             VALUE 2.
             88 INVALID-TOKEN-POS           VALUE 3.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 4.
             88 GATING-CLAMP-OVERFLOW       VALUE 5.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 6.
             88 CASCADE-ROLLBACK-FAIL       VALUE 7.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-ZORSE-SYNTHESIS
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-TASK-ID < 1 OR WS-TASK-ID > 8
               SET INVALID-TASK-ID TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-TOKEN-POS-X > 2048 OR WS-TOKEN-POS-Y > 2048
               SET INVALID-TOKEN-POS TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-ZORSE-SYNTHESIS.
           COMPUTE WS-RADIAL-DIST-Q16 = (WS-TOKEN-POS-X + WS-TOKEN-POS-Y) * 16.
           IF WS-RADIAL-DIST-Q16 > 65536
               MOVE 65536 TO WS-RADIAL-DIST-Q16
           END-IF.

           COMPUTE WS-J0-RADIAL = 65536 - ((WS-RADIAL-DIST-Q16 * WS-RADIAL-DIST-Q16) / 262144).
           COMPUTE WS-J1-RADIAL = (WS-RADIAL-DIST-Q16 / 2) - ((WS-RADIAL-DIST-Q16 * WS-RADIAL-DIST-Q16 * WS-RADIAL-DIST-Q16) / 1048576).
           COMPUTE WS-WAVE-PACKET = WS-J0-RADIAL + (WS-J1-RADIAL / 4).

           COMPUTE WS-SHADOW-CONTEXT = (WS-CICS-WRITER-ID * 10000) + (WS-TASK-ID * 1000) + (WS-TOKEN-POS-X + WS-TOKEN-POS-Y).

           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-TASK-ID) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-CONTEXT TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = (((WS-SHADOW-CONTEXT + (WS-WAVE-PACKET / 16)) * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-CONTEXT NOT EQUAL ((WS-CICS-WRITER-ID * 10000) + (WS-TASK-ID * 1000) + (WS-TOKEN-POS-X + WS-TOKEN-POS-Y))
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-CONTEXT
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
