       IDENTIFICATION DIVISION.
       PROGRAM-ID. LYAPUNOV-SPHEROID-ALU.
       AUTHOR. AUNCIENT DYSNOMIA VM / 1895 SPHEROID ALU.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-ALU-PARAMS.
          05 WS-ANGULAR-MOMENTUM-L0    PIC 9(05) VALUE 20000.
          05 WS-ECCENTRICITY-PERMILLE  PIC 9(03) VALUE 450.
          05 WS-ALU-CYCLES-N           PIC 9(02) VALUE 16.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-CURRENT-ALU-E          PIC 9(05) VALUE 0.
          05 WS-STEP-IDX               PIC 9(02) VALUE 0.
          05 WS-ECC-MOD                PIC 9(03) VALUE 0.
          05 WS-SHADOW-ALU-BASE        PIC 9(12) VALUE 0.
          05 WS-CYC-MOD                PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-ANGULAR-MOMENTUM    VALUE 2.
             88 INVALID-ECCENTRICITY        VALUE 3.
             88 INVALID-ALU-CYCLES          VALUE 4.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
             88 ALU-CENTRIFUGAL-DIVERG-FAIL VALUE 6.
             88 GATING-CLAMP-OVERFLOW       VALUE 7.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 8.
             88 CASCADE-ROLLBACK-FAIL       VALUE 9.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-SPHEROID-ALU-LOOP
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-ANGULAR-MOMENTUM-L0 > 50000
               SET INVALID-ANGULAR-MOMENTUM TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-ECCENTRICITY-PERMILLE > 999
               SET INVALID-ECCENTRICITY TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-ALU-CYCLES-N < 1 OR WS-ALU-CYCLES-N > 64
               SET INVALID-ALU-CYCLES TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-SPHEROID-ALU-LOOP.
           MOVE WS-ANGULAR-MOMENTUM-L0 TO WS-CURRENT-ALU-E.

           PERFORM VARYING WS-STEP-IDX FROM 1 BY 1 UNTIL WS-STEP-IDX > WS-ALU-CYCLES-N
               COMPUTE WS-CURRENT-ALU-E = (WS-CURRENT-ALU-E * 875) / 1000
           END-PERFORM.

           IF WS-CURRENT-ALU-E > WS-ANGULAR-MOMENTUM-L0
               SET ALU-CENTRIFUGAL-DIVERG-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-ECC-MOD = FUNCTION MOD(WS-ECCENTRICITY-PERMILLE, 100).

           COMPUTE WS-SHADOW-ALU-BASE = (WS-CICS-WRITER-ID * 1000000) + 
               (WS-ALU-CYCLES-N * 10000) + (WS-ECC-MOD * 10) + (WS-CURRENT-ALU-E / 16).

           COMPUTE WS-CYC-MOD = FUNCTION MOD(WS-ECCENTRICITY-PERMILLE, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-CYC-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-ALU-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-ALU-BASE + ((WS-CURRENT-ALU-E * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-ALU-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-ALU-CYCLES-N * 10000) + (WS-ECC-MOD * 10) + (WS-CURRENT-ALU-E / 16))
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-ALU-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
