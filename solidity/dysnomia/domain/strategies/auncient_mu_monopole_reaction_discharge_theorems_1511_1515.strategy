        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-MONO-REACT.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-MONO-REACT-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1511-REACT-OK          PIC 9(01) VALUE 1.
            05  WS-TH1512-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1513-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1514-1515M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1515-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-MONO-REACT-WIT           PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-MONO-REACT.
            GOBACK.
        1000-EVALUATE-MONO-REACT.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1511-REACT-OK = 1 AND
               WS-TH1512-DATBIN-STRAT-OK = 1 AND
               WS-TH1513-SUBMICRO-LAT-OK = 1 AND
               WS-TH1514-1515M-SAAT-OK = 1 AND
               WS-TH1515-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-MONO-REACT-WIT
            ELSE
                MOVE 0 TO WS-MONO-REACT-WIT.
