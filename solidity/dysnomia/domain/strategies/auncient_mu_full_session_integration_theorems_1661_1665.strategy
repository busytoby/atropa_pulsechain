        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FULL-SESS.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FULL-SESS-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1661-FULL-SESS-OK      PIC 9(01) VALUE 1.
            05  WS-TH1662-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1663-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1664-1665M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1665-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-FULL-SESS-WIT            PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-FULL-SESS.
            GOBACK.
        1000-EVALUATE-FULL-SESS.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1661-FULL-SESS-OK = 1 AND
               WS-TH1662-DATBIN-STRAT-OK = 1 AND
               WS-TH1663-SUBMICRO-LAT-OK = 1 AND
               WS-TH1664-1665M-SAAT-OK = 1 AND
               WS-TH1665-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-FULL-SESS-WIT
            ELSE
                MOVE 0 TO WS-FULL-SESS-WIT.
