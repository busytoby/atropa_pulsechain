        IDENTIFICATION DIVISION.
        PROGRAM-ID. CHS-SDF-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / CONVEX HULL SDF BOUNDS AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-CHS-PARAMS.
           05 WS-SDF-LAT-MS             PIC 9(02) VALUE 12.
           05 WS-HULL-PRECISION-M       PIC 9(04) VALUE 0960.
           05 WS-PENETRATION-M          PIC 9(02) VALUE 01.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-CHS-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-CHS-VITALITY           PIC 9(09) VALUE 0.
           05 WS-CHS-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-CHS-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-CHS-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 SDF-LAT-OUT-OF-BOUNDS       VALUE 2.
              88 HULL-PRECISION-LOW          VALUE 3.
              88 PENETRATION-EXCEEDED        VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 COLLISION-COLLAPSE          VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-SDF-BOUNDS
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-SDF-LAT-MS < 5 OR WS-SDF-LAT-MS > 25
                SET SDF-LAT-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-HULL-PRECISION-M < 850 OR WS-HULL-PRECISION-M > 1000
                SET HULL-PRECISION-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-PENETRATION-M < 0 OR WS-PENETRATION-M > 5
                SET PENETRATION-EXCEEDED TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-SDF-BOUNDS.
            COMPUTE WS-CHS-COMPOSITE = ((30 - WS-SDF-LAT-MS) * 20) +
                                       (WS-HULL-PRECISION-M / 2) +
                                       ((10 - WS-PENETRATION-M) * 40).

            COMPUTE WS-CHS-VITALITY = (WS-CHS-COMPOSITE / 4) +
                                      (WS-HULL-PRECISION-M / 4) +
                                      ((30 - WS-SDF-LAT-MS) * 4) + 1.

            IF WS-CHS-VITALITY EQUAL ZERO
                SET COLLISION-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-CHS-COHERENCE = (WS-CHS-COMPOSITE / 16) +
                                       (WS-HULL-PRECISION-M / 16) +
                                       ((30 - WS-SDF-LAT-MS) * 2).

            COMPUTE WS-CHS-REBAR-LATCH = 1470169088 +
                                         (WS-CHS-COMPOSITE / 2) +
                                         ((30 - WS-SDF-LAT-MS) * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-CHS-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-CHS-VITALITY * 10) +
                                         (WS-CHS-COHERENCE * 10) +
                                         (WS-CHS-COMPOSITE * 10) +
                                         (WS-CHS-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-CHS-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-CHS-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
