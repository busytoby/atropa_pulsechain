       IDENTIFICATION DIVISION.
       PROGRAM-ID. SKELETON-CICS-TERMINAL-STRATEGY.
       AUTHOR. AUNCIENT DYSNOMIA VM / SKELETON CICS TOTIENT AUDIT.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-CICS-TERMINAL-PARAMS.
          05 WS-CICS-TRANS-ID          PIC 9(02) VALUE 03.
          05 WS-SKELETON-JOINT-ID      PIC 9(05) VALUE 00128.
          05 WS-TOTIENT-INITIAL-MU0    PIC 9(12) VALUE 0001000000.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-ABEND         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-SHADOW-TOTIENT-BASE    PIC 9(12) VALUE 0.
          05 WS-JOINT-MOD              PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-TERMINAL-DELTA         PIC 9(09) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-TRANS-ID            VALUE 2.
             88 INVALID-JOINT-ID            VALUE 3.
             88 INVALID-INITIAL-TOTIENT     VALUE 4.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
             88 GATING-CLAMP-OVERFLOW       VALUE 6.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 7.
             88 CASCADE-ROLLBACK-FAIL       VALUE 8.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-CICS-TRANSACTION
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-TRANS-ID < 1 OR WS-CICS-TRANS-ID > 4
               SET INVALID-TRANS-ID TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SKELETON-JOINT-ID > 9999
               SET INVALID-JOINT-ID TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-TOTIENT-INITIAL-MU0 EQUAL ZERO
               SET INVALID-INITIAL-TOTIENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-CICS-TRANSACTION.
           COMPUTE WS-SHADOW-TOTIENT-BASE = (WS-CICS-WRITER-ID * 1000000) + (WS-CICS-TRANS-ID * 10000) + WS-TOTIENT-INITIAL-MU0.

           COMPUTE WS-JOINT-MOD = FUNCTION MOD(WS-SKELETON-JOINT-ID, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-JOINT-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-TERMINAL-DELTA = WS-CICS-TRANS-ID * 5000.

           IF WS-SIMULATE-ABEND EQUAL 'Y'
               MOVE WS-SHADOW-TOTIENT-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = (((WS-SHADOW-TOTIENT-BASE + WS-TERMINAL-DELTA) * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-TOTIENT-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-CICS-TRANS-ID * 10000) + WS-TOTIENT-INITIAL-MU0)
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-ABEND EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-TOTIENT-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
