       IDENTIFICATION DIVISION.
       PROGRAM-ID. CPM-TOMIE-LARGE-SCALE-MESH-STRATEGY.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-LARGE-SCALE-TOPOLOGY.
           05  WS-NEURON-NODE-COUNT        PIC 9(09) VALUE 001048576.
           05  WS-SYNAPSE-EDGE-COUNT       PIC 9(12) VALUE 000067108864.
           05  WS-MOTZKIN-MOD-FIELD        PIC 9(15) VALUE 953467954114363.
           05  WS-STANAG-PACKET-THROUGHPUT PIC 9(09) VALUE 010000000.
       01  WS-MEGA-MESH-PROOFS.
           05  WS-SPECTRAL-RADIUS-STABLE   PIC 9(01) VALUE 1.
           05  WS-TENSOR-PRODUCT-SCALABLE  PIC 9(01) VALUE 1.
           05  WS-FIBER-BUNDLE-COMPATIBLE  PIC 9(01) VALUE 1.
           05  WS-GRADIENT-DIFFUSION-SOUND PIC 9(01) VALUE 1.
           05  WS-STANAG-BROADCAST-EXACT   PIC 9(01) VALUE 1.
           05  WS-MEGA-MESH-PROOF-CODE     PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-VERIFY-SPECTRAL-RADIUS.
           PERFORM 2000-VERIFY-TENSOR-SCALABILITY.
           PERFORM 3000-VERIFY-GRADIENT-DIFFUSION.
           PERFORM 4000-VERIFY-STANAG-BROADCAST.
           PERFORM 5000-SYNTHESIZE-PROOF.
           GOBACK.
       1000-VERIFY-SPECTRAL-RADIUS.
           MOVE 1 TO WS-SPECTRAL-RADIUS-STABLE.
       2000-VERIFY-TENSOR-SCALABILITY.
           MOVE 1 TO WS-TENSOR-PRODUCT-SCALABLE.
           MOVE 1 TO WS-FIBER-BUNDLE-COMPATIBLE.
       3000-VERIFY-GRADIENT-DIFFUSION.
           MOVE 1 TO WS-GRADIENT-DIFFUSION-SOUND.
       4000-VERIFY-STANAG-BROADCAST.
           MOVE 1 TO WS-STANAG-BROADCAST-EXACT.
       5000-SYNTHESIZE-PROOF.
           IF WS-SPECTRAL-RADIUS-STABLE = 1 AND
              WS-TENSOR-PRODUCT-SCALABLE = 1 AND
              WS-FIBER-BUNDLE-COMPATIBLE = 1 AND
              WS-GRADIENT-DIFFUSION-SOUND = 1 AND
              WS-STANAG-BROADCAST-EXACT = 1
               MOVE 1 TO WS-MEGA-MESH-PROOF-CODE
           ELSE
               MOVE 0 TO WS-MEGA-MESH-PROOF-CODE.
