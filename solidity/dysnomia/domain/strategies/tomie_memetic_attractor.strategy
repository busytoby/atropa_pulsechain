       IDENTIFICATION DIVISION.
       PROGRAM-ID. TOMIE-MEM-STRAT.
       AUTHOR. AUNCIENT DYSNOMIA VM / TOMIE MEMETIC ATTRACTOR.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-MEM-PARAMS.
          05 WS-INIT-MEM-DEV           PIC 9(05) VALUE 16000.
          05 WS-OBSERVER-COUNT-K       PIC 9(02) VALUE 08.
          05 WS-ATTRACT-CYCLES-N       PIC 9(02) VALUE 16.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-CURRENT-DEV            PIC 9(05) VALUE 0.
          05 WS-STEP-IDX               PIC 9(02) VALUE 0.
          05 WS-SHADOW-MEM-BASE        PIC 9(12) VALUE 0.
          05 WS-CYC-MOD                PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-MEMETIC-DEV         VALUE 2.
             88 INVALID-OBSERVER-COUNT-K    VALUE 3.
             88 INVALID-ATTRACT-CYCLES-N    VALUE 4.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
             88 MEMETIC-DEV-DIVERG-FAIL     VALUE 6.
             88 GATING-CLAMP-OVERFLOW       VALUE 7.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 8.
             88 CASCADE-ROLLBACK-FAIL       VALUE 9.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-MEMETIC-ATTRACTION
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-INIT-MEM-DEV > 50000
               SET INVALID-MEMETIC-DEV TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-OBSERVER-COUNT-K < 1 OR WS-OBSERVER-COUNT-K > 16
               SET INVALID-OBSERVER-COUNT-K TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-ATTRACT-CYCLES-N < 1 OR WS-ATTRACT-CYCLES-N > 64
               SET INVALID-ATTRACT-CYCLES-N TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-MEMETIC-ATTRACTION.
           MOVE WS-INIT-MEM-DEV TO WS-CURRENT-DEV.

           PERFORM VARYING WS-STEP-IDX FROM 1 BY 1 UNTIL WS-STEP-IDX > WS-ATTRACT-CYCLES-N
               COMPUTE WS-CURRENT-DEV = (WS-CURRENT-DEV * 875) / 1000
           END-PERFORM.

           IF WS-CURRENT-DEV > WS-INIT-MEM-DEV
               SET MEMETIC-DEV-DIVERG-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-SHADOW-MEM-BASE = (WS-CICS-WRITER-ID * 1000000) + 
               (WS-ATTRACT-CYCLES-N * 10000) + (WS-OBSERVER-COUNT-K * 100) + (WS-CURRENT-DEV / 16).

           COMPUTE WS-CYC-MOD = FUNCTION MOD(WS-OBSERVER-COUNT-K, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-CYC-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-MEM-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-MEM-BASE + ((WS-CURRENT-DEV * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-MEM-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-ATTRACT-CYCLES-N * 10000) + (WS-OBSERVER-COUNT-K * 100) + (WS-CURRENT-DEV / 16))
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-MEM-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
