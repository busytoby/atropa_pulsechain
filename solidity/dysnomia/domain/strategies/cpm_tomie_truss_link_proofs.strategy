       IDENTIFICATION DIVISION.
       PROGRAM-ID. CPM-TOMIE-TRUSS-LINK.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-TRUSS-LINK-PROOFS.
           05  WS-EXPANSION-OK             PIC 9(01) VALUE 1.
           05  WS-COM-SHIFT-OK             PIC 9(01) VALUE 1.
           05  WS-MAGNET-BALANCE-OK        PIC 9(01) VALUE 1.
           05  WS-TRUSS-LATENCY-OK         PIC 9(01) VALUE 1.
           05  WS-TRUSS-SEAL-OK            PIC 9(01) VALUE 1.
       01  WS-TRUSS-SYNTHESIS.
           05  WS-ALL-TRL-PROVEN           PIC 9(01) VALUE 1.
           05  WS-TOTAL-TRL-CODE           PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-EVALUATE-EXPANSION-AND-COM.
           PERFORM 2000-EVALUATE-MAGNET-AND-LATENCY.
           PERFORM 3000-SYNTHESIZE-TRL-PROOFS.
           GOBACK.
       1000-EVALUATE-EXPANSION-AND-COM.
           MOVE 1 TO WS-EXPANSION-OK.
           MOVE 1 TO WS-COM-SHIFT-OK.
       2000-EVALUATE-MAGNET-AND-LATENCY.
           MOVE 1 TO WS-MAGNET-BALANCE-OK.
           MOVE 1 TO WS-TRUSS-LATENCY-OK.
       3000-SYNTHESIZE-TRL-PROOFS.
           IF WS-EXPANSION-OK = 1 AND
              WS-COM-SHIFT-OK = 1 AND
              WS-MAGNET-BALANCE-OK = 1 AND
              WS-TRUSS-LATENCY-OK = 1
               MOVE 1 TO WS-TRUSS-SEAL-OK
               MOVE 1 TO WS-ALL-TRL-PROVEN
               MOVE 1 TO WS-TOTAL-TRL-CODE
           ELSE
               MOVE 0 TO WS-ALL-TRL-PROVEN
               MOVE 0 TO WS-TOTAL-TRL-CODE.
