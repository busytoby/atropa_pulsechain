        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-STANAG-DTN-141-145.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-STANAG-DTN-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH141-ASYMPT-LIVE-OK     PIC 9(01) VALUE 1.
            05  WS-TH142-SREJ-BOUND-OK      PIC 9(01) VALUE 1.
            05  WS-TH143-CLOCK-DRIFT-OK     PIC 9(01) VALUE 1.
            05  WS-TH144-CONVERGE-OK        PIC 9(01) VALUE 1.
            05  WS-TH145-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-STANAG-DTN-WITNESS       PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-STANAG-DTN.
            GOBACK.
        1000-EVALUATE-STANAG-DTN.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH141-ASYMPT-LIVE-OK = 1 AND
               WS-TH142-SREJ-BOUND-OK = 1 AND
               WS-TH143-CLOCK-DRIFT-OK = 1 AND
               WS-TH144-CONVERGE-OK = 1 AND
               WS-TH145-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-STANAG-DTN-WITNESS
            ELSE
                MOVE 0 TO WS-STANAG-DTN-WITNESS.
