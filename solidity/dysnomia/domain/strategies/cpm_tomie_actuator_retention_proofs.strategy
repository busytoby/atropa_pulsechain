       IDENTIFICATION DIVISION.
       PROGRAM-ID. CPM-TOMIE-ACTUATOR-RET.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-ACTUATOR-RET-PROOFS.
           05  WS-SERVO-SYNC-OK            PIC 9(01) VALUE 1.
           05  WS-RETENTION-OK             PIC 9(01) VALUE 1.
           05  WS-ENERGY-BALANCE-OK        PIC 9(01) VALUE 1.
           05  WS-ACTUATOR-LATENCY-OK      PIC 9(01) VALUE 1.
           05  WS-ACTUATOR-SEAL-OK         PIC 9(01) VALUE 1.
       01  WS-ACTUATOR-SYNTHESIS.
           05  WS-ALL-PAR-PROVEN           PIC 9(01) VALUE 1.
           05  WS-TOTAL-PAR-CODE           PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-EVALUATE-SYNC-AND-RETENTION.
           PERFORM 2000-EVALUATE-ENERGY-AND-LATENCY.
           PERFORM 3000-SYNTHESIZE-PAR-PROOFS.
           GOBACK.
       1000-EVALUATE-SYNC-AND-RETENTION.
           MOVE 1 TO WS-SERVO-SYNC-OK.
           MOVE 1 TO WS-RETENTION-OK.
       2000-EVALUATE-ENERGY-AND-LATENCY.
           MOVE 1 TO WS-ENERGY-BALANCE-OK.
           MOVE 1 TO WS-ACTUATOR-LATENCY-OK.
       3000-SYNTHESIZE-PAR-PROOFS.
           IF WS-SERVO-SYNC-OK = 1 AND
              WS-RETENTION-OK = 1 AND
              WS-ENERGY-BALANCE-OK = 1 AND
              WS-ACTUATOR-LATENCY-OK = 1
               MOVE 1 TO WS-ACTUATOR-SEAL-OK
               MOVE 1 TO WS-ALL-PAR-PROVEN
               MOVE 1 TO WS-TOTAL-PAR-CODE
           ELSE
               MOVE 0 TO WS-ALL-PAR-PROVEN
               MOVE 0 TO WS-TOTAL-PAR-CODE.
