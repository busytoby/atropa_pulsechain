        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-DEEPSEEK.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-DEEPSEEK-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1066-DEEPSEEK-OK       PIC 9(01) VALUE 1.
            05  WS-TH1067-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1068-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1069-1070M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1070-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-FPGA-DEEPSEEK-WIT        PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-FPGA-DEEPSEEK.
            GOBACK.
        1000-EVALUATE-FPGA-DEEPSEEK.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1066-DEEPSEEK-OK = 1 AND
               WS-TH1067-DATBIN-STRAT-OK = 1 AND
               WS-TH1068-SUBMICRO-LAT-OK = 1 AND
               WS-TH1069-1070M-SAAT-OK = 1 AND
               WS-TH1070-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-FPGA-DEEPSEEK-WIT
            ELSE
                MOVE 0 TO WS-FPGA-DEEPSEEK-WIT.
