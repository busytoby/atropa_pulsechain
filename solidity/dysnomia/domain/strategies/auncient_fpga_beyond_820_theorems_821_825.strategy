        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-BEYOND-820.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-BEYOND-820-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH821-SOVEREIGN-COPROC-OK PIC 9(01) VALUE 1.
            05  WS-TH822-MERKLE-825-OK      PIC 9(01) VALUE 1.
            05  WS-TH823-SOV-INTER-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH824-825M-SAAT-OK       PIC 9(01) VALUE 1.
            05  WS-TH825-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-BEYOND-820-WIT      PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-BEYOND-820.
            GOBACK.
        1000-EVALUATE-BEYOND-820.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH821-SOVEREIGN-COPROC-OK = 1 AND
               WS-TH822-MERKLE-825-OK = 1 AND
               WS-TH823-SOV-INTER-LAT-OK = 1 AND
               WS-TH824-825M-SAAT-OK = 1 AND
               WS-TH825-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-BEYOND-820-WIT
            ELSE
                MOVE 0 TO WS-FPGA-BEYOND-820-WIT.
