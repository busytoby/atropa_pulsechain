        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-SDK-MIMETIC.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-SDK-MIMETIC-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1176-MIMETIC-OK        PIC 9(01) VALUE 1.
            05  WS-TH1177-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1178-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1179-1180M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1180-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-SDK-MIMETIC-WIT          PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-SDK-MIMETIC.
            GOBACK.
        1000-EVALUATE-SDK-MIMETIC.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1176-MIMETIC-OK = 1 AND
               WS-TH1177-DATBIN-STRAT-OK = 1 AND
               WS-TH1178-SUBMICRO-LAT-OK = 1 AND
               WS-TH1179-1180M-SAAT-OK = 1 AND
               WS-TH1180-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-SDK-MIMETIC-WIT
            ELSE
                MOVE 0 TO WS-SDK-MIMETIC-WIT.
