        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-CPM-POLYPHASE-EXEC.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-CPM-POLY-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-PHASE-A-COMPILE-OK       PIC 9(01) VALUE 1.
            05  WS-PHASE-B-RELOC-OK         PIC 9(01) VALUE 1.
            05  WS-PHASE-C-EXEC-OK          PIC 9(01) VALUE 1.
            05  WS-DISPLACE-SYNC-OK         PIC 9(01) VALUE 1.
            05  WS-PARITY-CLOSURE-OK        PIC 9(01) VALUE 1.
            05  WS-CPM-POLY-WITNESS         PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-CPM-POLY.
            GOBACK.
        1000-EVALUATE-CPM-POLY.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-PHASE-A-COMPILE-OK = 1 AND
               WS-PHASE-B-RELOC-OK = 1 AND
               WS-PHASE-C-EXEC-OK = 1 AND
               WS-DISPLACE-SYNC-OK = 1 AND
               WS-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-CPM-POLY-WITNESS
            ELSE
                MOVE 0 TO WS-CPM-POLY-WITNESS.
