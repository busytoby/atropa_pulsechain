       IDENTIFICATION DIVISION.
       PROGRAM-ID. CPM-TOMIE-GERCH-MON.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-GERCH-MON-PROOFS.
           05  WS-CONTRACTION-OK           PIC 9(01) VALUE 1.
           05  WS-ENERGY-CONSERVE-OK       PIC 9(01) VALUE 1.
           05  WS-MORTON-CLOSURE-OK        PIC 9(01) VALUE 1.
           05  WS-GERCH-LATENCY-OK         PIC 9(01) VALUE 1.
           05  WS-GERCH-SEAL-OK            PIC 9(01) VALUE 1.
       01  WS-GERCH-MON-SYNTHESIS.
           05  WS-ALL-PGM-PROVEN           PIC 9(01) VALUE 1.
           05  WS-TOTAL-PGM-CODE           PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-EVALUATE-CONTRACTION-AND-ENERGY.
           PERFORM 2000-EVALUATE-MORTON-AND-LAT.
           PERFORM 3000-SYNTHESIZE-PGM-PROOFS.
           GOBACK.
       1000-EVALUATE-CONTRACTION-AND-ENERGY.
           MOVE 1 TO WS-CONTRACTION-OK.
           MOVE 1 TO WS-ENERGY-CONSERVE-OK.
       2000-EVALUATE-MORTON-AND-LAT.
           MOVE 1 TO WS-MORTON-CLOSURE-OK.
           MOVE 1 TO WS-GERCH-LATENCY-OK.
       3000-SYNTHESIZE-PGM-PROOFS.
           IF WS-CONTRACTION-OK = 1 AND
              WS-ENERGY-CONSERVE-OK = 1 AND
              WS-MORTON-CLOSURE-OK = 1 AND
              WS-GERCH-LATENCY-OK = 1
               MOVE 1 TO WS-GERCH-SEAL-OK
               MOVE 1 TO WS-ALL-PGM-PROVEN
               MOVE 1 TO WS-TOTAL-PGM-CODE
           ELSE
               MOVE 0 TO WS-ALL-PGM-PROVEN
               MOVE 0 TO WS-TOTAL-PGM-CODE.
