        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-BEYOND-555.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-BEYOND-555-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH556-LORENTZ-ALGOL-OK   PIC 9(01) VALUE 1.
            05  WS-TH557-WEYL-COBOL-OK      PIC 9(01) VALUE 1.
            05  WS-TH558-PURITY-OK          PIC 9(01) VALUE 1.
            05  WS-TH559-DECOUPLED-SAAT-OK  PIC 9(01) VALUE 1.
            05  WS-TH560-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-BEYOND-555-WIT      PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-BEYOND-555.
            GOBACK.
        1000-EVALUATE-BEYOND-555.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH556-LORENTZ-ALGOL-OK = 1 AND
               WS-TH557-WEYL-COBOL-OK = 1 AND
               WS-TH558-PURITY-OK = 1 AND
               WS-TH559-DECOUPLED-SAAT-OK = 1 AND
               WS-TH560-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-BEYOND-555-WIT
            ELSE
                MOVE 0 TO WS-FPGA-BEYOND-555-WIT.
