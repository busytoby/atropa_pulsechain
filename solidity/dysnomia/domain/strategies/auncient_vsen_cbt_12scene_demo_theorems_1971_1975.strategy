        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-VSEN-CBT12SC.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-VSEN-CBT12SC-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1971-CBT-AV-OK         PIC 9(01) VALUE 1.
            05  WS-TH1972-CBT-BIO-OK        PIC 9(01) VALUE 1.
            05  WS-TH1973-CBT-MUX-LAT-OK    PIC 9(01) VALUE 1.
            05  WS-TH1974-1975M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1975-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-VSEN-CBT12SC-WIT         PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-VSEN-CBT12SC.
            GOBACK.
        1000-EVALUATE-VSEN-CBT12SC.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1971-CBT-AV-OK = 1 AND
               WS-TH1972-CBT-BIO-OK = 1 AND
               WS-TH1973-CBT-MUX-LAT-OK = 1 AND
               WS-TH1974-1975M-SAAT-OK = 1 AND
               WS-TH1975-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-VSEN-CBT12SC-WIT
            ELSE
                MOVE 0 TO WS-VSEN-CBT12SC-WIT.
