        IDENTIFICATION DIVISION.
        PROGRAM-ID. MYO-BIO-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / MYOINTERACT BIOMECHANICS AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-MYO-PARAMS.
           05 WS-ACTIVATION-LAT-MS      PIC 9(02) VALUE 12.
           05 WS-MOTOR-FID-M            PIC 9(04) VALUE 0960.
           05 WS-JOINT-DRIFT-MRAD       PIC 9(02) VALUE 01.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-MYO-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-MYO-VITALITY           PIC 9(09) VALUE 0.
           05 WS-MYO-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-MYO-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-MYO-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 ACT-LAT-OUT-OF-BOUNDS       VALUE 2.
              88 MOTOR-FIDELITY-LOW          VALUE 3.
              88 DRIFT-EXCEEDED              VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 MYOINTERACT-COLLAPSE        VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-MYOINTERACT-BIO
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3 AND WS-K-EXPONENT NOT EQUAL 4
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-ACTIVATION-LAT-MS < 5 OR WS-ACTIVATION-LAT-MS > 25
                SET ACT-LAT-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-MOTOR-FID-M < 850 OR WS-MOTOR-FID-M > 1000
                SET MOTOR-FIDELITY-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-JOINT-DRIFT-MRAD < 0 OR WS-JOINT-DRIFT-MRAD > 5
                SET DRIFT-EXCEEDED TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-MYOINTERACT-BIO.
            COMPUTE WS-MYO-COMPOSITE = ((30 - WS-ACTIVATION-LAT-MS) * 20) +
                                       (WS-MOTOR-FID-M / 2) +
                                       ((10 - WS-JOINT-DRIFT-MRAD) * 40).

            COMPUTE WS-MYO-VITALITY = (WS-MYO-COMPOSITE / 4) +
                                      (WS-MOTOR-FID-M / 4) +
                                      ((30 - WS-ACTIVATION-LAT-MS) * 4) + 1.

            IF WS-MYO-VITALITY EQUAL ZERO
                SET MYOINTERACT-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-MYO-COHERENCE = (WS-MYO-COMPOSITE / 16) +
                                       (WS-MOTOR-FID-M / 16) +
                                       ((30 - WS-ACTIVATION-LAT-MS) * 2).

            COMPUTE WS-MYO-REBAR-LATCH = 1470169088 +
                                         (WS-MYO-COMPOSITE / 2) +
                                         ((30 - WS-ACTIVATION-LAT-MS) * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-MYO-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-MYO-VITALITY * 10) +
                                         (WS-MYO-COHERENCE * 10) +
                                         (WS-MYO-COMPOSITE * 10) +
                                         (WS-MYO-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-MYO-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-MYO-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
