IDENTIFICATION DIVISION.
PROGRAM-ID. PROG-GLM-HBRIDGE-SWIGLU.

DATA DIVISION.
01 D0-SUBSTRATE-TRUNK.
   05 D0-MOTZKIN-PRIME     PIC 9(9) USAGE R0.
   05 D0-K-EXPONENT        PIC 9(9) USAGE R1.
   05 D0-HEASLY-THRESH     PIC 9(9) USAGE R2.
01 D1-HBRIDGE-INPUT.
   05 D1-INPUT-VAL-SCALED  PIC 9(9) USAGE R3.
   05 D1-V-NPN-POTENTIAL   PIC 9(9) USAGE R4.
   05 D1-V-PNP-POTENTIAL   PIC 9(9) USAGE R5.
   05 D1-V-DIFF-POTENTIAL  PIC 9(9) USAGE R6.
01 D2-WMQ-GATING.
   05 D2-WMQ-GATE-FACTOR   PIC 9(9) USAGE R7.
   05 D2-SWIGLU-OUTPUT     PIC 9(9) USAGE R8.
01 D3-LEAF-EVAL.
   05 D3-PROOF-RULING      PIC 9(9) USAGE R9.
   05 D3-DISP-WRAP-MOD     PIC 9(9) USAGE R10.

PROCEDURE DIVISION.
    MOVE 953467954 TO D0-MOTZKIN-PRIME.
    MOVE 3 TO D0-K-EXPONENT.
    MOVE 250 TO D0-HEASLY-THRESH.

    PERFORM EVAL-GLM-HBRIDGE-SWITCHING.
    PERFORM EVAL-WMQ-SCSI-GATING.
    PERFORM SYNC-DISPLACEMENT-MODULO.

    IF D2-WMQ-GATE-FACTOR >= 0 AND D2-WMQ-GATE-FACTOR <= 1000
        MOVE 0 TO D3-PROOF-RULING
        SET depth 4
    ELSE
        MOVE 3 TO D3-PROOF-RULING
        SET depth 1
    END-IF.

    EVAL.
    GO TO END-STRATEGY.

EVAL-GLM-HBRIDGE-SWITCHING.
    IF D1-INPUT-VAL-SCALED > 0
        COMPUTE D1-V-NPN-POTENTIAL = (D1-INPUT-VAL-SCALED * 1414) / 1000
        MOVE 0 TO D1-V-PNP-POTENTIAL
        COMPUTE D1-V-DIFF-POTENTIAL = D1-V-NPN-POTENTIAL
    ELSE
        MOVE 0 TO D1-V-NPN-POTENTIAL
        COMPUTE D1-V-PNP-POTENTIAL = ((-D1-INPUT-VAL-SCALED) * 707) / 1000
        COMPUTE D1-V-DIFF-POTENTIAL = -D1-V-PNP-POTENTIAL
    END-IF.
    EXIT.

EVAL-WMQ-SCSI-GATING.
    comment WinchesterMQ SCSI Gating with k=3 (7/8 = 875/1000 scale);
    IF D1-V-DIFF-POTENTIAL >= D0-HEASLY-THRESH
        COMPUTE D2-WMQ-GATE-FACTOR = 875 + ((125 * 1000) / (1000 + ((100 * D1-V-DIFF-POTENTIAL) / 1000)))
    ELSE IF D1-V-DIFF-POTENTIAL <= -D0-HEASLY-THRESH
        COMPUTE D2-WMQ-GATE-FACTOR = (125 * 1000) / (1000 + ((200 * (-D1-V-DIFF-POTENTIAL)) / 1000))
    ELSE
        COMPUTE D2-WMQ-GATE-FACTOR = 500 + D1-V-DIFF-POTENTIAL
    END-IF.

    IF D2-WMQ-GATE-FACTOR > 1000 MOVE 1000 TO D2-WMQ-GATE-FACTOR END-IF.
    IF D2-WMQ-GATE-FACTOR < 0 MOVE 0 TO D2-WMQ-GATE-FACTOR END-IF.
    COMPUTE D2-SWIGLU-OUTPUT = (D1-INPUT-VAL-SCALED * D2-WMQ-GATE-FACTOR) / 1000.
    EXIT.

SYNC-DISPLACEMENT-MODULO.
    comment DisplacementShader Synchronization: modulo 256;
    COMPUTE D3-DISP-WRAP-MOD = D2-SWIGLU-OUTPUT - ((D2-SWIGLU-OUTPUT / 256) * 256).
    EXIT.

END-STRATEGY.
