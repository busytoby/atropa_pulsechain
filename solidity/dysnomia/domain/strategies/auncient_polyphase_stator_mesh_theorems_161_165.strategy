        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-POLYPHASE-161-165.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-POLYPHASE-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH161-3PHASE-SYM-OK      PIC 9(01) VALUE 1.
            05  WS-TH162-MULTI-SYNC-OK      PIC 9(01) VALUE 1.
            05  WS-TH163-FLUX-QUANT-OK      PIC 9(01) VALUE 1.
            05  WS-TH164-DAMPING-OK         PIC 9(01) VALUE 1.
            05  WS-TH165-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-POLYPHASE-WITNESS        PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-POLYPHASE.
            GOBACK.
        1000-EVALUATE-POLYPHASE.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH161-3PHASE-SYM-OK = 1 AND
               WS-TH162-MULTI-SYNC-OK = 1 AND
               WS-TH163-FLUX-QUANT-OK = 1 AND
               WS-TH164-DAMPING-OK = 1 AND
               WS-TH165-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-POLYPHASE-WITNESS
            ELSE
                MOVE 0 TO WS-POLYPHASE-WITNESS.
