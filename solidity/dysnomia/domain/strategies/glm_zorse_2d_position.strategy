IDENTIFICATION DIVISION.
PROGRAM-ID. PROG-GLM-ZORSE-2D-POS.

DATA DIVISION.
01 D0-SUBSTRATE-TRUNK.
   05 D0-MOTZKIN-PRIME     PIC 9(9) USAGE R0.
   05 D0-K-EXPONENT        PIC 9(9) USAGE R1.
   05 D0-VDSO-LATENCY-NS   PIC 9(9) USAGE R2.
01 D1-COBOL-POSITION-INPUT.
   05 D1-LINEAR-TOKEN-POS  PIC 9(9) USAGE R3.
   05 D1-DIVISION-DEPTH    PIC 9(9) USAGE R4.
   05 D1-TOKENS-PER-DIV    PIC 9(9) USAGE R5.
01 D2-GLM-2D-COORDINATES.
   05 D2-POS-1-INTER-DIV   PIC 9(9) USAGE R6.
   05 D2-POS-2-INTRA-DIV   PIC 9(9) USAGE R7.
   05 D2-RECONSTRUCTED-POS PIC 9(9) USAGE R8.
01 D3-LEAF-EVAL.
   05 D3-PROOF-RULING      PIC 9(9) USAGE R9.
   05 D3-DISP-WRAP-MOD     PIC 9(9) USAGE R10.

PROCEDURE DIVISION.
    MOVE 953467954 TO D0-MOTZKIN-PRIME.
    MOVE 3 TO D0-K-EXPONENT.
    MOVE 80 TO D0-VDSO-LATENCY-NS.

    PERFORM DECOMPOSE-GLM-2D-POSITION.
    PERFORM RECONSTRUCT-LINEAR-POSITION.
    PERFORM SYNC-DISPLACEMENT-MODULO.

    IF D2-RECONSTRUCTED-POS == D1-LINEAR-TOKEN-POS AND D0-VDSO-LATENCY-NS < 1000
        MOVE 0 TO D3-PROOF-RULING
        SET depth 4
    ELSE
        MOVE 3 TO D3-PROOF-RULING
        SET depth 1
    END-IF.

    EVAL.
    GO TO END-STRATEGY.

DECOMPOSE-GLM-2D-POSITION.
    comment GLM 2D Positional Encoding: [Pos1: Inter-Division, Pos2: Intra-Division];
    MOVE D1-DIVISION-DEPTH TO D2-POS-1-INTER-DIV.
    COMPUTE D2-POS-2-INTRA-DIV = D1-LINEAR-TOKEN-POS - ((D1-LINEAR-TOKEN-POS / D1-TOKENS-PER-DIV) * D1-TOKENS-PER-DIV).
    EXIT.

RECONSTRUCT-LINEAR-POSITION.
    comment Exact Inverse Positional Recovery: Linear = (Pos1 * MaxTokens) + Pos2;
    COMPUTE D2-RECONSTRUCTED-POS = (D2-POS-1-INTER-DIV * D1-TOKENS-PER-DIV) + D2-POS-2-INTRA-DIV.
    EXIT.

SYNC-DISPLACEMENT-MODULO.
    COMPUTE D3-DISP-WRAP-MOD = D2-RECONSTRUCTED-POS - ((D2-RECONSTRUCTED-POS / 256) * 256).
    EXIT.

END-STRATEGY.
