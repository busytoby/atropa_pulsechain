        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-MU-LOGIT-INTERCEPT.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-INTERCEPT-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1866-INTERCEPT-OK      PIC 9(01) VALUE 1.
            05  WS-TH1867-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1868-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1869-1870M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1870-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-INTERCEPT-WIT            PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-INTERCEPT.
            GOBACK.
        1000-EVALUATE-INTERCEPT.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1866-INTERCEPT-OK = 1 AND
               WS-TH1867-DATBIN-STRAT-OK = 1 AND
               WS-TH1868-SUBMICRO-LAT-OK = 1 AND
               WS-TH1869-1870M-SAAT-OK = 1 AND
               WS-TH1870-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-INTERCEPT-WIT
            ELSE
                MOVE 0 TO WS-INTERCEPT-WIT.
