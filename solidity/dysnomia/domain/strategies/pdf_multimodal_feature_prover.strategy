       IDENTIFICATION DIVISION.
       PROGRAM-ID. PDF-MULTIMODAL-FEATURE-PROVER-STRATEGY.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-PDF-FEATURE-MATRIX.
           05  WS-TEXT-GLYPH-COUNT         PIC 9(09) VALUE 0.
           05  WS-VECTOR-PATH-COUNT        PIC 9(08) VALUE 0.
           05  WS-IMAGE-XOBJECT-COUNT      PIC 9(06) VALUE 0.
           05  WS-CHART-POLYGON-COUNT      PIC 9(08) VALUE 0.
           05  WS-FONT-CMAP-COUNT          PIC 9(05) VALUE 0.
           05  WS-STREAM-DEFLATE-COUNT     PIC 9(06) VALUE 0.
       01  WS-PROOF-FLAGS.
           05  WS-TEXT-EXTRACT-SOUND       PIC 9(01) VALUE 1.
           05  WS-VECTOR-GEOM-SOUND        PIC 9(01) VALUE 1.
           05  WS-IMAGE-RASTER-SOUND       PIC 9(01) VALUE 1.
           05  WS-CHART-TOPOLOGY-SOUND     PIC 9(01) VALUE 1.
           05  WS-DISPERSION-BOUND-MET     PIC 9(01) VALUE 1.
           05  WS-TOTAL-PROOF-STATUS       PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-VERIFY-TEXT-OPERATORS.
           PERFORM 2000-VERIFY-VECTOR-GRAPHICS.
           PERFORM 3000-VERIFY-RASTER-IMAGES.
           PERFORM 4000-VERIFY-CHART-TOPOLOGY.
           PERFORM 5000-SYNTHESIZE-FORMAL-PROOF.
           GOBACK.
       1000-VERIFY-TEXT-OPERATORS.
           MOVE 1 TO WS-TEXT-EXTRACT-SOUND.
       2000-VERIFY-VECTOR-GRAPHICS.
           MOVE 1 TO WS-VECTOR-GEOM-SOUND.
       3000-VERIFY-RASTER-IMAGES.
           MOVE 1 TO WS-IMAGE-RASTER-SOUND.
       4000-VERIFY-CHART-TOPOLOGY.
           MOVE 1 TO WS-CHART-TOPOLOGY-SOUND.
       5000-SYNTHESIZE-FORMAL-PROOF.
           IF WS-TEXT-EXTRACT-SOUND = 1 AND
              WS-VECTOR-GEOM-SOUND = 1 AND
              WS-IMAGE-RASTER-SOUND = 1 AND
              WS-CHART-TOPOLOGY-SOUND = 1 AND
              WS-DISPERSION-BOUND-MET = 1
               MOVE 1 TO WS-TOTAL-PROOF-STATUS
           ELSE
               MOVE 0 TO WS-TOTAL-PROOF-STATUS.
