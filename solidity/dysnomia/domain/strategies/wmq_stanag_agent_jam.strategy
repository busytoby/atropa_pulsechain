        IDENTIFICATION DIVISION.
        PROGRAM-ID. WMQ-STANAG-AGENT-JAM-STRATEGY.
        AUTHOR. AUNCIENT DYSNOMIA VM / STANAG JAM AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-JAM-PARAMETERS.
           05 WS-NIC-PORT               PIC 9(04) VALUE 8080.
           05 WS-ACTIVE-MUSICIANS       PIC 9(02) VALUE 04.
           05 WS-TEMPO-DRIFT-Q16        PIC 9(06) VALUE 032768.
           05 WS-MIX-HEADROOM           PIC 9(06) VALUE 050000.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-DAMPED-TEMPO-ERROR     PIC 9(06) VALUE 0.
           05 WS-POLYPHONIC-MIX-ODE     PIC 9(09) VALUE 0.
           05 WS-STANAG-LATCH-OUT       PIC 9(12) VALUE 0.
           05 WS-SHADOW-JAM-BASELINE    PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 INVALID-NIC-PORT            VALUE 2.
              88 INVALID-MUSICIAN-COUNT      VALUE 3.
              88 INVALID-TEMPO-DRIFT         VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 HEADROOM-OVERFLOW           VALUE 6.
              88 ROUTING-DESYNC              VALUE 7.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 8.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-STANAG-JAM
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-NIC-PORT < 8080 OR WS-NIC-PORT > 8096
                SET INVALID-NIC-PORT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-ACTIVE-MUSICIANS < 1 OR WS-ACTIVE-MUSICIANS > 16
                SET INVALID-MUSICIAN-COUNT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-TEMPO-DRIFT-Q16 > 65536
                SET INVALID-TEMPO-DRIFT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-MIX-HEADROOM EQUAL ZERO OR WS-MIX-HEADROOM > 100000
                SET HEADROOM-OVERFLOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-STANAG-JAM.
            COMPUTE WS-DAMPED-TEMPO-ERROR = (WS-TEMPO-DRIFT-Q16 * 875) / 1000.
            COMPUTE WS-POLYPHONIC-MIX-ODE = (WS-ACTIVE-MUSICIANS * 4096) + (WS-MIX-HEADROOM / 10) + 1.
            COMPUTE WS-STANAG-LATCH-OUT = 1470169088 + WS-NIC-PORT + WS-ACTIVE-MUSICIANS.

            IF WS-STANAG-LATCH-OUT < 1470177169
                SET ROUTING-DESYNC TO TRUE
                EXIT PARAGRAPH
            END-IF.

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-JAM-BASELINE = (WS-CICS-WRITER-ID * 1000000) +
                                             (WS-POLYPHONIC-MIX-ODE * 10) +
                                             (WS-DAMPED-TEMPO-ERROR / 10) +
                                             (WS-STANAG-LATCH-OUT / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-JAM-BASELINE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-JAM-BASELINE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
