        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-ALIGN-CLOSURE.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-CLOSURE-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1826-CLOSURE-OK        PIC 9(01) VALUE 1.
            05  WS-TH1827-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1828-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1829-1830M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1830-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-CLOSURE-WIT              PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-CLOSURE.
            GOBACK.
        1000-EVALUATE-CLOSURE.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1826-CLOSURE-OK = 1 AND
               WS-TH1827-DATBIN-STRAT-OK = 1 AND
               WS-TH1828-SUBMICRO-LAT-OK = 1 AND
               WS-TH1829-1830M-SAAT-OK = 1 AND
               WS-TH1830-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-CLOSURE-WIT
            ELSE
                MOVE 0 TO WS-CLOSURE-WIT.
