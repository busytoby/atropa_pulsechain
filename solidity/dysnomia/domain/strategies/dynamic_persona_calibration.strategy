        IDENTIFICATION DIVISION.
        PROGRAM-ID. DPC-CAL-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / DYNAMIC PERSONA CALIBRATION AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-DPC-PARAMS.
           05 WS-INTIMACY-SCALE-M       PIC 9(04) VALUE 0500.
           05 WS-EMBARRASS-SCORE-M      PIC 9(02) VALUE 01.
           05 WS-MODULATE-LAT-MS        PIC 9(02) VALUE 25.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-DPC-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-DPC-VITALITY           PIC 9(09) VALUE 0.
           05 WS-DPC-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-DPC-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-DPC-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 INTIMACY-SCALE-OUT-OF-BOUND VALUE 2.
              88 EMBARRASS-SCORE-EXCEEDED    VALUE 3.
              88 MODULATE-LAT-OUT-OF-BOUNDS  VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 PERSONA-COLLAPSE            VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-PERSONA-CALIBRATE
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-INTIMACY-SCALE-M < 200 OR WS-INTIMACY-SCALE-M > 800
                SET INTIMACY-SCALE-OUT-OF-BOUND TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-EMBARRASS-SCORE-M < 0 OR WS-EMBARRASS-SCORE-M > 5
                SET EMBARRASS-SCORE-EXCEEDED TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-MODULATE-LAT-MS < 10 OR WS-MODULATE-LAT-MS > 60
                SET MODULATE-LAT-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-PERSONA-CALIBRATE.
            COMPUTE WS-DPC-COMPOSITE = (WS-INTIMACY-SCALE-M / 2) +
                                       ((10 - WS-EMBARRASS-SCORE-M) * 20) +
                                       ((70 - WS-MODULATE-LAT-MS) * 10).

            COMPUTE WS-DPC-VITALITY = (WS-DPC-COMPOSITE / 4) +
                                      (WS-INTIMACY-SCALE-M / 4) +
                                      ((10 - WS-EMBARRASS-SCORE-M) * 4) + 1.

            IF WS-DPC-VITALITY EQUAL ZERO
                SET PERSONA-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-DPC-COHERENCE = (WS-DPC-COMPOSITE / 16) +
                                       (WS-INTIMACY-SCALE-M / 16) +
                                       ((10 - WS-EMBARRASS-SCORE-M) * 2).

            COMPUTE WS-DPC-REBAR-LATCH = 1470169088 +
                                         (WS-DPC-COMPOSITE / 2) +
                                         ((10 - WS-EMBARRASS-SCORE-M) * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-DPC-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-DPC-VITALITY * 10) +
                                         (WS-DPC-COHERENCE * 10) +
                                         (WS-DPC-COMPOSITE * 10) +
                                         (WS-DPC-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-DPC-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-DPC-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
