        IDENTIFICATION DIVISION.
        PROGRAM-ID. TOTIENT-TURTLE-PERCEPTION-STRATEGY.
        AUTHOR. AUNCIENT DYSNOMIA VM / TURTLE PERCEPTION AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-PERCEPTION-PARAMETERS.
           05 WS-COORD-X                PIC 9(04) VALUE 0320.
           05 WS-COORD-Y                PIC 9(04) VALUE 0176.
           05 WS-LUMA-ENERGY            PIC 9(03) VALUE 210.
           05 WS-GRADIENT-MAG           PIC 9(04) VALUE 0450.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-STIMULUS-METRIC        PIC 9(09) VALUE 0.
           05 WS-CHEMOTAXIS-VECTOR      PIC 9(09) VALUE 0.
           05 WS-VISION-REBAR-LATCH     PIC 9(12) VALUE 0.
           05 WS-SHADOW-VISION-BASE     PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 INVALID-COORD-X             VALUE 2.
              88 INVALID-COORD-Y             VALUE 3.
              88 INVALID-LUMA-ENERGY         VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 INVALID-GRADIENT-MAG        VALUE 6.
              88 VISION-UNDERFLOW-FAIL       VALUE 7.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 8.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-TURTLE-VISION
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-COORD-X > 640
                SET INVALID-COORD-X TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-COORD-Y > 352
                SET INVALID-COORD-Y TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-LUMA-ENERGY > 255
                SET INVALID-LUMA-ENERGY TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-GRADIENT-MAG > 1000
                SET INVALID-GRADIENT-MAG TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-TURTLE-VISION.
            COMPUTE WS-STIMULUS-METRIC = (WS-LUMA-ENERGY * 100) +
                                         (WS-GRADIENT-MAG * 10) +
                                         (WS-COORD-X * 2) + 1.

            IF WS-STIMULUS-METRIC EQUAL ZERO
                SET VISION-UNDERFLOW-FAIL TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-CHEMOTAXIS-VECTOR = ((WS-GRADIENT-MAG * 875) / 1000) +
                                           (WS-COORD-Y * 10).

            COMPUTE WS-VISION-REBAR-LATCH = 1470169088 + (WS-COORD-X * 256) +
                                            (WS-COORD-Y * 4) + (WS-LUMA-ENERGY / 10).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-VISION-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                            (WS-STIMULUS-METRIC * 10) +
                                            (WS-CHEMOTAXIS-VECTOR * 10) +
                                            (WS-COORD-X * 10) +
                                            (WS-VISION-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-VISION-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-VISION-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
