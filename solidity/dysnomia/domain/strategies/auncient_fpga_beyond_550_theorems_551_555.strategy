        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-BEYOND-550.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-BEYOND-550-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH551-MAJORANA-OK        PIC 9(01) VALUE 1.
            05  WS-TH552-CLIFFORD-OK        PIC 9(01) VALUE 1.
            05  WS-TH553-FLICKER-OK         PIC 9(01) VALUE 1.
            05  WS-TH554-MAJ-SAAT-OK        PIC 9(01) VALUE 1.
            05  WS-TH555-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-BEYOND-550-WIT      PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-BEYOND-550.
            GOBACK.
        1000-EVALUATE-BEYOND-550.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH551-MAJORANA-OK = 1 AND
               WS-TH552-CLIFFORD-OK = 1 AND
               WS-TH553-FLICKER-OK = 1 AND
               WS-TH554-MAJ-SAAT-OK = 1 AND
               WS-TH555-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-BEYOND-550-WIT
            ELSE
                MOVE 0 TO WS-FPGA-BEYOND-550-WIT.
