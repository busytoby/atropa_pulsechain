        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-STEERING-HEAD.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-STEERING-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1806-STEERING-OK       PIC 9(01) VALUE 1.
            05  WS-TH1807-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1808-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1809-1810M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1810-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-STEERING-WIT             PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-STEERING.
            GOBACK.
        1000-EVALUATE-STEERING.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1806-STEERING-OK = 1 AND
               WS-TH1807-DATBIN-STRAT-OK = 1 AND
               WS-TH1808-SUBMICRO-LAT-OK = 1 AND
               WS-TH1809-1810M-SAAT-OK = 1 AND
               WS-TH1810-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-STEERING-WIT
            ELSE
                MOVE 0 TO WS-STEERING-WIT.
