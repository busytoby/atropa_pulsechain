       IDENTIFICATION DIVISION.
       PROGRAM-ID. CAPTURE-THE-ZERO-SKELETON-XPLSM.
       AUTHOR. AUNCIENT DYSNOMIA VM / SKELETON XPLSM SELF PROOF.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-GAME-PARAMETERS.
          05 WS-U-HAT-FORWARD          PIC 9(09) VALUE 000049152.
          05 WS-V-HAT-BACKWARD         PIC 9(09) VALUE 000016384.
          05 WS-JOINT-INDEX            PIC 9(05) VALUE 00128.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-XPLSM-QUOTIENT-Q       PIC 9(09) VALUE 0.
          05 WS-XPLSM-PRODUCT-P        PIC 9(09) VALUE 0.
          05 WS-SHADOW-SKELETON-BASE   PIC 9(12) VALUE 0.
          05 WS-JOINT-MOD              PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-JOINT-POTENTIAL        PIC 9(09) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-FORWARD-TRAJECTORY  VALUE 2.
             88 INVALID-BACKWARD-TRAJECTORY VALUE 3.
             88 INVALID-JOINT-INDEX         VALUE 4.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
             88 GATING-CLAMP-OVERFLOW       VALUE 6.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 7.
             88 CASCADE-ROLLBACK-FAIL       VALUE 8.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-SKELETON-XPLSM
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-U-HAT-FORWARD EQUAL ZERO
               SET INVALID-FORWARD-TRAJECTORY TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-V-HAT-BACKWARD EQUAL ZERO
               SET INVALID-BACKWARD-TRAJECTORY TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-JOINT-INDEX > 9999
               SET INVALID-JOINT-INDEX TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-SKELETON-XPLSM.
           COMPUTE WS-XPLSM-QUOTIENT-Q = (WS-U-HAT-FORWARD * 1000) / WS-V-HAT-BACKWARD.
           COMPUTE WS-XPLSM-PRODUCT-P = (WS-U-HAT-FORWARD * WS-V-HAT-BACKWARD) / 65536.

           COMPUTE WS-SHADOW-SKELETON-BASE = (WS-CICS-WRITER-ID * 1000000) + (WS-JOINT-INDEX * 100) + WS-XPLSM-QUOTIENT-Q.

           COMPUTE WS-JOINT-MOD = FUNCTION MOD(WS-JOINT-INDEX, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-JOINT-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-JOINT-POTENTIAL = (WS-XPLSM-QUOTIENT-Q * 16) + WS-XPLSM-PRODUCT-P.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-SKELETON-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = (((WS-SHADOW-SKELETON-BASE + WS-JOINT-POTENTIAL) * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-SKELETON-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-JOINT-INDEX * 100) + WS-XPLSM-QUOTIENT-Q)
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-SKELETON-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
