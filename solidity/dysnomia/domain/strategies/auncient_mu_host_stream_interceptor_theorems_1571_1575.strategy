        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-STREAM-INT.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-STREAM-INT-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1571-STREAM-OK         PIC 9(01) VALUE 1.
            05  WS-TH1572-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1573-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1574-1575M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1575-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-STREAM-INT-WIT           PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-STREAM-INT.
            GOBACK.
        1000-EVALUATE-STREAM-INT.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1571-STREAM-OK = 1 AND
               WS-TH1572-DATBIN-STRAT-OK = 1 AND
               WS-TH1573-SUBMICRO-LAT-OK = 1 AND
               WS-TH1574-1575M-SAAT-OK = 1 AND
               WS-TH1575-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-STREAM-INT-WIT
            ELSE
                MOVE 0 TO WS-STREAM-INT-WIT.
