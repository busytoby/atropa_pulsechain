        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-AUX-NEURAL.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-AUX-NEURAL-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1056-NEURAL-CORES-OK   PIC 9(01) VALUE 1.
            05  WS-TH1057-DATBIN-NEURAL-OK  PIC 9(01) VALUE 1.
            05  WS-TH1058-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1059-1060M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1060-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-AUX-NEURAL-WIT           PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-AUX-NEURAL.
            GOBACK.
        1000-EVALUATE-AUX-NEURAL.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1056-NEURAL-CORES-OK = 1 AND
               WS-TH1057-DATBIN-NEURAL-OK = 1 AND
               WS-TH1058-SUBMICRO-LAT-OK = 1 AND
               WS-TH1059-1060M-SAAT-OK = 1 AND
               WS-TH1060-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-AUX-NEURAL-WIT
            ELSE
                MOVE 0 TO WS-AUX-NEURAL-WIT.
