       IDENTIFICATION DIVISION.
       PROGRAM-ID. LYAPUNOV-ISS-SCSI-STRATEGY.
       AUTHOR. AUNCIENT DYSNOMIA VM / ISS SCSI NOISE STABILITY.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-ISS-PARAMETERS.
          05 WS-INITIAL-STATE-X0       PIC 9(05) VALUE 10000.
          05 WS-SCSI-NOISE-AMP-W       PIC 9(04) VALUE 00500.
          05 WS-SCSI-BUS-CYCLES-T      PIC 9(02) VALUE 16.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-CURRENT-X              PIC 9(05) VALUE 0.
          05 WS-STEP-IDX               PIC 9(02) VALUE 0.
          05 WS-ISS-ULTIMATE-BOUND     PIC 9(05) VALUE 0.
          05 WS-SHADOW-ISS-BASE        PIC 9(12) VALUE 0.
          05 WS-CYC-MOD                PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-INITIAL-STATE       VALUE 2.
             88 INVALID-SCSI-NOISE          VALUE 3.
             88 INVALID-BUS-CYCLES          VALUE 4.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
             88 ISS-BOUND-VIOLATION         VALUE 6.
             88 GATING-CLAMP-OVERFLOW       VALUE 7.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 8.
             88 CASCADE-ROLLBACK-FAIL       VALUE 9.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-ISS-PROPAGATION
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-INITIAL-STATE-X0 > 50000
               SET INVALID-INITIAL-STATE TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SCSI-NOISE-AMP-W > 1000
               SET INVALID-SCSI-NOISE TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SCSI-BUS-CYCLES-T < 1 OR WS-SCSI-BUS-CYCLES-T > 64
               SET INVALID-BUS-CYCLES TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-ISS-PROPAGATION.
           MOVE WS-INITIAL-STATE-X0 TO WS-CURRENT-X.

           PERFORM VARYING WS-STEP-IDX FROM 1 BY 1 UNTIL WS-STEP-IDX > WS-SCSI-BUS-CYCLES-T
               COMPUTE WS-CURRENT-X = ((WS-CURRENT-X * 875) / 1000) + ((WS-SCSI-NOISE-AMP-W * 125) / 1000)
           END-PERFORM.

           MOVE WS-INITIAL-STATE-X0 TO WS-ISS-ULTIMATE-BOUND.
           IF WS-SCSI-NOISE-AMP-W > WS-ISS-ULTIMATE-BOUND
               MOVE WS-SCSI-NOISE-AMP-W TO WS-ISS-ULTIMATE-BOUND
           END-IF.

           IF WS-CURRENT-X > WS-ISS-ULTIMATE-BOUND
               SET ISS-BOUND-VIOLATION TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-SHADOW-ISS-BASE = (WS-CICS-WRITER-ID * 1000000) + 
               (WS-SCSI-BUS-CYCLES-T * 1000) + (WS-CURRENT-X / 16).

           COMPUTE WS-CYC-MOD = FUNCTION MOD(WS-SCSI-BUS-CYCLES-T, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-CYC-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-ISS-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-ISS-BASE + ((WS-CURRENT-X * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-ISS-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-SCSI-BUS-CYCLES-T * 1000) + (WS-CURRENT-X / 16))
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-ISS-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
