        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-SDK-SFT-MAT.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-SFT-MAT-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1236-MAT-OK            PIC 9(01) VALUE 1.
            05  WS-TH1237-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1238-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1239-1240M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1240-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-SFT-MAT-WIT              PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-SFT-MAT.
            GOBACK.
        1000-EVALUATE-SFT-MAT.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1236-MAT-OK = 1 AND
               WS-TH1237-DATBIN-STRAT-OK = 1 AND
               WS-TH1238-SUBMICRO-LAT-OK = 1 AND
               WS-TH1239-1240M-SAAT-OK = 1 AND
               WS-TH1240-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-SFT-MAT-WIT
            ELSE
                MOVE 0 TO WS-SFT-MAT-WIT.
