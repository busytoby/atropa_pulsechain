        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-MU-XI.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-MU-XI-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1371-XI-OK             PIC 9(01) VALUE 1.
            05  WS-TH1372-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1373-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1374-1375M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1375-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-MU-XI-WIT                PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-MU-XI.
            GOBACK.
        1000-EVALUATE-MU-XI.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1371-XI-OK = 1 AND
               WS-TH1372-DATBIN-STRAT-OK = 1 AND
               WS-TH1373-SUBMICRO-LAT-OK = 1 AND
               WS-TH1374-1375M-SAAT-OK = 1 AND
               WS-TH1375-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-MU-XI-WIT
            ELSE
                MOVE 0 TO WS-MU-XI-WIT.
