        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-SYSTOLIC.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-SYSTOLIC-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH256-ORTHOGONAL-OK      PIC 9(01) VALUE 1.
            05  WS-TH257-TERAOPS-OK         PIC 9(01) VALUE 1.
            05  WS-TH258-ZERO-BUBBLE-OK     PIC 9(01) VALUE 1.
            05  WS-TH259-SAAT-CLEAR-OK      PIC 9(01) VALUE 1.
            05  WS-TH260-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-SYSTOLIC-WITNESS    PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-FPGA-SYSTOLIC.
            GOBACK.
        1000-EVALUATE-FPGA-SYSTOLIC.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH256-ORTHOGONAL-OK = 1 AND
               WS-TH257-TERAOPS-OK = 1 AND
               WS-TH258-ZERO-BUBBLE-OK = 1 AND
               WS-TH259-SAAT-CLEAR-OK = 1 AND
               WS-TH260-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-SYSTOLIC-WITNESS
            ELSE
                MOVE 0 TO WS-FPGA-SYSTOLIC-WITNESS.
