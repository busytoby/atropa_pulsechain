        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-RBB-BARREL.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-RBB-BARREL-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1326-RBB-OK            PIC 9(01) VALUE 1.
            05  WS-TH1327-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1328-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1329-1330M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1330-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-RBB-BARREL-WIT           PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-RBB-BARREL.
            GOBACK.
        1000-EVALUATE-RBB-BARREL.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1326-RBB-OK = 1 AND
               WS-TH1327-DATBIN-STRAT-OK = 1 AND
               WS-TH1328-SUBMICRO-LAT-OK = 1 AND
               WS-TH1329-1330M-SAAT-OK = 1 AND
               WS-TH1330-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-RBB-BARREL-WIT
            ELSE
                MOVE 0 TO WS-RBB-BARREL-WIT.
