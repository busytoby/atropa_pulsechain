        IDENTIFICATION DIVISION.
        PROGRAM-ID. THERMAL-ENV-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / THERMAL ENVELOPE AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-THERM-PARAMS.
           05 WS-POWER-MW               PIC 9(05) VALUE 12500.
           05 WS-JUNCTION-TEMP-MC       PIC 9(05) VALUE 65000.
           05 WS-ENERGY-PER-TOKEN-MJ    PIC 9(04) VALUE 1500.
           05 WS-ENVELOPE-FLAG          PIC 9(01) VALUE 1.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-THERM-VITALITY         PIC 9(09) VALUE 0.
           05 WS-THERM-COHERENCE        PIC 9(09) VALUE 0.
           05 WS-THERM-REBAR-LATCH      PIC 9(12) VALUE 0.
           05 WS-SHADOW-THERM-BASE      PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 INVALID-POWER-BUDGET        VALUE 2.
              88 INVALID-JUNCTION-TEMP       VALUE 3.
              88 INVALID-ENERGY-PER-TOKEN    VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 THERMAL-ENVELOPE-FLAG-FAIL  VALUE 6.
              88 THERMAL-THROTTLE-BREACH     VALUE 7.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 8.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-THERMAL-ENVELOPE
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-POWER-MW < 1000 OR WS-POWER-MW > 25000
                SET INVALID-POWER-BUDGET TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-JUNCTION-TEMP-MC < 25000 OR WS-JUNCTION-TEMP-MC > 85000
                SET INVALID-JUNCTION-TEMP TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-ENERGY-PER-TOKEN-MJ < 100 OR WS-ENERGY-PER-TOKEN-MJ > 5000
                SET INVALID-ENERGY-PER-TOKEN TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-ENVELOPE-FLAG NOT EQUAL 1
                SET THERMAL-ENVELOPE-FLAG-FAIL TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-JUNCTION-TEMP-MC > 80000
                SET THERMAL-THROTTLE-BREACH TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-THERMAL-ENVELOPE.
            COMPUTE WS-THERM-VITALITY = ((80000 - WS-JUNCTION-TEMP-MC) / 64) +
                                        ((25000 - WS-POWER-MW) / 64) +
                                        (WS-ENVELOPE-FLAG * 256) + 1.

            IF WS-THERM-VITALITY EQUAL ZERO
                SET THERMAL-THROTTLE-BREACH TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-THERM-COHERENCE = ((80000 - WS-JUNCTION-TEMP-MC) / 256) +
                                         ((25000 - WS-POWER-MW) / 256) +
                                         (WS-ENERGY-PER-TOKEN-MJ / 64).

            COMPUTE WS-THERM-REBAR-LATCH = 1470169088 +
                                           (WS-JUNCTION-TEMP-MC / 32) +
                                           (WS-POWER-MW / 16) +
                                           (WS-ENERGY-PER-TOKEN-MJ * 4).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-THERM-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                           (WS-THERM-VITALITY * 10) +
                                           (WS-THERM-COHERENCE * 10) +
                                           ((80000 - WS-JUNCTION-TEMP-MC) / 10) +
                                           (WS-THERM-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-THERM-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-THERM-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
