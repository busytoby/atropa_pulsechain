        IDENTIFICATION DIVISION.
        PROGRAM-ID. OBM-OST-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / OSTEOPHONIC BONE MESH AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-OBM-PARAMS.
           05 WS-PROPAGATE-LAT-MS       PIC 9(02) VALUE 12.
           05 WS-LOC-FIDELITY-M         PIC 9(04) VALUE 0960.
           05 WS-CROSSTALK-M            PIC 9(02) VALUE 01.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-OBM-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-OBM-VITALITY           PIC 9(09) VALUE 0.
           05 WS-OBM-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-OBM-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-OBM-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 PROPAGATE-LAT-OUT-OF-BOUNDS VALUE 2.
              88 LOCALIZATION-FIDELITY-LOW   VALUE 3.
              88 CROSSTALK-EXCEEDED          VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 OSTEOPHONIC-COLLAPSE        VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-BONE-MESH
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3 AND WS-K-EXPONENT NOT EQUAL 4
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-PROPAGATE-LAT-MS < 5 OR WS-PROPAGATE-LAT-MS > 25
                SET PROPAGATE-LAT-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-LOC-FIDELITY-M < 850 OR WS-LOC-FIDELITY-M > 1000
                SET LOCALIZATION-FIDELITY-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CROSSTALK-M < 0 OR WS-CROSSTALK-M > 5
                SET CROSSTALK-EXCEEDED TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-BONE-MESH.
            COMPUTE WS-OBM-COMPOSITE = ((30 - WS-PROPAGATE-LAT-MS) * 20) +
                                       (WS-LOC-FIDELITY-M / 2) +
                                       ((10 - WS-CROSSTALK-M) * 40).

            COMPUTE WS-OBM-VITALITY = (WS-OBM-COMPOSITE / 4) +
                                      (WS-LOC-FIDELITY-M / 4) +
                                      ((30 - WS-PROPAGATE-LAT-MS) * 4) + 1.

            IF WS-OBM-VITALITY EQUAL ZERO
                SET OSTEOPHONIC-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-OBM-COHERENCE = (WS-OBM-COMPOSITE / 16) +
                                       (WS-LOC-FIDELITY-M / 16) +
                                       ((30 - WS-PROPAGATE-LAT-MS) * 2).

            COMPUTE WS-OBM-REBAR-LATCH = 1470169088 +
                                         (WS-OBM-COMPOSITE / 2) +
                                         ((30 - WS-PROPAGATE-LAT-MS) * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-OBM-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-OBM-VITALITY * 10) +
                                         (WS-OBM-COHERENCE * 10) +
                                         (WS-OBM-COMPOSITE * 10) +
                                         (WS-OBM-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-OBM-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-OBM-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
