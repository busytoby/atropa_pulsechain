IDENTIFICATION DIVISION.
PROGRAM-ID. PROG-USDSHADE-FET-VERLET.

DATA DIVISION.
01 D0-SUBSTRATE-TRUNK.
   05 D0-MOTZKIN-PRIME     PIC 9(9) USAGE R0.
   05 D0-K-EXPONENT        PIC 9(9) USAGE R1.
   05 D0-MAX-SPRING-FORCE  PIC 9(9) USAGE R2.
01 D1-FET-GRID.
   05 D1-GRID-SIZE-N       PIC 9(9) USAGE R3.
   05 D1-REST-LEN-Q16      PIC 9(9) USAGE R4.
   05 D1-CHARGE-LEVEL-Q16  PIC 9(9) USAGE R5.
01 D2-VERLET-INTEGRATION.
   05 D2-VERLET-DISP-Q16   PIC 9(9) USAGE R6.
   05 D2-SPRING-FORCE-Q16  PIC 9(9) USAGE R7.
   05 D2-G-SWIGLU-GATE     PIC 9(9) USAGE R8.
   05 D2-SHADOW-CHARGE     PIC 9(9) USAGE R9.
   05 D2-COMMITTED-STATE   PIC 9(9) USAGE R10.
01 D3-LEAF-EVAL.
   05 D3-PROOF-RULING      PIC 9(9) USAGE R11.
   05 D3-DISP-WRAP-MOD     PIC 9(9) USAGE R12.

PROCEDURE DIVISION.
    MOVE 953467954 TO D0-MOTZKIN-PRIME.
    MOVE 3 TO D0-K-EXPONENT.
    MOVE 65536 TO D0-MAX-SPRING-FORCE.
    MOVE 4 TO D1-GRID-SIZE-N.
    MOVE 98304 TO D1-REST-LEN-Q16.
    MOVE 65536 TO D1-CHARGE-LEVEL-Q16.

    PERFORM STAGE-VERLET-STEP.
    PERFORM STAGE-SPRING-RELAXATION.
    PERFORM EVALUATE-COMMIT.
    PERFORM SYNC-DISPLACEMENT.

    IF D2-SHADOW-CHARGE == D1-CHARGE-LEVEL-Q16 AND D2-SPRING-FORCE-Q16 <= D0-MAX-SPRING-FORCE
        MOVE 0 TO D3-PROOF-RULING
        SET depth 4
    ELSE
        MOVE 5 TO D3-PROOF-RULING
        SET depth 1
    END-IF.

    EVAL.
    GO TO END-STRATEGY.

STAGE-VERLET-STEP.
    MOVE D1-CHARGE-LEVEL-Q16 TO D2-SHADOW-CHARGE.
    COMPUTE D2-VERLET-DISP-Q16 = (D1-CHARGE-LEVEL-Q16 * 9800) / 10000.
    EXIT.

STAGE-SPRING-RELAXATION.
    COMPUTE D2-SPRING-FORCE-Q16 = (D1-REST-LEN-Q16 * 65536) / (D1-REST-LEN-Q16 + D2-VERLET-DISP-Q16).
    COMPUTE D2-G-SWIGLU-GATE = 875 + ((125 * D1-GRID-SIZE-N) / 16).
    EXIT.

EVALUATE-COMMIT.
    COMPUTE D2-COMMITTED-STATE = (((D2-VERLET-DISP-Q16 + D2-SPRING-FORCE-Q16 + 43605) * D2-G-SWIGLU-GATE) / 1000).
    EXIT.

SYNC-DISPLACEMENT.
    COMPUTE D3-DISP-WRAP-MOD = D2-COMMITTED-STATE - ((D2-COMMITTED-STATE / 256) * 256).
    EXIT.

END-STRATEGY.
