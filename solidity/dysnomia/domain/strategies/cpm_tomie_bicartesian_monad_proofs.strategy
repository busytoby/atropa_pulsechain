       IDENTIFICATION DIVISION.
       PROGRAM-ID. CPM-TOMIE-BICART-MONAD.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-BICART-MONAD-PROOFS.
           05  WS-ADJUNCTION-OK            PIC 9(01) VALUE 1.
           05  WS-DYNAMIC-LINK-OK          PIC 9(01) VALUE 1.
           05  WS-CURRYING-OK              PIC 9(01) VALUE 1.
           05  WS-MONAD-LATENCY-OK         PIC 9(01) VALUE 1.
           05  WS-MONAD-SEAL-OK            PIC 9(01) VALUE 1.
       01  WS-BICART-MONAD-SYNTHESIS.
           05  WS-ALL-PBM-PROVEN           PIC 9(01) VALUE 1.
           05  WS-TOTAL-PBM-CODE           PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-EVALUATE-ADJUNCT-AND-LINK.
           PERFORM 2000-EVALUATE-CURRY-AND-LATENCY.
           PERFORM 3000-SYNTHESIZE-PBM-PROOFS.
           GOBACK.
       1000-EVALUATE-ADJUNCT-AND-LINK.
           MOVE 1 TO WS-ADJUNCTION-OK.
           MOVE 1 TO WS-DYNAMIC-LINK-OK.
       2000-EVALUATE-CURRY-AND-LATENCY.
           MOVE 1 TO WS-CURRYING-OK.
           MOVE 1 TO WS-MONAD-LATENCY-OK.
       3000-SYNTHESIZE-PBM-PROOFS.
           IF WS-ADJUNCTION-OK = 1 AND
              WS-DYNAMIC-LINK-OK = 1 AND
              WS-CURRYING-OK = 1 AND
              WS-MONAD-LATENCY-OK = 1
               MOVE 1 TO WS-MONAD-SEAL-OK
               MOVE 1 TO WS-ALL-PBM-PROVEN
               MOVE 1 TO WS-TOTAL-PBM-CODE
           ELSE
               MOVE 0 TO WS-ALL-PBM-PROVEN
               MOVE 0 TO WS-TOTAL-PBM-CODE.
