        IDENTIFICATION DIVISION.
        PROGRAM-ID. PGD-PRO-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / PRONOUN GAZE DISAMBIGUATION AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-PGD-PARAMS.
           05 WS-DISAMBIG-LAT-MS        PIC 9(02) VALUE 12.
           05 WS-REFERENCE-FID-M        PIC 9(04) VALUE 0960.
           05 WS-ANGULAR-OFFSET-MRAD    PIC 9(02) VALUE 01.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-PGD-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-PGD-VITALITY           PIC 9(09) VALUE 0.
           05 WS-PGD-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-PGD-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-PGD-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 DISAMBIG-LAT-OUT-OF-BOUNDS  VALUE 2.
              88 REFERENCE-FIDELITY-LOW      VALUE 3.
              88 OFFSET-EXCEEDED             VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 PRONOUN-COLLAPSE            VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-PRONOUN-DISAMBIG
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3 AND WS-K-EXPONENT NOT EQUAL 4
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-DISAMBIG-LAT-MS < 5 OR WS-DISAMBIG-LAT-MS > 25
                SET DISAMBIG-LAT-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-REFERENCE-FID-M < 850 OR WS-REFERENCE-FID-M > 1000
                SET REFERENCE-FIDELITY-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-ANGULAR-OFFSET-MRAD < 0 OR WS-ANGULAR-OFFSET-MRAD > 5
                SET OFFSET-EXCEEDED TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-PRONOUN-DISAMBIG.
            COMPUTE WS-PGD-COMPOSITE = ((30 - WS-DISAMBIG-LAT-MS) * 20) +
                                       (WS-REFERENCE-FID-M / 2) +
                                       ((10 - WS-ANGULAR-OFFSET-MRAD) * 40).

            COMPUTE WS-PGD-VITALITY = (WS-PGD-COMPOSITE / 4) +
                                      (WS-REFERENCE-FID-M / 4) +
                                      ((30 - WS-DISAMBIG-LAT-MS) * 4) + 1.

            IF WS-PGD-VITALITY EQUAL ZERO
                SET PRONOUN-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-PGD-COHERENCE = (WS-PGD-COMPOSITE / 16) +
                                       (WS-REFERENCE-FID-M / 16) +
                                       ((30 - WS-DISAMBIG-LAT-MS) * 2).

            COMPUTE WS-PGD-REBAR-LATCH = 1470169088 +
                                         (WS-PGD-COMPOSITE / 2) +
                                         ((30 - WS-DISAMBIG-LAT-MS) * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-PGD-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-PGD-VITALITY * 10) +
                                         (WS-PGD-COHERENCE * 10) +
                                         (WS-PGD-COMPOSITE * 10) +
                                         (WS-PGD-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-PGD-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-PGD-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
