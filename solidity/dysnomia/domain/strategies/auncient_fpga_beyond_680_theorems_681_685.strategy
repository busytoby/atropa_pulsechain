        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-BEYOND-680.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-BEYOND-680-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH681-MULTICORE-IC-OK    PIC 9(01) VALUE 1.
            05  WS-TH682-LOCKFREE-BUS-OK    PIC 9(01) VALUE 1.
            05  WS-TH683-IC-LAT-OK          PIC 9(01) VALUE 1.
            05  WS-TH684-685M-SAAT-OK       PIC 9(01) VALUE 1.
            05  WS-TH685-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-BEYOND-680-WIT      PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-BEYOND-680.
            GOBACK.
        1000-EVALUATE-BEYOND-680.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH681-MULTICORE-IC-OK = 1 AND
               WS-TH682-LOCKFREE-BUS-OK = 1 AND
               WS-TH683-IC-LAT-OK = 1 AND
               WS-TH684-685M-SAAT-OK = 1 AND
               WS-TH685-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-BEYOND-680-WIT
            ELSE
                MOVE 0 TO WS-FPGA-BEYOND-680-WIT.
