        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-MONOPOLE-LIMIT.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-MONOPOLE-LIMIT-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1536-LIMIT-OK          PIC 9(01) VALUE 1.
            05  WS-TH1537-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1538-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1539-1540M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1540-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-MONOPOLE-LIMIT-WIT       PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-MONOPOLE-LIMIT.
            GOBACK.
        1000-EVALUATE-MONOPOLE-LIMIT.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1536-LIMIT-OK = 1 AND
               WS-TH1537-DATBIN-STRAT-OK = 1 AND
               WS-TH1538-SUBMICRO-LAT-OK = 1 AND
               WS-TH1539-1540M-SAAT-OK = 1 AND
               WS-TH1540-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-MONOPOLE-LIMIT-WIT
            ELSE
                MOVE 0 TO WS-MONOPOLE-LIMIT-WIT.
