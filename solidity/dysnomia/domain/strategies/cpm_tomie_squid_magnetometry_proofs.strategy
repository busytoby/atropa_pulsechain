       IDENTIFICATION DIVISION.
       PROGRAM-ID. CPM-TOMIE-SQUID-MAG.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-SQUID-MAG-PROOFS.
           05  WS-FLUX-QUANT-OK            PIC 9(01) VALUE 1.
           05  WS-MOTOR-INTENT-OK          PIC 9(01) VALUE 1.
           05  WS-SHIELDING-OK             PIC 9(01) VALUE 1.
           05  WS-SQUID-LATENCY-OK         PIC 9(01) VALUE 1.
           05  WS-SQUID-SEAL-OK            PIC 9(01) VALUE 1.
       01  WS-SQUID-MAG-SYNTHESIS.
           05  WS-ALL-PSQ-PROVEN           PIC 9(01) VALUE 1.
           05  WS-TOTAL-PSQ-CODE           PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-EVALUATE-FLUX-AND-INTENT.
           PERFORM 2000-EVALUATE-SHIELD-AND-LATENCY.
           PERFORM 3000-SYNTHESIZE-PSQ-PROOFS.
           GOBACK.
       1000-EVALUATE-FLUX-AND-INTENT.
           MOVE 1 TO WS-FLUX-QUANT-OK.
           MOVE 1 TO WS-MOTOR-INTENT-OK.
       2000-EVALUATE-SHIELD-AND-LATENCY.
           MOVE 1 TO WS-SHIELDING-OK.
           MOVE 1 TO WS-SQUID-LATENCY-OK.
       3000-SYNTHESIZE-PSQ-PROOFS.
           IF WS-FLUX-QUANT-OK = 1 AND
              WS-MOTOR-INTENT-OK = 1 AND
              WS-SHIELDING-OK = 1 AND
              WS-SQUID-LATENCY-OK = 1
               MOVE 1 TO WS-SQUID-SEAL-OK
               MOVE 1 TO WS-ALL-PSQ-PROVEN
               MOVE 1 TO WS-TOTAL-PSQ-CODE
           ELSE
               MOVE 0 TO WS-ALL-PSQ-PROVEN
               MOVE 0 TO WS-TOTAL-PSQ-CODE.
