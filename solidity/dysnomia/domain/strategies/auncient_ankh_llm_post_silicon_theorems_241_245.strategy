        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-ANKH-POST-SILICON.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-ANKH-POST-SILICON-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH241-CONTEXT-OK         PIC 9(01) VALUE 1.
            05  WS-TH242-POST-SILICON-OK    PIC 9(01) VALUE 1.
            05  WS-TH243-ATTENTION-OK       PIC 9(01) VALUE 1.
            05  WS-TH244-ZERO-LEAK-OK       PIC 9(01) VALUE 1.
            05  WS-TH245-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-ANKH-POST-SILICON-WITNESS PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-ANKH-POST-SILICON.
            GOBACK.
        1000-EVALUATE-ANKH-POST-SILICON.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH241-CONTEXT-OK = 1 AND
               WS-TH242-POST-SILICON-OK = 1 AND
               WS-TH243-ATTENTION-OK = 1 AND
               WS-TH244-ZERO-LEAK-OK = 1 AND
               WS-TH245-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-ANKH-POST-SILICON-WITNESS
            ELSE
                MOVE 0 TO WS-ANKH-POST-SILICON-WITNESS.
