        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FC-BARREL.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FC-BARREL-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1286-FC-OK             PIC 9(01) VALUE 1.
            05  WS-TH1287-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1288-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1289-1290M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1290-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-FC-BARREL-WIT            PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-FC-BARREL.
            GOBACK.
        1000-EVALUATE-FC-BARREL.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1286-FC-OK = 1 AND
               WS-TH1287-DATBIN-STRAT-OK = 1 AND
               WS-TH1288-SUBMICRO-LAT-OK = 1 AND
               WS-TH1289-1290M-SAAT-OK = 1 AND
               WS-TH1290-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-FC-BARREL-WIT
            ELSE
                MOVE 0 TO WS-FC-BARREL-WIT.
