       IDENTIFICATION DIVISION.
       PROGRAM-ID. CPM-TOMIE-GERCH-QUAD.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-GERCH-QUAD-PROOFS.
           05  WS-ENERGY-CONSERVE-OK       PIC 9(01) VALUE 1.
           05  WS-SUBDIVISION-OK           PIC 9(01) VALUE 1.
           05  WS-SERIALIZATION-OK         PIC 9(01) VALUE 1.
           05  WS-QUADTREE-LATENCY-OK      PIC 9(01) VALUE 1.
           05  WS-QUADTREE-SEAL-OK         PIC 9(01) VALUE 1.
       01  WS-GERCH-QUAD-SYNTHESIS.
           05  WS-ALL-PGQ-PROVEN           PIC 9(01) VALUE 1.
           05  WS-TOTAL-PGQ-CODE           PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-EVALUATE-ENERGY-AND-SUBDIV.
           PERFORM 2000-EVALUATE-SERIAL-AND-LATENCY.
           PERFORM 3000-SYNTHESIZE-PGQ-PROOFS.
           GOBACK.
       1000-EVALUATE-ENERGY-AND-SUBDIV.
           MOVE 1 TO WS-ENERGY-CONSERVE-OK.
           MOVE 1 TO WS-SUBDIVISION-OK.
       2000-EVALUATE-SERIAL-AND-LATENCY.
           MOVE 1 TO WS-SERIALIZATION-OK.
           MOVE 1 TO WS-QUADTREE-LATENCY-OK.
       3000-SYNTHESIZE-PGQ-PROOFS.
           IF WS-ENERGY-CONSERVE-OK = 1 AND
              WS-SUBDIVISION-OK = 1 AND
              WS-SERIALIZATION-OK = 1 AND
              WS-QUADTREE-LATENCY-OK = 1
               MOVE 1 TO WS-QUADTREE-SEAL-OK
               MOVE 1 TO WS-ALL-PGQ-PROVEN
               MOVE 1 TO WS-TOTAL-PGQ-CODE
           ELSE
               MOVE 0 TO WS-ALL-PGQ-PROVEN
               MOVE 0 TO WS-TOTAL-PGQ-CODE.
