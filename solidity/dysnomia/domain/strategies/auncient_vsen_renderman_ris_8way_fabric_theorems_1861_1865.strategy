        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-VSEN-RIS.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-VSEN-RIS-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1861-RIS-BXDF-OK       PIC 9(01) VALUE 1.
            05  WS-TH1862-FUR-OPTICS-OK     PIC 9(01) VALUE 1.
            05  WS-TH1863-SHADOW-LAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1864-1865M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1865-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-VSEN-RIS-WIT             PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-VSEN-RIS.
            GOBACK.
        1000-EVALUATE-VSEN-RIS.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1861-RIS-BXDF-OK = 1 AND
               WS-TH1862-FUR-OPTICS-OK = 1 AND
               WS-TH1863-SHADOW-LAT-OK = 1 AND
               WS-TH1864-1865M-SAAT-OK = 1 AND
               WS-TH1865-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-VSEN-RIS-WIT
            ELSE
                MOVE 0 TO WS-VSEN-RIS-WIT.
