       IDENTIFICATION DIVISION.
       PROGRAM-ID. LYAPUNOV-FLETCHER-STRATEGY.
       AUTHOR. AUNCIENT DYSNOMIA VM / EQUAL-LOUDNESS FATIGUE.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-FATIGUE-PARAMETERS.
          05 WS-FREQUENCY-HZ           PIC 9(05) VALUE 03000.
          05 WS-SPL-DB                 PIC 9(03) VALUE 085.
          05 WS-EXPOSURE-DURATION-SEC  PIC 9(02) VALUE 16.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-PERCEIVED-PHON-LEVEL   PIC 9(03) VALUE 0.
          05 WS-CUMULATIVE-FATIGUE     PIC 9(06) VALUE 0.
          05 WS-STEP-IDX               PIC 9(02) VALUE 0.
          05 WS-SHADOW-FATIGUE-BASE    PIC 9(12) VALUE 0.
          05 WS-CYC-MOD                PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-FREQUENCY           VALUE 2.
             88 INVALID-SPL-LEVEL           VALUE 3.
             88 INVALID-EXPOSURE-DUR        VALUE 4.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
             88 AUDITORY-FATIGUE-FAIL       VALUE 6.
             88 GATING-CLAMP-OVERFLOW       VALUE 7.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 8.
             88 CASCADE-ROLLBACK-FAIL       VALUE 9.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-FATIGUE-CLAMP
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-FREQUENCY-HZ < 20 OR WS-FREQUENCY-HZ > 12500
               SET INVALID-FREQUENCY TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SPL-DB > 120
               SET INVALID-SPL-LEVEL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-EXPOSURE-DURATION-SEC < 1 OR WS-EXPOSURE-DURATION-SEC > 64
               SET INVALID-EXPOSURE-DUR TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-FATIGUE-CLAMP.
           IF WS-FREQUENCY-HZ >= 2000 AND WS-FREQUENCY-HZ <= 4000
               COMPUTE WS-PERCEIVED-PHON-LEVEL = WS-SPL-DB + 5
           ELSE
               IF WS-FREQUENCY-HZ < 500
                   IF WS-SPL-DB >= 5
                       COMPUTE WS-PERCEIVED-PHON-LEVEL = WS-SPL-DB - 5
                   ELSE
                       MOVE ZERO TO WS-PERCEIVED-PHON-LEVEL
                   END-IF
               ELSE
                   MOVE WS-SPL-DB TO WS-PERCEIVED-PHON-LEVEL
               END-IF
           END-IF.

           COMPUTE WS-CUMULATIVE-FATIGUE = WS-PERCEIVED-PHON-LEVEL * 100.

           PERFORM VARYING WS-STEP-IDX FROM 1 BY 1 UNTIL WS-STEP-IDX > WS-EXPOSURE-DURATION-SEC
               COMPUTE WS-CUMULATIVE-FATIGUE = (WS-CUMULATIVE-FATIGUE * 875) / 1000
           END-PERFORM.

           IF WS-CUMULATIVE-FATIGUE > (WS-PERCEIVED-PHON-LEVEL * 100)
               SET AUDITORY-FATIGUE-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-SHADOW-FATIGUE-BASE = (WS-CICS-WRITER-ID * 1000000) + 
               (WS-PERCEIVED-PHON-LEVEL * 10000) + (WS-EXPOSURE-DURATION-SEC * 100) + (WS-CUMULATIVE-FATIGUE / 16).

           COMPUTE WS-CYC-MOD = FUNCTION MOD(WS-EXPOSURE-DURATION-SEC, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-CYC-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-FATIGUE-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-FATIGUE-BASE + ((WS-CUMULATIVE-FATIGUE * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-FATIGUE-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-PERCEIVED-PHON-LEVEL * 10000) + (WS-EXPOSURE-DURATION-SEC * 100) + (WS-CUMULATIVE-FATIGUE / 16))
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-FATIGUE-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
