        IDENTIFICATION DIVISION.
        PROGRAM-ID. BAD-DIS-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / BEAR CLAN ASSEMBLY DISPATCH AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-BAD-PARAMS.
           05 WS-DISPATCH-LAT-MS        PIC 9(02) VALUE 12.
           05 WS-ASSEMBLY-FID-M         PIC 9(04) VALUE 0960.
           05 WS-SYNC-DRIFT-MS          PIC 9(02) VALUE 01.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-BAD-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-BAD-VITALITY           PIC 9(09) VALUE 0.
           05 WS-BAD-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-BAD-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-BAD-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 DISPATCH-LAT-OUT-OF-BOUNDS  VALUE 2.
              88 ASSEMBLY-FIDELITY-LOW       VALUE 3.
              88 SYNC-DRIFT-EXCEEDED         VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 DISPATCH-COLLAPSE           VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-CLAN-DISPATCH
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3 AND WS-K-EXPONENT NOT EQUAL 4
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-DISPATCH-LAT-MS < 5 OR WS-DISPATCH-LAT-MS > 25
                SET DISPATCH-LAT-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-ASSEMBLY-FID-M < 850 OR WS-ASSEMBLY-FID-M > 1000
                SET ASSEMBLY-FIDELITY-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-SYNC-DRIFT-MS < 0 OR WS-SYNC-DRIFT-MS > 5
                SET SYNC-DRIFT-EXCEEDED TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-CLAN-DISPATCH.
            COMPUTE WS-BAD-COMPOSITE = ((30 - WS-DISPATCH-LAT-MS) * 20) +
                                       (WS-ASSEMBLY-FID-M / 2) +
                                       ((10 - WS-SYNC-DRIFT-MS) * 40).

            COMPUTE WS-BAD-VITALITY = (WS-BAD-COMPOSITE / 4) +
                                      (WS-ASSEMBLY-FID-M / 4) +
                                      ((30 - WS-DISPATCH-LAT-MS) * 4) + 1.

            IF WS-BAD-VITALITY EQUAL ZERO
                SET DISPATCH-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-BAD-COHERENCE = (WS-BAD-COMPOSITE / 16) +
                                       (WS-ASSEMBLY-FID-M / 16) +
                                       ((30 - WS-DISPATCH-LAT-MS) * 2).

            COMPUTE WS-BAD-REBAR-LATCH = 1470169088 +
                                         (WS-BAD-COMPOSITE / 2) +
                                         ((30 - WS-DISPATCH-LAT-MS) * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-BAD-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-BAD-VITALITY * 10) +
                                         (WS-BAD-COHERENCE * 10) +
                                         (WS-BAD-COMPOSITE * 10) +
                                         (WS-BAD-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-BAD-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-BAD-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
