        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-ZK-POLAR.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-ZK-POLAR-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1486-LINEAGE-OK        PIC 9(01) VALUE 1.
            05  WS-TH1487-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1488-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1489-1490M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1490-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-ZK-POLAR-WIT             PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-ZK-POLAR.
            GOBACK.
        1000-EVALUATE-ZK-POLAR.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1486-LINEAGE-OK = 1 AND
               WS-TH1487-DATBIN-STRAT-OK = 1 AND
               WS-TH1488-SUBMICRO-LAT-OK = 1 AND
               WS-TH1489-1490M-SAAT-OK = 1 AND
               WS-TH1490-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-ZK-POLAR-WIT
            ELSE
                MOVE 0 TO WS-ZK-POLAR-WIT.
