        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-VSEN-MSTANIM.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-VSEN-MSTANIM-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1896-SWARM-TOPO-OK     PIC 9(01) VALUE 1.
            05  WS-TH1897-UNIV-FET-OK       PIC 9(01) VALUE 1.
            05  WS-TH1898-UNIV-LAT-OK       PIC 9(01) VALUE 1.
            05  WS-TH1899-1900M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1900-GRAND-SEAL-OK     PIC 9(01) VALUE 1.
            05  WS-VSEN-MSTANIM-WIT         PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-VSEN-MSTANIM.
            GOBACK.
        1000-EVALUATE-VSEN-MSTANIM.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1896-SWARM-TOPO-OK = 1 AND
               WS-TH1897-UNIV-FET-OK = 1 AND
               WS-TH1898-UNIV-LAT-OK = 1 AND
               WS-TH1899-1900M-SAAT-OK = 1 AND
               WS-TH1900-GRAND-SEAL-OK = 1
                MOVE 1 TO WS-VSEN-MSTANIM-WIT
            ELSE
                MOVE 0 TO WS-VSEN-MSTANIM-WIT.
