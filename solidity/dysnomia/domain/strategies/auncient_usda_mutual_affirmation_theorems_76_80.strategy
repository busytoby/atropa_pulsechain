        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-USDA-MUTUAL-AFFIRMATION-76-80.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-MUTUAL-AFFIRM-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH76-COSIGN-AFFIRM-OK    PIC 9(01) VALUE 1.
            05  WS-TH77-SECONDARY-PROOF-OK  PIC 9(01) VALUE 1.
            05  WS-TH78-COMPENSATORY-ACT-OK PIC 9(01) VALUE 1.
            05  WS-TH79-REGISTRY-MEMORY-OK  PIC 9(01) VALUE 1.
            05  WS-TH80-GOSSIP-CLOSURE-OK   PIC 9(01) VALUE 1.
            05  WS-AFFIRM-PROOF-WITNESS     PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-MUTUAL-AFFIRM.
            GOBACK.
        1000-EVALUATE-MUTUAL-AFFIRM.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH76-COSIGN-AFFIRM-OK = 1 AND
               WS-TH77-SECONDARY-PROOF-OK = 1 AND
               WS-TH78-COMPENSATORY-ACT-OK = 1 AND
               WS-TH79-REGISTRY-MEMORY-OK = 1 AND
               WS-TH80-GOSSIP-CLOSURE-OK = 1
                MOVE 1 TO WS-AFFIRM-PROOF-WITNESS
            ELSE
                MOVE 0 TO WS-AFFIRM-PROOF-WITNESS.
