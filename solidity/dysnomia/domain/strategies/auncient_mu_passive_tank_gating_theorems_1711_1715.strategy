        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-PASS-GATE.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-PASS-GATE-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1711-PASS-GATE-OK      PIC 9(01) VALUE 1.
            05  WS-TH1712-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1713-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1714-1715M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1715-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-PASS-GATE-WIT            PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-PASS-GATE.
            GOBACK.
        1000-EVALUATE-PASS-GATE.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1711-PASS-GATE-OK = 1 AND
               WS-TH1712-DATBIN-STRAT-OK = 1 AND
               WS-TH1713-SUBMICRO-LAT-OK = 1 AND
               WS-TH1714-1715M-SAAT-OK = 1 AND
               WS-TH1715-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-PASS-GATE-WIT
            ELSE
                MOVE 0 TO WS-PASS-GATE-WIT.
