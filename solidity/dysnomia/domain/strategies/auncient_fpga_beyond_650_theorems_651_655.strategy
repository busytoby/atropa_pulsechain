        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-BEYOND-650.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-BEYOND-650-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH651-RENDERMAN-RIB-OK   PIC 9(01) VALUE 1.
            05  WS-TH652-PHOTO-BXDF-OK      PIC 9(01) VALUE 1.
            05  WS-TH653-RIB-LAT-OK         PIC 9(01) VALUE 1.
            05  WS-TH654-655M-SAAT-OK       PIC 9(01) VALUE 1.
            05  WS-TH655-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-BEYOND-650-WIT      PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-BEYOND-650.
            GOBACK.
        1000-EVALUATE-BEYOND-650.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH651-RENDERMAN-RIB-OK = 1 AND
               WS-TH652-PHOTO-BXDF-OK = 1 AND
               WS-TH653-RIB-LAT-OK = 1 AND
               WS-TH654-655M-SAAT-OK = 1 AND
               WS-TH655-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-BEYOND-650-WIT
            ELSE
                MOVE 0 TO WS-FPGA-BEYOND-650-WIT.
