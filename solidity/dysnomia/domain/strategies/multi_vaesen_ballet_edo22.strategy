        IDENTIFICATION DIVISION.
        PROGRAM-ID. MULTI-VAESEN-BALLET-EDO22-STRATEGY.
        AUTHOR. AUNCIENT DYSNOMIA VM / BALLET CHOREOGRAPHY AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-BALLET-PARAMETERS.
           05 WS-LEADER-DNA             PIC 9(07) VALUE 0555555.
           05 WS-EDO22-DEGREE           PIC 9(02) VALUE 11.
           05 WS-TEMPO-BPM              PIC 9(03) VALUE 120.
           05 WS-FORMATION-RAD-Q16      PIC 9(06) VALUE 032768.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-MULTI-POSE-METRIC      PIC 9(09) VALUE 0.
           05 WS-EDO22-RESONANCE        PIC 9(09) VALUE 0.
           05 WS-BALLET-REBAR-LATCH     PIC 9(12) VALUE 0.
           05 WS-SHADOW-BALLET-BASE     PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 INVALID-LEADER-DNA          VALUE 2.
              88 INVALID-EDO22-DEGREE        VALUE 3.
              88 INVALID-TEMPO-BPM           VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 INVALID-FORMATION-RAD       VALUE 6.
              88 BALLET-UNDERFLOW-FAIL       VALUE 7.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 8.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-BALLET-EDO22
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-LEADER-DNA < 1 OR WS-LEADER-DNA > 1000000
                SET INVALID-LEADER-DNA TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-EDO22-DEGREE > 21
                SET INVALID-EDO22-DEGREE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-TEMPO-BPM < 30 OR WS-TEMPO-BPM > 300
                SET INVALID-TEMPO-BPM TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-FORMATION-RAD-Q16 < 1000 OR WS-FORMATION-RAD-Q16 > 65536
                SET INVALID-FORMATION-RAD TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-BALLET-EDO22.
            COMPUTE WS-MULTI-POSE-METRIC = (WS-LEADER-DNA / 10) +
                                           (WS-EDO22-DEGREE * 512) +
                                           (WS-TEMPO-BPM * 16) + 1.

            IF WS-MULTI-POSE-METRIC EQUAL ZERO
                SET BALLET-UNDERFLOW-FAIL TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-EDO22-RESONANCE = ((WS-FORMATION-RAD-Q16 * 875) / 10000) +
                                         (WS-EDO22-DEGREE * 32).

            COMPUTE WS-BALLET-REBAR-LATCH = 1470169088 + (WS-LEADER-DNA / 100) +
                                            (WS-EDO22-DEGREE * 64) +
                                            (WS-TEMPO-BPM * 2).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-BALLET-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                            (WS-MULTI-POSE-METRIC * 10) +
                                            (WS-EDO22-RESONANCE * 10) +
                                            (WS-EDO22-DEGREE * 1000) +
                                            (WS-BALLET-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-BALLET-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-BALLET-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
