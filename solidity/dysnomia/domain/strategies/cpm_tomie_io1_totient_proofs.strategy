       IDENTIFICATION DIVISION.
       PROGRAM-ID. CPM-TOMIE-IO1-TOTIENT.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-IO1-TOTIENT-PROOFS.
           05  WS-OPCODE-AUDIT-OK          PIC 9(01) VALUE 1.
           05  WS-TOTIENT-RESIDUE-OK       PIC 9(01) VALUE 1.
           05  WS-WORD-ALIGNMENT-OK        PIC 9(01) VALUE 1.
           05  WS-IO1-LATENCY-OK           PIC 9(01) VALUE 1.
           05  WS-IO1-TOTIENT-SEAL-OK      PIC 9(01) VALUE 1.
       01  WS-IO1-TOTIENT-SYNTHESIS.
           05  WS-ALL-IO1-PROVEN           PIC 9(01) VALUE 1.
           05  WS-TOTAL-IO1-CODE           PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-EVALUATE-AUDIT-AND-TOTIENT.
           PERFORM 2000-EVALUATE-ALIGN-AND-LATENCY.
           PERFORM 3000-SYNTHESIZE-IO1-PROOFS.
           GOBACK.
       1000-EVALUATE-AUDIT-AND-TOTIENT.
           MOVE 1 TO WS-OPCODE-AUDIT-OK.
           MOVE 1 TO WS-TOTIENT-RESIDUE-OK.
       2000-EVALUATE-ALIGN-AND-LATENCY.
           MOVE 1 TO WS-WORD-ALIGNMENT-OK.
           MOVE 1 TO WS-IO1-LATENCY-OK.
       3000-SYNTHESIZE-IO1-PROOFS.
           IF WS-OPCODE-AUDIT-OK = 1 AND
              WS-TOTIENT-RESIDUE-OK = 1 AND
              WS-WORD-ALIGNMENT-OK = 1 AND
              WS-IO1-LATENCY-OK = 1
               MOVE 1 TO WS-IO1-TOTIENT-SEAL-OK
               MOVE 1 TO WS-ALL-IO1-PROVEN
               MOVE 1 TO WS-TOTAL-IO1-CODE
           ELSE
               MOVE 0 TO WS-ALL-IO1-PROVEN
               MOVE 0 TO WS-TOTAL-IO1-CODE.
