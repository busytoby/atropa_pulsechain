        IDENTIFICATION DIVISION.
        PROGRAM-ID. PST-ATK-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / POST THINKING ATTENTION SINK AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-ATK-PARAMS.
           05 WS-SINK-INITIAL-TOKENS    PIC 9(02) VALUE 04.
           05 WS-TAIL-REFL-TOKENS       PIC 9(03) VALUE 081.
           05 WS-KV-CACHE-HIT-T-PCT     PIC 9(03) VALUE 950.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-ATK-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-ATK-VITALITY           PIC 9(09) VALUE 0.
           05 WS-ATK-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-ATK-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-ATK-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 INITIAL-SINK-OUT-OF-BOUNDS  VALUE 2.
              88 TAIL-REFL-OUT-OF-BOUNDS     VALUE 3.
              88 KV-CACHE-HIT-RATIO-LOW      VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 ATTENTION-SINK-COLLAPSE     VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-ATTENTION-SINK
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-SINK-INITIAL-TOKENS < 2 OR WS-SINK-INITIAL-TOKENS > 8
                SET INITIAL-SINK-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-TAIL-REFL-TOKENS < 30 OR WS-TAIL-REFL-TOKENS > 150
                SET TAIL-REFL-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-KV-CACHE-HIT-T-PCT < 800 OR WS-KV-CACHE-HIT-T-PCT > 995
                SET KV-CACHE-HIT-RATIO-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-ATTENTION-SINK.
            COMPUTE WS-ATK-COMPOSITE = (WS-SINK-INITIAL-TOKENS * 50) +
                                       (WS-TAIL-REFL-TOKENS * 2) +
                                       (WS-KV-CACHE-HIT-T-PCT / 2).

            COMPUTE WS-ATK-VITALITY = (WS-ATK-COMPOSITE / 4) +
                                      (WS-KV-CACHE-HIT-T-PCT / 4) +
                                      (WS-SINK-INITIAL-TOKENS * 10) + 1.

            IF WS-ATK-VITALITY EQUAL ZERO
                SET ATTENTION-SINK-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-ATK-COHERENCE = (WS-ATK-COMPOSITE / 16) +
                                       (WS-KV-CACHE-HIT-T-PCT / 16) +
                                       (WS-SINK-INITIAL-TOKENS * 2).

            COMPUTE WS-ATK-REBAR-LATCH = 1470169088 +
                                         (WS-ATK-COMPOSITE / 2) +
                                         (WS-SINK-INITIAL-TOKENS * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-ATK-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-ATK-VITALITY * 10) +
                                         (WS-ATK-COHERENCE * 10) +
                                         (WS-ATK-COMPOSITE * 10) +
                                         (WS-ATK-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-ATK-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-ATK-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
