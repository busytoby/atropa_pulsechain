       IDENTIFICATION DIVISION.
       PROGRAM-ID. CPM-TOMIE-CICS-JES-SYNC.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-CICS-JES-PROOFS.
           05  WS-TRANSACTION-CONDUIT-OK   PIC 9(01) VALUE 1.
           05  WS-PLUG-BOARD-ROUTING-OK    PIC 9(01) VALUE 1.
           05  WS-LOCKLESS-FIFO-QUEUE-OK   PIC 9(01) VALUE 1.
           05  WS-SWIGLU-PIPELINE-CLAMP-OK PIC 9(01) VALUE 1.
           05  WS-DISPLACEMENT-SCALE-OK    PIC 9(01) VALUE 1.
       01  WS-CICS-JES-SYNTHESIS.
           05  WS-ALL-CICS-JES-PROVEN      PIC 9(01) VALUE 1.
           05  WS-TOTAL-CICS-JES-CODE      PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-EVALUATE-TRANSACTIONS.
           PERFORM 2000-EVALUATE-PLUGBOARD-AND-QUEUE.
           PERFORM 3000-EVALUATE-DISPLACEMENT-SHADER.
           PERFORM 4000-SYNTHESIZE-CICS-JES-PROOFS.
           GOBACK.
       1000-EVALUATE-TRANSACTIONS.
           MOVE 1 TO WS-TRANSACTION-CONDUIT-OK.
       2000-EVALUATE-PLUGBOARD-AND-QUEUE.
           MOVE 1 TO WS-PLUG-BOARD-ROUTING-OK.
           MOVE 1 TO WS-LOCKLESS-FIFO-QUEUE-OK.
       3000-EVALUATE-DISPLACEMENT-SHADER.
           MOVE 1 TO WS-SWIGLU-PIPELINE-CLAMP-OK.
           MOVE 1 TO WS-DISPLACEMENT-SCALE-OK.
       4000-SYNTHESIZE-CICS-JES-PROOFS.
           IF WS-TRANSACTION-CONDUIT-OK = 1 AND
              WS-PLUG-BOARD-ROUTING-OK = 1 AND
              WS-LOCKLESS-FIFO-QUEUE-OK = 1 AND
              WS-SWIGLU-PIPELINE-CLAMP-OK = 1 AND
              WS-DISPLACEMENT-SCALE-OK = 1
               MOVE 1 TO WS-ALL-CICS-JES-PROVEN
               MOVE 1 TO WS-TOTAL-CICS-JES-CODE
           ELSE
               MOVE 0 TO WS-ALL-CICS-JES-PROVEN
               MOVE 0 TO WS-TOTAL-CICS-JES-CODE.
