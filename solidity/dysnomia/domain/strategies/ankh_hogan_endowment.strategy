       IDENTIFICATION DIVISION.
       PROGRAM-ID. ANKH-HGN-STRAT.
       AUTHOR. AUNCIENT DYSNOMIA VM / HOGAN ENDOWMENT.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-HGN-PARAMS.
          05 WS-INIT-HGN-JITTER        PIC 9(05) VALUE 11230.
          05 WS-BANKING-CHANS-M        PIC 9(02) VALUE 08.
          05 WS-ENDOW-CYCLES-N         PIC 9(02) VALUE 16.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-CURRENT-JITTER         PIC 9(05) VALUE 0.
          05 WS-STEP-IDX               PIC 9(02) VALUE 0.
          05 WS-SHADOW-HGN-BASE        PIC 9(12) VALUE 0.
          05 WS-CYC-MOD                PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-HGN-JITTER          VALUE 2.
             88 INVALID-BANKING-CHANS-M     VALUE 3.
             88 INVALID-ENDOW-CYCLES        VALUE 4.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
             88 HGN-JITTER-FAIL             VALUE 6.
             88 GATING-CLAMP-OVERFLOW       VALUE 7.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 8.
             88 CASCADE-ROLLBACK-FAIL       VALUE 9.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-HGN-EVAL
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-INIT-HGN-JITTER > 50000
               SET INVALID-HGN-JITTER TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-BANKING-CHANS-M < 1 OR WS-BANKING-CHANS-M > 16
               SET INVALID-BANKING-CHANS-M TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-ENDOW-CYCLES-N < 1 OR WS-ENDOW-CYCLES-N > 64
               SET INVALID-ENDOW-CYCLES TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-HGN-EVAL.
           MOVE WS-INIT-HGN-JITTER TO WS-CURRENT-JITTER.

           PERFORM VARYING WS-STEP-IDX FROM 1 BY 1 UNTIL WS-STEP-IDX > WS-ENDOW-CYCLES-N
               COMPUTE WS-CURRENT-JITTER = (WS-CURRENT-JITTER * 875) / 1000
           END-PERFORM.

           IF WS-CURRENT-JITTER > WS-INIT-HGN-JITTER
               SET HGN-JITTER-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-SHADOW-HGN-BASE = (WS-CICS-WRITER-ID * 1000000) + 
               (WS-ENDOW-CYCLES-N * 10000) + (WS-BANKING-CHANS-M * 100) + (WS-CURRENT-JITTER / 16).

           COMPUTE WS-CYC-MOD = FUNCTION MOD(WS-BANKING-CHANS-M, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-CYC-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-HGN-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-HGN-BASE + ((WS-CURRENT-JITTER * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-HGN-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-ENDOW-CYCLES-N * 10000) + (WS-BANKING-CHANS-M * 100) + (WS-CURRENT-JITTER / 16))
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-HGN-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
