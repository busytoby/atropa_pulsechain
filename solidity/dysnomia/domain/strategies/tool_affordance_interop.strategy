        IDENTIFICATION DIVISION.
        PROGRAM-ID. TAI-TOO-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / TOOL AFFORDANCE INTEROP AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-TAI-PARAMS.
           05 WS-MAPPING-LAT-MS         PIC 9(02) VALUE 12.
           05 WS-INTEROP-FID-M          PIC 9(04) VALUE 0960.
           05 WS-RUNOUT-ERROR-UM        PIC 9(02) VALUE 01.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-TAI-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-TAI-VITALITY           PIC 9(09) VALUE 0.
           05 WS-TAI-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-TAI-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-TAI-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 MAPPING-LAT-OUT-OF-BOUNDS   VALUE 2.
              88 INTEROP-FIDELITY-LOW        VALUE 3.
              88 RUNOUT-ERROR-EXCEEDED       VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 AFFORDANCE-COLLAPSE         VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-TOOL-AFFORDANCE
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3 AND WS-K-EXPONENT NOT EQUAL 4
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-MAPPING-LAT-MS < 5 OR WS-MAPPING-LAT-MS > 25
                SET MAPPING-LAT-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-INTEROP-FID-M < 850 OR WS-INTEROP-FID-M > 1000
                SET INTEROP-FIDELITY-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-RUNOUT-ERROR-UM < 0 OR WS-RUNOUT-ERROR-UM > 5
                SET RUNOUT-ERROR-EXCEEDED TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-TOOL-AFFORDANCE.
            COMPUTE WS-TAI-COMPOSITE = ((30 - WS-MAPPING-LAT-MS) * 20) +
                                       (WS-INTEROP-FID-M / 2) +
                                       ((10 - WS-RUNOUT-ERROR-UM) * 40).

            COMPUTE WS-TAI-VITALITY = (WS-TAI-COMPOSITE / 4) +
                                      (WS-INTEROP-FID-M / 4) +
                                      ((30 - WS-MAPPING-LAT-MS) * 4) + 1.

            IF WS-TAI-VITALITY EQUAL ZERO
                SET AFFORDANCE-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-TAI-COHERENCE = (WS-TAI-COMPOSITE / 16) +
                                       (WS-INTEROP-FID-M / 16) +
                                       ((30 - WS-MAPPING-LAT-MS) * 2).

            COMPUTE WS-TAI-REBAR-LATCH = 1470169088 +
                                         (WS-TAI-COMPOSITE / 2) +
                                         ((30 - WS-MAPPING-LAT-MS) * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-TAI-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-TAI-VITALITY * 10) +
                                         (WS-TAI-COHERENCE * 10) +
                                         (WS-TAI-COMPOSITE * 10) +
                                         (WS-TAI-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-TAI-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-TAI-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
