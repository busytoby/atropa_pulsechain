        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-VSEN-SSSFLEEC.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-VSEN-SSSFLEEC-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1966-SSS-DIPOLE-OK     PIC 9(01) VALUE 1.
            05  WS-TH1967-BSSRDF-ENERGY-OK  PIC 9(01) VALUE 1.
            05  WS-TH1968-FLEECE-FET-OK     PIC 9(01) VALUE 1.
            05  WS-TH1969-1970M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1970-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-VSEN-SSSFLEEC-WIT        PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-VSEN-SSSFLEEC.
            GOBACK.
        1000-EVALUATE-VSEN-SSSFLEEC.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1966-SSS-DIPOLE-OK = 1 AND
               WS-TH1967-BSSRDF-ENERGY-OK = 1 AND
               WS-TH1968-FLEECE-FET-OK = 1 AND
               WS-TH1969-1970M-SAAT-OK = 1 AND
               WS-TH1970-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-VSEN-SSSFLEEC-WIT
            ELSE
                MOVE 0 TO WS-VSEN-SSSFLEEC-WIT.
