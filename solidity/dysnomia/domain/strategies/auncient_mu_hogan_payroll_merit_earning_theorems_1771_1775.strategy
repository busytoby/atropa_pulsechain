        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-HOGAN-PAYROLL.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-PAYROLL-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1771-PAYROLL-OK        PIC 9(01) VALUE 1.
            05  WS-TH1772-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1773-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1774-1775M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1775-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-PAYROLL-WIT              PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-PAYROLL.
            GOBACK.
        1000-EVALUATE-PAYROLL.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1771-PAYROLL-OK = 1 AND
               WS-TH1772-DATBIN-STRAT-OK = 1 AND
               WS-TH1773-SUBMICRO-LAT-OK = 1 AND
               WS-TH1774-1775M-SAAT-OK = 1 AND
               WS-TH1775-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-PAYROLL-WIT
            ELSE
                MOVE 0 TO WS-PAYROLL-WIT.
