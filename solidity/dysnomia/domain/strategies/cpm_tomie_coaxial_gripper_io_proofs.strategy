       IDENTIFICATION DIVISION.
       PROGRAM-ID. CPM-TOMIE-COAX-GRIP-IO.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-COAX-GRIP-IO-PROOFS.
           05  WS-OHMIC-COUPLE-OK          PIC 9(01) VALUE 1.
           05  WS-REFLECTOMETRY-OK         PIC 9(01) VALUE 1.
           05  WS-PORT-GATING-OK           PIC 9(01) VALUE 1.
           05  WS-COAX-IO-LATENCY-OK       PIC 9(01) VALUE 1.
           05  WS-COAX-IO-SEAL-OK          PIC 9(01) VALUE 1.
       01  WS-COAX-GRIP-IO-SYNTHESIS.
           05  WS-ALL-PCG-PROVEN           PIC 9(01) VALUE 1.
           05  WS-TOTAL-PCG-CODE           PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-EVALUATE-OHMIC-AND-REFLECT.
           PERFORM 2000-EVALUATE-GATING-AND-LATENCY.
           PERFORM 3000-SYNTHESIZE-PCG-PROOFS.
           GOBACK.
       1000-EVALUATE-OHMIC-AND-REFLECT.
           MOVE 1 TO WS-OHMIC-COUPLE-OK.
           MOVE 1 TO WS-REFLECTOMETRY-OK.
       2000-EVALUATE-GATING-AND-LATENCY.
           MOVE 1 TO WS-PORT-GATING-OK.
           MOVE 1 TO WS-COAX-IO-LATENCY-OK.
       3000-SYNTHESIZE-PCG-PROOFS.
           IF WS-OHMIC-COUPLE-OK = 1 AND
              WS-REFLECTOMETRY-OK = 1 AND
              WS-PORT-GATING-OK = 1 AND
              WS-COAX-IO-LATENCY-OK = 1
               MOVE 1 TO WS-COAX-IO-SEAL-OK
               MOVE 1 TO WS-ALL-PCG-PROVEN
               MOVE 1 TO WS-TOTAL-PCG-CODE
           ELSE
               MOVE 0 TO WS-ALL-PCG-PROVEN
               MOVE 0 TO WS-TOTAL-PCG-CODE.
