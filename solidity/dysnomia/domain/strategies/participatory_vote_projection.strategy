        IDENTIFICATION DIVISION.
        PROGRAM-ID. VOTE-PROJ-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / PARTICIPATORY VOTE PROJECTION AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-VOTE-PARAMS.
           05 WS-VOTES-PROX             PIC 9(06) VALUE 000450.
           05 WS-VOTES-PARA             PIC 9(06) VALUE 001250.
           05 WS-VOTES-GAZE             PIC 9(06) VALUE 000980.
           05 WS-VOTES-ERR              PIC 9(06) VALUE 000620.
           05 WS-VOTES-FACE             PIC 9(06) VALUE 000840.
           05 WS-VOTES-LANG             PIC 9(06) VALUE 000360.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-TOTAL-VOTES            PIC 9(08) VALUE 0.
           05 WS-WEIGHT-PARA            PIC 9(04) VALUE 0.
           05 WS-WEIGHT-GAZE            PIC 9(04) VALUE 0.
           05 WS-PROJ-VITALITY          PIC 9(09) VALUE 0.
           05 WS-PROJ-COHERENCE         PIC 9(09) VALUE 0.
           05 WS-PROJ-REBAR-LATCH       PIC 9(12) VALUE 0.
           05 WS-SHADOW-PROJ-BASE       PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 INVALID-VOTE-RANGE          VALUE 2.
              88 TOTAL-VOTES-FLOOR-FAIL      VALUE 3.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 4.
              88 PROJECTION-VITALITY-COLLAPSE VALUE 5.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 6.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-VOTE-PROJECTION
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-VOTES-PROX > 100000 OR WS-VOTES-PARA > 100000 OR
               WS-VOTES-GAZE > 100000 OR WS-VOTES-ERR > 100000 OR
               WS-VOTES-FACE > 100000 OR WS-VOTES-LANG > 100000
                SET INVALID-VOTE-RANGE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-TOTAL-VOTES = WS-VOTES-PROX + WS-VOTES-PARA +
                                     WS-VOTES-GAZE + WS-VOTES-ERR +
                                     WS-VOTES-FACE + WS-VOTES-LANG.

            IF WS-TOTAL-VOTES < 10
                SET TOTAL-VOTES-FLOOR-FAIL TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-VOTE-PROJECTION.
            COMPUTE WS-WEIGHT-PARA = (WS-VOTES-PARA * 1000) / WS-TOTAL-VOTES.
            COMPUTE WS-WEIGHT-GAZE = (WS-VOTES-GAZE * 1000) / WS-TOTAL-VOTES.

            COMPUTE WS-PROJ-VITALITY = (WS-WEIGHT-PARA / 4) +
                                       (WS-WEIGHT-GAZE / 8) +
                                       (WS-TOTAL-VOTES / 100) + 1.

            IF WS-PROJ-VITALITY EQUAL ZERO
                SET PROJECTION-VITALITY-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-PROJ-COHERENCE = (WS-WEIGHT-PARA / 16) +
                                        (WS-WEIGHT-GAZE / 32) +
                                        (WS-TOTAL-VOTES / 400).

            COMPUTE WS-PROJ-REBAR-LATCH = 1470169088 +
                                          (WS-WEIGHT-PARA / 2) +
                                          (WS-WEIGHT-GAZE / 4) +
                                          (WS-TOTAL-VOTES / 50).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-PROJ-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                          (WS-PROJ-VITALITY * 10) +
                                          (WS-PROJ-COHERENCE * 10) +
                                          (WS-WEIGHT-PARA * 10) +
                                          (WS-PROJ-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-PROJ-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-PROJ-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
