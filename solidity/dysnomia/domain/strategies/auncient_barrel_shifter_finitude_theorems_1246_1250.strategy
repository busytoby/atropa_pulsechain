        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FINITUDE.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FINITUDE-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1246-FINITE-OK         PIC 9(01) VALUE 1.
            05  WS-TH1247-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1248-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1249-1250M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1250-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-FINITUDE-WIT             PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-FINITUDE.
            GOBACK.
        1000-EVALUATE-FINITUDE.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1246-FINITE-OK = 1 AND
               WS-TH1247-DATBIN-STRAT-OK = 1 AND
               WS-TH1248-SUBMICRO-LAT-OK = 1 AND
               WS-TH1249-1250M-SAAT-OK = 1 AND
               WS-TH1250-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-FINITUDE-WIT
            ELSE
                MOVE 0 TO WS-FINITUDE-WIT.
