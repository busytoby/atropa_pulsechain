        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-LOGIT-INTERCEPT.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-LOGIT-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1821-LOGIT-OK          PIC 9(01) VALUE 1.
            05  WS-TH1822-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1823-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1824-1825M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1825-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-LOGIT-WIT                PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-LOGIT.
            GOBACK.
        1000-EVALUATE-LOGIT.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1821-LOGIT-OK = 1 AND
               WS-TH1822-DATBIN-STRAT-OK = 1 AND
               WS-TH1823-SUBMICRO-LAT-OK = 1 AND
               WS-TH1824-1825M-SAAT-OK = 1 AND
               WS-TH1825-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-LOGIT-WIT
            ELSE
                MOVE 0 TO WS-LOGIT-WIT.
