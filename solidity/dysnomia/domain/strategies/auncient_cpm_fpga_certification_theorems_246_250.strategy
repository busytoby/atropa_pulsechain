        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-CPM-FPGA-CERT.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-CERT-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH246-SYNTHESIS-OK       PIC 9(01) VALUE 1.
            05  WS-TH247-TIMING-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-TH248-DSP-ACCEL-OK       PIC 9(01) VALUE 1.
            05  WS-TH249-DUAL-PATH-SCSI-OK  PIC 9(01) VALUE 1.
            05  WS-TH250-SEAL-OK            PIC 9(01) VALUE 1.
            05  WS-FPGA-CERT-WITNESS        PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-FPGA-CERT.
            GOBACK.
        1000-EVALUATE-FPGA-CERT.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH246-SYNTHESIS-OK = 1 AND
               WS-TH247-TIMING-CLOSURE-OK = 1 AND
               WS-TH248-DSP-ACCEL-OK = 1 AND
               WS-TH249-DUAL-PATH-SCSI-OK = 1 AND
               WS-TH250-SEAL-OK = 1
                MOVE 1 TO WS-FPGA-CERT-WITNESS
            ELSE
                MOVE 0 TO WS-FPGA-CERT-WITNESS.
