IDENTIFICATION DIVISION.
PROGRAM-ID. PROG-HARVARD-ZUO-COUPLING.

DATA DIVISION.
01 D0-SUBSTRATE-TRUNK.
   05 D0-MOTZKIN-PRIME     PIC 9(9) USAGE R0.
   05 D0-K-EXPONENT        PIC 9(9) USAGE R1.
   05 D0-BLEED-FAULT-FLAG  PIC 9(9) USAGE R2.
01 D1-COUPLING-SHADOW.
   05 D1-LOW-SHORT-WORD    PIC 9(9) USAGE R3.
   05 D1-HIGH-SHORT-WORD   PIC 9(9) USAGE R4.
   05 D1-SHADOW-LOW-SNAP   PIC 9(9) USAGE R5.
01 D2-PARTITION-STAGE.
   05 D2-COUPLED-LONG-WORD PIC 9(12) USAGE R6.
   05 D2-REC-LOW-WORD      PIC 9(9) USAGE R7.
   05 D2-REC-HIGH-WORD     PIC 9(9) USAGE R8.
   05 D2-G-SWIGLU-GATE     PIC 9(9) USAGE R9.
   05 D2-COMMITTED-STATE   PIC 9(9) USAGE R10.
01 D3-LEAF-EVAL.
   05 D3-PROOF-RULING      PIC 9(9) USAGE R11.
   05 D3-DISP-WRAP-MOD     PIC 9(9) USAGE R12.

PROCEDURE DIVISION.
    MOVE 953467954 TO D0-MOTZKIN-PRIME.
    MOVE 3 TO D0-K-EXPONENT.
    MOVE 0 TO D0-BLEED-FAULT-FLAG.
    MOVE 43605 TO D1-LOW-SHORT-WORD.
    MOVE 87210 TO D1-HIGH-SHORT-WORD.

    PERFORM STAGE-WORD-COUPLING.
    PERFORM APPLY-BLEED-LATCH.
    PERFORM SYNC-DISPLACEMENT.

    IF D1-SHADOW-LOW-SNAP == D1-LOW-SHORT-WORD AND D2-REC-LOW-WORD == 43605 AND D2-REC-HIGH-WORD == 87210
        MOVE 0 TO D3-PROOF-RULING
        SET depth 4
    ELSE
        MOVE 4 TO D3-PROOF-RULING
        SET depth 1
    END-IF.

    EVAL.
    GO TO END-STRATEGY.

STAGE-WORD-COUPLING.
    MOVE D1-LOW-SHORT-WORD TO D1-SHADOW-LOW-SNAP.
    COMPUTE D2-COUPLED-LONG-WORD = (D1-HIGH-SHORT-WORD * 262144) + D1-LOW-SHORT-WORD.
    COMPUTE D2-REC-HIGH-WORD = D2-COUPLED-LONG-WORD / 262144.
    COMPUTE D2-REC-LOW-WORD = D2-COUPLED-LONG-WORD - (D2-REC-HIGH-WORD * 262144).
    COMPUTE D2-G-SWIGLU-GATE = 875 + ((125 * (D1-LOW-SHORT-WORD - ((D1-LOW-SHORT-WORD / 1000) * 1000))) / 1000).
    EXIT.

APPLY-BLEED-LATCH.
    IF D0-BLEED-FAULT-FLAG == 1
        MOVE D1-SHADOW-LOW-SNAP TO D2-COMMITTED-STATE
    ELSE
        COMPUTE D2-COMMITTED-STATE = ((D2-COUPLED-LONG-WORD - ((D2-COUPLED-LONG-WORD / 1000000) * 1000000)) * D2-G-SWIGLU-GATE) / 1000
    END-IF.
    EXIT.

SYNC-DISPLACEMENT.
    COMPUTE D3-DISP-WRAP-MOD = D2-COMMITTED-STATE - ((D2-COMMITTED-STATE / 256) * 256).
    EXIT.

END-STRATEGY.
