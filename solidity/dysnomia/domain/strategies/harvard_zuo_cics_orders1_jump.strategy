IDENTIFICATION DIVISION.
PROGRAM-ID. PROG-HARVARD-ZUO-CICS-ORDERS1.

DATA DIVISION.
01 D0-SUBSTRATE-TRUNK.
   05 D0-MOTZKIN-PRIME     PIC 9(9) USAGE R0.
   05 D0-K-EXPONENT        PIC 9(9) USAGE R1.
   05 D0-CICS-VECTOR       PIC 9(9) USAGE R2.
01 D1-CICS-SHADOW.
   05 D1-BASE-ADDRESS      PIC 9(9) USAGE R3.
   05 D1-THETA-OFFSET      PIC 9(9) USAGE R4.
   05 D1-SHADOW-BASE-SNAP  PIC 9(9) USAGE R5.
01 D2-WHEELER-STAGE.
   05 D2-EFFECTIVE-ADDR    PIC 9(9) USAGE R6.
   05 D2-OVERRUN-FLAG      PIC 9(1) USAGE R7.
   05 D2-TARGET-PC         PIC 9(9) USAGE R8.
   05 D2-G-SWIGLU-GATE     PIC 9(9) USAGE R9.
   05 D2-COMMITTED-STATE   PIC 9(9) USAGE R10.
01 D3-LEAF-EVAL.
   05 D3-PROOF-RULING      PIC 9(9) USAGE R11.
   05 D3-DISP-WRAP-MOD     PIC 9(9) USAGE R12.

PROCEDURE DIVISION.
    MOVE 953467954 TO D0-MOTZKIN-PRIME.
    MOVE 3 TO D0-K-EXPONENT.
    MOVE 49605 TO D0-CICS-VECTOR.
    MOVE 100 TO D1-BASE-ADDRESS.
    MOVE 50 TO D1-THETA-OFFSET.

    PERFORM STAGE-WHEELER-RELOCATION.
    PERFORM EVALUATE-CICS-BRANCH.
    PERFORM SYNC-DISPLACEMENT.

    IF D1-SHADOW-BASE-SNAP == D1-BASE-ADDRESS AND D2-EFFECTIVE-ADDR == 150
        MOVE 0 TO D3-PROOF-RULING
        SET depth 4
    ELSE
        MOVE 4 TO D3-PROOF-RULING
        SET depth 1
    END-IF.

    EVAL.
    GO TO END-STRATEGY.

STAGE-WHEELER-RELOCATION.
    MOVE D1-BASE-ADDRESS TO D1-SHADOW-BASE-SNAP.
    COMPUTE D2-EFFECTIVE-ADDR = D1-BASE-ADDRESS + D1-THETA-OFFSET.
    IF D2-EFFECTIVE-ADDR >= 2048
        MOVE 1 TO D2-OVERRUN-FLAG
        COMPUTE D2-EFFECTIVE-ADDR = D2-EFFECTIVE-ADDR - ((D2-EFFECTIVE-ADDR / 2048) * 2048)
    ELSE
        MOVE 0 TO D2-OVERRUN-FLAG
    END-IF.
    COMPUTE D2-G-SWIGLU-GATE = 875 + ((125 * (D2-EFFECTIVE-ADDR - ((D2-EFFECTIVE-ADDR / 1000) * 1000))) / 1000).
    EXIT.

EVALUATE-CICS-BRANCH.
    IF D2-OVERRUN-FLAG == 1
        MOVE D0-CICS-VECTOR TO D2-TARGET-PC
        MOVE D0-CICS-VECTOR TO D2-COMMITTED-STATE
    ELSE
        MOVE D2-EFFECTIVE-ADDR TO D2-TARGET-PC
        COMPUTE D2-COMMITTED-STATE = (((D2-TARGET-PC * 1000 + 43605) * D2-G-SWIGLU-GATE) / 1000)
    END-IF.
    EXIT.

SYNC-DISPLACEMENT.
    COMPUTE D3-DISP-WRAP-MOD = D2-COMMITTED-STATE - ((D2-COMMITTED-STATE / 256) * 256).
    EXIT.

END-STRATEGY.
