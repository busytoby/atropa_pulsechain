       IDENTIFICATION DIVISION.
       PROGRAM-ID. CPM-TOMIE-PARALLEL-DELTA.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-DELTA-PROOFS.
           05  WS-IK-MAPPING-OK            PIC 9(01) VALUE 1.
           05  WS-SINGULARITY-DEFENSE-OK   PIC 9(01) VALUE 1.
           05  WS-SOCKET-STABILITY-OK      PIC 9(01) VALUE 1.
           05  WS-DELTA-LATENCY-OK         PIC 9(01) VALUE 1.
           05  WS-DELTA-SEAL-OK            PIC 9(01) VALUE 1.
       01  WS-DELTA-SYNTHESIS.
           05  WS-ALL-PDL-PROVEN           PIC 9(01) VALUE 1.
           05  WS-TOTAL-PDL-CODE           PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-EVALUATE-IK-AND-SINGULARITY.
           PERFORM 2000-EVALUATE-SOCKET-AND-LATENCY.
           PERFORM 3000-SYNTHESIZE-PDL-PROOFS.
           GOBACK.
       1000-EVALUATE-IK-AND-SINGULARITY.
           MOVE 1 TO WS-IK-MAPPING-OK.
           MOVE 1 TO WS-SINGULARITY-DEFENSE-OK.
       2000-EVALUATE-SOCKET-AND-LATENCY.
           MOVE 1 TO WS-SOCKET-STABILITY-OK.
           MOVE 1 TO WS-DELTA-LATENCY-OK.
       3000-SYNTHESIZE-PDL-PROOFS.
           IF WS-IK-MAPPING-OK = 1 AND
              WS-SINGULARITY-DEFENSE-OK = 1 AND
              WS-SOCKET-STABILITY-OK = 1 AND
              WS-DELTA-LATENCY-OK = 1
               MOVE 1 TO WS-DELTA-SEAL-OK
               MOVE 1 TO WS-ALL-PDL-PROVEN
               MOVE 1 TO WS-TOTAL-PDL-CODE
           ELSE
               MOVE 0 TO WS-ALL-PDL-PROVEN
               MOVE 0 TO WS-TOTAL-PDL-CODE.
