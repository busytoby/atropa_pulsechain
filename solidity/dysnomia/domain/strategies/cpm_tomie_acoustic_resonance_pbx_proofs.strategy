       IDENTIFICATION DIVISION.
       PROGRAM-ID. CPM-TOMIE-ACOUSTIC-PBX.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-ACOUSTIC-PBX-PROOFS.
           05  WS-FREQ-ALIGN-OK            PIC 9(01) VALUE 1.
           05  WS-PHASE-LOCK-OK            PIC 9(01) VALUE 1.
           05  WS-STROWGER-ROUTE-OK        PIC 9(01) VALUE 1.
           05  WS-PBX-LATENCY-OK           PIC 9(01) VALUE 1.
           05  WS-ACOUSTIC-PBX-SEAL-OK     PIC 9(01) VALUE 1.
       01  WS-ACOUSTIC-PBX-SYNTHESIS.
           05  WS-ALL-PBX-PROVEN           PIC 9(01) VALUE 1.
           05  WS-TOTAL-PBX-CODE           PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-EVALUATE-FREQ-AND-LOCK.
           PERFORM 2000-EVALUATE-ROUTE-AND-LATENCY.
           PERFORM 3000-SYNTHESIZE-PBX-PROOFS.
           GOBACK.
       1000-EVALUATE-FREQ-AND-LOCK.
           MOVE 1 TO WS-FREQ-ALIGN-OK.
           MOVE 1 TO WS-PHASE-LOCK-OK.
       2000-EVALUATE-ROUTE-AND-LATENCY.
           MOVE 1 TO WS-STROWGER-ROUTE-OK.
           MOVE 1 TO WS-PBX-LATENCY-OK.
       3000-SYNTHESIZE-PBX-PROOFS.
           IF WS-FREQ-ALIGN-OK = 1 AND
              WS-PHASE-LOCK-OK = 1 AND
              WS-STROWGER-ROUTE-OK = 1 AND
              WS-PBX-LATENCY-OK = 1
               MOVE 1 TO WS-ACOUSTIC-PBX-SEAL-OK
               MOVE 1 TO WS-ALL-PBX-PROVEN
               MOVE 1 TO WS-TOTAL-PBX-CODE
           ELSE
               MOVE 0 TO WS-ALL-PBX-PROVEN
               MOVE 0 TO WS-TOTAL-PBX-CODE.
