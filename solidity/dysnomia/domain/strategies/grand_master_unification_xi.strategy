        IDENTIFICATION DIVISION.
        PROGRAM-ID. GM-UXI-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / GRAND MASTER UNIFICATION XI AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-UXI-PARAMS.
           05 WS-UNIFICATION-X-M        PIC 9(04) VALUE 0920.
           05 WS-POST-THINKING-M        PIC 9(04) VALUE 0960.
           05 WS-MCP-LIGHTHOUSE-M       PIC 9(04) VALUE 0950.
           05 WS-PUBLIC-COMP-M          PIC 9(04) VALUE 0940.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-UXI-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-UXI-VITALITY           PIC 9(09) VALUE 0.
           05 WS-UXI-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-UXI-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-UXI-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 UNIFICATION-X-OUT-OF-BOUNDS VALUE 2.
              88 POST-THINKING-LOW           VALUE 3.
              88 MCP-LIGHTHOUSE-LOW          VALUE 4.
              88 PUBLIC-COMPANION-LOW        VALUE 5.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 6.
              88 UNIFICATION-XI-COLLAPSE     VALUE 7.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 8.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-UNIFICATION-XI
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-UNIFICATION-X-M < 500 OR WS-UNIFICATION-X-M > 1000
                SET UNIFICATION-X-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-POST-THINKING-M < 850 OR WS-POST-THINKING-M > 1000
                SET POST-THINKING-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-MCP-LIGHTHOUSE-M < 850 OR WS-MCP-LIGHTHOUSE-M > 1000
                SET MCP-LIGHTHOUSE-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-PUBLIC-COMP-M < 850 OR WS-PUBLIC-COMP-M > 1000
                SET PUBLIC-COMPANION-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-UNIFICATION-XI.
            COMPUTE WS-UXI-COMPOSITE = (WS-UNIFICATION-X-M / 2) +
                                       (WS-POST-THINKING-M / 4) +
                                       (WS-MCP-LIGHTHOUSE-M / 4) +
                                       (WS-PUBLIC-COMP-M / 4).

            COMPUTE WS-UXI-VITALITY = (WS-UXI-COMPOSITE / 4) +
                                      (WS-POST-THINKING-M / 8) +
                                      (WS-PUBLIC-COMP-M / 8) + 1.

            IF WS-UXI-VITALITY EQUAL ZERO
                SET UNIFICATION-XI-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-UXI-COHERENCE = (WS-UXI-COMPOSITE / 16) +
                                       (WS-MCP-LIGHTHOUSE-M / 16) +
                                       (WS-PUBLIC-COMP-M / 16).

            COMPUTE WS-UXI-REBAR-LATCH = 1470169088 +
                                         (WS-UXI-COMPOSITE / 2) +
                                         (WS-UNIFICATION-X-M * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-UXI-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-UXI-VITALITY * 10) +
                                         (WS-UXI-COHERENCE * 10) +
                                         (WS-UXI-COMPOSITE * 10) +
                                         (WS-UXI-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-UXI-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-UXI-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
