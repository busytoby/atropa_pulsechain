        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-RADIO.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-RADIO-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH261-FRAMING-OK         PIC 9(01) VALUE 1.
            05  WS-TH262-COHERENCE-OK       PIC 9(01) VALUE 1.
            05  WS-TH263-SERDES-OK          PIC 9(01) VALUE 1.
            05  WS-TH264-TELEMETRY-OK       PIC 9(01) VALUE 1.
            05  WS-TH265-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-RADIO-WITNESS       PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-FPGA-RADIO.
            GOBACK.
        1000-EVALUATE-FPGA-RADIO.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH261-FRAMING-OK = 1 AND
               WS-TH262-COHERENCE-OK = 1 AND
               WS-TH263-SERDES-OK = 1 AND
               WS-TH264-TELEMETRY-OK = 1 AND
               WS-TH265-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-RADIO-WITNESS
            ELSE
                MOVE 0 TO WS-FPGA-RADIO-WITNESS.
