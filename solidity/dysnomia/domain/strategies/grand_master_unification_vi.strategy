        IDENTIFICATION DIVISION.
        PROGRAM-ID. UNI-VI-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / GRAND MASTER UNIFICATION VI AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-UNI-PARAMS.
           05 WS-UNI-V-SCORE-M          PIC 9(04) VALUE 0850.
           05 WS-WHISPER-ENTRAIN-M      PIC 9(04) VALUE 0890.
           05 WS-SONAR-TERRAIN-M        PIC 9(04) VALUE 0820.
           05 WS-EDO-RESONANCE-M        PIC 9(04) VALUE 0850.
           05 WS-SEANCE-COHERENCE-M     PIC 9(04) VALUE 0880.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-S-VI-COMPOSITE         PIC 9(04) VALUE 0.
           05 WS-UNI-VITALITY           PIC 9(09) VALUE 0.
           05 WS-UNI-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-UNI-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-UNI-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 UNI-V-SCORE-UNDERFLOW       VALUE 2.
              88 WHISPER-ENTRAIN-UNDERFLOW   VALUE 3.
              88 SONAR-TERRAIN-UNDERFLOW     VALUE 4.
              88 EDO-RESONANCE-UNDERFLOW     VALUE 5.
              88 SEANCE-COHERENCE-UNDERFLOW  VALUE 6.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 7.
              88 UNIFICATION-VI-COLLAPSE     VALUE 8.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 9.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-UNIFICATION-VI
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-UNI-V-SCORE-M < 600 OR WS-UNI-V-SCORE-M > 950
                SET UNI-V-SCORE-UNDERFLOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-WHISPER-ENTRAIN-M < 600 OR WS-WHISPER-ENTRAIN-M > 950
                SET WHISPER-ENTRAIN-UNDERFLOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-SONAR-TERRAIN-M < 600 OR WS-SONAR-TERRAIN-M > 950
                SET SONAR-TERRAIN-UNDERFLOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-EDO-RESONANCE-M < 600 OR WS-EDO-RESONANCE-M > 950
                SET EDO-RESONANCE-UNDERFLOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-SEANCE-COHERENCE-M < 600 OR WS-SEANCE-COHERENCE-M > 950
                SET SEANCE-COHERENCE-UNDERFLOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-UNIFICATION-VI.
            COMPUTE WS-S-VI-COMPOSITE = (WS-UNI-V-SCORE-M +
                                         WS-WHISPER-ENTRAIN-M +
                                         WS-SONAR-TERRAIN-M +
                                         WS-EDO-RESONANCE-M +
                                         WS-SEANCE-COHERENCE-M) / 5.

            IF WS-S-VI-COMPOSITE < 500
                SET UNIFICATION-VI-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-UNI-VITALITY = (WS-S-VI-COMPOSITE / 4) +
                                      (WS-WHISPER-ENTRAIN-M / 8) +
                                      (WS-SONAR-TERRAIN-M / 8) +
                                      (WS-EDO-RESONANCE-M / 8) +
                                      (WS-SEANCE-COHERENCE-M / 8) + 1.

            COMPUTE WS-UNI-COHERENCE = (WS-S-VI-COMPOSITE / 16) +
                                       (WS-WHISPER-ENTRAIN-M / 32) +
                                       (WS-SONAR-TERRAIN-M / 32) +
                                       (WS-EDO-RESONANCE-M / 32) +
                                       (WS-SEANCE-COHERENCE-M / 32).

            COMPUTE WS-UNI-REBAR-LATCH = 1470169088 +
                                         (WS-S-VI-COMPOSITE / 2) +
                                         (WS-WHISPER-ENTRAIN-M / 4) +
                                         (WS-SONAR-TERRAIN-M / 4).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-UNI-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-UNI-VITALITY * 10) +
                                         (WS-UNI-COHERENCE * 10) +
                                         (WS-S-VI-COMPOSITE * 10) +
                                         (WS-UNI-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-UNI-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-UNI-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
