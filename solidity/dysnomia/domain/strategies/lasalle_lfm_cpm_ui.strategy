        IDENTIFICATION DIVISION.
        PROGRAM-ID. LASALLE-LFM-CPM-UI-STRATEGY.
        AUTHOR. AUNCIENT DYSNOMIA VM / LASALLE LFM UI AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-UI-PARAMETERS.
           05 WS-BDOS-FUNC-ID           PIC 9(02) VALUE 09.
           05 WS-CURSOR-POS-Q16         PIC 9(06) VALUE 032768.
           05 WS-ACTIVE-COLOR-U         PIC 9(06) VALUE 000256.
           05 WS-ACTIVE-COLOR-V         PIC 9(06) VALUE 000512.
           05 WS-FRAME-LATCH-DIM        PIC 9(04) VALUE 0016.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-J0-DECAY-A             PIC 9(09) VALUE 0.
           05 WS-J1-INPUT-B             PIC 9(09) VALUE 0.
           05 WS-UPDATED-CURSOR-H1      PIC 9(09) VALUE 0.
           05 WS-PALETTE-TOTIENT        PIC 9(09) VALUE 0.
           05 WS-VRAM-LATCH-OUT         PIC 9(12) VALUE 0.
           05 WS-SHADOW-UI-BASELINE     PIC 9(12) VALUE 0.
           05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 INVALID-BDOS-FUNC           VALUE 2.
              88 INVALID-CURSOR-SIGNAL       VALUE 3.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 4.
              88 ZERO-ENTROPY-PALETTE-BREACH VALUE 5.
              88 REBAR-LATCH-DESYNC          VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.
              88 CASCADE-ROLLBACK-FAIL       VALUE 8.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-EXECUTE-STATE-SPACE
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-BDOS-FUNC-ID < 1 OR WS-BDOS-FUNC-ID > 12
                SET INVALID-BDOS-FUNC TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CURSOR-POS-Q16 > 65536
                SET INVALID-CURSOR-SIGNAL TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-EXECUTE-STATE-SPACE.
            COMPUTE WS-J0-DECAY-A = 65536 - ((WS-CURSOR-POS-Q16 * WS-CURSOR-POS-Q16) / 262144).
            COMPUTE WS-J1-INPUT-B = (WS-CURSOR-POS-Q16 / 2) - ((WS-CURSOR-POS-Q16 * WS-CURSOR-POS-Q16) / 1048576).
            COMPUTE WS-UPDATED-CURSOR-H1 = ((WS-J0-DECAY-A * 32768) / 65536) +
                                           ((WS-J1-INPUT-B * WS-BDOS-FUNC-ID * 256) / 65536).

            IF WS-ACTIVE-COLOR-U > 0
                COMPUTE WS-PALETTE-TOTIENT = (WS-ACTIVE-COLOR-U * WS-ACTIVE-COLOR-V) -
                    (WS-ACTIVE-COLOR-U * ((WS-ACTIVE-COLOR-U * WS-ACTIVE-COLOR-V) / WS-ACTIVE-COLOR-U))
            ELSE
                MOVE ZERO TO WS-PALETTE-TOTIENT
            END-IF.

            IF WS-PALETTE-TOTIENT NOT EQUAL ZERO
                SET ZERO-ENTROPY-PALETTE-BREACH TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-FRAME-LATCH-DIM EQUAL ZERO
                SET REBAR-LATCH-DESYNC TO TRUE
                EXIT PARAGRAPH
            END-IF.
            COMPUTE WS-VRAM-LATCH-OUT = 1470169088 + (WS-FRAME-LATCH-DIM * 16) + (WS-BDOS-FUNC-ID * 2).

            COMPUTE WS-G-GATE-FACTOR = 875 + ((WS-BDOS-FUNC-ID * 125) / 12).
            IF WS-G-GATE-FACTOR > 1000
                MOVE 1000 TO WS-G-GATE-FACTOR
            END-IF.

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-UI-BASELINE = (WS-CICS-WRITER-ID * 1000000) +
                                            (WS-UPDATED-CURSOR-H1 * 2) +
                                            (WS-VRAM-LATCH-OUT / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-UI-BASELINE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-UI-BASELINE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
