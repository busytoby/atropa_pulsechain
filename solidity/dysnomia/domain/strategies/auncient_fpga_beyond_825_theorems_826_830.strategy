        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-BEYOND-825.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-BEYOND-825-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH826-ICAP-SCRUB-OK      PIC 9(01) VALUE 1.
            05  WS-TH827-SEU-REPAIR-OK      PIC 9(01) VALUE 1.
            05  WS-TH828-SCRUB-LAT-OK       PIC 9(01) VALUE 1.
            05  WS-TH829-830M-SAAT-OK       PIC 9(01) VALUE 1.
            05  WS-TH830-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-BEYOND-825-WIT      PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-BEYOND-825.
            GOBACK.
        1000-EVALUATE-BEYOND-825.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH826-ICAP-SCRUB-OK = 1 AND
               WS-TH827-SEU-REPAIR-OK = 1 AND
               WS-TH828-SCRUB-LAT-OK = 1 AND
               WS-TH829-830M-SAAT-OK = 1 AND
               WS-TH830-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-BEYOND-825-WIT
            ELSE
                MOVE 0 TO WS-FPGA-BEYOND-825-WIT.
