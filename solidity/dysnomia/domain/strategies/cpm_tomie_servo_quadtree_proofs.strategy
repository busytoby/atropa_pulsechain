       IDENTIFICATION DIVISION.
       PROGRAM-ID. CPM-TOMIE-SERVO-QUAD.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-SERVO-QUAD-PROOFS.
           05  WS-MORTON-QUAD-OK           PIC 9(01) VALUE 1.
           05  WS-TRIE-DECODING-OK         PIC 9(01) VALUE 1.
           05  WS-INTERLOCK-OK             PIC 9(01) VALUE 1.
           05  WS-SERVO-VM-LATENCY-OK      PIC 9(01) VALUE 1.
           05  WS-SERVO-VM-SEAL-OK         PIC 9(01) VALUE 1.
       01  WS-SERVO-QUAD-SYNTHESIS.
           05  WS-ALL-PTQ-PROVEN           PIC 9(01) VALUE 1.
           05  WS-TOTAL-PTQ-CODE           PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-EVALUATE-MORTON-AND-TRIE.
           PERFORM 2000-EVALUATE-INTERLOCK-AND-LATENCY.
           PERFORM 3000-SYNTHESIZE-PTQ-PROOFS.
           GOBACK.
       1000-EVALUATE-MORTON-AND-TRIE.
           MOVE 1 TO WS-MORTON-QUAD-OK.
           MOVE 1 TO WS-TRIE-DECODING-OK.
       2000-EVALUATE-INTERLOCK-AND-LATENCY.
           MOVE 1 TO WS-INTERLOCK-OK.
           MOVE 1 TO WS-SERVO-VM-LATENCY-OK.
       3000-SYNTHESIZE-PTQ-PROOFS.
           IF WS-MORTON-QUAD-OK = 1 AND
              WS-TRIE-DECODING-OK = 1 AND
              WS-INTERLOCK-OK = 1 AND
              WS-SERVO-VM-LATENCY-OK = 1
               MOVE 1 TO WS-SERVO-VM-SEAL-OK
               MOVE 1 TO WS-ALL-PTQ-PROVEN
               MOVE 1 TO WS-TOTAL-PTQ-CODE
           ELSE
               MOVE 0 TO WS-ALL-PTQ-PROVEN
               MOVE 0 TO WS-TOTAL-PTQ-CODE.
