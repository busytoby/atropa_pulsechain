        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-VSEN-ALL.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-VSEN-ALL-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1031-ALL-FEATURES-OK   PIC 9(01) VALUE 1.
            05  WS-TH1032-4DOMAIN-OK        PIC 9(01) VALUE 1.
            05  WS-TH1033-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1034-1035M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1035-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-VSEN-ALL-WIT             PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-VSEN-ALL.
            GOBACK.
        1000-EVALUATE-VSEN-ALL.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1031-ALL-FEATURES-OK = 1 AND
               WS-TH1032-4DOMAIN-OK = 1 AND
               WS-TH1033-SUBMICRO-LAT-OK = 1 AND
               WS-TH1034-1035M-SAAT-OK = 1 AND
               WS-TH1035-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-VSEN-ALL-WIT
            ELSE
                MOVE 0 TO WS-VSEN-ALL-WIT.
