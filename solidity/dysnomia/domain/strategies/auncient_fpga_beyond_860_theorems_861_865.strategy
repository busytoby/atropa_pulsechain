        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-BEYOND-860.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-BEYOND-860-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH861-ZORSE-TORO-OK      PIC 9(01) VALUE 1.
            05  WS-TH862-TORO-MERKLE-OK     PIC 9(01) VALUE 1.
            05  WS-TH863-JITTER-LAT-OK      PIC 9(01) VALUE 1.
            05  WS-TH864-865M-SAAT-OK       PIC 9(01) VALUE 1.
            05  WS-TH865-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-BEYOND-860-WIT      PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-BEYOND-860.
            GOBACK.
        1000-EVALUATE-BEYOND-860.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH861-ZORSE-TORO-OK = 1 AND
               WS-TH862-TORO-MERKLE-OK = 1 AND
               WS-TH863-JITTER-LAT-OK = 1 AND
               WS-TH864-865M-SAAT-OK = 1 AND
               WS-TH865-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-BEYOND-860-WIT
            ELSE
                MOVE 0 TO WS-FPGA-BEYOND-860-WIT.
