        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-ROUSE-ANDERSON-990.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-ROUSE-ANDERSON-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH991-INTERNAL-MODEL-OK  PIC 9(01) VALUE 1.
            05  WS-TH992-EQUITY-MERKLE-OK   PIC 9(01) VALUE 1.
            05  WS-TH993-MODEL-LAT-OK       PIC 9(01) VALUE 1.
            05  WS-TH994-995M-SAAT-OK       PIC 9(01) VALUE 1.
            05  WS-TH995-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-ROUSE-ANDERSON-WIT       PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-ROUSE-ANDERSON.
            GOBACK.
        1000-EVALUATE-ROUSE-ANDERSON.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH991-INTERNAL-MODEL-OK = 1 AND
               WS-TH992-EQUITY-MERKLE-OK = 1 AND
               WS-TH993-MODEL-LAT-OK = 1 AND
               WS-TH994-995M-SAAT-OK = 1 AND
               WS-TH995-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-ROUSE-ANDERSON-WIT
            ELSE
                MOVE 0 TO WS-ROUSE-ANDERSON-WIT.
