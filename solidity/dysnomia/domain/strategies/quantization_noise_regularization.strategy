        IDENTIFICATION DIVISION.
        PROGRAM-ID. QUANT-REGULAR-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / REGULARIZATION AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-REG-PARAMS.
           05 WS-PRECISION-BITS         PIC 9(02) VALUE 01.
           05 WS-CLIPPING-BOUND         PIC 9(04) VALUE 0500.
           05 WS-NOISE-MARGIN           PIC 9(02) VALUE 15.
           05 WS-STABILITY-FLAG         PIC 9(01) VALUE 1.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-REG-VITALITY           PIC 9(09) VALUE 0.
           05 WS-REG-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-REG-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-REG-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 INVALID-PRECISION-BITS      VALUE 2.
              88 INVALID-CLIPPING-BOUND      VALUE 3.
              88 INVALID-NOISE-MARGIN        VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 REG-STABILITY-FAIL          VALUE 6.
              88 REG-DIVERG-FAIL             VALUE 7.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 8.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-REGULARIZATION
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-PRECISION-BITS < 1 OR WS-PRECISION-BITS > 8
                SET INVALID-PRECISION-BITS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CLIPPING-BOUND < 10 OR WS-CLIPPING-BOUND > 1000
                SET INVALID-CLIPPING-BOUND TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-NOISE-MARGIN < 1 OR WS-NOISE-MARGIN > 30
                SET INVALID-NOISE-MARGIN TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-STABILITY-FLAG NOT EQUAL 1
                SET REG-STABILITY-FAIL TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-REGULARIZATION.
            COMPUTE WS-REG-VITALITY = (WS-PRECISION-BITS * 512) +
                                      (WS-CLIPPING-BOUND / 2) +
                                      (WS-NOISE-MARGIN * 32) +
                                      (WS-STABILITY-FLAG * 256) + 1.

            IF WS-REG-VITALITY EQUAL ZERO
                SET REG-DIVERG-FAIL TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-REG-COHERENCE = (WS-PRECISION-BITS * 64) +
                                       (WS-CLIPPING-BOUND / 8) +
                                       (WS-NOISE-MARGIN * 16).

            COMPUTE WS-REG-REBAR-LATCH = 1470169088 + (WS-PRECISION-BITS * 256) +
                                         (WS-CLIPPING-BOUND / 4) +
                                         (WS-NOISE-MARGIN * 64).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-REG-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-REG-VITALITY * 10) +
                                         (WS-REG-COHERENCE * 10) +
                                         (WS-PRECISION-BITS * 1000) +
                                         (WS-REG-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-REG-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-REG-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
