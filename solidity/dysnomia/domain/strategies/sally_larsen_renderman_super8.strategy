        IDENTIFICATION DIVISION.
        PROGRAM-ID. LARSEN-RENDERMAN-SUPER8-STRATEGY.
        AUTHOR. AUNCIENT DYSNOMIA VM / RENDERMAN CINEMA AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-CINEMA-PARAMETERS.
           05 WS-ASPECT-RATIO-Q16       PIC 9(06) VALUE 121241.
           05 WS-MICROPOLY-GRID-SIZE    PIC 9(02) VALUE 04.
           05 WS-EXPOSURE-FSTOP-Q16     PIC 9(06) VALUE 032768.
           05 WS-SHUTTER-ANGLE-DEG      PIC 9(03) VALUE 180.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-REYES-DICED-MICROPOLYS PIC 9(09) VALUE 0.
           05 WS-RSL-SHADED-RADIANCE    PIC 9(09) VALUE 0.
           05 WS-CINEMA-REBAR-LATCH     PIC 9(12) VALUE 0.
           05 WS-SHADOW-CINEMA-BASE     PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 INVALID-ASPECT-RATIO        VALUE 2.
              88 INVALID-GRID-SIZE           VALUE 3.
              88 INVALID-EXPOSURE            VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 INVALID-SHUTTER-ANGLE       VALUE 6.
              88 REYES-UNDERFLOW-FAIL        VALUE 7.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 8.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-RENDERMAN-CINEMA
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-ASPECT-RATIO-Q16 < 80000 OR WS-ASPECT-RATIO-Q16 > 160000
                SET INVALID-ASPECT-RATIO TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-MICROPOLY-GRID-SIZE < 1 OR WS-MICROPOLY-GRID-SIZE > 16
                SET INVALID-GRID-SIZE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-EXPOSURE-FSTOP-Q16 > 65536
                SET INVALID-EXPOSURE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-SHUTTER-ANGLE-DEG < 90 OR WS-SHUTTER-ANGLE-DEG > 180
                SET INVALID-SHUTTER-ANGLE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-RENDERMAN-CINEMA.
            COMPUTE WS-REYES-DICED-MICROPOLYS = ((16 / WS-MICROPOLY-GRID-SIZE) * 1024) +
                                                (WS-ASPECT-RATIO-Q16 / 1000) + 1.

            IF WS-REYES-DICED-MICROPOLYS EQUAL ZERO
                SET REYES-UNDERFLOW-FAIL TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-RSL-SHADED-RADIANCE = ((WS-EXPOSURE-FSTOP-Q16 * 875) / 10000) +
                                             (WS-SHUTTER-ANGLE-DEG * 10).

            COMPUTE WS-CINEMA-REBAR-LATCH = 1470169088 + (WS-ASPECT-RATIO-Q16 / 100) +
                                            (WS-MICROPOLY-GRID-SIZE * 64) + WS-SHUTTER-ANGLE-DEG.

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-CINEMA-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                            (WS-REYES-DICED-MICROPOLYS * 10) +
                                            (WS-RSL-SHADED-RADIANCE * 10) +
                                            (WS-SHUTTER-ANGLE-DEG * 100) +
                                            (WS-CINEMA-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-CINEMA-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-CINEMA-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
