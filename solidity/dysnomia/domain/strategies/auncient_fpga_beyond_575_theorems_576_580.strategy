        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-BEYOND-575.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-BEYOND-575-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH576-DAT-TRIGRAM-OK     PIC 9(01) VALUE 1.
            05  WS-TH577-BLACK-RED-HEX-OK   PIC 9(01) VALUE 1.
            05  WS-TH578-DAT-LATENCY-OK     PIC 9(01) VALUE 1.
            05  WS-TH579-BLACK-RED-SAAT-OK  PIC 9(01) VALUE 1.
            05  WS-TH580-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-BEYOND-575-WIT      PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-BEYOND-575.
            GOBACK.
        1000-EVALUATE-BEYOND-575.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH576-DAT-TRIGRAM-OK = 1 AND
               WS-TH577-BLACK-RED-HEX-OK = 1 AND
               WS-TH578-DAT-LATENCY-OK = 1 AND
               WS-TH579-BLACK-RED-SAAT-OK = 1 AND
               WS-TH580-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-BEYOND-575-WIT
            ELSE
                MOVE 0 TO WS-FPGA-BEYOND-575-WIT.
