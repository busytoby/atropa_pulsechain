        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-ZKSAT-R1CS.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-ZKSAT-R1CS-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1521-R1CS-OK           PIC 9(01) VALUE 1.
            05  WS-TH1522-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1523-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1524-1525M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1525-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-ZKSAT-R1CS-WIT           PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-ZKSAT-R1CS.
            GOBACK.
        1000-EVALUATE-ZKSAT-R1CS.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1521-R1CS-OK = 1 AND
               WS-TH1522-DATBIN-STRAT-OK = 1 AND
               WS-TH1523-SUBMICRO-LAT-OK = 1 AND
               WS-TH1524-1525M-SAAT-OK = 1 AND
               WS-TH1525-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-ZKSAT-R1CS-WIT
            ELSE
                MOVE 0 TO WS-ZKSAT-R1CS-WIT.
