        IDENTIFICATION DIVISION.
        PROGRAM-ID. BNK-CUR-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / BANKNOTE CURRENCY FEATURE AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-CUR-PARAMS.
           05 WS-COUNTRY-ORIGIN-ID      PIC 9(02) VALUE 01.
           05 WS-DENOMINATION-VAL-ID    PIC 9(03) VALUE 050.
           05 WS-CURRENCY-ANLS-M        PIC 9(04) VALUE 0278.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-CUR-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-CUR-VITALITY           PIC 9(09) VALUE 0.
           05 WS-CUR-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-CUR-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-CUR-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 COUNTRY-ORIGIN-OUT-OF-BOUNDS VALUE 2.
              88 DENOMINATION-OUT-OF-BOUNDS  VALUE 3.
              88 CURRENCY-ANLS-OUT-OF-BOUNDS VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 CURRENCY-COLLAPSE           VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-BANKNOTE-CURRENCY
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-COUNTRY-ORIGIN-ID < 1 OR WS-COUNTRY-ORIGIN-ID > 5
                SET COUNTRY-ORIGIN-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-DENOMINATION-VAL-ID < 1 OR WS-DENOMINATION-VAL-ID > 100
                SET DENOMINATION-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CURRENCY-ANLS-M < 150 OR WS-CURRENCY-ANLS-M > 450
                SET CURRENCY-ANLS-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-BANKNOTE-CURRENCY.
            COMPUTE WS-CUR-COMPOSITE = (WS-COUNTRY-ORIGIN-ID * 100) +
                                       (WS-DENOMINATION-VAL-ID * 5) +
                                       (WS-CURRENCY-ANLS-M / 2).

            COMPUTE WS-CUR-VITALITY = (WS-CUR-COMPOSITE / 4) +
                                      (WS-CURRENCY-ANLS-M / 4) +
                                      (WS-COUNTRY-ORIGIN-ID * 20) + 1.

            IF WS-CUR-VITALITY EQUAL ZERO
                SET CURRENCY-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-CUR-COHERENCE = (WS-CUR-COMPOSITE / 16) +
                                       (WS-CURRENCY-ANLS-M / 16) +
                                       (WS-COUNTRY-ORIGIN-ID * 5).

            COMPUTE WS-CUR-REBAR-LATCH = 1470169088 +
                                         (WS-CUR-COMPOSITE / 2) +
                                         (WS-COUNTRY-ORIGIN-ID * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-CUR-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-CUR-VITALITY * 10) +
                                         (WS-CUR-COHERENCE * 10) +
                                         (WS-CUR-COMPOSITE * 10) +
                                         (WS-CUR-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-CUR-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-CUR-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
