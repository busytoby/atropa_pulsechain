        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-ZJ-DEEP-FOLDING.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-ZJ-DEEP-FOLDING-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH216-DEEP-BOUND-OK      PIC 9(01) VALUE 1.
            05  WS-TH217-DRIFT-FREE-OK      PIC 9(01) VALUE 1.
            05  WS-TH218-BATCH-AGG-OK       PIC 9(01) VALUE 1.
            05  WS-TH219-CONSERVE-SAAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH220-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-ZJ-DEEP-WITNESS          PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-DEEP-FOLDING.
            GOBACK.
        1000-EVALUATE-DEEP-FOLDING.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH216-DEEP-BOUND-OK = 1 AND
               WS-TH217-DRIFT-FREE-OK = 1 AND
               WS-TH218-BATCH-AGG-OK = 1 AND
               WS-TH219-CONSERVE-SAAT-OK = 1 AND
               WS-TH220-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-ZJ-DEEP-WITNESS
            ELSE
                MOVE 0 TO WS-ZJ-DEEP-WITNESS.
