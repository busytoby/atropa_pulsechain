        IDENTIFICATION DIVISION.
        PROGRAM-ID. TACTILE-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / TACTILE RESPONSE AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-TACTILE-PARAMS.
           05 WS-PRESSURE-INTENS        PIC 9(04) VALUE 0450.
           05 WS-CONTACT-AREA-MM        PIC 9(04) VALUE 0120.
           05 WS-RESP-LATENCY-MS        PIC 9(02) VALUE 15.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-TACTILE-ENERGY         PIC 9(04) VALUE 0.
           05 WS-TACT-VITALITY          PIC 9(09) VALUE 0.
           05 WS-TACT-COHERENCE         PIC 9(09) VALUE 0.
           05 WS-TACT-REBAR-LATCH       PIC 9(12) VALUE 0.
           05 WS-SHADOW-TACT-BASE       PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 INVALID-PRESSURE-INTENS     VALUE 2.
              88 INVALID-CONTACT-AREA        VALUE 3.
              88 TACTILE-LATENCY-EXCEEDED    VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 TACTILE-VITALITY-COLLAPSE   VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-TACTILE-FEEDBACK
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-PRESSURE-INTENS < 50 OR WS-PRESSURE-INTENS > 1000
                SET INVALID-PRESSURE-INTENS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CONTACT-AREA-MM < 10 OR WS-CONTACT-AREA-MM > 500
                SET INVALID-CONTACT-AREA TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-RESP-LATENCY-MS < 1 OR WS-RESP-LATENCY-MS > 35
                SET TACTILE-LATENCY-EXCEEDED TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-TACTILE-ENERGY = (WS-PRESSURE-INTENS * WS-CONTACT-AREA-MM) / 100.
            IF WS-TACTILE-ENERGY > 1000
                MOVE 1000 TO WS-TACTILE-ENERGY
            END-IF.

            IF WS-TACTILE-ENERGY EQUAL ZERO
                SET TACTILE-VITALITY-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-TACTILE-FEEDBACK.
            COMPUTE WS-TACT-VITALITY = (WS-TACTILE-ENERGY / 4) +
                                       ((35 - WS-RESP-LATENCY-MS) * 8) +
                                       (WS-CONTACT-AREA-MM / 2) + 1.

            IF WS-TACT-VITALITY EQUAL ZERO
                SET TACTILE-VITALITY-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-TACT-COHERENCE = (WS-TACTILE-ENERGY / 16) +
                                        ((35 - WS-RESP-LATENCY-MS) * 2) +
                                        (WS-CONTACT-AREA-MM / 8).

            COMPUTE WS-TACT-REBAR-LATCH = 1470169088 +
                                          (WS-TACTILE-ENERGY / 2) +
                                          ((35 - WS-RESP-LATENCY-MS) * 16).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-TACT-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                          (WS-TACT-VITALITY * 10) +
                                          (WS-TACT-COHERENCE * 10) +
                                          (WS-TACTILE-ENERGY * 10) +
                                          (WS-TACT-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-TACT-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-TACT-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
