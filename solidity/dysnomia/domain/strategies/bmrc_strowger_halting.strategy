       IDENTIFICATION DIVISION.
       PROGRAM-ID. BMRC-STROWGER-HALTING-STRATEGY.
       AUTHOR. AUNCIENT DYSNOMIA VM / BMRC STROWGER HALTING.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-HALTING-PARAMETERS.
          05 WS-INITIAL-ENERGY-V0      PIC 9(09) VALUE 000065536.
          05 WS-EPSILON-TARGET-TOL     PIC 9(09) VALUE 000010000.
          05 WS-MAX-STEP-BOUND-T       PIC 9(02) VALUE 64.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-CURRENT-V-ENERGY       PIC 9(09) VALUE 0.
          05 WS-STEP-COUNTER           PIC 9(02) VALUE 0.
          05 WS-HALTING-CYCLE-ACHIEVED PIC 9(02) VALUE 0.
          05 WS-SHADOW-HALTING-BASE    PIC 9(12) VALUE 0.
          05 WS-CYCLE-MOD              PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-INITIAL-ENERGY      VALUE 2.
             88 INVALID-EPSILON-TOL         VALUE 3.
             88 INVALID-STEP-BOUND          VALUE 4.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
             88 HALTING-BOUND-EXCEEDED      VALUE 6.
             88 GATING-CLAMP-OVERFLOW       VALUE 7.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 8.
             88 CASCADE-ROLLBACK-FAIL       VALUE 9.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-HALTING-CONTRACTION
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-INITIAL-ENERGY-V0 EQUAL ZERO
               SET INVALID-INITIAL-ENERGY TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-EPSILON-TARGET-TOL EQUAL ZERO
               SET INVALID-EPSILON-TOL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-MAX-STEP-BOUND-T < 1 OR WS-MAX-STEP-BOUND-T > 64
               SET INVALID-STEP-BOUND TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-HALTING-CONTRACTION.
           MOVE WS-INITIAL-ENERGY-V0 TO WS-CURRENT-V-ENERGY.
           MOVE ZERO TO WS-HALTING-CYCLE-ACHIEVED.

           PERFORM VARYING WS-STEP-COUNTER FROM 1 BY 1 UNTIL WS-STEP-COUNTER > WS-MAX-STEP-BOUND-T
               COMPUTE WS-CURRENT-V-ENERGY = (WS-CURRENT-V-ENERGY * 875) / 1000
               IF WS-CURRENT-V-ENERGY <= WS-EPSILON-TARGET-TOL AND WS-HALTING-CYCLE-ACHIEVED EQUAL ZERO
                   MOVE WS-STEP-COUNTER TO WS-HALTING-CYCLE-ACHIEVED
               END-IF
           END-PERFORM.

           IF WS-HALTING-CYCLE-ACHIEVED EQUAL ZERO
               SET HALTING-BOUND-EXCEEDED TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-SHADOW-HALTING-BASE = (WS-CICS-WRITER-ID * 1000000) + 
               (WS-HALTING-CYCLE-ACHIEVED * 1000) + (WS-CURRENT-V-ENERGY / 16).

           COMPUTE WS-CYCLE-MOD = FUNCTION MOD(WS-HALTING-CYCLE-ACHIEVED, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-CYCLE-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-HALTING-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-HALTING-BASE + ((2600 * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-HALTING-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-HALTING-CYCLE-ACHIEVED * 1000) + (WS-CURRENT-V-ENERGY / 16))
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-HALTING-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
