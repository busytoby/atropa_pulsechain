        IDENTIFICATION DIVISION.
        PROGRAM-ID. PMV-PRI-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / PRIVACYMOTIV JOURNEY AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-PMV-PARAMS.
           05 WS-AUDIT-LAT-MS           PIC 9(02) VALUE 12.
           05 WS-MITIGATION-FID-M       PIC 9(04) VALUE 0960.
           05 WS-TRANSITION-DRIFT-MS    PIC 9(02) VALUE 01.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-PMV-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-PMV-VITALITY           PIC 9(09) VALUE 0.
           05 WS-PMV-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-PMV-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-PMV-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 AUDIT-LAT-OUT-OF-BOUNDS     VALUE 2.
              88 MITIGATION-FIDELITY-LOW     VALUE 3.
              88 DRIFT-EXCEEDED              VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 PRIVACYMOTIV-COLLAPSE       VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-PRIVACYMOTIV-JOURNEY
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3 AND WS-K-EXPONENT NOT EQUAL 4
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-AUDIT-LAT-MS < 5 OR WS-AUDIT-LAT-MS > 25
                SET AUDIT-LAT-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-MITIGATION-FID-M < 850 OR WS-MITIGATION-FID-M > 1000
                SET MITIGATION-FIDELITY-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-TRANSITION-DRIFT-MS < 0 OR WS-TRANSITION-DRIFT-MS > 5
                SET DRIFT-EXCEEDED TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-PRIVACYMOTIV-JOURNEY.
            COMPUTE WS-PMV-COMPOSITE = ((30 - WS-AUDIT-LAT-MS) * 20) +
                                       (WS-MITIGATION-FID-M / 2) +
                                       ((10 - WS-TRANSITION-DRIFT-MS) * 40).

            COMPUTE WS-PMV-VITALITY = (WS-PMV-COMPOSITE / 4) +
                                      (WS-MITIGATION-FID-M / 4) +
                                      ((30 - WS-AUDIT-LAT-MS) * 4) + 1.

            IF WS-PMV-VITALITY EQUAL ZERO
                SET PRIVACYMOTIV-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-PMV-COHERENCE = (WS-PMV-COMPOSITE / 16) +
                                       (WS-MITIGATION-FID-M / 16) +
                                       ((30 - WS-AUDIT-LAT-MS) * 2).

            COMPUTE WS-PMV-REBAR-LATCH = 1470169088 +
                                         (WS-PMV-COMPOSITE / 2) +
                                         ((30 - WS-AUDIT-LAT-MS) * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-PMV-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-PMV-VITALITY * 10) +
                                         (WS-PMV-COHERENCE * 10) +
                                         (WS-PMV-COMPOSITE * 10) +
                                         (WS-PMV-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-PMV-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-PMV-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
