        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-BICENTENNIAL-196-200.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-BICENTENNIAL-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH196-CLOSURE-OK         PIC 9(01) VALUE 1.
            05  WS-TH197-TK-SOUND-OK        PIC 9(01) VALUE 1.
            05  WS-TH198-ISOMORPHISM-OK     PIC 9(01) VALUE 1.
            05  WS-TH199-RULE18-OK          PIC 9(01) VALUE 1.
            05  WS-TH200-SEAL-OK            PIC 9(01) VALUE 1.
            05  WS-BICENTENNIAL-WITNESS     PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-BICENTENNIAL.
            GOBACK.
        1000-EVALUATE-BICENTENNIAL.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH196-CLOSURE-OK = 1 AND
               WS-TH197-TK-SOUND-OK = 1 AND
               WS-TH198-ISOMORPHISM-OK = 1 AND
               WS-TH199-RULE18-OK = 1 AND
               WS-TH200-SEAL-OK = 1
                MOVE 1 TO WS-BICENTENNIAL-WITNESS
            ELSE
                MOVE 0 TO WS-BICENTENNIAL-WITNESS.
