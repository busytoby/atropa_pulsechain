        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-APOGEE-SIG.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-APOGEE-SIG-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1356-SIG-OK            PIC 9(01) VALUE 1.
            05  WS-TH1357-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1358-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1359-1360M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1360-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-APOGEE-SIG-WIT           PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-APOGEE-SIG.
            GOBACK.
        1000-EVALUATE-APOGEE-SIG.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1356-SIG-OK = 1 AND
               WS-TH1357-DATBIN-STRAT-OK = 1 AND
               WS-TH1358-SUBMICRO-LAT-OK = 1 AND
               WS-TH1359-1360M-SAAT-OK = 1 AND
               WS-TH1360-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-APOGEE-SIG-WIT
            ELSE
                MOVE 0 TO WS-APOGEE-SIG-WIT.
