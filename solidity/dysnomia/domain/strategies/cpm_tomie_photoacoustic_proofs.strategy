       IDENTIFICATION DIVISION.
       PROGRAM-ID. CPM-TOMIE-PHOTO-ACOU.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-PHOTO-ACOU-PROOFS.
           05  WS-THERMOELASTIC-OK         PIC 9(01) VALUE 1.
           05  WS-PIEZO-TRANSDUCE-OK       PIC 9(01) VALUE 1.
           05  WS-BACKPROJECTION-OK        PIC 9(01) VALUE 1.
           05  WS-PHOTOAC-LATENCY-OK       PIC 9(01) VALUE 1.
           05  WS-PHOTOAC-SEAL-OK          PIC 9(01) VALUE 1.
       01  WS-PHOTO-ACOU-SYNTHESIS.
           05  WS-ALL-PPX-PROVEN           PIC 9(01) VALUE 1.
           05  WS-TOTAL-PPX-CODE           PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-EVALUATE-THERMO-AND-PIEZO.
           PERFORM 2000-EVALUATE-BACKPROJ-AND-LAT.
           PERFORM 3000-SYNTHESIZE-PPX-PROOFS.
           GOBACK.
       1000-EVALUATE-THERMO-AND-PIEZO.
           MOVE 1 TO WS-THERMOELASTIC-OK.
           MOVE 1 TO WS-PIEZO-TRANSDUCE-OK.
       2000-EVALUATE-BACKPROJ-AND-LAT.
           MOVE 1 TO WS-BACKPROJECTION-OK.
           MOVE 1 TO WS-PHOTOAC-LATENCY-OK.
       3000-SYNTHESIZE-PPX-PROOFS.
           IF WS-THERMOELASTIC-OK = 1 AND
              WS-PIEZO-TRANSDUCE-OK = 1 AND
              WS-BACKPROJECTION-OK = 1 AND
              WS-PHOTOAC-LATENCY-OK = 1
               MOVE 1 TO WS-PHOTOAC-SEAL-OK
               MOVE 1 TO WS-ALL-PPX-PROVEN
               MOVE 1 TO WS-TOTAL-PPX-CODE
           ELSE
               MOVE 0 TO WS-ALL-PPX-PROVEN
               MOVE 0 TO WS-TOTAL-PPX-CODE.
