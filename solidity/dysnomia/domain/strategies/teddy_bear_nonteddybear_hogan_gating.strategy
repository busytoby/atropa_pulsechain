        IDENTIFICATION DIVISION.
        PROGRAM-ID. TNH-HOG-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / TEDDY BEAR VS NONTEDDYBEAR HOGAN GATING AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-TNH-PARAMS.
           05 WS-PARTICIPANT-TYPE       PIC 9(01) VALUE 1.
              88 PARTICIPANT-TEDDY-BEAR VALUE 1.
              88 PARTICIPANT-ACRYLIC    VALUE 2.
              88 PARTICIPANT-BADGE      VALUE 3.
              88 PARTICIPANT-RESIN      VALUE 4.
           05 WS-DNA-FIDELITY-M         PIC 9(04) VALUE 0960.
           05 WS-HOGAN-ENDOW-SAAT       PIC 9(08) VALUE 01000000.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-TNH-COMPOSITE          PIC 9(06) VALUE 0.
           05 WS-TNH-VITALITY           PIC 9(09) VALUE 0.
           05 WS-TNH-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-TNH-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-TNH-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 UNKNOWN-PARTICIPANT-TYPE    VALUE 2.
              88 DNA-FIDELITY-LOW            VALUE 3.
              88 NONTEDDYBEAR-HOGAN-PROHIB   VALUE 4.
              88 TEDDY-BEAR-ENDOW-MISMATCH   VALUE 5.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 6.
              88 GATING-COLLAPSE             VALUE 7.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 8.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-HOGAN-GATING
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-PARTICIPANT-TYPE < 1 OR WS-PARTICIPANT-TYPE > 4
                SET UNKNOWN-PARTICIPANT-TYPE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-DNA-FIDELITY-M < 850 OR WS-DNA-FIDELITY-M > 1000
                SET DNA-FIDELITY-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-PARTICIPANT-TYPE NOT EQUAL 1 AND WS-HOGAN-ENDOW-SAAT > 0
                SET NONTEDDYBEAR-HOGAN-PROHIB TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-PARTICIPANT-TYPE EQUAL 1 AND WS-HOGAN-ENDOW-SAAT NOT EQUAL 1000000
                SET TEDDY-BEAR-ENDOW-MISMATCH TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-HOGAN-GATING.
            COMPUTE WS-TNH-COMPOSITE = (WS-PARTICIPANT-TYPE * 100) +
                                       (WS-DNA-FIDELITY-M / 2) +
                                       (WS-HOGAN-ENDOW-SAAT / 10000).

            COMPUTE WS-TNH-VITALITY = (WS-TNH-COMPOSITE / 4) +
                                      (WS-DNA-FIDELITY-M / 4) +
                                      (WS-PARTICIPANT-TYPE * 25) + 1.

            IF WS-TNH-VITALITY EQUAL ZERO
                SET GATING-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-TNH-COHERENCE = (WS-TNH-COMPOSITE / 16) +
                                       (WS-DNA-FIDELITY-M / 16) +
                                       (WS-PARTICIPANT-TYPE * 10).

            COMPUTE WS-TNH-REBAR-LATCH = 1470169088 +
                                         (WS-TNH-COMPOSITE / 2) +
                                         (WS-PARTICIPANT-TYPE * 512).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-TNH-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-TNH-VITALITY * 10) +
                                         (WS-TNH-COHERENCE * 10) +
                                         (WS-TNH-COMPOSITE * 10) +
                                         (WS-TNH-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-TNH-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-TNH-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
