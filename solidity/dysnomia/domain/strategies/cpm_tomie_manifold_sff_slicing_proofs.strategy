       IDENTIFICATION DIVISION.
       PROGRAM-ID. CPM-TOMIE-MANIFOLD-SFF-SLICING.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-MANIFOLD-SLICING-PROOFS.
           05  WS-SLICING-FIDELITY-OK      PIC 9(01) VALUE 1.
           05  WS-LAYER-ADHESION-OK        PIC 9(01) VALUE 1.
           05  WS-TOOLPATH-INVAR-OK        PIC 9(01) VALUE 1.
           05  WS-SLICING-LATENCY-OK       PIC 9(01) VALUE 1.
           05  WS-MANIFOLD-SLICING-SEAL-OK PIC 9(01) VALUE 1.
       01  WS-MANIFOLD-SLICING-SYNTHESIS.
           05  WS-ALL-SLC-PROVEN           PIC 9(01) VALUE 1.
           05  WS-TOTAL-SLC-CODE           PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-EVALUATE-SLICING-AND-ADHESION.
           PERFORM 2000-EVALUATE-TOOLPATH-AND-LATENCY.
           PERFORM 3000-SYNTHESIZE-SLC-PROOFS.
           GOBACK.
       1000-EVALUATE-SLICING-AND-ADHESION.
           MOVE 1 TO WS-SLICING-FIDELITY-OK.
           MOVE 1 TO WS-LAYER-ADHESION-OK.
       2000-EVALUATE-TOOLPATH-AND-LATENCY.
           MOVE 1 TO WS-TOOLPATH-INVAR-OK.
           MOVE 1 TO WS-SLICING-LATENCY-OK.
       3000-SYNTHESIZE-SLC-PROOFS.
           IF WS-SLICING-FIDELITY-OK = 1 AND
              WS-LAYER-ADHESION-OK = 1 AND
              WS-TOOLPATH-INVAR-OK = 1 AND
              WS-SLICING-LATENCY-OK = 1
               MOVE 1 TO WS-MANIFOLD-SLICING-SEAL-OK
               MOVE 1 TO WS-ALL-SLC-PROVEN
               MOVE 1 TO WS-TOTAL-SLC-CODE
           ELSE
               MOVE 0 TO WS-ALL-SLC-PROVEN
               MOVE 0 TO WS-TOTAL-SLC-CODE.
