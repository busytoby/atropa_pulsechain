        IDENTIFICATION DIVISION.
        PROGRAM-ID. SAB-SPI-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / SPIRITUAL AGENCY BALANCE AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-SAB-PARAMS.
           05 WS-AGENCY-LAT-MS          PIC 9(02) VALUE 12.
           05 WS-AUTH-FID-M             PIC 9(04) VALUE 0960.
           05 WS-BOUND-DRIFT-MS         PIC 9(02) VALUE 01.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-SAB-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-SAB-VITALITY           PIC 9(09) VALUE 0.
           05 WS-SAB-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-SAB-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-SAB-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 AGEN-LAT-OUT-OF-BOUNDS      VALUE 2.
              88 AUTH-FIDELITY-LOW           VALUE 3.
              88 DRIFT-EXCEEDED              VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 SPIRITUAL-COLLAPSE          VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-SPIRITUAL-AGENCY
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3 AND WS-K-EXPONENT NOT EQUAL 4
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-AGENCY-LAT-MS < 5 OR WS-AGENCY-LAT-MS > 25
                SET AGEN-LAT-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-AUTH-FID-M < 850 OR WS-AUTH-FID-M > 1000
                SET AUTH-FIDELITY-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-BOUND-DRIFT-MS < 0 OR WS-BOUND-DRIFT-MS > 5
                SET DRIFT-EXCEEDED TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-SPIRITUAL-AGENCY.
            COMPUTE WS-SAB-COMPOSITE = ((30 - WS-AGENCY-LAT-MS) * 20) +
                                       (WS-AUTH-FID-M / 2) +
                                       ((10 - WS-BOUND-DRIFT-MS) * 40).

            COMPUTE WS-SAB-VITALITY = (WS-SAB-COMPOSITE / 4) +
                                      (WS-AUTH-FID-M / 4) +
                                      ((30 - WS-AGENCY-LAT-MS) * 4) + 1.

            IF WS-SAB-VITALITY EQUAL ZERO
                SET SPIRITUAL-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-SAB-COHERENCE = (WS-SAB-COMPOSITE / 16) +
                                       (WS-AUTH-FID-M / 16) +
                                       ((30 - WS-AGENCY-LAT-MS) * 2).

            COMPUTE WS-SAB-REBAR-LATCH = 1470169088 +
                                         (WS-SAB-COMPOSITE / 2) +
                                         ((30 - WS-AGENCY-LAT-MS) * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-SAB-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-SAB-VITALITY * 10) +
                                         (WS-SAB-COHERENCE * 10) +
                                         (WS-SAB-COMPOSITE * 10) +
                                         (WS-SAB-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-SAB-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-SAB-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
