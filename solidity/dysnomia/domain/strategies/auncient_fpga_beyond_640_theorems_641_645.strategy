        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-BEYOND-640.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-BEYOND-640-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH641-HYBRID-CLAY-OK     PIC 9(01) VALUE 1.
            05  WS-TH642-BIN-ASSM-SYNC-OK   PIC 9(01) VALUE 1.
            05  WS-TH643-ASSM-LAT-OK        PIC 9(01) VALUE 1.
            05  WS-TH644-645M-SAAT-OK       PIC 9(01) VALUE 1.
            05  WS-TH645-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-BEYOND-640-WIT      PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-BEYOND-640.
            GOBACK.
        1000-EVALUATE-BEYOND-640.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH641-HYBRID-CLAY-OK = 1 AND
               WS-TH642-BIN-ASSM-SYNC-OK = 1 AND
               WS-TH643-ASSM-LAT-OK = 1 AND
               WS-TH644-645M-SAAT-OK = 1 AND
               WS-TH645-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-BEYOND-640-WIT
            ELSE
                MOVE 0 TO WS-FPGA-BEYOND-640-WIT.
