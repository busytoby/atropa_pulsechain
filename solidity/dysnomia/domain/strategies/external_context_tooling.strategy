        IDENTIFICATION DIVISION.
        PROGRAM-ID. ECT-TOO-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / EXTERNAL CONTEXT TOOLING AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-ECT-PARAMS.
           05 WS-INGEST-LAT-MS          PIC 9(02) VALUE 20.
           05 WS-SPEC-FIDELITY-M        PIC 9(04) VALUE 0960.
           05 WS-TORQUE-VAR-CNM         PIC 9(02) VALUE 01.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-ECT-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-ECT-VITALITY           PIC 9(09) VALUE 0.
           05 WS-ECT-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-ECT-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-ECT-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 INGEST-LAT-OUT-OF-BOUNDS    VALUE 2.
              88 SPEC-FIDELITY-LOW           VALUE 3.
              88 TORQUE-VAR-EXCEEDED         VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 SPECIFICATION-COLLAPSE      VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-CONTEXT-TOOLING
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-INGEST-LAT-MS < 10 OR WS-INGEST-LAT-MS > 50
                SET INGEST-LAT-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-SPEC-FIDELITY-M < 850 OR WS-SPEC-FIDELITY-M > 1000
                SET SPEC-FIDELITY-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-TORQUE-VAR-CNM < 0 OR WS-TORQUE-VAR-CNM > 5
                SET TORQUE-VAR-EXCEEDED TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-CONTEXT-TOOLING.
            COMPUTE WS-ECT-COMPOSITE = ((60 - WS-INGEST-LAT-MS) * 10) +
                                       (WS-SPEC-FIDELITY-M / 2) +
                                       ((10 - WS-TORQUE-VAR-CNM) * 40).

            COMPUTE WS-ECT-VITALITY = (WS-ECT-COMPOSITE / 4) +
                                      (WS-SPEC-FIDELITY-M / 4) +
                                      ((60 - WS-INGEST-LAT-MS) * 4) + 1.

            IF WS-ECT-VITALITY EQUAL ZERO
                SET SPECIFICATION-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-ECT-COHERENCE = (WS-ECT-COMPOSITE / 16) +
                                       (WS-SPEC-FIDELITY-M / 16) +
                                       ((60 - WS-INGEST-LAT-MS) * 2).

            COMPUTE WS-ECT-REBAR-LATCH = 1470169088 +
                                         (WS-ECT-COMPOSITE / 2) +
                                         ((60 - WS-INGEST-LAT-MS) * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-ECT-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-ECT-VITALITY * 10) +
                                         (WS-ECT-COHERENCE * 10) +
                                         (WS-ECT-COMPOSITE * 10) +
                                         (WS-ECT-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-ECT-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-ECT-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
