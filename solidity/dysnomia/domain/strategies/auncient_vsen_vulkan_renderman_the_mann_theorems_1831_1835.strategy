        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-VSEN-MANN.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-VSEN-MANN-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1831-VK-QUEUE-OK       PIC 9(01) VALUE 1.
            05  WS-TH1832-MANN-DMABUF-OK    PIC 9(01) VALUE 1.
            05  WS-TH1833-RIB-DISP-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1834-1835M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1835-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-VSEN-MANN-WIT            PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-VSEN-MANN.
            GOBACK.
        1000-EVALUATE-VSEN-MANN.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1831-VK-QUEUE-OK = 1 AND
               WS-TH1832-MANN-DMABUF-OK = 1 AND
               WS-TH1833-RIB-DISP-LAT-OK = 1 AND
               WS-TH1834-1835M-SAAT-OK = 1 AND
               WS-TH1835-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-VSEN-MANN-WIT
            ELSE
                MOVE 0 TO WS-VSEN-MANN-WIT.
