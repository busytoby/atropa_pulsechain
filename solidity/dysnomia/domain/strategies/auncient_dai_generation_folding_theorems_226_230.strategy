        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-DAI-FOLDING.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-DAI-FOLDING-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH226-EMISSION-OK        PIC 9(01) VALUE 1.
            05  WS-TH227-COALESCE-OK        PIC 9(01) VALUE 1.
            05  WS-TH228-SOLVENCY-OK        PIC 9(01) VALUE 1.
            05  WS-TH229-EQUILIBRIUM-OK     PIC 9(01) VALUE 1.
            05  WS-TH230-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-DAI-FOLDING-WITNESS      PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-DAI-FOLDING.
            GOBACK.
        1000-EVALUATE-DAI-FOLDING.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH226-EMISSION-OK = 1 AND
               WS-TH227-COALESCE-OK = 1 AND
               WS-TH228-SOLVENCY-OK = 1 AND
               WS-TH229-EQUILIBRIUM-OK = 1 AND
               WS-TH230-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-DAI-FOLDING-WITNESS
            ELSE
                MOVE 0 TO WS-DAI-FOLDING-WITNESS.
