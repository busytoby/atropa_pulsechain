        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-QUADTREE-OS.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-QUADTREE-OS-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH366-DATBIN-BOOT-OK     PIC 9(01) VALUE 1.
            05  WS-TH367-JUBILEE-GATE-OK    PIC 9(01) VALUE 1.
            05  WS-TH368-WMQ-BDOS-OK        PIC 9(01) VALUE 1.
            05  WS-TH369-ANKH-SAAT-OK       PIC 9(01) VALUE 1.
            05  WS-TH370-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-QUADTREE-OS-WIT     PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-QUADTREE-OS.
            GOBACK.
        1000-EVALUATE-QUADTREE-OS.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH366-DATBIN-BOOT-OK = 1 AND
               WS-TH367-JUBILEE-GATE-OK = 1 AND
               WS-TH368-WMQ-BDOS-OK = 1 AND
               WS-TH369-ANKH-SAAT-OK = 1 AND
               WS-TH370-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-QUADTREE-OS-WIT
            ELSE
                MOVE 0 TO WS-FPGA-QUADTREE-OS-WIT.
