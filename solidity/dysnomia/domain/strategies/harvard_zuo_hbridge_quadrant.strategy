IDENTIFICATION DIVISION.
PROGRAM-ID. PROG-HARVARD-ZUO-HBRIDGE.

DATA DIVISION.
01 D0-SUBSTRATE-TRUNK.
   05 D0-MOTZKIN-PRIME     PIC 9(9) USAGE R0.
   05 D0-K-EXPONENT        PIC 9(9) USAGE R1.
   05 D0-ARM-SHORT-FLAG    PIC 9(9) USAGE R2.
01 D1-VOLTAGE-SHADOW.
   05 D1-VOLTAGE-A         PIC 9(9) USAGE R3.
   05 D1-VOLTAGE-B         PIC 9(9) USAGE R4.
   05 D1-SHADOW-VA-SNAP    PIC 9(9) USAGE R5.
01 D2-COMMUTATION-STAGE.
   05 D2-V-DIFF-FORWARD    PIC 9(9) USAGE R6.
   05 D2-G-SWIGLU-GATE     PIC 9(9) USAGE R7.
   05 D2-COMMITTED-STATE   PIC 9(9) USAGE R8.
01 D3-LEAF-EVAL.
   05 D3-PROOF-RULING      PIC 9(9) USAGE R9.
   05 D3-DISP-WRAP-MOD     PIC 9(9) USAGE R10.

PROCEDURE DIVISION.
    MOVE 953467954 TO D0-MOTZKIN-PRIME.
    MOVE 3 TO D0-K-EXPONENT.
    MOVE 0 TO D0-ARM-SHORT-FLAG.
    MOVE 5000 TO D1-VOLTAGE-A.
    MOVE 2172 TO D1-VOLTAGE-B.

    PERFORM STAGE-QUADRANT-COMMUTATION.
    PERFORM APPLY-ARM-SHORT-LATCH.
    PERFORM SYNC-DISPLACEMENT.

    IF D1-SHADOW-VA-SNAP == D1-VOLTAGE-A AND D2-G-SWIGLU-GATE >= 875 AND D2-G-SWIGLU-GATE <= 1000
        MOVE 0 TO D3-PROOF-RULING
        SET depth 4
    ELSE
        MOVE 4 TO D3-PROOF-RULING
        SET depth 1
    END-IF.

    EVAL.
    GO TO END-STRATEGY.

STAGE-QUADRANT-COMMUTATION.
    MOVE D1-VOLTAGE-A TO D1-SHADOW-VA-SNAP.
    COMPUTE D2-V-DIFF-FORWARD = D1-VOLTAGE-A - D1-VOLTAGE-B.
    COMPUTE D2-G-SWIGLU-GATE = 875 + ((125 * D2-V-DIFF-FORWARD) / 10000).
    EXIT.

APPLY-ARM-SHORT-LATCH.
    IF D0-ARM-SHORT-FLAG == 1
        MOVE D1-SHADOW-VA-SNAP TO D2-COMMITTED-STATE
    ELSE
        COMPUTE D2-COMMITTED-STATE = (D2-V-DIFF-FORWARD * D2-G-SWIGLU-GATE) / 1000
    END-IF.
    EXIT.

SYNC-DISPLACEMENT.
    COMPUTE D3-DISP-WRAP-MOD = D2-COMMITTED-STATE - ((D2-COMMITTED-STATE / 256) * 256).
    EXIT.

END-STRATEGY.
