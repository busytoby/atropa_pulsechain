        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-DISP-DISC.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-DISP-DISC-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1696-DISP-DISC-OK      PIC 9(01) VALUE 1.
            05  WS-TH1697-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1698-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1699-1700M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1700-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-DISP-DISC-WIT            PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-DISP-DISC.
            GOBACK.
        1000-EVALUATE-DISP-DISC.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1696-DISP-DISC-OK = 1 AND
               WS-TH1697-DATBIN-STRAT-OK = 1 AND
               WS-TH1698-SUBMICRO-LAT-OK = 1 AND
               WS-TH1699-1700M-SAAT-OK = 1 AND
               WS-TH1700-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-DISP-DISC-WIT
            ELSE
                MOVE 0 TO WS-DISP-DISC-WIT.
