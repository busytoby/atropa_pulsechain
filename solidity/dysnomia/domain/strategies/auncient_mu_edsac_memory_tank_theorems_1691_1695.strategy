        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-MEM-TANK.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-MEM-TANK-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1691-MEM-TANK-OK       PIC 9(01) VALUE 1.
            05  WS-TH1692-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1693-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1694-1695M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1695-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-MEM-TANK-WIT             PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-MEM-TANK.
            GOBACK.
        1000-EVALUATE-MEM-TANK.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1691-MEM-TANK-OK = 1 AND
               WS-TH1692-DATBIN-STRAT-OK = 1 AND
               WS-TH1693-SUBMICRO-LAT-OK = 1 AND
               WS-TH1694-1695M-SAAT-OK = 1 AND
               WS-TH1695-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-MEM-TANK-WIT
            ELSE
                MOVE 0 TO WS-MEM-TANK-WIT.
