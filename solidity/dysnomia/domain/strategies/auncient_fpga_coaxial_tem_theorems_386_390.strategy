        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-COAXIAL.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-COAXIAL-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH386-50OHM-MATCH-OK     PIC 9(01) VALUE 1.
            05  WS-TH387-VSWR-DAMPING-OK    PIC 9(01) VALUE 1.
            05  WS-TH388-RETURN-LOSS-OK     PIC 9(01) VALUE 1.
            05  WS-TH389-COAXIAL-SAAT-OK    PIC 9(01) VALUE 1.
            05  WS-TH390-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-COAXIAL-WIT         PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-COAXIAL.
            GOBACK.
        1000-EVALUATE-COAXIAL.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH386-50OHM-MATCH-OK = 1 AND
               WS-TH387-VSWR-DAMPING-OK = 1 AND
               WS-TH388-RETURN-LOSS-OK = 1 AND
               WS-TH389-COAXIAL-SAAT-OK = 1 AND
               WS-TH390-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-COAXIAL-WIT
            ELSE
                MOVE 0 TO WS-FPGA-COAXIAL-WIT.
