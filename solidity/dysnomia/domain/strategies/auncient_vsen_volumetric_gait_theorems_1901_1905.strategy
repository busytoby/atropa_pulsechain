        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-VSEN-VOLGAIT.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-VSEN-VOLGAIT-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1901-GAIT-SYNC-OK      PIC 9(01) VALUE 1.
            05  WS-TH1902-FOG-ENERGY-OK     PIC 9(01) VALUE 1.
            05  WS-TH1903-PAW-DISSIP-OK     PIC 9(01) VALUE 1.
            05  WS-TH1904-1905M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1905-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-VSEN-VOLGAIT-WIT         PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-VSEN-VOLGAIT.
            GOBACK.
        1000-EVALUATE-VSEN-VOLGAIT.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1901-GAIT-SYNC-OK = 1 AND
               WS-TH1902-FOG-ENERGY-OK = 1 AND
               WS-TH1903-PAW-DISSIP-OK = 1 AND
               WS-TH1904-1905M-SAAT-OK = 1 AND
               WS-TH1905-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-VSEN-VOLGAIT-WIT
            ELSE
                MOVE 0 TO WS-VSEN-VOLGAIT-WIT.
