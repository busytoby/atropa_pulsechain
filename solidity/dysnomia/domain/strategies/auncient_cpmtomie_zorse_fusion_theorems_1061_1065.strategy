        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-CPM-ZORSE.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-CPM-ZORSE-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1061-ZORSE-EXEC-OK     PIC 9(01) VALUE 1.
            05  WS-TH1062-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1063-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1064-1065M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1065-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-CPM-ZORSE-WIT            PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-CPM-ZORSE.
            GOBACK.
        1000-EVALUATE-CPM-ZORSE.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1061-ZORSE-EXEC-OK = 1 AND
               WS-TH1062-DATBIN-STRAT-OK = 1 AND
               WS-TH1063-SUBMICRO-LAT-OK = 1 AND
               WS-TH1064-1065M-SAAT-OK = 1 AND
               WS-TH1065-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-CPM-ZORSE-WIT
            ELSE
                MOVE 0 TO WS-CPM-ZORSE-WIT.
