        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-APOGEE-CHAN.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-APOGEE-CHAN-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1361-CHAN-OK           PIC 9(01) VALUE 1.
            05  WS-TH1362-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1363-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1364-1365M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1365-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-APOGEE-CHAN-WIT          PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-APOGEE-CHAN.
            GOBACK.
        1000-EVALUATE-APOGEE-CHAN.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1361-CHAN-OK = 1 AND
               WS-TH1362-DATBIN-STRAT-OK = 1 AND
               WS-TH1363-SUBMICRO-LAT-OK = 1 AND
               WS-TH1364-1365M-SAAT-OK = 1 AND
               WS-TH1365-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-APOGEE-CHAN-WIT
            ELSE
                MOVE 0 TO WS-APOGEE-CHAN-WIT.
