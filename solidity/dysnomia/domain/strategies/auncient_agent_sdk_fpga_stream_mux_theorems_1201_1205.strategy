        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-SDK-STREAM-MUX.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-STREAM-MUX-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1201-STREAM-OK         PIC 9(01) VALUE 1.
            05  WS-TH1202-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1203-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1204-1205M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1205-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-STREAM-MUX-WIT           PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-STREAM-MUX.
            GOBACK.
        1000-EVALUATE-STREAM-MUX.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1201-STREAM-OK = 1 AND
               WS-TH1202-DATBIN-STRAT-OK = 1 AND
               WS-TH1203-SUBMICRO-LAT-OK = 1 AND
               WS-TH1204-1205M-SAAT-OK = 1 AND
               WS-TH1205-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-STREAM-MUX-WIT
            ELSE
                MOVE 0 TO WS-STREAM-MUX-WIT.
