        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-BEYOND-510.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-BEYOND-510-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH511-OPTIC-POLAR-OK     PIC 9(01) VALUE 1.
            05  WS-TH512-FLUX-CONSERV-OK    PIC 9(01) VALUE 1.
            05  WS-TH513-ZERO-LOSS-OK       PIC 9(01) VALUE 1.
            05  WS-TH514-OPTIC-SAAT-OK      PIC 9(01) VALUE 1.
            05  WS-TH515-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-BEYOND-510-WIT      PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-BEYOND-510.
            GOBACK.
        1000-EVALUATE-BEYOND-510.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH511-OPTIC-POLAR-OK = 1 AND
               WS-TH512-FLUX-CONSERV-OK = 1 AND
               WS-TH513-ZERO-LOSS-OK = 1 AND
               WS-TH514-OPTIC-SAAT-OK = 1 AND
               WS-TH515-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-BEYOND-510-WIT
            ELSE
                MOVE 0 TO WS-FPGA-BEYOND-510-WIT.
