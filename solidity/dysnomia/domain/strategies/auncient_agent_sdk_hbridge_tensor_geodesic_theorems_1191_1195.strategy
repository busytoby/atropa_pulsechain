        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-SDK-GEODESIC.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-SDK-GEODESIC-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1191-GEODESIC-OK       PIC 9(01) VALUE 1.
            05  WS-TH1192-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1193-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1194-1195M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1195-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-SDK-GEODESIC-WIT         PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-SDK-GEODESIC.
            GOBACK.
        1000-EVALUATE-SDK-GEODESIC.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1191-GEODESIC-OK = 1 AND
               WS-TH1192-DATBIN-STRAT-OK = 1 AND
               WS-TH1193-SUBMICRO-LAT-OK = 1 AND
               WS-TH1194-1195M-SAAT-OK = 1 AND
               WS-TH1195-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-SDK-GEODESIC-WIT
            ELSE
                MOVE 0 TO WS-SDK-GEODESIC-WIT.
