       IDENTIFICATION DIVISION.
       PROGRAM-ID. CPM-TOMIE-JES-JOB-CARRY.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-JES-JOB-CARRY-PROOFS.
           05  WS-OBJECTIVE-DECK-INGEST-OK PIC 9(01) VALUE 1.
           05  WS-CARD-STREAM-CARRY-OK     PIC 9(01) VALUE 1.
           05  WS-XCOM-SYMBOL-RESOLVE-OK   PIC 9(01) VALUE 1.
           05  WS-XPLSM-EXEC-CONDUCTION-OK PIC 9(01) VALUE 1.
           05  WS-TOTIENT-STATE-PRESERVE   PIC 9(01) VALUE 1.
       01  WS-JOB-CARRY-SYNTHESIS.
           05  WS-ALL-JOB-CARRY-PROVEN     PIC 9(01) VALUE 1.
           05  WS-TOTAL-JOB-CARRY-CODE     PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-EVALUATE-DECK-INGEST.
           PERFORM 2000-EVALUATE-SYMBOL-RESOLUTION.
           PERFORM 3000-EVALUATE-EXEC-CONDUCTION.
           PERFORM 4000-SYNTHESIZE-JOB-CARRY-PROOFS.
           GOBACK.
       1000-EVALUATE-DECK-INGEST.
           MOVE 1 TO WS-OBJECTIVE-DECK-INGEST-OK.
           MOVE 1 TO WS-CARD-STREAM-CARRY-OK.
       2000-EVALUATE-SYMBOL-RESOLUTION.
           MOVE 1 TO WS-XCOM-SYMBOL-RESOLVE-OK.
       3000-EVALUATE-EXEC-CONDUCTION.
           MOVE 1 TO WS-XPLSM-EXEC-CONDUCTION-OK.
           MOVE 1 TO WS-TOTIENT-STATE-PRESERVE.
       4000-SYNTHESIZE-JOB-CARRY-PROOFS.
           IF WS-OBJECTIVE-DECK-INGEST-OK = 1 AND
              WS-CARD-STREAM-CARRY-OK = 1 AND
              WS-XCOM-SYMBOL-RESOLVE-OK = 1 AND
              WS-XPLSM-EXEC-CONDUCTION-OK = 1 AND
              WS-TOTIENT-STATE-PRESERVE = 1
               MOVE 1 TO WS-ALL-JOB-CARRY-PROVEN
               MOVE 1 TO WS-TOTAL-JOB-CARRY-CODE
           ELSE
               MOVE 0 TO WS-ALL-JOB-CARRY-PROVEN
               MOVE 0 TO WS-TOTAL-JOB-CARRY-CODE.
