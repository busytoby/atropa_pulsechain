^{:wmq-job "ESEVJOB"
  :wmq-compiler "FOLKLORE"
  :wmq-mount "GOSTINT"
  :wmq-author "ADVERSARY"
  :wmq-params {:tin 950000000 :ssn 050051122 :gost-key "KGBKEY01"}}

(def ws-ssn-tin "050051122")
(def ws-gost-key "KGBKEY01")

(defn -main []
  (wmq-reg-write 1 950000000)
  (wmq-reg-write 2 050051122))
