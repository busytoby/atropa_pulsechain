        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-STATOR-ROTOR.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-STATOR-ROTOR-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH436-STATOR-RIGID-OK    PIC 9(01) VALUE 1.
            05  WS-TH437-ROTOR-FLUX-OK      PIC 9(01) VALUE 1.
            05  WS-TH438-BACK-EMF-OK        PIC 9(01) VALUE 1.
            05  WS-TH439-DYNAMO-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH440-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-STATOR-ROTOR-WIT    PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-STATOR-ROTOR.
            GOBACK.
        1000-EVALUATE-STATOR-ROTOR.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH436-STATOR-RIGID-OK = 1 AND
               WS-TH437-ROTOR-FLUX-OK = 1 AND
               WS-TH438-BACK-EMF-OK = 1 AND
               WS-TH439-DYNAMO-SAAT-OK = 1 AND
               WS-TH440-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-STATOR-ROTOR-WIT
            ELSE
                MOVE 0 TO WS-FPGA-STATOR-ROTOR-WIT.
