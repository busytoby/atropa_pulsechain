        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-RENDERMAN-USDA-THEOREMS-26-30.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-RENDERMAN-USDA-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH26-RIB-SCENEGRAPH-OK   PIC 9(01) VALUE 1.
            05  WS-TH27-BSDF-ENERGY-OK      PIC 9(01) VALUE 1.
            05  WS-TH28-DISP-BOUND-OK       PIC 9(01) VALUE 1.
            05  WS-TH29-BSSRDF-DIFFUSE-OK   PIC 9(01) VALUE 1.
            05  WS-TH30-WINCHESTER-SCSI-OK  PIC 9(01) VALUE 1.
            05  WS-RENDERMAN-PROOF-WITNESS  PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-RENDERMAN-THEOREMS.
            GOBACK.
        1000-EVALUATE-RENDERMAN-THEOREMS.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH26-RIB-SCENEGRAPH-OK = 1 AND
               WS-TH27-BSDF-ENERGY-OK = 1 AND
               WS-TH28-DISP-BOUND-OK = 1 AND
               WS-TH29-BSSRDF-DIFFUSE-OK = 1 AND
               WS-TH30-WINCHESTER-SCSI-OK = 1
                MOVE 1 TO WS-RENDERMAN-PROOF-WITNESS
            ELSE
                MOVE 0 TO WS-RENDERMAN-PROOF-WITNESS.
