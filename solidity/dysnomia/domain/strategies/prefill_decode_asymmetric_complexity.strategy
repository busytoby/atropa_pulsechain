        IDENTIFICATION DIVISION.
        PROGRAM-ID. ASYM-COMPLEX-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / ASYMMETRIC COMPLEXITY AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-ASYM-PARAMS.
           05 WS-PROMPT-LEN             PIC 9(04) VALUE 0128.
           05 WS-GEN-TOKENS             PIC 9(04) VALUE 0064.
           05 WS-MODEL-DIM              PIC 9(05) VALUE 04096.
           05 WS-EXACT-FLAG             PIC 9(01) VALUE 1.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-ASYM-VITALITY          PIC 9(09) VALUE 0.
           05 WS-ASYM-COHERENCE         PIC 9(09) VALUE 0.
           05 WS-ASYM-REBAR-LATCH       PIC 9(12) VALUE 0.
           05 WS-SHADOW-ASYM-BASE       PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 INVALID-PROMPT-LEN          VALUE 2.
              88 INVALID-GEN-TOKENS          VALUE 3.
              88 INVALID-MODEL-DIM           VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 PHASE-EXACTNESS-FAIL        VALUE 6.
              88 ASYMMETRIC-DIVERG-FAIL      VALUE 7.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 8.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-ASYMMETRIC-PHASE
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-PROMPT-LEN < 1 OR WS-PROMPT-LEN > 2048
                SET INVALID-PROMPT-LEN TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-GEN-TOKENS < 1 OR WS-GEN-TOKENS > 1024
                SET INVALID-GEN-TOKENS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-MODEL-DIM < 256 OR WS-MODEL-DIM > 8192
                SET INVALID-MODEL-DIM TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-EXACT-FLAG NOT EQUAL 1
                SET PHASE-EXACTNESS-FAIL TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-ASYMMETRIC-PHASE.
            COMPUTE WS-ASYM-VITALITY = (WS-PROMPT-LEN * 128) +
                                       (WS-GEN-TOKENS * 64) +
                                       (WS-MODEL-DIM / 8) +
                                       (WS-EXACT-FLAG * 256) + 1.

            IF WS-ASYM-VITALITY EQUAL ZERO
                SET ASYMMETRIC-DIVERG-FAIL TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-ASYM-COHERENCE = (WS-PROMPT-LEN * 32) +
                                        (WS-GEN-TOKENS * 16) +
                                        (WS-MODEL-DIM / 32).

            COMPUTE WS-ASYM-REBAR-LATCH = 1470169088 + (WS-PROMPT-LEN * 64) +
                                          (WS-GEN-TOKENS * 32) +
                                          (WS-MODEL-DIM / 4).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-ASYM-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                          (WS-ASYM-VITALITY * 10) +
                                          (WS-ASYM-COHERENCE * 10) +
                                          (WS-PROMPT-LEN * 100) +
                                          (WS-ASYM-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-ASYM-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-ASYM-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
