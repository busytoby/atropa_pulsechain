        IDENTIFICATION DIVISION.
        PROGRAM-ID. MEM-COMPRESS-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / MEMORY FOOTPRINT AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-MEM-PARAMS.
           05 WS-PARAM-MILLIONS         PIC 9(05) VALUE 08000.
           05 WS-WEIGHT-ENUM            PIC 9(02) VALUE 05.
           05 WS-RAM-LIMIT-MB           PIC 9(05) VALUE 08192.
           05 WS-FIT-FLAG               PIC 9(01) VALUE 1.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-EFFECTIVE-BITS-MILLI   PIC 9(06) VALUE 0.
           05 WS-ESTIMATED-MB           PIC 9(06) VALUE 0.
           05 WS-MEM-VITALITY           PIC 9(09) VALUE 0.
           05 WS-MEM-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-MEM-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-MEM-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 INVALID-PARAM-COUNT         VALUE 2.
              88 INVALID-WEIGHT-ENUM         VALUE 3.
              88 INVALID-RAM-LIMIT           VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 MEMORY-FIT-FLAG-FAIL        VALUE 6.
              88 MEMORY-BUDGET-EXCEEDED      VALUE 7.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 8.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-MEMORY-FOOTPRINT
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-PARAM-MILLIONS < 500 OR WS-PARAM-MILLIONS > 8500
                SET INVALID-PARAM-COUNT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-WEIGHT-ENUM < 1 OR WS-WEIGHT-ENUM > 5
                SET INVALID-WEIGHT-ENUM TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-RAM-LIMIT-MB < 2048 OR WS-RAM-LIMIT-MB > 16384
                SET INVALID-RAM-LIMIT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-FIT-FLAG NOT EQUAL 1
                SET MEMORY-FIT-FLAG-FAIL TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-WEIGHT-ENUM EQUAL 1
                MOVE 16000 TO WS-EFFECTIVE-BITS-MILLI
            END-IF.
            IF WS-WEIGHT-ENUM EQUAL 2
                MOVE 8000 TO WS-EFFECTIVE-BITS-MILLI
            END-IF.
            IF WS-WEIGHT-ENUM EQUAL 3
                MOVE 4500 TO WS-EFFECTIVE-BITS-MILLI
            END-IF.
            IF WS-WEIGHT-ENUM EQUAL 4
                MOVE 2560 TO WS-EFFECTIVE-BITS-MILLI
            END-IF.
            IF WS-WEIGHT-ENUM EQUAL 5
                MOVE 1580 TO WS-EFFECTIVE-BITS-MILLI
            END-IF.

            COMPUTE WS-ESTIMATED-MB = ((WS-PARAM-MILLIONS * (WS-EFFECTIVE-BITS-MILLI / 1000)) / 8) + 350.
            IF WS-ESTIMATED-MB > WS-RAM-LIMIT-MB
                SET MEMORY-BUDGET-EXCEEDED TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-MEMORY-FOOTPRINT.
            COMPUTE WS-MEM-VITALITY = ((WS-RAM-LIMIT-MB - WS-ESTIMATED-MB) * 16) +
                                      (WS-PARAM-MILLIONS / 8) +
                                      (WS-WEIGHT-ENUM * 256) + 1.

            IF WS-MEM-VITALITY EQUAL ZERO
                SET MEMORY-BUDGET-EXCEEDED TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-MEM-COHERENCE = ((WS-RAM-LIMIT-MB - WS-ESTIMATED-MB) * 4) +
                                       (WS-WEIGHT-ENUM * 64) +
                                       (WS-PARAM-MILLIONS / 32).

            COMPUTE WS-MEM-REBAR-LATCH = 1470169088 + (WS-ESTIMATED-MB * 64) +
                                         (WS-WEIGHT-ENUM * 128) +
                                         (WS-PARAM-MILLIONS / 16).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-MEM-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-MEM-VITALITY * 10) +
                                         (WS-MEM-COHERENCE * 10) +
                                         ((WS-RAM-LIMIT-MB - WS-ESTIMATED-MB) * 10) +
                                         (WS-MEM-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-MEM-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-MEM-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
