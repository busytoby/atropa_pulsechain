       IDENTIFICATION DIVISION.
       PROGRAM-ID. ANKH-HAM-STRATEGY.
       AUTHOR. AUNCIENT DYSNOMIA VM / HAMILTONIAN CONSERVATIVITY.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-HAM-PARAMS.
          05 WS-INIT-ENERGY-DRIFT      PIC 9(05) VALUE 21000.
          05 WS-CROSS-HEADS-H          PIC 9(02) VALUE 32.
          05 WS-CONSERVATION-CYCLES-N  PIC 9(02) VALUE 16.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-CURRENT-DRIFT          PIC 9(05) VALUE 0.
          05 WS-STEP-IDX               PIC 9(02) VALUE 0.
          05 WS-SHADOW-HAM-BASE        PIC 9(12) VALUE 0.
          05 WS-CYC-MOD                PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-ENERGY-DRIFT        VALUE 2.
             88 INVALID-HEAD-COUNT-H        VALUE 3.
             88 INVALID-CONSERV-CYCLES      VALUE 4.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
             88 HAMILTONIAN-DIVERG-FAIL     VALUE 6.
             88 GATING-CLAMP-OVERFLOW       VALUE 7.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 8.
             88 CASCADE-ROLLBACK-FAIL       VALUE 9.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-HAMILTONIAN-CONSERVATION
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-INIT-ENERGY-DRIFT > 50000
               SET INVALID-ENERGY-DRIFT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CROSS-HEADS-H < 1 OR WS-CROSS-HEADS-H > 64
               SET INVALID-HEAD-COUNT-H TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CONSERVATION-CYCLES-N < 1 OR WS-CONSERVATION-CYCLES-N > 64
               SET INVALID-CONSERV-CYCLES TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-HAMILTONIAN-CONSERVATION.
           MOVE WS-INIT-ENERGY-DRIFT TO WS-CURRENT-DRIFT.

           PERFORM VARYING WS-STEP-IDX FROM 1 BY 1 UNTIL WS-STEP-IDX > WS-CONSERVATION-CYCLES-N
               COMPUTE WS-CURRENT-DRIFT = (WS-CURRENT-DRIFT * 875) / 1000
           END-PERFORM.

           IF WS-CURRENT-DRIFT > WS-INIT-ENERGY-DRIFT
               SET HAMILTONIAN-DIVERG-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-SHADOW-HAM-BASE = (WS-CICS-WRITER-ID * 1000000) + 
               (WS-CONSERVATION-CYCLES-N * 10000) + (WS-CROSS-HEADS-H * 100) + (WS-CURRENT-DRIFT / 16).

           COMPUTE WS-CYC-MOD = FUNCTION MOD(WS-CROSS-HEADS-H, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-CYC-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-HAM-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-HAM-BASE + ((WS-CURRENT-DRIFT * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-HAM-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-CONSERVATION-CYCLES-N * 10000) + (WS-CROSS-HEADS-H * 100) + (WS-CURRENT-DRIFT / 16))
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-HAM-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
