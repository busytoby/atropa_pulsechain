        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-BEYOND-675.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-BEYOND-675-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH676-COMMON-PROC-OK     PIC 9(01) VALUE 1.
            05  WS-TH677-ISA-EQUIV-OK       PIC 9(01) VALUE 1.
            05  WS-TH678-DISPATCH-LAT-OK    PIC 9(01) VALUE 1.
            05  WS-TH679-680M-SAAT-OK       PIC 9(01) VALUE 1.
            05  WS-TH680-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-BEYOND-675-WIT      PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-BEYOND-675.
            GOBACK.
        1000-EVALUATE-BEYOND-675.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH676-COMMON-PROC-OK = 1 AND
               WS-TH677-ISA-EQUIV-OK = 1 AND
               WS-TH678-DISPATCH-LAT-OK = 1 AND
               WS-TH679-680M-SAAT-OK = 1 AND
               WS-TH680-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-BEYOND-675-WIT
            ELSE
                MOVE 0 TO WS-FPGA-BEYOND-675-WIT.
