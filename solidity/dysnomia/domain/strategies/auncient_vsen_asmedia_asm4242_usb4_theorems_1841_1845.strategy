        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-VSEN-USB4.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-VSEN-USB4-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1841-PORT-TREE-OK      PIC 9(01) VALUE 1.
            05  WS-TH1842-TUNNEL-ENCAP-OK   PIC 9(01) VALUE 1.
            05  WS-TH1843-TUNNEL-LAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1844-1845M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1845-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-VSEN-USB4-WIT            PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-VSEN-USB4.
            GOBACK.
        1000-EVALUATE-VSEN-USB4.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1841-PORT-TREE-OK = 1 AND
               WS-TH1842-TUNNEL-ENCAP-OK = 1 AND
               WS-TH1843-TUNNEL-LAT-OK = 1 AND
               WS-TH1844-1845M-SAAT-OK = 1 AND
               WS-TH1845-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-VSEN-USB4-WIT
            ELSE
                MOVE 0 TO WS-VSEN-USB4-WIT.
