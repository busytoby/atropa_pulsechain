IDENTIFICATION DIVISION.
PROGRAM-ID. PROG-MARSCHNER-FUR-SCATTERING.

DATA DIVISION.
01 D0-SUBSTRATE-TRUNK.
   05 D0-MOTZKIN-PRIME     PIC 9(9) USAGE R0.
   05 D0-K-EXPONENT        PIC 9(9) USAGE R1.
   05 D0-MAX-ENERGY-Q16    PIC 9(9) USAGE R2.
01 D1-MARSCHNER-SHADOW.
   05 D1-DOT-TL-Q16        PIC 9(9) USAGE R3.
   05 D1-CLUMPING-SEED     PIC 9(9) USAGE R4.
   05 D1-SHADOW-DOT-SNAP   PIC 9(9) USAGE R5.
01 D2-SCATTERING-STAGE.
   05 D2-SIN-THETA-SQ-Q16  PIC 9(9) USAGE R6.
   05 D2-SPEC1-LOBE-Q16    PIC 9(9) USAGE R7.
   05 D2-SPEC2-LOBE-Q16    PIC 9(9) USAGE R8.
   05 D2-TOTAL-SPEC-Q16    PIC 9(9) USAGE R9.
   05 D2-G-SWIGLU-GATE     PIC 9(9) USAGE R10.
   05 D2-COMMITTED-STATE   PIC 9(9) USAGE R11.
01 D3-LEAF-EVAL.
   05 D3-PROOF-RULING      PIC 9(9) USAGE R12.
   05 D3-DISP-WRAP-MOD     PIC 9(9) USAGE R13.

PROCEDURE DIVISION.
    MOVE 953467954 TO D0-MOTZKIN-PRIME.
    MOVE 3 TO D0-K-EXPONENT.
    MOVE 65536 TO D0-MAX-ENERGY-Q16.
    MOVE 32768 TO D1-DOT-TL-Q16.
    MOVE 44257 TO D1-CLUMPING-SEED.

    PERFORM STAGE-MARSCHNER-LOBES.
    PERFORM EVALUATE-ENERGY-CONSERVATION.
    PERFORM SYNC-DISPLACEMENT.

    IF D1-SHADOW-DOT-SNAP == D1-DOT-TL-Q16 AND D2-TOTAL-SPEC-Q16 <= D0-MAX-ENERGY-Q16
        MOVE 0 TO D3-PROOF-RULING
        SET depth 4
    ELSE
        MOVE 3 TO D3-PROOF-RULING
        SET depth 1
    END-IF.

    EVAL.
    GO TO END-STRATEGY.

STAGE-MARSCHNER-LOBES.
    MOVE D1-DOT-TL-Q16 TO D1-SHADOW-DOT-SNAP.
    COMPUTE D2-SIN-THETA-SQ-Q16 = 65536 - ((D1-DOT-TL-Q16 * D1-DOT-TL-Q16) / 65536).
    COMPUTE D2-SPEC1-LOBE-Q16 = (((D2-SIN-THETA-SQ-Q16 * D2-SIN-THETA-SQ-Q16) / 65536) * 32768) / 65536.
    COMPUTE D2-SPEC2-LOBE-Q16 = (D2-SIN-THETA-SQ-Q16 * 3932) / 65536.
    COMPUTE D2-TOTAL-SPEC-Q16 = D2-SPEC1-LOBE-Q16 + D2-SPEC2-LOBE-Q16.
    COMPUTE D2-G-SWIGLU-GATE = 875 + ((125 * D2-TOTAL-SPEC-Q16) / 65536).
    EXIT.

EVALUATE-ENERGY-CONSERVATION.
    COMPUTE D2-COMMITTED-STATE = (((D2-TOTAL-SPEC-Q16 * 1000 + 43605) * D2-G-SWIGLU-GATE) / 1000).
    EXIT.

SYNC-DISPLACEMENT.
    COMPUTE D3-DISP-WRAP-MOD = D2-COMMITTED-STATE - ((D2-COMMITTED-STATE / 256) * 256).
    EXIT.

END-STRATEGY.
