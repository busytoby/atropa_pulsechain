       IDENTIFICATION DIVISION.
       PROGRAM-ID. LYAPUNOV-CACHE-STRAT.
       AUTHOR. AUNCIENT DYSNOMIA VM / CACHE LATENCY.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-CACHE-PARAMS.
          05 WS-KEY-BUF-SIZE-BYTES     PIC 9(04) VALUE 0256.
          05 WS-INIT-LOOKUP-LAT-NS     PIC 9(05) VALUE 00900.
          05 WS-LOOKUP-CYCLES-N        PIC 9(02) VALUE 16.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-CURRENT-LATENCY        PIC 9(05) VALUE 0.
          05 WS-STEP-IDX               PIC 9(02) VALUE 0.
          05 WS-BUF-MOD                PIC 9(03) VALUE 0.
          05 WS-SHADOW-CACHE-BASE      PIC 9(12) VALUE 0.
          05 WS-CYC-MOD                PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 BUFFER-SAFETY-VIOLATION     VALUE 2.
             88 LATENCY-GUARD-BREACH        VALUE 3.
             88 INVALID-LOOKUP-CYCLES       VALUE 4.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
             88 LATENCY-JITTER-DIVERG-FAIL  VALUE 6.
             88 GATING-CLAMP-OVERFLOW       VALUE 7.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 8.
             88 CASCADE-ROLLBACK-FAIL       VALUE 9.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-LATENCY-CONTRACTION
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-KEY-BUF-SIZE-BYTES < 256 OR WS-KEY-BUF-SIZE-BYTES > 4096
               SET BUFFER-SAFETY-VIOLATION TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-INIT-LOOKUP-LAT-NS > 50000
               SET LATENCY-GUARD-BREACH TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-LOOKUP-CYCLES-N < 1 OR WS-LOOKUP-CYCLES-N > 64
               SET INVALID-LOOKUP-CYCLES TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-LATENCY-CONTRACTION.
           MOVE WS-INIT-LOOKUP-LAT-NS TO WS-CURRENT-LATENCY.

           PERFORM VARYING WS-STEP-IDX FROM 1 BY 1 UNTIL WS-STEP-IDX > WS-LOOKUP-CYCLES-N
               COMPUTE WS-CURRENT-LATENCY = (WS-CURRENT-LATENCY * 875) / 1000
           END-PERFORM.

           IF WS-CURRENT-LATENCY > WS-INIT-LOOKUP-LAT-NS
               SET LATENCY-JITTER-DIVERG-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-BUF-MOD = FUNCTION MOD(WS-KEY-BUF-SIZE-BYTES, 100).

           COMPUTE WS-SHADOW-CACHE-BASE = (WS-CICS-WRITER-ID * 1000000) + 
               (WS-LOOKUP-CYCLES-N * 10000) + (WS-BUF-MOD * 10) + (WS-CURRENT-LATENCY / 16).

           COMPUTE WS-CYC-MOD = FUNCTION MOD(WS-LOOKUP-CYCLES-N, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-CYC-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-CACHE-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-CACHE-BASE + ((WS-CURRENT-LATENCY * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-CACHE-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-LOOKUP-CYCLES-N * 10000) + (WS-BUF-MOD * 10) + (WS-CURRENT-LATENCY / 16))
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-CACHE-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
