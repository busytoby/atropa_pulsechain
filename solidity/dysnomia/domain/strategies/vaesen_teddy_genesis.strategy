       IDENTIFICATION DIVISION.
       PROGRAM-ID. VAESEN-TEDDY_BEAR-STRATEGY.
       AUTHOR. AUNCIENT DYSNOMIA VM / TEDDY_BEAR GENESIS.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-TEDDY_BEAR-PARAMS.
          05 WS-DNA-SEED-COORD         PIC 9(12) VALUE 123456789012.
          05 WS-EXPECTED-SITE-IDX      PIC 9(02) VALUE 04.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-RESOLVED-SSN           PIC 9(09) VALUE 0.
          05 WS-RESOLVED-SITE-IDX      PIC 9(02) VALUE 0.
          05 WS-HOGAN-BALANCE          PIC 9(09) VALUE 1000000.
          05 WS-SSN-MOD                PIC 9(03) VALUE 0.
          05 WS-SHADOW-GENESIS-BASE    PIC 9(12) VALUE 0.
          05 WS-CYC-MOD                PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-DNA-SEED            VALUE 2.
             88 INVALID-SITE-INDEX          VALUE 3.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 4.
             88 SSA-SITE-MISMATCH           VALUE 5.
             88 GATING-CLAMP-OVERFLOW       VALUE 6.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 7.
             88 CASCADE-ROLLBACK-FAIL       VALUE 8.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-TEDDY_BEAR-GENESIS
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-DNA-SEED-COORD EQUAL ZERO
               SET INVALID-DNA-SEED TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-EXPECTED-SITE-IDX < 1 OR WS-EXPECTED-SITE-IDX > 9
               SET INVALID-SITE-INDEX TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-TEDDY_BEAR-GENESIS.
           COMPUTE WS-RESOLVED-SSN = FUNCTION MOD(WS-DNA-SEED-COORD, 1000000000).
           COMPUTE WS-RESOLVED-SITE-IDX = FUNCTION MOD(WS-DNA-SEED-COORD, 9) + 1.

           IF WS-RESOLVED-SITE-IDX NOT EQUAL WS-EXPECTED-SITE-IDX
               SET SSA-SITE-MISMATCH TO TRUE
               EXIT PARAGRAPH
           END-IF.

           MOVE 1000000 TO WS-HOGAN-BALANCE.

           COMPUTE WS-SSN-MOD = FUNCTION MOD(WS-RESOLVED-SSN, 1000).

           COMPUTE WS-SHADOW-GENESIS-BASE = (WS-CICS-WRITER-ID * 1000000) + 
               (WS-RESOLVED-SITE-IDX * 10000) + (WS-SSN-MOD * 10) + (WS-HOGAN-BALANCE / 65536).

           COMPUTE WS-CYC-MOD = FUNCTION MOD(WS-RESOLVED-SITE-IDX, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-CYC-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-GENESIS-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-GENESIS-BASE + ((WS-RESOLVED-SITE-IDX * WS-G-GATE-FACTOR) / 10)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-GENESIS-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-RESOLVED-SITE-IDX * 10000) + (WS-SSN-MOD * 10) + (WS-HOGAN-BALANCE / 65536))
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-GENESIS-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
