        IDENTIFICATION DIVISION.
        PROGRAM-ID. OGS-GHO-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / OCCLUSION GHOSTING SHADER AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-OGS-PARAMS.
           05 WS-OCCLUSION-LAT-MS       PIC 9(02) VALUE 12.
           05 WS-GHOSTING-FID-M         PIC 9(04) VALUE 0960.
           05 WS-ALPHA-EDGE-DRIFT-M     PIC 9(02) VALUE 01.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-OGS-COMPOSITE          PIC 9(04) VALUE 0.
           05 WS-OGS-VITALITY           PIC 9(09) VALUE 0.
           05 WS-OGS-COHERENCE          PIC 9(09) VALUE 0.
           05 WS-OGS-REBAR-LATCH        PIC 9(12) VALUE 0.
           05 WS-SHADOW-OGS-BASE        PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 OCCLUSION-LAT-OUT-OF-BOUNDS VALUE 2.
              88 GHOSTING-FIDELITY-LOW       VALUE 3.
              88 ALPHA-DRIFT-EXCEEDED        VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 OCCLUSION-COLLAPSE          VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-OCCLUSION-SHADER
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3 AND WS-K-EXPONENT NOT EQUAL 4
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-OCCLUSION-LAT-MS < 5 OR WS-OCCLUSION-LAT-MS > 25
                SET OCCLUSION-LAT-OUT-OF-BOUNDS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-GHOSTING-FID-M < 850 OR WS-GHOSTING-FID-M > 1000
                SET GHOSTING-FIDELITY-LOW TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-ALPHA-EDGE-DRIFT-M < 0 OR WS-ALPHA-EDGE-DRIFT-M > 5
                SET ALPHA-DRIFT-EXCEEDED TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-OCCLUSION-SHADER.
            COMPUTE WS-OGS-COMPOSITE = ((30 - WS-OCCLUSION-LAT-MS) * 20) +
                                       (WS-GHOSTING-FID-M / 2) +
                                       ((10 - WS-ALPHA-EDGE-DRIFT-M) * 40).

            COMPUTE WS-OGS-VITALITY = (WS-OGS-COMPOSITE / 4) +
                                      (WS-GHOSTING-FID-M / 4) +
                                      ((30 - WS-OCCLUSION-LAT-MS) * 4) + 1.

            IF WS-OGS-VITALITY EQUAL ZERO
                SET OCCLUSION-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-OGS-COHERENCE = (WS-OGS-COMPOSITE / 16) +
                                       (WS-GHOSTING-FID-M / 16) +
                                       ((30 - WS-OCCLUSION-LAT-MS) * 2).

            COMPUTE WS-OGS-REBAR-LATCH = 1470169088 +
                                         (WS-OGS-COMPOSITE / 2) +
                                         ((30 - WS-OCCLUSION-LAT-MS) * 128).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-OGS-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                         (WS-OGS-VITALITY * 10) +
                                         (WS-OGS-COHERENCE * 10) +
                                         (WS-OGS-COMPOSITE * 10) +
                                         (WS-OGS-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-OGS-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-OGS-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
