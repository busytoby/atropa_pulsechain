       IDENTIFICATION DIVISION.
       PROGRAM-ID. ANKH-PATENT-0003-STRAT.
       AUTHOR. AUNCIENT DYSNOMIA VM / PATENT 0003.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-PATENT-PARAMS.
          05 WS-INIT-QUANT-DRIFT-PPM   PIC 9(05) VALUE 16000.
          05 WS-BLOCK-SIZE-BYTES       PIC 9(04) VALUE 0064.
          05 WS-QUANT-CYCLES-N         PIC 9(02) VALUE 16.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-CURRENT-DRIFT          PIC 9(05) VALUE 0.
          05 WS-STEP-IDX               PIC 9(02) VALUE 0.
          05 WS-SHADOW-PATENT-BASE     PIC 9(12) VALUE 0.
          05 WS-CYC-MOD                PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-QUANT-DRIFT-PPM     VALUE 2.
             88 INVALID-BLOCK-SIZE-BYTES    VALUE 3.
             88 INVALID-QUANT-CYCLES-N      VALUE 4.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
             88 QUANTIZATION-DIVERG-FAIL    VALUE 6.
             88 GATING-CLAMP-OVERFLOW       VALUE 7.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 8.
             88 CASCADE-ROLLBACK-FAIL       VALUE 9.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-QUANT-CONTRACTION
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-INIT-QUANT-DRIFT-PPM > 50000
               SET INVALID-QUANT-DRIFT-PPM TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-BLOCK-SIZE-BYTES NOT EQUAL 64  AND
              WS-BLOCK-SIZE-BYTES NOT EQUAL 128 AND
              WS-BLOCK-SIZE-BYTES NOT EQUAL 256 AND
              WS-BLOCK-SIZE-BYTES NOT EQUAL 512
               SET INVALID-BLOCK-SIZE-BYTES TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-QUANT-CYCLES-N < 1 OR WS-QUANT-CYCLES-N > 64
               SET INVALID-QUANT-CYCLES-N TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-QUANT-CONTRACTION.
           MOVE WS-INIT-QUANT-DRIFT-PPM TO WS-CURRENT-DRIFT.

           PERFORM VARYING WS-STEP-IDX FROM 1 BY 1 UNTIL WS-STEP-IDX > WS-QUANT-CYCLES-N
               COMPUTE WS-CURRENT-DRIFT = (WS-CURRENT-DRIFT * 875) / 1000
           END-PERFORM.

           IF WS-CURRENT-DRIFT > WS-INIT-QUANT-DRIFT-PPM
               SET QUANTIZATION-DIVERG-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-SHADOW-PATENT-BASE = (WS-CICS-WRITER-ID * 1000000) + 
               (WS-QUANT-CYCLES-N * 10000) + (WS-BLOCK-SIZE-BYTES * 10) + (WS-CURRENT-DRIFT / 16).

           COMPUTE WS-CYC-MOD = FUNCTION MOD(WS-QUANT-CYCLES-N, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-CYC-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-PATENT-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-PATENT-BASE + ((WS-CURRENT-DRIFT * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-PATENT-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-QUANT-CYCLES-N * 10000) + (WS-BLOCK-SIZE-BYTES * 10) + (WS-CURRENT-DRIFT / 16))
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-PATENT-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
