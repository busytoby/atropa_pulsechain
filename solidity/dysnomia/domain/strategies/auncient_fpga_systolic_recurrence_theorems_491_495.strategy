        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-SYSTOLIC-REC.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-SYSTOLIC-REC-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH491-SYSTOLIC-REC-OK    PIC 9(01) VALUE 1.
            05  WS-TH492-DSP-THROUGHPUT-OK  PIC 9(01) VALUE 1.
            05  WS-TH493-ACCUM-CONSERV-OK   PIC 9(01) VALUE 1.
            05  WS-TH494-SYSTOLIC-SAAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH495-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-SYSTOLIC-REC-WIT    PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-SYSTOLIC-REC.
            GOBACK.
        1000-EVALUATE-SYSTOLIC-REC.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH491-SYSTOLIC-REC-OK = 1 AND
               WS-TH492-DSP-THROUGHPUT-OK = 1 AND
               WS-TH493-ACCUM-CONSERV-OK = 1 AND
               WS-TH494-SYSTOLIC-SAAT-OK = 1 AND
               WS-TH495-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-SYSTOLIC-REC-WIT
            ELSE
                MOVE 0 TO WS-FPGA-SYSTOLIC-REC-WIT.
