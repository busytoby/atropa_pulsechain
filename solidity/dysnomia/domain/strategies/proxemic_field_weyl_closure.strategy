        IDENTIFICATION DIVISION.
        PROGRAM-ID. PROX-WEYL-STRAT.
        AUTHOR. AUNCIENT DYSNOMIA VM / PROXEMIC WEYL CLOSURE AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-PROX-PARAMS.
           05 WS-DISTANCE-R             PIC 9(03) VALUE 030.
           05 WS-OFFSET-R0              PIC 9(03) VALUE 010.
           05 WS-APPROACH-POWER         PIC 9(04) VALUE 0800.
           05 WS-SINGULAR-LOCUS         PIC 9(05) VALUE 02500.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-EFFECTIVE-RADIUS       PIC 9(04) VALUE 0.
           05 WS-FIELD-POTENTIAL        PIC 9(04) VALUE 0.
           05 WS-PROX-VITALITY          PIC 9(09) VALUE 0.
           05 WS-PROX-COHERENCE         PIC 9(09) VALUE 0.
           05 WS-PROX-REBAR-LATCH       PIC 9(12) VALUE 0.
           05 WS-SHADOW-PROX-BASE       PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 INVALID-DISTANCE-OR-OFFSET  VALUE 2.
              88 INVALID-APPROACH-POWER      VALUE 3.
              88 INVALID-SINGULAR-LOCUS      VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 PROXEMIC-CLOSURE-COLLAPSE   VALUE 6.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 7.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-PROXEMIC-CLOSURE
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-DISTANCE-R < 1 OR WS-DISTANCE-R > 200 OR
               WS-OFFSET-R0 < 1 OR WS-OFFSET-R0 > 50
                SET INVALID-DISTANCE-OR-OFFSET TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-APPROACH-POWER < 100 OR WS-APPROACH-POWER > 1000
                SET INVALID-APPROACH-POWER TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-SINGULAR-LOCUS < 100 OR WS-SINGULAR-LOCUS > 10000
                SET INVALID-SINGULAR-LOCUS TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-EFFECTIVE-RADIUS = WS-DISTANCE-R + WS-OFFSET-R0.
            COMPUTE WS-FIELD-POTENTIAL = (WS-APPROACH-POWER * 100) / WS-EFFECTIVE-RADIUS.
            IF WS-FIELD-POTENTIAL > 1000
                MOVE 1000 TO WS-FIELD-POTENTIAL
            END-IF.

            IF WS-FIELD-POTENTIAL EQUAL ZERO
                SET PROXEMIC-CLOSURE-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-PROXEMIC-CLOSURE.
            COMPUTE WS-PROX-VITALITY = (WS-FIELD-POTENTIAL / 4) +
                                       (WS-SINGULAR-LOCUS / 16) +
                                       (WS-APPROACH-POWER / 8) + 1.

            IF WS-PROX-VITALITY EQUAL ZERO
                SET PROXEMIC-CLOSURE-COLLAPSE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-PROX-COHERENCE = (WS-FIELD-POTENTIAL / 16) +
                                        (WS-SINGULAR-LOCUS / 64) +
                                        (WS-APPROACH-POWER / 32).

            COMPUTE WS-PROX-REBAR-LATCH = 1470169088 +
                                          (WS-FIELD-POTENTIAL / 2) +
                                          (WS-SINGULAR-LOCUS / 8).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-PROX-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                          (WS-PROX-VITALITY * 10) +
                                          (WS-PROX-COHERENCE * 10) +
                                          (WS-FIELD-POTENTIAL * 10) +
                                          (WS-PROX-REBAR-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-PROX-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-PROX-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
