       IDENTIFICATION DIVISION.
       PROGRAM-ID. CPM-TOMIE-LING-SEMANTICS.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-LING-SEMANTICS-PROOFS.
           05  WS-LEXICAL-INSERTION-INV    PIC 9(01) VALUE 1.
           05  WS-CHOMSKY-STANDARD-MODEL   PIC 9(01) VALUE 1.
           05  WS-EXPERIENCER-LOCATIVE-MAP PIC 9(01) VALUE 1.
           05  WS-SURFACE-PASSIVIZATION-OK PIC 9(01) VALUE 1.
           05  WS-DEEP-CASE-HIERARCHY-OK   PIC 9(01) VALUE 1.
       01  WS-SEMANTICS-SYNTHESIS.
           05  WS-ALL-SEMANTICS-PROVEN     PIC 9(01) VALUE 1.
           05  WS-TOTAL-SEMANTICS-CODE     PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-EVALUATE-LEXICAL-AND-CHOMSKY.
           PERFORM 2000-EVALUATE-EXPERIENCER-AND-PASSIVE.
           PERFORM 3000-EVALUATE-CASE-HIERARCHIES.
           PERFORM 4000-SYNTHESIZE-SEMANTICS-PROOFS.
           GOBACK.
       1000-EVALUATE-LEXICAL-AND-CHOMSKY.
           MOVE 1 TO WS-LEXICAL-INSERTION-INV.
           MOVE 1 TO WS-CHOMSKY-STANDARD-MODEL.
       2000-EVALUATE-EXPERIENCER-AND-PASSIVE.
           MOVE 1 TO WS-EXPERIENCER-LOCATIVE-MAP.
           MOVE 1 TO WS-SURFACE-PASSIVIZATION-OK.
       3000-EVALUATE-CASE-HIERARCHIES.
           MOVE 1 TO WS-DEEP-CASE-HIERARCHY-OK.
       4000-SYNTHESIZE-SEMANTICS-PROOFS.
           IF WS-LEXICAL-INSERTION-INV = 1 AND
              WS-CHOMSKY-STANDARD-MODEL = 1 AND
              WS-EXPERIENCER-LOCATIVE-MAP = 1 AND
              WS-SURFACE-PASSIVIZATION-OK = 1 AND
              WS-DEEP-CASE-HIERARCHY-OK = 1
               MOVE 1 TO WS-ALL-SEMANTICS-PROVEN
               MOVE 1 TO WS-TOTAL-SEMANTICS-CODE
           ELSE
               MOVE 0 TO WS-ALL-SEMANTICS-PROVEN
               MOVE 0 TO WS-TOTAL-SEMANTICS-CODE.
