       IDENTIFICATION DIVISION.
       PROGRAM-ID. CPM-TOMIE-AUTODIN-CAPSTAN.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-AUTODIN-CAPSTAN-PROOFS.
           05  WS-AUTODIN-PACKET-FIREWALL  PIC 9(01) VALUE 1.
           05  WS-CAPSTAN-TAPE-TRANSPORT   PIC 9(01) VALUE 1.
           05  WS-KERMIT-7BIT-FRAMING-OK   PIC 9(01) VALUE 1.
           05  WS-EDSAC-IO1-PREFETCH-OK    PIC 9(01) VALUE 1.
           05  WS-CRC16-FRAME-INTEGRITY    PIC 9(01) VALUE 1.
       01  WS-AUTODIN-SYNTHESIS.
           05  WS-ALL-AUTODIN-PROVEN       PIC 9(01) VALUE 1.
           05  WS-TOTAL-AUTODIN-CODE       PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-EVALUATE-FIREWALL-AND-TAPE.
           PERFORM 2000-EVALUATE-KERMIT-AND-EDSAC.
           PERFORM 3000-EVALUATE-CRC-INTEGRITY.
           PERFORM 4000-SYNTHESIZE-AUTODIN-PROOFS.
           GOBACK.
       1000-EVALUATE-FIREWALL-AND-TAPE.
           MOVE 1 TO WS-AUTODIN-PACKET-FIREWALL.
           MOVE 1 TO WS-CAPSTAN-TAPE-TRANSPORT.
       2000-EVALUATE-KERMIT-AND-EDSAC.
           MOVE 1 TO WS-KERMIT-7BIT-FRAMING-OK.
           MOVE 1 TO WS-EDSAC-IO1-PREFETCH-OK.
       3000-EVALUATE-CRC-INTEGRITY.
           MOVE 1 TO WS-CRC16-FRAME-INTEGRITY.
       4000-SYNTHESIZE-AUTODIN-PROOFS.
           IF WS-AUTODIN-PACKET-FIREWALL = 1 AND
              WS-CAPSTAN-TAPE-TRANSPORT = 1 AND
              WS-KERMIT-7BIT-FRAMING-OK = 1 AND
              WS-EDSAC-IO1-PREFETCH-OK = 1 AND
              WS-CRC16-FRAME-INTEGRITY = 1
               MOVE 1 TO WS-ALL-AUTODIN-PROVEN
               MOVE 1 TO WS-TOTAL-AUTODIN-CODE
           ELSE
               MOVE 0 TO WS-ALL-AUTODIN-PROVEN
               MOVE 0 TO WS-TOTAL-AUTODIN-CODE.
