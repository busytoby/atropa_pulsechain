       IDENTIFICATION DIVISION.
       PROGRAM-ID. ANKH-VAL-STRATEGY.
       AUTHOR. AUNCIENT DYSNOMIA VM / INITIAL ORDERS 1 VALIDATOR.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-VAL-PARAMS.
          05 WS-REQUESTED-CTX-TOKENS   PIC 9(05) VALUE 32768.
          05 WS-OPCODE-BITMASK-VAL     PIC 9(05) VALUE 01024.
          05 WS-VALIDATION-CYCLES-N    PIC 9(02) VALUE 16.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-CURRENT-CTX-ENTROPY    PIC 9(05) VALUE 0.
          05 WS-STEP-IDX               PIC 9(02) VALUE 0.
          05 WS-CTX-REM                PIC 9(03) VALUE 0.
          05 WS-SHADOW-VAL-BASE        PIC 9(12) VALUE 0.
          05 WS-CYC-MOD                PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-REQUESTED-CTX       VALUE 2.
             88 INVALID-OPCODE-BITMASK      VALUE 3.
             88 INVALID-VALIDATION-CYCLES   VALUE 4.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
             88 CONTEXT-ENTROPY-DIVERG-FAIL VALUE 6.
             88 GATING-CLAMP-OVERFLOW       VALUE 7.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 8.
             88 CASCADE-ROLLBACK-FAIL       VALUE 9.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-CONTEXT-VALIDATION
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-REQUESTED-CTX-TOKENS < 8192 OR WS-REQUESTED-CTX-TOKENS > 65536
               SET INVALID-REQUESTED-CTX TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-OPCODE-BITMASK-VAL > 50000
               SET INVALID-OPCODE-BITMASK TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-VALIDATION-CYCLES-N < 1 OR WS-VALIDATION-CYCLES-N > 64
               SET INVALID-VALIDATION-CYCLES TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-CONTEXT-VALIDATION.
           COMPUTE WS-CURRENT-CTX-ENTROPY = (WS-REQUESTED-CTX-TOKENS / 64) * 20.
           IF WS-CURRENT-CTX-ENTROPY < 5000 MOVE 5000 TO WS-CURRENT-CTX-ENTROPY.
           IF WS-CURRENT-CTX-ENTROPY > 50000 MOVE 50000 TO WS-CURRENT-CTX-ENTROPY.

           PERFORM VARYING WS-STEP-IDX FROM 1 BY 1 UNTIL WS-STEP-IDX > WS-VALIDATION-CYCLES-N
               COMPUTE WS-CURRENT-CTX-ENTROPY = (WS-CURRENT-CTX-ENTROPY * 875) / 1000
           END-PERFORM.

           IF WS-CURRENT-CTX-ENTROPY > 50000
               SET CONTEXT-ENTROPY-DIVERG-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-CTX-REM = FUNCTION MOD(WS-REQUESTED-CTX-TOKENS, 100).

           COMPUTE WS-SHADOW-VAL-BASE = (WS-CICS-WRITER-ID * 1000000) + 
               (WS-VALIDATION-CYCLES-N * 10000) + (WS-CTX-REM * 10) + (WS-CURRENT-CTX-ENTROPY / 16).

           COMPUTE WS-CYC-MOD = FUNCTION MOD(WS-VALIDATION-CYCLES-N, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-CYC-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-VAL-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-VAL-BASE + ((WS-CURRENT-CTX-ENTROPY * WS-G-GATE-FACTOR) / 1000)
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-VAL-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-VALIDATION-CYCLES-N * 10000) + (WS-CTX-REM * 10) + (WS-CURRENT-CTX-ENTROPY / 16))
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-VAL-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
