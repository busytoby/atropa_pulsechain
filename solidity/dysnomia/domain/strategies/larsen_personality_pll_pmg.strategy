        IDENTIFICATION DIVISION.
        PROGRAM-ID. LARSEN-PERSONALITY-PLL-PMG-STRATEGY.
        AUTHOR. AUNCIENT DYSNOMIA VM / LARSEN AUDIT.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.

        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01 WS-LARSEN-PARAMETERS.
           05 WS-ARCHETYPE-ID           PIC 9(02) VALUE 04.
           05 WS-DEMEANOR-Q16           PIC 9(06) VALUE 032768.
           05 WS-PLL-PHASE-ERROR-Q16    PIC 9(06) VALUE 016384.
           05 WS-PMG-SPRITE-X           PIC 9(03) VALUE 160.
           05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
           05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
           05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

        01 WS-INTERMEDIATE-REGISTERS.
           05 WS-DAMPED-PLL-ERROR       PIC 9(06) VALUE 0.
           05 WS-PERSONALITY-ENERGY     PIC 9(09) VALUE 0.
           05 WS-PMG-SPRITE-LATCH       PIC 9(12) VALUE 0.
           05 WS-SHADOW-LARSEN-BASE     PIC 9(12) VALUE 0.
           05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
           05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

        01 WS-CLASSIFICATION-RULINGS.
           05 WS-RULING-CODE            PIC 9(02) VALUE 0.
              88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
              88 INVALID-K-EXPONENT          VALUE 1.
              88 INVALID-ARCHETYPE-ID        VALUE 2.
              88 INVALID-DEMEANOR-VALUE      VALUE 3.
              88 INVALID-PLL-PHASE-ERROR     VALUE 4.
              88 CICS-CITIZEN-UNVERIFIED     VALUE 5.
              88 INVALID-PMG-SPRITE-X        VALUE 6.
              88 PLL-LOCK-UNDERFLOW-FAIL     VALUE 7.
              88 SHADOW-ISOLATION-CORRUPT    VALUE 8.

        PROCEDURE DIVISION.
        0000-MAIN-EVALUATION.
            PERFORM 1000-VALIDATE-PREREQUISITES.
            IF WS-RULING-CODE EQUAL ZERO
                PERFORM 2000-PROCESS-LARSEN-PLL
                PERFORM 3000-VERIFY-ACID-INVARIANTS
            END-IF.
            STOP RUN.

        1000-VALIDATE-PREREQUISITES.
            IF WS-K-EXPONENT NOT EQUAL 3
                SET INVALID-K-EXPONENT TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-ARCHETYPE-ID < 1 OR WS-ARCHETYPE-ID > 8
                SET INVALID-ARCHETYPE-ID TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-DEMEANOR-Q16 > 65536
                SET INVALID-DEMEANOR-VALUE TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-PLL-PHASE-ERROR-Q16 > 65536
                SET INVALID-PLL-PHASE-ERROR TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-PMG-SPRITE-X > 320
                SET INVALID-PMG-SPRITE-X TO TRUE
                EXIT PARAGRAPH
            END-IF.

            IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
               WS-CICS-WRITER-ID NOT EQUAL 888 AND
               WS-CICS-WRITER-ID NOT EQUAL 99  AND
               WS-CICS-WRITER-ID NOT EQUAL 42
                SET CICS-CITIZEN-UNVERIFIED TO TRUE
                EXIT PARAGRAPH
            END-IF.

        2000-PROCESS-LARSEN-PLL.
            COMPUTE WS-DAMPED-PLL-ERROR = (WS-PLL-PHASE-ERROR-Q16 * 875) / 1000.
            COMPUTE WS-PERSONALITY-ENERGY = (WS-DEMEANOR-Q16 * 8) + (WS-ARCHETYPE-ID * 1024) + 1.

            IF WS-PERSONALITY-ENERGY EQUAL ZERO
                SET PLL-LOCK-UNDERFLOW-FAIL TO TRUE
                EXIT PARAGRAPH
            END-IF.

            COMPUTE WS-PMG-SPRITE-LATCH = 1470169088 + (WS-PMG-SPRITE-X * 64) + (WS-ARCHETYPE-ID * 8).

        3000-VERIFY-ACID-INVARIANTS.
            COMPUTE WS-SHADOW-LARSEN-BASE = (WS-CICS-WRITER-ID * 1000000) +
                                            (WS-PERSONALITY-ENERGY * 10) +
                                            (WS-DAMPED-PLL-ERROR / 10) +
                                            (WS-PMG-SPRITE-LATCH / 10000).

            IF WS-SIMULATE-FAULT EQUAL 'Y'
                COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-LARSEN-BASE - 1163
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT + 1163, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            ELSE
                MOVE WS-SHADOW-LARSEN-BASE TO WS-COMMITTED-OUTPUT
                COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256)
                SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE
            END-IF.
