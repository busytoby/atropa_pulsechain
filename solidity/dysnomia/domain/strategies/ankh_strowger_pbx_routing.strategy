       IDENTIFICATION DIVISION.
       PROGRAM-ID. ANKH-STROWGER-PBX-STRATEGY.
       AUTHOR. AUNCIENT DYSNOMIA VM / ANKH STROWGER PBX ROUTING.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-PBX-PARAMETERS.
          05 WS-DIAL-PULSE-COUNT       PIC 9(02) VALUE 12.
          05 WS-ORIGIN-EXTENSION       PIC 9(02) VALUE 01.
          05 WS-TOKEN-FRAME-QUANTA     PIC 9(09) VALUE 000065536.
          05 WS-CICS-WRITER-ID         PIC 9(04) VALUE 555.
          05 WS-SIMULATE-FAULT         PIC X(01) VALUE 'N'.
          05 WS-K-EXPONENT             PIC 9(01) VALUE 3.

       01 WS-INTERMEDIATE-REGISTERS.
          05 WS-DEST-TRUNK-ID          PIC 9(02) VALUE 0.
          05 WS-SHADOW-PBX-BASE        PIC 9(12) VALUE 0.
          05 WS-TRUNK-MOD              PIC 9(02) VALUE 0.
          05 WS-G-GATE-FACTOR          PIC 9(04) VALUE 0.
          05 WS-ROUTED-PAYLOAD         PIC 9(09) VALUE 0.
          05 WS-COMMITTED-OUTPUT       PIC 9(12) VALUE 0.
          05 WS-DISP-WRAP-MOD          PIC 9(03) VALUE 0.

       01 WS-CLASSIFICATION-RULINGS.
          05 WS-RULING-CODE            PIC 9(02) VALUE 0.
             88 QUALIFIED-ORBITAL-HANDSHAKE VALUE 0.
             88 INVALID-K-EXPONENT          VALUE 1.
             88 INVALID-PULSE-COUNT         VALUE 2.
             88 INVALID-ORIGIN-EXT          VALUE 3.
             88 CICS-CITIZEN-UNVERIFIED     VALUE 4.
             88 TRUNK-SEIZE-COLLISION       VALUE 5.
             88 GATING-CLAMP-OVERFLOW       VALUE 6.
             88 SHADOW-ISOLATION-CORRUPT    VALUE 7.
             88 CASCADE-ROLLBACK-FAIL       VALUE 8.

       PROCEDURE DIVISION.
       0000-MAIN-EVALUATION.
           PERFORM 1000-VALIDATE-PREREQUISITES.
           IF WS-RULING-CODE EQUAL ZERO
               PERFORM 2000-EXECUTE-STROWGER-ROUTING
               PERFORM 3000-VERIFY-ACID-INVARIANTS
           END-IF.
           STOP RUN.

       1000-VALIDATE-PREREQUISITES.
           IF WS-K-EXPONENT NOT EQUAL 3
               SET INVALID-K-EXPONENT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-DIAL-PULSE-COUNT < 1 OR WS-DIAL-PULSE-COUNT > 24
               SET INVALID-PULSE-COUNT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-ORIGIN-EXTENSION < 1 OR WS-ORIGIN-EXTENSION > 24
               SET INVALID-ORIGIN-EXT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-CICS-WRITER-ID NOT EQUAL 555 AND
              WS-CICS-WRITER-ID NOT EQUAL 888 AND
              WS-CICS-WRITER-ID NOT EQUAL 99  AND
              WS-CICS-WRITER-ID NOT EQUAL 42
               SET CICS-CITIZEN-UNVERIFIED TO TRUE
               EXIT PARAGRAPH
           END-IF.

       2000-EXECUTE-STROWGER-ROUTING.
           MOVE WS-DIAL-PULSE-COUNT TO WS-DEST-TRUNK-ID.

           COMPUTE WS-SHADOW-PBX-BASE = (WS-CICS-WRITER-ID * 1000000) + 
               (WS-DEST-TRUNK-ID * 10000) + (WS-ORIGIN-EXTENSION * 100).

           COMPUTE WS-TRUNK-MOD = FUNCTION MOD(WS-DEST-TRUNK-ID, 8).
           COMPUTE WS-G-GATE-FACTOR = 875 + ((125 * WS-TRUNK-MOD) / 8).
           IF WS-G-GATE-FACTOR < 875 OR WS-G-GATE-FACTOR > 1000
               SET GATING-CLAMP-OVERFLOW TO TRUE
               EXIT PARAGRAPH
           END-IF.

           COMPUTE WS-ROUTED-PAYLOAD = (WS-TOKEN-FRAME-QUANTA * WS-G-GATE-FACTOR) / 1000.

           IF WS-SIMULATE-FAULT EQUAL 'Y'
               MOVE WS-SHADOW-PBX-BASE TO WS-COMMITTED-OUTPUT
           ELSE
               COMPUTE WS-COMMITTED-OUTPUT = WS-SHADOW-PBX-BASE + WS-ROUTED-PAYLOAD
           END-IF.

           COMPUTE WS-DISP-WRAP-MOD = FUNCTION MOD(WS-COMMITTED-OUTPUT, 256).

       3000-VERIFY-ACID-INVARIANTS.
           IF WS-SHADOW-PBX-BASE NOT EQUAL ((WS-CICS-WRITER-ID * 1000000) + (WS-DEST-TRUNK-ID * 10000) + (WS-ORIGIN-EXTENSION * 100))
               SET SHADOW-ISOLATION-CORRUPT TO TRUE
               EXIT PARAGRAPH
           END-IF.

           IF WS-SIMULATE-FAULT EQUAL 'Y' AND WS-COMMITTED-OUTPUT NOT EQUAL WS-SHADOW-PBX-BASE
               SET CASCADE-ROLLBACK-FAIL TO TRUE
               EXIT PARAGRAPH
           END-IF.

           SET QUALIFIED-ORBITAL-HANDSHAKE TO TRUE.
