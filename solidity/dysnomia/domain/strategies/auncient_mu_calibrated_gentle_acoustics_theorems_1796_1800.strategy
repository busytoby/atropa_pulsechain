        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-GENTLE-ACOUSTICS.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-GENTLE-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH1796-GENTLE-OK         PIC 9(01) VALUE 1.
            05  WS-TH1797-DATBIN-STRAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1798-SUBMICRO-LAT-OK   PIC 9(01) VALUE 1.
            05  WS-TH1799-1800M-SAAT-OK     PIC 9(01) VALUE 1.
            05  WS-TH1800-PARITY-SEAL-OK    PIC 9(01) VALUE 1.
            05  WS-GENTLE-WIT               PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-GENTLE.
            GOBACK.
        1000-EVALUATE-GENTLE.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH1796-GENTLE-OK = 1 AND
               WS-TH1797-DATBIN-STRAT-OK = 1 AND
               WS-TH1798-SUBMICRO-LAT-OK = 1 AND
               WS-TH1799-1800M-SAAT-OK = 1 AND
               WS-TH1800-PARITY-SEAL-OK = 1
                MOVE 1 TO WS-GENTLE-WIT
            ELSE
                MOVE 0 TO WS-GENTLE-WIT.
