        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-FPGA-SUPERCONDUCTING.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-FPGA-SUPERCONDUCT-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH311-ICOSITETRA-OK      PIC 9(01) VALUE 1.
            05  WS-TH312-FLUX-PINNING-OK    PIC 9(01) VALUE 1.
            05  WS-TH313-PERSISTENT-OK      PIC 9(01) VALUE 1.
            05  WS-TH314-SAAT-SUPER-OK      PIC 9(01) VALUE 1.
            05  WS-TH315-PARITY-CLOSURE-OK  PIC 9(01) VALUE 1.
            05  WS-FPGA-SUPERCONDUCT-WIT    PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-SUPERCONDUCT.
            GOBACK.
        1000-EVALUATE-SUPERCONDUCT.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH311-ICOSITETRA-OK = 1 AND
               WS-TH312-FLUX-PINNING-OK = 1 AND
               WS-TH313-PERSISTENT-OK = 1 AND
               WS-TH314-SAAT-SUPER-OK = 1 AND
               WS-TH315-PARITY-CLOSURE-OK = 1
                MOVE 1 TO WS-FPGA-SUPERCONDUCT-WIT
            ELSE
                MOVE 0 TO WS-FPGA-SUPERCONDUCT-WIT.
