        IDENTIFICATION DIVISION.
        PROGRAM-ID. AUNCIENT-ENOLL-ADVANCED-THEOREMS-66-70.
        ENVIRONMENT DIVISION.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  WS-ENOLL-ADV-STATE.
            05  WS-TPA-BASE-ADDR            PIC 9(05) VALUE 00256.
            05  WS-TH66-OI2-VALUE-OK        PIC 9(01) VALUE 1.
            05  WS-TH67-ACTION-RESEARCH-OK  PIC 9(01) VALUE 1.
            05  WS-TH68-MIXED-METHODS-OK    PIC 9(01) VALUE 1.
            05  WS-TH69-URBAN-HOMOMORPH-OK  PIC 9(01) VALUE 1.
            05  WS-TH70-SOVEREIGN-IP-OK     PIC 9(01) VALUE 1.
            05  WS-ENOLL-ADV-WITNESS        PIC 9(01) VALUE 0.
        PROCEDURE DIVISION.
        0000-MAIN-LOGIC.
            PERFORM 1000-EVALUATE-ENOLL-ADV.
            GOBACK.
        1000-EVALUATE-ENOLL-ADV.
            IF WS-TPA-BASE-ADDR = 00256 AND
               WS-TH66-OI2-VALUE-OK = 1 AND
               WS-TH67-ACTION-RESEARCH-OK = 1 AND
               WS-TH68-MIXED-METHODS-OK = 1 AND
               WS-TH69-URBAN-HOMOMORPH-OK = 1 AND
               WS-TH70-SOVEREIGN-IP-OK = 1
                MOVE 1 TO WS-ENOLL-ADV-WITNESS
            ELSE
                MOVE 0 TO WS-ENOLL-ADV-WITNESS.
