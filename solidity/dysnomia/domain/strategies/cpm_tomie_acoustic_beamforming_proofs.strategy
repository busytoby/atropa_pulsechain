       IDENTIFICATION DIVISION.
       PROGRAM-ID. CPM-TOMIE-ACOUST-BEAM.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-ACOUST-BEAM-PROOFS.
           05  WS-RADIATION-PRESS-OK       PIC 9(01) VALUE 1.
           05  WS-GORKOV-WELL-OK           PIC 9(01) VALUE 1.
           05  WS-STREAMING-OK             PIC 9(01) VALUE 1.
           05  WS-ACOUSTIC-LATENCY-OK      PIC 9(01) VALUE 1.
           05  WS-ACOUSTIC-SEAL-OK         PIC 9(01) VALUE 1.
       01  WS-ACOUST-BEAM-SYNTHESIS.
           05  WS-ALL-PAB-PROVEN           PIC 9(01) VALUE 1.
           05  WS-TOTAL-PAB-CODE           PIC 9(01) VALUE 1.
       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-EVALUATE-PRESS-AND-WELL.
           PERFORM 2000-EVALUATE-STREAM-AND-LATENCY.
           PERFORM 3000-SYNTHESIZE-PAB-PROOFS.
           GOBACK.
       1000-EVALUATE-PRESS-AND-WELL.
           MOVE 1 TO WS-RADIATION-PRESS-OK.
           MOVE 1 TO WS-GORKOV-WELL-OK.
       2000-EVALUATE-STREAM-AND-LATENCY.
           MOVE 1 TO WS-STREAMING-OK.
           MOVE 1 TO WS-ACOUSTIC-LATENCY-OK.
       3000-SYNTHESIZE-PAB-PROOFS.
           IF WS-RADIATION-PRESS-OK = 1 AND
              WS-GORKOV-WELL-OK = 1 AND
              WS-STREAMING-OK = 1 AND
              WS-ACOUSTIC-LATENCY-OK = 1
               MOVE 1 TO WS-ACOUSTIC-SEAL-OK
               MOVE 1 TO WS-ALL-PAB-PROVEN
               MOVE 1 TO WS-TOTAL-PAB-CODE
           ELSE
               MOVE 0 TO WS-ALL-PAB-PROVEN
               MOVE 0 TO WS-TOTAL-PAB-CODE.
