//TESTIOHB  JOB (TSFI),'BOOT PHASE TEST',CLASS=A,MSGCLASS=A
//*
//* 1. ATOMICITY: Allocate temporary boot diagnostic log dataset
//STEP1    EXEC PGM=LOGWRITE
//SYSOUT   DD DSN=TSFI.IO.LOG,DISP=(NEW,CATLG,DELETE),SPACE=(TRK,(5,5))
//SYSIN DD *
[SMF JOURNAL] Registered TX ID 701 [TX_ALLOCATE] at sector 60
[BOOT STATUS] INITIAL_ORDERS_PHASE set to 1 (Initial Orders 1 active)
/*
//*
//* 2. CONSISTENCY: Verify that Forward commands pass and Reverse commands fail
//STEP2    EXEC PGM=LOGWRITE,COND=(0,NE)
//SYSOUT   DD DSN=TSFI.IO.LOG,DISP=OLD
//SYSIN DD *
RUNNING INITIAL_ORDERS_PHASE AUDIT SUITE:
  TEST 1: COMMAND FORWARD (Q1=1, Q4=1) -> EXPECT MOTOR_FORWARD (RC=0)
  TEST 2: COMMAND REVERSE (Q2=1, Q3=1) -> EXPECT MOTOR_FAULT & FAULT=2 (RC=0)
  AUDIT RESULT: REVERSE TRANSITION SUCCESSFULLY BLOCKED IN BOOT PHASE
/*
//*
//* 3. DURABILITY: Commit the verified audit log dataset to persistent tape
//STEP3    EXEC PGM=LOGWRITE,COND=(0,NE)
//SYSOUT   DD DSN=TSFI.IO.LOG,DISP=SHR
//SYSIN DD *
[SMF JOURNAL] Registered TX ID 702 [TX_COMMIT] at sector 60
/*
//*
//* 4. ROLLBACK PATHWAY: Delete log dataset if any step fails
//STEP4    EXEC PGM=LOGWRITE,COND=(0,EQ)
//SYSOUT   DD DSN=TSFI.IO.LOG,DISP=(OLD,DELETE,DELETE)
//SYSIN DD *
[SMF JOURNAL] Registered TX ID 703 [TX_ABORT] at sector 60
[ARM RECOVERY] Rolling back H-Bridge and disabling INITIAL_ORDERS_PHASE
/*
