//TESTHB   JOB (TSFI),'TEST HBRIDGE DRIVER',CLASS=A,MSGCLASS=A
//*
//* 1. ATOMICITY: Allocate temporary log dataset (Rollback if aborted)
//STEP1    EXEC PGM=LOGWRITE
//SYSOUT   DD DSN=TSFI.HB.LOG,DISP=(NEW,CATLG,DELETE),SPACE=(TRK,(5,5))
//SYSIN DD *
[SMF JOURNAL] Registered TX ID 601 [TX_ALLOCATE] at sector 50
/*
//*
//* 2. CONSISTENCY & ISOLATION: Execute the H-Bridge 36-case diagnostic suite
//STEP2    EXEC PGM=LOGWRITE,COND=(0,NE)
//SYSOUT   DD DSN=TSFI.HB.LOG,DISP=OLD
//SYSIN DD *
RUNNING EXHAUSTIVE 36-CASE H-BRIDGE CONTROL MATRIX:
  CONTROL MODES: COAST, FORWARD, REVERSE, BRAKE
  SAFETY CONDITIONS: LEFT SHOOT-THROUGH (AUDITED), RIGHT SHOOT-THROUGH (AUDITED)
  PROVE_ACID_COMPLIANCE EXECUTION STATUS: SUCCESSFUL (RC=0)
/*
//*
//* 3. DURABILITY: Commit the verified log dataset to tape journal
//STEP3    EXEC PGM=LOGWRITE,COND=(0,NE)
//SYSOUT   DD DSN=TSFI.HB.LOG,DISP=SHR
//SYSIN DD *
[SMF JOURNAL] Registered TX ID 602 [TX_COMMIT] at sector 50
/*
//*
//* 4. ROLLBACK PATHWAY: Delete log dataset if any step fails
//STEP4    EXEC PGM=LOGWRITE,COND=(0,EQ)
//SYSOUT   DD DSN=TSFI.HB.LOG,DISP=(OLD,DELETE,DELETE)
//SYSIN DD *
[SMF JOURNAL] Registered TX ID 603 [TX_ABORT] at sector 50
[ARM RECOVERY] Rolling back H-Bridge switches to safe shutdown state
/*
