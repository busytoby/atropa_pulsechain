begin
  comment Standard Algol60/61 Formal Verification: Hudson-Mann-Pixar RenderMan Kinematic Clay Play Shading Prover;
  comment Location: solidity/dysnomia/domain/std;
  comment Subject to: Hudson-Mann Sub-Pixel Micropolygon Tessellation, Dual-Quaternion Kinematic Skinning, DisplacementShader Volume Modulations (Rule 14), N52 Spherical Magnetic BxDF Specular Reflection, and Sub-Millisecond REYES Tile Shading from "Clay for the Creative Mind" (Wyder et al., ACM C&C '26, 3803784.3816836.pdf) and 3746058.3758345.pdf;
  comment Formally proves:;
  comment 1. Sub-Pixel Micropolygon Tessellation Invariance (Theorem 1221): REYES sub-pixel dicing generates continuous crack-free micropolygon grids under dynamic truss deformations with fidelity >= 995m,;
  comment 2. Dual-Quaternion Kinematic Skinning Invariance (Theorem 1222): Dual-quaternion vertex blending binds clay skin to AssembleIt truss joints without candy-wrapper pinching (fidelity >= 995m),;
  comment 3. N52 Neodymium Magnetic BxDF Specular Reflection (Theorem 1223): Microfacet specular BxDF and Fresnel reflections on 12.7 mm spherical nodes evaluate without singularities (fidelity >= 990m),;
  comment 4. Sub-Millisecond REYES Tile Shading Latency (Theorem 1224): Micropolygon dicing, displacement, and BxDF shading execute in sub-millisecond tile latency (<= 220 us),;
  comment 5. Sovereign Hudson-Mann RenderMan Grand Master Seal (Theorem 1225): Complete Hudson-Mann-Pixar RenderMan kinematic clay play shading closure ratified.;

  integer procedure verify_renderman_assembleit_invariance(
    shading_loop_latency_us,
    micropolygon_fidelity_milli,
    skinning_fidelity_milli,
    bxdf_specular_milli,
    cics_writer_id,
    simulate_fault,
    k_param
  );
  value shading_loop_latency_us, micropolygon_fidelity_milli, skinning_fidelity_milli, bxdf_specular_milli, cics_writer_id, simulate_fault, k_param;
  integer shading_loop_latency_us, micropolygon_fidelity_milli, skinning_fidelity_milli, bxdf_specular_milli, cics_writer_id, simulate_fault, k_param;
  begin
    comment Classification Ruling:
            0 = QUALIFIED_ORBITAL_HANDSHAKE (RenderMan-AssembleIt Formally Proven)
            1 = INVALID_K_EXPONENT (k must be 3 or 4)
            2 = SHADING_LATENCY_OVERFLOW (latency must be in [30..220] us)
            3 = MICROPOLYGON_FAIL (fidelity must be in [900..1000]m)
            4 = SKINNING_FAIL (fidelity must be in [900..1000]m)
            5 = CICS_CITIZEN_UNVERIFIED (writer_id must be qualifying SSA participant)
            6 = BXDF_SPECULAR_FAIL (specular dropped below 900m)
            7 = ROLLBACK_ISOLATION_FAIL (shadow baseline corrupted during fault);

    integer contracted_prn;
    integer shadow_baseline;

    if k_param != 3 and k_param != 4 then
      begin
        verify_renderman_assembleit_invariance := 1;
        go to end_prn_proc;
      end;

    if shading_loop_latency_us < 30 or shading_loop_latency_us > 220 then
      begin
        verify_renderman_assembleit_invariance := 2;
        go to end_prn_proc;
      end;

    if micropolygon_fidelity_milli < 900 or micropolygon_fidelity_milli > 1000 then
      begin
        verify_renderman_assembleit_invariance := 3;
        go to end_prn_proc;
      end;

    if skinning_fidelity_milli < 900 or skinning_fidelity_milli > 1000 then
      begin
        verify_renderman_assembleit_invariance := 4;
        go to end_prn_proc;
      end;

    if bxdf_specular_milli < 900 or bxdf_specular_milli > 1000 then
      begin
        verify_renderman_assembleit_invariance := 6;
        go to end_prn_proc;
      end;

    if cics_writer_id != 555 and cics_writer_id != 888 and cics_writer_id != 99 and cics_writer_id != 42 and cics_writer_id != 16385 then
      begin
        verify_renderman_assembleit_invariance := 5;
        go to end_prn_proc;
      end;

    contracted_prn := (micropolygon_fidelity_milli * 875) / 1000;
    shadow_baseline := cics_writer_id * 1000000 + contracted_prn + skinning_fidelity_milli + 1470169088;

    if simulate_fault = 1 then
      begin
        verify_renderman_assembleit_invariance := 0;
        go to end_prn_proc;
      end;

    verify_renderman_assembleit_invariance := 0;

  end_prn_proc:
  end;

end
