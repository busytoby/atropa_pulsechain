begin
  comment Theodore Motzkin Polynomial Form & Lattice Path Prover;
  comment M(x,y) = x^4 y^2 + x^2 y^4 - 3 x^2 y^2 + 1;

  real procedure motzkinPoly(x, y);
  value x, y; real x, y;
  begin
    real x2, y2, x4, y4;
    x2 := x * x;
    y2 := y * y;
    x4 := x2 * x2;
    y4 := y2 * y2;
    motzkinPoly := x4 * y2 + x2 * y4 - 3.0 * x2 * y2 + 1.0
  end;

  real polyVal;
  integer sosBound, motzkinNum, latch;
  polyVal := motzkinPoly(1.5, 2.0);
  if polyVal >= 0.0 then sosBound := 1 else sosBound := 0;
  motzkinNum := 323;
  latch := 1470169088 + 8 * 65536 + entier(polyVal * 100.0)
end
