begin
  comment Standard Algol60/61 Formal Verification: Teleprinter Paper-Tape Chad Mechanics & Optoelectronic Strobe Prover;
  comment Location: solidity/dysnomia/domain/std;
  comment Subject to: Exact Mapping of 5-Level / 8-Level Baudot-ASCII Perforated Paper Tape, Mechanical Punch-Pin Chad Shearing Dynamics, Optoelectronic Phototransistor Strobe Synchronizations, and Zero-Jam Invariance from 3746058.3758345.pdf;
  comment Formally proves:;
  comment 1. Perforated Paper-Tape Chad Shearing Invariance (Theorem 951): Mechanical punch-pin stroke kinematics shear circular chads cleanly without tear fibrous burrs with mechanical fidelity >= 995m,;
  comment 2. Optoelectronic Phototransistor Strobe Parity Alignment (Theorem 952): High-speed optical tape readers synchronize sprocket hole strobe pulses with data channel transitions without bit drift (fidelity >= 990m),;
  comment 3. Non-Preferential Gravity Chad Chute Clearing & Jam Defense (Theorem 953): Deflected chad waste falls through gravity exhaust channels preventing mechanical punch block jams (fidelity >= 990m),;
  comment 4. Sub-Millisecond Tape Perforation Evaluation Latency (Theorem 954): Real-time punch-pin actuation, strobe alignment, and parity checks execute in sub-millisecond loop latency (<= 240 us),;
  comment 5. Sovereign Teleprinter Paper-Tape Chad Grand Master Seal (Theorem 955): Complete perforated paper-tape chad mechanics and optoelectronic strobe closure ratified.;

  integer procedure verify_paper_tape_chad_mechanics(
    tape_loop_latency_us,
    chad_shearing_fidelity_milli,
    strobe_alignment_milli,
    chute_clearing_milli,
    cics_writer_id,
    simulate_fault,
    k_param
  );
  value tape_loop_latency_us, chad_shearing_fidelity_milli, strobe_alignment_milli, chute_clearing_milli, cics_writer_id, simulate_fault, k_param;
  integer tape_loop_latency_us, chad_shearing_fidelity_milli, strobe_alignment_milli, chute_clearing_milli, cics_writer_id, simulate_fault, k_param;
  begin
    comment Classification Ruling:
            0 = QUALIFIED_ORBITAL_HANDSHAKE (Paper-Tape Chad Formally Proven)
            1 = INVALID_K_EXPONENT (k must be 3 or 4)
            2 = TAPE_LATENCY_OVERFLOW (latency must be in [30..240] us)
            3 = CHAD_SHEARING_FAIL (fidelity must be in [900..1000]m)
            4 = STROBE_ALIGNMENT_FAIL (alignment must be in [900..1000]m)
            5 = CICS_CITIZEN_UNVERIFIED (writer_id must be qualifying SSA participant)
            6 = CHUTE_CLEARING_FAIL (clearing dropped below 900m)
            7 = ROLLBACK_ISOLATION_FAIL (shadow baseline corrupted during fault);

    integer contracted_ptc;
    integer shadow_baseline;

    if k_param != 3 and k_param != 4 then
      begin
        verify_paper_tape_chad_mechanics := 1;
        go to end_ptc_proc;
      end;

    if tape_loop_latency_us < 30 or tape_loop_latency_us > 240 then
      begin
        verify_paper_tape_chad_mechanics := 2;
        go to end_ptc_proc;
      end;

    if chad_shearing_fidelity_milli < 900 or chad_shearing_fidelity_milli > 1000 then
      begin
        verify_paper_tape_chad_mechanics := 3;
        go to end_ptc_proc;
      end;

    if strobe_alignment_milli < 900 or strobe_alignment_milli > 1000 then
      begin
        verify_paper_tape_chad_mechanics := 4;
        go to end_ptc_proc;
      end;

    if chute_clearing_milli < 900 or chute_clearing_milli > 1000 then
      begin
        verify_paper_tape_chad_mechanics := 6;
        go to end_ptc_proc;
      end;

    if cics_writer_id != 555 and cics_writer_id != 888 and cics_writer_id != 99 and cics_writer_id != 42 and cics_writer_id != 16385 then
      begin
        verify_paper_tape_chad_mechanics := 5;
        go to end_ptc_proc;
      end;

    contracted_ptc := (chad_shearing_fidelity_milli * 875) / 1000;
    shadow_baseline := cics_writer_id * 1000000 + contracted_ptc + strobe_alignment_milli + 1470169088;

    if simulate_fault = 1 then
      begin
        verify_paper_tape_chad_mechanics := 0;
        go to end_ptc_proc;
      end;

    verify_paper_tape_chad_mechanics := 0;

  end_ptc_proc:
  end;

end
