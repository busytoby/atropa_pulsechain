begin
  comment Standard Algol60/61 Domain Prover: Formal SSA Registration & Hogan Bank Qualification;
  comment Location: solidity/dysnomia/domain/std;
  comment Enforces Rule 16: auncient_bridge_dna_to_ssa resolution, SSA Site Table, and HoganAccount clearance;

  integer procedure verify_formal_ssa_and_hogan_qualification(
    dna_seed,
    default_endowment_saat,
    account_clearance_level
  );
  value dna_seed, default_endowment_saat, account_clearance_level;
  integer dna_seed, default_endowment_saat, account_clearance_level;
  begin
    comment Formal Verification Codes:
            0 = QUALIFIED_PARTICIPANT (SSA Registered, Site Validated, Hogan Account Active)
            1 = INVALID_DNA_SEED (Zero seed payload)
            2 = UNREGISTERED_SSA_SITE (Area out of bounds 1..9)
            3 = DISQUALIFIED_HOGAN_ACCOUNT (Deficient balance or clearance level);

    integer area_lot, ssn_prefix, is_valid_site;

    if dna_seed = 0 then
      verify_formal_ssa_and_hogan_qualification := 1
    else
      begin
        comment Deterministic SSA Area derivation: area = (dna_seed % 9) + 1;
        area_lot := (dna_seed - (dna_seed // 9) * 9) + 1;

        comment Verify SSA Regional Issuance Site bounds: 1=New Hampshire, 2=Vermont, ..., 7=Maine;
        if area_lot >= 1 and area_lot <= 9 then
          is_valid_site := 1
        else
          is_valid_site := 0;

        if is_valid_site = 0 then
          verify_formal_ssa_and_hogan_qualification := 2
        else if default_endowment_saat = 1000000 and account_clearance_level = 1 then
          verify_formal_ssa_and_hogan_qualification := 0
        else
          verify_formal_ssa_and_hogan_qualification := 3
      end
  end;

  comment Domain Input Telemetry: Canonical Newborn Bear (Seed 42 -> Area 7 / Maine);
  integer candidate_dna_seed;
  integer initial_hogan_balance;
  integer initial_clearance;
  integer qualification_ruling;

  candidate_dna_seed     := 42;
  initial_hogan_balance  := 1000000;
  initial_clearance      := 1;

  qualification_ruling := verify_formal_ssa_and_hogan_qualification(
    candidate_dna_seed,
    initial_hogan_balance,
    initial_clearance
  );

  if qualification_ruling = 0 then
    outstring(1, "RULING: QUALIFIED_PARTICIPANT (SSA Site Verified, Hogan Account #999 Active @ 1,000,000 Saat)\n")
  else
    outstring(1, "RULING: DISQUALIFIED_ENTITY (Chancery Retained)\n")
end
