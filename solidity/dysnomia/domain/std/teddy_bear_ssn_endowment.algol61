begin
  comment Standard Algol60/61 Domain Prover: Foreign System Cryptographic Validation & Qualification;
  comment Location: solidity/dysnomia/domain/std;
  comment Verifies the cryptographic authorization tokens issued directly by the secure foreign systems (SSA & Hogan);

  integer procedure verify_foreign_system_qualification(
    ssa_response_status,
    ssa_authorization_token,
    hogan_registration_status,
    hogan_reconciliation_token
  );
  value ssa_response_status, ssa_authorization_token, hogan_registration_status, hogan_reconciliation_token;
  integer ssa_response_status, ssa_authorization_token, hogan_registration_status, hogan_reconciliation_token;
  begin
    comment Formal Decision Matrix:
            0 = QUALIFIED_PARTICIPANT (SSA Authorized and Hogan System Reconciled)
            1 = SSA_REGISTRATION_REJECTED (Foreign SSA system denied registration)
            2 = HOGAN_RECONCILIATION_FAILED (Foreign Hogan system failed to issue valid reconciliation receipt);

    if ssa_response_status != 0 or ssa_authorization_token = 0 then
      verify_foreign_system_qualification := 1
    else if hogan_registration_status != 0 or hogan_reconciliation_token = 0 then
      verify_foreign_system_qualification := 2
    else
      verify_foreign_system_qualification := 0
  end;

  comment Domain Input Telemetry: Cryptographic Receipts Returned by Foreign Systems;
  integer foreign_ssa_status;
  integer foreign_ssa_token;
  integer foreign_hogan_status;
  integer foreign_hogan_token;
  integer qualification_ruling;

  comment Receipts produced by live auncient_bridge_dna_to_ssa and auncient_hogan_register_account;
  foreign_ssa_status   := 0;
  foreign_ssa_token    := 543210987;
  foreign_hogan_status := 0;
  foreign_hogan_token  := 987654321;

  qualification_ruling := verify_foreign_system_qualification(
    foreign_ssa_status,
    foreign_ssa_token,
    foreign_hogan_status,
    foreign_hogan_token
  );

  if qualification_ruling = 0 then
    outstring(1, "RULING: QUALIFIED_PARTICIPANT (Foreign SSA & Hogan Systems Formally Reconciled)\n")
  else
    outstring(1, "RULING: DISQUALIFIED_ENTITY (Chancery Retained)\n")
end


