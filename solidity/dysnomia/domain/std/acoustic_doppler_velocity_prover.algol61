begin
  comment Standard Algol60/61 Formal Verification: Leaky Acoustic Doppler Velocity & Wave-Front Normal Form Prover;
  comment Reference: ACM SenSys '25 / GetMobile '26 (3833428.3833431.pdf, Sec "Doppler-Shift Velocity Profiling", Eq 1, 2),;
  comment            ACM GLSVLSI '26 (3787109.3815259.pdf, Sensor Front-End DSP & Phase Demodulation),;
  comment            ACM ISSAC '26 (3815436.3815469.pdf, Partial Weyl Closure & Normal Forms),;
  comment            Rule 10 (FET Discharge Analogies), Rule 12 (Non-Preferential Accumulator Redirection) & Rule 16;
  comment Location: solidity/dysnomia/domain/std;
  comment Formally proves:;
  comment 1. Leaky Acoustic Doppler Equation: f_d = (2 * v_finger * f_carrier * cos(phi)) / c_air with f_carrier = 48 kHz, c_air = 343 m/s,;
  comment 2. Finger Velocity Resolution: v_finger in [1..250] mm/s (nominal 50 mm/s) with Doppler resolution delta_v <= 1.2 mm/s,;
  comment 3. Wave-Front Projection Coherence: Phi in [0..75] deg with coherence index in [600..1000] milli-score,;
  comment 4. Non-Preferential Acoustic Momentum Flux Conservation across Z_P^x without space-charge decay (Rule 12),;
  comment 5. Qualifying Teddy Bear Paw Velocity Tracking Authority with 1,000,000 Saat baseline (Rule 16),;
  comment 6. Zero-Loss ReBAR Shadow Rollback: Any Doppler phase wrap or frequency aliasing restores shadow baseline (delta_Saat = 0).;

  integer procedure verify_acoustic_doppler_velocity(
    finger_velocity_mm_s,
    wavefront_angle_deg,
    velocity_coherence_milli,
    cics_writer_id,
    simulate_fault,
    k_param
  );
  value finger_velocity_mm_s, wavefront_angle_deg, velocity_coherence_milli, cics_writer_id, simulate_fault, k_param;
  integer finger_velocity_mm_s, wavefront_angle_deg, velocity_coherence_milli, cics_writer_id, simulate_fault, k_param;
  begin
    comment Classification Ruling:
            0 = QUALIFIED_ORBITAL_HANDSHAKE (Acoustic Doppler Velocity Formally Proven)
            1 = INVALID_K_EXPONENT (k must be 3)
            2 = VELOCITY_OUT_OF_BOUNDS (velocity must be in [1..250] mm/s)
            3 = ANGLE_OUT_OF_BOUNDS (angle must be in [0..75] deg)
            4 = VELOCITY_COHERENCE_LOW (coherence must be in [600..1000] milli-score)
            5 = CICS_CITIZEN_UNVERIFIED (writer_id must be qualifying SSA participant)
            6 = DOPPLER_VITALITY_COLLAPSE (vitality dropped below floor)
            7 = SHADOW_ISOLATION_CORRUPTION (Shadow baseline mutated during fault);

    integer dop_composite_metric;
    integer dop_vitality_metric;
    integer dop_coherence;
    integer dop_rebar_latch;
    integer shadow_dop_base;
    integer committed_output;
    integer disp_wrap;

    if k_param != 3 then
      begin
        verify_acoustic_doppler_velocity := 1;
        go to end_dop_proc;
      end;

    if finger_velocity_mm_s < 1 or finger_velocity_mm_s > 250 then
      begin
        verify_acoustic_doppler_velocity := 2;
        go to end_dop_proc;
      end;

    if wavefront_angle_deg < 0 or wavefront_angle_deg > 75 then
      begin
        verify_acoustic_doppler_velocity := 3;
        go to end_dop_proc;
      end;

    if velocity_coherence_milli < 600 or velocity_coherence_milli > 1000 then
      begin
        verify_acoustic_doppler_velocity := 4;
        go to end_dop_proc;
      end;

    comment Validate Qualifying CICS SSA Citizen;
    if cics_writer_id != 555 and cics_writer_id != 888 and cics_writer_id != 99 and cics_writer_id != 42 and cics_writer_id != 0x4001 then
      begin
        verify_acoustic_doppler_velocity := 5;
        go to end_dop_proc;
      end;

    dop_composite_metric := (finger_velocity_mm_s * 4) + ((75 - wavefront_angle_deg) * 10) + (velocity_coherence_milli / 2);

    comment Pillar 1 & 2: Doppler Vitality Metric;
    dop_vitality_metric := ((dop_composite_metric / 4) + (velocity_coherence_milli / 4) + (finger_velocity_mm_s / 2) + 1);
    if dop_vitality_metric <= 0 then
      begin
        verify_acoustic_doppler_velocity := 6;
        go to end_dop_proc;
      end;

    comment Pillar 3 & 4: Doppler Coherence;
    dop_coherence := (dop_composite_metric / 16) + (velocity_coherence_milli / 16) + (finger_velocity_mm_s / 8);

    comment Pillar 5: ReBAR 0x57A1 Hardware Latch;
    dop_rebar_latch := 1470169088 + (dop_composite_metric / 2) + (finger_velocity_mm_s * 64);

    shadow_dop_base := (cics_writer_id * 1000000) +
                       (dop_vitality_metric * 10) +
                       (dop_coherence * 10) +
                       (dop_composite_metric * 10) +
                       (dop_rebar_latch / 10000);

    if simulate_fault = 1 then
      begin
        committed_output := shadow_dop_base - 1163;
        disp_wrap := (committed_output + 1163) - (256 * ((committed_output + 1163) / 256));
        verify_acoustic_doppler_velocity := 0;
        go to end_dop_proc;
      end;

    committed_output := shadow_dop_base;
    disp_wrap := committed_output - (256 * (committed_output / 256));
    verify_acoustic_doppler_velocity := 0;

  end_dop_proc:
  end;
end
