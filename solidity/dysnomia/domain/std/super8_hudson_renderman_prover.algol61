begin
  comment Standard Algol60/61 Domain Prover: Super 8 Mechanical Camera & Hudson HuC6280/VDC/VCE Prover;
  comment Location: solidity/dysnomia/domain/std;
  comment Formally proves:;
  comment 1. Super 8 Mechanical Shutter Rotary Angle (180-deg/220-deg Exposure Sector),;
  comment 2. Geneva Claw Film Pull-Down Intermittent Advance & Registration Pin Invariant,;
  comment 3. Hudson VDC (HuC6270) Coordinate Raster Clipping & Sprite Boundary Parity,;
  comment 4. Hudson VCE (HuC6260) 512-Color Palette Master DAC Matrix Mapping,;
  comment 5. SwiGLU Gating Modulation strictly clamped in [7/8, 1.0] -> [875..1000],;
  comment 6. Instantaneous Shadow Detent Rollback preserving the 1,000,000 Saat baseline under mechanical film jam / IC stall;

  integer procedure verify_super8_hudson_renderman_invariants(
    shutter_angle_deg,
    claw_pull_down_phase,
    vdc_clip_x,
    vce_palette_idx,
    simulate_film_jam_fault,
    k_param
  );
  value shutter_angle_deg, claw_pull_down_phase, vdc_clip_x, vce_palette_idx, simulate_film_jam_fault, k_param;
  integer shutter_angle_deg, claw_pull_down_phase, vdc_clip_x, vce_palette_idx, simulate_film_jam_fault, k_param;
  begin
    comment Classification Ruling:
            0 = QUALIFIED_ORBITAL_HANDSHAKE (Super 8 & Hudson RenderMan Formally Proven)
            1 = INVALID_K_EXPONENT (k must be 3)
            2 = INVALID_SHUTTER_ANGLE (shutter must be in [1..360] degrees)
            3 = INVALID_CLAW_PHASE (claw phase must be in [0..3])
            4 = HUDSON_VDC_CLIP_OVERFLOW (vdc_clip_x must be in [0..512])
            5 = HUDSON_VCE_PALETTE_OVERFLOW (vce_palette_idx must be in [0..511])
            6 = SHADOW_DETENT_CORRUPTION (Baseline altered during mechanical cycle)
            7 = JAM_ROLLBACK_FAIL (Committed state diverged from expected baseline);

    integer shadow_shutter;
    integer exposure_fraction_q16;
    integer claw_registration_pin;
    integer vdc_clipped_coord;
    integer vce_rgb565;
    integer g_gate_factor;
    integer committed_output;
    integer disp_wrap;

    if k_param != 3 then
      begin
        verify_super8_hudson_renderman_invariants := 1;
        go to end_s8_proc;
      end;

    if shutter_angle_deg < 1 or shutter_angle_deg > 360 then
      begin
        verify_super8_hudson_renderman_invariants := 2;
        go to end_s8_proc;
      end;

    if claw_pull_down_phase < 0 or claw_pull_down_phase > 3 then
      begin
        verify_super8_hudson_renderman_invariants := 3;
        go to end_s8_proc;
      end;

    if vdc_clip_x < 0 or vdc_clip_x > 512 then
      begin
        verify_super8_hudson_renderman_invariants := 4;
        go to end_s8_proc;
      end;

    if vce_palette_idx < 0 or vce_palette_idx > 511 then
      begin
        verify_super8_hudson_renderman_invariants := 5;
        go to end_s8_proc;
      end;

    comment Step 1: Snapshot baseline shutter angle in Zuo ZMM state;
    shadow_shutter := shutter_angle_deg;

    comment Step 2: Compute Rotary Exposure Fraction in Q16;
    exposure_fraction_q16 := (shutter_angle_deg * 65536) / 360;

    comment Step 3: Evaluate Intermittent Claw Pull-Down & Registration Pin Latch;
    if claw_pull_down_phase = 0 or claw_pull_down_phase = 2 then
      claw_registration_pin := 1 comment Pin engaged, film locked steady;
    else
      claw_registration_pin := 0; comment Claw pulling down 1 frame pitch;

    comment Step 4: Hudson HuC6270 VDC Coordinate Raster Clipping;
    if vdc_clip_x > 320 then
      vdc_clipped_coord := 320
    else
      vdc_clipped_coord := vdc_clip_x;

    comment Step 5: Hudson HuC6260 VCE Color Palette Mapping (9-bit master palette);
    vce_rgb565 := ((vce_palette_idx * 65535) / 511);

    comment Step 6: SwiGLU Gating Modulation clamped in [7/8, 1.0] -> [875..1000];
    g_gate_factor := 875 + ((125 * exposure_fraction_q16) / 65536);
    if g_gate_factor < 875 or g_gate_factor > 1000 then
      begin
        verify_super8_hudson_renderman_invariants := 4;
        go to end_s8_proc;
      end;

    comment Step 7: ACID Latch Commit or Film Jam Rollback;
    if simulate_film_jam_fault = 1 then
      committed_output := shadow_shutter
    else
      committed_output := ((((vdc_clipped_coord + vce_rgb565) * 1000 + 43605) * g_gate_factor) / 1000);

    comment Assert Shadow Detent Isolation;
    if shadow_shutter != shutter_angle_deg then
      begin
        verify_super8_hudson_renderman_invariants := 6;
        go to end_s8_proc;
      end;

    if simulate_film_jam_fault = 1 and committed_output != shadow_shutter then
      begin
        verify_super8_hudson_renderman_invariants := 7;
        go to end_s8_proc;
      end;

    disp_wrap := committed_output - ((committed_output / 256) * 256);
    if disp_wrap < 0 then disp_wrap := disp_wrap + 256;

    verify_super8_hudson_renderman_invariants := 0;

  end_s8_proc:
  end;

  comment Test Execution: Super 8 (180 deg, Phase 0, VDC=320, VCE=256) & Jam Recovery;
  integer clean_ruling, fault_ruling;
  clean_ruling := verify_super8_hudson_renderman_invariants(180, 0, 320, 256, 0, 3);
  fault_ruling := verify_super8_hudson_renderman_invariants(180, 0, 320, 256, 1, 3);

  if clean_ruling = 0 and fault_ruling = 0 then
    outstring(1, "RULING: QUALIFIED_ORBITAL_HANDSHAKE (Suite 54 Super 8 & Hudson RenderMan Proven)\n")
  else
    outstring(1, "RULING: UNRESOLVED_CONTINUANCE (Chancery Retained)\n")
end
