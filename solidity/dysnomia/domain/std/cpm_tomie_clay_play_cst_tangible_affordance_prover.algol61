  );
  value prompt_syntax_error_rate, tangible_affordance_fidelity, neurodynamic_stability_milli, feedback_sync_latency_us, cics_writer_id, simulate_fault, k_param;
  integer prompt_syntax_error_rate, tangible_affordance_fidelity, neurodynamic_stability_milli, feedback_sync_latency_us, cics_writer_id, simulate_fault, k_param;
  begin
    comment Classification Ruling:
            0 = QUALIFIED_ORBITAL_HANDSHAKE (CST Tangible Affordance Formally Proven)
            1 = INVALID_K_EXPONENT (k must be 3 or 4)
            2 = PROMPT_FATIGUE_FAILURE (syntax error rate must be 0)
            3 = AFFORDANCE_DEGRADATION (fidelity must be in [850..1000]m)
            4 = NEURODYNAMIC_INSTABILITY (stability must be in [900..1000]m)
