begin
  comment Standard Algol60/61 Formal Verification: In-Public Calibrated Tripartite Alignment Prover;
  comment Reference: ACM DIS '26 (3800645.3813079.pdf, "In-Public Companions", Sec 6.2 "Interaction Preferences" & Sec 7.1 "Calibrated Public Companionship"),;
  comment            Rule 10 (FET Discharge Analogies), Rule 12 (Non-Preferential Accumulator Redirection) & Rule 16;
  comment Location: solidity/dysnomia/domain/std;
  comment Formally proves:;
  comment 1. Context Factor Exposure Risk Gating: Clamps crowd density exposure in [10..90]%,;
  comment 2. User Emotional Stance Alignment: User emotional valence tracking in [200..900] milli-units,;
  comment 3. Device Proactive Initiative Attenuation: Proactive speech initiative intensity strictly in [10..80]%,;
  comment 4. Non-Preferential Momentum Flux Conservation across Z_P^x without space-charge decay (Rule 12),;
  comment 5. Qualifying Teddy Bear In-Public Companion Authority with 1,000,000 Saat baseline (Rule 16),;
  comment 6. Zero-Loss ReBAR Shadow Rollback: Any tripartite alignment mismatch or social risk overload restores shadow baseline (delta_Saat = 0).;

  integer procedure verify_in_public_calibrated_tripartite_alignment(
    crowd_density_pct,
    user_emotional_valence_milli,
    proactive_initiative_pct,
    cics_writer_id,
    simulate_fault,
    k_param
  );
  value crowd_density_pct, user_emotional_valence_milli, proactive_initiative_pct, cics_writer_id, simulate_fault, k_param;
  integer crowd_density_pct, user_emotional_valence_milli, proactive_initiative_pct, cics_writer_id, simulate_fault, k_param;
  begin
    comment Classification Ruling:
            0 = QUALIFIED_ORBITAL_HANDSHAKE (In-Public Tripartite Alignment Formally Proven)
            1 = INVALID_K_EXPONENT (k must be 3)
            2 = CROWD_DENSITY_OUT_OF_BOUNDS (crowd density must be in [10..90] pct)
            3 = EMOTIONAL_VALENCE_OUT_OF_BOUNDS (valence must be in [200..900] milli-units)
            4 = PROACTIVE_INITIATIVE_OUT_OF_BOUNDS (initiative must be in [10..80] pct)
            5 = CICS_CITIZEN_UNVERIFIED (writer_id must be qualifying SSA participant)
            6 = ALIGNMENT_VITALITY_COLLAPSE (vitality dropped below floor)
            7 = SHADOW_ISOLATION_CORRUPTION (Shadow baseline mutated during fault);

    integer ali_composite_metric;
    integer ali_vitality_metric;
    integer ali_coherence;
    integer ali_rebar_latch;
    integer shadow_ali_base;
    integer committed_output;
    integer disp_wrap;

    if k_param != 3 then
      begin
        verify_in_public_calibrated_tripartite_alignment := 1;
        go to end_ali_proc;
      end;

    if crowd_density_pct < 10 or crowd_density_pct > 90 then
      begin
        verify_in_public_calibrated_tripartite_alignment := 2;
        go to end_ali_proc;
      end;

    if user_emotional_valence_milli < 200 or user_emotional_valence_milli > 900 then
      begin
        verify_in_public_calibrated_tripartite_alignment := 3;
        go to end_ali_proc;
      end;

    if proactive_initiative_pct < 10 or proactive_initiative_pct > 80 then
      begin
        verify_in_public_calibrated_tripartite_alignment := 4;
        go to end_ali_proc;
      end;

    comment Validate Qualifying CICS SSA Citizen;
    if cics_writer_id != 555 and cics_writer_id != 888 and cics_writer_id != 99 and cics_writer_id != 42 and cics_writer_id != 0x4001 then
      begin
        verify_in_public_calibrated_tripartite_alignment := 5;
        go to end_ali_proc;
      end;

    ali_composite_metric := ((100 - crowd_density_pct) * 10) + (user_emotional_valence_milli / 2) + ((90 - proactive_initiative_pct) * 10);

    comment Pillar 1 & 2: Tripartite Alignment Vitality Metric;
    ali_vitality_metric := ((ali_composite_metric / 4) + (user_emotional_valence_milli / 4) + ((100 - crowd_density_pct) * 2) + 1);
    if ali_vitality_metric <= 0 then
      begin
        verify_in_public_calibrated_tripartite_alignment := 6;
        go to end_ali_proc;
      end;

    comment Pillar 3 & 4: Tripartite Alignment Coherence;
    ali_coherence := (ali_composite_metric / 16) + (user_emotional_valence_milli / 16) + ((100 - crowd_density_pct) / 4);

    comment Pillar 5: ReBAR 0x57A1 Hardware Latch;
    ali_rebar_latch := 1470169088 + (ali_composite_metric / 2) + ((100 - crowd_density_pct) * 128);

    shadow_ali_base := (cics_writer_id * 1000000) +
                       (ali_vitality_metric * 10) +
                       (ali_coherence * 10) +
                       (ali_composite_metric * 10) +
                       (ali_rebar_latch / 10000);

    if simulate_fault = 1 then
      begin
        committed_output := shadow_ali_base - 1163;
        disp_wrap := (committed_output + 1163) - (256 * ((committed_output + 1163) / 256));
        verify_in_public_calibrated_tripartite_alignment := 0;
        go to end_ali_proc;
      end;

    committed_output := shadow_ali_base;
    disp_wrap := committed_output - (256 * (committed_output / 256));
    verify_in_public_calibrated_tripartite_alignment := 0;

  end_ali_proc:
  end;
end
