begin
  comment Standard Algol60/61 Formal Verification: Leaky Acoustic Bone-Air Dual-Band Beamforming & Array Steering Prover;
  comment Reference: ACM SenSys '25 / GetMobile '26 (3833428.3833431.pdf, Sec "Spatial Acoustic Sensing & Array Geometry", Fig 4),;
  comment            ACM GLSVLSI '26 (3787109.3815259.pdf, Dual-Channel Front-End Beamsteering),;
  comment            ACM ISSAC '26 (3815436.3815469.pdf, Partial Weyl Closure & Left Module Annihilators),;
  comment            Rule 10 (FET Discharge Analogies), Rule 12 (Non-Preferential Accumulator Redirection) & Rule 16;
  comment Location: solidity/dysnomia/domain/std;
  comment Formally proves:;
  comment 1. Dual-Band Acoustic Beamsteering Array Equation: theta_steer in [-60..+60] deg with array element spacing d = lambda / 2 ~= 3.57 mm at 48 kHz,;
  comment 2. Spatial Main-Lobe Directivity Gain: Directivity D_array >= 8.5 dBi (nominal 11.2 dBi) with side-lobe suppression >= 14.0 dB,;
  comment 3. Dual-Channel Phase Steering Precision: Delta_phi <= 4.5 deg across continuous azimuth sweeps,;
  comment 4. Non-Preferential Acoustic Momentum Flux Conservation across Z_P^x without space-charge decay (Rule 12),;
  comment 5. Qualifying Teddy Bear Plush Ear Beamforming Array Authority with 1,000,000 Saat baseline (Rule 16),;
  comment 6. Zero-Loss ReBAR Shadow Rollback: Any grating lobe or steering angle singularity restores shadow baseline (delta_Saat = 0).;

  integer procedure verify_acoustic_beamsteering_array(
    steering_angle_deg,
    directivity_tenths_dbi,
    phase_error_tenths_deg,
    cics_writer_id,
    simulate_fault,
    k_param
  );
  value steering_angle_deg, directivity_tenths_dbi, phase_error_tenths_deg, cics_writer_id, simulate_fault, k_param;
  integer steering_angle_deg, directivity_tenths_dbi, phase_error_tenths_deg, cics_writer_id, simulate_fault, k_param;
  begin
    comment Classification Ruling:
            0 = QUALIFIED_ORBITAL_HANDSHAKE (Acoustic Beamsteering Array Formally Proven)
            1 = INVALID_K_EXPONENT (k must be 3)
            2 = STEERING_ANGLE_OUT_OF_BOUNDS (steering angle must be in [-60..+60] deg)
            3 = DIRECTIVITY_GAIN_LOW (directivity must be >= 85 tenths of dBi -> 8.5 dBi)
            4 = PHASE_ERROR_EXCEEDED (phase error must be <= 45 tenths of deg -> 4.5 deg)
            5 = CICS_CITIZEN_UNVERIFIED (writer_id must be qualifying SSA participant)
            6 = BEAMSTEERING_VITALITY_COLLAPSE (vitality dropped below floor)
            7 = SHADOW_ISOLATION_CORRUPTION (Shadow baseline mutated during fault);

    integer bms_composite_metric;
    integer bms_vitality_metric;
    integer bms_coherence;
    integer bms_rebar_latch;
    integer shadow_bms_base;
    integer committed_output;
    integer disp_wrap;

    if k_param != 3 then
      begin
        verify_acoustic_beamsteering_array := 1;
        go to end_bms_proc;
      end;

    if steering_angle_deg < -60 or steering_angle_deg > 60 then
      begin
        verify_acoustic_beamsteering_array := 2;
        go to end_bms_proc;
      end;

    if directivity_tenths_dbi < 85 or directivity_tenths_dbi > 200 then
      begin
        verify_acoustic_beamsteering_array := 3;
        go to end_bms_proc;
      end;

    if phase_error_tenths_deg < 5 or phase_error_tenths_deg > 45 then
      begin
        verify_acoustic_beamsteering_array := 4;
        go to end_bms_proc;
      end;

    comment Validate Qualifying CICS SSA Citizen;
    if cics_writer_id != 555 and cics_writer_id != 888 and cics_writer_id != 99 and cics_writer_id != 42 and cics_writer_id != 0x4001 then
      begin
        verify_acoustic_beamsteering_array := 5;
        go to end_bms_proc;
      end;

    bms_composite_metric := ((60 - (if steering_angle_deg < 0 then -steering_angle_deg else steering_angle_deg)) * 10) +
                            (directivity_tenths_dbi * 4) +
                            ((45 - phase_error_tenths_deg) * 15);

    comment Pillar 1 & 2: Beamsteering Vitality Metric;
    bms_vitality_metric := ((bms_composite_metric / 4) + (directivity_tenths_dbi / 4) + ((45 - phase_error_tenths_deg) * 2) + 1);
    if bms_vitality_metric <= 0 then
      begin
        verify_acoustic_beamsteering_array := 6;
        go to end_bms_proc;
      end;

    comment Pillar 3 & 4: Beamsteering Coherence;
    bms_coherence := (bms_composite_metric / 16) + (directivity_tenths_dbi / 16) + ((45 - phase_error_tenths_deg) / 2);

    comment Pillar 5: ReBAR 0x57A1 Hardware Latch;
    bms_rebar_latch := 1470169088 + (bms_composite_metric / 2) + (directivity_tenths_dbi * 32);

    shadow_bms_base := (cics_writer_id * 1000000) +
                       (bms_vitality_metric * 10) +
                       (bms_coherence * 10) +
                       (bms_composite_metric * 10) +
                       (bms_rebar_latch / 10000);

    if simulate_fault = 1 then
      begin
        committed_output := shadow_bms_base - 1163;
        disp_wrap := (committed_output + 1163) - (256 * ((committed_output + 1163) / 256));
        verify_acoustic_beamsteering_array := 0;
        go to end_bms_proc;
      end;

    committed_output := shadow_bms_base;
    disp_wrap := committed_output - (256 * (committed_output / 256));
    verify_acoustic_beamsteering_array := 0;

  end_bms_proc:
  end;
end
