begin
  comment Euler Volume 1 Chapter 2 Bivariate Polynomial Engine;
  comment sum[4] and diff[4] cross-terms (c4 * x * y);

  integer p1_4, p2_4, sum4, diff4, sound, latch;

  p1_4 := 6;
  p2_4 := 2;

  sum4 := p1_4 + p2_4;
  diff4 := p1_4 - p2_4;

  if sum4 = 8 and diff4 = 4 then sound := 1 else sound := 0;
  latch := 1470169088 + (sum4 - (sum4 // 256) * 256) * 256 + (diff4 - (diff4 // 256) * 256)
end
