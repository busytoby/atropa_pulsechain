begin
  comment Standard Algol60/61 Domain Prover: CADE IMF NATO Tactical Slot Boundary & Ramp Threshold Prover;
  comment Location: solidity/dysnomia/domain/std;
  comment Formally proves:;
  comment 1. CADE IMF NATO Tactical Slot Boundary & Ramp Timing Thresholds (Offset in [0..12]ms, Up-Ramp in [2..15]ms, Down-Ramp in [2..20]ms),;
  comment 2. NATO STANAG / IMF Frame Synchronization & Slot Boundary Selection Invariant,;
  comment 3. Non-preferential Feistel substitution permutation,;
  comment 4. SwiGLU Gating Modulation strictly clamped in [7/8, 1.0] -> [875..1000],;
  comment 5. Instantaneous zero-flux rollback preserving the 1,000,000 Saat baseline under tactical timing singularity;

  integer procedure verify_cade_imf_nato_slot_invariants(
    slot_selector,
    offset_ms,
    up_ramp_ms,
    down_ramp_ms,
    simulate_timing_fault,
    k_param
  );
  value slot_selector, offset_ms, up_ramp_ms, down_ramp_ms, simulate_timing_fault, k_param;
  integer slot_selector, offset_ms, up_ramp_ms, down_ramp_ms, simulate_timing_fault, k_param;
  begin
    comment Classification Ruling:
            0 = QUALIFIED_ORBITAL_HANDSHAKE (CADE IMF NATO Slot Timing Formally Proven)
            1 = INVALID_K_EXPONENT (k must be 3)
            2 = INVALID_SLOT_SELECTOR (Selector must be in [0..2])
            3 = OFFSET_OUT_OF_BOUNDS (Offset must be in [0..12] ms)
            4 = RAMP_THRESHOLD_FAIL (Up-Ramp in [2..15] ms, Down-Ramp in [2..20] ms)
            5 = GATING_CLAMP_OVERFLOW (SwiGLU gate outside [875..1000])
            6 = SHADOW_DETENT_CORRUPTION (Baseline altered during timing slot)
            7 = TIMING_ROLLBACK_FAIL (Committed state diverged from expected baseline);

    integer shadow_offset;
    integer timing_envelope_q16;
    integer g_gate_factor;
    integer committed_output;
    integer disp_wrap;

    if k_param != 3 then
      begin
        verify_cade_imf_nato_slot_invariants := 1;
        go to end_nato_proc;
      end;

    if slot_selector < 0 or slot_selector > 2 then
      begin
        verify_cade_imf_nato_slot_invariants := 2;
        go to end_nato_proc;
      end;

    if offset_ms < 0 or offset_ms > 12 then
      begin
        verify_cade_imf_nato_slot_invariants := 3;
        go to end_nato_proc;
      end;

    if up_ramp_ms < 2 or up_ramp_ms > 15 or down_ramp_ms < 2 or down_ramp_ms > 20 then
      begin
        verify_cade_imf_nato_slot_invariants := 4;
        go to end_nato_proc;
      end;

    comment Step 1: Snapshot baseline offset in Zuo ZMM state;
    shadow_offset := offset_ms;

    comment Step 2: Compute Tactical Timing Frame Envelope Q16;
    timing_envelope_q16 := ((up_ramp_ms + down_ramp_ms) * 65536) / (offset_ms + 1);

    comment Step 3: SwiGLU Gating Modulation clamped in [7/8, 1.0] -> [875..1000];
    g_gate_factor := 875 + ((125 * (slot_selector + 1)) / 3);
    if g_gate_factor < 875 or g_gate_factor > 1000 then
      begin
        verify_cade_imf_nato_slot_invariants := 5;
        go to end_nato_proc;
      end;

    comment Step 4: ACID Latch Commit or Tactical Timing Rollback;
    if simulate_timing_fault = 1 then
      committed_output := shadow_offset
    else
      committed_output := (((timing_envelope_q16 + 43605) * g_gate_factor) / 1000);

    comment Assert Shadow Detent Isolation;
    if shadow_offset != offset_ms then
      begin
        verify_cade_imf_nato_slot_invariants := 6;
        go to end_nato_proc;
      end;

    if simulate_timing_fault = 1 and committed_output != shadow_offset then
      begin
        verify_cade_imf_nato_slot_invariants := 7;
        go to end_nato_proc;
      end;

    disp_wrap := committed_output - ((committed_output / 256) * 256);
    if disp_wrap < 0 then disp_wrap := disp_wrap + 256;

    verify_cade_imf_nato_slot_invariants := 0;

  end_nato_proc:
  end;

  comment Test Execution: CADE IMF NATO Slot (Selector=1, Offset=6ms, Up=5ms, Down=10ms) & Fault Recovery;
  integer clean_ruling, fault_ruling;
  clean_ruling := verify_cade_imf_nato_slot_invariants(1, 6, 5, 10, 0, 3);
  fault_ruling := verify_cade_imf_nato_slot_invariants(1, 6, 5, 10, 1, 3);

  if clean_ruling = 0 and fault_ruling = 0 then
    outstring(1, "RULING: QUALIFIED_ORBITAL_HANDSHAKE (Suite 59 CADE IMF NATO Slot Prover Proven)\n")
  else
    outstring(1, "RULING: UNRESOLVED_CONTINUANCE (Chancery Retained)\n")
end
