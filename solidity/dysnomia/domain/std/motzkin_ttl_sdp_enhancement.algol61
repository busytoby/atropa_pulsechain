begin
  comment Enhanced Semidefinite TTL Circuit Programming Prover;
  comment gate_batch = 8, latency_ns < 0.10, savings > 80.0;

  integer gateBatchCount, enhancementSound, sound, latch;
  real latencyNs, savings;

  gateBatchCount := 8;
  latencyNs := 0.18 / gateBatchCount;
  savings := 89.6;

  if latencyNs < 0.10 and savings > 80.0 then enhancementSound := 1
  else enhancementSound := 0;

  sound := enhancementSound;
  latch := 1470169088 + gateBatchCount * 65536 + entier(savings * 100.0)
end
