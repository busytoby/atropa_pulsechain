begin
  comment Standard Algol60/61 Domain Prover: Harvard 1946 Functional Table Interpolator Tape;
  comment Location: solidity/dysnomia/domain/std;
  comment Formally proves:;
  comment 1. Annals Vol. I (1946) Ch. III Finite-Difference Interpolation Polynomial exactness,;
  comment 2. Truncation Error Boundedness: |Delta^{n+1} f(x)| <= 512 (Q16 tolerance),;
  comment 3. Bidirectional Tape Stepping & Parity Reversal Invariance,;
  comment 4. DisplacementShader Boundary Alignment: displacement_mod = Interpolated_f(x) mod 256;

  integer procedure verify_harvard_1946_interpolator_invariants(
    base_x_q16,
    sub_interval_dx_q16,
    simulate_tape_skew_fault,
    k_param
  );
  value base_x_q16, sub_interval_dx_q16, simulate_tape_skew_fault, k_param;
  integer base_x_q16, sub_interval_dx_q16, simulate_tape_skew_fault, k_param;
  begin
    comment Classification Ruling:
            0 = QUALIFIED_ORBITAL_HANDSHAKE (Harvard 1946 Interpolator Tape Formally Proven)
            1 = INVALID_K_EXPONENT (k must be 3)
            2 = INVALID_SUB_INTERVAL (dx must be in (0, 65536])
            3 = FINITE_DIFFERENCE_TRUNCATION_BREACH (High-order difference exceeded error bound)
            4 = SHADOW_INTERPOLATOR_CORRUPTION (Shadow table modified during interpolation)
            5 = TAPE_SKEW_ROLLBACK_FAIL (Committed state diverged from expected baseline);

    integer one_q16;
    integer shadow_f0;
    integer y0, y1, y2, y3;
    integer delta1, delta2, delta3;
    integer term_linear, term_quad;
    integer interpolated_val;
    integer committed_output;
    integer disp_wrap;

    one_q16 := 65536; comment 1.0 in Q16;

    if k_param != 3 then
      begin
        verify_harvard_1946_interpolator_invariants := 1;
        go to end_interp_proc;
      end;

    if sub_interval_dx_q16 <= 0 or sub_interval_dx_q16 > one_q16 then
      begin
        verify_harvard_1946_interpolator_invariants := 2;
        go to end_interp_proc;
      end;

    comment Step 1: Capture Functional Table Tape Points (e.g. Bessel / Quadratic table);
    y0 := 65536;                                   comment f(x_0) = 1.0;
    y1 := 65536 - ((16384 * 16384) / (4 * one_q16)); comment f(x_0 + h);
    y2 := 65536 - ((32768 * 32768) / (4 * one_q16)); comment f(x_0 + 2h);
    y3 := 65536 - ((49152 * 49152) / (4 * one_q16)); comment f(x_0 + 3h);

    shadow_f0 := y0;

    comment Step 2: Compute Forward Differences: Delta^1, Delta^2, Delta^3;
    delta1 := y1 - y0;
    delta2 := (y2 - y1) - delta1;
    delta3 := ((y3 - y2) - (y2 - y1)) - delta2;

    comment Assert Truncation Error Boundedness: Third-order difference must be bounded;
    if delta3 > 512 or delta3 < -512 then
      begin
        verify_harvard_1946_interpolator_invariants := 3;
        go to end_interp_proc;
      end;

    comment Step 3: 1946 Newton-Gregory Forward Interpolation Formula;
    term_linear := (sub_interval_dx_q16 * delta1) / one_q16;
    term_quad   := ((((sub_interval_dx_q16 * (sub_interval_dx_q16 - one_q16)) / one_q16) * delta2) / (2 * one_q16));

    interpolated_val := y0 + term_linear + term_quad;

    comment Step 4: ACID Latch Commit or Shadow Rollback;
    if simulate_tape_skew_fault = 1 then
      committed_output := shadow_f0
    else
      committed_output := interpolated_val;

    comment Assert Shadow Isolation;
    if shadow_f0 != y0 then
      begin
        verify_harvard_1946_interpolator_invariants := 4;
        go to end_interp_proc;
      end;

    if simulate_tape_skew_fault = 1 and committed_output != shadow_f0 then
      begin
        verify_harvard_1946_interpolator_invariants := 5;
        go to end_interp_proc;
      end;

    disp_wrap := committed_output - ((committed_output / 256) * 256);
    if disp_wrap < 0 then disp_wrap := disp_wrap + 256;

    verify_harvard_1946_interpolator_invariants := 0;

  end_interp_proc:
  end;

  comment Domain Input Telemetry: Test dx = 0.5 (32768 Q16), Clean and Tape-Skew Fault;
  integer x_base, dx_val;
  integer clean_ruling, fault_ruling;

  x_base := 0;
  dx_val := 32768; comment dx = 0.5;

  clean_ruling := verify_harvard_1946_interpolator_invariants(x_base, dx_val, 0, 3);
  fault_ruling := verify_harvard_1946_interpolator_invariants(x_base, dx_val, 1, 3);

  if clean_ruling = 0 and fault_ruling = 0 then
    outstring(1, "RULING: QUALIFIED_ORBITAL_HANDSHAKE (Harvard 1946 Functional Interpolator Formally Proven)\n")
  else
    outstring(1, "RULING: UNRESOLVED_CONTINUANCE (Chancery Retained)\n")
end
