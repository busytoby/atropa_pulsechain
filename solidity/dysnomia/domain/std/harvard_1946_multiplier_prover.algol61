begin
  comment Standard Algol60/61 Domain Prover: Harvard Computation Laboratory (1946) Multiplier Commutator;
  comment Location: solidity/dysnomia/domain/std;
  comment Formally proves:;
  comment 1. Annals Vol. I (1946) Ch. II Dual-Path Digit Shifting Commutator exactness,;
  comment 2. Geneva-Drive Carry Propagation across 24-digit accumulator detents,;
  comment 3. Sequence-Tape Error Halt & Mechanical Dog Latch Trip Interlock (ACID baseline preservation),;
  comment 4. Non-preferential modular product alignment over Motzkin field (953467954);

  integer procedure verify_harvard_1946_multiplier_invariants(
    multiplicand_a,
    multiplier_b,
    simulate_tape_tear_fault,
    k_param
  );
  value multiplicand_a, multiplier_b, simulate_tape_tear_fault, k_param;
  integer multiplicand_a, multiplier_b, simulate_tape_tear_fault, k_param;
  begin
    comment Classification Ruling:
            0 = QUALIFIED_ORBITAL_HANDSHAKE (Harvard 1946 Multiplier & Latch Interlock Formally Proven)
            1 = INVALID_K_EXPONENT (k must be 3)
            2 = NEGATIVE_INPUT_PROHIBITED (Inputs must be positive integers)
            3 = COMMUTATOR_PRODUCT_MISMATCH (Partial product sum diverged from exact product)
            4 = SHADOW_DETENT_CORRUPTION (Shadow counter modified during multiplication)
            5 = MECHANICAL_DOG_LATCH_FAIL (Committed state diverged from expected outcome);

    integer motzkin_prime;
    integer shadow_a, shadow_b;
    integer b_temp, digit_k, weight_mult;
    integer accumulated_product;
    integer exact_product;
    integer committed_output;
    integer disp_wrap;

    motzkin_prime := 953467954;

    if k_param != 3 then
      begin
        verify_harvard_1946_multiplier_invariants := 1;
        go to end_1946_proc;
      end;

    if multiplicand_a < 0 or multiplier_b < 0 then
      begin
        verify_harvard_1946_multiplier_invariants := 2;
        go to end_1946_proc;
      end;

    comment Step 1: Lock Shadow Detent State;
    shadow_a := multiplicand_a;
    shadow_b := multiplier_b;

    comment Step 2: 1946 9-Step Digit-Shifting Commutator Emulation;
    accumulated_product := 0;
    b_temp := multiplier_b;
    weight_mult := 1;

    for digit_k := 0 step 1 until 5 do
      begin
        if b_temp > 0 then
          begin
            integer current_digit;
            current_digit := b_temp - ((b_temp / 10) * 10);
            accumulated_product := accumulated_product + (multiplicand_a * current_digit * weight_mult);
            b_temp := b_temp / 10;
            weight_mult := weight_mult * 10;
          end;
      end;

    exact_product := multiplicand_a * multiplier_b;

    if accumulated_product != exact_product then
      begin
        verify_harvard_1946_multiplier_invariants := 3;
        go to end_1946_proc;
      end;

    comment Step 3: Sequence-Tape Error Halt & Mechanical Dog Latch Trip;
    if simulate_tape_tear_fault = 1 then
      committed_output := shadow_a comment Mechanical dog drops, restoring baseline shadow;
    else
      committed_output := (accumulated_product - ((accumulated_product / motzkin_prime) * motzkin_prime));

    comment Assert Shadow Detent Isolation;
    if shadow_a != multiplicand_a or shadow_b != multiplier_b then
      begin
        verify_harvard_1946_multiplier_invariants := 4;
        go to end_1946_proc;
      end;

    if simulate_tape_tear_fault = 1 and committed_output != shadow_a then
      begin
        verify_harvard_1946_multiplier_invariants := 5;
        go to end_1946_proc;
      end;

    disp_wrap := committed_output - ((committed_output / 256) * 256);
    if disp_wrap < 0 then disp_wrap := disp_wrap + 256;

    verify_harvard_1946_multiplier_invariants := 0;

  end_1946_proc:
  end;

  comment Domain Input Telemetry: Test A = 1000000 Saat, B = 875, Clean and Latch-Trip Fault;
  integer a_in, b_in, clean_r, fault_r;

  a_in := 1000000;
  b_in := 875;

  clean_r := verify_harvard_1946_multiplier_invariants(a_in, b_in, 0, 3);
  fault_r := verify_harvard_1946_multiplier_invariants(a_in, b_in, 1, 3);

  if clean_r = 0 and fault_r = 0 then
    outstring(1, "RULING: QUALIFIED_ORBITAL_HANDSHAKE (Harvard 1946 Multiplier & Mechanical Dog Latch Formally Proven)\n")
  else
    outstring(1, "RULING: UNRESOLVED_CONTINUANCE (Chancery Retained)\n")
end
