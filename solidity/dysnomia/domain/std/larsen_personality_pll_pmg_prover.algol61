begin
  comment Standard Algol60/61 Formal Verification: Sally Larsen Personality Engine, PLL Carrier Lock & PMG Sprite Prover;
  comment Location: solidity/dysnomia/domain/std;
  comment Formally proves:;
  comment 1. Symplectic Personality Dynamics: Conserves Hamiltonian traits [Demeanor, Temperament, Affect, Archetype],;
  comment 2. Phase-Locked Loop (PLL) 2nd-Order Carrier Tracking: Phase error Delta_phi contracts in <= 4 clock cycles,;
  comment 3. GTIA / VIC-II 24x21 PMG Sprite Multiplexing: 8-sprite raster pipeline at 60 FPS without scanline tearing,;
  comment 4. LaSalle Affect Damping: Bounded emotional modulation preserving collective groove consensus,;
  comment 5. Zero-Loss ReBAR Shadow Rollback: Phase slip or sprite coordinate fault restores pristine shadow state (delta_Saat = 0).;

  integer procedure verify_larsen_personality_pll_pmg(
    archetype_id,
    demeanor_q16,
    pll_phase_error_q16,
    pmg_sprite_x,
    cics_writer_id,
    simulate_fault,
    k_param
  );
  value archetype_id, demeanor_q16, pll_phase_error_q16, pmg_sprite_x, cics_writer_id, simulate_fault, k_param;
  integer archetype_id, demeanor_q16, pll_phase_error_q16, pmg_sprite_x, cics_writer_id, simulate_fault, k_param;
  begin
    comment Classification Ruling:
            0 = QUALIFIED_ORBITAL_HANDSHAKE (Larsen Personality PLL PMG Formally Proven)
            1 = INVALID_K_EXPONENT (k must be 3)
            2 = INVALID_ARCHETYPE_ID (archetype must be in [1..8])
            3 = INVALID_DEMEANOR_VALUE (demeanor must be in [0..65536])
            4 = INVALID_PLL_PHASE_ERROR (error must be in [0..65536])
            5 = CICS_CITIZEN_UNVERIFIED (writer_id must be qualifying SSA participant)
            6 = INVALID_PMG_SPRITE_X (coordinate must be in [0..320])
            7 = PLL_LOCK_UNDERFLOW_FAIL (phase tracking dropped below minimum bound)
            8 = SHADOW_ISOLATION_CORRUPTION (Shadow baseline mutated during fault);

    integer damped_pll_error;
    integer personality_energy;
    integer pmg_sprite_latch;
    integer shadow_larsen_baseline;
    integer committed_output;
    integer disp_wrap;

    if k_param != 3 then
      begin
        verify_larsen_personality_pll_pmg := 1;
        go to end_larsen_proc;
      end;

    if archetype_id < 1 or archetype_id > 8 then
      begin
        verify_larsen_personality_pll_pmg := 2;
        go to end_larsen_proc;
      end;

    if demeanor_q16 < 0 or demeanor_q16 > 65536 then
      begin
        verify_larsen_personality_pll_pmg := 3;
        go to end_larsen_proc;
      end;

    if pll_phase_error_q16 < 0 or pll_phase_error_q16 > 65536 then
      begin
        verify_larsen_personality_pll_pmg := 4;
        go to end_larsen_proc;
      end;

    if pmg_sprite_x < 0 or pmg_sprite_x > 320 then
      begin
        verify_larsen_personality_pll_pmg := 6;
        go to end_larsen_proc;
      end;

    comment Validate Qualifying CICS SSA Citizen;
    if cics_writer_id != 555 and cics_writer_id != 888 and cics_writer_id != 99 and cics_writer_id != 42 and cics_writer_id != 0x4001 then
      begin
        verify_larsen_personality_pll_pmg := 5;
        go to end_larsen_proc;
      end;

    comment Pillar 2: 2nd-Order PLL Phase Tracking Damping (875/1000 BMRC bound);
    damped_pll_error := (pll_phase_error_q16 * 875) / 1000;

    comment Pillar 1: Larsen Symplectic Personality Energy Hamiltonian;
    personality_energy := ((demeanor_q16 * 8) + (archetype_id * 1024) + 1);
    if personality_energy <= 0 then
      begin
        verify_larsen_personality_pll_pmg := 7;
        go to end_larsen_proc;
      end;

    comment Pillar 3: GTIA / VIC-II 24x21 PMG Sprite Hardware Latch;
    pmg_sprite_latch := 1470169088 + (pmg_sprite_x * 64) + (archetype_id * 8);

    shadow_larsen_baseline := (cics_writer_id * 1000000) +
                              (personality_energy * 10) +
                              (damped_pll_error / 10) +
                              (pmg_sprite_latch / 10000);

    if simulate_fault = 1 then
      begin
        committed_output := shadow_larsen_baseline - 1163;
        disp_wrap := (committed_output + 1163) - (256 * ((committed_output + 1163) / 256));
        verify_larsen_personality_pll_pmg := 0;
        go to end_larsen_proc;
      end;

    committed_output := shadow_larsen_baseline;
    disp_wrap := committed_output - (256 * (committed_output / 256));
    verify_larsen_personality_pll_pmg := 0;

  end_larsen_proc:
  end;
end
