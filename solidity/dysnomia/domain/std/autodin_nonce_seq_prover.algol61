begin
  comment Standard Algol60/61 Domain Prover: AUTODIN Logarithmic Nonce Sequence Verification;
  comment Location: solidity/dysnomia/domain/std;
  comment Rule: Nonce_0 must be random non-zero; subsequent Nonce_{n+1} = ((ln(2)/ln(e))*Nonce_n + (1 - 1/2^5)*Nonce_n + 1) pmod MotzkinPrime;

  integer procedure verify_autodin_nonce_sequence(
    is_first_nonce,
    random_seed_valid,
    prev_nonce,
    curr_nonce,
    k_exponent
  );
  value is_first_nonce, random_seed_valid, prev_nonce, curr_nonce, k_exponent;
  integer is_first_nonce, random_seed_valid, prev_nonce, curr_nonce, k_exponent;
  begin
    comment Classification Ruling:
            0 = QUALIFIED_ORBITAL_HANDSHAKE (Nonce Sequence Verified)
            1 = INVALID_FIRST_NONCE_ENTROPY (First nonce non-random or zero)
            2 = INVALID_EXPONENT_RANGE (k must be 5)
            3 = NONCE_DERIVATION_MISMATCH (Current nonce does not match ln2/lne transition from previous);

    integer expected_next_nonce;
    integer motzkin_prime;
    integer ln2_over_lne_fixed_scaled;
    integer pow2_k;

    motzkin_prime := 953467954;
    ln2_over_lne_fixed_scaled := 693;
    pow2_k := 32; comment 2^5 = 32;

    if k_exponent != 5 then
      verify_autodin_nonce_sequence := 2
    else if is_first_nonce = 1 then
      begin
        if curr_nonce > 0 and random_seed_valid = 1 then
          verify_autodin_nonce_sequence := 0
        else
          verify_autodin_nonce_sequence := 1
      end
    else
      begin
        expected_next_nonce := ((ln2_over_lne_fixed_scaled * prev_nonce) / 1000) + (((pow2_k - 1) * prev_nonce) / pow2_k) + 1;
        if expected_next_nonce >= motzkin_prime then
          expected_next_nonce := expected_next_nonce - motzkin_prime;

        if curr_nonce = expected_next_nonce then
          verify_autodin_nonce_sequence := 0
        else
          verify_autodin_nonce_sequence := 3
      end
  end;

  comment Test Vector: First Nonce random check;
  integer ruling_genesis;
  ruling_genesis := verify_autodin_nonce_sequence(1, 1, 0, 84729103, 5);

  comment Test Vector: Subsequent Nonce transition check;
  integer ruling_step;
  integer test_prev;
  integer test_curr;
  test_prev := 100000;
  test_curr := ((693 * 100000) / 1000) + ((31 * 100000) / 32) + 1;
  ruling_step := verify_autodin_nonce_sequence(0, 0, test_prev, test_curr, 5);

  if ruling_genesis = 0 and ruling_step = 0 then
    outstring(1, "RULING: QUALIFIED_ORBITAL_HANDSHAKE (AUTODIN Logarithmic Nonce Sequence Verified)\n")
  else
    outstring(1, "RULING: UNRESOLVED_CONTINUANCE (Chancery Retained)\n")
end
