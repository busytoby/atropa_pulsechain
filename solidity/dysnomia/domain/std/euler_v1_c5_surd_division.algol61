begin
  comment Euler Volume 1 Chapter 5 Surd Division Engine;
  comment (a1+b1*sqrt(k))/(a2+b2*sqrt(k)) conjugate division;

  integer a1, b1, a2, b2, randX, radicandK, numBase, numMult, ratDenom, sound, latch;

  a1 := 4; b1 := 2;
  a2 := 2; b2 := 1;
  randX := 3;

  radicandK := randX;
  numBase := (a1 * a2) - (b1 * b2 * radicandK);
  numMult := (b1 * a2) - (a1 * b2);
  ratDenom := (a2 * a2) - (b2 * b2 * radicandK);

  if numBase = 2 and numMult = 0 and ratDenom = 1 then sound := 1
  else sound := 0;

  latch := 1470169088 + (numBase - (numBase // 256) * 256) * 256 + (ratDenom - (ratDenom // 256) * 256)
end
