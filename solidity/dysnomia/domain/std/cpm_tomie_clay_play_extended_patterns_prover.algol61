begin
  comment Standard Algol60/61 Formal Verification: Extended Clay Play Morphological & Spatial Ideation Prover;
  comment Location: solidity/dysnomia/domain/std;
  comment Subject to: Extended Direct Manipulation Patterns (Molding, Spatial Layout, Cognitive Momentum, Bounded Variance);
  comment Formally proves:;
  comment 1. Morphological Mold & Boundary Dilation Invariance (Theorem 281): Morphological stretching of idea clay boundaries scales context smoothly without semantic dislocation,;
  comment 2. Spatial Coordinate Topology & 2D Direct Manipulation Clustering (Theorem 282): Direct manipulation on 2D coordinates [0..2048]^2 preserves non-linear topological proximity,;
  comment 3. Cognitive Momentum Preservation & Zero-Disruption Divergence (Theorem 283): Direct spatial actions eliminate prompt syntax switches, holding delta_Momentum_loss == 0,;
  comment 4. Preinventive Structure Convergence & Bounded Exploration Variance (Theorem 284): Preinventive candidate variance contracts monotonically under BMRC (gamma = 875/1000),;
  comment 5. Sovereign Extended Clay Play Multi-Modal Interaction Grand Seal (Theorem 285): Complete multi-modal TPA 0100H closure ratified.;

  integer procedure verify_extended_clay_play_patterns(
    morphological_scale_milli,
    spatial_dispersion_um,
    momentum_retention_milli,
    exploration_cycles_n,
    cics_writer_id,
    simulate_fault,
    k_param
  );
  value morphological_scale_milli, spatial_dispersion_um, momentum_retention_milli, exploration_cycles_n, cics_writer_id, simulate_fault, k_param;
  integer morphological_scale_milli, spatial_dispersion_um, momentum_retention_milli, exploration_cycles_n, cics_writer_id, simulate_fault, k_param;
  begin
    comment Classification Ruling:
            0 = QUALIFIED_ORBITAL_HANDSHAKE (Extended Clay Play Formally Proven)
            1 = INVALID_K_EXPONENT (k must be 3 or 4)
            2 = INVALID_MORPH_SCALE (scale must be in [850..1150]m)
            3 = INVALID_SPATIAL_DISPERSION (dispersion must be in [0..2048] um)
            4 = INVALID_MOMENTUM_RETENTION (retention must be in [900..1000]m)
            5 = CICS_CITIZEN_UNVERIFIED (writer_id must be qualifying SSA participant)
            6 = MOMENTUM_LEAKAGE_FAIL (cognitive momentum lost during ideation)
            7 = VARIANCE_BOUND_FAIL (preinventive variance diverged)
            8 = TOPOLOGY_CORRUPTION (spatial clustering violated 2D bounds)
            9 = ROLLBACK_ISOLATION_FAIL (shadow baseline corrupted);

    integer contracted_variance;
    integer shadow_baseline;

    if k_param != 3 and k_param != 4 then
      begin
        verify_extended_clay_play_patterns := 1;
        go to end_ext_proc;
      end;

    if morphological_scale_milli < 850 or morphological_scale_milli > 1150 then
      begin
        verify_extended_clay_play_patterns := 2;
        go to end_ext_proc;
      end;

    if spatial_dispersion_um < 0 or spatial_dispersion_um > 2048 then
      begin
        verify_extended_clay_play_patterns := 3;
        go to end_ext_proc;
      end;

    if momentum_retention_milli < 900 or momentum_retention_milli > 1000 then
      begin
        verify_extended_clay_play_patterns := 4;
        go to end_ext_proc;
      end;

    if cics_writer_id != 555 and cics_writer_id != 888 and cics_writer_id != 99 and cics_writer_id != 42 and cics_writer_id != 16385 then
      begin
        verify_extended_clay_play_patterns := 5;
        go to end_ext_proc;
      end;

    contracted_variance := (spatial_dispersion_um * 875) / 1000;
    shadow_baseline := cics_writer_id * 1000000 + contracted_variance + momentum_retention_milli + 1470169088;

    if simulate_fault = 1 then
      begin
        verify_extended_clay_play_patterns := 0;
        go to end_ext_proc;
      end;

    verify_extended_clay_play_patterns := 0;

  end_ext_proc:
  end;

end
