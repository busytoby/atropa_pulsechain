begin
  comment HathiTrust Opera Omnia Volume 1 Chapter 8 Full-Text Engine;
  comment Caput VIII De quantitatibus transcendentibus ex circulo ortis;

  integer startPage, endPage, totalPages, sectionCnt, paragraphCnt, sound, latch;

  startPage := 225;
  endPage := 256;
  totalPages := (endPage - startPage) + 1;
  sectionCnt := 26;
  paragraphCnt := 44;

  if totalPages = 32 and sectionCnt = 26 and paragraphCnt = 44 then sound := 1
  else sound := 0;

  latch := 1470169088 + startPage * 256 + totalPages
end
