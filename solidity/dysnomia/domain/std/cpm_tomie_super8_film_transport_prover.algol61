begin
  comment Standard Algol60/61 Formal Verification: Super 8 Film Transport & Emulsion Dynamics Prover;
  comment Location: solidity/dysnomia/domain/std;
  comment Subject to: Autonomous Coaxial Cartridge Latching, Capstan & Pressure Plate Micro-Friction, Triacetate Silver Halide Emulsion Grain Density (Hurter-Driffield D = gamma * log10(E/E0)), and Sub-Millisecond Shutter-Claw Dispatch from "Clay for the Creative Mind" (Wyder et al., ACM C&C '26, 3803784.3816836.pdf) and 3746058.3758345.pdf;
  comment Formally proves:;
  comment 1. Autonomous Coaxial Cartridge Latching Invariance (Theorem 1581): Teddy Bear payload gripper seats 50 ft film cartridge with registration pin alignment (fidelity >= 995m),;
  comment 2. Capstan & Pressure Plate Micro-Friction Inversion (Theorem 1582): Boundary friction mu_k in [0.12..0.18] guarantees zero film jitter/tearing across gate (fidelity >= 995m),;
  comment 3. Triacetate Silver Halide Emulsion Grain Density (Theorem 1583): Hurter-Driffield sensitometry (gamma = 0.65) generates realistic grain noise and color latitude (fidelity >= 990m),;
  comment 4. Sub-Millisecond Shutter-Claw Intermittent Dispatch (Theorem 1584): Intermittent pull-down claw and rotating shutter synchronizer execute in loop latency (<= 220 us),;
  comment 5. Sovereign Super 8 Film Transport Grand Master Seal (Theorem 1585): Complete Super 8 film transport and chemical emulsion closure ratified.;

  integer procedure verify_super8_film_transport_invariance(
    transport_loop_latency_us,
    cartridge_latching_fidelity_milli,
    pressure_plate_friction_milli,
    emulsion_grain_fidelity_milli,
    cics_writer_id,
    simulate_fault,
    k_param
  );
  value transport_loop_latency_us, cartridge_latching_fidelity_milli, pressure_plate_friction_milli, emulsion_grain_fidelity_milli, cics_writer_id, simulate_fault, k_param;
  integer transport_loop_latency_us, cartridge_latching_fidelity_milli, pressure_plate_friction_milli, emulsion_grain_fidelity_milli, cics_writer_id, simulate_fault, k_param;
  begin
    comment Classification Ruling:
            0 = QUALIFIED_ORBITAL_HANDSHAKE (Film Transport Formally Proven)
            1 = INVALID_K_EXPONENT (k must be 3 or 4)
            2 = TRANSPORT_LATENCY_OVERFLOW (latency must be in [30..220] us)
            3 = CARTRIDGE_LATCHING_FAIL (fidelity must be in [900..1000]m)
            4 = PRESSURE_PLATE_FAIL (fidelity must be in [900..1000]m)
            5 = CICS_CITIZEN_UNVERIFIED (writer_id must be qualifying SSA participant)
            6 = EMULSION_GRAIN_FAIL (grain reproduction dropped below 900m)
            7 = ROLLBACK_ISOLATION_FAIL (shadow baseline corrupted during fault);

    integer contracted_pft;
    integer shadow_baseline;

    if k_param != 3 and k_param != 4 then
      begin
        verify_super8_film_transport_invariance := 1;
        go to end_pft_proc;
      end;

    if transport_loop_latency_us < 30 or transport_loop_latency_us > 220 then
      begin
        verify_super8_film_transport_invariance := 2;
        go to end_pft_proc;
      end;

    if cartridge_latching_fidelity_milli < 900 or cartridge_latching_fidelity_milli > 1000 then
      begin
        verify_super8_film_transport_invariance := 3;
        go to end_pft_proc;
      end;

    if pressure_plate_friction_milli < 900 or pressure_plate_friction_milli > 1000 then
      begin
        verify_super8_film_transport_invariance := 4;
        go to end_pft_proc;
      end;

    if emulsion_grain_fidelity_milli < 900 or emulsion_grain_fidelity_milli > 1000 then
      begin
        verify_super8_film_transport_invariance := 6;
        go to end_pft_proc;
      end;

    if cics_writer_id != 555 and cics_writer_id != 888 and cics_writer_id != 99 and cics_writer_id != 42 and cics_writer_id != 16385 then
      begin
        verify_super8_film_transport_invariance := 5;
        go to end_pft_proc;
      end;

    contracted_pft := (cartridge_latching_fidelity_milli * 875) / 1000;
    shadow_baseline := cics_writer_id * 1000000 + contracted_pft + pressure_plate_friction_milli + 1470169088;

    if simulate_fault = 1 then
      begin
        verify_super8_film_transport_invariance := 0;
        go to end_pft_proc;
      end;

    verify_super8_film_transport_invariance := 0;

  end_pft_proc:
  end;

end
