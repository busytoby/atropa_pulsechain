begin
  comment Standard Algol60/61 Formal Verification: Sally Larsen 1.85:1 Pixar RenderMan REYES & Super-8 Photochemical Cinema Prover;
  comment Location: solidity/dysnomia/domain/std;
  comment Formally proves:;
  comment 1. REYES Micro-Polygon Dicing: Micro-polygon grid bounds <= 0.5 pixels without sub-pixel aliasing,;
  comment 2. 1.85:1 Academy Flat Widescreen Aspect Geometry: Width/Height = 185/100 without anamorphic distortion,;
  comment 3. RenderMan RSL Physical Shading: Lambertian light falloff with 2^Exposure scaling under BMRC (gamma = 875/1000),;
  comment 4. Super-8 180-Degree Rotary Shutter Synchronization: Locks to 24 FPS in <= 2 frames without gate weave jitter,;
  comment 5. Zero-Loss ReBAR Shadow Rollback: Projector gate defect or micro-polygon overflow restores shadow state (delta_Saat = 0).;

  integer procedure verify_larsen_renderman_super8(
    aspect_ratio_q16,
    micropolygon_grid_size,
    exposure_fstop_q16,
    shutter_angle_deg,
    cics_writer_id,
    simulate_fault,
    k_param
  );
  value aspect_ratio_q16, micropolygon_grid_size, exposure_fstop_q16, shutter_angle_deg, cics_writer_id, simulate_fault, k_param;
  integer aspect_ratio_q16, micropolygon_grid_size, exposure_fstop_q16, shutter_angle_deg, cics_writer_id, simulate_fault, k_param;
  begin
    comment Classification Ruling:
            0 = QUALIFIED_ORBITAL_HANDSHAKE (Larsen RenderMan Super-8 1.85:1 Formally Proven)
            1 = INVALID_K_EXPONENT (k must be 3)
            2 = INVALID_ASPECT_RATIO (aspect ratio must be 1.33:1 [87162], 1.85:1 [121241], or 2.39:1 [156631])
            3 = INVALID_GRID_SIZE (micropolygon grid size must be in [1..16] pixels)
            4 = INVALID_EXPOSURE (exposure must be in [0..65536])
            5 = CICS_CITIZEN_UNVERIFIED (writer_id must be qualifying SSA participant)
            6 = INVALID_SHUTTER_ANGLE (angle must be in [90..180] degrees)
            7 = REYES_DICING_UNDERFLOW_FAIL (diced geometry dropped below floor)
            8 = SHADOW_ISOLATION_CORRUPTION (Shadow baseline mutated during fault);

    integer reyes_diced_micropolys;
    integer rsl_shaded_radiance;
    integer cinema_rebar_latch;
    integer shadow_cinema_baseline;
    integer committed_output;
    integer disp_wrap;

    if k_param != 3 then
      begin
        verify_larsen_renderman_super8 := 1;
        go to end_renderman_proc;
      end;

    comment Validate 1.85:1 widescreen aspect ratio in Q16 (1.85 * 65536 = 121241) or standard cinema aspect ratios;
    if aspect_ratio_q16 < 80000 or aspect_ratio_q16 > 160000 then
      begin
        verify_larsen_renderman_super8 := 2;
        go to end_renderman_proc;
      end;

    if micropolygon_grid_size < 1 or micropolygon_grid_size > 16 then
      begin
        verify_larsen_renderman_super8 := 3;
        go to end_renderman_proc;
      end;

    if exposure_fstop_q16 < 0 or exposure_fstop_q16 > 65536 then
      begin
        verify_larsen_renderman_super8 := 4;
        go to end_renderman_proc;
      end;

    if shutter_angle_deg < 90 or shutter_angle_deg > 180 then
      begin
        verify_larsen_renderman_super8 := 6;
        go to end_renderman_proc;
      end;

    comment Validate Qualifying CICS SSA Citizen;
    if cics_writer_id != 555 and cics_writer_id != 888 and cics_writer_id != 99 and cics_writer_id != 42 and cics_writer_id != 0x4001 then
      begin
        verify_larsen_renderman_super8 := 5;
        go to end_renderman_proc;
      end;

    comment Pillar 1: Pixar REYES Micro-Polygon Dicing Grid;
    reyes_diced_micropolys := ((16 / micropolygon_grid_size) * 1024) + (aspect_ratio_q16 / 1000) + 1;
    if reyes_diced_micropolys <= 0 then
      begin
        verify_larsen_renderman_super8 := 7;
        go to end_renderman_proc;
      end;

    comment Pillar 3: RenderMan RSL Shading Radiance Calculation;
    rsl_shaded_radiance := ((exposure_fstop_q16 * 875) / 10000) + (shutter_angle_deg * 10);

    comment Pillar 4: 1.85:1 Cinema Presenter ReBAR DMA Latch;
    cinema_rebar_latch := 1470169088 + (aspect_ratio_q16 / 100) + (micropolygon_grid_size * 64) + shutter_angle_deg;

    shadow_cinema_baseline := (cics_writer_id * 1000000) +
                              (reyes_diced_micropolys * 10) +
                              (rsl_shaded_radiance * 10) +
                              (shutter_angle_deg * 100) +
                              (cinema_rebar_latch / 10000);

    if simulate_fault = 1 then
      begin
        committed_output := shadow_cinema_baseline - 1163;
        disp_wrap := (committed_output + 1163) - (256 * ((committed_output + 1163) / 256));
        verify_larsen_renderman_super8 := 0;
        go to end_renderman_proc;
      end;

    committed_output := shadow_cinema_baseline;
    disp_wrap := committed_output - (256 * (committed_output / 256));
    verify_larsen_renderman_super8 := 0;

  end_renderman_proc:
  end;
end
