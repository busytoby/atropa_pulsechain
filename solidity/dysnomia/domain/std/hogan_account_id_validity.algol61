begin
  comment Standard Algol60/61 Domain Prover: Hogan Bank Account ID & Range Validity Prover;
  comment Location: solidity/dysnomia/domain/std;
  comment Verifies account ID namespaces: Individual/Teddy (100..999), Retail (1000..8999), Sovereign (9000..9999);

  integer procedure classify_hogan_account_validity(account_id);
  value account_id;
  integer account_id;
  begin
    comment Classification Taxonomy:
            0 = INVALID_ACCOUNT_ID (Zero or exceeds 32-bit ceiling)
            1 = QUALIFIED_INDIVIDUAL_PARTICIPANT (Range: 100 .. 999)
            2 = QUALIFIED_RETAIL_COMMERCIAL (Range: 1000 .. 8999)
            3 = QUALIFIED_SOVEREIGN_SECTOR (Range: 9000 .. 9999);

    if account_id < 100 or account_id > 999999 then
      classify_hogan_account_validity := 0
    else if account_id >= 100 and account_id <= 999 then
      classify_hogan_account_validity := 1
    else if account_id >= 1000 and account_id <= 8999 then
      classify_hogan_account_validity := 2
    else if account_id >= 9000 and account_id <= 9999 then
      classify_hogan_account_validity := 3
    else
      classify_hogan_account_validity := 2
  end;

  comment Domain Input Telemetry for Account ID 999;
  integer target_account_id;
  integer formal_account_ruling;

  target_account_id := 999;

  formal_account_ruling := classify_hogan_account_validity(target_account_id);

  comment Verification Assertion: 999 must resolve to Category 1 (Qualified Individual Participant);
  if formal_account_ruling = 1 then
    outstring(1, "RULING: VALID_HOGAN_ACCOUNT_ID (Category: QUALIFIED_INDIVIDUAL_PARTICIPANT)\n")
  else
    outstring(1, "RULING: INVALID_ACCOUNT_RANGE (Chancery Retained)\n")
end
