begin
  comment Euler Volume 1 Chapter 3 Section 2 Polynomial Expansion Engine;
  comment P(x)*Q(x) degree 2 convolution r[k] = sum p[i]*q[j];

  integer p0, p1, p2, q0, q1, q2, r0, r1, r2, r3, r4, sound, latch;

  p0 := 1; p1 := 2; p2 := 1;
  q0 := 1; q1 := 1; q2 := 0;

  r0 := p0 * q0;
  r1 := p0 * q1 + p1 * q0;
  r2 := p0 * q2 + p1 * q1 + p2 * q0;
  r3 := p1 * q2 + p2 * q1;
  r4 := p2 * q2;

  if r0 = 1 and r1 = 3 and r2 = 3 and r3 = 1 then sound := 1 else sound := 0;
  latch := 1470169088 + (r0 - (r0 // 256) * 256) * 256 + (r4 - (r4 // 256) * 256)
end
