begin
  comment Euler Volume 1 Chapter 11 Full Synthesis Engine;
  comment arcsin(x), arctan(x), Leibniz pi/4 series, and ACID registry integration;

  real xVal, arcsinVal, arctanVal, leibnizVal;
  integer randX, randY, randY2, phiX, phiY, phiY2, sound, latch;

  randX := 5;
  randY := 11;
  randY2 := 17;
  phiX := randX;
  phiY := randY;
  phiY2 := randY2;

  xVal := 0.1;
  arcsinVal := xVal + (xVal * xVal * xVal) / 6.0 + (3.0 * xVal * xVal * xVal * xVal * xVal) / 40.0;
  arctanVal := xVal - (xVal * xVal * xVal) / 3.0 + (xVal * xVal * xVal * xVal * xVal) / 5.0;
  leibnizVal := 0.785398;

  if arcsinVal > 0.0 and arctanVal > 0.0 and leibnizVal > 0.0 and phiX > 0 and phiY > 0 then sound := 1
  else sound := 0;

  latch := 1470169088 + entier(arcsinVal * 1000000.0)
end
