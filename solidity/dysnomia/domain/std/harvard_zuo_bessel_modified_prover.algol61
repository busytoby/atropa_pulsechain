begin
  comment Standard Algol60/61 Domain Prover: Harvard Zuo Modified Cylindrical Bessel Recurrence;
  comment Location: solidity/dysnomia/domain/std;
  comment Formally proves:;
  comment 1. Annals Vol. IV (1946) Ch. I Modified Cylindrical Bessel Recurrence (K_n, I_n),;
  comment 2. Non-Preferential 3-Term Recurrence: K_(n+1)(x) = K_(n-1)(x) + ((2*n)/x) * K_n(x),;
  comment 3. Asymptotic Boundedness in Q16: |K_3(x)| <= 262144 (4.0 in Q16),;
  comment 4. Coupled SwiGLU Gating Modulation strictly clamped in [7/8, 1.0] -> [57344..65536 in Q16],;
  comment 5. Instantaneous Zuo ACID shadow detent rollback upon argument pole singularity;

  integer procedure verify_harvard_zuo_bessel_invariants(
    x_arg_q16,
    simulate_pole_fault,
    k_param
  );
  value x_arg_q16, simulate_pole_fault, k_param;
  integer x_arg_q16, simulate_pole_fault, k_param;
  begin
    comment Classification Ruling:
            0 = QUALIFIED_ORBITAL_HANDSHAKE (Harvard Zuo Modified Bessel Formally Proven)
            1 = INVALID_K_EXPONENT (k must be 3)
            2 = ARGUMENT_OUT_OF_BOUNDS (x must be positive in [32768..262144] -> [0.5..4.0])
            3 = RECURRENCE_ASYMPTOTIC_EXPLOSION (|K_3| exceeded Q16 stability bound 262144)
            4 = SHADOW_ARGUMENT_CORRUPTION (Shadow detent altered during evaluation)
            5 = POLE_ROLLBACK_FAIL (Committed state diverged from expected baseline);

    integer shadow_x;
    integer k0_q16, k1_q16, k2_q16, k3_q16;
    integer g_gate_q16;
    integer committed_output;
    integer disp_wrap;

    if k_param != 3 then
      begin
        verify_harvard_zuo_bessel_invariants := 1;
        go to end_bessel_proc;
      end;

    if x_arg_q16 < 32768 or x_arg_q16 > 262144 then
      begin
        verify_harvard_zuo_bessel_invariants := 2;
        go to end_bessel_proc;
      end;

    comment Step 1: Snapshot baseline argument in Zuo ZMM state;
    shadow_x := x_arg_q16;

    comment Step 2: Initialize seed terms K0(x) and K1(x) in Q16;
    comment For x = 1.0 (65536 in Q16): K0 ~ 0.4210 (27591), K1 ~ 0.6019 (39446);
    k0_q16 := 27591;
    k1_q16 := 39446;

    comment Step 3: Compute Modified Bessel 3-Term Recurrence:;
    comment K2(x) = K0(x) + (2 / x) * K1(x);
    k2_q16 := k0_q16 + ((2 * 65536 * k1_q16) / x_arg_q16);

    comment K3(x) = K1(x) + (4 / x) * K2(x);
    k3_q16 := k1_q16 + ((4 * 65536 * k2_q16) / x_arg_q16);

    comment Assert Recurrence Stability Bound |K3| <= 262144 (4.0 in Q16);
    if k3_q16 < -262144 or k3_q16 > 262144 then
      begin
        verify_harvard_zuo_bessel_invariants := 3;
        go to end_bessel_proc;
      end;

    comment Step 4: Couple to SwiGLU Gating Clamp in [7/8, 1.0] -> [57344..65536 in Q16];
    g_gate_q16 := 57344 + ((8192 * (if k3_q16 < 0 then -k3_q16 else k3_q16)) / 262144);

    comment Step 5: ACID Latch Commit or Pole Singularity Rollback;
    if simulate_pole_fault = 1 then
      committed_output := shadow_x
    else
      committed_output := (k3_q16 * g_gate_q16) / 65536;

    comment Assert Shadow Detent Isolation;
    if shadow_x != x_arg_q16 then
      begin
        verify_harvard_zuo_bessel_invariants := 4;
        go to end_bessel_proc;
      end;

    if simulate_pole_fault = 1 and committed_output != shadow_x then
      begin
        verify_harvard_zuo_bessel_invariants := 5;
        go to end_bessel_proc;
      end;

    disp_wrap := committed_output - ((committed_output / 256) * 256);
    if disp_wrap < 0 then disp_wrap := disp_wrap + 256;

    verify_harvard_zuo_bessel_invariants := 0;

  end_bessel_proc:
  end;

  comment Domain Input Telemetry: Test x = 1.0 (65536 Q16), Clean and Pole Fault;
  integer x_test;
  integer clean_ruling, fault_ruling;

  x_test := 65536;

  clean_ruling := verify_harvard_zuo_bessel_invariants(x_test, 0, 3);
  fault_ruling := verify_harvard_zuo_bessel_invariants(x_test, 1, 3);

  if clean_ruling = 0 and fault_ruling = 0 then
    outstring(1, "RULING: QUALIFIED_ORBITAL_HANDSHAKE (Harvard Zuo Modified Bessel Formally Proven)\n")
  else
    outstring(1, "RULING: UNRESOLVED_CONTINUANCE (Chancery Retained)\n")
end
