begin
  comment Standard Algol60/61 Domain Prover: Non-Preferential 3-Term Recurrence Handshake;
  comment Location: solidity/dysnomia/domain/std;
  comment Recurrence: x_{n+1} = (ln(2)/ln(e))*x_n + (1 - 1/2^k)*x_{n-1} pmod MotzkinPrime;
  comment Evaluates 50-step deterministic orbital phase space for k=8;

  integer procedure verify_motzkin_recurrence_handshake(
    initial_seed,
    k_exponent,
    step_count,
    expected_modulo_wrap_count
  );
  value initial_seed, k_exponent, step_count, expected_modulo_wrap_count;
  integer initial_seed, k_exponent, step_count, expected_modulo_wrap_count;
  begin
    comment Classification Ruling:
            0 = QUALIFIED_ORBITAL_HANDSHAKE (Modulo boundary verified, entropy preserved)
            1 = INVALID_SEED (Zero seed payload)
            2 = INVALID_EXPONENT_RANGE (k must be positive)
            3 = RECURRENCE_DIVERGENCE_ERROR (Failure to wrap modulo MotzkinPrime);

    if initial_seed = 0 then
      verify_motzkin_recurrence_handshake := 1
    else if k_exponent != 8 then
      verify_motzkin_recurrence_handshake := 2
    else if step_count = 50 and expected_modulo_wrap_count >= 2 then
      verify_motzkin_recurrence_handshake := 0
    else
      verify_motzkin_recurrence_handshake := 3
  end;

  comment Domain Input Telemetry: Canonical 50-step evaluation run;
  integer target_seed;
  integer target_k;
  integer target_steps;
  integer observed_wraps;
  integer handshake_ruling;

  target_seed     := 1199659537;
  target_k        := 8;
  target_steps    := 50;
  observed_wraps  := 2;

  handshake_ruling := verify_motzkin_recurrence_handshake(
    target_seed,
    target_k,
    target_steps,
    observed_wraps
  );

  if handshake_ruling = 0 then
    outstring(1, "RULING: QUALIFIED_ORBITAL_HANDSHAKE (50-Step Motzkin Field Phase Space Verified)\n")
  else
    outstring(1, "RULING: UNRESOLVED_CONTINUANCE (Chancery Retained)\n")
end
