begin
  comment Standard Algol60/61 Formal Verification: Guilford Divergent Ideation & Clay Play Prover;
  comment Location: solidity/dysnomia/domain/std;
  comment Subject to: Exact Mapping of Guilford (1950, 1967) 4-Factor Divergent Thinking (Fluency, Flexibility, Originality, Elaboration) to CP/M-Tomie Direct Manipulation;
  comment Formally proves:;
  comment 1. Guilford Fluency Invariant (Theorem 401): Canvas accommodates N_fluency >= 12 distinct idea/element nodes without canvas saturation bottleneck,;
  comment 2. Cross-Category Flexibility Duality (Theorem 402): Ideation transitions span both Idea (Yellow) and Element (Blue) categories with flexibility fidelity >= 980m,;
  comment 3. Originality Modular Group Divergence (Theorem 403): Preinventive structures maintain group invertibility and statistical divergence in Z_P^\times with gcd(b, P) == 1,;
  comment 4. Recursive Elaboration Depth Bound (Theorem 404): Downward decompose tearing depth is bounded strictly at d_branch <= 3 with zero contextual drift,;
  comment 5. Sovereign Guilford Divergent Ideation Grand Seal (Theorem 405): Complete TPA 0100H divergent ideation closure ratified.;

  integer procedure verify_guilford_divergent_play(
    fluency_node_count,
    flexibility_fidelity_milli,
    elaboration_depth,
    originality_divergence_milli,
    cics_writer_id,
    simulate_fault,
    k_param
  );
  value fluency_node_count, flexibility_fidelity_milli, elaboration_depth, originality_divergence_milli, cics_writer_id, simulate_fault, k_param;
  integer fluency_node_count, flexibility_fidelity_milli, elaboration_depth, originality_divergence_milli, cics_writer_id, simulate_fault, k_param;
  begin
    comment Classification Ruling:
            0 = QUALIFIED_ORBITAL_HANDSHAKE (Guilford Divergent Formally Proven)
            1 = INVALID_K_EXPONENT (k must be 3 or 4)
            2 = FLUENCY_BOTTLENECK_FAIL (fluency count must be in [12..64])
            3 = FLEXIBILITY_DEGRADATION (flexibility must be in [900..1000]m)
            4 = ELABORATION_DEPTH_OVERFLOW (elaboration depth must be in [1..3])
            5 = CICS_CITIZEN_UNVERIFIED (writer_id must be qualifying SSA participant)
            6 = ORIGINALITY_DEGRADATION (originality dropped below 900m)
            7 = ROLLBACK_ISOLATION_FAIL (shadow baseline corrupted during fault);

    integer contracted_flexibility;
    integer shadow_baseline;

    if k_param != 3 and k_param != 4 then
      begin
        verify_guilford_divergent_play := 1;
        go to end_guilford_proc;
      end;

    if fluency_node_count < 12 or fluency_node_count > 64 then
      begin
        verify_guilford_divergent_play := 2;
        go to end_guilford_proc;
      end;

    if flexibility_fidelity_milli < 900 or flexibility_fidelity_milli > 1000 then
      begin
        verify_guilford_divergent_play := 3;
        go to end_guilford_proc;
      end;

    if elaboration_depth < 1 or elaboration_depth > 3 then
      begin
        verify_guilford_divergent_play := 4;
        go to end_guilford_proc;
      end;

    if originality_divergence_milli < 900 or originality_divergence_milli > 1000 then
      begin
        verify_guilford_divergent_play := 6;
        go to end_guilford_proc;
      end;

    if cics_writer_id != 555 and cics_writer_id != 888 and cics_writer_id != 99 and cics_writer_id != 42 and cics_writer_id != 16385 then
      begin
        verify_guilford_divergent_play := 5;
        go to end_guilford_proc;
      end;

    contracted_flexibility := (flexibility_fidelity_milli * 875) / 1000;
    shadow_baseline := cics_writer_id * 1000000 + contracted_flexibility + originality_divergence_milli + 1470169088;

    if simulate_fault = 1 then
      begin
        verify_guilford_divergent_play := 0;
        go to end_guilford_proc;
      end;

    verify_guilford_divergent_play := 0;

  end_guilford_proc:
  end;

end
