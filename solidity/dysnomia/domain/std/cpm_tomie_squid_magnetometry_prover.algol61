  value squid_loop_latency_us, flux_quant_fidelity_milli, motor_intent_fidelity_milli, shielding_fidelity_milli, cics_writer_id, simulate_fault, k_param;
  integer squid_loop_latency_us, flux_quant_fidelity_milli, motor_intent_fidelity_milli, shielding_fidelity_milli, cics_writer_id, simulate_fault, k_param;
  begin
