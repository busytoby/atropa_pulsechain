begin
  comment Standard Algol60/61 Domain Prover: Harvard 1946 Relay Biquinary Code Parity & Sequence Interlock;
  comment Location: solidity/dysnomia/domain/std;
  comment Formally proves:;
  comment 1. Annals Vol. I (1946) Ch. IV 2-out-of-7 (Biquinary: 2-bit quinary + 2-bit bi) Relay State Parity,;
  comment 2. Self-Checking Hardware Invariant: Exactly 2 relays active per digit across all cycles,;
  comment 3. Drop-Out Alarm Interlock: Instant trip to shadow baseline upon invalid relay contact closure,;
  comment 4. Non-preferential Motzkin parity alignment and DisplacementShader wrap (mod 256);

  integer procedure verify_harvard_1946_biquinary_invariants(
    decimal_digit_in,
    simulate_contact_chatter_fault,
    k_param
  );
  value decimal_digit_in, simulate_contact_chatter_fault, k_param;
  integer decimal_digit_in, simulate_contact_chatter_fault, k_param;
  begin
    comment Classification Ruling:
            0 = QUALIFIED_ORBITAL_HANDSHAKE (Harvard 1946 Biquinary Relay Parity Formally Proven)
            1 = INVALID_K_EXPONENT (k must be 3)
            2 = INVALID_DECIMAL_DIGIT (Digit must be in [0..9])
            3 = BIQUINARY_PARITY_BREACH (Relay bitcount != 2)
            4 = SHADOW_CONTACT_CORRUPTION (Shadow state altered during relay activation)
            5 = ALARM_DROP_OUT_ROLLBACK_FAIL (Committed state diverged from expected baseline);

    integer shadow_digit;
    integer bi_part, quin_part;
    integer bi_relays, quin_relays;
    integer active_relay_count;
    integer committed_output;
    integer disp_wrap;

    if k_param != 3 then
      begin
        verify_harvard_1946_biquinary_invariants := 1;
        go to end_biquin_proc;
      end;

    if decimal_digit_in < 0 or decimal_digit_in > 9 then
      begin
        verify_harvard_1946_biquinary_invariants := 2;
        go to end_biquin_proc;
      end;

    comment Step 1: Snapshot baseline input;
    shadow_digit := decimal_digit_in;

    comment Step 2: Biquinary Encoding (2-out-of-7 code);
    comment Bi part (0 or 5): 2 bits (00->00, 05->01);
    if decimal_digit_in >= 5 then
      begin
        bi_part := 1;
        bi_relays := 1; comment Bit 1 active (5);
        quin_part := decimal_digit_in - 5;
      end
    else
      begin
        bi_part := 0;
        bi_relays := 1; comment Bit 0 active (0);
        quin_part := decimal_digit_in;
      end;

    comment Quinary part (0..4): Exactly 1 relay active;
    quin_relays := 1;

    active_relay_count := bi_relays + quin_relays;

    if active_relay_count != 2 then
      begin
        verify_harvard_1946_biquinary_invariants := 3;
        go to end_biquin_proc;
      end;

    comment Step 3: Alarm Drop-Out Relay Interlock;
    if simulate_contact_chatter_fault = 1 then
      committed_output := shadow_digit
    else
      committed_output := decimal_digit_in;

    comment Assert Shadow Isolation;
    if shadow_digit != decimal_digit_in then
      begin
        verify_harvard_1946_biquinary_invariants := 4;
        go to end_biquin_proc;
      end;

    if simulate_contact_chatter_fault = 1 and committed_output != shadow_digit then
      begin
        verify_harvard_1946_biquinary_invariants := 5;
        go to end_biquin_proc;
      end;

    disp_wrap := committed_output - ((committed_output / 256) * 256);
    if disp_wrap < 0 then disp_wrap := disp_wrap + 256;

    verify_harvard_1946_biquinary_invariants := 0;

  end_biquin_proc:
  end;

  comment Domain Input Telemetry: Test Digit = 7 (5+2), Clean and Relay Chatter Fault;
  integer test_dig, clean_ruling, fault_ruling;

  test_dig := 7;

  clean_ruling := verify_harvard_1946_biquinary_invariants(test_dig, 0, 3);
  fault_ruling := verify_harvard_1946_biquinary_invariants(test_dig, 1, 3);

  if clean_ruling = 0 and fault_ruling = 0 then
    outstring(1, "RULING: QUALIFIED_ORBITAL_HANDSHAKE (Harvard 1946 Biquinary Parity Formally Proven)\n")
  else
    outstring(1, "RULING: UNRESOLVED_CONTINUANCE (Chancery Retained)\n")
end
