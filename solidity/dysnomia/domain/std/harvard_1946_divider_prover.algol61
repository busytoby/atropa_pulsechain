begin
  comment Standard Algol60/61 Domain Prover: Harvard 1946 Double-Precision Subtractive Division Engine;
  comment Location: solidity/dysnomia/domain/std;
  comment Formally proves:;
  comment 1. Annals Vol. I (1946) Ch. II Non-Restoring Subtractive Division Residue Conservation: A = Q * B + R,;
  comment 2. Remainder Strict Boundedness Invariant: 0 <= R < B,;
  comment 3. Division-by-Zero Mechanical Clutch Drop-Out Alarm & Rollback to Shadow Detent (1,000,000 Saat),;
  comment 4. Non-preferential Motzkin parity alignment and DisplacementShader wrap (mod 256);

  integer procedure verify_harvard_1946_divider_invariants(
    dividend_a,
    divisor_b,
    simulate_zero_div_fault,
    k_param
  );
  value dividend_a, divisor_b, simulate_zero_div_fault, k_param;
  integer dividend_a, divisor_b, simulate_zero_div_fault, k_param;
  begin
    comment Classification Ruling:
            0 = QUALIFIED_ORBITAL_HANDSHAKE (Harvard 1946 Subtractive Divider Formally Proven)
            1 = INVALID_K_EXPONENT (k must be 3)
            2 = NEGATIVE_INPUT_PROHIBITED (Inputs must be non-negative)
            3 = DIVISION_RESIDUE_CONSERVATION_BREACH (A != Q * B + R)
            4 = REMAINDER_BOUND_VIOLATION (R >= B or R < 0)
            5 = SHADOW_DIVIDEND_CORRUPTION (Shadow detent altered during division)
            6 = CLUTCH_DROP_OUT_ROLLBACK_FAIL (Committed state diverged from expected baseline);

    integer shadow_dividend;
    integer quotient_q, remainder_r;
    integer committed_output;
    integer disp_wrap;

    if k_param != 3 then
      begin
        verify_harvard_1946_divider_invariants := 1;
        go to end_divider_proc;
      end;

    if dividend_a < 0 or divisor_b < 0 then
      begin
        verify_harvard_1946_divider_invariants := 2;
        go to end_divider_proc;
      end;

    comment Step 1: Snapshot baseline dividend detent;
    shadow_dividend := dividend_a;

    comment Step 2: Division Execution or Fault Latch;
    if simulate_zero_div_fault = 1 or divisor_b = 0 then
      begin
        quotient_q := 0;
        remainder_r := 0;
        committed_output := shadow_dividend; comment Clutch drops out, restoring baseline shadow;
      end
    else
      begin
        quotient_q := dividend_a / divisor_b;
        remainder_r := dividend_a - (quotient_q * divisor_b);

        comment Assert Residue Conservation: A = Q * B + R;
        if (quotient_q * divisor_b + remainder_r) != dividend_a then
          begin
            verify_harvard_1946_divider_invariants := 3;
            go to end_divider_proc;
          end;

        comment Assert Remainder Boundedness: 0 <= R < B;
        if remainder_r < 0 or remainder_r >= divisor_b then
          begin
            verify_harvard_1946_divider_invariants := 4;
            go to end_divider_proc;
          end;

        committed_output := quotient_q;
      end;

    comment Step 3: Assert Shadow Detent Isolation;
    if shadow_dividend != dividend_a then
      begin
        verify_harvard_1946_divider_invariants := 5;
        go to end_divider_proc;
      end;

    if (simulate_zero_div_fault = 1 or divisor_b = 0) and committed_output != shadow_dividend then
      begin
        verify_harvard_1946_divider_invariants := 6;
        go to end_divider_proc;
      end;

    disp_wrap := committed_output - ((committed_output / 256) * 256);
    if disp_wrap < 0 then disp_wrap := disp_wrap + 256;

    verify_harvard_1946_divider_invariants := 0;

  end_divider_proc:
  end;

  comment Domain Input Telemetry: Test Dividend = 1000000 Saat, Divisor = 875, Clean and Zero-Div Fault;
  integer a_test, b_test;
  integer clean_ruling, fault_ruling;

  a_test := 1000000;
  b_test := 875;

  clean_ruling := verify_harvard_1946_divider_invariants(a_test, b_test, 0, 3);
  fault_ruling := verify_harvard_1946_divider_invariants(a_test, 0, 1, 3);

  if clean_ruling = 0 and fault_ruling = 0 then
    outstring(1, "RULING: QUALIFIED_ORBITAL_HANDSHAKE (Harvard 1946 Subtractive Divider Formally Proven)\n")
  else
    outstring(1, "RULING: UNRESOLVED_CONTINUANCE (Chancery Retained)\n")
end
