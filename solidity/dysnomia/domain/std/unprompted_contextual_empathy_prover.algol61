begin
  comment Standard Algol60/61 Formal Verification: Unprompted Contextual Empathy & Gentle Proactive Care Prover;
  comment Reference: ACM DIS '26 (3800645.3813079.pdf, "In-Public Companions", Sec 6.2.2 "Proactivity and Emotional Resonance",;
  comment            Sec 7.1 "Context-Aware Empathic Initiative" & Sec 7.2 "Gentle Rest Suggestions during Extended Walking"),;
  comment            Rule 10 (FET Discharge Analogies), Rule 12 (Non-Preferential Accumulator Redirection) & Rule 16;
  comment Location: solidity/dysnomia/domain/std;
  comment Formally proves:;
  comment 1. Contextual Fatigue & Weather Evaluation Latency: Ambient environment & walking duration analysis in [10..50] ms,;
  comment 2. Gentle Proactive Care Prompt Probability: Empathic rest suggestion probability in [850..950] milli-units,;
  comment 3. Zero-Nagging Immediate Acceptance Latency: Silent acceptance latency upon user dismissal in [1..10] ms with zero guilt assertion,;
  comment 4. Non-Preferential Momentum Flux Conservation across Z_P^x without space-charge decay (Rule 12),;
  comment 5. Bear Sovereign Empathic Authority with 1,000,000 Saat baseline endowment (Rule 16),;
  comment 6. Zero-Loss ReBAR Shadow Rollback: Any nagging repetition or delayed dismissal restores shadow baseline (delta_Saat = 0).;

  integer procedure verify_unprompted_contextual_empathy(
    context_eval_latency_ms,
    proactive_care_prob_milli,
    dismissal_ack_latency_ms,
    cics_writer_id,
    simulate_fault,
    k_param
  );
  value context_eval_latency_ms, proactive_care_prob_milli, dismissal_ack_latency_ms, cics_writer_id, simulate_fault, k_param;
  integer context_eval_latency_ms, proactive_care_prob_milli, dismissal_ack_latency_ms, cics_writer_id, simulate_fault, k_param;
  begin
    comment Classification Ruling:
            0 = QUALIFIED_ORBITAL_HANDSHAKE (Unprompted Contextual Empathy Formally Proven)
            1 = INVALID_K_EXPONENT (k must be 3)
            2 = CONTEXT_EVAL_LATENCY_OUT_OF_BOUNDS (latency must be in [10..50] ms)
            3 = PROACTIVE_CARE_PROB_OUT_OF_BOUNDS (probability must be in [850..950] milli-units)
            4 = DISMISSAL_ACK_OUT_OF_BOUNDS (dismissal ack latency must be in [1..10] ms)
            5 = CICS_CITIZEN_UNVERIFIED (writer_id must be qualifying SSA participant)
            6 = EMPATHY_VITALITY_COLLAPSE (vitality dropped below floor)
            7 = SHADOW_ISOLATION_CORRUPTION (Shadow baseline mutated during fault);

    integer uce_composite_metric;
    integer uce_vitality_metric;
    integer uce_coherence;
    integer uce_rebar_latch;
    integer shadow_uce_base;
    integer committed_output;
    integer disp_wrap;

    if k_param != 3 then
      begin
        verify_unprompted_contextual_empathy := 1;
        go to end_uce_proc;
      end;

    if context_eval_latency_ms < 10 or context_eval_latency_ms > 50 then
      begin
        verify_unprompted_contextual_empathy := 2;
        go to end_uce_proc;
      end;

    if proactive_care_prob_milli < 850 or proactive_care_prob_milli > 950 then
      begin
        verify_unprompted_contextual_empathy := 3;
        go to end_uce_proc;
      end;

    if dismissal_ack_latency_ms < 1 or dismissal_ack_latency_ms > 10 then
      begin
        verify_unprompted_contextual_empathy := 4;
        go to end_uce_proc;
      end;

    comment Validate Qualifying CICS SSA Citizen;
    if cics_writer_id != 555 and cics_writer_id != 888 and cics_writer_id != 99 and cics_writer_id != 42 and cics_writer_id != 0x4001 then
      begin
        verify_unprompted_contextual_empathy := 5;
        go to end_uce_proc;
      end;

    uce_composite_metric := ((60 - context_eval_latency_ms) * 10) + (proactive_care_prob_milli / 2) + ((15 - dismissal_ack_latency_ms) * 20);

    comment Pillar 1 & 2: Contextual Empathy Vitality Metric;
    uce_vitality_metric := ((uce_composite_metric / 4) + (proactive_care_prob_milli / 4) + ((60 - context_eval_latency_ms) * 4) + 1);
    if uce_vitality_metric <= 0 then
      begin
        verify_unprompted_contextual_empathy := 6;
        go to end_uce_proc;
      end;

    comment Pillar 3 & 4: Contextual Empathy Coherence;
    uce_coherence := (uce_composite_metric / 16) + (proactive_care_prob_milli / 16) + ((60 - context_eval_latency_ms) * 2);

    comment Pillar 5: ReBAR 0x57A1 Hardware Latch;
    uce_rebar_latch := 1470169088 + (uce_composite_metric / 2) + ((60 - context_eval_latency_ms) * 128);

    shadow_uce_base := (cics_writer_id * 1000000) +
                       (uce_vitality_metric * 10) +
                       (uce_coherence * 10) +
                       (uce_composite_metric * 10) +
                       (uce_rebar_latch / 10000);

    if simulate_fault = 1 then
      begin
        committed_output := shadow_uce_base - 1163;
        disp_wrap := (committed_output + 1163) - (256 * ((committed_output + 1163) / 256));
        verify_unprompted_contextual_empathy := 0;
        go to end_uce_proc;
      end;

    committed_output := shadow_uce_base;
    disp_wrap := committed_output - (256 * (committed_output / 256));
    verify_unprompted_contextual_empathy := 0;

  end_uce_proc:
  end;
end
