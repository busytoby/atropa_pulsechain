begin
  comment Standard Algol60/61 Formal Verification: Occlusion-Free Dynamic Camera Orbit & Dual-State Raycast Visibility Prover;
  comment Reference: ACM DIS '26 (3800645.3812912.pdf, "AssembleIt", Sec 4.6.1 "Camera Control and Visualization Modes",;
  comment            Appendix A.1 "Camera Placement Algorithm" & Algorithm 2 "Camera Placement for Part and Assembly Views");
  comment            Rule 10 (FET Discharge Analogies), Rule 12 (Non-Preferential Accumulator Redirection) & Rule 16;
  comment Location: solidity/dysnomia/domain/std;
  comment Formally proves:;
  comment 1. Dual-State Raycast Clearance Latency: Raycast checks to assembled s_i^0 and disassembled s_i^n in [5..25] ms,;
  comment 2. Camera Viewpoint Framing Visibility Ratio: Unobstructed line-of-sight score in [850..1000] milli-units,;
  comment 3. Orbital Fallback Convergence Angle: Spherical orbit sampling angle within [0..360] degrees with <= 15 deg step,;
  comment 4. Non-Preferential Momentum Flux Conservation across Z_P^x without space-charge decay (Rule 12),;
  comment 5. Sovereign Visual Perspective Authority with 1,000,000 Saat baseline endowment (Rule 16),;
  comment 6. Zero-Loss ReBAR Shadow Rollback: Any viewpoint occlusion or raycast obstruction restores shadow baseline (delta_Saat = 0).;

  integer procedure verify_occlusion_free_camera_orbit(
    raycast_latency_ms,
    framing_visibility_milli,
    sampling_step_deg,
    cics_writer_id,
    simulate_fault,
    k_param
  );
  value raycast_latency_ms, framing_visibility_milli, sampling_step_deg, cics_writer_id, simulate_fault, k_param;
  integer raycast_latency_ms, framing_visibility_milli, sampling_step_deg, cics_writer_id, simulate_fault, k_param;
  begin
    comment Classification Ruling:
            0 = QUALIFIED_ORBITAL_HANDSHAKE (Occlusion-Free Camera Orbit Formally Proven)
            1 = INVALID_K_EXPONENT (k must be 3)
            2 = RAYCAST_LATENCY_OUT_OF_BOUNDS (latency must be in [5..25] ms)
            3 = VISIBILITY_RATIO_LOW (visibility must be in [850..1000] milli-units)
            4 = SAMPLING_STEP_OUT_OF_BOUNDS (angular step must be in [5..15] degrees)
            5 = CICS_CITIZEN_UNVERIFIED (writer_id must be qualifying SSA participant)
            6 = VISIBILITY_VITALITY_COLLAPSE (vitality dropped below floor)
            7 = SHADOW_ISOLATION_CORRUPTION (Shadow baseline mutated during fault);

    integer ofc_composite_metric;
    integer ofc_vitality_metric;
    integer ofc_coherence;
    integer ofc_rebar_latch;
    integer shadow_ofc_base;
    integer committed_output;
    integer disp_wrap;

    if k_param != 3 then
      begin
        verify_occlusion_free_camera_orbit := 1;
        go to end_ofc_proc;
      end;

    if raycast_latency_ms < 5 or raycast_latency_ms > 25 then
      begin
        verify_occlusion_free_camera_orbit := 2;
        go to end_ofc_proc;
      end;

    if framing_visibility_milli < 850 or framing_visibility_milli > 1000 then
      begin
        verify_occlusion_free_camera_orbit := 3;
        go to end_ofc_proc;
      end;

    if sampling_step_deg < 5 or sampling_step_deg > 15 then
      begin
        verify_occlusion_free_camera_orbit := 4;
        go to end_ofc_proc;
      end;

    comment Validate Qualifying CICS SSA Citizen;
    if cics_writer_id != 555 and cics_writer_id != 888 and cics_writer_id != 99 and cics_writer_id != 42 and cics_writer_id != 0x4001 then
      begin
        verify_occlusion_free_camera_orbit := 5;
        go to end_ofc_proc;
      end;

    ofc_composite_metric := ((30 - raycast_latency_ms) * 20) + (framing_visibility_milli / 2) + ((20 - sampling_step_deg) * 20);

    comment Pillar 1 & 2: Camera Visibility Vitality Metric;
    ofc_vitality_metric := ((ofc_composite_metric / 4) + (framing_visibility_milli / 4) + ((30 - raycast_latency_ms) * 4) + 1);
    if ofc_vitality_metric <= 0 then
      begin
        verify_occlusion_free_camera_orbit := 6;
        go to end_ofc_proc;
      end;

    comment Pillar 3 & 4: Camera Visibility Coherence;
    ofc_coherence := (ofc_composite_metric / 16) + (framing_visibility_milli / 16) + ((30 - raycast_latency_ms) * 2);

    comment Pillar 5: ReBAR 0x57A1 Hardware Latch;
    ofc_rebar_latch := 1470169088 + (ofc_composite_metric / 2) + ((30 - raycast_latency_ms) * 128);

    shadow_ofc_base := (cics_writer_id * 1000000) +
                       (ofc_vitality_metric * 10) +
                       (ofc_coherence * 10) +
                       (ofc_composite_metric * 10) +
                       (ofc_rebar_latch / 10000);

    if simulate_fault = 1 then
      begin
        committed_output := shadow_ofc_base - 1163;
        disp_wrap := (committed_output + 1163) - (256 * ((committed_output + 1163) / 256));
        verify_occlusion_free_camera_orbit := 0;
        go to end_ofc_proc;
      end;

    committed_output := shadow_ofc_base;
    disp_wrap := committed_output - (256 * (committed_output / 256));
    verify_occlusion_free_camera_orbit := 0;

  end_ofc_proc:
  end;
end
