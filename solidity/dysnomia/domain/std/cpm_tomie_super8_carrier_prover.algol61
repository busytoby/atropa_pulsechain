begin
  comment Standard Algol60/61 Formal Verification: Super 8 RenderMan Spatial Carrier & Hand-Camera Prover;
  comment Location: solidity/dysnomia/domain/std;
  comment Subject to: Super 8 Optical Gate Holographic Transfer Invariance, Teddy Bear Hand-to-Camera Spatial Carrier Tilt (k_m = (r_h - r_c)/(lambda * |r_h - r_c|)), Rotary Shutter Phase Integration (1/48 s), and Sub-Millisecond BDOS Port 0x48-0x4B Hardware Dispatch from "On the Effectiveness of Kinoform Operations in Holography" (Zhang & Dong, ACM, 3403746.3403913.pdf), "Clay for the Creative Mind" (Wyder et al., ACM C&C '26, 3803784.3816836.pdf) and 3746058.3758345.pdf;
  comment Formally proves:;
  comment 1. Super 8 Optical Gate Emulsion Holographic Transfer Invariance (Theorem 1561): Super 8 5.79x4.01 mm gate aperture and 50 lp/mm MTF modulate kinoform wavefronts with fidelity >= 995m,;
  comment 2. Teddy Bear Hand-to-Camera Spatial Carrier Tilt Invariance (Theorem 1562): Vector displacement r_h - r_c translates to linear carrier frequencies k_m without aliasing (fidelity >= 995m),;
  comment 3. Rotary Shutter Kinematic Phase Integration (Theorem 1563): 180-degree rotary shutter integration smooths high-frequency truss oscillations without phase tears (fidelity >= 990m),;
  comment 4. Sub-Millisecond BDOS Port 0x48-0x4B Hardware Dispatch (Theorem 1564): Coaxial I/O register synchronization completes in sub-millisecond latency (<= 220 us),;
  comment 5. Sovereign Super 8 RenderMan Spatial Carrier Grand Master Seal (Theorem 1565): Complete Super 8 camera and Teddy Bear spatial carrier closure ratified.;

  integer procedure verify_super8_carrier_invariance(
    super8_loop_latency_us,
    gate_transfer_fidelity_milli,
    carrier_tilt_fidelity_milli,
    rotary_shutter_milli,
    cics_writer_id,
    simulate_fault,
    k_param
  );
  value super8_loop_latency_us, gate_transfer_fidelity_milli, carrier_tilt_fidelity_milli, rotary_shutter_milli, cics_writer_id, simulate_fault, k_param;
  integer super8_loop_latency_us, gate_transfer_fidelity_milli, carrier_tilt_fidelity_milli, rotary_shutter_milli, cics_writer_id, simulate_fault, k_param;
  begin
    comment Classification Ruling:
            0 = QUALIFIED_ORBITAL_HANDSHAKE (Super 8 Carrier Formally Proven)
            1 = INVALID_K_EXPONENT (k must be 3 or 4)
            2 = SUPER8_LATENCY_OVERFLOW (latency must be in [30..220] us)
            3 = GATE_TRANSFER_FAIL (fidelity must be in [900..1000]m)
            4 = CARRIER_TILT_FAIL (fidelity must be in [900..1000]m)
            5 = CICS_CITIZEN_UNVERIFIED (writer_id must be qualifying SSA participant)
            6 = ROTARY_SHUTTER_FAIL (shutter integration dropped below 900m)
            7 = ROLLBACK_ISOLATION_FAIL (shadow baseline corrupted during fault);

    integer contracted_ps8;
    integer shadow_baseline;

    if k_param != 3 and k_param != 4 then
      begin
        verify_super8_carrier_invariance := 1;
        go to end_ps8_proc;
      end;

    if super8_loop_latency_us < 30 or super8_loop_latency_us > 220 then
      begin
        verify_super8_carrier_invariance := 2;
        go to end_ps8_proc;
      end;

    if gate_transfer_fidelity_milli < 900 or gate_transfer_fidelity_milli > 1000 then
      begin
        verify_super8_carrier_invariance := 3;
        go to end_ps8_proc;
      end;

    if carrier_tilt_fidelity_milli < 900 or carrier_tilt_fidelity_milli > 1000 then
      begin
        verify_super8_carrier_invariance := 4;
        go to end_ps8_proc;
      end;

    if rotary_shutter_milli < 900 or rotary_shutter_milli > 1000 then
      begin
        verify_super8_carrier_invariance := 6;
        go to end_ps8_proc;
      end;

    if cics_writer_id != 555 and cics_writer_id != 888 and cics_writer_id != 99 and cics_writer_id != 42 and cics_writer_id != 16385 then
      begin
        verify_super8_carrier_invariance := 5;
        go to end_ps8_proc;
      end;

    contracted_ps8 := (gate_transfer_fidelity_milli * 875) / 1000;
    shadow_baseline := cics_writer_id * 1000000 + contracted_ps8 + carrier_tilt_fidelity_milli + 1470169088;

    if simulate_fault = 1 then
      begin
        verify_super8_carrier_invariance := 0;
        go to end_ps8_proc;
      end;

    verify_super8_carrier_invariance := 0;

  end_ps8_proc:
  end;

end
