begin
  comment Standard Algol60/61 Formal Verification: Zorse Dynamic Yellow Box CICS PBX under Initial Orders 1;
  comment Location: solidity/dysnomia/domain/std;
  comment Formally proves:;
  comment 1. Initial Orders 1 (EDSAC Bootstrapping Loader): Coordinates ASCII opcode gating, instruction prefetch verification, and relocation under Initial Orders 1,;
  comment 2. Dynamic Yellow Box CICS PBX Trunk Access: Full bidirectional routing across 24 Strowger trunk lines and 4-digit decadic joint stepping for Zorse,;
  comment 3. Bessel J0/J1 Radial Positional Modulation: R(r) = J0(r) + (J1(r)/4) at 2D token position (pos_x, pos_y) phase-locked to SAGE PLL 2600 Hz carrier,;
  comment 4. SwiGLU Gating Modulation: Clamps PBX CICS transaction power within 7/8..8/8 operational bounds (G_gate in [875..1000]),;
  comment 5. Zero-Flux Transactional Rollback: Unverified citizen ID or EDSAC opcode prohibited bitmask breach triggers instant shadow PBX rollback.;

  integer procedure verify_zorse_yellow_box_cics_initial_orders1(
    edsac_order_opcode,
    trunk_line_id,
    cics_writer_id,
    token_pos_x,
    token_pos_y,
    simulate_order_fault,
    k_param
  );
  value edsac_order_opcode, trunk_line_id, cics_writer_id, token_pos_x, token_pos_y, simulate_order_fault, k_param;
  integer edsac_order_opcode, trunk_line_id, cics_writer_id, token_pos_x, token_pos_y, simulate_order_fault, k_param;
  begin
    comment Classification Ruling:
            0 = QUALIFIED_ORBITAL_HANDSHAKE (Zorse Yellow Box CICS Initial Orders 1 Formally Proven)
            1 = INVALID_K_EXPONENT (k must be 3)
            2 = INVALID_EDSAC_OPCODE (opcode must be in ASCII 'A'..'Z' or '0'..'9')
            3 = INVALID_TRUNK_LINE (trunk_line_id must be in [1..24])
            4 = CICS_CITIZEN_UNVERIFIED (writer_id must be qualifying SSA participant)
            5 = INVALID_POSITION (token positions must be in [0..2048])
            6 = GATING_CLAMP_OVERFLOW (SwiGLU gate outside [875..1000])
            7 = SHADOW_ISOLATION_CORRUPTION (CICS shadow baseline mutated during fault)
            8 = CASCADE_ROLLBACK_FAIL (Committed state diverged from expected shadow baseline);

    integer radial_distance_r_q16;
    integer j0_radial_val;
    integer j1_radial_val;
    integer bessel_wave_packet;
    integer shadow_cics_baseline;
    integer g_gate_factor;
    integer committed_output;
    integer disp_wrap;

    if k_param != 3 then
      begin
        verify_zorse_yellow_box_cics_initial_orders1 := 1;
        go to end_zorse_cics_io1_proc;
      end;

    comment Initial Orders 1 Opcodes: 'A'=65 (Add), 'S'=83 (Subtract), 'T'=84 (Transfer), 'Z'=90 (Stop), 'H'=72 (Hold), 'L'=76 (Shift Left), 'R'=82 (Shift Right);
    if edsac_order_opcode < 32 or edsac_order_opcode > 126 then
      begin
        verify_zorse_yellow_box_cics_initial_orders1 := 2;
        go to end_zorse_cics_io1_proc;
      end;

    if trunk_line_id < 1 or trunk_line_id > 24 then
      begin
        verify_zorse_yellow_box_cics_initial_orders1 := 3;
        go to end_zorse_cics_io1_proc;
      end;

    comment Validate Qualifying CICS SSA Citizen (555=TeddyBear, 888=FederalWorker, 99=Agent99, 42=Agent42);
    if cics_writer_id != 555 and cics_writer_id != 888 and cics_writer_id != 99 and cics_writer_id != 42 and cics_writer_id != 0x4001 then
      begin
        verify_zorse_yellow_box_cics_initial_orders1 := 4;
        go to end_zorse_cics_io1_proc;
      end;

    if token_pos_x < 0 or token_pos_x > 2048 or
       token_pos_y < 0 or token_pos_y > 2048 then
      begin
        verify_zorse_yellow_box_cics_initial_orders1 := 5;
        go to end_zorse_cics_io1_proc;
      end;

    comment Step 1: Compute 2D Spatial Radial Distance & Bessel Wave Packet;
    radial_distance_r_q16 := (token_pos_x + token_pos_y) * 16;
    if radial_distance_r_q16 > 65536 then radial_distance_r_q16 := 65536;

    j0_radial_val := 65536 - ((radial_distance_r_q16 * radial_distance_r_q16) / 262144);
    j1_radial_val := (radial_distance_r_q16 / 2) - ((radial_distance_r_q16 * radial_distance_r_q16 * radial_distance_r_q16) / 1048576);
    bessel_wave_packet := j0_radial_val + (j1_radial_val / 4);

    comment Step 2: Establish Shadow CICS PBX Baseline in Isolated ZMM Registers;
    shadow_cics_baseline := (cics_writer_id * 1000000) + (trunk_line_id * 10000) + (edsac_order_opcode * 100) + (token_pos_x + token_pos_y);

    comment Step 3: SwiGLU Gating Modulation per Trunk Line ID;
    comment g_gate = 875 + ((125 * trunk_line_id) / 24);
    g_gate_factor := 875 + ((125 * trunk_line_id) / 24);
    if g_gate_factor < 875 or g_gate_factor > 1000 then
      begin
        verify_zorse_yellow_box_cics_initial_orders1 := 6;
        go to end_zorse_cics_io1_proc;
      end;

    if simulate_order_fault then
      begin
        committed_output := shadow_cics_baseline;
      end
    else
      begin
        committed_output := (((shadow_cics_baseline + (bessel_wave_packet / 16)) * g_gate_factor) / 1000);
      end;

    comment Assert Shadow CICS Register Immutability Invariant;
    if shadow_cics_baseline != ((cics_writer_id * 1000000) + (trunk_line_id * 10000) + (edsac_order_opcode * 100) + (token_pos_x + token_pos_y)) then
      begin
        verify_zorse_yellow_box_cics_initial_orders1 := 7;
        go to end_zorse_cics_io1_proc;
      end;

    if simulate_order_fault and committed_output != shadow_cics_baseline then
      begin
        verify_zorse_yellow_box_cics_initial_orders1 := 8;
        go to end_zorse_cics_io1_proc;
      end;

    disp_wrap := committed_output - ((committed_output / 256) * 256);
    if disp_wrap < 0 then disp_wrap := disp_wrap + 256;

    verify_zorse_yellow_box_cics_initial_orders1 := 0;

  end_zorse_cics_io1_proc:
  end;

end
