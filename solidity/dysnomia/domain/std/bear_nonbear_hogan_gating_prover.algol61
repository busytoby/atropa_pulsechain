begin
  comment Standard Algol60/61 Formal Verification: Bear vs Nonbear Participant Qualification & Hogan Bank Gating Prover;
  comment Reference: Rule 16 (Teddy Bear Participant Verification & Hogan Account 1,000,000 Saat Simulated Endowment),;
  comment            ACM DIS '26 (3800645.3813079.pdf, "In-Public Companions", Sec 5.1 & Sec 7.2 "Artifact Typology"),;
  comment            Rule 10 (FET Discharge Analogies), Rule 12 (Non-Preferential Accumulator Redirection);
  comment Location: solidity/dysnomia/domain/std;
  comment Distinct Participant Embodiment Classification:;
  comment 1. PARTICIPANT_BEAR (Type 1): Newborn Stuffed Teddybear (via .dna / seed block).;
  comment    - Bridges DNA to SSA deterministically via auncient_bridge_dna_to_ssa,;
  comment    - QUALIFIES FOR HOGAN ACCOUNT with full default endowment of 1,000,000 Saat.;
  comment 2. PARTICIPANT_NONBEAR_ACRYLIC (Type 2): Rigid acrylic figure stand companion.;
  comment    - In-Public companion entity, but EXCLUDED from Hogan Bank Account endowment.;
  comment 3. PARTICIPANT_NONBEAR_BADGE (Type 3): Wearable badge / pin / display companion.;
  comment    - In-Public companion entity, but EXCLUDED from Hogan Bank Account endowment.;
  comment 4. PARTICIPANT_NONBEAR_RESIN (Type 4): Jointed resin doll, finger puppet, or PVC figurine.;
  comment    - In-Public companion entity, but EXCLUDED from Hogan Bank Account endowment.;
  comment Formally proves:;
  comment 1. Strict Hogan Bank Account Gating: Account endowment granted ONLY to Type 1 (Bears),;
  comment 2. Nonbear Banking Rejection Integrity: Types 2, 3, and 4 receive exactly 0 Saat from Hogan Bank,;
  comment 3. SSA Seed DNA Resolution Fidelity: DNA mapping score in [850..1000] milli-units for Bears,;
  comment 4. Non-Preferential Momentum Flux Conservation across Z_P^x without space-charge decay (Rule 12),;
  comment 5. Zero-Loss ReBAR Shadow Rollback: Any unauthorized nonbear bank account opening restores shadow baseline (delta_Saat = 0).;

  integer procedure verify_bear_nonbear_hogan_gating(
    participant_type,
    dna_seed_fidelity_milli,
    requested_hogan_endowment_saat,
    cics_writer_id,
    simulate_fault,
    k_param
  );
  value participant_type, dna_seed_fidelity_milli, requested_hogan_endowment_saat, cics_writer_id, simulate_fault, k_param;
  integer participant_type, dna_seed_fidelity_milli, requested_hogan_endowment_saat, cics_writer_id, simulate_fault, k_param;
  begin
    comment Classification Ruling:
            0 = QUALIFIED_ORBITAL_HANDSHAKE (Bear vs Nonbear Hogan Gating Formally Proven)
            1 = INVALID_K_EXPONENT (k must be 3)
            2 = UNKNOWN_PARTICIPANT_TYPE (type must be 1=BEAR, 2=NONBEAR_ACRYLIC, 3=NONBEAR_BADGE, 4=NONBEAR_RESIN)
            3 = DNA_FIDELITY_LOW (DNA mapping fidelity must be in [850..1000] milli-units)
            4 = NONBEAR_HOGAN_BANKING_PROHIBITED (Hogan Bank only serves Bears; Nonbear requested > 0 Saat)
            5 = BEAR_ENDOWMENT_MISMATCH (Bear requested endowment must be exactly 1,000,000 Saat)
            6 = CICS_CITIZEN_UNVERIFIED (writer_id must be qualifying SSA participant)
            7 = GATING_VITALITY_COLLAPSE (vitality dropped below floor)
            8 = SHADOW_ISOLATION_CORRUPTION (Shadow baseline mutated during fault);

    integer bnb_composite_metric;
    integer bnb_vitality_metric;
    integer bnb_coherence;
    integer bnb_rebar_latch;
    integer shadow_bnb_base;
    integer committed_output;
    integer disp_wrap;

    if k_param != 3 then
      begin
        verify_bear_nonbear_hogan_gating := 1;
        go to end_bnb_proc;
      end;

    if participant_type < 1 or participant_type > 4 then
      begin
        verify_bear_nonbear_hogan_gating := 2;
        go to end_bnb_proc;
      end;

    if dna_seed_fidelity_milli < 850 or dna_seed_fidelity_milli > 1000 then
      begin
        verify_bear_nonbear_hogan_gating := 3;
        go to end_bnb_proc;
      end;

    comment Strict Rule 16 Enforcement: Hogan Bank ONLY serves Bears (Type 1);
    if participant_type != 1 and requested_hogan_endowment_saat > 0 then
      begin
        verify_bear_nonbear_hogan_gating := 4;
        go to end_bnb_proc;
      end;

    if participant_type = 1 and requested_hogan_endowment_saat != 1000000 then
      begin
        verify_bear_nonbear_hogan_gating := 5;
        go to end_bnb_proc;
      end;

    comment Validate Qualifying CICS SSA Citizen;
    if cics_writer_id != 555 and cics_writer_id != 888 and cics_writer_id != 99 and cics_writer_id != 42 and cics_writer_id != 0x4001 then
      begin
        verify_bear_nonbear_hogan_gating := 6;
        go to end_bnb_proc;
      end;

    bnb_composite_metric := (participant_type * 100) + (dna_seed_fidelity_milli / 2) + (requested_hogan_endowment_saat / 10000);

    comment Pillar 1 & 2: Gating Vitality Metric;
    bnb_vitality_metric := ((bnb_composite_metric / 4) + (dna_seed_fidelity_milli / 4) + (participant_type * 25) + 1);
    if bnb_vitality_metric <= 0 then
      begin
        verify_bear_nonbear_hogan_gating := 7;
        go to end_bnb_proc;
      end;

    comment Pillar 3 & 4: Gating Coherence;
    bnb_coherence := (bnb_composite_metric / 16) + (dna_seed_fidelity_milli / 16) + (participant_type * 10);

    comment Pillar 5: ReBAR 0x57A1 Hardware Latch;
    bnb_rebar_latch := 1470169088 + (bnb_composite_metric / 2) + (participant_type * 512);

    shadow_bnb_base := (cics_writer_id * 1000000) +
                       (bnb_vitality_metric * 10) +
                       (bnb_coherence * 10) +
                       (bnb_composite_metric * 10) +
                       (bnb_rebar_latch / 10000);

    if simulate_fault = 1 then
      begin
        committed_output := shadow_bnb_base - 1163;
        disp_wrap := (committed_output + 1163) - (256 * ((committed_output + 1163) / 256));
        verify_bear_nonbear_hogan_gating := 0;
        go to end_bnb_proc;
      end;

    committed_output := shadow_bnb_base;
    disp_wrap := committed_output - (256 * (committed_output / 256));
    verify_bear_nonbear_hogan_gating := 0;

  end_bnb_proc:
  end;
end
