begin
  comment Theodore Motzkin Double Sequences Prover;
  comment S(m, n) = ((m^2 + n^2 + 1) * 42) mod MotzkinPrime;

  integer procedure doubleSequence(m, n);
  value m, n; integer m, n;
  begin
    integer m2, n2, sumVal, prime;
    prime := 953467954114363;
    m2 := m * m;
    n2 := n * n;
    sumVal := (m2 + n2 + 1) * 42;
    doubleSequence := sumVal - (sumVal // prime) * prime
  end;

  integer seqVal, latch, sound;
  seqVal := doubleSequence(4, 5);
  if seqVal > 0 then sound := 1 else sound := 0;
  latch := 1470169088 + 4 * 65536 + 5
end
